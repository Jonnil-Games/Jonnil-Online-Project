/* Shared drawing constructor access for callers that use the Drawing macro */
#macro Drawing scr_get_drawing()

/* Stable drawing-tool IDs stored in commands, saved history, and network payloads.
Pen streams strokes, eraser removes pixels, line and shapes use two endpoints,
fill samples connected pixels, text stores a string, picker samples the canvas,
stamp places PNGs, select edits copied pixels, and wall sends collision strokes */
#macro DRAW_TOOL_PEN 0
#macro DRAW_TOOL_ERASER 1
#macro DRAW_TOOL_LINE 2
#macro DRAW_TOOL_RECTANGLE 3
#macro DRAW_TOOL_CIRCLE 4
#macro DRAW_TOOL_FILL 5
#macro DRAW_TOOL_TEXT 6
#macro DRAW_TOOL_COLOR_PICKER 7
#macro DRAW_TOOL_STAMP 8
#macro DRAW_TOOL_SELECT 9
#macro DRAW_TOOL_WALL 10

/* Explicit history tags distinguish embedded PNGs, layer operations, and undo
records from ordinary drawing commands that have no special history kind */
#macro DRAW_HISTORY_IMAGE 1
#macro DRAW_HISTORY_LAYER 2
#macro DRAW_HISTORY_UNDO 3

/* Stable layer-operation IDs identify creation, duplication, deletion, reordering,
visibility changes, archiving, and restoration in shared history payloads */
#macro DRAW_LAYER_ADD 0
#macro DRAW_LAYER_DUPLICATE 1
#macro DRAW_LAYER_DELETE 2
#macro DRAW_LAYER_MOVE 3
#macro DRAW_LAYER_VISIBILITY 4
#macro DRAW_LAYER_ARCHIVE 5
#macro DRAW_LAYER_RESTORE 6

/// @description Initialize drawing tools, layers, shared history, transfer queues, and local INI preferences
function scr_drawing() constructor
{

	#region /* Network and Drawing Limits */
	net = scr_get_network(); /* Shared packet definitions and client limits used by drawing replication */

	/* max_history is a persistence validation ceiling, not a rolling history limit. Dropping
	old commands before they have been rasterized permanently removes their pixels */
	max_history = 250000;
	history_chunk_size = 64; /* Maximum ordinary history items grouped into one synchronization packet */
	image_chunk_size = 12000; /* Characters of base64 PNG data carried in each image packet */
	image_import_max_bytes = 2097152; /* Two MiB ceiling for PNG bytes accepted by imports and replicated images */

	/* Maximum chunks accepted for one image so incomplete transfers cannot grow without bound */
	image_import_max_chunks = 384;

	/* Milliseconds on current_time before an unfinished image transfer is discarded */
	image_pending_timeout_ms = 15000;
	server_history_sync_packets_per_step = 2; /* Packet budget per server Step for queued history transfers */
	client_image_packets_per_step = 2; /* Image-chunk packet budget per client Step for pending uploads */
	client_history_replay_items_per_step = 64; /* Maximum ordinary history items replayed in one client Step */

	/* Microsecond replay budget measured with get_timer so joining leaves time for other Step
	work */
	client_history_replay_budget_us = 4000;
	history_sync_retry_delay_ms = 250; /* current_time milliseconds to wait before retrying a blocked history send */
	image_import_max_sprite_dimension = 4096; /* Maximum imported PNG width or height in pixels */
	image_import_folder_name = "drawing_imports"; /* Save-area folder used for temporary imported PNG files */

	/* Prefix distinguishing cached imported files from other PNGs */
	image_import_file_prefix = "JonnilOnline_Import_";

	/* Save-area folder used for temporary PNG files produced by completed fills */
	fill_upload_folder_name = "drawing_fill_uploads";
	fill_upload_file_prefix = "JonnilOnline_Fill_"; /* Prefix identifying cached fill-upload PNG files */
	next_image_import_id = 1; /* Next host-side image identifier, starting at one and advanced for each import */

	/* Next client-side image identifier, starting at one and advanced for each generated image */
	next_client_image_id = 1;
	max_text_chars = 96; /* Maximum characters retained in one drawing-text command */
	max_fill_bounds_area = 1200000; /* Maximum sampled rectangle area in pixels accepted for a fill */

	/* Maximum pixels one fill may replace, sharing the sampled-area ceiling */
	max_fill_pixels = max_fill_bounds_area;
	max_fill_queue = max_fill_bounds_area; /* Maximum seed entries appended during one fill, sharing the sampled-area ceiling */
	fill_pixels_per_step = 8192; /* Local fill pixel budget per Step so cancellable work yields to the UI */

	/* Local fill seed budget per Step, limiting unsuccessful seed scans as well as painted
	pixels */
	fill_seed_budget_per_step = 384;
	fill_spans_per_step = 48; /* Local fill horizontal-span budget per Step */

	/* Shared/history fills cannot be cancelled and block ordered drawing input while
	they run. Give legacy raw fill commands a larger progressive budget, while
	continuing to yield each frame even on a slow client */
	shared_fill_pixels_per_step = 65536;
	shared_fill_seed_budget_per_step = 32768; /* Larger seed budget per Step for shared-history fill replay */
	shared_fill_spans_per_step = 8192; /* Larger horizontal-span budget per Step for shared-history fill replay */

	/* Alpha byte at or below which the fill matcher treats a sampled pixel as empty */
	fill_empty_alpha_threshold = 112;
	fill_colour_tolerance = 8; /* Maximum per-channel RGB byte difference allowed when matching the fill seed */
	fill_alpha_tolerance = 16; /* Maximum alpha-byte difference allowed for nonempty fill target pixels */
	min_brush_width = 1; /* Smallest brush diameter accepted by local controls, in world pixels */
	max_brush_width = 32; /* Largest non-eraser brush diameter accepted by local controls, in world pixels */
	max_eraser_width = 96; /* Larger eraser diameter ceiling, in world pixels */
	min_send_distance = 3; /* Minimum world-pixel distance between streamed stroke endpoints */
	send_interval_ms = 24; /* current_time milliseconds between ordinary streamed drawing sends */

	/* Minimum current_time spacing between commands accepted from one player slot */
	server_min_command_interval_ms = 10;
	fill_action_cooldown_ms = 700; /* Local fill cooldown duration in current_time milliseconds */
	stamp_action_cooldown_ms = 260; /* Local stamp cooldown duration in current_time milliseconds */
	stamp_default_brush_width = 6; /* Brush-width reference used to scale stamps from their library dimensions */
	stamp_min_world_size = 4; /* Minimum placed stamp side length in world pixels */
	stamp_max_world_size = 1024; /* Maximum placed stamp side length in world pixels */
	history_action_cooldown_ms = 450; /* Local undo and redo cooldown duration in current_time milliseconds */
	server_undo_action_cooldown_ms = 450; /* Host-enforced undo cooldown duration per player slot, in milliseconds */
	server_layer_action_cooldown_ms = 750; /* Host-enforced layer request cooldown per player slot, in milliseconds */
	layer_vote_duration_ms = 30000; /* current_time milliseconds available for a shared-layer vote */

	/* current_time milliseconds before a player may propose another layer vote */
	layer_vote_retry_cooldown_ms = 10000;
	max_shared_active_layers = 16; /* Maximum unarchived layers allowed in the shared canvas */
	max_shared_total_layers = 32; /* Maximum shared layers including archived layers */
	#endregion /* Network and Drawing Limits END */

	#region /* Tool and Local Display State */
	draw_mode_enabled = false; /* Drawing input starts disabled until the player enables drawing mode */
	draw_while_hidden = false; /* Hidden-toolbar drawing starts disabled and can be enabled separately */
	tool = DRAW_TOOL_PEN; /* Selected drawing action starts as the pen */

	/* Tool restored after stamping, initially the pen before any stamp selection */
	tool_before_stamp = DRAW_TOOL_PEN;
	selection_active = false; /* No pixel-selection rectangle is active at startup */
	selection_left = 0; /* Selection left edge in world pixels, zero while no selection exists */
	selection_top = 0; /* Selection top edge in world pixels, zero while no selection exists */
	selection_right = 0; /* Selection right edge in world pixels, zero while no selection exists */
	selection_bottom = 0; /* Selection bottom edge in world pixels, zero while no selection exists */
	selection_anchor_x = 0; /* World-pixel x where rectangle creation begins, unset until a selection drag */
	selection_anchor_y = 0; /* World-pixel y where rectangle creation begins, unset until a selection drag */
	selection_drag_mode = ""; /* Empty text means no rectangle-create or pixel-move drag is in progress */
	selection_drag_start_x = 0; /* Pointer world x at the start of a selection move, zero before a drag */
	selection_drag_start_y = 0; /* Pointer world y at the start of a selection move, zero before a drag */
	selection_move_origin_left = 0; /* Original world-pixel left edge retained while previewing a move */
	selection_move_origin_top = 0; /* Original world-pixel top edge retained while previewing a move */
	selection_preview_active = false; /* No provisional moved rectangle is shown until a move drag begins */
	selection_preview_left = 0; /* Provisional world-pixel left edge, zero before a move preview */
	selection_preview_top = 0; /* Provisional world-pixel top edge, zero before a move preview */
	selection_move_region = noone; /* Copied RGBA region for a selection move, noone until the drag captures pixels */

	/* Owned move-preview surface, noone until created and freed when selection preview clears */
	selection_preview_surface = noone;

	/* Fill samples the current layer by default, with visible-layer sampling selected
	separately */
	fill_sample_visible_layers = false;
	tool_cursor_active = false; /* Custom tool cursor starts inactive until the client input state enables it */
	tool_cursor_scale = 2; /* Multiplier used when drawing tool cursor sprites */
	brush_width = 6; /* Current brush diameter starts at six world pixels and changes through size controls */
	brush_red = 255; /* Initial brush red channel, a byte later changed by palette and color controls */
	brush_green = 220; /* Initial brush green channel, a byte later changed by palette and color controls */
	brush_blue = 95; /* Initial brush blue channel, a byte later changed by palette and color controls */
	brush_alpha = 255; /* Initial brush alpha byte is fully opaque, with zero used for transparency */
	hue_value = 36; /* Initial brush hue in degrees for the HSV controls */
	saturation_value = 160; /* Initial brush saturation on the zero-to-255 HSV scale */
	value_value = 255; /* Initial brush value on the zero-to-255 HSV scale */
	text_entry_active = false; /* No drawing-text edit is open until the text tool is used */
	text_entry_world_x = 0; /* World-pixel text origin x captured when an edit begins */
	text_entry_world_y = 0; /* World-pixel text origin y captured when an edit begins */

	/* Text edit red byte, initialized to the default brush and captured again when editing
	begins */
	text_entry_color_r = 255;

	/* Text edit green byte, initialized to the default brush and captured again when editing
	begins */
	text_entry_color_g = 220;

	/* Text edit blue byte, initialized to the default brush and captured again when editing
	begins */
	text_entry_color_b = 95;
	text_entry_color_a = 255; /* Text edit alpha byte starts opaque and captures brush opacity when editing begins */

	/* Text size reference starts at six world pixels and captures brush width when editing
	begins */
	text_entry_brush_width = 6;
	text_entry_text = ""; /* Editable drawing-text contents, empty before the first edit */
	text_entry_max_width = 420; /* Maximum rendered text-preview width in world pixels */

	/* Reuse the profile settings INI so client-only drawing preferences live in the
	engine's per-user save area instead of drawing history or server state */
	client_settings_file = "client_settings.ini";
	drawing_settings_section = "drawing"; /* INI section containing local drawing preferences */

	/* Current INI key for the signed canvas-background brightness value */
	canvas_background_key = "canvas_background_brightness";

	/* Older named-background INI key consulted when the current key is missing */
	canvas_background_legacy_key = "canvas_background";
	inactive_layer_dim_key = "dim_inactive_layers"; /* INI key for the local inactive-layer dimming toggle */
	recent_colors_key = "recent_colors"; /* INI key for the pipe-separated recent RGBA swatches */

	/* Canvas background brightness is a signed overlay:
	-1 is full black tint, 0 is normal room view, +1 is full white tint */
	/* Target signed overlay, zero for normal room view and negative or positive for black or
	white */
	canvas_background_brightness = 0;

	/* Animated overlay value starts at the normal view and approaches the loaded or selected
	target */
	canvas_background_brightness_lerp = 0;

	/* Inactive-layer dimming starts enabled and is replaced by the saved local preference */
	dim_inactive_layers = true;
	inactive_layer_alpha = 0.38; /* Opacity multiplier for dimmed layers, leaving the active layer fully visible */

	/* Fixed toolbar palette. Every entry stores r, g, b, and a byte channels for red, green,
	blue, and opacity. The final transparent swatch selects zero opacity */
	swatches =
	[
		{ r: 255, g: 255, b: 255, a: 255 },
		{ r: 255, g: 220, b: 95, a: 255 },
		{ r: 244, g: 84, b: 84, a: 255 },
		{ r: 94, g: 215, b: 122, a: 255 },
		{ r: 82, g: 162, b: 255, a: 255 },
		{ r: 196, g: 116, b: 255, a: 255 },
		{ r: 34, g: 34, b: 38, a: 255 },
		{ r: 0, g: 0, b: 0, a: 0 }
	];

	/* Maximum recent colors shown, matching the number of fixed palette slots */
	recent_swatch_capacity = array_length(swatches);

	/* Newest-first RGBA swatches, empty until saved colors load or drawing records a new color */
	recent_swatches = [];
	#endregion /* Tool and Local Display State END */

	#region /* Canvas and History State */
	/* Owned flattened room-sized drawing surface, noone until ensure_surface creates it and
	delete_surface frees it */
	canvas_surface = noone;

	/* Ordered client paint-layer structs, empty until default layers or shared history rebuild
	the stack */
	layers = [];

	/* Initially selected paint-layer identifier, matching the default layer created with ID
	one */
	active_layer_id = 1;
	next_layer_id = 2; /* Next client paint-layer identifier starts after the default layer */
	layers_panel_x = 16; /* Layer-panel left edge starts at 16 GUI pixels and can move when its header is dragged */
	layers_panel_y = 282; /* Layer-panel top edge starts at 282 GUI pixels and can move when its header is dragged */
	layers_panel_width = 360; /* Layer-panel width in GUI pixels, used by row layout and hit testing */
	layers_panel_height = 176; /* Layer-panel height in GUI pixels, bounding its rows and scroll range */
	layers_panel_header_height = 28; /* Layer-panel header height in GUI pixels, separating dragging from row input */
	layers_panel_row_height = 28; /* Height of each displayed layer row in GUI pixels */
	layers_panel_button_size = 24; /* Side length of square layer controls in GUI pixels */
	layers_panel_hover = ""; /* Empty text means no layer-panel control is under the pointer */
	layers_panel_dragging = false; /* Layer-panel position drag starts inactive */
	layers_panel_drag_offset_x = 0; /* Pointer-to-panel horizontal offset captured when panel dragging begins */
	layers_panel_drag_offset_y = 0; /* Pointer-to-panel vertical offset captured when panel dragging begins */
	layers_panel_scroll = 0; /* Zero-based first displayed active-layer row, starting at the top of the list */

	/* No provisional layer reorder exists until the player moves a layer in the panel */
	layer_move_draft_active = false;
	layer_move_draft_layer_id = 0; /* Layer identifier being reordered, zero while no draft exists */
	layer_move_draft_target_position = 0; /* Proposed active-layer position, zero before a reorder draft */

	/* Original active-layer position retained to compare and cancel a reorder draft */
	layer_move_draft_original_position = 0;
	layer_move_draft_submitted = false; /* No reorder request is awaiting the server at startup */
	layer_blink_layer_id = 0; /* Layer highlighted after an action, zero while no highlight is scheduled */

	/* current_time millisecond start of the layer highlight, zero before the first highlight */
	layer_blink_started_at = 0;
	layer_blink_duration_ms = 1600; /* Total layer-highlight duration in current_time milliseconds */
	layer_blink_period_ms = 360; /* One layer-highlight pulse period in current_time milliseconds */
	layer_blink_fade_ms = 180; /* Highlight fade duration at the beginning and end, in milliseconds */

	/* Next archive ordering value starts at one so the latest archived layer can be found */
	next_layer_archive_sequence = 1;
	layer_surface_rebuild_active = false; /* No ordered layer-surface reconstruction is running at startup */

	/* Undo patch capture starts enabled and is suspended during reconstruction */
	undo_patch_capture_suspended = false;

	/* Fill replay normally yields between Steps rather than completing synchronously */
	fill_force_synchronous_replay = false;
	layer_composite_dirty = true; /* Initial flattened surface needs compositing once its layer surfaces exist */

	/* Owned fill-sampling surface, unallocated until ensure_fill_work_area and freed by
	delete_fill_work_area */
	fill_work_surface = noone;

	/* Owned RGBA sampling buffer, unallocated until fill setup and deleted with the work area */
	fill_work_buffer = noone;
	fill_work_buffer_size = 0; /* Allocated sampling-buffer capacity in bytes, zero while no buffer exists */

	/* Owned replacement-pixel mask buffer, unallocated until fill setup and deleted with the
	work area */
	fill_mask_buffer = noone;
	fill_mask_buffer_size = 0; /* Allocated replacement-mask capacity in bytes, zero while no mask buffer exists */

	/* Progressive fill job, noone until a fill starts and cleared on finish or cancellation */
	fill_active_job = noone;
	fill_deferred_history_items = []; /* Ordered history waiting behind a fill, empty while no blocked items exist */

	/* Locally retained drawing history in replay order, empty before drawing or
	synchronization */
	client_history = [];

	/* Revision counter invalidating the local undo lookup cache, starting before any history
	mutation */
	client_history_revision = 0;
	undo_lookup_revision = -1; /* Cached history revision starts invalid so the first undo lookup scans the history */
	undo_lookup_author = -1; /* Cached undo author starts invalid so no player owns the initial cache entry */
	undo_lookup_id = 0; /* Cached last local undo-group identifier, zero when no usable group has been found */
	pending_image_draws = []; /* Image sprites awaiting asynchronous load, empty before an image starts loading */

	/* Ordered history waiting behind an image load, empty before a replay barrier */
	image_deferred_history_items = [];

	/* Authoritative ordered history, empty until saved history loads or the host accepts
	drawing */
	server_history = [];

	/* Per-recipient queued history snapshots, empty until a join or update requests
	synchronization */
	server_history_sync_jobs = [];

	/* Primary JSON drawing-history file in the host save area */
	server_history_persistence_file = "server_drawing_history.json";

	/* Pending JSON write used before replacing the primary saved history */
	server_history_persistence_temp_file = "server_drawing_history.pending.json";

	/* Previous JSON save retained as a recovery source */
	server_history_persistence_backup_file = "server_drawing_history.backup.json";

	/* Version stored in the JSON history envelope and checked during decoding */
	server_history_persistence_format = 1;

	/* Maximum JSON text characters accepted before parsing a saved history */
	server_history_persistence_max_chars = 33554432;

	/* Quiet-period delay before saving dirty history, in current_time milliseconds */
	server_history_persistence_save_delay_ms = 5000;

	/* Maximum dirty-history wait before a save attempt, in milliseconds */
	server_history_persistence_max_delay_ms = 30000;
	server_history_persistence_dirty = false; /* No unsaved accepted history change has been recorded at startup */

	/* current_time timestamp of the first unsaved change, zero before history becomes dirty */
	server_history_persistence_dirty_since = 0;

	/* Scheduled current_time save deadline, zero before any save is scheduled */
	server_history_persistence_save_at = 0;

	/* Earliest current_time save retry, zero before a failed save introduces a delay */
	server_history_persistence_retry_at = 0;
	server_history_persistence_loaded_count = 0; /* Count of history items restored from disk, zero before loading */

	/* Count of history items in the last successful disk save, zero before saving */
	server_history_persistence_saved_count = 0;

	/* Human-readable save/load status starts before any load attempt */
	server_history_persistence_status = "not loaded";

	/* Latest rejected persistence-record detail, empty before validation fails */
	server_history_persistence_validation_error = "";
	server_history_checkpoint_dirty = false; /* No accepted change has yet made the compact checkpoint stale */
	server_history_checkpoint_requested = false; /* No compact-history rebuild is pending at startup */
	server_history_checkpoint_in_progress = false; /* No authoritative checkpoint replay is running at startup */

	/* Earliest current_time checkpoint retry, zero before any failed attempt delays it */
	server_history_checkpoint_retry_at = 0;

	/* History length captured at checkpoint start, zero before a reconstruction snapshot */
	server_history_checkpoint_source_count = 0;

	/* Layer-state snapshot retained during checkpoint reconstruction, empty before capture */
	server_history_checkpoint_layer_states = [];

	/* Count of failed item applications in the current checkpoint, zero before replay */
	server_history_checkpoint_apply_failures = 0;
	server_history_checkpoint_next_image_id = 1; /* Next checkpoint image ID starts at one for encoded layer tiles */
	server_history_checkpoint_status = "idle"; /* Human-readable checkpoint state starts idle */

	/* World-pixel side length used to divide checkpoint layer images into PNG tiles */
	server_history_checkpoint_tile_size = 512;

	/* Delay after a failed checkpoint, in current_time milliseconds */
	server_history_checkpoint_retry_delay_ms = 30000;

	/* Mappings from connection-specific undo authors to player slots and sockets, empty before
	attribution */
	server_undo_author_slots = [];

	/* Last accepted command time per zero-based player slot, initially zero on the
	current_time clock */
	server_last_command_time = array_create(net.max_clients, 0);

	/* Incomplete incoming images keyed by sender slot and image ID, empty before an upload */
	server_pending_image_receives = [];

	/* current_time undo deadline per player slot, zero giving each slot no initial cooldown */
	server_undo_cooldown_until = array_create(net.max_clients, 0);

	/* current_time layer-action deadline per player slot, zero before any accepted request */
	server_layer_action_cooldown_until = array_create(net.max_clients, 0);

	/* current_time proposal-retry deadline per player slot, zero before any layer vote */
	server_layer_vote_cooldown_until = array_create(net.max_clients, 0);

	/* Authoritative layer membership and stewardship records, empty until the default stack is
	established */
	server_layer_states = [];
	server_next_layer_id = 2; /* Next authoritative layer ID starts after the default layer with ID one */

	/* Authoritative stack revision starts before any layer operation and invalidates stale
	votes */
	server_layer_stack_revision = 0;
	server_next_layer_vote_id = 1; /* Next shared-layer proposal identifier starts at one */
	server_active_layer_vote = noone; /* Active host-side proposal, noone while no vote is running */
	pending_image_receives = []; /* Incomplete client-side PNG transfers, empty before an image packet arrives */

	/* Shared drawing input waits for synchronization, which starts incomplete */
	client_history_sync_complete = false;
	client_history_sync_completion_received = false; /* No explicit end-of-history marker has arrived at startup */

	/* Explicit completion is not required until the negotiated synchronization path enables it */
	client_history_sync_completion_required = false;

	/* No deferred reconstruction has been requested before synchronization begins */
	client_history_sync_requires_replay = false;
	client_history_replay = noone; /* Progressive history-replay cursor state, noone before a reconstruction starts */
	client_history_replay_restart = false; /* No new history mutation has requested restarting the active replay */
	client_history_sync_notice_shown = false; /* The waiting-for-history UI notice has not been shown yet */

	/* Most recent legacy history packet time, zero before any packet on current_time */
	client_history_sync_legacy_last_packet_at = 0;

	/* Silence interval in milliseconds used to finish legacy synchronization without an
	explicit marker */
	client_history_sync_legacy_idle_ms = 2000;

	/* current_time timestamp of synchronization start, zero before a batch begins */
	client_history_sync_started_at = 0;

	/* No synchronization batch currently suppresses per-item surface rebuilding */
	client_history_sync_batch_active = false;

	/* Previous reconstruction flag retained for restoration when a sync batch finishes */
	client_history_sync_restore_rebuild_active = false;

	/* Previous undo-capture flag retained while a sync batch suspends capture */
	client_history_sync_restore_patch_capture_suspended = false;
	client_layer_vote = noone; /* Client copy of the current shared-layer proposal, noone before receiving a vote */
	layer_vote_hover = ""; /* Empty text means no vote-banner button is hovered */
	layer_vote_mouse_capture = false; /* The vote banner starts without capturing the current pointer gesture */

	/* Local zero-based player slot is unknown until drawing identity is assigned or refreshed */
	local_player_id = noone;
	local_player_name = ""; /* Local displayed author name is empty until drawing identity is available */

	/* Connection-specific drawing author is not assigned yet, preventing identity collisions
	across clients */
	local_undo_author_id = 0;
	next_local_undo_id = 1; /* Next local stroke-group identifier starts at one and advances for each undo group */
	active_undo_group_id = 0; /* Zero means no stroke or compound action currently owns an undo group */
	redo_stack = []; /* Removed local undo groups available for redo, empty before the first undo */

	/* Local current_time fill deadline, zero allowing the first fill without an initial wait */
	fill_cooldown_until = 0;
	undo_cooldown_until = 0; /* Local current_time undo deadline, zero before the first undo */
	redo_cooldown_until = 0; /* Local current_time redo deadline, zero before the first redo */

	/* Local current_time stamp deadline, zero allowing the first placement without an initial
	wait */
	stamp_cooldown_until = 0;

	/* Ordered local commands or images awaiting upload, empty before local submission */
	pending_client_history_sends = [];
	client_image_send_chunk = 0; /* Zero-based next chunk of the pending client image, reset for each image upload */

	/* current_time retry deadline for the queued local upload, zero allowing an immediate
	first attempt */
	next_pending_history_send_time = 0;
	#endregion /* Canvas and History State END */

	#region /* Stroke Input State */
	is_drawing = false; /* No pointer stroke is in progress at startup */

	/* Current stroke has not sent a dragged segment, allowing click-only handling on release */
	sent_drag_command = false;
	last_world_x = 0; /* Previous accepted stroke point x in world pixels, zero before a stroke starts */
	last_world_y = 0; /* Previous accepted stroke point y in world pixels, zero before a stroke starts */
	current_world_x = 0; /* Current sampled pointer x in world pixels, zero before a valid world sample */
	current_world_y = 0; /* Current sampled pointer y in world pixels, zero before a valid world sample */
	next_send_time = 0; /* current_time deadline for the next streamed stroke send, zero before the first segment */
	#endregion /* Stroke Input State END */

	#region /* Toolbar and Export State */
	toolbar_x = 16; /* Toolbar left edge starts at 16 GUI pixels and moves through header dragging */
	toolbar_y = 56; /* Toolbar top edge starts at 56 GUI pixels and is clamped during layout */

	/* Toolbar's computed GUI-pixel width, zero until update_toolbar_layout measures its
	controls */
	toolbar_width = 0;
	toolbar_height = 34; /* Base toolbar row height in GUI pixels */
	toolbar_active_slider = ""; /* Empty text means no size, HSV, or background slider is being dragged */
	toolbar_dragging = false; /* Toolbar position drag starts inactive */
	toolbar_drag_offset_x = 0; /* Horizontal pointer-to-toolbar offset captured when toolbar dragging begins */
	toolbar_drag_offset_y = 0; /* Vertical pointer-to-toolbar offset captured when toolbar dragging begins */
	toolbar_hidden = true; /* Toolbar starts hidden until drawing controls are opened */
	toolbar_layout_cache_key = ""; /* Empty layout signature forces the first GUI layout calculation */
	toolbar_reserved_right_width = 230; /* GUI pixels left clear on the right for other interface controls */
	toolbar_reserved_top = 46; /* Top GUI-pixel boundary used when clamping the toolbar away from other controls */
	toolbar_reserved_bottom = 136; /* Bottom reserved GUI-pixel margin used when clamping the toolbar */
	draw_button_x = 0; /* Drawing-mode button GUI x, zero until toolbar layout places it */
	draw_button_y = 0; /* Drawing-mode button GUI y, zero until toolbar layout places it */
	draw_button_width = 76; /* Drawing-mode button width in GUI pixels */
	draw_button_height = 30; /* Drawing-mode button height in GUI pixels */
	action_button_y = 0; /* Shared action-button row GUI y, zero until layout chooses the row */
	pen_button_x = 0; /* Pen-button GUI x, zero before toolbar layout */
	eraser_button_x = 0; /* Eraser-button GUI x, zero before toolbar layout */
	tool_buttons = []; /* Ordered tool-button rectangles populated by update_toolbar_layout, initially empty */
	tool_button_width = 34; /* Width of each tool selector in GUI pixels */
	tool_button_height = 30; /* Height of each tool selector in GUI pixels */
	width_minus_x = 0; /* Brush decrement-button GUI x, zero before toolbar layout */
	width_plus_x = 0; /* Brush increment-button GUI x, zero before toolbar layout */
	width_button_width = 28; /* Width of each brush increment or decrement button in GUI pixels */
	brush_slider_x = 0; /* Brush-size slider GUI x, zero before toolbar layout */
	brush_slider_y = 0; /* Brush-size slider GUI y, zero before toolbar layout */
	brush_slider_width = 92; /* Brush-size slider width in GUI pixels, used to map pointer x to brush size */
	brush_slider_height = 14; /* Brush-size slider height in GUI pixels for rendering and hit testing */
	brush_input_x = 0; /* Brush-size text field GUI x, zero before toolbar layout */
	brush_input_y = 0; /* Brush-size text field GUI y, zero before toolbar layout */
	brush_input_width = 42; /* Brush-size text field width in GUI pixels */
	brush_input_height = 22; /* Brush-size text field height in GUI pixels */
	brush_input_active = false; /* No brush-size text edit is open at startup */
	brush_input_text = ""; /* Brush-size edit contents start empty and are filled when editing begins */
	swatch_x = 0; /* Fixed palette's first swatch GUI x, zero before toolbar layout */
	swatch_y = 0; /* Fixed palette row GUI y, zero before toolbar layout */
	recent_swatch_y = 0; /* Recent palette row GUI y, zero before toolbar layout */
	swatch_size = 24; /* Square palette-cell side length in GUI pixels */
	color_preview_x = 0; /* Current brush-color preview GUI x, zero before toolbar layout */
	color_preview_y = 0; /* Current brush-color preview GUI y, zero before toolbar layout */
	color_preview_size = 34; /* Current brush-color preview side length in GUI pixels */
	hsv_slider_x = 0; /* Shared HSV slider GUI x, zero before toolbar layout */
	hsv_slider_y = 0; /* First HSV slider GUI y, zero before toolbar layout */
	hsv_slider_width = 176; /* HSV slider width in GUI pixels, used to map pointer x to channel values */
	hsv_slider_height = 14; /* HSV slider height in GUI pixels */
	hsv_slider_gap = 7; /* GUI-pixel gap between successive HSV slider rows */
	hsv_input_x = 0; /* Shared HSV numeric-field GUI x, zero before toolbar layout */
	hsv_input_width = 46; /* HSV numeric-field width in GUI pixels */
	hsv_input_height = 18; /* HSV numeric-field height in GUI pixels */
	hsv_input_active = ""; /* Empty text means no hue, saturation, or value numeric field is being edited */
	hsv_input_text = ""; /* HSV numeric edit contents start empty and are populated for the selected field */

	/* Owned hue-gradient cache surface, unallocated until drawn and released with toolbar
	gradient caches */
	hsv_surface_hue = noone;

	/* Owned saturation-gradient cache surface, unallocated until drawn and released with
	toolbar caches */
	hsv_surface_saturation = noone;

	/* Owned value-gradient cache surface, unallocated until drawn and released with toolbar
	caches */
	hsv_surface_value = noone;
	hsv_key_hue = ""; /* Cached hue-gradient signature, empty to force initial rendering */
	hsv_key_saturation = ""; /* Cached saturation-gradient signature, empty to force initial rendering */
	hsv_key_value = ""; /* Cached value-gradient signature, empty to force initial rendering */
	toolbar_hover = ""; /* Empty text means no toolbar control is under the pointer */
	screenshot_folder_name = "screenshots"; /* Root folder for native drawing screenshots within the save area */
	screenshot_manual_folder_name = "manual"; /* Subfolder containing manually requested drawing screenshots */

	/* Filename prefix identifying drawing PNGs and their companion metadata */
	screenshot_file_prefix = "JonnilOnline_Drawing_";
	undo_button_x = 0; /* Undo-button GUI x, zero before toolbar layout */
	undo_button_width = 62; /* Undo-button width in GUI pixels */
	redo_button_x = 0; /* Redo-button GUI x, zero before toolbar layout */
	redo_button_width = 62; /* Redo-button width in GUI pixels */
	screenshot_button_x = 0; /* Screenshot-button GUI x, zero before toolbar layout */
	screenshot_button_width = 96; /* Screenshot-button width in GUI pixels */
	open_screenshot_folder_button_x = 0; /* Screenshot-folder button GUI x, zero before toolbar layout */
	open_screenshot_folder_button_width = 94; /* Screenshot-folder button width in GUI pixels */
	draw_hidden_button_x = 0; /* Hidden-toolbar drawing toggle GUI x, zero before toolbar layout */
	draw_hidden_button_width = 178; /* Hidden-toolbar drawing toggle width in GUI pixels */
	dim_inactive_button_x = 0; /* Inactive-layer dimming toggle GUI x, zero before toolbar layout */
	dim_inactive_button_width = 126; /* Inactive-layer dimming toggle width in GUI pixels */
	fill_source_label_x = 0; /* Fill-source label GUI x, zero before toolbar layout */
	fill_source_label_y = 0; /* Fill-source label GUI y, zero before toolbar layout */
	fill_source_label_width = 86; /* Fill-source label width in GUI pixels */
	fill_current_button_x = 0; /* Current-layer fill button GUI x, zero before toolbar layout */
	fill_visible_button_x = 0; /* Visible-layers fill button GUI x, zero before toolbar layout */
	fill_source_button_y = 0; /* Shared fill-source button row GUI y, zero before toolbar layout */
	fill_current_button_width = 112; /* Current-layer fill button width in GUI pixels */
	fill_visible_button_width = 116; /* Visible-layers fill button width in GUI pixels */
	canvas_background_label_x = 0; /* Signed-background control label GUI x, zero before toolbar layout */
	canvas_background_label_y = 0; /* Signed-background control label GUI y, zero before toolbar layout */
	canvas_background_label_width = 24; /* Signed-background label width in GUI pixels */
	canvas_background_slider_x = 0; /* Signed-background slider GUI x, zero before toolbar layout */
	canvas_background_slider_y = 0; /* Signed-background slider GUI y, zero before toolbar layout */

	/* Signed-background slider width in GUI pixels for pointer-to-brightness conversion */
	canvas_background_slider_width = 88;
	canvas_background_slider_height = 14; /* Signed-background slider height in GUI pixels */
	canvas_background_value_x = 0; /* Signed-background percentage field GUI x, zero before toolbar layout */
	canvas_background_value_y = 0; /* Signed-background percentage field GUI y, zero before toolbar layout */
	canvas_background_value_width = 42; /* Signed-background percentage field width in GUI pixels */
	canvas_background_value_height = 22; /* Signed-background percentage field height in GUI pixels */

	/* Owned signed-brightness gradient surface, created on demand and freed with toolbar
	caches */
	canvas_background_gradient_surface = noone;
	canvas_background_gradient_key = ""; /* Empty gradient signature forces the first brightness-gradient rendering */
	hide_toolbar_button_width = 112; /* Width of the hide-toolbar control in GUI pixels */
	show_toolbar_button_width = 108; /* Width of the collapsed-toolbar show control in GUI pixels */
	show_toolbar_button_height = 30; /* Height of the collapsed-toolbar show control in GUI pixels */

	/* Mode described by the transient toolbar notice, initially drawing disabled */
	toolbar_mode_notice_enabled = false;
	toolbar_mode_notice_until = 0; /* current_time notice expiry, zero keeping the initial notice hidden */
	screenshot_status_text = ""; /* Transient screenshot or action feedback, empty before a result exists */

	/* Feedback starts neutral white and is replaced by the result's chosen color */
	screenshot_status_color = c_white;
	screenshot_status_until = 0; /* current_time feedback expiry, zero keeping initial status hidden */
	last_screenshot_filename = ""; /* Filename of the most recent successful screenshot, empty before saving */
	last_screenshot_path = ""; /* Full save path of the most recent successful screenshot, empty before saving */
	server_import_button_x = 16; /* Host import-button GUI x starts at 16 and is recalculated by host layout */
	server_import_button_y = 56; /* Host import-button GUI y starts at 56 and is recalculated by host layout */
	server_import_button_width = 140; /* Host import-button width in GUI pixels */
	server_import_button_height = 34; /* Host import-button height in GUI pixels */
	server_import_folder_button_x = 0; /* Host import-folder button GUI x, zero before host layout */
	server_import_folder_button_width = 118; /* Host import-folder button width in GUI pixels */
	server_save_log_button_x = 0; /* Host save-log button GUI x, zero before host layout */
	server_save_log_button_width = 96; /* Host save-log button width in GUI pixels */
	server_logs_folder_button_x = 0; /* Host log-folder button GUI x, zero before host layout */
	server_logs_folder_button_width = 118; /* Host log-folder button width in GUI pixels */
	server_logs_auto_save_button_x = 0; /* Host automatic-log-save toggle GUI x, zero before host layout */
	server_logs_auto_save_button_width = 136; /* Host automatic-log-save toggle width in GUI pixels */

	/* Opening the host log folder saves current logs by default, toggled through the host UI */
	server_logs_auto_save_on_open = true;
	server_import_hover = false; /* Host PNG-import button starts unhovered */
	server_import_folder_hover = false; /* Host import-folder button starts unhovered */
	server_save_log_hover = false; /* Host save-log button starts unhovered */
	server_logs_folder_hover = false; /* Host log-folder button starts unhovered */
	server_logs_auto_save_hover = false; /* Host automatic-log-save toggle starts unhovered */
	server_import_status_text = ""; /* Transient host import feedback starts empty before an import attempt */
	server_import_status_color = c_white; /* Host import feedback starts neutral white and changes with the result */
	server_import_status_until = 0; /* current_time expiry for import feedback, zero keeping it initially hidden */
	server_import_debug_lines = []; /* Host import diagnostic lines, empty before an import begins */
	server_import_debug_line_count = 0; /* Number of populated import diagnostic lines, zero before logging */
	server_import_debug_max_lines = 28; /* Maximum diagnostic lines retained for the host import display */
	#endregion /* Toolbar and Export State END */

	#region /* Drawing Diagnostic State */
	debug_overlay_enabled = false; /* Drawing diagnostics start hidden until explicitly toggled */
	debug_last_stage = "init"; /* Latest diagnosed drawing stage starts at constructor initialization */

	/* Initial diagnostic detail before input, replication, or rendering runs */
	debug_last_reason = "drawing debug overlay ready";
	debug_last_time = current_time; /* current_time timestamp of the initial diagnostic note */
	debug_update_count = 0; /* Client update calls observed, starting at zero */
	debug_validate_failures = 0; /* Rejected drawing commands observed, starting at zero */
	debug_last_validated_command = noone; /* Last accepted command reference, noone before any validation succeeds */
	debug_last_invalid_command = ""; /* Last rejected command description, empty before validation fails */
	debug_send_attempts = 0; /* Attempted local drawing sends, starting at zero */
	debug_send_successes = 0; /* Successful local drawing sends, starting at zero */
	debug_send_failures = 0; /* Failed local drawing sends, starting at zero */
	debug_last_send_result = noone; /* Last transport result, noone before any drawing send */
	debug_last_send_time = 0; /* current_time timestamp of the last send attempt, zero before sending */
	debug_last_send_mode = ""; /* Transport or submission mode of the last send, empty before sending */
	debug_last_command = noone; /* Last received command reference, noone before reception */
	debug_last_outgoing_command = noone; /* Last outgoing command reference, noone before local submission */
	debug_last_raw_command = noone; /* Last unvalidated received command, noone before reception */
	debug_last_local_command = noone; /* Last locally applied command, noone before local drawing */
	debug_last_outgoing_payload = ""; /* Last serialized outgoing command, empty before sending */
	debug_last_raw_payload = ""; /* Last received serialized command, empty before reception */
	debug_last_validated_payload = ""; /* Last serialized accepted command, empty before validation */
	debug_last_replication_status = "idle"; /* Human-readable replication state begins idle */
	debug_local_apply_count = 0; /* Locally submitted commands applied, starting at zero */
	debug_receive_count = 0; /* Incoming live drawing commands observed, starting at zero */
	debug_history_receive_count = 0; /* Incoming history items observed, starting at zero */
	debug_apply_count = 0; /* Command applications attempted, starting at zero */
	debug_apply_failures = 0; /* Command applications that failed, starting at zero */
	debug_surface_status = "none"; /* Surface diagnostic starts before a canvas surface exists */
	debug_last_camera_id = noone; /* Last sampled camera handle, noone before a pointer-to-world conversion */
	debug_last_mouse_gui_x = 0; /* Last sampled pointer GUI x, zero before sampling */
	debug_last_mouse_gui_y = 0; /* Last sampled pointer GUI y, zero before sampling */
	debug_mouse_world_valid = false; /* Pointer has not yet produced a valid room-space position */
	debug_raw_world_x = 0; /* Unclamped sampled world x in pixels, zero before sampling */
	debug_raw_world_y = 0; /* Unclamped sampled world y in pixels, zero before sampling */
	debug_mouse_world_x = 0; /* Validated pointer world x in pixels, zero before sampling */
	debug_mouse_world_y = 0; /* Validated pointer world y in pixels, zero before sampling */
	debug_mouse_reason = "not sampled"; /* Reason describing the last pointer conversion, initially unsampled */
	debug_last_toolbar_captured = false; /* Toolbar has not captured any pointer gesture at startup */
	debug_last_mouse_pressed = false; /* Last drawing-input press flag starts false before sampling */
	debug_last_mouse_down = false; /* Last drawing-input held flag starts false before sampling */
	debug_last_mouse_released = false; /* Last drawing-input release flag starts false before sampling */
	debug_last_moved_enough = false; /* No stroke distance check has yet permitted another segment */
	debug_server_received_count = 0; /* Host drawing packets received, starting at zero */
	debug_server_accept_count = 0; /* Host drawing packets accepted, starting at zero */
	debug_server_reject_count = 0; /* Host drawing packets rejected, starting at zero */
	debug_server_broadcast_count = 0; /* Host drawing broadcasts completed, starting at zero */
	debug_server_broadcast_failures = 0; /* Host drawing broadcasts that failed, starting at zero */
	debug_server_last_slot = noone; /* Last drawing sender's player slot, noone before a packet */
	debug_server_last_send_count = noone; /* Last broadcast transport result, noone before broadcasting */
	debug_server_last_history_sync = noone; /* Last history synchronization result, noone before a transfer */
	debug_server_last_history_slot = noone; /* Last recipient player slot for history, noone before a transfer */
	debug_server_history_sync_jobs = 0; /* Queued history-transfer count last observed, initially zero */
	debug_server_history_sync_detail = "idle"; /* Human-readable history-transfer diagnostic starts idle */
	#endregion /* Drawing Diagnostic State END */

	#region /* Session and Diagnostic Helpers */
	/// @description Check whether the shared client has an assigned player slot
	/// @returns {Bool} Whether a client struct exposes an ID other than noone
	is_active_client_session = function()
	{
		/* Use the shared client state for the session test rather than keeping a second
		drawing connection */
		var client = scr_get_client();

		/* An assigned ID marks an active drawing session. Check the struct and field first so
		an absent client returns false without an invalid access */
		return is_struct(client)
			&& variable_struct_exists(client, "ID")
			&& client.ID != noone;
	}

	/// @description Allow local single-player drawing or a completed shared-history synchronization
	/// @returns {Bool} Whether drawing may proceed without waiting for history
	client_history_sync_is_ready = function()
	{
		/* Read the shared client to distinguish a local game from a synchronized network
		session */
		var client = scr_get_client();

		/* Single-player has no remote history to wait for. Return ready only when the client
		actually exposes and enables that mode */
		if (is_struct(client)
		&& variable_struct_exists(client, "singleplayer_mode")
		&& client.singleplayer_mode)
		{
			return true;
		}

		/* Network sessions stay blocked until ordered history transfer and replay mark
		synchronization complete */
		return client_history_sync_complete;
	}

	/// @description Replace the drawing diagnostic stage, detail, and current_time timestamp
	/// @param {String} stage Diagnostic stage name, converted to text
	/// @param {String} reason Diagnostic detail, empty by default
	debug_note = function(stage, reason = "")
	{
		debug_last_stage = string(stage);
		debug_last_reason = string(reason);
		debug_last_time = current_time;
	}

	/// @description Read an optional diagnostic field without accessing a missing struct
	/// @param {Any} target Struct that may expose the requested optional diagnostic field
	/// @param {String} field_name Name of the optional struct member to read
	/// @param {Any} fallback Value returned for an absent target or field, undefined by default
	/// @returns {Any} Existing field value, or the supplied fallback
	debug_struct_field = function(target, field_name, fallback = undefined)
	{
		/* A missing or nonstruct diagnostic target cannot supply a field, so keep the caller's
		fallback */
		if (!is_struct(target))
		{
			return fallback;
		}

		/* Optional diagnostics may not exist on older state. Keep the fallback rather than
		accessing an absent member */
		if (!variable_struct_exists(target, field_name))
		{
			return fallback;
		}

		return target[$ field_name];
	}

	/// @description Read an available server slot username for drawing attribution
	/// @param {Real} slot Zero-based player slot in server state
	/// @returns {String} Slot username, or empty text when server state or slot is unavailable
	server_slot_display_name = function(slot)
	{
		/* Read the authoritative host state that owns the player-slot username array */
		var server = scr_get_server();

		/* An unavailable host, missing username array, or slot outside that array has no
		display name. Earlier checks protect the later length and entry reads */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "slot_usernames")
		|| !is_array(server.slot_usernames)
		|| slot == noone
		|| slot < 0
		|| slot >= array_length(server.slot_usernames))
		{
			return "";
		}

		return string(server.slot_usernames[slot]);
	}

	/// @description Format the shared network diagnostic label for a player slot
	/// @param {Real} slot Zero-based player slot in server state
	/// @returns {String} Shared network slot label
	server_slot_label = function(slot)
	{
		return scr_network_debug_server_slot_label(slot);
	}

	/// @description Describe the server player map through the network diagnostic service
	/// @returns {String} Current player-map summary
	server_slot_summary = function()
	{
		return scr_network_debug_player_map();
	}
	#endregion /* Session and Diagnostic Helpers END */

	#region /* Client Drawing Preferences */
	/// @description Convert legacy background names or numeric settings into a signed overlay amount
	/// @param {Any} raw_value Unnormalized saved preference or slider value
	/// @returns {Real} Brightness between negative one and positive one
	canvas_background_value_from_saved = function(raw_value)
	{
		/* Normalize saved spelling before matching older named-background settings */
		var clean_value = string_lower(string_trim(string(raw_value)));

		/* Legacy black and white names become moderate signed overlays. Off, normal, none, and
		empty names retain the room view. Other text reaches numeric conversion below */
		switch (clean_value)
		{
			case "black":
				return -0.55;
			case "white":
				return 0.55;
			case "none":
			case "off":
			case "normal":
			case "":
				return 0;
		}

		return clamp(real(raw_value), -1, 1);
	}

	/// @description Express the selected signed background brightness as a rounded percentage
	/// @returns {Real} Signed whole-number percentage
	canvas_background_display_percent = function()
	{
		return round(canvas_background_brightness * 100);
	}

	/// @description Format background brightness for the local drawing controls
	/// @returns {String} Signed percentage with a percent suffix
	canvas_background_text = function()
	{
		return string(canvas_background_display_percent()) + "%";
	}

	/// @description Apply a bounded local background preference and optionally save it
	/// @param {Any} raw_value Unnormalized saved preference or slider value
	/// @param {Bool} persist Whether to write the applied preference to the local INI, true by default
	/// @returns {Bool} True after applying the preference, even if persistence reports a failure separately
	set_canvas_background_brightness = function(raw_value, persist = true)
	{
		canvas_background_brightness = clamp(real(raw_value), -1, 1);

		/* Snap very small overlays back to the normal view so a slider drag can land on a
		clear zero. Larger amounts retain their selected brightness */
		if (abs(canvas_background_brightness) < 0.025)
		{
			canvas_background_brightness = 0;
		}

		debug_note("background brightness", canvas_background_text());

		/* Save explicit preference changes when requested. Drag previews and initial loading
		pass false so they only update local state */
		if (persist)
		{
			save_canvas_background_setting();
		}

		return true;
	}

	/// @description Restore current or legacy local background settings and initialize the animated overlay
	/// @returns {Real} Applied signed brightness, with zero retained when no setting is found
	load_canvas_background_setting = function()
	{
		/* Start with normal room view so a missing file or missing preference has a meaningful
		default */
		var saved_background = "0";

		try
		{
			/* Only open an existing settings file. Without it the default background remains
			zero */
			if (file_exists(client_settings_file))
			{
				ini_open(client_settings_file);

				/* Prefer the current numeric brightness key when available */
				if (ini_key_exists(drawing_settings_section, canvas_background_key))
				{
					saved_background = ini_read_string(drawing_settings_section, canvas_background_key, "0");
				}

				/* If the current key is absent, accept the legacy background name instead.
				With neither key, retain normal room view */
				else if (ini_key_exists(drawing_settings_section, canvas_background_legacy_key))
				{
					saved_background = ini_read_string(drawing_settings_section, canvas_background_legacy_key, "0");
				}
				ini_close();
			}
		}
		catch(e)
		{
			/* Use an exception's message when its struct exposes one, otherwise stringify the
			exception so loading failures remain readable */
			var load_error = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			debug_error("Could not load canvas background brightness setting: " + load_error);
		}

		set_canvas_background_brightness(canvas_background_value_from_saved(saved_background), false);
		canvas_background_brightness_lerp = canvas_background_brightness;
		return canvas_background_brightness;
	}

	/// @description Write the selected background brightness to the shared client INI
	/// @returns {Bool} Whether the INI write completed without an exception
	save_canvas_background_setting = function()
	{
		try
		{
			ini_open(client_settings_file);
			ini_write_real(drawing_settings_section, canvas_background_key, canvas_background_brightness);
			ini_close();
			return true;
		}
		catch(e)
		{
			/* Extract a structured exception message when available, with the raw exception as
			the fallback diagnostic */
			var save_error = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			debug_error("Could not save canvas background brightness setting: " + save_error);
			return false;
		}
	}

	/// @description Cycle between the white overlay, black overlay, and normal room view
	/// @returns {Bool} Brightness setter result
	toggle_canvas_background = function()
	{
		/* A black overlay cycles back to normal view. Other states continue to the
		white-overlay check */
		if (canvas_background_brightness < -0.01)
		{
			return set_canvas_background_brightness(0, true);
		}

		/* A white overlay cycles to black. Normal view, including values near zero, reaches
		the white overlay below */
		if (canvas_background_brightness > 0.01)
		{
			return set_canvas_background_brightness(-0.55, true);
		}

		return set_canvas_background_brightness(0.55, true);
	}

	/// @description Accept readable Boolean preference spellings and numeric values
	/// @param {Any} raw_value Unnormalized saved preference or slider value
	/// @param {Bool} fallback_value Preference retained when saved input is empty or unconvertible
	/// @returns {Bool} Decoded toggle, or fallback_value for empty or invalid input
	bool_setting_value_from_saved = function(raw_value, fallback_value)
	{
		/* Normalize spelling and surrounding spaces before comparing saved toggle values */
		var clean_value = string_lower(string_trim(string(raw_value)));

		/* Recognized true spellings enable the setting and false spellings disable it. Empty
		text keeps the caller's default. Other text is tried as a number below */
		switch (clean_value)
		{
			case "1":
			case "true":
			case "yes":
			case "on":
				return true;
			case "0":
			case "false":
			case "no":
			case "off":
				return false;
			case "":
				return fallback_value;
		}

		try
		{
			/* A nonzero saved number enables the setting and zero disables it, matching the
			numeric INI toggle format */
			return real(clean_value) != 0;
		}
		catch(e)
		{
			/* Unconvertible saved text retains the supplied preference default rather than
			aborting loading */
			return fallback_value;
		}
	}

	/// @description Apply the local dimming preference and optionally save it
	/// @param {Bool} enabled Whether inactive paint layers should be dimmed locally
	/// @param {Bool} persist Whether to write the applied preference to the local INI, true by default
	/// @returns {Bool} True after applying the toggle, with save failures diagnosed separately
	set_inactive_layer_dim = function(enabled, persist = true)
	{
		dim_inactive_layers = enabled;

		/* Start the diagnostic label as off so disabled dimming needs no replacement */
		var dim_state_text = "off";

		/* Use the on label only for enabled dimming, leaving off otherwise for the diagnostic
		note */
		if (dim_inactive_layers)
		{
			dim_state_text = "on";
		}
		debug_note("dim inactive layers", dim_state_text);

		/* Persist requested toggle changes. Loading passes false to restore local state
		without rewriting the INI */
		if (persist)
		{
			save_inactive_layer_dim_setting();
		}

		return true;
	}

	/// @description Restore the local inactive-layer toggle, defaulting to enabled
	/// @returns {Bool} Applied dimming preference
	load_inactive_layer_dim_setting = function()
	{
		/* Default to enabled dimming for clients without a saved preference */
		var saved_dim = "1";

		try
		{
			/* Read only an existing INI, retaining enabled dimming when no file has been saved */
			if (file_exists(client_settings_file))
			{
				ini_open(client_settings_file);

				/* Restore a saved dimming key when present. Older files without the key keep
				the enabled default */
				if (ini_key_exists(drawing_settings_section, inactive_layer_dim_key))
				{
					saved_dim = ini_read_string(drawing_settings_section, inactive_layer_dim_key, "1");
				}
				ini_close();
			}
		}
		catch(e)
		{
			/* Keep the exception's printable form until a more specific message can be
			extracted */
			var load_error = string(e);

			/* Prefer a structured error message when present, otherwise retain the printable
			exception */
			if (is_struct(e) && variable_struct_exists(e, "message"))
			{
				load_error = string(e.message);
			}
			debug_error("Could not load inactive layer dim setting: " + load_error);
		}

		set_inactive_layer_dim(bool_setting_value_from_saved(saved_dim, true), false);
		return dim_inactive_layers;
	}

	/// @description Persist the local inactive-layer toggle as zero or one
	/// @returns {Bool} Whether the INI write completed without an exception
	save_inactive_layer_dim_setting = function()
	{
		try
		{
			/* The saved toggle starts at zero for disabled dimming */
			var saved_value = 0;

			/* Encode enabled dimming as one, leaving zero for disabled so the INI uses numeric
			Boolean values */
			if (dim_inactive_layers)
			{
				saved_value = 1;
			}

			ini_open(client_settings_file);
			ini_write_real(drawing_settings_section, inactive_layer_dim_key, saved_value);
			ini_close();
			return true;
		}
		catch(e)
		{
			/* Begin with the exception's printable form for a useful save diagnostic */
			var save_error = string(e);

			/* A structured message supplies a clearer save failure. Without it, retain the
			printable exception */
			if (is_struct(e) && variable_struct_exists(e, "message"))
			{
				save_error = string(e.message);
			}
			debug_error("Could not save inactive layer dim setting: " + save_error);
			return false;
		}
	}

	/// @description Invert and save the local inactive-layer dimming preference
	/// @returns {Bool} Toggle setter result
	toggle_inactive_layer_dim = function()
	{
		/* Invert the current dimming flag and persist the new choice so the toolbar toggle
		survives restart */
		return set_inactive_layer_dim(!dim_inactive_layers, true);
	}

	/// @description Normalize an RGBA color into the recent-swatch byte format
	/// @param {Real} red Red channel byte before normalization
	/// @param {Real} green Green channel byte before normalization
	/// @param {Real} blue Blue channel byte before normalization
	/// @param {Real} alpha Opacity byte, fully opaque at 255 and transparent at zero. Defaults to 255 when omitted
	/// @returns {Struct} Fresh color with r, g, b, and a bytes
	recent_color_value = function(red, green, blue, alpha = 255)
	{
		/* The r, g, b, and a members store red, green, blue, and opacity bytes respectively.
		Clamp each to the PNG channel range before keeping a recent color */
		return
		{
			r: clamp(floor(real(red)), 0, 255),
			g: clamp(floor(real(green)), 0, 255),
			b: clamp(floor(real(blue)), 0, 255),
			a: clamp(floor(real(alpha)), 0, 255)
		};
	}

	/// @description Match a complete stored swatch against all four supplied channel bytes
	/// @param {Any} entry Recent-swatch entry to validate and compare
	/// @param {Real} red Red channel byte before normalization
	/// @param {Real} green Green channel byte before normalization
	/// @param {Real} blue Blue channel byte before normalization
	/// @param {Real} alpha Opacity byte, fully opaque at 255 and transparent at zero. Defaults to 255 when omitted
	/// @returns {Bool} Whether the entry contains and matches every RGBA component
	recent_color_matches = function(entry, red, green, blue, alpha)
	{
		/* A recent entry matches only when all four fields exist and equal the requested
		channels. Validate its shape first to avoid absent-field reads and distinguish
		opacity as well as color */
		return is_struct(entry)
			&& variable_struct_exists(entry, "r")
			&& variable_struct_exists(entry, "g")
			&& variable_struct_exists(entry, "b")
			&& variable_struct_exists(entry, "a")
			&& entry.r == red
			&& entry.g == green
			&& entry.b == blue
			&& entry.a == alpha;
	}

	/// @description Check whether a color already appears in the fixed palette
	/// @param {Real} red Red channel byte before normalization
	/// @param {Real} green Green channel byte before normalization
	/// @param {Real} blue Blue channel byte before normalization
	/// @param {Real} alpha Opacity byte, fully opaque at 255 and transparent at zero. Defaults to 255 when omitted
	/// @returns {Bool} Whether any fixed swatch matches all RGBA bytes
	recent_color_matches_fixed_swatch = function(red, green, blue, alpha)
	{
		/* Scan fixed palette slots from index zero until a full RGBA match is found or every
		swatch is checked */
		for (var swatch_index = 0; swatch_index < array_length(swatches); swatch_index++)
		{
			/* A matching fixed swatch needs no additional recent slot. Return immediately so
			later palette entries are unnecessary */
			if (recent_color_matches(swatches[swatch_index], red, green, blue, alpha))
			{
				return true;
			}
		}

		/* No fixed palette entry matched, so this color is eligible for a recent slot */
		return false;
	}

	/// @description Serialize up to the visible recent-swatch capacity for the client INI
	/// @returns {String} Pipe-separated colors with comma-separated r,g,b,a bytes
	serialize_recent_colors = function()
	{
		/* Build the INI string from empty text so the first accepted color needs no separator */
		var serialized = "";

		/* Only serialize the number of recent entries the toolbar can display */
		var color_count = min(recent_swatch_capacity, array_length(recent_swatches));

		/* Visit recent entries from the newest at index zero through the visible capacity,
		stopping before any unavailable array entry */
		for (var color_index = 0; color_index < color_count; color_index++)
		{
			/* Use the current recent-swatch struct as the source of one serialized RGBA entry */
			var entry = recent_swatches[color_index];

			/* Skip a malformed nonstruct entry rather than reading channel members from it */
			if (!is_struct(entry))
			{
				continue;
			}

			/* Add a separator only after a previous color has been written so the saved string
			has no leading pipe */
			if (serialized != "")
			{
				serialized += "|";
			}
			serialized += string(entry.r) + "," + string(entry.g) + "," + string(entry.b) + "," + string(entry.a);
		}
		return serialized;
	}

	/// @description Persist the recent palette to the local client INI
	/// @returns {Bool} Whether serialization and writing completed without an exception
	save_recent_colors = function()
	{
		try
		{
			ini_open(client_settings_file);
			ini_write_string(drawing_settings_section, recent_colors_key, serialize_recent_colors());
			ini_close();
			return true;
		}
		catch(e)
		{
			try { ini_close(); } catch(close_error) {}

			/* Prefer an available structured exception message, otherwise retain the printable
			exception for the save diagnostic */
			var save_error = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			debug_error("Could not save recent drawing colors: " + save_error);
			return false;
		}
	}

	/// @description Restore valid unique nontransparent colors that are absent from the fixed palette
	/// @returns {Bool} Whether reading and parsing completed, including an empty saved palette
	load_recent_colors = function()
	{
		recent_swatches = [];

		/* Begin with no serialized palette so absent local settings restore an empty recent
		list */
		var serialized = "";
		try
		{
			/* Read the recent palette only if its shared client INI exists. Otherwise keep the
			empty serialized default */
			if (file_exists(client_settings_file))
			{
				ini_open(client_settings_file);
				serialized = ini_read_string(drawing_settings_section, recent_colors_key, "");
				ini_close();
			}
		}
		catch(e)
		{
			try { ini_close(); } catch(close_error) {}

			/* Extract a structured load message when present and fall back to the exception's
			printable form */
			var load_error = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			debug_error("Could not load recent drawing colors: " + load_error);
			return false;
		}

		/* Empty or whitespace-only saved text is a valid empty palette. Stop successfully
		before attempting to split color entries */
		if (string_trim(serialized) == "")
		{
			return true;
		}

		try
		{
			/* Split the saved palette into ordered color records using its pipe separator */
			var saved_entries = string_split(serialized, "|");

			/* Walk saved records from the first entry until all records are checked or the
			visible recent palette is full */
			for (var saved_index = 0; saved_index < array_length(saved_entries); saved_index++)
			{
				/* Stop once enough recent colors have been restored, avoiding work on entries
				that cannot be displayed */
				if (array_length(recent_swatches) >= recent_swatch_capacity)
				{
					break;
				}

				/* Split this record into its expected red, green, blue, and alpha byte fields */
				var parts = string_split(saved_entries[saved_index], ",");

				/* A record without exactly four channels cannot be restored safely, so skip it
				and check the next saved color */
				if (array_length(parts) != 4)
				{
					continue;
				}

				/* The red, green, blue, and alpha locals are whole-number RGBA bytes parsed
				from this saved record */
				var red = floor(real(parts[0]));
				var green = floor(real(parts[1]));
				var blue = floor(real(parts[2]));
				var alpha = floor(real(parts[3]));

				/* Reject channels outside byte range and fully transparent colors. These
				cannot become useful visible recent swatches */
				if (red < 0 || red > 255
				|| green < 0 || green > 255
				|| blue < 0 || blue > 255
				|| alpha <= 0 || alpha > 255)
				{
					continue;
				}

				/* Colors already present in the fixed palette do not need a recent slot, so
				continue with the next saved entry */
				if (recent_color_matches_fixed_swatch(red, green, blue, alpha))
				{
					continue;
				}

				/* Assume this saved color is new until an existing recent entry matches it */
				var duplicate = false;

				/* Compare restored recent colors from index zero, ending at a matching
				duplicate or the current list length */
				for (var recent_index = 0; recent_index < array_length(recent_swatches); recent_index++)
				{
					/* A complete RGBA match marks this color as already restored and ends the
					duplicate scan */
					if (recent_color_matches(recent_swatches[recent_index], red, green, blue, alpha))
					{
						duplicate = true;
						break;
					}
				}

				/* Append only a new color. Duplicate records leave the restored palette
				unchanged */
				if (!duplicate)
				{
					recent_swatches[array_length(recent_swatches)] = recent_color_value(red, green, blue, alpha);
				}
			}
		}
		catch(e)
		{
			recent_swatches = [];

			/* Prefer an available structured parse error and otherwise stringify the exception
			after clearing the partially restored palette */
			var parse_error = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			debug_error("Could not parse recent drawing colors: " + parse_error);
			return false;
		}

		return true;
	}

	/// @description Remember a new nontransparent color at the front of the local recent palette
	/// @param {Real} red Red channel byte before normalization
	/// @param {Real} green Green channel byte before normalization
	/// @param {Real} blue Blue channel byte before normalization
	/// @param {Real} alpha Opacity byte, fully opaque at 255 and transparent at zero. Defaults to 255 when omitted
	/// @returns {Bool} Whether a new entry was added, with save failure reported separately
	record_recent_color = function(red, green, blue, alpha = 255)
	{
		/* Normalize the supplied channels into the RGBA byte struct used by the palette */
		var entry = recent_color_value(red, green, blue, alpha);

		/* Fully transparent colors do not provide a visible recent swatch, so leave the
		palette unchanged */
		if (entry.a <= 0)
		{
			return false;
		}

		/* A fixed palette match already has a selectable slot, so do not duplicate it in the
		recent list */
		if (recent_color_matches_fixed_swatch(entry.r, entry.g, entry.b, entry.a))
		{
			return false;
		}

		/* Search every current recent entry from index zero, stopping on a matching RGBA color */
		for (var recent_index = 0; recent_index < array_length(recent_swatches); recent_index++)
		{
			/* An already recorded color leaves the existing order unchanged rather than
			inserting a duplicate */
			if (recent_color_matches(recent_swatches[recent_index], entry.r, entry.g, entry.b, entry.a))
			{
				return false;
			}
		}

		array_insert(recent_swatches, 0, entry);

		/* After inserting a new color at the front, discard entries beyond the toolbar's
		capacity. Shorter lists need no trimming */
		if (array_length(recent_swatches) > recent_swatch_capacity)
		{
			array_delete(recent_swatches, recent_swatch_capacity, array_length(recent_swatches) - recent_swatch_capacity);
		}

		save_recent_colors();
		debug_note("recent color recorded", string(entry.r) + "," + string(entry.g) + "," + string(entry.b) + "," + string(entry.a));
		return true;
	}

	/// @description Record colors only from painting tools that use the command RGBA value
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {Bool} Whether the command added a new recent swatch
	record_recent_color_from_command = function(command)
	{
		/* Only structured drawing commands can provide tool and color fields, so reject other
		values before reading them */
		if (!is_struct(command))
		{
			return false;
		}

		/* Pen, line, rectangle, circle, fill, and text use the command color. Other tools,
		including erasing and stamps, do not add that RGBA value to the recent palette */
		switch (command.tool_id)
		{
			case DRAW_TOOL_PEN:
			case DRAW_TOOL_LINE:
			case DRAW_TOOL_RECTANGLE:
			case DRAW_TOOL_CIRCLE:
			case DRAW_TOOL_FILL:
			case DRAW_TOOL_TEXT:
				break;
			default:
				return false;
		}

		/* Read the command's opacity through the compatibility helper so older commands use
		its defined fallback */
		var alpha = command_alpha(command);

		/* Transparent drawing adds no visible recent color, so skip it before recording the
		RGB channels */
		if (alpha <= 0)
		{
			return false;
		}
		return record_recent_color(command.color_r, command.color_g, command.color_b, alpha);
	}

	/// @description Map GUI pointer x into the signed black-to-white overlay range
	/// @param {Real} mx Pointer x in GUI pixels
	/// @returns {Real} Clamped signed brightness between negative one and positive one
	canvas_background_slider_value_from_mouse = function(mx)
	{
		/* Map pointer GUI x into the slider's zero-to-one fraction. Clamp outside drags and
		guard a zero-width layout before converting to signed brightness */
		var amount = clamp((mx - canvas_background_slider_x) / max(1, canvas_background_slider_width), 0, 1);
		return amount * 2 - 1;
	}

	/// @description Apply a background slider drag without writing the INI on each sample
	/// @param {Real} mx Pointer x in GUI pixels
	/// @returns {Bool} True after applying the drag value
	update_canvas_background_slider_from_mouse = function(mx)
	{
		set_canvas_background_brightness(canvas_background_slider_value_from_mouse(mx), false);
		return true;
	}
	#endregion /* Client Drawing Preferences END */

	#region /* Command Access and Author Identity */
	/// @description Read the explicit brush diameter for later command validation
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {Any} Stored brush width, or undefined when unavailable
	command_brush_px = function(command)
	{
		/* A nonstruct command has no brush field to validate, so return undefined rather than
		inventing a diameter */
		if (!is_struct(command))
		{
			return undefined;
		}

		/* Return the stored diameter when the field exists. Missing brush width remains
		undefined so command validation can reject it */
		if (variable_struct_exists(command, "brush_px"))
		{
			return command.brush_px;
		}

		return undefined;
	}

	/// @description Read a positive whole-number layer identifier with a local-layer fallback
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {Real} Command layer ID, or active_layer_id when omitted
	command_layer_id = function(command)
	{
		/* An explicit layer field overrides the local selection after whole-number coercion.
		Missing command state keeps active_layer_id for legacy callers */
		if (is_struct(command)
		&& variable_struct_exists(command, "layer_id"))
		{
			return max(1, floor(real(command.layer_id)));
		}

		return active_layer_id;
	}

	/// @description Read the first optional tool payload value without breaking older commands
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {Any} Stored extra_a value, or zero
	command_extra_a = function(command)
	{
		/* Keep an available first tool extension value. Commands without it use zero for
		compatibility */
		if (is_struct(command)
		&& variable_struct_exists(command, "extra_a"))
		{
			return command.extra_a;
		}

		return 0;
	}

	/// @description Read the second optional tool payload value without breaking older commands
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {Any} Stored extra_b value, or zero
	command_extra_b = function(command)
	{
		/* Keep an available second tool extension value. Commands without it use zero for
		compatibility */
		if (is_struct(command)
		&& variable_struct_exists(command, "extra_b"))
		{
			return command.extra_b;
		}

		return 0;
	}

	/// @description Read optional command text used by drawing text and fill compatibility
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {String} Command text, or empty text when omitted
	command_text_value = function(command)
	{
		/* An explicit text field supplies tool text. Missing text becomes empty so older
		drawing commands still decode */
		if (is_struct(command)
		&& variable_struct_exists(command, "text"))
		{
			return string(command.text);
		}

		return "";
	}

	/// @description Resolve modern and legacy flags for sampling all visible layers during a fill
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {Bool} Whether a recognized flag requests visible-layer sampling
	command_fill_sample_visible = function(command)
	{
		/* A nonstruct command cannot request a fill sampling mode, so default to the current
		layer */
		if (!is_struct(command))
		{
			return false;
		}

		/* Read the optional modern visible-layer flag, defaulting to false for older commands */
		var raw_visible = debug_struct_field(command, "fill_sample_visible", false);

		/* A nonzero numeric flag enables visible-layer sampling. Other values continue to the
		readable spelling checks */
		if (is_real(raw_visible)
		&& real(raw_visible) != 0)
		{
			return true;
		}

		/* Normalize a nonnumeric modern flag for the accepted visible-layer names */
		var raw_visible_text = string_lower(string_trim(string(raw_visible)));

		/* Any recognized true or visible-layer spelling requests sampling the composite.
		Unrecognized names fall through to the older text payload */
		if (raw_visible_text == "true"
		|| raw_visible_text == "visible"
		|| raw_visible_text == "visible_layers"
		|| raw_visible_text == "all_visible"
		|| raw_visible_text == "all visible"
		|| raw_visible_text == "1")
		{
			return true;
		}

		/* Normalize the legacy command-text payload used by fills before the dedicated
		sampling field existed */
		var fill_text = string_lower(string_trim(command_text_value(command)));

		/* Only recognized visible-layer spellings in the legacy text select composite
		sampling. Other text leaves the fill sampling its current layer */
		return fill_text == "visible"
			|| fill_text == "visible_layers"
			|| fill_text == "all_visible"
			|| fill_text == "all visible"
			|| fill_text == "1";
	}

	/// @description Accept only nonnegative whole-number player-slot identifiers
	/// @param {Any} raw_player_id Value expected to name a nonnegative whole-number player slot
	/// @returns {Real} Player slot, or noone for missing, fractional, negative, or unconvertible values
	coerce_player_id = function(raw_player_id)
	{
		/* Missing input and noone do not identify a player slot, so preserve the unknown-slot
		sentinel before numeric conversion */
		if (is_undefined(raw_player_id)
		|| raw_player_id == noone)
		{
			return noone;
		}

		try
		{
			/* Convert the supplied player identifier to a number for whole-slot validation */
			var player_id_value = real(raw_player_id);

			/* Use its floored value as the candidate zero-based array index */
			var player_id_index = floor(player_id_value);

			/* Negative or fractional IDs cannot name a whole player slot. Return noone so
			attribution does not use a truncated or invalid index */
			if (player_id_index < 0
			|| player_id_value != player_id_index)
			{
				return noone;
			}

			return player_id_index;
		}
		catch(e)
		{
			/* A value that cannot become a number has no usable player slot, so report noone */
			return noone;
		}
	}

	/// @description Read an optional command author slot through the shared ID validator
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {Real} Author player slot, or noone when unavailable
	command_author_player_id = function(command)
	{
		/* Missing author state or an explicit unknown ID has no player attribution. Check
		field existence before reading it */
		if (!is_struct(command)
		|| !variable_struct_exists(command, "author_player_id")
		|| is_undefined(command.author_player_id)
		|| command.author_player_id == noone)
		{
			return noone;
		}

		return coerce_player_id(command.author_player_id);
	}

	/// @description Read a nonblank command author name through username sanitization
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {String} Sanitized author name, or empty text
	command_author_name = function(command)
	{
		/* A command without an author-name field has no name to sanitize, so retain empty
		attribution */
		if (!is_struct(command)
		|| !variable_struct_exists(command, "author_name"))
		{
			return "";
		}

		/* Whitespace-only names contain no displayed identity and remain empty instead of
		passing through username sanitization */
		if (string_trim(string(command.author_name)) == "")
		{
			return "";
		}

		return chat_sanitize_username(command.author_name);
	}

	/// @description Read a nonnegative connection-specific drawing author identifier
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {Real} Whole-number undo author ID, or zero when unavailable
	command_undo_author_id = function(command)
	{
		/* Without an undo-author field, return zero to mark history lacking a
		connection-specific author */
		if (!is_struct(command)
		|| !variable_struct_exists(command, "undo_author_id"))
		{
			return 0;
		}

		return max(0, floor(real(command.undo_author_id)));
	}

	/// @description Read a nonnegative stroke-group identifier for undo matching
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {Real} Whole-number undo group ID, or zero when unavailable
	command_undo_id = function(command)
	{
		/* Without an undo-group field, return zero to mark history lacking an undoable stroke
		group */
		if (!is_struct(command)
		|| !variable_struct_exists(command, "undo_id"))
		{
			return 0;
		}

		return max(0, floor(real(command.undo_id)));
	}

	/// @description Provide a positive author ID from the assigned local undo identity
	/// @returns {Real} Local author ID clamped to at least one
	make_local_undo_author_id = function()
	{
		return max(1, local_undo_author_id);
	}

	/// @description Store the assigned player slot, display name, and connection-specific undo author
	/// @param {Any} player_slot_id Assigned local zero-based player slot
	/// @param {String} username Local drawing author display name
	/// @param {Real} drawing_author_id Server-assigned connection-specific undo author identifier
	/// @returns {Bool} True after replacing drawing attribution
	set_local_identity = function(player_slot_id, username, drawing_author_id)
	{
		local_player_id = coerce_player_id(player_slot_id);
		local_player_name = string(username);
		local_undo_author_id = max(1, floor(real(drawing_author_id)));
		debug_note("drawing identity set", scr_network_debug_id_label(local_player_id, local_player_name) + " author=" + string(local_undo_author_id));
		return true;
	}

	/// @description Refresh available slot and username fields without replacing the assigned undo author
	/// @returns {Bool} False without a valid client ID, otherwise true whether or not fields changed
	refresh_local_identity_from_client = function()
	{
		/* Read the current client assignment to refresh drawing attribution after connection
		changes */
		var client = scr_get_client();

		/* Until the client has an assigned ID, leave the existing drawing identity unchanged
		and report that refresh could not proceed */
		if (!is_struct(client)
		|| !variable_struct_exists(client, "ID")
		|| client.ID == noone)
		{
			return false;
		}

		/* Normalize the assigned client ID into a whole nonnegative player slot */
		var client_player_id = coerce_player_id(client.ID);

		/* An invalid assigned slot cannot replace local attribution, so stop without changing
		it */
		if (client_player_id == noone)
		{
			return false;
		}

		/* Track whether either attribution field changes so diagnostics only report actual
		refreshes */
		var refreshed = false;

		/* Replace an invalid or different local slot with the current assignment. An unchanged
		numeric slot needs no update */
		if (!is_real(local_player_id)
		|| local_player_id != client_player_id)
		{
			local_player_id = client_player_id;
			refreshed = true;
		}

		/* Begin without a replacement name so unavailable or blank client names preserve the
		current drawing name */
		var client_player_name = "";

		/* Prefer the nonblank server-assigned username because it is the accepted display
		identity */
		if (variable_struct_exists(client, "assigned_username")
		&& string_trim(string(client.assigned_username)) != "")
		{
			client_player_name = string(client.assigned_username);
		}

		/* If no assigned name is available, use a nonblank requested name. Without either,
		keep the current drawing name */
		else if (variable_struct_exists(client, "requested_username")
		&& string_trim(string(client.requested_username)) != "")
		{
			client_player_name = string(client.requested_username);
		}

		/* Only a nonempty different name replaces local attribution, preventing unavailable
		client state from clearing a known name */
		if (client_player_name != ""
		&& local_player_name != client_player_name)
		{
			local_player_name = client_player_name;
			refreshed = true;
		}

		/* Log a refresh only when a slot or name changed. Unchanged identity creates no
		additional diagnostic note */
		if (refreshed)
		{
			debug_note("drawing identity refreshed", scr_network_debug_id_label(local_player_id, local_player_name) + " author=" + string(local_undo_author_id));
		}

		return true;
	}

	/// @description Allocate the next local stroke-group ID and make it the active group
	/// @returns {Real} New active undo group ID
	begin_local_undo_group = function()
	{
		active_undo_group_id = next_local_undo_id;
		next_local_undo_id++;
		return active_undo_group_id;
	}

	/// @description Clear the active undo group when a stroke or compound action ends
	/// @returns {Bool} True after releasing the group
	end_local_undo_group = function()
	{
		active_undo_group_id = 0;
		return true;
	}

	/// @description Keep the active stroke group or allocate one if no group is active
	/// @returns {Real} Active undo group ID
	ensure_local_undo_group = function()
	{
		/* Zero or negative means no stroke group is active. Allocate one for this action,
		otherwise continue using the existing group */
		if (active_undo_group_id <= 0)
		{
			return begin_local_undo_group();
		}

		return active_undo_group_id;
	}
	#endregion /* Command Access and Author Identity END */

	#region /* Action Cooldowns */
	/// @description Select the local duration for fill, stamp, undo, or redo
	/// @param {String} action_key Action key, recognizing fill, stamp, undo, and redo for local waits
	/// @returns {Real} Cooldown duration in milliseconds, or zero for an unrecognized action
	action_cooldown_duration = function(action_key)
	{
		/* Fill and stamp have their own durations. Undo and redo share the history duration.
		An unrecognized action reaches the zero-duration fallback */
		switch (string(action_key))
		{
			case "fill":
				return fill_action_cooldown_ms;
			case "stamp":
				return stamp_action_cooldown_ms;
			case "undo":
			case "redo":
				return history_action_cooldown_ms;
		}

		return 0;
	}

	/// @description Select a readable action label for cooldown feedback
	/// @param {String} action_key Action key, recognizing fill, stamp, undo, and redo for local waits
	/// @returns {String} Recognized action label, or Action
	action_cooldown_label = function(action_key)
	{
		/* Choose the matching readable action label for cooldown feedback. Unrecognized keys
		fall through to the generic Action label */
		switch (string(action_key))
		{
			case "fill":
				return "Fill";
			case "stamp":
				return "Stamp";
			case "undo":
				return "Undo";
			case "redo":
				return "Redo";
		}

		return "Action";
	}

	/// @description Select the local current_time deadline for an action
	/// @param {String} action_key Action key, recognizing fill, stamp, undo, and redo for local waits
	/// @returns {Real} Action deadline in milliseconds, or zero for an unrecognized action
	action_cooldown_until = function(action_key)
	{
		/* Each recognized action reads its own deadline, including separate undo and redo
		waits. Unrecognized keys have no local wait and return zero */
		switch (string(action_key))
		{
			case "fill":
				return fill_cooldown_until;
			case "stamp":
				return stamp_cooldown_until;
			case "undo":
				return undo_cooldown_until;
			case "redo":
				return redo_cooldown_until;
		}

		return 0;
	}

	/// @description Replace the selected local action's current_time deadline
	/// @param {String} action_key Action key, recognizing fill, stamp, undo, and redo for local waits
	/// @param {Real} cooldown_until Scheduled action deadline on the current_time millisecond clock
	/// @returns {Bool} Whether the action had a known cooldown field
	set_action_cooldown_until = function(action_key, cooldown_until)
	{
		/* Update only the deadline belonging to the recognized action. Unknown keys change no
		state and return false */
		switch (string(action_key))
		{
			case "fill":
				fill_cooldown_until = cooldown_until;
				return true;
			case "stamp":
				stamp_cooldown_until = cooldown_until;
				return true;
			case "undo":
				undo_cooldown_until = cooldown_until;
				return true;
			case "redo":
				redo_cooldown_until = cooldown_until;
				return true;
		}

		return false;
	}

	/// @description Measure the selected action's unexpired wait on the current_time clock
	/// @param {String} action_key Action key, recognizing fill, stamp, undo, and redo for local waits
	/// @returns {Real} Nonnegative milliseconds remaining
	action_cooldown_remaining_ms = function(action_key)
	{
		return max(0, action_cooldown_until(action_key) - current_time);
	}

	/// @description Check whether the selected action has finished waiting
	/// @param {String} action_key Action key, recognizing fill, stamp, undo, and redo for local waits
	/// @returns {Bool} Whether no cooldown milliseconds remain
	action_cooldown_is_ready = function(action_key)
	{
		/* No remaining milliseconds means the action can run. A positive wait keeps it
		unavailable until its current_time deadline */
		return action_cooldown_remaining_ms(action_key) <= 0;
	}

	/// @description Convert the remaining wait into a zero-to-one toolbar readiness amount
	/// @param {String} action_key Action key, recognizing fill, stamp, undo, and redo for local waits
	/// @returns {Real} Clamped progress from waiting to ready
	action_cooldown_ready_fraction = function(action_key)
	{
		/* Use the action duration in milliseconds as the progress denominator, with one
		preventing division by zero for unthrottled actions */
		var duration = max(1, action_cooldown_duration(action_key));
		return clamp(1 - action_cooldown_remaining_ms(action_key) / duration, 0, 1);
	}

	/// @description Reject a waiting action with feedback or reserve its next local cooldown
	/// @param {String} action_key Action key, recognizing fill, stamp, undo, and redo for local waits
	/// @returns {Bool} Whether the action may proceed
	try_start_action_cooldown = function(action_key)
	{
		/* Measure the current action wait in milliseconds before reserving another cooldown */
		var remaining_ms = action_cooldown_remaining_ms(action_key);

		/* An active wait rejects the action and shows its remaining time. Expired waits
		continue to reserve the next deadline */
		if (remaining_ms > 0)
		{
			/* Convert the remaining milliseconds to a one-decimal seconds label, keeping very
			short waits visibly above zero */
			var seconds_text = string_format(max(0.1, remaining_ms / 1000), 1, 1);

			/* Use the readable action name in the rejection message and diagnostic stage */
			var label = action_cooldown_label(action_key);
			set_screenshot_status(label + " cooldown: " + seconds_text + "s", make_color_rgb(255, 220, 95));
			debug_note(string_lower(label) + " cooldown", string(ceil(remaining_ms)) + "ms");
			return false;
		}

		/* Select this action's configured local wait duration in milliseconds */
		var duration = action_cooldown_duration(action_key);

		/* Only actions with a positive duration receive a new deadline. Unknown or unthrottled
		actions are allowed without changing one */
		if (duration > 0)
		{
			set_action_cooldown_until(action_key, current_time + duration);
		}

		return true;
	}

	/// @description Reserve a recognized action's next local cooldown without checking its previous wait
	/// @param {String} action_key Action key, recognizing fill, stamp, undo, and redo for local waits
	/// @returns {Bool} True after processing the action
	start_action_cooldown = function(action_key)
	{
		/* Read the configured action duration in milliseconds for an unconditional cooldown
		restart */
		var duration = action_cooldown_duration(action_key);

		/* A positive duration schedules the next allowed time. Zero-duration actions leave
		their deadlines unchanged */
		if (duration > 0)
		{
			set_action_cooldown_until(action_key, current_time + duration);
		}

		return true;
	}

	/// @description Show cooldown feedback only while the selected action is waiting
	/// @param {String} action_key Action key, recognizing fill, stamp, undo, and redo for local waits
	/// @returns {Bool} Whether the wait blocks the action
	action_cooldown_blocks = function(action_key)
	{
		/* Measure unexpired wait in milliseconds before deciding whether to block the action */
		var remaining_ms = action_cooldown_remaining_ms(action_key);

		/* An expired wait does not block and needs no feedback. A remaining wait reaches the
		status message below */
		if (remaining_ms <= 0)
		{
			return false;
		}

		/* Convert the active millisecond wait into a one-decimal seconds label for the toolbar */
		var seconds_text = string_format(max(0.1, remaining_ms / 1000), 1, 1);

		/* Use this action's readable name in the blocking feedback and diagnostic */
		var label = action_cooldown_label(action_key);
		set_screenshot_status(label + " cooldown: " + seconds_text + "s", make_color_rgb(255, 220, 95));
		debug_note(string_lower(label) + " cooldown", string(ceil(remaining_ms)) + "ms");
		return true;
	}

	/// @description Extend the host undo-deadline array through the requested player slot
	/// @param {Real} slot Zero-based player slot in server state
	/// @returns {Bool} True after every required new slot has a zero deadline
	ensure_server_cooldown_slot = function(slot)
	{
		/* Append zero deadlines until the requested zero-based slot exists. New slots can undo
		immediately because no earlier action established a wait */
		while (array_length(server_undo_cooldown_until) <= slot)
		{
			server_undo_cooldown_until[array_length(server_undo_cooldown_until)] = 0;
		}

		return true;
	}

	/// @description Enforce the host's per-slot undo deadline and reject invalid slots
	/// @param {Real} slot Zero-based player slot in server state
	/// @param {String} action_key Action key, recognizing fill, stamp, undo, and redo for local waits
	/// @returns {Bool} Whether the requested action passes this host cooldown gate
	server_try_start_action_cooldown = function(slot, action_key)
	{
		/* An unknown or negative sender has no cooldown slot. Count the rejection and stop
		before indexing per-player state */
		if (slot == noone || slot < 0)
		{
			debug_server_reject_count++;
			debug_note("server cooldown rejected", "bad slot");
			return false;
		}

		ensure_server_cooldown_slot(slot);

		/* Only undo is throttled by this host gate. Other action keys pass after their slot
		storage is made available */
		if (string(action_key) != "undo")
		{
			return true;
		}

		/* Read this player's current_time undo deadline, initially zero until an earlier
		accepted undo sets it */
		var cooldown_until = server_undo_cooldown_until[slot];

		/* Before the deadline, reject the undo to enforce the host wait. Once it expires,
		reserve the next deadline and allow the action */
		if (current_time < cooldown_until)
		{
			debug_server_reject_count++;
			debug_note("server throttled " + string(action_key), server_slot_label(slot) + " wait=" + string(ceil(cooldown_until - current_time)) + "ms");
			return false;
		}

		server_undo_cooldown_until[slot] = current_time + server_undo_action_cooldown_ms;

		return true;
	}
	#endregion /* Action Cooldowns END */

	#region /* History Classification and Tool Payloads */
	/// @description Choose text-tool contents or the visible-fill marker for the wire payload
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {String} Tool-specific text, or empty text for other commands
	command_payload_text = function(command)
	{
		/* A nonstruct value has no tool payload and serializes as empty text here */
		if (!is_struct(command))
		{
			return "";
		}

		/* Read the tool ID with a pen fallback for older commands that omit the field */
		var command_tool = debug_struct_field(command, "tool_id", DRAW_TOOL_PEN);

		/* Text tools carry their text contents in the extension payload. Other tools continue
		to the fill-mode check */
		if (command_tool == DRAW_TOOL_TEXT)
		{
			return command_text_value(command);
		}

		/* Only a fill that samples visible layers needs the visible marker. Other commands use
		empty extension text */
		if (command_tool == DRAW_TOOL_FILL
		&& command_fill_sample_visible(command))
		{
			return "visible";
		}

		return "";
	}

	/// @description Select the extended command format when tool or optional payload needs it
	/// @param {Any} command Drawing command whose tool, payload, or attribution is being inspected
	/// @returns {Bool} Whether plain pen or eraser fields alone are insufficient
	command_uses_extended_payload = function(command)
	{
		/* A nonstruct value cannot select an extended drawing format, so report false */
		if (!is_struct(command))
		{
			return false;
		}

		/* Read the tool with a pen fallback before checking whether ordinary pen-or-eraser
		fields suffice */
		var command_tool = debug_struct_field(command, "tool_id", DRAW_TOOL_PEN);

		/* Tools other than pen and eraser require the extended format. Either optional numeric
		extension or nonempty text also requires it, even for those simple tools */
		return command_tool != DRAW_TOOL_PEN
			&& command_tool != DRAW_TOOL_ERASER
			|| command_extra_a(command) != 0
			|| command_extra_b(command) != 0
			|| command_text_value(command) != "";
	}

	/// @description Filter drawing text for display and limit it to the command character cap
	/// @param {Any} raw_text Drawing text to convert and filter for display
	/// @returns {String} Display-safe drawing text with line breaks replaced by spaces
	text_sanitize = function(raw_text)
	{
		/* Convert the supplied drawing-text value to text before applying display filtering
		and the character limit */
		var text = string(raw_text);
		return scr_text_filter_for_display(text, max_text_chars, true, " ", " ");
	}

	/// @description Identify an explicit image-history record without reading absent fields
	/// @param {Any} item History record to classify or inspect for local author blocking
	/// @returns {Bool} Whether history_kind identifies an image
	history_item_is_image = function(item)
	{
		/* An image needs a struct with the explicit image history tag. Missing or other tags
		return false so callers can try the remaining record formats */
		return is_struct(item)
			&& variable_struct_exists(item, "history_kind")
			&& item.history_kind == DRAW_HISTORY_IMAGE;
	}

	/// @description Identify an explicit layer-history record without reading absent fields
	/// @param {Any} item History record to classify or inspect for local author blocking
	/// @returns {Bool} Whether history_kind identifies a layer operation
	history_item_is_layer = function(item)
	{
		/* A layer operation needs a struct with the layer history tag. Validate field presence
		before comparing it so ordinary commands return false safely */
		return is_struct(item)
			&& variable_struct_exists(item, "history_kind")
			&& item.history_kind == DRAW_HISTORY_LAYER;
	}

	/// @description Identify an explicit undo-history record without reading absent fields
	/// @param {Any} item History record to classify or inspect for local author blocking
	/// @returns {Bool} Whether history_kind identifies an undo operation
	history_item_is_undo = function(item)
	{
		/* An undo operation needs a struct with the undo history tag. Untagged commands and
		other record kinds are not undo records */
		return is_struct(item)
			&& variable_struct_exists(item, "history_kind")
			&& item.history_kind == DRAW_HISTORY_UNDO;
	}

	/// @description Apply local social blocking to attributed drawing while retaining authoritative reconstruction
	/// @param {Any} item History record to classify or inspect for local author blocking
	/// @returns {Bool} Whether this drawable item belongs to a locally blocked nonlocal author
	history_item_is_blocked = function(item)
	{
		/* A server checkpoint is an authoritative reconstruction. The machine hosting
		the server may have a local social block list, but that must never erase
		another player's pixels from the shared canvas snapshot */
		if (server_history_checkpoint_in_progress)
		{
			return false;
		}

		/* Layer and undo records maintain the shared stack and ordering rather than carrying
		locally hideable pixels. Nonstruct values likewise have no author to block here */
		if (!is_struct(item)
		|| history_item_is_layer(item)
		|| history_item_is_undo(item))
		{
			return false;
		}

		/* Read sanitized author text to match the local social block list consistently */
		var author_name = command_author_name(item);

		/* Unattributed drawing has no username to match, so keep it visible */
		if (author_name == "")
		{
			return false;
		}

		/* Read the optional player slot to distinguish the local player's own drawing */
		var author_id = command_author_player_id(item);

		/* A known author slot matching the local player stays visible even if username-based
		blocking would match it */
		if (author_id != noone
		&& author_id == local_player_id)
		{
			return false;
		}

		/* Hide drawing only when its nonlocal author name is in the local social block list.
		Unblocked names remain visible */
		return scr_get_social().is_blocked_username(author_name);
	}
	#endregion /* History Classification and Tool Payloads END */

	#region /* Layer State and Surfaces */
	/// @description Make a bounded layer label safe for line and pipe-delimited payloads
	/// @param {Any} raw_name Proposed layer label or stewardship name before cleanup
	/// @param {String} fallback Replacement for a blank layer label. Defaults to Paint Layer
	/// @returns {String} Cleaned label of at most 48 characters, using fallback when empty
	layer_name_clean = function(raw_name, fallback = "Paint Layer")
	{
		/* Trim the proposed display label before removing line breaks and the wire-format pipe
		delimiter */
		var text = string_trim(string(raw_name));
		text = string_replace_all(text, "\r", " ");
		text = string_replace_all(text, "\n", " ");
		text = string_replace_all(text, "|", " ");

		/* A blank cleaned label uses the caller's fallback so the layer still has a readable
		name */
		if (text == "")
		{
			text = fallback;
		}

		return string_copy(text, 1, 48);
	}

	/// @description Make layer stewardship text safe for serialized payloads
	/// @param {Any} raw_name Proposed layer label or stewardship name before cleanup
	/// @returns {String} Cleaned author text of at most 48 characters, preserving an empty name
	layer_author_name_clean = function(raw_name)
	{
		/* Trim stewardship text before removing line breaks and payload delimiters. Unlike a
		layer label, an absent author remains empty */
		var text = string_trim(string(raw_name));
		text = string_replace_all(text, "\r", " ");
		text = string_replace_all(text, "\n", " ");
		text = string_replace_all(text, "|", " ");
		return string_copy(text, 1, 48);
	}

	/// @description Format the default label for a positive layer identifier
	/// @param {Real} layer_id Stable positive layer identifier, distinct from its changing stack index
	/// @returns {String} Paint Layer followed by the normalized layer ID
	layer_default_name = function(layer_id)
	{
		return "Paint Layer " + string(max(1, floor(real(layer_id))));
	}

	/// @description Create client layer state with no allocated surface
	/// @param {Real} layer_id Stable positive layer identifier, distinct from its changing stack index
	/// @param {String} layer_name Proposed layer display label
	/// @param {Bool} layer_visible Initial layer visibility. Defaults to true
	/// @param {String} steward_name Initial stewardship author name. Defaults to ""
	/// @param {Bool} layer_archived Initial archive flag, recognized only when equal to true. Defaults to false
	/// @returns {Struct} New layer owned by the client stack, with surface allocated lazily
	make_layer_struct = function(layer_id, layer_name, layer_visible = true, steward_name = "", layer_archived = false)
	{
		/* Normalize the layer ID to a positive whole number so it agrees with command and
		history identifiers */
		var clean_id = max(1, floor(real(layer_id)));

		/* The new layer stores its stable id, cleaned name, requested visibility, and
		steward_name. locked starts false, archived records the requested archive state, and
		archive_sequence starts unset at zero. Its owned surface starts noone and is
		allocated and freed by the layer-surface helpers */
		return
		{
			id: clean_id,
			name: layer_name_clean(layer_name, layer_default_name(clean_id)),
			visible: layer_visible,
			locked: false,
			steward_name: layer_author_name_clean(steward_name),

			/* Only the literal true archive flag marks this new layer archived. Other input
			starts it unarchived */
			archived: layer_archived == true,
			archive_sequence: 0,
			surface: noone
		};
	}

	/// @description Check an optional layer archive flag without treating older layers as archived
	/// @param {Any} paint_layer Client layer struct to inspect
	/// @returns {Bool} Whether the layer explicitly has archived equal to true
	layer_is_archived = function(paint_layer)
	{
		/* Only a struct with an explicit true archive flag is archived. Older layers without
		the flag stay active */
		return is_struct(paint_layer)
			&& variable_struct_exists(paint_layer, "archived")
			&& paint_layer.archived == true;
	}

	/// @description Check whether the current client proposal enables a local layer preview
	/// @returns {Bool} Whether the vote exposes an enabled preview field
	layer_vote_preview_active = function()
	{
		/* A client vote exposes a preview only when its struct has an enabled preview field.
		Missing vote state leaves preview disabled */
		return is_struct(client_layer_vote)
			&& variable_struct_exists(client_layer_vote, "preview")
			&& client_layer_vote.preview;
	}

	/// @description Identify the archived layer currently previewed for a restore proposal
	/// @param {Any} paint_layer Client layer struct to inspect
	/// @returns {Bool} Whether this layer is the enabled restore-preview target
	layer_is_restore_preview = function(paint_layer)
	{
		/* An archived layer is shown as a restoration preview only for an active restore
		proposal that enables preview and targets this same layer ID */
		return layer_is_archived(paint_layer)
			&& is_struct(client_layer_vote)
			&& client_layer_vote.action == LAYER_VOTE_ACTION_RESTORE
			&& client_layer_vote.preview
			&& paint_layer.id == client_layer_vote.layer_id;
	}

	/// @description Collect unarchived layer stack indexes in their stored order
	/// @returns {Array} Zero-based indexes into layers
	active_layer_indices = function()
	{
		/* Collect stack indexes for unarchived layers, starting with no entries */
		var indices = [];

		/* Visit each zero-based layer-stack index so active layers retain their existing
		relative order */
		for (var layer_index = 0; layer_index < array_length(layers); layer_index++)
		{
			/* Keep only unarchived layers in the active list. Archived layers remain stored
			but do not occupy an active position */
			if (!layer_is_archived(layers[layer_index]))
			{
				indices[array_length(indices)] = layer_index;
			}
		}

		return indices;
	}

	/// @description Build provisional render order for local reorder drafts or move-vote previews
	/// @returns {Array} Stored layer indexes in the order to draw, without changing layers
	layer_render_order_indices = function()
	{
		/* Build a render-order index array with one entry per layer, independent of the stored
		layer structs */
		var order = array_create(array_length(layers));

		/* Seed the order with every stack index from zero upward before applying a provisional
		move */
		for (var layer_index = 0; layer_index < array_length(layers); layer_index++)
		{
			order[layer_index] = layer_index;
		}

		/* No layer is provisionally moved until a local draft or vote supplies its stable ID */
		var preview_layer_id = 0;

		/* No destination stack index is available before a preview supplies it */
		var preview_target_index = noone;

		/* A local reorder draft takes priority over the vote preview so the player's
		in-progress move remains visible */
		if (layer_move_draft_active)
		{
			preview_layer_id = layer_move_draft_layer_id;

			/* Use only active stack indexes when translating the draft's active-layer position
			into a stored-stack index */
			var active_indices = active_layer_indices();

			/* An active position must lie within the current active list before it can name
			the preview destination. An invalid position keeps the destination unset */
			if (layer_move_draft_target_position >= 0
			&& layer_move_draft_target_position < array_length(active_indices))
			{
				preview_target_index = active_indices[layer_move_draft_target_position];
			}
		}

		/* With no local draft, an enabled move-vote preview supplies the provisional layer and
		destination. Other votes leave ordinary stack order intact */
		else if (is_struct(client_layer_vote)
		&& client_layer_vote.action == LAYER_VOTE_ACTION_MOVE
		&& client_layer_vote.preview)
		{
			preview_layer_id = client_layer_vote.layer_id;
			preview_target_index = client_layer_vote.target_index;
		}

		/* Resolve the provisional stable ID into the stored-stack index to remove and reinsert */
		var source_index = layer_index_from_id(preview_layer_id);

		/* Without both a source and a destination, keep the original render order rather than
		moving an unrelated layer */
		if (source_index == noone || preview_target_index == noone)
		{
			return order;
		}

		array_delete(order, source_index, 1);
		array_insert(order, clamp(preview_target_index, 0, array_length(order)), source_index);
		return order;
	}

	/// @description Collect displayed active-layer rows, including a restoration preview
	/// @returns {Array} Stored layer indexes in provisional render order
	active_layer_display_indices = function()
	{
		/* Start from the provisional render order so the layer panel agrees with the world
		preview */
		var order = layer_render_order_indices();

		/* Collect only rows that should be displayed, initially with no layer indexes */
		var indices = [];

		/* Walk render positions from zero through the order array while keeping their
		displayed order */
		for (var order_index = 0; order_index < array_length(order); order_index++)
		{
			/* Translate this render position into the index of its actual layer struct */
			var layer_index = order[order_index];

			/* Display unarchived layers and the archived layer currently previewed for
			restoration. Other archived layers stay out of the panel */
			if (!layer_is_archived(layers[layer_index])
			|| layer_is_restore_preview(layers[layer_index]))
			{
				indices[array_length(indices)] = layer_index;
			}
		}
		return indices;
	}

	/// @description Count unarchived client layers
	/// @returns {Real} Number of active layers
	active_layer_count = function()
	{
		return array_length(active_layer_indices());
	}

	/// @description Count stored client layers outside the unarchived list
	/// @returns {Real} Number of archived layers
	archived_layer_count = function()
	{
		return max(0, array_length(layers) - active_layer_count());
	}

	/// @description Find a stable layer ID's position among unarchived layers
	/// @param {Real} layer_id Stable positive layer identifier, distinct from its changing stack index
	/// @returns {Real} Zero-based active-layer position, or noone
	active_layer_position = function(layer_id)
	{
		/* Use the unarchived stack-index list to translate a stable ID into its active-layer
		position */
		var indices = active_layer_indices();

		/* Search active positions from zero until the requested layer is found or every active
		layer is checked */
		for (var position = 0; position < array_length(indices); position++)
		{
			/* A matching stable ID identifies the requested active position, so stop the
			search there */
			if (layers[indices[position]].id == layer_id)
			{
				return position;
			}
		}

		/* No active layer matched the ID, so report noone instead of a valid position */
		return noone;
	}

	/// @description Find the newest archived layer, using render order to break sequence ties
	/// @returns {Real} Stored layer index, or noone when no layer is archived
	latest_archived_layer_index = function()
	{
		/* The result starts noone so a stack with no archived layers has no restoration
		candidate */
		var latest_index = noone;

		/* Start below all nonnegative archive sequence values so the first archived candidate
		can be selected */
		var latest_sequence = -1;

		/* Use render order to resolve equal archive sequence values in the displayed stack
		order */
		var render_order = layer_render_order_indices();

		/* Check each displayed stack position from zero for the most recently archived layer */
		for (var order_index = 0; order_index < array_length(render_order); order_index++)
		{
			/* Resolve the displayed position to its stored layer index */
			var layer_index = render_order[order_index];

			/* Inspect this layer's archive flag and sequence without changing the stack */
			var paint_layer = layers[layer_index];

			/* An archived layer replaces the candidate when its sequence is at least as
			recent. Active or older layers leave the candidate unchanged */
			if (layer_is_archived(paint_layer)
			&& paint_layer.archive_sequence >= latest_sequence)
			{
				latest_index = layer_index;
				latest_sequence = paint_layer.archive_sequence;
			}
		}

		return latest_index;
	}

	/// @description Release an existing layer surface without changing its owning struct
	/// @param {Real} layer_surface Layer-owned surface handle, possibly noone or a lost surface
	delete_layer_surface_value = function(layer_surface)
	{
		/* Free only a live surface handle. An unallocated or already-lost surface needs no
		release */
		if (surface_exists(layer_surface))
		{
			surface_free(layer_surface);
		}
	}

	/// @description Free every client layer surface and replace its handle with noone
	delete_all_layer_surfaces = function()
	{
		/* Visit every stored layer from index zero, releasing its owned surface and resetting
		its handle */
		for (var layer_index = 0; layer_index < array_length(layers); layer_index++)
		{
			delete_layer_surface_value(layers[layer_index].surface);
			layers[layer_index].surface = noone;
		}
	}

	/// @description Release cached HSV and background surfaces and clear their cache signatures
	/// @returns {Bool} True after clearing every gradient cache
	free_toolbar_gradient_surfaces = function()
	{
		/* Release a live hue-gradient cache before clearing its handle and signature below.
		Lost caches need no release */
		if (surface_exists(hsv_surface_hue))
		{
			surface_free(hsv_surface_hue);
		}

		/* Release the saturation-gradient cache only if its surface still exists */
		if (surface_exists(hsv_surface_saturation))
		{
			surface_free(hsv_surface_saturation);
		}

		/* Release the value-gradient cache only while its surface exists */
		if (surface_exists(hsv_surface_value))
		{
			surface_free(hsv_surface_value);
		}

		/* Release the signed-background gradient cache only if allocated. All cache handles
		and signatures are then reset for lazy rebuilding */
		if (surface_exists(canvas_background_gradient_surface))
		{
			surface_free(canvas_background_gradient_surface);
		}

		hsv_surface_hue = noone;
		hsv_surface_saturation = noone;
		hsv_surface_value = noone;
		hsv_key_hue = "";
		hsv_key_saturation = "";
		hsv_key_value = "";
		canvas_background_gradient_surface = noone;
		canvas_background_gradient_key = "";
		return true;
	}

	/// @description Create a visible default layer only when the client stack is empty
	/// @returns {Bool} True after retaining or creating the stack
	ensure_default_layers = function()
	{
		/* An existing stack already provides drawing layers, so preserve it. An empty stack
		receives the visible default layer below */
		if (array_length(layers) > 0)
		{
			return true;
		}

		layers = [make_layer_struct(1, "Paint Layer 1", true)];
		active_layer_id = 1;
		next_layer_id = max(next_layer_id, 2);
		layer_composite_dirty = true;
		return true;
	}

	/// @description Find a layer's current stack position from its stable identifier
	/// @param {Real} layer_id Stable positive layer identifier, distinct from its changing stack index
	/// @returns {Real} Stored zero-based index, or noone
	layer_index_from_id = function(layer_id)
	{
		/* Search stored layer indexes from zero until the stable ID matches or the stack ends */
		for (var layer_index = 0; layer_index < array_length(layers); layer_index++)
		{
			/* Return the matching stack index immediately, leaving the layers unchanged */
			if (layers[layer_index].id == layer_id)
			{
				return layer_index;
			}
		}

		/* An unknown stable ID has no stack index, so report noone */
		return noone;
	}

	/// @description Resolve the selected unarchived layer, choosing or reopening a fallback if necessary
	/// @returns {Real} Usable layer-stack index, updating active_layer_id when needed
	active_layer_index = function()
	{
		ensure_default_layers();

		/* Resolve the currently selected stable ID after ensuring the default stack exists */
		var layer_index = layer_index_from_id(active_layer_id);

		/* Keep a selected layer only when it exists and is unarchived. Missing or archived
		selections need a fallback */
		if (layer_index != noone && !layer_is_archived(layers[layer_index]))
		{
			return layer_index;
		}

		/* List the currently unarchived layers to choose a valid replacement selection */
		var active_indices = active_layer_indices();

		/* When every layer is archived, reopen the first stored layer so drawing retains an
		active target */
		if (array_length(active_indices) <= 0)
		{
			layers[0].archived = false;
			layers[0].archive_sequence = 0;
			active_layer_id = layers[0].id;
			return 0;
		}

		/* Select the final unarchived stack index as the fallback when the old selection
		cannot be used */
		var fallback_index = active_indices[array_length(active_indices) - 1];
		active_layer_id = layers[fallback_index].id;
		return fallback_index;
	}

	/// @description Restore a usable preferred selection or retain and repair the current selection
	/// @param {Real} preferred_layer_id Stable ID to try restoring as the selected layer
	/// @returns {Bool} Whether the preferred layer ID was selected
	restore_active_layer_id = function(preferred_layer_id)
	{
		ensure_default_layers();

		/* Locate the preferred stable ID after ensuring a default stack exists */
		var preferred_index = layer_index_from_id(preferred_layer_id);

		/* Restore the preferred layer only if present and unarchived. Otherwise consider
		preserving the current selection */
		if (preferred_index != noone && !layer_is_archived(layers[preferred_index]))
		{
			active_layer_id = preferred_layer_id;
			return true;
		}

		/* Resolve the current selected layer before deciding whether any fallback is necessary */
		var current_index = layer_index_from_id(active_layer_id);

		/* An existing unarchived selection remains valid, so keep it and report that the
		preferred ID was not restored */
		if (current_index != noone && !layer_is_archived(layers[current_index]))
		{
			return false;
		}

		/* Neither preference nor current selection is usable. Let active_layer_index choose or
		reopen a fallback, still reporting that the preference was not restored */
		active_layer_index();
		return false;
	}

	/// @description Check whether an existing surface has the current room dimensions
	/// @param {Real} layer_surface Layer-owned surface handle, possibly noone or a lost surface
	/// @returns {Bool} Whether the surface can be reused for this room
	layer_surface_matches_room = function(layer_surface)
	{
		/* A reusable layer surface must exist and match both room dimensions, with a minimum
		of one pixel. Missing or differently sized surfaces require reconstruction */
		return surface_exists(layer_surface)
			&& surface_get_width(layer_surface) == max(1, room_width)
			&& surface_get_height(layer_surface) == max(1, room_height);
	}

	/// @description Retain a room-sized owned surface or allocate and clear a replacement
	/// @param {Real} layer_index Zero-based stored index in layers
	/// @returns {Bool} Whether the requested layer has a live room-sized surface
	ensure_layer_surface = function(layer_index)
	{
		ensure_default_layers();

		/* Reject indexes outside the layer array before reading a layer or creating its
		surface */
		if (layer_index < 0 || layer_index >= array_length(layers))
		{
			return false;
		}

		/* Borrow this layer struct so replacing its owned surface updates the shared stack
		entry */
		var paint_layer = layers[layer_index];

		/* A live room-sized surface can be retained without erasing its pixels. Other surfaces
		are freed and recreated below */
		if (layer_surface_matches_room(paint_layer.surface))
		{
			return true;
		}

		delete_layer_surface_value(paint_layer.surface);
		paint_layer.surface = surface_create(max(1, room_width), max(1, room_height));

		/* Allocation failure leaves noone as the handle and reports false instead of targeting
		a nonexistent surface */
		if (!surface_exists(paint_layer.surface))
		{
			paint_layer.surface = noone;
			return false;
		}

		surface_set_target(paint_layer.surface);
		draw_clear_alpha(c_black, 0);
		surface_reset_target();
		layer_composite_dirty = true;
		return true;
	}

	/// @description Ensure live room-sized surfaces for the whole client stack
	/// @returns {Bool} Whether every layer surface is available
	ensure_all_layer_surfaces = function()
	{
		ensure_default_layers();

		/* Ensure a room-sized surface for every stored layer, including archived layers needed
		for reconstruction */
		for (var layer_index = 0; layer_index < array_length(layers); layer_index++)
		{
			/* Stop on the first surface failure. Reporting success only after all layers
			prevents rendering a partially unavailable stack */
			if (!ensure_layer_surface(layer_index))
			{
				return false;
			}
		}

		return true;
	}

	/// @description Resolve the active layer and allocate its surface if needed
	/// @returns {Real} Borrowed active-layer surface handle, or noone
	active_layer_surface = function()
	{
		/* Resolve or repair the active selection before asking for its owned surface */
		var layer_index = active_layer_index();

		/* An unavailable active surface cannot be drawn into, so return noone to the caller */
		if (!ensure_layer_surface(layer_index))
		{
			return noone;
		}

		return layers[layer_index].surface;
	}

	/// @description Capture stable IDs and visibility flags before temporary display changes
	/// @returns {Array} New id-and-visible records for every stored layer
	layer_visibility_snapshot = function()
	{
		ensure_default_layers();

		/* Capture visibility records in a new array so temporary export changes can later be
		restored */
		var snapshot = [];

		/* Visit each stored layer index, recording its stable ID and current visibility */
		for (var layer_index = 0; layer_index < array_length(layers); layer_index++)
		{
			/* Each snapshot entry pairs id with visible so restoration survives later stack
			reordering */
			snapshot[layer_index] =
			{
				id: layers[layer_index].id,
				visible: layers[layer_index].visible
			};
		}

		return snapshot;
	}

	/// @description Apply saved visibility only to still-existing layers with different flags
	/// @param {Any} snapshot Saved id-and-visible records to restore
	/// @returns {Bool} Whether any layer's visibility changed
	restore_layer_visibility_snapshot = function(snapshot)
	{
		/* Only an array can supply visibility records, so reject other inputs without changing
		layers */
		if (!is_array(snapshot))
		{
			return false;
		}

		/* Track whether at least one existing layer actually receives a different visibility
		flag */
		var changed = false;

		/* Check snapshot entries from index zero, ending after every saved visibility record */
		for (var snapshot_index = 0; snapshot_index < array_length(snapshot); snapshot_index++)
		{
			/* Inspect the current saved id-and-visibility record without assuming it is well
			formed */
			var item = snapshot[snapshot_index];

			/* Skip entries that are not structs or lack either field so malformed snapshots
			cannot cause member access errors */
			if (!is_struct(item)
			|| !variable_struct_exists(item, "id")
			|| !variable_struct_exists(item, "visible"))
			{
				continue;
			}

			/* Resolve the saved stable ID in the current stack rather than reusing a
			potentially stale array position */
			var layer_index = layer_index_from_id(item.id);

			/* Restore only an existing layer whose visibility differs. Missing IDs and
			unchanged flags leave the stack untouched */
			if (layer_index != noone
			&& layers[layer_index].visible != item.visible)
			{
				layers[layer_index].visible = item.visible;
				changed = true;
			}
		}

		return changed;
	}

	/// @description Start a local current_time highlight for an existing layer
	/// @param {Real} layer_id Stable positive layer identifier, distinct from its changing stack index
	/// @returns {Bool} Whether the target layer exists and the blink was scheduled
	trigger_layer_blink = function(layer_id)
	{
		/* Resolve the requested highlight layer by stable ID before scheduling its blink */
		var layer_index = layer_index_from_id(layer_id);

		/* A missing layer cannot be highlighted, so keep the current blink state and report
		false */
		if (layer_index == noone)
		{
			return false;
		}

		layer_blink_layer_id = layers[layer_index].id;
		layer_blink_started_at = current_time;
		debug_note("layer blink", layers[layer_index].name);
		return true;
	}

	/// @description Measure the time since the current layer highlight started
	/// @returns {Real} Nonnegative elapsed current_time milliseconds
	layer_blink_elapsed = function()
	{
		return max(0, current_time - layer_blink_started_at);
	}

	/// @description Check and expire the scheduled layer highlight
	/// @returns {Bool} Whether its layer still exists and its duration has not expired
	layer_blink_active = function()
	{
		/* Zero or negative highlight ID means no blink is scheduled, so return inactive */
		if (layer_blink_layer_id <= 0)
		{
			return false;
		}

		/* Expire a blink when its millisecond duration ends or its layer disappears. Clear the
		ID so later checks remain inactive */
		if (layer_blink_elapsed() > layer_blink_duration_ms
		|| layer_index_from_id(layer_blink_layer_id) == noone)
		{
			layer_blink_layer_id = 0;
			return false;
		}

		return true;
	}

	/// @description Calculate the current highlight pulse without changing layer pixels
	/// @returns {Real} Clamped zero-to-one pulse opacity, or zero when inactive
	layer_blink_alpha = function()
	{
		/* Without an active blink, return zero opacity and avoid calculating a pulse */
		if (!layer_blink_active())
		{
			return 0;
		}

		/* Measure this highlight's elapsed current_time milliseconds */
		var blink_elapsed = layer_blink_elapsed();

		/* Find the millisecond phase within one pulse, guarding the configured period against
		zero */
		var blink_phase = blink_elapsed mod max(1, layer_blink_period_ms);

		/* Use a positive fade-down duration in milliseconds so its opacity division remains
		defined */
		var fade_down_ms = max(1, layer_blink_fade_ms);

		/* Use the remaining positive pulse duration for fade-up, again guarding against zero */
		var fade_up_ms = max(1, layer_blink_period_ms - layer_blink_fade_ms);

		/* Begin with no pulse opacity before selecting the appropriate phase */
		var blink_alpha = 0;

		/* During the first pulse phase, fade from full opacity toward zero */
		if (blink_phase < fade_down_ms)
		{
			blink_alpha = 1 - blink_phase / fade_down_ms;
		}

		/* After fade-down finishes, fade back upward for the remainder of the pulse */
		else
		{
			blink_alpha = (blink_phase - fade_down_ms) / fade_up_ms;
		}

		return clamp(blink_alpha, 0, 1);
	}

	/// @description Check whether multiple unarchived layers make dimming useful
	/// @returns {Bool} Whether there is more than one active layer
	inactive_layer_dim_available = function()
	{
		/* Dimming becomes useful only with more than one unarchived layer. A single active
		layer has no inactive comparison layer */
		return active_layer_count() > 1;
	}

	/// @description Require drawing mode, the local preference, and multiple layers for dimming
	/// @returns {Bool} Whether inactive-layer dim rendering should be used
	inactive_layer_dim_active = function()
	{
		/* Dim only while drawing mode is enabled, the local preference is on, and multiple
		active layers exist. Missing any requirement leaves the ordinary view unchanged */
		return draw_mode_enabled
			&& dim_inactive_layers
			&& inactive_layer_dim_available();
	}

	/// @description Choose ordinary or dimmed opacity for a client paint layer
	/// @param {Any} paint_layer Client layer struct to inspect
	/// @returns {Real} Inactive multiplier for eligible nonselected layers, otherwise one
	layer_display_alpha = function(paint_layer)
	{
		/* Only a well-formed nonselected layer receives the dim multiplier while dimming is
		active. The selected layer and other cases keep full opacity */
		if (inactive_layer_dim_active()
		&& is_struct(paint_layer)
		&& variable_struct_exists(paint_layer, "id")
		&& paint_layer.id != active_layer_id)
		{
			return inactive_layer_alpha;
		}

		return 1;
	}

	/// @description Draw a live surface at room origin with bounded opacity and restore full draw alpha
	/// @param {Real} layer_surface Layer-owned surface handle, possibly noone or a lost surface
	/// @param {Real} layer_alpha Requested zero-to-one opacity multiplier
	/// @returns {Bool} Whether the surface was drawn
	draw_layer_surface_with_alpha = function(layer_surface, layer_alpha)
	{
		/* A missing surface or nonpositive requested opacity contributes no pixels, so skip
		drawing it */
		if (!surface_exists(layer_surface)
		|| layer_alpha <= 0)
		{
			return false;
		}

		draw_set_alpha(clamp(layer_alpha, 0, 1));
		draw_surface(layer_surface, 0, 0);
		draw_set_alpha(1);
		return true;
	}

	/* This is a local accessibility preview. It redraws visible layers directly
	for a moment so the clicked layer can disappear/reappear without editing
	layer pixels, visibility, command history, or server state */
	/// @description Render a temporary local layer highlight without changing shared drawing state
	/// @returns {Bool} Whether the blink rendering path handled the world view
	draw_layer_blink_world = function()
	{
		/* No active blink leaves world drawing to the normal rendering path */
		if (!layer_blink_active())
		{
			return false;
		}

		/* Blink rendering needs every layer surface available. If reconstruction fails, return
		false so the caller can use its fallback path */
		if (!ensure_all_layer_surfaces())
		{
			return false;
		}

		/* Use the current zero-to-one blink pulse to control the highlighted layer's opacity */
		var blink_alpha = layer_blink_alpha();

		gpu_set_blendmode(bm_normal);
		draw_set_alpha(1);

		/* Obtain provisional render order so blinking agrees with any local or vote layer-move
		preview */
		var render_order = layer_render_order_indices();

		/* Render stack positions from zero in compositing order, stopping after every stored
		layer */
		for (var order_index = 0; order_index < array_length(render_order); order_index++)
		{
			/* Resolve this render position into a stored layer index */
			var layer_index = render_order[order_index];

			/* Borrow the current paint-layer struct to read its surface, visibility, and
			stable ID */
			var paint_layer = layers[layer_index];

			/* Remember whether this archived layer is currently being previewed for
			restoration */
			var restore_preview = layer_is_restore_preview(paint_layer);

			/* Skip archived layers outside a restore preview and layers without surfaces.
			Neither contributes to this local display */
			if ((layer_is_archived(paint_layer) && !restore_preview)
			|| !surface_exists(paint_layer.surface))
			{
				continue;
			}

			/* The highlighted layer uses pulse opacity instead of ordinary visibility so a
			hidden layer can briefly be located */
			if (paint_layer.id == layer_blink_layer_id)
			{
				/* Draw the highlight only above the near-zero pulse threshold. Lower opacity
				skips its draw while preserving the blink timing */
				if (blink_alpha > 0.02)
				{
					/* Start hidden-layer highlight opacity at 0.86 so a blink can locate
					otherwise invisible content */
					var max_alpha = 0.86;

					/* For a visible layer, use its ordinary display opacity as the pulse
					ceiling. Hidden layers retain the special highlight ceiling */
					if (paint_layer.visible)
					{
						max_alpha = layer_display_alpha(paint_layer);
					}
					draw_set_alpha(max_alpha * blink_alpha);
					draw_surface(paint_layer.surface, 0, 0);
					draw_set_alpha(1);
				}

				/* Do not draw the highlighted layer again through the ordinary visibility path */
				continue;
			}

			/* Other layers draw when visible or when a restoration vote previews them. Hidden
			nonpreview layers remain omitted */
			if (paint_layer.visible || restore_preview)
			{
				draw_layer_surface_with_alpha(paint_layer.surface, layer_display_alpha(paint_layer));
			}
		}

		draw_set_alpha(1);
		return true;
	}

	/// @description Render visible or previewed layers directly with local inactive-layer opacity
	/// @returns {Bool} Whether the dimming rendering path handled the world view
	draw_inactive_layer_dim_world = function()
	{
		/* When local dimming is unavailable or disabled, leave drawing to the ordinary
		composite path */
		if (!inactive_layer_dim_active())
		{
			return false;
		}

		/* Direct dim rendering requires every layer surface. A failure returns false rather
		than drawing an incomplete stack */
		if (!ensure_all_layer_surfaces())
		{
			return false;
		}

		gpu_set_blendmode(bm_normal);

		/* Use provisional render order so dimmed drawing matches local and vote move previews */
		var render_order = layer_render_order_indices();

		/* Visit every render position from zero in compositing order */
		for (var order_index = 0; order_index < array_length(render_order); order_index++)
		{
			/* Resolve the current render position into its stored layer index */
			var layer_index = render_order[order_index];

			/* Borrow this paint-layer struct to read visibility and the owned surface */
			var paint_layer = layers[layer_index];

			/* Remember whether a restore vote temporarily makes this archived layer drawable */
			var restore_preview = layer_is_restore_preview(paint_layer);

			/* Omit archived or hidden layers unless restoration previews them, and always omit
			missing surfaces. Remaining layers use their normal or dimmed display opacity */
			if ((layer_is_archived(paint_layer) && !restore_preview)
			|| (!paint_layer.visible && !restore_preview)
			|| !surface_exists(paint_layer.surface))
			{
				continue;
			}

			draw_layer_surface_with_alpha(paint_layer.surface, layer_display_alpha(paint_layer));
		}

		draw_set_alpha(1);
		return true;
	}

	/// @description Clear a usable layer to transparent and mark the flattened composite dirty
	/// @param {Real} layer_index Zero-based stored index in layers
	/// @returns {Bool} Whether the layer surface was cleared
	clear_layer_surface = function(layer_index)
	{
		/* Clear only after this layer has a usable surface. Allocation failure leaves its
		pixels unchanged and reports false */
		if (!ensure_layer_surface(layer_index))
		{
			return false;
		}

		surface_set_target(layers[layer_index].surface);
		draw_clear_alpha(c_black, 0);
		surface_reset_target();
		layer_composite_dirty = true;
		return true;
	}

	/// @description Free the current stack and recreate default layer state before ordered replay
	reset_layer_stack_for_replay = function()
	{
		delete_all_layer_surfaces();
		layers = [];
		active_layer_id = 1;
		next_layer_id = 2;
		next_layer_archive_sequence = 1;
		ensure_default_layers();

		/* After resetting the stack to its default layer, allocate every current layer surface
		from index zero so replay has valid draw targets */
		for (var layer_index = 0; layer_index < array_length(layers); layer_index++)
		{
			ensure_layer_surface(layer_index);
		}

		layer_composite_dirty = true;
	}
	#endregion /* Layer State and Surfaces END */

	#region /* Command Validation and Serialization */
	/// @description Describe ordinary drawing or image history for diagnostics
	/// @param {Any} command Drawing command to inspect or validate, possibly noone for diagnostics
	/// @returns {String} Readable command detail, or the none marker for a nonstruct value
	command_debug_string = function(command)
	{
		/* A nonstruct value has no drawing fields to describe, so use the none marker instead
		of reading members */
		if (!is_struct(command))
		{
			return "<none>";
		}

		/* Image history has dimensions and a filename rather than brush endpoints, so format
		its image-specific diagnostic */
		if (history_item_is_image(command))
		{
			/* Include an author-and-group undo label only for an image with a positive undo
			group. Otherwise image_undo_text is empty */
			var image_undo_text = command_undo_id(command) > 0 ? " undo=" + string(command_undo_author_id(command)) + ":" + string(command_undo_id(command)) : "";
			return "image id=" + string(command.image_id)
				+ " layer=" + string(command.layer_id)
				+ " " + string(command.w) + "x" + string(command.h)
				+ " @(" + string(command.x) + "," + string(command.y) + ")"
				+ image_undo_text
				+ " name=\"" + string(command.name) + "\"";
		}

		/* debug_tool_id and debug_layer_id identify the action and target layer, using
		question-mark placeholders for missing fields */
		var debug_tool_id = debug_struct_field(command, "tool_id", "?");
		var debug_layer_id = debug_struct_field(command, "layer_id", "?");

		/* debug_brush_px holds the command's explicit world-pixel diameter, remaining
		undefined when the field is missing */
		var debug_brush_px = command_brush_px(command);

		/* debug_color_r, debug_color_g, and debug_color_b are diagnostic RGB bytes or
		missing-field placeholders. debug_color_a supplies opacity with the legacy opaque
		fallback */
		var debug_color_r = debug_struct_field(command, "color_r", "?");
		var debug_color_g = debug_struct_field(command, "color_g", "?");
		var debug_color_b = debug_struct_field(command, "color_b", "?");
		var debug_color_a = command_alpha(command);

		/* debug_from_x and debug_from_y describe the starting world point. debug_to_x and
		debug_to_y describe the end point. Missing coordinates use diagnostic placeholders */
		var debug_from_x = debug_struct_field(command, "from_x", "?");
		var debug_from_y = debug_struct_field(command, "from_y", "?");
		var debug_to_x = debug_struct_field(command, "to_x", "?");
		var debug_to_y = debug_struct_field(command, "to_y", "?");

		/* debug_extra_a and debug_extra_b describe optional tool values, both defaulting to
		zero for older commands */
		var debug_extra_a = debug_struct_field(command, "extra_a", 0);
		var debug_extra_b = debug_struct_field(command, "extra_b", 0);

		/* Read optional drawing text, with empty text marking no payload */
		var debug_text = command_text_value(command);

		/* Only a fill needs a source label. Its recognized sampling flag selects visible or
		current layers, while other tools keep debug_fill_sample_text empty */
		var debug_fill_sample_text = debug_tool_id == DRAW_TOOL_FILL ? " fill_source=" + (command_fill_sample_visible(command) ? "visible" : "current") : "";

		/* Read the sanitized attribution name before deciding whether a diagnostic author
		suffix can be shown */
		var debug_author_name = command_author_name(command);

		/* Keep debug_author_text empty for unnamed drawing. A known name adds the optional
		player-slot label and display name for attribution */
		var debug_author_text = debug_author_name == "" ? "" : " author=" + scr_network_debug_id_text(command_author_player_id(command)) + "(" + debug_author_name + ")";

		/* A positive undo group adds its connection-specific author and group IDs to
		debug_undo_text. Ungrouped drawing omits that suffix */
		var debug_undo_text = command_undo_id(command) > 0 ? " undo=" + string(command_undo_author_id(command)) + ":" + string(command_undo_id(command)) : "";

		return "tool_id=" + string(debug_tool_id)
			+ " layer=" + string(debug_layer_id)
			+ " brush_px=" + string(debug_brush_px)
			+ " rgba=" + string(debug_color_r) + "," + string(debug_color_g) + "," + string(debug_color_b) + "," + string(debug_color_a)
			+ " (" + string(debug_from_x) + "," + string(debug_from_y) + ")->(" + string(debug_to_x) + "," + string(debug_to_y) + ")"
			+ " extra=" + string(debug_extra_a) + "," + string(debug_extra_b)
			+ debug_author_text
			+ debug_undo_text
			+ debug_fill_sample_text

			/* Append a quoted text suffix only for nonempty tool text so ordinary stroke
			diagnostics remain compact */
			+ (debug_text == "" ? "" : " text=\"" + debug_text + "\"");
	}

	/// @description Record a validation rejection and its provisional command without accepting it
	/// @param {String} reason Specific validation failure to record
	/// @param {Any} command Drawing command to inspect or validate, possibly noone for diagnostics. Defaults to noone
	/// @returns {Real} noone so callers can reject or propagate the failure
	validate_fail = function(reason, command = noone)
	{
		debug_validate_failures++;
		debug_last_invalid_command = string(reason);
		debug_last_command = command;
		debug_note("validate failed", reason);
		return noone;
	}

	/// @description Build a GameMaker RGB color from a command's required channel fields
	/// @param {Any} command Drawing command to inspect or validate, possibly noone for diagnostics
	/// @returns {Real} GameMaker color value, requiring a struct with numeric RGB fields
	command_color = function(command)
	{
		return make_color_rgb(command.color_r, command.color_g, command.color_b);
	}

	/// @description Read command opacity with a fully opaque legacy fallback
	/// @param {Any} command Drawing command to inspect or validate, possibly noone for diagnostics
	/// @returns {Real} Clamped alpha byte, or 255 when no field exists
	command_alpha = function(command)
	{
		/* An explicit alpha field is clamped to a byte. Commands from before opacity was
		serialized retain full opacity at 255 */
		if (is_struct(command)
		&& variable_struct_exists(command, "color_a"))
		{
			return clamp(floor(real(command.color_a)), 0, 255);
		}

		return 255;
	}

	/// @description Check whether command opacity contributes no visible color
	/// @param {Any} command Drawing command to inspect or validate, possibly noone for diagnostics
	/// @returns {Bool} Whether its alpha byte is zero
	command_is_transparent = function(command)
	{
		/* Zero opacity marks transparent drawing, while any positive alpha still represents
		visible color */
		return command_alpha(command) <= 0;
	}

	/// @description Serialize a structured command in the current D6 wire format
	/// @param {Any} command Drawing command to inspect or validate, possibly noone for diagnostics
	/// @returns {String} Pipe-separated D6 payload, or empty text for a nonstruct value
	command_payload_string = function(command)
	{
		/* A nonstruct value cannot supply the required command fields, so serialize no command */
		if (!is_struct(command))
		{
			return "";
		}

		/* D6 fields are pipe-separated in this fixed order: version, tool, layer, player slot,
		author name, undo author, undo group, RGBA bytes, brush diameter, start point, end
		point, extra_a, extra_b, and tool text. The reader uses these exact positions for
		compatibility */
		return "D6"
			+ "|" + string(command.tool_id)
			+ "|" + string(command_layer_id(command))
			+ "|" + string(command_author_player_id(command))
			+ "|" + command_author_name(command)
			+ "|" + string(command_undo_author_id(command))
			+ "|" + string(command_undo_id(command))
			+ "|" + string(command.color_r)
			+ "|" + string(command.color_g)
			+ "|" + string(command.color_b)
			+ "|" + string(command_alpha(command))
			+ "|" + string(command.brush_px)
			+ "|" + string(command.from_x)
			+ "|" + string(command.from_y)
			+ "|" + string(command.to_x)
			+ "|" + string(command.to_y)
			+ "|" + string(command_extra_a(command))
			+ "|" + string(command_extra_b(command))
			+ "|" + text_sanitize(command_payload_text(command));
	}

	/// @description Parse a whole-number payload field with an optional leading minus sign
	/// @param {Any} raw_text Field text expected to encode a whole number
	/// @param {String} field_name Caller-supplied field label, currently unused by the parser
	/// @returns {Real} Numeric integer, or undefined for empty or nondigit input
	payload_integer = function(raw_text, field_name)
	{
		/* Trim the candidate integer field before checking its characters, preserving a
		possible leading minus sign */
		var text = string_trim(string(raw_text));

		/* Count characters so empty values and a lone minus sign can be rejected before
		conversion */
		var length = string_length(text);

		/* An empty field contains no integer, so return undefined for the caller's validation
		failure */
		if (length <= 0)
		{
			return undefined;
		}

		/* GML string positions are one-based. Begin checking at the first character unless a
		minus sign is skipped */
		var start_index = 1;

		/* Allow a leading minus so legacy noone identifiers can pass lexical integer parsing.
		The later field validator decides whether negative values are allowed */
		if (string_char_at(text, 1) == "-")
		{
			/* A minus sign without digits is not an integer and must be rejected before real
			conversion */
			if (length <= 1)
			{
				return undefined;
			}

			start_index = 2;
		}

		/* Check each remaining character from the first digit through the final one, rejecting
		fractional notation and other nondigit text */
		for (var i = start_index; i <= length; i++)
		{
			/* Any nondigit makes the whole payload field invalid, so return undefined rather
			than partially parsing it */
			if (string_pos(string_char_at(text, i), "0123456789") <= 0)
			{
				return undefined;
			}
		}

		return real(text);
	}

	/// @description Decode original and D2-through-D6 command layouts through the shared validator
	/// @param {Any} payload Received or already serialized drawing payload
	/// @returns {Any} Fresh normalized command, or noone with rejection diagnostics
	command_from_payload = function(payload)
	{
		/* Convert the received payload to text and retain the exact received value for
		diagnostics */
		var payload_text = string(payload);
		debug_last_raw_payload = payload_text;

		/* Split fields using the drawing wire format's pipe separator */
		var parts = string_split(payload_text, "|");

		/* Recognize D6 only with its version marker and at least 19 fields, protecting all
		indexed reads and allowing the explicit alpha byte */
		var d6_payload = array_length(parts) >= 19 && parts[0] == "D6";

		/* If D6 did not match, recognize D5 with its marker and at least 18 fields. D5 has
		author attribution and undo groups but no alpha field */
		var d5_payload = !d6_payload && array_length(parts) >= 18 && parts[0] == "D5";

		/* After newer formats fail, identify D4 with at least 16 fields for a layer ID and
		undo author/group IDs */
		var d4_payload = !d6_payload && !d5_payload && array_length(parts) >= 16 && parts[0] == "D4";

		/* Identify D3 only after newer formats fail and its 14-field minimum is present. It
		adds a layer ID but predates undo attribution */
		var d3_payload = !d6_payload && !d5_payload && !d4_payload && array_length(parts) >= 14 && parts[0] == "D3";

		/* The remaining marked D2 format needs 13 fields for tool extensions. It predates
		explicit layer and undo fields */
		var extended_payload = !d6_payload && !d5_payload && !d4_payload && !d3_payload && array_length(parts) >= 13 && parts[0] == "D2";

		/* Accept a recognized marked format or the original nine-field command. Other layouts
		cannot be indexed safely and are rejected */
		if (!d6_payload && !d5_payload && !d4_payload && !d3_payload && !extended_payload && array_length(parts) != 9)
		{
			return validate_fail("payload field count " + string(array_length(parts)), noone);
		}

		/* D6 and D5 share attribution and undo fields, so decode them together. Older formats
		continue to the compatibility offsets below */
		if (d6_payload || d5_payload)
		{
			/* D6 inserts an alpha byte before brush width, shifting later fields by one. D5
			keeps its original indexes */
			var alpha_offset = d6_payload ? 1 : 0;

			/* raw_d5_command temporarily holds unvalidated tool and layer IDs, author
			slot/name, undo author/group IDs, RGBA bytes, world-pixel brush diameter and
			endpoints, numeric tool extensions, and filtered text. Only validate_command may
			turn these received values into a usable command */
			var raw_d5_command =
			{
				tool_id: payload_integer(parts[1], "tool_id"),
				layer_id: payload_integer(parts[2], "layer_id"),
				author_player_id: payload_integer(parts[3], "author_player_id"),
				author_name: text_sanitize(parts[4]),
				undo_author_id: payload_integer(parts[5], "undo_author_id"),
				undo_id: payload_integer(parts[6], "undo_id"),
				color_r: payload_integer(parts[7], "color_r"),
				color_g: payload_integer(parts[8], "color_g"),
				color_b: payload_integer(parts[9], "color_b"),

				/* D6 restores its explicit alpha byte. D5 supplies opaque 255 because that
				older format never carried opacity */
				color_a: d6_payload ? payload_integer(parts[10], "color_a") : 255,
				brush_px: payload_integer(parts[10 + alpha_offset], "brush_px"),
				from_x: payload_integer(parts[11 + alpha_offset], "from_x"),
				from_y: payload_integer(parts[12 + alpha_offset], "from_y"),
				to_x: payload_integer(parts[13 + alpha_offset], "to_x"),
				to_y: payload_integer(parts[14 + alpha_offset], "to_y"),
				extra_a: payload_integer(parts[15 + alpha_offset], "extra_a"),
				extra_b: payload_integer(parts[16 + alpha_offset], "extra_b"),
				text: text_sanitize(parts[17 + alpha_offset])
			};

			debug_last_raw_command = raw_d5_command;

			/* Every required integer field must parse, including attribution, channels,
			coordinates, and extensions. Any undefined result rejects this whole command
			before numeric validation */
			if (is_undefined(raw_d5_command.tool_id)
			|| is_undefined(raw_d5_command.layer_id)
			|| is_undefined(raw_d5_command.author_player_id)
			|| is_undefined(raw_d5_command.undo_author_id)
			|| is_undefined(raw_d5_command.undo_id)
			|| is_undefined(raw_d5_command.color_r)
			|| is_undefined(raw_d5_command.color_g)
			|| is_undefined(raw_d5_command.color_b)
			|| is_undefined(raw_d5_command.color_a)
			|| is_undefined(raw_d5_command.brush_px)
			|| is_undefined(raw_d5_command.from_x)
			|| is_undefined(raw_d5_command.from_y)
			|| is_undefined(raw_d5_command.to_x)
			|| is_undefined(raw_d5_command.to_y)
			|| is_undefined(raw_d5_command.extra_a)
			|| is_undefined(raw_d5_command.extra_b))
			{
				return validate_fail("payload non-integer value", raw_d5_command);
			}

			/* Validate the parsed modern command, obtaining a normalized struct or noone on
			rejection */
			var d5_command = validate_command(raw_d5_command);

			/* Record a normalized serialized diagnostic only after validation succeeds. A
			rejected payload does not replace the last accepted diagnostic */
			if (d5_command != noone)
			{
				debug_last_validated_payload = command_payload_string(d5_command);
			}

			return d5_command;
		}

		/* The original format begins with the tool at index zero, while D2 begins after its
		version marker */
		var offset = extended_payload ? 1 : 0;

		/* D3 and D4 insert one layer field after the tool, shifting subsequent legacy fields */
		var layer_offset = (d3_payload || d4_payload) ? 1 : 0;

		/* D4 additionally inserts two undo fields after the layer. Earlier versions have no
		undo offset */
		var undo_offset = d4_payload ? 2 : 0;

		/* D3 and D4 also have a leading version marker, so move the initial field offset past
		it */
		if (d3_payload || d4_payload)
		{
			offset = 1;
		}

		/* raw_command holds legacy tool, layer, undo IDs, RGB bytes, brush diameter, world
		endpoints, numeric extensions, and text before validation. Legacy opacity starts at
		opaque 255 because these formats lack an alpha field. Author attribution is absent
		and receives validator defaults */
		var raw_command =
		{
			tool_id: payload_integer(parts[offset + 0], "tool_id"),

			/* D3 and D4 restore the explicit layer ID. Earlier commands belong to default
			layer one */
			layer_id: (d3_payload || d4_payload) ? payload_integer(parts[offset + 1], "layer_id") : 1,

			/* D4 restores undo_author_id. Earlier formats use zero because no
			connection-specific undo author was transmitted */
			undo_author_id: d4_payload ? payload_integer(parts[offset + 2], "undo_author_id") : 0,

			/* D4 restores undo_id. Earlier formats use zero to mark an ungrouped command */
			undo_id: d4_payload ? payload_integer(parts[offset + 3], "undo_id") : 0,
			color_r: payload_integer(parts[offset + 1 + layer_offset + undo_offset], "color_r"),
			color_g: payload_integer(parts[offset + 2 + layer_offset + undo_offset], "color_g"),
			color_b: payload_integer(parts[offset + 3 + layer_offset + undo_offset], "color_b"),
			color_a: 255,
			brush_px: payload_integer(parts[offset + 4 + layer_offset + undo_offset], "brush_px"),
			from_x: payload_integer(parts[offset + 5 + layer_offset + undo_offset], "from_x"),
			from_y: payload_integer(parts[offset + 6 + layer_offset + undo_offset], "from_y"),
			to_x: payload_integer(parts[offset + 7 + layer_offset + undo_offset], "to_x"),
			to_y: payload_integer(parts[offset + 8 + layer_offset + undo_offset], "to_y"),

			/* Marked extended formats restore extra_a. Original nine-field strokes use zero
			because they have no extension values */
			extra_a: (d4_payload || d3_payload || extended_payload) ? payload_integer(parts[offset + 9 + layer_offset + undo_offset], "extra_a") : 0,

			/* Marked extended formats restore extra_b. Original nine-field strokes use zero */
			extra_b: (d4_payload || d3_payload || extended_payload) ? payload_integer(parts[offset + 10 + layer_offset + undo_offset], "extra_b") : 0,

			/* Restore and filter text only for marked extended formats. Original strokes
			contain no text and use an empty value */
			text: (d4_payload || d3_payload || extended_payload) ? text_sanitize(parts[offset + 11 + layer_offset + undo_offset]) : ""
		};

		debug_last_raw_command = raw_command;

		/* Reject any legacy numeric field that failed integer parsing before normalizing the
		command. Layer and undo fields are checked by the validator below */
		if (is_undefined(raw_command.tool_id)
		|| is_undefined(raw_command.color_r)
		|| is_undefined(raw_command.color_g)
		|| is_undefined(raw_command.color_b)
		|| is_undefined(raw_command.brush_px)
		|| is_undefined(raw_command.from_x)
		|| is_undefined(raw_command.from_y)
		|| is_undefined(raw_command.to_x)
		|| is_undefined(raw_command.to_y)
		|| is_undefined(raw_command.extra_a)
		|| is_undefined(raw_command.extra_b))
		{
			return validate_fail("payload non-integer value", raw_command);
		}

		/* Normalize the decoded legacy command through the same validator used by current
		packets */
		var command = validate_command(raw_command);

		/* Only a successfully validated command updates the accepted-payload diagnostic,
		leaving the old diagnostic intact on rejection */
		if (command != noone)
		{
			debug_last_validated_payload = command_payload_string(command);
		}

		return command;
	}

	/// @description Capture local attribution and brush opacity defaults in a validated drawing command
	/// @param {Real} tool_id DRAW_TOOL identifier for an accepted drawing command
	/// @param {Real} color_r Red channel byte
	/// @param {Real} color_g Green channel byte
	/// @param {Real} color_b Blue channel byte
	/// @param {Real} brush_px Brush diameter in world pixels
	/// @param {Real} from_x World-pixel starting x, or fill seed x
	/// @param {Real} from_y World-pixel starting y, or fill seed y
	/// @param {Real} to_x World-pixel ending x, or first fill-bounds corner x
	/// @param {Real} to_y World-pixel ending y, or first fill-bounds corner y
	/// @param {Real} extra_a Tool extension value, including opposite fill-bounds x. Defaults to 0
	/// @param {Real} extra_b Tool extension value, including opposite fill-bounds y. Defaults to 0
	/// @param {String} text Drawing text or legacy fill-mode text. Defaults to ""
	/// @param {Real} layer_id Stable target layer ID, defaulting to the current active layer
	/// @param {Bool} fill_sample_visible Whether a fill samples visible layers instead of only its target. Defaults to false
	/// @param {Real} undo_id Stroke-group ID, defaulting to the active local group
	/// @param {Real} undo_author_id Connection-specific undo author ID, defaulting to the assigned local author
	/// @param {Real} color_a Opacity byte. undefined captures the current brush alpha. Defaults to undefined
	/// @returns {Any} Fresh normalized command, or noone if supplied fields are invalid
	make_command = function(tool_id, color_r, color_g, color_b, brush_px, from_x, from_y, to_x, to_y, extra_a = 0, extra_b = 0, text = "", layer_id = active_layer_id, fill_sample_visible = false, undo_id = active_undo_group_id, undo_author_id = local_undo_author_id, color_a = undefined)
	{
		refresh_local_identity_from_client();

		/* raw_command gathers caller tool/layer IDs, current local player attribution, undo
		group, RGBA bytes, world-pixel brush and endpoints, tool extensions, filtered text,
		and the fill sampling flag. It remains provisional until validate_command checks it */
		var raw_command =
		{
			tool_id: tool_id,
			layer_id: layer_id,
			author_player_id: local_player_id,
			author_name: local_player_name,

			/* Retain the requested undo author only for a positive undo group. Ungrouped
			drawing uses zero so it cannot accidentally claim a stroke group */
			undo_author_id: undo_id > 0 ? undo_author_id : 0,
			undo_id: max(0, floor(real(undo_id))),
			color_r: color_r,
			color_g: color_g,
			color_b: color_b,

			/* An omitted alpha argument captures the current brush opacity. An explicit
			argument lets generated commands keep their own opacity */
			color_a: is_undefined(color_a) ? brush_alpha : color_a,
			brush_px: brush_px,
			from_x: from_x,
			from_y: from_y,
			to_x: to_x,
			to_y: to_y,
			extra_a: extra_a,
			extra_b: extra_b,
			text: text_sanitize(text),
			fill_sample_visible: fill_sample_visible
		};

		debug_last_outgoing_command = raw_command;
		return validate_command(raw_command);
	}

	/// @description Check drawing shape, numeric fields, tool limits, and fill bounds before normalization
	/// @param {Any} command Drawing command to inspect or validate, possibly noone for diagnostics
	/// @returns {Any} Fresh accepted command, or noone with a recorded reason
	validate_command = function(command)
	{
		/* Only a command struct can expose the required drawing fields. Reject other values
		before reading any members */
		if (!is_struct(command))
		{
			return validate_fail("command is not a struct", command);
		}

		/* raw_tool_id identifies the requested tool and remains undefined if omitted */
		var raw_tool_id = debug_struct_field(command, "tool_id");

		/* raw_layer_id identifies its target layer, defaulting to the legacy layer one when
		omitted */
		var raw_layer_id = debug_struct_field(command, "layer_id", 1);

		/* raw_color_r, raw_color_g, and raw_color_b hold the unvalidated RGB channels. Missing
		channels stay undefined for rejection below */
		var raw_color_r = debug_struct_field(command, "color_r");
		var raw_color_g = debug_struct_field(command, "color_g");
		var raw_color_b = debug_struct_field(command, "color_b");

		/* raw_color_a holds explicit opacity or the legacy fully opaque default */
		var raw_color_a = debug_struct_field(command, "color_a", 255);

		/* raw_brush_px is the unvalidated world-pixel brush diameter, undefined when omitted */
		var raw_brush_px = command_brush_px(command);

		/* raw_from_x/raw_from_y are the starting world point, while raw_to_x/raw_to_y are the
		endpoint. Missing coordinates remain undefined */
		var raw_from_x = debug_struct_field(command, "from_x");
		var raw_from_y = debug_struct_field(command, "from_y");
		var raw_to_x = debug_struct_field(command, "to_x");
		var raw_to_y = debug_struct_field(command, "to_y");

		/* raw_extra_a and raw_extra_b hold tool-specific numeric extensions, zero for ordinary
		or older commands */
		var raw_extra_a = debug_struct_field(command, "extra_a", 0);
		var raw_extra_b = debug_struct_field(command, "extra_b", 0);

		/* raw_text holds optional tool text, initially empty when the field is omitted */
		var raw_text = command_text_value(command);

		/* raw_author_player_id holds the optional player slot, noone when unknown.
		raw_author_name holds optional displayed attribution, empty when unavailable */
		var raw_author_player_id = debug_struct_field(command, "author_player_id", noone);
		var raw_author_name = debug_struct_field(command, "author_name", "");

		/* raw_undo_author_id identifies the connection's drawing author and raw_undo_id
		identifies its stroke group. Both default to zero for ungrouped legacy history */
		var raw_undo_author_id = debug_struct_field(command, "undo_author_id", 0);
		var raw_undo_id = debug_struct_field(command, "undo_id", 0);

		/* Probe the optional player ID with whole-slot validation before rejecting malformed
		explicit attribution */
		var clean_author_player_id_probe = coerce_player_id(raw_author_player_id);

		/* Without a tool ID, no rendering operation can be selected. Reject instead of
		guessing a tool */
		if (is_undefined(raw_tool_id))
		{
			return validate_fail("missing tool_id", command);
		}

		/* An explicitly undefined layer ID has no target. The omitted-field default still
		allows legacy commands on layer one */
		if (is_undefined(raw_layer_id))
		{
			return validate_fail("missing layer_id", command);
		}

		/* Every RGBA component must exist before range checks, including the alpha value
		supplied for legacy commands. Reject any undefined channel */
		if (is_undefined(raw_color_r)
		|| is_undefined(raw_color_g)
		|| is_undefined(raw_color_b)
		|| is_undefined(raw_color_a))
		{
			return validate_fail("missing color", command);
		}

		/* A missing brush diameter cannot define a stroke or text size, so reject it before
		rounding and range checks */
		if (is_undefined(raw_brush_px))
		{
			return validate_fail("missing brush_px", command);
		}

		/* All start and end coordinates must exist before room-bound validation. Reject any
		incomplete point pair */
		if (is_undefined(raw_from_x)
		|| is_undefined(raw_from_y)
		|| is_undefined(raw_to_x)
		|| is_undefined(raw_to_y))
		{
			return validate_fail("missing coordinates", command);
		}

		/* Undefined undo author or group values cannot be normalized safely. Reject them
		rather than claiming an accidental group */
		if (is_undefined(raw_undo_author_id)
		|| is_undefined(raw_undo_id))
		{
			return validate_fail("missing undo metadata", command);
		}

		/* Rendering fields and undo IDs must be real numbers. An explicit known player ID must
		also be a valid whole slot, while missing or noone attribution is allowed. Reject
		any mismatch before conversion and field access */
		if (!is_real(raw_tool_id)
		|| !is_real(raw_layer_id)
		|| !is_real(raw_color_r)
		|| !is_real(raw_color_g)
		|| !is_real(raw_color_b)
		|| !is_real(raw_color_a)
		|| !is_real(raw_brush_px)
		|| !is_real(raw_from_x)
		|| !is_real(raw_from_y)
		|| !is_real(raw_to_x)
		|| !is_real(raw_to_y)
		|| !is_real(raw_extra_a)
		|| !is_real(raw_extra_b)
		|| (!is_undefined(raw_author_player_id) && raw_author_player_id != noone && clean_author_player_id_probe == noone)
		|| !is_real(raw_undo_author_id)
		|| !is_real(raw_undo_id))
		{
			return validate_fail("non-real command value", command);
		}

		/* clean_tool_id is the whole-number tool selection used by rendering and tool-specific
		checks */
		var clean_tool_id = floor(real(raw_tool_id));

		/* clean_layer_id is the positive whole stable layer ID retained in the normalized
		command */
		var clean_layer_id = max(1, floor(real(raw_layer_id)));

		/* Keep the already validated optional author slot, including noone for unattributed
		history */
		var clean_author_player_id = clean_author_player_id_probe;

		/* Blank author text stays empty. A nonblank author uses username sanitization for
		consistent social and drawing attribution */
		var clean_author_name = string_trim(string(raw_author_name)) == "" ? "" : chat_sanitize_username(raw_author_name);

		/* clean_undo_author_id and clean_undo_id are nonnegative whole identifiers, with zero
		marking unavailable author or group state */
		var clean_undo_author_id = max(0, floor(real(raw_undo_author_id)));
		var clean_undo_id = max(0, floor(real(raw_undo_id)));

		/* Only pen, eraser, line, rectangle, circle, fill, text, and selection-clear commands
		are valid here. Picker is local-only, stamps travel as images, and walls use their
		own packets, so other IDs are rejected */
		if (clean_tool_id != DRAW_TOOL_PEN
		&& clean_tool_id != DRAW_TOOL_ERASER
		&& clean_tool_id != DRAW_TOOL_LINE
		&& clean_tool_id != DRAW_TOOL_RECTANGLE
		&& clean_tool_id != DRAW_TOOL_CIRCLE
		&& clean_tool_id != DRAW_TOOL_FILL
		&& clean_tool_id != DRAW_TOOL_TEXT
		&& clean_tool_id != DRAW_TOOL_SELECT)
		{
			return validate_fail("bad tool_id " + string(raw_tool_id), command);
		}

		/* clean_color_r, clean_color_g, clean_color_b, and clean_color_a are whole-number red,
		green, blue, and opacity bytes before range validation */
		var clean_color_r = floor(real(raw_color_r));
		var clean_color_g = floor(real(raw_color_g));
		var clean_color_b = floor(real(raw_color_b));
		var clean_color_a = floor(real(raw_color_a));

		/* Each channel must fit the zero-to-255 byte range used by rendering and PNG
		conversion. Reject any out-of-range component */
		if (clean_color_r < 0 || clean_color_r > 255
		|| clean_color_g < 0 || clean_color_g > 255
		|| clean_color_b < 0 || clean_color_b > 255
		|| clean_color_a < 0 || clean_color_a > 255)
		{
			return validate_fail("color out of range", command);
		}

		/* Round the supplied world-pixel brush diameter down before enforcing the tool's
		limits */
		var clean_brush_px = floor(real(raw_brush_px));

		/* Erase commands may use the larger eraser ceiling. All other accepted tools use the
		normal brush ceiling */
		var command_max_width = clean_tool_id == DRAW_TOOL_ERASER ? max_eraser_width : max_brush_width;

		/* Reject diameters below the minimum or above this tool's maximum so rendering never
		uses an unsupported size */
		if (clean_brush_px < min_brush_width
		|| clean_brush_px > command_max_width)
		{
			return validate_fail("brush_px out of range " + string(raw_brush_px), command);
		}

		/* clean_from_x/clean_from_y and clean_to_x/clean_to_y are rounded world-pixel
		endpoints used by the final command */
		var clean_from_x = round(real(raw_from_x));
		var clean_from_y = round(real(raw_from_y));
		var clean_to_x = round(real(raw_to_x));
		var clean_to_y = round(real(raw_to_y));

		/* clean_extra_a and clean_extra_b are rounded tool extension values, including the
		opposite fill-bounds corner for fills */
		var clean_extra_a = round(real(raw_extra_a));
		var clean_extra_b = round(real(raw_extra_b));

		/* Enable visible-layer sampling only for an actual fill whose modern or legacy flag
		requests it. Other tools store false */
		var clean_fill_sample_visible = clean_tool_id == DRAW_TOOL_FILL && command_fill_sample_visible(command);

		/* Both rounded endpoints must lie within the room's inclusive pixel bounds. Reject a
		point outside either axis before any surface operation */
		if (clean_from_x < 0 || clean_from_x > room_width - 1
		|| clean_to_x < 0 || clean_to_x > room_width - 1
		|| clean_from_y < 0 || clean_from_y > room_height - 1
		|| clean_to_y < 0 || clean_to_y > room_height - 1)
		{
			return validate_fail("coordinates out of room", command);
		}

		/* Fill interprets the endpoint and extensions as sampling bounds, so it needs extra
		rectangle and seed checks. Other tools keep their normal endpoint validation */
		if (clean_tool_id == DRAW_TOOL_FILL)
		{
			/* The opposite fill corner must also lie inside the room before computing its
			sampling rectangle */
			if (clean_extra_a < 0 || clean_extra_a > room_width - 1
			|| clean_extra_b < 0 || clean_extra_b > room_height - 1)
			{
				return validate_fail("fill bounds out of room", command);
			}

			/* fill_left and fill_top are the lesser x/y bounds. fill_right and fill_bottom are
			the greater bounds, all inclusive world-pixel coordinates */
			var fill_left = min(clean_to_x, clean_extra_a);
			var fill_top = min(clean_to_y, clean_extra_b);
			var fill_right = max(clean_to_x, clean_extra_a);
			var fill_bottom = max(clean_to_y, clean_extra_b);

			/* Count every sampled rectangle pixel, including both inclusive edges, before
			allocating fill work */
			var fill_bounds_area = (fill_right - fill_left + 1) * (fill_bottom - fill_top + 1);

			/* Reject a fill rectangle above the sampling-area ceiling so it cannot demand an
			unsupported work area */
			if (fill_bounds_area > max_fill_bounds_area)
			{
				return validate_fail("fill bounds too large " + string(fill_bounds_area), command);
			}

			/* The start point is the fill seed and must lie inside the accepted rectangle. A
			seed outside its sample bounds cannot be processed and is rejected */
			if (clean_from_x < fill_left
			|| clean_from_x > fill_right
			|| clean_from_y < fill_top
			|| clean_from_y > fill_bottom)
			{
				return validate_fail("fill origin outside bounds", command);
			}
		}

		/* clean_command is the validated replay/network record. It stores normalized tool and
		layer IDs, RGBA bytes, brush diameter, world endpoints, tool extensions, text and
		sampling mode, player attribution, and connection-specific undo IDs. These fields
		are copied from the checked locals rather than retaining the caller's mutable struct */
		var clean_command =
		{
			tool_id: clean_tool_id,
			layer_id: clean_layer_id,
			color_r: clean_color_r,
			color_g: clean_color_g,
			color_b: clean_color_b,
			color_a: clean_color_a,
			brush_px: clean_brush_px,
			from_x: clean_from_x,
			from_y: clean_from_y,
			to_x: clean_to_x,
			to_y: clean_to_y,
			extra_a: clean_extra_a,
			extra_b: clean_extra_b,

			/* Only a text tool keeps filtered text. Other tools store an empty text field so
			unrelated extensions are not treated as drawing text */
			text: clean_tool_id == DRAW_TOOL_TEXT ? text_sanitize(raw_text) : "",
			fill_sample_visible: clean_fill_sample_visible,
			author_player_id: clean_author_player_id,
			author_name: clean_author_name,
			undo_author_id: clean_undo_author_id,
			undo_id: clean_undo_id
		};

		/* A text tool with no displayable contents draws nothing, so reject it rather than
		storing an empty history action */
		if (clean_tool_id == DRAW_TOOL_TEXT
		&& clean_command.text == "")
		{
			return validate_fail("empty text command", command);
		}

		debug_last_validated_command = clean_command;
		debug_last_validated_payload = command_payload_string(clean_command);
		return clean_command;
	}

	/// @description Write a D6 drawing payload into the caller's shared network packet buffer
	/// @param {Any} command Drawing command to inspect or validate, possibly noone for diagnostics
	write_command = function(command)
	{
		/* Serialize the command once for both the outgoing diagnostic and the shared packet
		buffer */
		var payload = command_payload_string(command);
		debug_last_outgoing_payload = payload;
		net.write(buffer_string, payload);
	}

	/// @description Write supplied drawing payload text into the caller's shared network packet buffer
	/// @param {Any} payload Received or already serialized drawing payload
	write_command_payload = function(payload)
	{
		/* Normalize an already serialized payload to text before recording and writing it */
		var payload_text = string(payload);
		debug_last_outgoing_payload = payload_text;
		net.write(buffer_string, payload_text);
	}

	/// @description Decode one drawing payload from the caller-primed shared network reader
	/// @returns {Any} Validated command, or noone
	read_command = function()
	{
		/* Read one buffer_string from the primed network reader, then decode and validate its
		versioned drawing payload */
		return command_from_payload(net.read(buffer_string));
	}
	#endregion /* Command Validation and Serialization END */

	#region /* Layer and Undo History Payloads */
	/// @description Build a normalized tagged layer operation with optional attribution
	/// @param {Real} layer_op DRAW_LAYER operation identifier
	/// @param {Real} layer_id Stable target layer ID
	/// @param {Real} layer_index Requested stored-stack index, not a stable ID
	/// @param {String} layer_name Proposed display name, with a default layer label used when blank
	/// @param {Real} source_layer_id Stable source ID for duplication, zero when not applicable. Defaults to 0
	/// @param {Bool} layer_visible Legacy visibility flag retained in the record for payload compatibility. Defaults to true
	/// @param {Real} author_player_id Author's zero-based player slot, noone when unavailable. Defaults to noone
	/// @param {String} author_name Optional author display text. Defaults to ""
	/// @returns {Struct} New layer-history item, with the legacy visibility field retained
	make_layer_history_item = function(layer_op, layer_id, layer_index, layer_name = "", source_layer_id = 0, layer_visible = true, author_player_id = noone, author_name = "")
	{
		/* This tagged layer record stores op, stable layer_id, requested stack index, cleaned
		name, duplication source_layer_id, legacy visible flag, and optional author
		slot/name. Numeric IDs and positions are normalized before the item enters history */
		return
		{
			history_kind: DRAW_HISTORY_LAYER,
			op: floor(real(layer_op)),
			layer_id: max(1, floor(real(layer_id))),
			index: floor(real(layer_index)),
			name: layer_name_clean(layer_name, layer_default_name(layer_id)),
			source_layer_id: max(0, floor(real(source_layer_id))),
			visible: layer_visible,
			author_player_id: author_player_id,
			author_name: layer_author_name_clean(author_name)
		};
	}

	/// @description Serialize a complete layer-history item in the L2 wire format
	/// @param {Struct} item Complete tagged history item with fields required by its serializer
	/// @returns {String} Pipe-separated layer operation and author metadata
	layer_payload_string = function(item)
	{
		/* L2 serializes the operation, stable target ID, stack index, source ID, legacy
		visibility, cleaned layer name, player slot, and cleaned author name in that
		pipe-separated order */
		return "L2"
			+ "|" + string(item.op)
			+ "|" + string(item.layer_id)
			+ "|" + string(item.index)
			+ "|" + string(item.source_layer_id)

			/* Encode the legacy visible field as one or zero to retain its historical payload
			format, even though clients keep their visibility choices locally */
			+ "|" + string(item.visible ? 1 : 0)
			+ "|" + layer_name_clean(item.name, layer_default_name(item.layer_id))
			+ "|" + string(command_author_player_id(item))
			+ "|" + layer_author_name_clean(command_author_name(item));
	}

	/// @description Decode common L1 fields and optional L2 attribution for accepted layer operations
	/// @param {Any} payload Received versioned history payload
	/// @returns {Any} Normalized layer-history item, or noone on malformed input
	layer_item_from_payload = function(payload)
	{
		/* Normalize the received layer payload to text before splitting its fixed fields */
		var payload_text = string(payload);

		/* Keep the pipe-separated fields in wire order for the layer decoder */
		var parts = string_split(payload_text, "|");

		/* Read the version marker from the first field when present, otherwise use empty text
		so malformed payloads can be rejected */
		var payload_version = array_length(parts) > 0 ? parts[0] : "";

		/* Require the seven common fields and a recognized L1 or L2 marker before indexed
		field reads. Other formats are not layer records */
		if (array_length(parts) < 7
		|| (payload_version != "L1" && payload_version != "L2"))
		{
			return noone;
		}

		/* raw_op identifies the requested layer operation before validation */
		var raw_op = payload_integer(parts[1], "layer_op");

		/* raw_layer_id names the target layer by stable ID rather than stack position */
		var raw_layer_id = payload_integer(parts[2], "layer_id");

		/* raw_index is the requested stack position before operation-specific bounds checks
		elsewhere */
		var raw_index = payload_integer(parts[3], "layer_index");

		/* raw_source_layer_id names the source layer for duplication, with zero marking no
		source */
		var raw_source_layer_id = payload_integer(parts[4], "source_layer_id");

		/* Parse the legacy visible numeric field for format validity even though it will not
		control local visibility */
		var raw_visible = payload_integer(parts[5], "visible");

		/* Reject the record if any common numeric field could not be parsed as an integer,
		avoiding partial operations from malformed payloads */
		if (is_undefined(raw_op)
		|| is_undefined(raw_layer_id)
		|| is_undefined(raw_index)
		|| is_undefined(raw_source_layer_id)
		|| is_undefined(raw_visible))
		{
			return noone;
		}

		/* Normalize the parsed operation to the whole-number enum used by history application */
		var clean_op = floor(real(raw_op));

		/* Accept only add, duplicate, delete, move, archive, and restore operations. Shared
		visibility changes are excluded because visibility belongs to each client */
		if (clean_op != DRAW_LAYER_ADD
		&& clean_op != DRAW_LAYER_DUPLICATE
		&& clean_op != DRAW_LAYER_DELETE
		&& clean_op != DRAW_LAYER_MOVE
		&& clean_op != DRAW_LAYER_ARCHIVE
		&& clean_op != DRAW_LAYER_RESTORE)
		{
			return noone;
		}

		/* The legacy visible field stays in the payload for compatibility, but
		visibility itself is local to each client and is not replayed from history */
		/* Older L1 records have no player attribution, so begin with the unknown-slot sentinel */
		var author_player_id = noone;

		/* Older records have no author display name, so begin with empty attribution */
		var author_name = "";

		/* L2 extends the common fields with player and author attribution. L1 retains the
		unknown-slot and empty-name defaults */
		if (payload_version == "L2")
		{
			/* An L2 record needs both extra attribution fields before either can be read, so
			reject a truncated extension */
			if (array_length(parts) < 9)
			{
				return noone;
			}

			/* Parse the L2 author field as a whole player-slot number, retaining noone's
			legacy numeric representation */
			var raw_author_id = payload_integer(parts[7], "layer_author_id");

			/* A malformed numeric author field invalidates the layer record, so stop instead
			of inventing attribution */
			if (is_undefined(raw_author_id))
			{
				return noone;
			}
			author_player_id = raw_author_id;
			author_name = parts[8];
		}

		return make_layer_history_item(clean_op, raw_layer_id, raw_index, parts[6], raw_source_layer_id, true, author_player_id, author_name);
	}

	/// @description Build a tagged undo request for a positive author-and-stroke pair
	/// @param {Real} undo_author_id Connection-specific undo author identifier
	/// @param {Real} undo_id Stroke-group identifier within that author
	/// @returns {Struct} New undo-history item
	make_undo_history_item = function(undo_author_id, undo_id)
	{
		/* An undo record's history_kind selects undo handling. undo_author_id identifies the
		connection and undo_id identifies its stroke group, both normalized to positive
		integers */
		return
		{
			history_kind: DRAW_HISTORY_UNDO,
			undo_author_id: max(1, floor(real(undo_author_id))),
			undo_id: max(1, floor(real(undo_id)))
		};
	}

	/// @description Serialize an undo-history item in the U1 wire format
	/// @param {Struct} item Complete tagged history item with fields required by its serializer
	/// @returns {String} Pipe-separated author and stroke-group identifiers
	undo_payload_string = function(item)
	{
		/* U1 serializes only the connection-specific author and stroke-group IDs after its
		version marker */
		return "U1"
			+ "|" + string(item.undo_author_id)
			+ "|" + string(item.undo_id);
	}

	/// @description Decode a U1 undo record with positive integer identifiers
	/// @param {Any} payload Received versioned history payload
	/// @returns {Any} New undo-history item, or noone
	undo_item_from_payload = function(payload)
	{
		/* Normalize the received undo payload to text before decoding its three-field format */
		var payload_text = string(payload);

		/* Split version, author ID, and group ID using the history pipe delimiter */
		var parts = string_split(payload_text, "|");

		/* Only a U1 marker with at least three fields can identify an undo request. Reject
		other or truncated formats before indexed reads */
		if (array_length(parts) < 3 || parts[0] != "U1")
		{
			return noone;
		}

		/* Parse the requested connection-specific drawing author ID */
		var raw_author_id = payload_integer(parts[1], "undo_author_id");

		/* Parse the requested stroke-group ID within that author */
		var raw_undo_id = payload_integer(parts[2], "undo_id");

		/* Both undo identifiers must parse and be positive. Zero or malformed values cannot
		identify an undoable group and are rejected */
		if (is_undefined(raw_author_id)
		|| is_undefined(raw_undo_id)
		|| raw_author_id <= 0
		|| raw_undo_id <= 0)
		{
			return noone;
		}

		return make_undo_history_item(raw_author_id, raw_undo_id);
	}

	/// @description Choose the layer, undo, image descriptor, or ordinary command format for history
	/// @param {Struct} item Complete tagged history item with fields required by its serializer
	/// @returns {String} Serialized history metadata, with image bytes transferred separately
	history_item_payload_string = function(item)
	{
		/* Tagged layer records use the dedicated L2 serializer. Other record kinds continue to
		their own formats */
		if (history_item_is_layer(item))
		{
			return layer_payload_string(item);
		}

		/* Tagged undo records use the dedicated U1 serializer rather than ordinary brush
		fields */
		if (history_item_is_undo(item))
		{
			return undo_payload_string(item);
		}

		/* Image history emits an I2 metadata descriptor containing image/layer IDs, player
		attribution, undo group, world origin and dimensions, and name. Its PNG bytes are
		transferred separately in chunks */
		if (history_item_is_image(item))
		{
			return "I2"
				+ "|" + string(item.image_id)
				+ "|" + string(item.layer_id)
				+ "|" + string(command_author_player_id(item))
				+ "|" + command_author_name(item)
				+ "|" + string(command_undo_author_id(item))
				+ "|" + string(command_undo_id(item))
				+ "|" + string(item.x)
				+ "|" + string(item.y)
				+ "|" + string(item.w)
				+ "|" + string(item.h)
				+ "|" + string(item.name);
		}

		/* Remaining structured records are ordinary drawing commands and use D6. Nonstruct
		values fall through to string conversion for their existing representation */
		if (is_struct(item))
		{
			return command_payload_string(item);
		}

		return string(item);
	}

	/// @description Dispatch incoming layer and undo records before ordinary command decoding
	/// @param {Any} payload Received versioned history payload
	/// @returns {Any} Decoded history item, or noone for rejection
	history_item_from_payload = function(payload)
	{
		/* Convert the incoming generic history payload to text once for version dispatch */
		var payload_text = string(payload);

		/* Read the first three characters because the layer version marker includes its
		terminating pipe */
		var layer_prefix = string_copy(payload_text, 1, 3);

		/* L1 and L2 prefixes dispatch to the layer decoder. Other formats continue to undo and
		drawing dispatch */
		if (layer_prefix == "L1|" || layer_prefix == "L2|")
		{
			return layer_item_from_payload(payload_text);
		}

		/* A U1 prefix selects the undo decoder. Remaining payloads reach drawing validation,
		which rejects incompatible formats */
		if (string_copy(payload_text, 1, 3) == "U1|")
		{
			return undo_item_from_payload(payload_text);
		}

		/* Treat the remaining payload as an ordinary command. This dispatcher does not
		reconstruct image bytes from an I2 descriptor */
		return command_from_payload(payload_text);
	}

	/// @description Decode one history string from the caller-primed shared packet reader
	/// @returns {Any} Decoded layer, undo, or drawing item, or noone
	read_history_item = function()
	{
		/* Read one history buffer_string from the caller-primed network packet, then dispatch
		by its version prefix */
		return history_item_from_payload(net.read(buffer_string));
	}
	#endregion /* Layer and Undo History Payloads END */

	#region /* Server History Persistence */
	/// @description Copy an accepted layer, image, or command into a JSON-safe persistence envelope
	/// @param {Struct} item Accepted in-memory layer, image, or ordinary command history item
	/// @returns {Any} New kind-and-item record, or noone for unsupported history kinds
	server_history_persistence_record = function(item)
	{
		/* Save tagged layer operations as a kind layer envelope. Its nested item stores op,
		stable layer_id, stack index, cleaned name, duplication source ID, and author
		slot/name. visible is fixed true because persisted history does not own clients'
		local visibility */
		if (history_item_is_layer(item))
		{
			return
			{
				kind: "layer",
				item:
				{
					op: item.op,
					layer_id: item.layer_id,
					index: item.index,
					name: item.name,
					source_layer_id: item.source_layer_id,
					visible: true,
					author_player_id: command_author_player_id(item),
					author_name: command_author_name(item)
				}
			};
		}

		/* Image envelopes keep kind image and a nested item with image/layer IDs, author name
		and slot, filename, world x/y origin and w/h dimensions, base64 PNG bytes,
		smooth-filter flag, and undo author/group IDs. This preserves image contents without
		transient sprite handles */
		if (history_item_is_image(item))
		{
			return
			{
				kind: "image",
				item:
				{
					image_id: item.image_id,
					layer_id: item.layer_id,
					author_player_id: command_author_player_id(item),
					author_name: command_author_name(item),
					name: item.name,
					x: item.x,
					y: item.y,
					w: item.w,
					h: item.h,
					base64: item.base64,

					/* Keep smoothing only when the optional field exists and is enabled. Older
					image records without the field save nearest-neighbour behavior */
					smooth_filter: variable_struct_exists(item, "smooth_filter") && item.smooth_filter,
					undo_author_id: command_undo_author_id(item),
					undo_id: command_undo_id(item)
				}
			};
		}

		/* Only remaining structs with a tool_id can become command envelopes. Their nested
		item stores tool/layer IDs, player attribution, undo IDs, RGBA bytes, world-pixel
		brush diameter and endpoints, extensions, text, and fill sampling mode through
		compatibility accessors */
		if (is_struct(item)
		&& variable_struct_exists(item, "tool_id"))
		{
			return
			{
				kind: "command",
				item:
				{
					tool_id: item.tool_id,
					layer_id: command_layer_id(item),
					author_player_id: command_author_player_id(item),
					author_name: command_author_name(item),
					undo_author_id: command_undo_author_id(item),
					undo_id: command_undo_id(item),
					color_r: item.color_r,
					color_g: item.color_g,
					color_b: item.color_b,
					color_a: command_alpha(item),
					brush_px: command_brush_px(item),
					from_x: item.from_x,
					from_y: item.from_y,
					to_x: item.to_x,
					to_y: item.to_y,
					extra_a: command_extra_a(item),
					extra_b: command_extra_b(item),
					text: command_text_value(item),
					fill_sample_visible: command_fill_sample_visible(item)
				}
			};
		}

		/* Unsupported values, including separate undo markers, have no persistent record
		representation here, so return noone for snapshot rejection */
		return noone;
	}

	/// @description Validate one saved envelope and discard stale player-slot attribution
	/// @param {Any} record Saved kind-and-item envelope that must be validated before use
	/// @returns {Any} Fresh normalized history item, or noone with persistence validation detail
	server_history_item_from_persistence_record = function(record)
	{
		server_history_persistence_validation_error = "invalid record";

		/* Require a record struct with both a kind marker and a structured item before
		dispatching. Missing envelope fields leave the validation error and return noone */
		if (!is_struct(record)
		|| !variable_struct_exists(record, "kind")
		|| !variable_struct_exists(record, "item")
		|| !is_struct(record.item))
		{
			return noone;
		}

		/* Normalize the persisted kind spelling for command, layer, and image dispatch */
		var kind = string_lower(string(record.kind));

		/* Borrow this record's nested metadata for validation, without treating it as an
		accepted history item yet */
		var raw_item = record.item;

		/* Command records use the same numeric, room-bound, and tool validation as network
		commands. Other kinds continue to their dedicated metadata checks */
		if (kind == "command")
		{
			/* Normalize the saved drawing command, obtaining a fresh command or noone with the
			validator's rejection reason */
			var command = validate_command(raw_item);

			/* A rejected command invalidates the saved record. Include the drawing validator's
			detail rather than loading unchecked history */
			if (command == noone)
			{
				server_history_persistence_validation_error = "invalid command: " + debug_last_invalid_command;
				return noone;
			}

			/* Player IDs are connection slots and may belong to someone else after
			a restart. Keep the saved display name, but discard the stale slot */
			command.author_player_id = noone;
			server_history_persistence_validation_error = "";
			return command;
		}

		/* Layer records need their own operation and ID checks because they do not contain
		brush fields */
		if (kind == "layer")
		{
			/* Require operation, target ID, stack index, name, and source ID, with numeric
			types on the operation and identifiers/index. Earlier existence tests protect
			later member reads */
			if (!variable_struct_exists(raw_item, "op")
			|| !variable_struct_exists(raw_item, "layer_id")
			|| !variable_struct_exists(raw_item, "index")
			|| !variable_struct_exists(raw_item, "name")
			|| !variable_struct_exists(raw_item, "source_layer_id")
			|| !is_real(raw_item.op)
			|| !is_real(raw_item.layer_id)
			|| !is_real(raw_item.index)
			|| !is_real(raw_item.source_layer_id))
			{
				server_history_persistence_validation_error = "invalid layer metadata";
				return noone;
			}

			/* layer_op is the saved whole-number operation before checking its allowed enum */
			var layer_op = floor(real(raw_item.op));

			/* layer_id is the saved whole stable target identifier */
			var layer_id = floor(real(raw_item.layer_id));

			/* source_layer_id is the saved duplication source identifier, with zero marking no
			source */
			var source_layer_id = floor(real(raw_item.source_layer_id));

			/* Accept only supported shared layer operations, a positive bounded target ID, and
			a nonnegative bounded source ID. Reject out-of-range metadata before creating a
			layer item */
			if ((layer_op != DRAW_LAYER_ADD
			&& layer_op != DRAW_LAYER_DUPLICATE
			&& layer_op != DRAW_LAYER_DELETE
			&& layer_op != DRAW_LAYER_MOVE
			&& layer_op != DRAW_LAYER_ARCHIVE
			&& layer_op != DRAW_LAYER_RESTORE)
			|| layer_id <= 0
			|| layer_id > 4000000000
			|| source_layer_id < 0
			|| source_layer_id > 4000000000)
			{
				server_history_persistence_validation_error = "layer metadata out of range";
				return noone;
			}

			/* Restore cleaned author text when present. Older layer records without
			attribution use an empty layer_author_name */
			var layer_author_name = variable_struct_exists(raw_item, "author_name")
				? layer_author_name_clean(raw_item.author_name)
				: "";
			server_history_persistence_validation_error = "";
			return make_layer_history_item(
				layer_op,
				layer_id,
				floor(real(raw_item.index)),
				string(raw_item.name),
				source_layer_id,
				true,
				noone,
				layer_author_name
			);
		}

		/* After command and layer dispatch, only image remains supported. Other kind names
		reject the record rather than guessing a drawing format */
		if (kind != "image")
		{
			server_history_persistence_validation_error = "unknown record kind";
			return noone;
		}

		/* Image metadata needs an ID, target layer, name, world origin, dimensions, and base64
		contents. Numeric IDs and geometry must be real before rounding and bounds checks */
		if (!variable_struct_exists(raw_item, "image_id")
		|| !variable_struct_exists(raw_item, "layer_id")
		|| !variable_struct_exists(raw_item, "name")
		|| !variable_struct_exists(raw_item, "x")
		|| !variable_struct_exists(raw_item, "y")
		|| !variable_struct_exists(raw_item, "w")
		|| !variable_struct_exists(raw_item, "h")
		|| !variable_struct_exists(raw_item, "base64")
		|| !is_real(raw_item.image_id)
		|| !is_real(raw_item.layer_id)
		|| !is_real(raw_item.x)
		|| !is_real(raw_item.y)
		|| !is_real(raw_item.w)
		|| !is_real(raw_item.h))
		{
			server_history_persistence_validation_error = "invalid image metadata";
			return noone;
		}

		/* image_id and image_layer_id are whole saved image and target-layer identifiers */
		var image_id = floor(real(raw_item.image_id));
		var image_layer_id = floor(real(raw_item.layer_id));

		/* image_x and image_y are the rounded world-pixel placement origin */
		var image_x = round(real(raw_item.x));
		var image_y = round(real(raw_item.y));

		/* image_w and image_h are the rounded world-pixel placement dimensions, distinct from
		the PNG header dimensions */
		var image_w = round(real(raw_item.w));
		var image_h = round(real(raw_item.h));

		/* Keep the encoded PNG text for validation and the reconstructed image-history item */
		var image_base64 = string(raw_item.base64);

		/* Require bounded IDs, a room-contained origin, positive room-bounded dimensions, and
		nonempty encoded data within the chunk-count ceiling. This check does not require
		the full placed rectangle to stay inside the room */
		if (image_id < 0
		|| image_id > 4000000000
		|| image_layer_id <= 0
		|| image_layer_id > 4000000000
		|| image_x < 0 || image_x > room_width - 1
		|| image_y < 0 || image_y > room_height - 1
		|| image_w <= 0 || image_w > room_width
		|| image_h <= 0 || image_h > room_height
		|| string_length(image_base64) <= 0
		|| string_length(image_base64) > image_chunk_size * image_import_max_chunks)
		{
			server_history_persistence_validation_error = "image metadata out of range";
			return noone;
		}

		/* Own a temporary decoded-PNG buffer only during validation. noone marks no allocation
		and cleanup releases any surviving buffer on error */
		var decoded_image = noone;
		try
		{
			decoded_image = buffer_base64_decode(image_base64);

			/* Reject a missing, empty, or oversized decoded buffer before inspecting its
			header. The byte ceiling derives from the maximum base64 chunk capacity */
			if (is_undefined(decoded_image)
			|| !buffer_exists(decoded_image)
			|| buffer_get_size(decoded_image) <= 0
			|| buffer_get_size(decoded_image) > (image_chunk_size * image_import_max_chunks * 3) div 4)
			{
				/* Release the rejected decoded buffer only if allocation produced a live
				handle, avoiding deletion of undefined or absent resources */
				if (!is_undefined(decoded_image) && buffer_exists(decoded_image))
				{
					buffer_delete(decoded_image);
				}
				server_history_persistence_validation_error = "invalid image data";
				return noone;
			}

			/* Read PNG header dimensions and validity while the temporary byte buffer is
			available, then delete that buffer immediately */
			var png_info = png_dimensions_from_buffer(decoded_image);
			buffer_delete(decoded_image);
			decoded_image = noone;

			/* Reject an invalid PNG header or source dimensions above the import sprite limit.
			The placed world dimensions need not equal the source image dimensions */
			if (!png_info.ok
			|| png_info.w > image_import_max_sprite_dimension
			|| png_info.h > image_import_max_sprite_dimension)
			{
				server_history_persistence_validation_error = "invalid image PNG";
				return noone;
			}
		}
		catch(e)
		{
			/* If decoding or header inspection throws, free a still-live temporary buffer
			before returning a rejected record */
			if (!is_undefined(decoded_image) && buffer_exists(decoded_image))
			{
				buffer_delete(decoded_image);
			}
			server_history_persistence_validation_error = "image decode failed";
			return noone;
		}

		/* Restore an optional image author name. Older records remain unattributed with empty
		text */
		var image_author_name = variable_struct_exists(raw_item, "author_name")
			? raw_item.author_name
			: "";

		/* Restore a numeric undo author as a nonnegative whole ID. Missing or nonnumeric
		optional attribution uses zero for compatibility */
		var image_undo_author_id = variable_struct_exists(raw_item, "undo_author_id")
			&& is_real(raw_item.undo_author_id)
			? max(0, floor(real(raw_item.undo_author_id)))
			: 0;

		/* Restore a numeric undo group as a nonnegative whole ID. Missing or nonnumeric group
		state uses zero */
		var image_undo_id = variable_struct_exists(raw_item, "undo_id")
			&& is_real(raw_item.undo_id)
			? max(0, floor(real(raw_item.undo_id)))
			: 0;

		/* Only an explicit true smoothing flag enables it. Missing or other values retain
		nearest-neighbour image replay */
		var image_smooth_filter = variable_struct_exists(raw_item, "smooth_filter")
			&& raw_item.smooth_filter == true;

		server_history_persistence_validation_error = "";
		return make_image_history_item(
			image_id,
			string_copy(string(raw_item.name), 1, 128),
			image_x,
			image_y,
			image_w,
			image_h,
			image_base64,
			image_layer_id,
			image_undo_id,
			image_undo_author_id,
			noone,
			image_author_name,
			image_smooth_filter
		);
	}

	/// @description Capture authoritative replay order and its checkpoint metadata for saving
	/// @returns {Any} JSON-ready snapshot, or noone if history cannot be represented within its item ceiling
	server_history_persistence_snapshot = function()
	{
		/* Reject an in-memory history above the persistence item ceiling rather than silently
		discarding old commands and their pixels */
		if (array_length(server_history) > max_history)
		{
			server_history_persistence_validation_error = "history item count exceeds the safety limit";
			return noone;
		}

		/* Collect independent persistence envelopes in replay order, starting with no records */
		var records = [];

		/* Visit every authoritative history index from zero, stopping if any item cannot be
		represented on disk */
		for (var history_index = 0; history_index < array_length(server_history); history_index++)
		{
			/* Convert this accepted in-memory history item into a save envelope before
			appending it */
			var record = server_history_persistence_record(server_history[history_index]);

			/* An unsupported item invalidates the whole snapshot so the disk save cannot omit
			part of the shared drawing */
			if (record == noone)
			{
				server_history_persistence_validation_error = "unsupported in-memory item at index " + string(history_index);
				return noone;
			}

			records[array_length(records)] = record;
		}

		/* The snapshot stores format_version for decoder compatibility, item_count for
		integrity checks, history in replay order, and saved_at on the calendar date/time
		clock. checkpointed is true only when the current history already represents a clean
		compact checkpoint */
		return
		{
			format_version: server_history_persistence_format,
			item_count: array_length(records),

			/* Mark the snapshot checkpointed when no accepted change has made its compact
			history stale. Dirty checkpoints retain false so loading can request
			reconstruction */
			checkpointed: !server_history_checkpoint_dirty,
			saved_at: date_current_datetime(),
			history: records
		};
	}

	/// @description Read a complete nonempty save file with bounded character count and owned-handle cleanup
	/// @param {String} path Persistence candidate path in the host save area
	/// @returns {Struct} Result with ok, text, and reason fields
	server_history_persistence_read_text = function(path)
	{
		/* result starts with ok false, empty text, and a file-missing reason. Successful
		nonempty reading replaces these fields, while failures keep a diagnostic without
		exposing partial text */
		var result = { ok: false, text: "", reason: "file missing" };

		/* A missing candidate file cannot be read, so return the initial unavailable result
		without opening a handle */
		if (!file_exists(path))
		{
			return result;
		}

		/* Own a text-file handle during this read, with minus one marking no open file for
		error cleanup */
		var file_handle = -1;
		try
		{
			file_handle = file_text_open_read(path);

			/* An unsuccessful open leaves no usable handle. Return a readable failure before
			attempting text reads */
			if (file_handle < 0)
			{
				result.reason = "could not open file";
				return result;
			}

			/* Accumulate JSON content from empty text. Line endings are skipped because the
			serializer's data is parsed as JSON rather than preserved as a document */
			var contents = "";

			/* Read until the text file reaches EOF, leaving one close after all content has
			been collected */
			while (!file_text_eof(file_handle))
			{
				/* Read the current line before checking whether appending it would exceed the
				text-size ceiling */
				var line = file_text_read_string(file_handle);

				/* Stop and close the file before exceeding the allowed character count,
				returning a failure instead of a partial JSON snapshot */
				if (string_length(contents) + string_length(line) > server_history_persistence_max_chars)
				{
					file_text_close(file_handle);
					file_handle = -1;
					result.reason = "file exceeds size limit";
					return result;
				}

				contents += line;
				file_text_readln(file_handle);
			}

			file_text_close(file_handle);
			file_handle = -1;

			/* Only nonempty complete contents mark the read successful. An empty file still
			returns its empty text with ok false */
			result.ok = string_length(contents) > 0;
			result.text = contents;

			/* A successful read has no failure reason. Empty contents produce the explicit
			file-is-empty detail */
			result.reason = result.ok ? "" : "file is empty";
			return result;
		}
		catch(e)
		{
			/* On a read exception, close a still-open handle with best-effort cleanup. An
			already closed handle needs no work */
			if (file_handle >= 0)
			{
				try { file_text_close(file_handle); } catch(close_error) { }
			}

			/* Prefer an exception's structured message when available, otherwise keep its
			printable form as the read failure reason */
			result.reason = is_struct(e) && variable_struct_exists(e, "message")
				? string(e.message)
				: string(e);
			return result;
		}
	}

	/// @description Decode a matching JSON snapshot and validate every saved record before acceptance
	/// @param {Any} text Complete saved JSON snapshot text
	/// @returns {Struct} Result with ok, restored history, checkpointed flag, and reason
	server_history_persistence_decode = function(text)
	{
		/* result begins rejected with no history, no checkpoint claim, and a generic reason.
		Only complete header and item validation sets ok true */
		var result = { ok: false, history: [], checkpointed: false, reason: "invalid snapshot" };
		try
		{
			/* Parse the supplied JSON into a provisional snapshot that has not yet been
			trusted */
			var snapshot = json_parse(string(text));

			/* Require a structured envelope, matching numeric format version, numeric item
			count, and a history array. Earlier shape checks protect later field access */
			if (!is_struct(snapshot)
			|| !variable_struct_exists(snapshot, "format_version")
			|| !is_real(snapshot.format_version)
			|| floor(real(snapshot.format_version)) != server_history_persistence_format
			|| !variable_struct_exists(snapshot, "item_count")
			|| !is_real(snapshot.item_count)
			|| !variable_struct_exists(snapshot, "history")
			|| !is_array(snapshot.history))
			{
				result.reason = "unsupported snapshot header";
				return result;
			}

			/* Count actual stored history records before comparing their header count and the
			persistence ceiling */
			var record_count = array_length(snapshot.history);

			/* A mismatch between actual records and the floored header count, or a count
			beyond the ceiling, rejects the snapshot rather than restoring an incomplete
			history */
			if (record_count != floor(real(snapshot.item_count))
			|| record_count < 0
			|| record_count > max_history)
			{
				result.reason = "snapshot item count is invalid";
				return result;
			}

			/* Allocate exactly one restored-history entry per saved record, filling them only
			after validation */
			var restored_history = array_create(record_count);

			/* Decode records from index zero in their saved replay order and stop at the first
			rejected item */
			for (var record_index = 0; record_index < record_count; record_index++)
			{
				/* Validate and normalize this persistence envelope into an ordinary history
				item */
				var restored_item = server_history_item_from_persistence_record(snapshot.history[record_index]);

				/* A rejected record aborts the entire load and reports its index and detailed
				validation error */
				if (restored_item == noone)
				{
					result.reason = "item " + string(record_index) + ": " + server_history_persistence_validation_error;
					return result;
				}

				restored_history[record_index] = restored_item;
			}

			result.ok = true;
			result.history = restored_history;

			/* Trust the checkpoint marker only when the optional field explicitly equals true.
			Older snapshots without it need checkpoint reconstruction */
			result.checkpointed = variable_struct_exists(snapshot, "checkpointed")
				&& snapshot.checkpointed == true;
			result.reason = "";
			return result;
		}
		catch(e)
		{
			/* Use a structured parse exception message when available, otherwise stringify the
			exception in the rejected result */
			result.reason = is_struct(e) && variable_struct_exists(e, "message")
				? string(e.message)
				: string(e);
			return result;
		}
	}

	/// @description Schedule quiet-period saving while retaining the first unsaved-change timestamp
	/// @returns {Bool} True after marking history dirty
	mark_server_history_persistence_dirty = function()
	{
		/* Record the first unsaved change time only when history becomes dirty. Later changes
		keep that original current_time timestamp so the maximum wait remains bounded */
		if (!server_history_persistence_dirty)
		{
			server_history_persistence_dirty_since = current_time;
		}

		server_history_persistence_dirty = true;
		server_history_persistence_save_at = current_time + server_history_persistence_save_delay_ms;
		return true;
	}

	/// @description Attempt to delete all drawing-history save copies and clear persistence scheduling
	/// @returns {Bool} Whether every path is absent after cleanup, with failures diagnosed
	delete_server_history_persistence = function()
	{
		/* Delete pending, primary, and backup save paths so clearing history cannot later
		restore an older recovery copy */
		var persistence_paths =
		[
			server_history_persistence_temp_file,
			server_history_persistence_file,
			server_history_persistence_backup_file
		];

		/* Assume all requested deletions succeed, then retain any failure across the remaining
		paths */
		var deleted_all = true;

		/* Visit each of the three persistence paths from index zero, attempting every cleanup
		even if another one fails */
		for (var persistence_path_index = 0; persistence_path_index < array_length(persistence_paths); persistence_path_index++)
		{
			try
			{
				/* Only an existing file needs deletion. Missing paths already satisfy the
				cleared-history request */
				if (file_exists(persistence_paths[persistence_path_index]))
				{
					file_delete(persistence_paths[persistence_path_index]);

					/* A file still present after deletion marks incomplete cleanup and emits
					its exact path for diagnosis */
					if (file_exists(persistence_paths[persistence_path_index]))
					{
						deleted_all = false;
						debug_error("Saved drawing history file still exists after deletion: " + string(persistence_paths[persistence_path_index]));
					}
				}
			}
			catch(e)
			{
				deleted_all = false;
				debug_error("Could not delete saved drawing history file: " + string(persistence_paths[persistence_path_index]));
			}
		}

		server_history_persistence_dirty = false;
		server_history_persistence_dirty_since = 0;
		server_history_persistence_save_at = 0;
		server_history_persistence_retry_at = 0;
		server_history_persistence_saved_count = 0;

		/* Report cleared saved history only if all paths were removed or absent. Any deletion
		failure selects the incomplete status */
		server_history_persistence_status = deleted_all
			? "cleared saved history"
			: "saved history clear incomplete";
		return deleted_all;
	}

	/// @description Write, verify, rotate, and promote a drawing snapshot, scheduling retry on failure
	/// @param {Bool} force_save Whether clean history should also be written, false by default
	/// @returns {Bool} Whether no write was needed or all save checks succeeded
	save_server_history_persistence = function(force_save = false)
	{
		/* Clean history needs no write unless force_save requests one. Return success for that
		no-work case rather than replacing the existing save */
		if (!force_save && !server_history_persistence_dirty)
		{
			return true;
		}

		/* Own the pending text-write handle while saving. Minus one marks no open handle for
		exception cleanup */
		var temp_handle = -1;
		try
		{
			/* Capture normalized authoritative history before serializing so unsupported
			in-memory items cannot silently disappear */
			var snapshot = server_history_persistence_snapshot();

			/* Snapshot normalization failure enters save error handling, retaining dirty
			history for a later retry */
			if (snapshot == noone)
			{
				throw "Could not normalize drawing history: " + server_history_persistence_validation_error;
			}

			/* Serialize the complete snapshot into the JSON text that both pending and
			promoted copies must match */
			var snapshot_text = json_stringify(snapshot);

			/* An empty or oversized serialized snapshot is not written. The ceiling measures
			characters even though the existing error message calls it a 32 MB limit */
			if (string_length(snapshot_text) <= 0
			|| string_length(snapshot_text) > server_history_persistence_max_chars)
			{
				throw "Saved drawing history exceeds the 32 MB safety limit.";
			}

			temp_handle = file_text_open_write(server_history_persistence_temp_file);

			/* Opening the pending file must produce a usable handle before any write. Failure
			enters retry handling */
			if (temp_handle < 0)
			{
				throw "Could not open pending drawing history file.";
			}
			file_text_write_string(temp_handle, snapshot_text);

			/* Store whether closing reports success, then clear the owned handle because
			subsequent verification reads the flushed pending file independently */
			var pending_closed = file_text_close(temp_handle);
			temp_handle = -1;

			/* An unsuccessful close is treated as a failed save instead of rotating the
			previous primary file */
			if (!pending_closed)
			{
				throw "Could not flush pending drawing history.";
			}

			/* Verify the flushed pending copy before rotating the current save into its backup */
			/* Read the closed pending copy back into a result for exact verification against
			the serialized snapshot */
			var verify_result = server_history_persistence_read_text(server_history_persistence_temp_file);

			/* Reject unreadable or different pending contents before rotating any previous
			saved history */
			if (!verify_result.ok || verify_result.text != snapshot_text)
			{
				throw "Pending drawing history verification failed: " + verify_result.reason;
			}

			/* When both primary and backup exist, clear the old backup so the current primary
			can become the next recovery copy. Without a primary, retain any existing backup */
			if (file_exists(server_history_persistence_file) && file_exists(server_history_persistence_backup_file))
			{
				file_delete(server_history_persistence_backup_file);

				/* A backup that survives deletion blocks rotation, preserving the primary and
				entering retry handling */
				if (file_exists(server_history_persistence_backup_file))
				{
					throw "Could not rotate the previous drawing history backup.";
				}
			}

			/* An existing primary moves to the backup before promotion. With no primary, there
			is no current file to rotate */
			if (file_exists(server_history_persistence_file))
			{
				file_rename(server_history_persistence_file, server_history_persistence_backup_file);

				/* Verify that rotation removed the primary and created its backup. Either
				mismatch stops promotion rather than claiming a successful save */
				if (file_exists(server_history_persistence_file) || !file_exists(server_history_persistence_backup_file))
				{
					throw "Could not move current drawing history to its backup.";
				}
			}
			file_rename(server_history_persistence_temp_file, server_history_persistence_file);

			/* Read the promoted primary back for exact verification against the same
			serialized snapshot */
			var promoted_result = server_history_persistence_read_text(server_history_persistence_file);

			/* Promotion succeeds only when the pending path disappears and the primary reads
			back identically. Any mismatch enters failure handling */
			if (file_exists(server_history_persistence_temp_file)
			|| !promoted_result.ok || promoted_result.text != snapshot_text)
			{
				throw "Pending drawing history promotion verification failed.";
			}

			server_history_persistence_dirty = false;
			server_history_persistence_dirty_since = 0;
			server_history_persistence_save_at = 0;
			server_history_persistence_retry_at = 0;
			server_history_persistence_saved_count = array_length(server_history);
			server_history_persistence_status = "saved " + string(server_history_persistence_saved_count) + " item(s)";
			debug_note("server history persisted", server_history_persistence_status);
			return true;
		}
		catch(e)
		{
			/* Close a still-owned pending file on failure with best-effort cleanup. A
			previously closed handle needs no extra close */
			if (temp_handle >= 0)
			{
				try { file_text_close(temp_handle); } catch(close_error) { }
			}

			/* Prefer a structured save error message and otherwise keep its printable form for
			both status and logging */
			var save_error = is_struct(e) && variable_struct_exists(e, "message")
				? string(e.message)
				: string(e);

			/* A failed attempt keeps history dirty and schedules a one-minute current_time
			retry. Reset its dirty epoch too so the normal maximum-wait check cannot bypass
			the retry gate */
			server_history_persistence_dirty = true;
			server_history_persistence_dirty_since = current_time;
			server_history_persistence_save_at = current_time + 60000;
			server_history_persistence_retry_at = current_time + 60000;
			server_history_persistence_status = "save failed: " + save_error;
			debug_error("Could not persist server drawing history: " + save_error);
			return false;
		}
	}

	/// @description Restore the first valid pending, primary, or backup history and rebuild host layer state
	/// @returns {Real} Restored item count, zero without any save file, or minus one if all existing candidates failed
	load_server_history_persistence = function()
	{
		/* Try pending, primary, then backup copies in recovery order so a flushed interrupted
		save can be restored before older copies */
		var candidate_paths =
		[
			server_history_persistence_temp_file,
			server_history_persistence_file,
			server_history_persistence_backup_file
		];

		/* Track whether any candidate exists, distinguishing a first run from existing but
		unreadable saves */
		var found_file = false;

		/* Collect failure details from unusable candidates, beginning with no diagnostic text */
		var failure_detail = "";

		/* Check candidate paths from index zero in priority order, stopping at the first fully
		decoded snapshot */
		for (var candidate_index = 0; candidate_index < array_length(candidate_paths); candidate_index++)
		{
			/* Borrow the current candidate path for reading and diagnostic labels */
			var candidate_path = candidate_paths[candidate_index];

			/* Missing candidates do not count as restore failures, so continue to the next
			recovery source */
			if (!file_exists(candidate_path))
			{
				continue;
			}

			found_file = true;

			/* Read the whole candidate with the character ceiling before attempting JSON
			decode */
			var read_result = server_history_persistence_read_text(candidate_path);

			/* If reading fails, keep its detail and try the next file instead of giving up
			before recovery copies */
			if (!read_result.ok)
			{
				/* Use no separator for the first failure and a comma for later failures so the
				combined candidate detail stays readable */
				failure_detail += (failure_detail == "" ? "" : ", ") + candidate_path + ": " + read_result.reason;
				continue;
			}

			/* Decode and validate the complete readable snapshot before replacing
			authoritative history */
			var decode_result = server_history_persistence_decode(read_result.text);

			/* Rejected JSON or history records add their detail and continue to the next
			recovery source */
			if (!decode_result.ok)
			{
				/* Separate this decode failure from any previous candidate failures without
				adding a leading comma */
				failure_detail += (failure_detail == "" ? "" : ", ") + candidate_path + ": " + decode_result.reason;
				continue;
			}

			server_history = decode_result.history;

			/* Nonempty legacy history without a clean checkpoint marker needs compact
			reconstruction. Empty or already checkpointed history does not queue that work */
			server_history_checkpoint_dirty = array_length(server_history) > 0
				&& !decode_result.checkpointed;
			server_history_checkpoint_requested = server_history_checkpoint_dirty;
			server_history_checkpoint_in_progress = false;
			server_history_checkpoint_retry_at = 0;

			/* Show legacy history queued for checkpoint while that reconstruction is needed.
			Otherwise report a restored checkpoint */
			server_history_checkpoint_status = server_history_checkpoint_dirty
				? "legacy history queued for checkpoint"
				: "restored checkpoint";
			server_history_persistence_loaded_count = array_length(server_history);
			server_history_persistence_saved_count = server_history_persistence_loaded_count;

			/* A recovery copy differs from the primary file, so mark it dirty for promotion by
			the normal save path. A valid primary needs no rewrite */
			server_history_persistence_dirty = candidate_path != server_history_persistence_file;

			/* Recovery starts its dirty timestamp at current_time. Clean primary restoration
			uses zero because no save is pending */
			server_history_persistence_dirty_since = server_history_persistence_dirty ? current_time : 0;

			/* Schedule recovered history after the configured quiet-period delay. Clean
			primary restoration keeps the save deadline unset */
			server_history_persistence_save_at = server_history_persistence_dirty
				? current_time + server_history_persistence_save_delay_ms
				: 0;
			server_history_persistence_retry_at = 0;
			server_history_persistence_status = "restored " + string(server_history_persistence_loaded_count)

				/* Add a recovery-copy suffix only when the chosen candidate was not the
				primary file */
				+ " item(s)" + (candidate_path == server_history_persistence_file ? "" : " from recovery copy");

			/* Inspect restored history indexes from zero so future imported image IDs cannot
			collide with saved image records */
			for (var history_index = 0; history_index < array_length(server_history); history_index++)
			{
				/* Borrow the restored item to check whether it carries an image identifier */
				var restored_item = server_history[history_index];

				/* Only image records advance next_image_import_id beyond their saved ID. Other
				record kinds leave image allocation unchanged */
				if (history_item_is_image(restored_item))
				{
					next_image_import_id = max(next_image_import_id, restored_item.image_id + 1);
				}
			}

			server_rebuild_layer_state_from_history();
			debug_success("Server drawing history " + server_history_persistence_status + ".");
			return server_history_persistence_loaded_count;
		}

		/* When no candidate file existed, treat this as no saved history and return zero.
		Existing but unusable candidates reach the restore-failed path */
		if (!found_file)
		{
			server_history_persistence_status = "no saved history yet";
			debug_log("Server drawing history: no saved history yet.");
			return 0;
		}

		server_history_persistence_status = "restore failed";
		debug_error("Could not restore server drawing history: " + failure_detail);

		/* All existing candidates failed validation or reading, so return minus one rather
		than reporting an empty successful restore */
		return -1;
	}

	/// @description Attempt scheduled saving after the quiet period or maximum dirty age, honoring retry waits
	/// @returns {Bool} Save result, or false while no save attempt is due
	update_server_history_persistence = function()
	{
		/* No dirty history needs a save. A positive retry deadline still in the future also
		defers work, so failed attempts wait before trying again */
		if (!server_history_persistence_dirty
		|| (server_history_persistence_retry_at > 0
			&& current_time < server_history_persistence_retry_at))
		{
			return false;
		}

		/* The quiet-period deadline is reached only when a save was scheduled and current_time
		has passed it */
		var idle_deadline_reached = server_history_persistence_save_at > 0
			&& current_time >= server_history_persistence_save_at;

		/* The maximum dirty-age deadline allows saving despite continuous incoming changes
		that keep extending the quiet period */
		var maximum_deadline_reached = current_time >= server_history_persistence_dirty_since
			+ server_history_persistence_max_delay_ms;

		/* Keep waiting until either the quiet period ends or the maximum dirty age is reached.
		Otherwise force a save attempt through the persistence routine */
		if (!idle_deadline_reached && !maximum_deadline_reached)
		{
			return false;
		}

		return save_server_history_persistence(true);
	}
	#endregion /* Server History Persistence END */

	#region /* Authoritative Layer State and History Checkpoints */
	/// @description Append ordered client history and advance a valid local undo lookup cache
	/// @param {Struct} item Accepted client or server history item
	push_client_history_item = function(item)
	{
		client_history[array_length(client_history)] = item;

		/* The undo lookup can advance cheaply only when it already matches the current history
		revision and local author. A stale cache stays stale so the next lookup rescans */
		if (undo_lookup_revision == client_history_revision && undo_lookup_author == local_undo_author_id)
		{
			/* A newly appended undoable local item becomes the cached last group. Other
			authors and nonundoable records preserve the cached group while its revision
			advances */
			if (history_item_is_undoable_command(item) && command_undo_author_id(item) == local_undo_author_id)
			{
				undo_lookup_id = command_undo_id(item);
			}
			undo_lookup_revision++;
		}
		client_history_revision++;
	}

	/// @description Append an ordinary command through the client history and undo-cache helper
	/// @param {Struct} command Accepted ordinary drawing command
	push_client_history = function(command)
	{
		push_client_history_item(command);
	}

	/// @description Create empty active authoritative metadata for a stable layer ID
	/// @param {Real} layer_id Stable authoritative target ID
	/// @param {String} layer_name Initial display name
	/// @param {String} steward_name Initial stewardship author text. Defaults to ""
	/// @returns {Struct} New state with empty content bounds and contributor list
	server_make_layer_state = function(layer_id, layer_name, steward_name = "")
	{
		/* Normalize the stable authoritative layer ID to a positive whole number before
		constructing its state */
		var clean_id = max(1, floor(real(layer_id)));

		/* Each state stores id/name and steward_name for identity, archived false for an
		active new layer, has_content false before drawing, and revision zero before
		changes. Empty inclusive content bounds start left/top beyond the room and
		right/bottom at minus one. contributors starts empty and receives unique author
		names when content is accepted */
		return
		{
			id: clean_id,
			name: layer_name_clean(layer_name, layer_default_name(clean_id)),
			steward_name: layer_author_name_clean(steward_name),
			archived: false,
			has_content: false,
			content_left: max(1, room_width),
			content_top: max(1, room_height),
			content_right: -1,
			content_bottom: -1,
			contributors: [],
			revision: 0
		};
	}

	/// @description Create authoritative default layer one only when the server stack is empty
	/// @returns {Bool} True after ensuring the stack exists
	server_ensure_default_layer_state = function()
	{
		/* Only an empty authoritative stack needs default layer one. An existing stack remains
		intact and keeps its allocation counter */
		if (array_length(server_layer_states) <= 0)
		{
			server_layer_states = [server_make_layer_state(1, "Paint Layer 1")];
			server_next_layer_id = max(server_next_layer_id, 2);
		}
		return true;
	}

	/// @description Find an authoritative layer-state index by its stable ID
	/// @param {Real} layer_id Stable authoritative target ID
	/// @returns {Real} Zero-based state index, or noone
	server_layer_state_index = function(layer_id)
	{
		/* Search authoritative layer-state indexes from zero until the stable ID matches or
		the entire stack has been checked */
		for (var layer_index = 0; layer_index < array_length(server_layer_states); layer_index++)
		{
			/* Return the index of the matching stable ID so callers can mutate the correct
			state entry */
			if (server_layer_states[layer_index].id == layer_id)
			{
				return layer_index;
			}
		}

		/* No authoritative layer matched, so return noone rather than a valid array index */
		return noone;
	}

	/// @description Count unarchived authoritative layers for shared-layer limits
	/// @returns {Real} Number of active server layers
	server_active_layer_count = function()
	{
		/* Count unarchived authoritative layers, beginning with none found */
		var count = 0;

		/* Inspect each authoritative state from index zero through the stack length */
		for (var layer_index = 0; layer_index < array_length(server_layer_states); layer_index++)
		{
			/* Only an unarchived state contributes to the active-layer limit. Archived states
			remain stored but do not increase the count */
			if (!server_layer_states[layer_index].archived)
			{
				count++;
			}
		}
		return count;
	}

	/// @description Check that a normalized target ID exists, including archived in-flight targets
	/// @param {Real} layer_id Stable authoritative target ID
	/// @returns {Bool} Whether the authoritative layer exists
	server_layer_accepts_content = function(layer_id)
	{
		server_ensure_default_layer_state();

		/* Resolve the normalized stable ID after ensuring a default authoritative stack exists */
		var state_index = server_layer_state_index(max(1, floor(real(layer_id))));

		/* Archived surfaces remain valid targets for packets that were already in
		flight when an archive commit arrived. They stay hidden until restored */
		/* An existing authoritative layer can accept content, including an archived layer
		receiving packets already in flight. Unknown IDs cannot */
		return state_index != noone;
	}

	/// @description Create a separate string array for copied contributor metadata
	/// @param {Any} source Contributor array to copy, with nonarrays producing an empty result
	/// @returns {Array} Converted entries, or an empty array for invalid input
	server_copy_string_array = function(source)
	{
		/* Build a separate array of contributor strings, initially empty so invalid source
		input has an empty result */
		var result = [];

		/* A nonarray source has no contributor entries to copy, so return the empty result */
		if (!is_array(source))
		{
			return result;
		}

		/* Copy every source entry from zero, converting it to text so the new array does not
		share the source array itself */
		for (var source_index = 0; source_index < array_length(source); source_index++)
		{
			result[source_index] = string(source[source_index]);
		}
		return result;
	}

	/// @description Add a cleaned nonblank contributor name only once without distinguishing case
	/// @param {Struct} layer_state Authoritative metadata with identity, content bounds, and contributor fields
	/// @param {Any} raw_name Proposed contributor name before cleanup
	/// @returns {Bool} Whether a new name was appended
	server_layer_state_add_contributor = function(layer_state, raw_name)
	{
		/* Normalize the proposed contributor name using the layer attribution format */
		var clean_name = layer_author_name_clean(raw_name);

		/* A missing state or blank cleaned author cannot add meaningful attribution, so leave
		the contributors unchanged */
		if (!is_struct(layer_state) || clean_name == "")
		{
			return false;
		}

		/* Search contributor entries from zero for the same name without distinguishing
		capitalization */
		for (var contributor_index = 0; contributor_index < array_length(layer_state.contributors); contributor_index++)
		{
			/* An existing case-insensitive name needs no duplicate contributor entry, so
			return false before appending it */
			if (string_lower(layer_state.contributors[contributor_index]) == string_lower(clean_name))
			{
				return false;
			}
		}
		layer_state.contributors[array_length(layer_state.contributors)] = clean_name;
		return true;
	}

	/// @description Apply stack operations or expand authoritative content bounds and attribution
	/// @param {Struct} item Accepted client or server history item
	/// @returns {Bool} Whether the layer operation or drawable target was processed
	server_apply_history_item_to_layer_state = function(item)
	{
		server_ensure_default_layer_state();

		/* Layer operations change stack membership or archive state. Drawable items instead
		extend content metadata below */
		if (history_item_is_layer(item))
		{
			/* Locate the operation's target stable ID in the authoritative stack before
			selecting its action */
			var state_index = server_layer_state_index(item.layer_id);

			/* Dispatch the accepted layer operation while retaining stable IDs across add,
			duplicate, delete, move, archive, and restore actions */
			switch (item.op)
			{
				/* Add operations insert a newly authored layer at the requested clamped stack
				position */
				case DRAW_LAYER_ADD:
				{
					/* Only a previously unknown ID creates an added state. A repeated add does
					not duplicate the existing layer */
					if (state_index == noone)
					{
						/* Create an empty active state whose steward is the layer operation's
						author */
						var add_state = server_make_layer_state(item.layer_id, item.name, command_author_name(item));
						array_insert(server_layer_states, clamp(item.index, 0, array_length(server_layer_states)), add_state);
					}
					break;
				}

				/* Duplicate operations create a separate target state and copy available
				source content metadata */
				case DRAW_LAYER_DUPLICATE:
				{
					/* An already present target ID must not be inserted twice. Only an absent
					target enters duplication */
					if (state_index == noone)
					{
						/* Create the duplicate target with its new ID/name and the duplicating
						author's stewardship */
						var duplicate_state = server_make_layer_state(item.layer_id, item.name, command_author_name(item));

						/* Resolve the source's stable ID before copying its content bounds and
						contributors */
						var source_index = server_layer_state_index(item.source_layer_id);

						/* An existing source supplies bounds, content presence, revision, and
						a copied contributor array. Missing sources leave the new state
						empty */
						if (source_index != noone)
						{
							/* Borrow the source state as the metadata donor without changing
							it */
							var source_state = server_layer_states[source_index];
							duplicate_state.has_content = source_state.has_content;
							duplicate_state.content_left = source_state.content_left;
							duplicate_state.content_top = source_state.content_top;
							duplicate_state.content_right = source_state.content_right;
							duplicate_state.content_bottom = source_state.content_bottom;
							duplicate_state.contributors = server_copy_string_array(source_state.contributors);
							duplicate_state.revision = source_state.revision;
						}
						array_insert(server_layer_states, clamp(item.index, 0, array_length(server_layer_states)), duplicate_state);
					}
					break;
				}

				/* Delete operations remove a known state only while at least one other stored
				layer remains */
				case DRAW_LAYER_DELETE:
				{
					/* A known target and more than one stored state allow deletion. Unknown
					targets or the final stored layer remain unchanged */
					if (state_index != noone && array_length(server_layer_states) > 1)
					{
						array_delete(server_layer_states, state_index, 1);
					}
					break;
				}

				/* Move operations remove and reinsert the same state so its identity and
				content survive a stack reorder */
				case DRAW_LAYER_MOVE:
				{
					/* Only an existing target can move. An unknown layer leaves the stack
					unchanged */
					if (state_index != noone)
					{
						/* Retain the moved state while removing its old index so reinsertion
						keeps its fields and contributors */
						var move_state = server_layer_states[state_index];
						array_delete(server_layer_states, state_index, 1);
						array_insert(server_layer_states, clamp(item.index, 0, array_length(server_layer_states)), move_state);
					}
					break;
				}

				/* Archive operations retain the layer state and mark it hidden from the active
				stack */
				case DRAW_LAYER_ARCHIVE:
				{
					/* An existing target can be archived and its revision advanced. Missing
					layers have no archive state to change */
					if (state_index != noone)
					{
						server_layer_states[state_index].archived = true;
						server_layer_states[state_index].revision++;
					}
					break;
				}

				/* Restore operations make retained archived state active again without
				recreating its pixels */
				case DRAW_LAYER_RESTORE:
				{
					/* An existing target can be restored and its revision advanced. A missing
					target remains absent */
					if (state_index != noone)
					{
						server_layer_states[state_index].archived = false;
						server_layer_states[state_index].revision++;
					}
					break;
				}
			}
			server_next_layer_id = max(server_next_layer_id, item.layer_id + 1);
			server_layer_stack_revision++;
			return true;
		}

		/* Resolve the drawable item's target stable layer ID using its history format */
		var target_layer_id = history_item_layer_id(item);

		/* An item without a target layer cannot contribute content metadata, so return false */
		if (target_layer_id == noone)
		{
			return false;
		}

		/* Locate this target in the authoritative stack before recording its content */
		var target_index = server_layer_state_index(target_layer_id);

		/* Legacy drawing may reference a layer without a preceding add record. Create an empty
		matching state so its content is retained during reconstruction */
		if (target_index == noone)
		{
			/* Create that legacy target with a default label and no stewardship author */
			var legacy_state = server_make_layer_state(target_layer_id, layer_default_name(target_layer_id));
			server_layer_states[array_length(server_layer_states)] = legacy_state;
			target_index = array_length(server_layer_states) - 1;
			server_next_layer_id = max(server_next_layer_id, target_layer_id + 1);
			server_layer_stack_revision++;
		}

		/* Borrow the authoritative target state so accepted content updates the shared
		metadata */
		var target_state = server_layer_states[target_index];
		target_state.has_content = true;

		/* Calculate the item's conservative inclusive world-pixel bounds for later checkpoint
		cropping */
		var affected_rect = history_item_affected_rect(item);

		/* Known bounds expand the accumulated content rectangle. Unavailable bounds use the
		full-room fallback below so compaction cannot crop unknown drawing */
		if (is_struct(affected_rect))
		{
			target_state.content_left = min(target_state.content_left, affected_rect.left);
			target_state.content_top = min(target_state.content_top, affected_rect.top);
			target_state.content_right = max(target_state.content_right, affected_rect.right);
			target_state.content_bottom = max(target_state.content_bottom, affected_rect.bottom);
		}

		/* Unknown drawing kinds must never be cropped away during destructive
		compaction. Fall back to the complete layer surface */
		else
		{
			target_state.content_left = 0;
			target_state.content_top = 0;
			target_state.content_right = max(0, room_width - 1);
			target_state.content_bottom = max(0, room_height - 1);
		}
		target_state.revision++;
		server_layer_state_add_contributor(target_state, command_author_name(item));
		return true;
	}

	/// @description Reset and replay authoritative stack metadata, retaining at least one active layer
	/// @returns {Real} Number of resulting stored server layers
	server_rebuild_layer_state_from_history = function()
	{
		server_layer_states = [];
		server_next_layer_id = 2;
		server_layer_stack_revision = 0;
		server_ensure_default_layer_state();

		/* Reapply authoritative history from index zero in replay order after resetting stack
		state and counters */
		for (var history_index = 0; history_index < array_length(server_history); history_index++)
		{
			server_apply_history_item_to_layer_state(server_history[history_index]);
		}

		/* If replay leaves stored layers but none active, reopen the first layer so the host
		retains an active drawing target */
		if (server_active_layer_count() <= 0 && array_length(server_layer_states) > 0)
		{
			server_layer_states[0].archived = false;
		}
		return array_length(server_layer_states);
	}

	/// @description Append accepted server history, update layer metadata, and schedule saving and empty-host compaction
	/// @param {Struct} item Accepted client or server history item
	push_server_history = function(item)
	{
		server_apply_history_item_to_layer_state(item);
		server_history[array_length(server_history)] = item;
		server_history_checkpoint_dirty = true;
		mark_server_history_persistence_dirty();

		/* Inspect the shared host's current connected-player count after adding accepted
		history */
		var server = scr_get_server();

		/* A host with an available nonpositive player count can queue compaction immediately.
		Active players or unavailable count state leave that request to later maintenance */
		if (is_struct(server)
		&& variable_struct_exists(server, "connected_players")
		&& server.connected_players <= 0)
		{
			server_request_history_checkpoint("server-side drawing changed while empty");
		}
	}

	/// @description Treat a missing host/count or nonpositive connection count as an empty checkpoint window
	/// @returns {Bool} Whether this helper considers the server empty
	server_history_checkpoint_server_is_empty = function()
	{
		/* Read the shared host state used to decide whether compaction can run without
		connected clients */
		var server = scr_get_server();

		/* A missing host/count or a nonpositive count is treated as empty by this helper. A
		positive connected-player count prevents checkpoint reconstruction */
		return !is_struct(server)
			|| !variable_struct_exists(server, "connected_players")
			|| server.connected_players <= 0;
	}

	/// @description Keep clients from joining while a checkpoint is queued or running
	/// @returns {Bool} Whether joining must wait
	server_history_checkpoint_blocks_join = function()
	{
		/* Either a queued or running checkpoint blocks joining so a new client does not
		synchronize while authoritative history is being replaced */
		return server_history_checkpoint_requested
			|| server_history_checkpoint_in_progress;
	}

	/// @description Queue dirty nonempty history for compaction when none is already running
	/// @param {String} reason Reason shown when compaction is queued. Defaults to "server empty"
	/// @returns {Bool} Whether a checkpoint request was queued
	server_request_history_checkpoint = function(reason = "server empty")
	{
		/* Clean history, empty history, and an already running checkpoint need no additional
		request. Other dirty history is queued with the caller's reason */
		if (!server_history_checkpoint_dirty
		|| array_length(server_history) <= 0
		|| server_history_checkpoint_in_progress)
		{
			return false;
		}

		server_history_checkpoint_requested = true;
		server_history_checkpoint_status = "queued: " + string(reason);
		debug_note("server history checkpoint queued", string(array_length(server_history)) + " item(s)");
		return true;
	}

	/// @description Capture independent layer and contributor metadata for reconstruction
	/// @returns {Array} Ordered snapshots of authoritative layer states
	server_checkpoint_copy_layer_states = function()
	{
		/* Capture authoritative metadata in a new array so checkpoint reconstruction can
		compare against a stable layer snapshot */
		var snapshot = [];

		/* Copy every authoritative state from index zero in its current stack order */
		for (var state_index = 0; state_index < array_length(server_layer_states); state_index++)
		{
			/* Borrow this authoritative layer only while copying its identity, archive/content
			metadata, contributors, and revision */
			var state = server_layer_states[state_index];

			/* The snapshot preserves id/name/steward_name, archived and has_content flags,
			inclusive content bounds, a separately copied contributors array, and revision.
			These records describe the source layers while temporary client surfaces render
			the checkpoint */
			snapshot[state_index] =
			{
				id: state.id,
				name: state.name,
				steward_name: state.steward_name,
				archived: state.archived,
				has_content: state.has_content,
				content_left: state.content_left,
				content_top: state.content_top,
				content_right: state.content_right,
				content_bottom: state.content_bottom,
				contributors: server_copy_string_array(state.contributors),
				revision: state.revision
			};
		}
		return snapshot;
	}

	/// @description Cancel checkpoint state, restore its image allocator, clear temporary drawing, and schedule retry
	/// @param {Any} message Failure reason to report during checkpoint cleanup
	/// @param {Real} retry_delay Retry wait in current_time milliseconds, defaulting to the checkpoint retry setting
	/// @returns {Bool} False after failure cleanup
	server_checkpoint_fail = function(message, retry_delay = server_history_checkpoint_retry_delay_ms)
	{
		/* Convert the failure reason to display text before clearing the reconstruction and
		scheduling its retry */
		var failure_message = string(message);
		server_history_checkpoint_in_progress = false;
		server_history_checkpoint_requested = false;
		server_history_checkpoint_retry_at = current_time + max(0, floor(real(retry_delay)));
		server_history_checkpoint_source_count = 0;
		server_history_checkpoint_layer_states = [];
		next_image_import_id = server_history_checkpoint_next_image_id;
		server_history_checkpoint_status = "failed: " + failure_message;
		clear_client_drawing_state();
		debug_error("Server drawing checkpoint failed: " + failure_message);
		return false;
	}

	/// @description Encode an owned temporary PNG for a borrowed surface region and clean up all temporary resources
	/// @param {Real} source_surface Borrowed source surface, retained by its caller
	/// @param {Real} source_x Region left offset in surface pixels
	/// @param {Real} source_y Region top offset in surface pixels
	/// @param {Real} region_w Requested source-region width in pixels
	/// @param {Real} region_h Requested source-region height in pixels
	/// @returns {Struct} Result with ok, too_large, base64, byte_size, and message
	server_checkpoint_encode_surface_region = function(source_surface, source_x, source_y, region_w, region_h)
	{
		/* The result begins failed with no PNG bytes or size. ok marks successful encoding,
		too_large distinguishes a tiling request, base64 carries accepted PNG data,
		byte_size reports encoded file bytes, and message explains a rejection */
		var result =
		{
			ok: false,
			too_large: false,
			base64: "",
			byte_size: 0,
			message: "Could not encode checkpoint PNG."
		};

		/* safe_x and safe_y are nonnegative whole-pixel source offsets */
		var safe_x = max(0, floor(real(source_x)));
		var safe_y = max(0, floor(real(source_y)));

		/* safe_w and safe_h are positive whole-pixel region dimensions, ensuring at least one
		pixel per axis */
		var safe_w = max(1, floor(real(region_w)));
		var safe_h = max(1, floor(real(region_h)));

		/* The source surface must exist and contain the full requested region. Reject missing
		or out-of-bounds source data before reading dimensions or allocating a tile */
		if (!surface_exists(source_surface)
		|| safe_x + safe_w > surface_get_width(source_surface)
		|| safe_y + safe_h > surface_get_height(source_surface))
		{
			result.message = "Checkpoint layer surface is unavailable.";
			return result;
		}

		/* Use the borrowed source directly for a whole-surface export, replacing this
		reference only when a cropped temporary tile is needed */
		var export_surface = source_surface;

		/* Own a temporary tile surface only for cropped exports. noone marks no allocation and
		cleanup frees any tile */
		var temporary_surface = noone;

		/* Track whether an export target is currently active so exceptions can restore the
		render target */
		var target_active = false;

		/* Capture the caller's texture filtering setting for restoration after tile copying */
		var restore_filter = gpu_get_texfilter();

		/* Own the file-loaded PNG byte buffer during encoding, with noone before loading and
		cleanup deleting it */
		var png_buffer = noone;

		/* Choose a temporary PNG path using the runtime temp directory, current_time, and a
		random suffix to reduce name collisions */
		var temp_path = screenshot_path_join(temp_directory,
			"JonnilOnline_Checkpoint_" + string(current_time) + "_" + string(irandom(999999999)) + ".png");
		try
		{
			/* Export a cropped tile only when origin or dimensions differ from the whole
			surface. Exact whole-surface exports avoid allocating an extra surface */
			if (safe_x != 0
			|| safe_y != 0
			|| safe_w != surface_get_width(source_surface)
			|| safe_h != surface_get_height(source_surface))
			{
				temporary_surface = surface_create(safe_w, safe_h);

				/* A failed tile allocation cannot become a render target, so enter cleanup
				with a specific failure */
				if (!surface_exists(temporary_surface))
				{
					throw "Could not create checkpoint tile surface.";
				}

				export_surface = temporary_surface;
				gpu_set_texfilter(false);
				surface_set_target(export_surface);
				target_active = true;

				/* Preserve the source RGBA bytes exactly. Normal alpha blending onto a
				transparent tile would multiply semi-transparent alpha a second time */
				gpu_set_blendmode_ext(bm_one, bm_zero);
				draw_set_alpha(1);
				draw_clear_alpha(c_black, 0);
				draw_surface_part(source_surface, safe_x, safe_y, safe_w, safe_h, 0, 0);
				surface_reset_target();
				target_active = false;
				gpu_set_texfilter(restore_filter);
			}

			surface_save(export_surface, temp_path);
			png_buffer = buffer_load(temp_path);

			/* The saved PNG must load into a live byte buffer before its header can be
			inspected */
			if (!buffer_exists(png_buffer))
			{
				throw "Could not read checkpoint PNG.";
			}

			/* Read the saved PNG header to verify its dimensions against the requested region */
			var png_info = png_dimensions_from_buffer(png_buffer);

			/* Reject invalid PNG headers or dimensions different from the requested tile so
			history cannot place mismatched encoded pixels */
			if (!png_info.ok || png_info.w != safe_w || png_info.h != safe_h)
			{
				throw "Checkpoint PNG dimensions did not match its layer region.";
			}

			/* Measure the encoded PNG file size in bytes before deciding whether it fits one
			transferable image */
			var png_size = buffer_get_size(png_buffer);

			/* Derive the byte ceiling from the maximum base64 chunk capacity used by image
			replication */
			var maximum_bytes = (image_chunk_size * image_import_max_chunks * 3) div 4;

			/* An empty PNG file has no replayable pixels, so fail instead of returning encoded
			data */
			if (png_size <= 0)
			{
				throw "Checkpoint PNG was empty.";
			}

			/* A nonempty PNG beyond the transfer ceiling requests tiling and records its byte
			size. It does not provide accepted base64 data */
			if (png_size > maximum_bytes)
			{
				result.too_large = true;
				result.byte_size = png_size;
				result.message = "Checkpoint PNG needs tiling.";
			}

			/* A PNG within the ceiling becomes a successful base64 result with its exact byte
			size and no failure message */
			else
			{
				result.ok = true;
				result.base64 = buffer_base64_encode(png_buffer, 0, png_size);
				result.byte_size = png_size;
				result.message = "";
			}
		}
		catch(e)
		{
			/* Prefer the encoding exception's structured message when available, otherwise
			stringify it into the failed result */
			result.message = is_struct(e) && variable_struct_exists(e, "message")
				? string(e.message)
				: string(e);
		}

		/* If an exception left the tile as the active target, attempt to reset it before
		releasing owned resources */
		if (target_active)
		{
			try { surface_reset_target(); } catch(target_error) { }
		}
		gpu_set_texfilter(restore_filter);
		gpu_set_blendmode(bm_normal);
		draw_set_alpha(1);

		/* Delete the loaded PNG byte buffer only if it still exists */
		if (buffer_exists(png_buffer))
		{
			buffer_delete(png_buffer);
		}

		/* Remove the temporary PNG file if created, using best-effort deletion even after an
		encoding failure */
		if (file_exists(temp_path))
		{
			try { file_delete(temp_path); } catch(delete_error) { }
		}

		/* Free a temporary cropped surface only when allocated. The borrowed original source
		is never released here */
		if (surface_exists(temporary_surface))
		{
			surface_free(temporary_surface);
		}
		return result;
	}

	/// @description Append one unattributed ungrouped checkpoint PNG record and advance the image allocator
	/// @param {Array} history_items Mutable candidate history receiving generated images
	/// @param {Struct} layer_state Authoritative metadata with identity, content bounds, and contributor fields
	/// @param {Real} image_x World-pixel checkpoint image left edge
	/// @param {Real} image_y World-pixel checkpoint image top edge
	/// @param {Real} image_w Checkpoint image width in world pixels
	/// @param {Real} image_h Checkpoint image height in world pixels
	/// @param {Struct} encoded_png Successful PNG encoding result containing base64 data
	/// @param {String} suffix Optional filename label, empty for a whole-region image. Defaults to ""
	/// @returns {Bool} True after appending the image
	server_checkpoint_append_image = function(history_items, layer_state, image_x, image_y, image_w, image_h, encoded_png, suffix = "")
	{
		/* Build a descriptive checkpoint image label from its layer name before limiting the
		saved name length */
		var image_name = "Canvas checkpoint - " + layer_state.name;

		/* A nonempty suffix distinguishes tiles of the same layer. Whole-region images keep
		the unsuffixed label */
		if (suffix != "")
		{
			image_name += " " + string(suffix);
		}

		/* Create a checkpoint image record with fresh image ID, encoded PNG, layer/world
		geometry, no player attribution or undo group, and nearest-neighbour replay */
		var image_item = make_image_history_item(
			next_image_import_id,
			string_copy(image_name, 1, 128),
			image_x,
			image_y,
			image_w,
			image_h,
			encoded_png.base64,
			layer_state.id,
			0,
			0,
			noone,
			"",
			false
		);
		next_image_import_id++;
		history_items[array_length(history_items)] = image_item;
		return true;
	}

	/// @description Append bounded layer PNGs, splitting oversized full-region encodings into tiles
	/// @param {Array} history_items Mutable candidate history receiving generated images
	/// @param {Struct} layer_state Authoritative metadata with identity, content bounds, and contributor fields
	/// @param {Real} layer_surface Borrowed live room-sized layer surface
	/// @returns {Struct} Result with ok and message, with candidate additions accepted only on complete checkpoint success
	server_checkpoint_append_layer_pixels = function(history_items, layer_state, layer_surface)
	{
		/* Read the source surface's full width and height in world pixels for clamping
		accumulated content bounds */
		var full_w = surface_get_width(layer_surface);
		var full_h = surface_get_height(layer_surface);

		/* region_left and region_top are whole-pixel minimum bounds clamped inside the surface */
		var region_left = clamp(floor(real(layer_state.content_left)), 0, full_w - 1);
		var region_top = clamp(floor(real(layer_state.content_top)), 0, full_h - 1);

		/* region_right and region_bottom are rounded-out inclusive maximum bounds, also
		clamped to the surface */
		var region_right = clamp(ceil(real(layer_state.content_right)), 0, full_w - 1);
		var region_bottom = clamp(ceil(real(layer_state.content_bottom)), 0, full_h - 1);

		/* has_content can remain true after an eraser removes every visible pixel.
		An empty bound is therefore a valid transparent layer, not an error */
		if (region_right < region_left || region_bottom < region_top)
		{
			/* An empty valid layer succeeds without appending a PNG, using ok true and no
			message */
			return { ok: true, message: "" };
		}

		/* region_w and region_h include both content-bound edges so the cropped PNG retains
		every covered pixel */
		var region_w = region_right - region_left + 1;
		var region_h = region_bottom - region_top + 1;

		/* Try encoding the entire bounded content region before allocating separate tile
		records */
		var full_png = server_checkpoint_encode_surface_region(layer_surface, region_left, region_top, region_w, region_h);

		/* A full-region PNG within the transfer ceiling needs only one image-history item, so
		append it and finish successfully */
		if (full_png.ok)
		{
			server_checkpoint_append_image(history_items, layer_state, region_left, region_top, region_w, region_h, full_png);
			return { ok: true, message: "" };
		}

		/* Failures other than excessive encoded size cannot be repaired by tiling, so return
		the original failed message */
		if (!full_png.too_large)
		{
			return { ok: false, message: full_png.message };
		}

		/* Number appended tiles from one, with zero before any tile so the first completed
		tile increments it */
		var tile_number = 0;

		/* Start at the content's top edge and advance one configured tile height while any
		inclusive rows remain */
		for (var tile_y = region_top; tile_y <= region_bottom; tile_y += server_history_checkpoint_tile_size)
		{
			/* For each tile row, start at the left edge and advance one tile width while any
			inclusive columns remain */
			for (var tile_x = region_left; tile_x <= region_right; tile_x += server_history_checkpoint_tile_size)
			{
				/* tile_w and tile_h trim the final column and row to the remaining content
				pixels rather than extending outside the cropped bounds */
				var tile_w = min(server_history_checkpoint_tile_size, region_right - tile_x + 1);
				var tile_h = min(server_history_checkpoint_tile_size, region_bottom - tile_y + 1);

				/* Encode the current tile's source rectangle into a separate transferable PNG */
				var tile_png = server_checkpoint_encode_surface_region(layer_surface, tile_x, tile_y, tile_w, tile_h);

				/* A failed tile aborts this candidate checkpoint. The caller does not accept a
				partially encoded layer */
				if (!tile_png.ok)
				{
					return { ok: false, message: tile_png.message };
				}

				tile_number++;
				server_checkpoint_append_image(history_items, layer_state, tile_x, tile_y, tile_w, tile_h, tile_png, "tile " + string(tile_number));
			}
		}

		/* Every needed tile was appended, so report ok true with no failure detail */
		return { ok: true, message: "" };
	}

	/// @description Build independent compact layer, image, and archive replay records from captured metadata
	/// @returns {Struct} Result with ok, candidate history, and message
	server_checkpoint_build_history = function()
	{
		/* Start with a rejected result carrying no history and a build message. Acceptance
		later replaces it with the completed candidate */
		var result = { ok: false, history: [], message: "Could not build checkpoint history." };

		/* Build compact history independently so a failed reconstruction cannot replace
		authoritative server_history */
		var candidate = [];

		/* Count the captured authoritative layer states for the ordered reconstruction passes */
		var state_count = array_length(server_history_checkpoint_layer_states);

		/* Assume the original default layer is absent until a captured state proves it still
		belongs in the stack */
		var includes_default_layer = false;

		/* Visit captured states from zero to create nondefault layers in their stored order */
		for (var state_index = 0; state_index < state_count; state_index++)
		{
			/* Borrow this captured layer's identity and stewardship for its compact add record */
			var layer_state = server_history_checkpoint_layer_states[state_index];

			/* Layer one already exists when replay starts, so retain its presence flag and
			skip an unnecessary add operation */
			if (layer_state.id == 1)
			{
				includes_default_layer = true;
				continue;
			}

			candidate[array_length(candidate)] = make_layer_history_item(
				DRAW_LAYER_ADD,
				layer_state.id,
				state_index,
				layer_state.name,
				0,
				true,
				noone,
				layer_state.steward_name
			);
		}

		/* If the captured nonempty stack lacks layer one, delete the replay-created default
		after adding the retained layers. Otherwise keep the default */
		if (!includes_default_layer && state_count > 0)
		{
			candidate[array_length(candidate)] = make_layer_history_item(
				DRAW_LAYER_DELETE,
				1,
				0,
				"Paint Layer 1",
				0,
				true,
				noone,
				""
			);
		}

		/* Revisit captured states from zero to append their rendered pixel images after layer
		creation */
		for (var state_index = 0; state_index < state_count; state_index++)
		{
			/* Borrow this captured state to decide whether it needs encoded pixels */
			var layer_state = server_history_checkpoint_layer_states[state_index];

			/* Layers with no recorded content need only their structural records, so skip PNG
			encoding for them */
			if (!layer_state.has_content)
			{
				continue;
			}

			/* Resolve the captured stable ID in the temporary rendered client stack */
			var rendered_index = layer_index_from_id(layer_state.id);

			/* A missing or incorrectly sized rendered surface cannot faithfully represent this
			source layer, so reject the candidate */
			if (rendered_index == noone
			|| !layer_surface_matches_room(layers[rendered_index].surface))
			{
				result.message = "Rendered layer " + string(layer_state.id) + " is unavailable.";
				return result;
			}

			/* Append that layer's bounded PNG or tiles into the candidate and retain its
			success/message result */
			var append_result = server_checkpoint_append_layer_pixels(candidate, layer_state, layers[rendered_index].surface);

			/* A layer encoding failure rejects the whole compact history instead of discarding
			part of the drawing */
			if (!append_result.ok)
			{
				result.message = append_result.message;
				return result;
			}
		}

		/* Collect archived layers separately so compact archive operations can retain their
		relative archive chronology */
		var archived_states = [];

		/* Inspect captured states from zero to collect only layers whose final state is
		archived */
		for (var state_index = 0; state_index < state_count; state_index++)
		{
			/* Borrow the captured layer to preserve its original state and stack position in
			the archive work list */
			var layer_state = server_history_checkpoint_layer_states[state_index];

			/* An active layer needs no archive operation, so skip it in this pass */
			if (!layer_state.archived)
			{
				continue;
			}

			/* Resolve the rendered layer to recover its archive sequence when available */
			var rendered_index = layer_index_from_id(layer_state.id);

			/* Use original stack position plus one as a fallback positive archive order */
			var archive_sequence = state_index + 1;

			/* A rendered matching layer supplies its actual archive sequence. Missing rendered
			state retains the positional fallback */
			if (rendered_index != noone)
			{
				archive_sequence = layers[rendered_index].archive_sequence;
			}

			/* Each archive work entry pairs the captured state with its original index and
			archive sequence so it can be sorted before replay records are written */
			archived_states[array_length(archived_states)] =
			{
				state: layer_state,
				index: state_index,
				sequence: archive_sequence
			};
		}

		/* While archived entries remain, remove and emit the earliest sequence. Deleting one
		per iteration eventually empties the work list */
		while (array_length(archived_states) > 0)
		{
			/* Begin each selection scan with the first remaining archived entry as the
			earliest candidate */
			var earliest_index = 0;

			/* Compare the remaining archive entries from index one because index zero already
			supplied the initial candidate */
			for (var archive_index = 1; archive_index < array_length(archived_states); archive_index++)
			{
				/* A strictly earlier sequence replaces the candidate. Equal or later sequences
				keep the first encountered entry */
				if (archived_states[archive_index].sequence < archived_states[earliest_index].sequence)
				{
					earliest_index = archive_index;
				}
			}

			/* Retain the selected archive entry before removing it from the work list and
			writing its archive operation */
			var archived = archived_states[earliest_index];
			array_delete(archived_states, earliest_index, 1);
			candidate[array_length(candidate)] = make_layer_history_item(
				DRAW_LAYER_ARCHIVE,
				archived.state.id,
				archived.index,
				archived.state.name,
				0,
				true,
				noone,
				""
			);
		}

		result.ok = true;
		result.history = candidate;
		result.message = "";
		return result;
	}

	/// @description Validate completed empty-host reconstruction, save compact history, and roll back on save failure
	/// @returns {Bool} Whether finalization succeeded, false while waiting or after failure
	server_finish_history_checkpoint = function()
	{
		/* Only a running checkpoint with no unfinished history/image/fill replay can be
		finalized. Other states keep waiting or report no work */
		if (!server_history_checkpoint_in_progress
		|| !client_history_sync_runtime_idle())
		{
			return false;
		}

		/* A connected player invalidates the empty-server reconstruction window, so abort and
		schedule a short retry instead of replacing history */
		if (!server_history_checkpoint_server_is_empty())
		{
			return server_checkpoint_fail("a player joined before the checkpoint finished", 1000);
		}

		/* A changed authoritative history length invalidates the captured source, so abort
		rather than committing stale pixels */
		if (array_length(server_history) != server_history_checkpoint_source_count)
		{
			return server_checkpoint_fail("drawing history changed while the checkpoint was rendering", 1000);
		}

		/* Any newly recorded application failure means some source drawing was not rendered,
		so reject the checkpoint */
		if (debug_apply_failures > server_history_checkpoint_apply_failures)
		{
			return server_checkpoint_fail("one or more drawing items could not be rendered");
		}

		/* Build the compact layer/image/archive candidate only after reconstruction has
		completed without those invalidations */
		var build_result = server_checkpoint_build_history();

		/* A failed candidate build keeps the original history and goes through checkpoint
		cleanup and retry scheduling */
		if (!build_result.ok)
		{
			return server_checkpoint_fail(build_result.message);
		}

		/* Retain the previous authoritative array until the compact candidate has been
		successfully saved, allowing rollback on persistence failure */
		var previous_history = server_history;
		server_history = build_result.history;
		server_history_checkpoint_dirty = false;
		server_rebuild_layer_state_from_history();
		mark_server_history_persistence_dirty();

		/* If forced saving fails, restore the previous authoritative history and rebuild its
		metadata before checkpoint failure cleanup. Successful saving allows completion
		below */
		if (!save_server_history_persistence(true))
		{
			server_history = previous_history;
			server_history_checkpoint_dirty = true;
			server_rebuild_layer_state_from_history();
			mark_server_history_persistence_dirty();
			return server_checkpoint_fail("the compact history could not be persisted");
		}

		/* old_count records the original command count for the completion message */
		var old_count = server_history_checkpoint_source_count;

		/* new_count records the accepted compact history length for comparison */
		var new_count = array_length(server_history);
		server_history_checkpoint_requested = false;
		server_history_checkpoint_in_progress = false;
		server_history_checkpoint_retry_at = 0;
		server_history_checkpoint_source_count = 0;
		server_history_checkpoint_layer_states = [];
		server_history_checkpoint_status = "saved " + string(new_count) + " item(s) from " + string(old_count);
		clear_client_drawing_state();
		debug_success("Server drawing checkpoint " + server_history_checkpoint_status + ".");
		return true;
	}

	/// @description Capture dirty empty-host history and render it into temporary client surfaces
	/// @returns {Bool} Whether reconstruction started or finalized, false when deferred or rejected
	server_begin_history_checkpoint = function()
	{
		/* Start only a queued dirty nonempty checkpoint that is not already running. Missing
		any prerequisite leaves reconstruction unchanged */
		if (!server_history_checkpoint_requested
		|| server_history_checkpoint_in_progress
		|| !server_history_checkpoint_dirty
		|| array_length(server_history) <= 0)
		{
			return false;
		}

		/* Connected players or existing history-transfer jobs prevent starting because their
		live state depends on the current authoritative history order */
		if (!server_history_checkpoint_server_is_empty()
		|| array_length(server_history_sync_jobs) > 0)
		{
			return false;
		}

		server_history_checkpoint_requested = false;
		server_history_checkpoint_in_progress = true;
		server_history_checkpoint_source_count = array_length(server_history);
		server_history_checkpoint_layer_states = server_checkpoint_copy_layer_states();
		server_history_checkpoint_apply_failures = debug_apply_failures;
		server_history_checkpoint_next_image_id = next_image_import_id;
		server_history_checkpoint_status = "rendering " + string(server_history_checkpoint_source_count) + " item(s)";

		/* Copy the authoritative replay source before loading it into temporary client drawing
		state for rendering */
		var source_history = copy_server_history_snapshot();

		/* If temporary drawing replacement cannot prepare its surfaces, reject the checkpoint
		instead of continuing with incomplete pixels */
		if (!replace_client_drawing_history(source_history))
		{
			return server_checkpoint_fail("the server could not create its checkpoint surfaces");
		}

		/* If reconstruction is already idle, finalize immediately. Otherwise preserve running
		state while asynchronous images or progressive fills complete */
		if (client_history_sync_runtime_idle())
		{
			return server_finish_history_checkpoint();
		}

		server_history_checkpoint_status = "waiting for checkpoint images";
		return true;
	}

	/// @description Advance running reconstruction or start eligible dirty empty-host compaction
	/// @returns {Bool} Whether checkpoint work ran successfully, false when deferred or rejected
	update_server_history_checkpoint = function()
	{
		/* Advance a running checkpoint before considering a new request so only one
		reconstruction owns temporary drawing state */
		if (server_history_checkpoint_in_progress)
		{
			/* A player joining during reconstruction aborts the checkpoint and schedules a
			short retry, preserving authoritative history */
			if (!server_history_checkpoint_server_is_empty())
			{
				return server_checkpoint_fail("a player joined before the checkpoint finished", 1000);
			}

			update_pending_image_draws();

			/* Finish replay fill work only when an active fill job is blocking reconstruction.
			Without one, proceed directly to the idle check */
			if (fill_job_active())
			{
				finish_replay_fill_if_needed();
			}

			/* When image and fill replay are idle, attempt finalization. While work remains,
			retain the running checkpoint for another update */
			if (client_history_sync_runtime_idle())
			{
				return server_finish_history_checkpoint();
			}
			return true;
		}

		/* Clean history, a nonempty host, or an unexpired current_time retry deadline defers
		new checkpoint work */
		if (!server_history_checkpoint_dirty
		|| !server_history_checkpoint_server_is_empty()
		|| current_time < server_history_checkpoint_retry_at)
		{
			return false;
		}

		/* Queue dirty empty-host history if no request exists yet, otherwise retain the
		existing request before trying to begin it */
		if (!server_history_checkpoint_requested)
		{
			server_request_history_checkpoint("server empty");
		}
		return server_begin_history_checkpoint();
	}
	#endregion /* Authoritative Layer State and History Checkpoints END */

	#region /* Server Layer Voting */
	/// @description Capture ready connected voters, excluding AFK nonrequesters and joining clients
	/// @param {Real} requester_slot Zero-based requester slot retained even when its AFK flag is set. Defaults to noone
	/// @returns {Array} Eligible zero-based player slots
	server_layer_eligible_slots = function(requester_slot = noone)
	{
		/* Collect eligible zero-based player slots, starting with no participants */
		var eligible = [];

		/* Read authoritative sockets and AFK flags to capture who can vote on the current
		shared canvas */
		var server = scr_get_server();

		/* Without structured host state and both socket and AFK arrays, eligibility cannot be
		established, so return the empty list */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "afk_active")
		|| !is_array(server.sockets)
		|| !is_array(server.afk_active))
		{
			return eligible;
		}

		/* Visit each socket slot from zero, retaining only currently connected players who
		have finished joining */
		for (var slot = 0; slot < array_length(server.sockets); slot++)
		{
			/* Skip empty sockets, missing player objects, and active join-history transfers.
			These slots cannot yet make an informed shared-layer choice */
			if (server.sockets[slot] == noone
			|| player_controller_get_player(slot, false) == noone
			|| history_join_sync_active_for_slot(slot))
			{
				continue;
			}

			/* An AFK player is omitted when its AFK flag exists, except the requester remains
			eligible for their own proposal. Other ready slots are retained */
			if (slot != requester_slot
			&& slot < array_length(server.afk_active)
			&& server.afk_active[slot])
			{
				continue;
			}
			eligible[array_length(eligible)] = slot;
		}
		return eligible;
	}

	/// @description Require unanimity for up to two voters and a strict majority for larger groups
	/// @param {Real} eligible_count Number of captured eligible voter connections
	/// @returns {Real} Positive whole-number approval threshold
	server_layer_vote_required = function(eligible_count)
	{
		/* Normalize the eligible voter count to a positive whole number before choosing the
		approval threshold */
		var count = max(1, floor(real(eligible_count)));

		/* With one or two eligible voters, require every vote. Larger groups reach a strict
		majority below */
		if (count <= 2)
		{
			return count;
		}

		/* For larger groups, one more than half of the whole count provides a strict majority */
		return floor(count * 0.5) + 1;
	}

	/// @description Send one proposal result through the resolved recipient's registered transport
	/// @param {Any} raw_slot Recipient or sender value resolved through the host's slot helper
	/// @param {Real} proposal_id Vote identifier included in result feedback
	/// @param {Real} result_code LAYER_VOTE_RESULT outcome constant
	/// @param {Any} message Feedback message converted to text
	/// @returns {Real} Transport result, or minus one without a usable recipient
	server_send_layer_vote_result_to_slot = function(raw_slot, proposal_id, result_code, message)
	{
		/* Read the host methods and transport arrays needed to send one result packet */
		var server = scr_get_server();

		/* Missing host resolution, socket, or transport state prevents a targeted result send
		and returns a transport-style failure */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "slot_from_value")
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "slot_transports"))
		{
			return -1;
		}

		/* Resolve the supplied sender value into a zero-based authoritative player slot */
		var slot = server.slot_from_value(raw_slot);

		/* An unknown or disconnected slot has no recipient socket, so return failure without
		constructing a result packet */
		if (slot == noone || server.sockets[slot] == noone)
		{
			return -1;
		}
		net.start(N_LAYER_VOTE, noone);
		net.write(buffer_u8, LAYER_VOTE_PACKET_RESULT);
		net.write(buffer_u32, max(0, floor(real(proposal_id))));
		net.write(buffer_u8, result_code);
		net.write(buffer_string, string(message));
		return net.send(server.sockets[slot], true, server.slot_transports[slot]);
	}

	/// @description Send a result to ready live clients and clean up failed recipient slots
	/// @param {Real} proposal_id Vote identifier included in result feedback
	/// @param {Real} result_code LAYER_VOTE_RESULT outcome constant
	/// @param {Any} message Feedback message converted to text
	/// @returns {Real} Successful recipient count, or minus one if host state or any delivery failed
	server_broadcast_layer_vote_result = function(proposal_id, result_code, message)
	{
		/* Read the host recipient sockets and their registered transport choices */
		var server = scr_get_server();

		/* Missing recipient or transport state prevents a result broadcast, so report failure */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "slot_transports"))
		{
			return -1;
		}

		/* Count successful recipients from zero, independently of failed slots */
		var send_count = 0;

		/* Collect failed recipients for disconnection after the broadcast loop so mutation
		does not interrupt recipient iteration */
		var failed_slots = [];

		/* Visit each authoritative socket slot from zero, sending a fresh vote-result packet
		to eligible live recipients */
		for (var slot = 0; slot < array_length(server.sockets); slot++)
		{
			/* Skip disconnected slots and joining clients still behind their history barrier.
			They must not receive vote UI before the shared canvas is ready */
			if (server.sockets[slot] == noone || history_join_sync_active_for_slot(slot))
			{
				continue;
			}
			net.start(N_LAYER_VOTE, noone);
			net.write(buffer_u8, LAYER_VOTE_PACKET_RESULT);
			net.write(buffer_u32, max(0, floor(real(proposal_id))));
			net.write(buffer_u8, result_code);
			net.write(buffer_string, string(message));

			/* A failed send records that recipient and continues with the rest. Successful
			sends increase the recipient count */
			if (net.send(server.sockets[slot], true, server.slot_transports[slot]) < 0)
			{
				failed_slots[array_length(failed_slots)] = slot;
				continue;
			}
			send_count++;
		}

		/* After all sends, visit every failed slot from index zero for best-effort
		disconnection */
		for (var failed_index = 0; failed_index < array_length(failed_slots); failed_index++)
		{
			/* Close failed recipients only when the host exposes its cleanup method. Otherwise
			retain the failed broadcast result without calling an absent method */
			if (variable_struct_exists(server, "close_client_slot"))
			{
				server.close_client_slot(failed_slots[failed_index], "broadcasting layer vote result", true, true);
			}
		}

		/* Any failed recipient makes the overall result minus one. With no failures, return
		the successful recipient count */
		return array_length(failed_slots) > 0 ? -1 : send_count;
	}

	/// @description Summarize captured choices and current presence into slot masks and counts
	/// @param {Struct} vote Captured proposal with item, action, revisions, deadline, and voter entries
	/// @returns {Struct} Eligible/yes/no masks and yes/no/pending counts
	server_layer_vote_masks = function(vote)
	{
		/* eligible_mask, yes_mask, and no_mask start with no player bits set. Each slot uses
		its corresponding bit for compact vote UI packets */
		var eligible_mask = 0;
		var yes_mask = 0;
		var no_mask = 0;

		/* A missing vote or voter array supplies zero masks and counts so packet construction
		and evaluation can safely handle absent state */
		if (!is_struct(vote) || !variable_struct_exists(vote, "voters") || !is_array(vote.voters))
		{
			/* The empty result has eligible, yes, and no slot masks plus yes_count, no_count,
			and pending_count, all zero because no voter records are available */
			return { eligible: 0, yes: 0, no: 0, yes_count: 0, no_count: 0, pending_count: 0 };
		}

		/* yes_count and no_count tally recorded approvals and refusals. pending_count tallies
		undecided records, all starting with no voters counted */
		var yes_count = 0;
		var no_count = 0;
		var pending_count = 0;

		/* Inspect captured voter entries from zero through the fixed eligibility snapshot */
		for (var voter_index = 0; voter_index < array_length(vote.voters); voter_index++)
		{
			/* Borrow this voter record to read its slot, presence, and recorded choice */
			var voter = vote.voters[voter_index];

			/* Use one bit at the voter's zero-based player slot so clients can identify
			individual eligible and voting players */
			var bit = 1 << voter.slot;

			/* Voters with missing legacy presence flags or current presence contribute an
			eligible bit. Departed voters lose that bit but retain their recorded choice and
			the original approval threshold */
			if (!variable_struct_exists(voter, "present") || voter.present)
			{
				eligible_mask |= bit;
			}

			/* A positive choice is an approval, contributing to both the yes mask and approval
			count */
			if (voter.vote > 0)
			{
				yes_mask |= bit;
				yes_count++;
			}

			/* A zero choice is a refusal, contributing to the no mask and rejection count */
			else if (voter.vote == 0)
			{
				no_mask |= bit;
				no_count++;
			}

			/* Negative choices are still undecided and increase the pending count */
			else
			{
				pending_count++;
			}
		}

		/* Return the eligible/yes/no slot masks together with their approval, refusal, and
		pending totals. Choice totals include captured voters regardless of their later
		presence */
		return
		{
			eligible: eligible_mask,
			yes: yes_mask,
			no: no_mask,
			yes_count: yes_count,
			no_count: no_count,
			pending_count: pending_count
		};
	}

	/// @description Build the current vote-state packet in the shared network buffer
	/// @returns {Bool} Whether an active proposal supplied a packet
	server_write_active_layer_vote_packet = function()
	{
		/* Without an active proposal there is no state packet to construct, so leave the
		shared packet buffer unused */
		if (!is_struct(server_active_layer_vote))
		{
			return false;
		}

		/* Borrow the active proposal for its ID, action, target, requester, deadline, and
		approval threshold */
		var vote = server_active_layer_vote;

		/* Calculate compact slot masks from the captured voters for the client banner */
		var masks = server_layer_vote_masks(vote);

		/* The state packet writes proposal/action/target IDs, requested stack position,
		requester slot/name, layer name, nonnegative remaining current_time milliseconds,
		three voter masks, and the required approval count in that order */
		net.start(N_LAYER_VOTE, noone);
		net.write(buffer_u8, LAYER_VOTE_PACKET_STATE);
		net.write(buffer_u32, vote.id);
		net.write(buffer_u8, vote.action);
		net.write(buffer_u32, vote.item.layer_id);
		net.write(buffer_s16, vote.item.index);
		net.write(TYPE_ID, vote.requester_slot);
		net.write(buffer_string, vote.requester_name);
		net.write(buffer_string, vote.layer_name);
		net.write(buffer_u32, max(0, vote.deadline - current_time));
		net.write(buffer_u16, masks.eligible);
		net.write(buffer_u16, masks.yes);
		net.write(buffer_u16, masks.no);
		net.write(buffer_u8, vote.required);
		return true;
	}

	/// @description Send active vote state to ready clients and clean up failed recipients
	/// @returns {Real} Successful recipient count, or minus one on state or delivery failure
	server_broadcast_active_layer_vote = function()
	{
		/* Read host recipient sockets and transports for the current vote-state broadcast */
		var server = scr_get_server();

		/* Missing recipient or transport state prevents an active-vote broadcast and returns
		failure */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "slot_transports"))
		{
			return -1;
		}

		/* Count successful state recipients, starting at zero */
		var send_count = 0;

		/* Collect failed state recipients before any cleanup mutates the host slots */
		var failed_slots = [];

		/* Visit authoritative recipient slots from zero, sending the current proposal state
		separately to each ready connection */
		for (var slot = 0; slot < array_length(server.sockets); slot++)
		{
			/* Disconnected slots and clients behind a join-history barrier do not receive the
			live vote banner */
			if (server.sockets[slot] == noone || history_join_sync_active_for_slot(slot))
			{
				continue;
			}

			/* A missing proposal packet or failed transport send records this recipient as
			failed. Otherwise count its successful state send */
			if (!server_write_active_layer_vote_packet()
			|| net.send(server.sockets[slot], true, server.slot_transports[slot]) < 0)
			{
				failed_slots[array_length(failed_slots)] = slot;
				continue;
			}
			send_count++;
		}

		/* Visit recorded failed recipients from zero after all broadcast attempts are complete */
		for (var failed_index = 0; failed_index < array_length(failed_slots); failed_index++)
		{
			/* Use host slot cleanup only when the method exists, avoiding an
			unavailable-method call during partial shutdown state */
			if (variable_struct_exists(server, "close_client_slot"))
			{
				server.close_client_slot(failed_slots[failed_index], "broadcasting active layer vote", true, true);
			}
		}

		/* Return minus one for any failed recipient, otherwise return the successful
		state-send count */
		return array_length(failed_slots) > 0 ? -1 : send_count;
	}

	/// @description Send current vote state to one resolved live player slot
	/// @param {Any} raw_slot Recipient or sender value resolved through the host's slot helper
	/// @returns {Real} Zero without an active proposal, transport result, or minus one on unusable state
	server_send_active_layer_vote_to_slot = function(raw_slot)
	{
		/* No active proposal needs no targeted state send and returns zero rather than an
		error */
		if (!is_struct(server_active_layer_vote))
		{
			return 0;
		}

		/* Read the host slot resolver, sockets, and transports before resolving the recipient */
		var server = scr_get_server();

		/* Missing host send state prevents the targeted packet and reports failure */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "slot_from_value")
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "slot_transports"))
		{
			return -1;
		}

		/* Resolve the supplied recipient into its authoritative player slot */
		var slot = server.slot_from_value(raw_slot);

		/* An unknown slot, disconnected socket, or unavailable state packet prevents sending.
		Check the slot before indexing its socket */
		if (slot == noone || server.sockets[slot] == noone
		|| !server_write_active_layer_vote_packet())
		{
			return -1;
		}
		return net.send(server.sockets[slot], true, server.slot_transports[slot]);
	}

	/// @description Commit an authoritative layer operation and distribute it behind each recipient's history barrier
	/// @param {Struct} item Tagged layer item or accepted drawable history item
	/// @param {Real} proposer_slot Joined player's zero-based slot used to stamp authoritative attribution
	/// @returns {Bool} Whether the authoritative commit occurred, even if a failed recipient was disconnected
	server_commit_layer_history_item = function(item, proposer_slot)
	{
		/* Read host recipient state before committing and distributing a structural layer
		change */
		var server = scr_get_server();

		/* Only a tagged layer item with usable host sockets and transports can be committed
		here. Invalid item or host state leaves history unchanged */
		if (!history_item_is_layer(item)
		|| !is_struct(server)
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "slot_transports"))
		{
			return false;
		}
		server_stamp_history_item_author(item, proposer_slot);

		/* Serialize the authoritative author-stamped layer item once for diagnostics and
		direct sends */
		var payload = layer_payload_string(item);
		push_server_history(item);
		debug_server_accept_count++;
		debug_last_validated_payload = payload;

		/* Accepted layer activity resets the player's host activity tracking only when that
		optional method is available */
		if (variable_struct_exists(server, "note_client_gameplay_activity"))
		{
			server.note_client_gameplay_activity(proposer_slot);
		}

		/* Count successful direct sends or queue insertions, starting with no recipients */
		var send_count = 0;

		/* Collect failures so their slot cleanup happens after recipient iteration */
		var failed_slots = [];

		/* Visit every authoritative slot from zero to distribute this committed structural
		item */
		for (var slot = 0; slot < array_length(server.sockets); slot++)
		{
			/* A disconnected slot has no live recipient, so skip it */
			if (server.sockets[slot] == noone)
			{
				continue;
			}

			/* Reserve the per-recipient send_result local before either queuing or directly
			sending the item */
			var send_result;

			/* An existing ordered history job queues this commit behind its snapshot,
			preventing layer moves or archives from arriving before their target layer */
			if (history_sync_job_index_for_slot(slot) != noone)
			{
				/* Keep authoritative structural commits behind the slot's join
				snapshot so MOVE/ARCHIVE cannot arrive before their target layer */
				send_result = queue_history_sync_items_to_slot(slot, [item], "layer catch-up");
			}

			/* Without an ordered job, send the structural item immediately through the slot's
			registered transport */
			else
			{
				net.start(N_DRAW_COMMAND, proposer_slot);
				write_command_payload(payload);
				send_result = net.send(server.sockets[slot], true, server.slot_transports[slot]);
			}

			/* A failed queue or send records the slot for cleanup and does not count it as a
			successful recipient */
			if (send_result < 0)
			{
				failed_slots[array_length(failed_slots)] = slot;
			}

			/* A successful queue or send contributes one recipient to the diagnostic count */
			else
			{
				send_count++;
			}
		}
		debug_server_last_send_count = send_count;

		/* Any failed recipients count as a broadcast failure and may be disconnected, while
		the already committed authoritative history remains accepted */
		if (array_length(failed_slots) > 0)
		{
			debug_server_broadcast_failures++;

			/* Disconnect failed recipients only if the host exposes its slot cleanup method */
			if (variable_struct_exists(server, "close_client_slot"))
			{
				/* Visit each failed recipient from index zero after all commit distribution
				attempts */
				for (var failed_index = 0; failed_index < array_length(failed_slots); failed_index++)
				{
					server.close_client_slot(failed_slots[failed_index], "broadcasting authoritative layer operation", true, true);
				}
			}
		}
		debug_server_broadcast_count++;

		/* The server history/state commit is authoritative even if a failed
		client had to be disconnected while receiving it */
		return true;
	}

	/// @description Distribute live history without passing ordered join snapshots or ordinary sender-echo rules
	/// @param {Struct} item Tagged layer item or accepted drawable history item
	/// @param {Real} sender_slot Original author slot used for packet attribution and echo rules
	/// @param {Bool} include_sender Whether ordinary direct sender echoes should also be delivered, false by default
	/// @returns {Real} Successful queued/direct recipient count, or minus one on state or delivery failure
	server_broadcast_history_item_with_sync_barrier = function(item, sender_slot, include_sender = false)
	{
		/* Read host recipient state to preserve ordering when distributing accepted live
		history */
		var server = scr_get_server();

		/* Only a structured history item and usable host socket/transport fields can be
		broadcast, so reject unavailable state before serialization */
		if (!is_struct(item)
		|| !is_struct(server)
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "slot_transports"))
		{
			return -1;
		}

		/* Serialize the history item once for recipients not already using an ordered transfer
		queue */
		var payload = history_item_payload_string(item);

		/* Count successful queued or direct deliveries from zero */
		var send_count = 0;

		/* Collect failed slots separately so cleanup can run after the recipient loop */
		var failed_slots = [];

		/* Visit each authoritative socket slot from zero to apply its ordering and sender-echo
		rules */
		for (var slot = 0; slot < array_length(server.sockets); slot++)
		{
			/* Disconnected slots have no delivery target and are skipped */
			if (server.sockets[slot] == noone)
			{
				continue;
			}

			/* Remember whether this recipient already has an ordered history-transfer job */
			var has_ordered_job = history_sync_job_index_for_slot(slot) != noone;

			/* Omit a sender's ordinary live echo when include_sender is false and no ordered
			job exists. An ordered sender still receives the queued catch-up item to keep
			snapshot order complete */
			if (!include_sender && slot == sender_slot && !has_ordered_job)
			{
				continue;
			}

			/* Reserve send_result for either queued catch-up or immediate packet delivery */
			var send_result;

			/* An ordered job receives this item at its tail so live drawing cannot pass the
			snapshot barrier */
			if (has_ordered_job)
			{
				send_result = queue_history_sync_items_to_slot(slot, [item], "live drawing catch-up");
			}

			/* Without an ordered job, send immediately using the slot's registered transport
			and the original sender attribution */
			else
			{
				net.start(N_DRAW_COMMAND, sender_slot);
				write_command_payload(payload);
				send_result = net.send(server.sockets[slot], true, server.slot_transports[slot]);
			}

			/* Record failed delivery for cleanup without incrementing the successful recipient
			count */
			if (send_result < 0)
			{
				failed_slots[array_length(failed_slots)] = slot;
			}

			/* A successful queue or direct send increases the recipient count */
			else
			{
				send_count++;
			}
		}

		/* Any delivery failure makes this broadcast unsuccessful even if other recipients
		succeeded */
		if (array_length(failed_slots) > 0)
		{
			/* Clean up failed recipients only when the host offers its slot-closing method */
			if (variable_struct_exists(server, "close_client_slot"))
			{
				/* Visit all recorded failures from index zero after recipient iteration has
				finished */
				for (var failed_index = 0; failed_index < array_length(failed_slots); failed_index++)
				{
					server.close_client_slot(failed_slots[failed_index], "sending ordered drawing history", true, true);
				}
			}
			return -1;
		}

		return send_count;
	}

	/// @description Validate a proposal's target, captured revisions, and final active-layer constraints
	/// @param {Struct} vote Captured proposal with item, action, revisions, deadline, and voter entries
	/// @returns {Bool} Whether the proposal can still be applied to current authoritative state
	server_layer_vote_commit_is_current = function(vote)
	{
		/* A missing vote or invalid layer-history target cannot be approved against current
		state, so return false */
		if (!is_struct(vote) || !history_item_is_layer(vote.item))
		{
			return false;
		}

		/* Resolve the proposal's stable target ID in the current authoritative stack */
		var state_index = server_layer_state_index(vote.item.layer_id);

		/* A removed target invalidates the proposal, so reject approval before reading its
		state */
		if (state_index == noone)
		{
			return false;
		}

		/* Borrow current authoritative metadata for comparison with the proposal's captured
		revisions */
		var state = server_layer_states[state_index];

		/* Move proposals require an active target and an unchanged whole-stack revision
		because their requested position depends on stack order */
		if (vote.action == LAYER_VOTE_ACTION_MOVE)
		{
			/* An archived target or changed stack revision invalidates the move. Both active
			status and matching revision must hold */
			return !state.archived && server_layer_stack_revision == vote.base_stack_revision;
		}

		/* Nonmove proposals become stale if their target layer revision changed during voting */
		if (state.revision != vote.base_layer_revision)
		{
			return false;
		}

		/* Archive proposals must still target an active layer while another active layer
		remains */
		if (vote.action == LAYER_VOTE_ACTION_ARCHIVE)
		{
			/* Approve archive validity only for an unarchived target and more than one active
			layer, preserving a usable drawing layer */
			return !state.archived && server_active_layer_count() > 1;
		}

		/* Restore proposals remain current only while their target is still archived */
		if (vote.action == LAYER_VOTE_ACTION_RESTORE)
		{
			/* A restored or otherwise active target no longer needs this restore proposal, so
			only archived state passes */
			return state.archived;
		}

		/* Unrecognized proposal actions have no current commit rule and are rejected */
		return false;
	}

	/// @description Post a system chat explanation when the host chat method is available
	/// @param {Any} message Feedback message converted to text
	server_layer_vote_chat = function(message)
	{
		/* Read the shared host to post a system message describing a layer vote */
		var server = scr_get_server();

		/* Broadcast chat only when the host exposes its chat method. Unavailable chat state
		does not prevent the underlying vote operation */
		if (is_struct(server) && variable_struct_exists(server, "broadcast_chat"))
		{
			server.broadcast_chat(CHAT_TYPE_SYSTEM, noone, "", string(message));
		}
	}

	/// @description Clear a proposal, validate any approved commit, apply retry waits, and broadcast its final result
	/// @param {Real} result_code LAYER_VOTE_RESULT outcome constant
	/// @param {Any} message Feedback message converted to text
	/// @returns {Bool} Whether the final result remained approved
	server_finish_active_layer_vote = function(result_code, message)
	{
		/* No active proposal can be finished, so leave state unchanged and return false */
		if (!is_struct(server_active_layer_vote))
		{
			return false;
		}

		/* Retain the proposal locally before clearing the active field, preventing callbacks
		from treating it as still running */
		var vote = server_active_layer_vote;
		server_active_layer_vote = noone;

		/* Start with the requested result code, which an approved-but-stale or failed commit
		may replace with cancellation */
		var final_result = result_code;

		/* Normalize the requested result message before any cancellation supplies a more
		specific detail */
		var final_message = string(message);

		/* Only an approval attempts to commit the layer operation. Rejections and
		cancellations report their result without changing layer history */
		if (result_code == LAYER_VOTE_RESULT_APPROVED)
		{
			/* A stale proposal becomes cancelled rather than applying a changed layer or
			obsolete stack position */
			if (!server_layer_vote_commit_is_current(vote))
			{
				final_result = LAYER_VOTE_RESULT_CANCELLED;
				final_message = "The layer changed before the vote finished. Please request it again.";
			}

			/* If current-state validation passed but the authoritative commit fails, report
			cancellation instead of approval */
			else if (!server_commit_layer_history_item(vote.item, vote.requester_slot))
			{
				final_result = LAYER_VOTE_RESULT_CANCELLED;
				final_message = "The server could not commit the approved layer change.";
			}
		}

		/* Set proposal retry state only when the original requester indexes the cooldown
		array. Missing requester storage leaves it unchanged */
		if (vote.requester_slot >= 0
		&& vote.requester_slot < array_length(server_layer_vote_cooldown_until))
		{
			/* Approved proposals use the normal retry wait. Other final outcomes use three
			times that wait, all scheduled on current_time */
			server_layer_vote_cooldown_until[vote.requester_slot] = current_time
				+ (final_result == LAYER_VOTE_RESULT_APPROVED ? layer_vote_retry_cooldown_ms : layer_vote_retry_cooldown_ms * 3);
		}
		server_broadcast_layer_vote_result(vote.id, final_result, final_message);
		server_layer_vote_chat(final_message);

		/* Only the final approved result returns true. Stale approvals, commit failures,
		rejection, and cancellation return false after result broadcasting */
		return final_result == LAYER_VOTE_RESULT_APPROVED;
	}

	/// @description Resolve reached approvals, impossible thresholds, or timeout, otherwise optionally broadcast pending state
	/// @param {Bool} broadcast_pending Whether an undecided proposal should send its current state, true by default
	/// @returns {Bool} Approval finalization result or true for handled rejection/timeout, false while pending or after cancelled approval
	server_evaluate_active_layer_vote = function(broadcast_pending = true)
	{
		/* Without an active proposal there is no threshold or deadline to evaluate, so report
		no completion */
		if (!is_struct(server_active_layer_vote))
		{
			return false;
		}

		/* Borrow the active proposal and its captured approval requirement */
		var vote = server_active_layer_vote;

		/* Calculate approvals, refusals, and pending choices from the captured voter records */
		var masks = server_layer_vote_masks(vote);

		/* Enough recorded approvals finalize the proposal, with current-state and commit
		validation still able to cancel it */
		if (masks.yes_count >= vote.required)
		{
			/* Choose an archive, restore, or reorder success message according to the proposal
			action before attempting its approved finish */
			var approved_message = vote.action == LAYER_VOTE_ACTION_ARCHIVE
				? "The vote passed. “" + vote.layer_name + "” was archived."
				: (vote.action == LAYER_VOTE_ACTION_RESTORE
					? "The vote passed. “" + vote.layer_name + "” was restored."
					: "The vote passed. The shared layer order was updated.");
			return server_finish_active_layer_vote(LAYER_VOTE_RESULT_APPROVED, approved_message);
		}

		/* If all remaining pending votes still cannot reach the approval threshold, reject
		immediately rather than waiting out the deadline */
		if (masks.yes_count + masks.pending_count < vote.required)
		{
			server_finish_active_layer_vote(LAYER_VOTE_RESULT_REJECTED, "The layer vote did not pass. Nothing changed.");
			return true;
		}

		/* A proposal past its current_time deadline is rejected. A still-possible proposal
		before the deadline remains pending */
		if (current_time >= vote.deadline)
		{
			server_finish_active_layer_vote(LAYER_VOTE_RESULT_REJECTED, "The layer vote timed out. Nothing changed.");
			return true;
		}

		/* Broadcast pending state only when requested. Presence maintenance can suppress
		redundant unchanged state broadcasts */
		if (broadcast_pending)
		{
			server_broadcast_active_layer_vote();
		}

		/* No approval, impossible-threshold rejection, or timeout completed this evaluation,
		so the proposal remains pending */
		return false;
	}

	/// @description Capture a fixed voter snapshot or directly commit when at most one player is eligible
	/// @param {Struct} item Tagged layer item or accepted drawable history item
	/// @param {Real} requester_slot Zero-based requester slot retained even when its AFK flag is set
	/// @param {Real} action LAYER_VOTE_ACTION move, archive, or restore identifier
	/// @returns {Bool} Whether a proposal was created or the direct commit succeeded
	server_create_layer_vote = function(item, requester_slot, action)
	{
		/* Read authoritative author assignments before capturing requester and voter
		identities */
		var server = scr_get_server();

		/* Only one shared-layer vote may run at a time. Reject a new request while another
		proposal is active */
		if (is_struct(server_active_layer_vote))
		{
			server_send_layer_vote_result_to_slot(requester_slot, 0, LAYER_VOTE_RESULT_CANCELLED, "Another layer vote is already in progress.");
			return false;
		}

		/* The requester must index available connection-specific author state. Missing host
		data or an out-of-range slot prevents capturing a valid proposal */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "slot_drawing_author_ids")
		|| requester_slot < 0
		|| requester_slot >= array_length(server.slot_drawing_author_ids))
		{
			return false;
		}

		/* Extend retry deadlines through the requester slot, adding zero for newly available
		slots so they have no prior proposal wait */
		while (array_length(server_layer_vote_cooldown_until) <= requester_slot)
		{
			server_layer_vote_cooldown_until[array_length(server_layer_vote_cooldown_until)] = 0;
		}

		/* Before the requester's current_time retry deadline, reject a new proposal and show
		the remaining wait */
		if (current_time < server_layer_vote_cooldown_until[requester_slot])
		{
			/* Round the remaining milliseconds upward into whole seconds so feedback does not
			suggest an expired wait */
			var wait_seconds = ceil((server_layer_vote_cooldown_until[requester_slot] - current_time) / 1000);
			server_send_layer_vote_result_to_slot(requester_slot, 0, LAYER_VOTE_RESULT_CANCELLED, "Please wait " + string(wait_seconds) + "s before requesting another layer vote.");
			return false;
		}

		/* Capture connected, joined, non-AFK eligible slots while retaining the ready
		requester */
		var eligible_slots = server_layer_eligible_slots(requester_slot);

		/* With zero or one eligible slot, commit directly rather than creating a multi-player
		vote */
		if (array_length(eligible_slots) <= 1)
		{
			/* Keep the direct authoritative commit result to decide whether a retry deadline
			should be started */
			var committed = server_commit_layer_history_item(item, requester_slot);

			/* A successful direct commit starts the normal proposal retry wait. A failed
			commit leaves that deadline unchanged */
			if (committed)
			{
				server_layer_vote_cooldown_until[requester_slot] = current_time + layer_vote_retry_cooldown_ms;
			}
			return committed;
		}

		/* Build voter records independently, starting with no captured participants */
		var voters = [];

		/* Visit every captured eligible slot from index zero to preserve the eligibility
		snapshot */
		for (var eligible_index = 0; eligible_index < array_length(eligible_slots); eligible_index++)
		{
			/* Read the current eligible player slot and its assigned author identity */
			var eligible_slot = eligible_slots[eligible_index];

			/* Each voter stores slot and connection-specific author_id to reject slot reuse,
			present true at capture, and vote as approval one for the requester or pending
			minus one for everyone else */
			voters[array_length(voters)] =
			{
				slot: eligible_slot,
				author_id: server.slot_drawing_author_ids[eligible_slot],
				present: true,

				/* The requester starts with approval because the request is their proposed
				change. Other eligible players begin undecided */
				vote: eligible_slot == requester_slot ? 1 : -1
			};
		}

		/* Resolve the proposed target's authoritative metadata before recording revision
		snapshots */
		var state_index = server_layer_state_index(item.layer_id);

		/* A disappeared target cannot be voted on, so stop without constructing active
		proposal state */
		if (state_index == noone)
		{
			return false;
		}
		server_stamp_history_item_author(item, requester_slot);

		/* The active proposal stores its fresh id/action/item, requester slot and
		connection-specific author, display names, captured layer/stack revisions,
		current_time deadline, fixed voter snapshot, and required approval count. These let
		later updates reject stale target or connection state */
		server_active_layer_vote =
		{
			id: server_next_layer_vote_id,
			action: action,
			item: item,
			requester_slot: requester_slot,
			requester_author_id: server.slot_drawing_author_ids[requester_slot],
			requester_name: server_slot_display_name(requester_slot),
			layer_name: server_layer_states[state_index].name,
			base_layer_revision: server_layer_states[state_index].revision,
			base_stack_revision: server_layer_stack_revision,
			deadline: current_time + layer_vote_duration_ms,
			voters: voters,
			required: server_layer_vote_required(array_length(voters))
		};
		server_next_layer_vote_id++;
		server_layer_vote_cooldown_until[requester_slot] = current_time + layer_vote_retry_cooldown_ms;

		/* Use archive or restore wording for those actions and reorder wording for the
		remaining move action, keeping the system chat request specific */
		var action_text = action == LAYER_VOTE_ACTION_ARCHIVE
			? "archive “" + server_active_layer_vote.layer_name + "”"
			: (action == LAYER_VOTE_ACTION_RESTORE
				? "restore “" + server_active_layer_vote.layer_name + "”"
				: "change the shared layer order");
		server_layer_vote_chat(server_active_layer_vote.requester_name + " requested a vote to " + action_text + ".");
		server_broadcast_active_layer_vote();
		return true;
	}

	/// @description Read a cast for the active proposal and match its sender's captured slot-and-author identity
	/// @param {Any} raw_slot Recipient or sender value resolved through the host's slot helper
	/// @returns {Bool} Whether an eligible current sender's choice was recorded
	server_handle_layer_vote_packet = function(raw_slot)
	{
		/* Read the layer-vote packet subtype from the already primed network reader */
		var packet_kind = net.read(buffer_u8);

		/* Only a client CAST subtype belongs in this handler. Other layer-vote packet
		directions are rejected before reading cast fields */
		if (packet_kind != LAYER_VOTE_PACKET_CAST)
		{
			return false;
		}

		/* Read the proposal identifier so delayed casts cannot affect a later proposal */
		var proposal_id = net.read(buffer_u32);

		/* Decode the choice byte as approve for any nonzero value or refusal for zero */
		var approve = net.read(buffer_u8) != 0;

		/* Read current authoritative socket and drawing-author assignments to validate the
		cast sender */
		var server = scr_get_server();

		/* The cast must target the currently active proposal, and the host must expose sender
		resolution, sockets, and author assignments. Other or missing state cannot change
		voters */
		if (!is_struct(server_active_layer_vote)
		|| proposal_id != server_active_layer_vote.id
		|| !is_struct(server)
		|| !variable_struct_exists(server, "slot_from_value")
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "slot_drawing_author_ids"))
		{
			return false;
		}

		/* Resolve the sender into a current authoritative player slot */
		var slot = server.slot_from_value(raw_slot);

		/* An unknown or disconnected sender has no valid current vote identity, so reject the
		cast */
		if (slot == noone || server.sockets[slot] == noone)
		{
			return false;
		}

		/* Borrow the matching active proposal to locate the sender's captured voter record */
		var vote = server_active_layer_vote;

		/* Search captured voters from index zero until both player slot and
		connection-specific author match */
		for (var voter_index = 0; voter_index < array_length(vote.voters); voter_index++)
		{
			/* Borrow the captured voter to compare its original slot/author with the current
			sender connection */
			var voter = vote.voters[voter_index];

			/* Skip records for another slot or an older connection author so a reused player
			slot cannot inherit someone else's eligibility */
			if (voter.slot != slot
			|| voter.author_id != server.slot_drawing_author_ids[slot])
			{
				continue;
			}

			/* Store approval as one and refusal as zero. Repeated valid casts replace the
			recorded choice, then trigger threshold evaluation */
			voter.vote = approve ? 1 : 0;

			/* A valid cast marks gameplay activity only when the host offers that optional
			hook */
			if (variable_struct_exists(server, "note_client_gameplay_activity"))
			{
				server.note_client_gameplay_activity(slot);
			}
			server_evaluate_active_layer_vote();
			return true;
		}

		/* No captured voter matched this sender connection, so the cast leaves the proposal
		unchanged */
		return false;
	}

	/// @description Cancel a departed requester and update voter presence without lowering the fixed threshold
	/// @returns {Bool} Evaluation result, false without a proposal or on cancellation
	server_update_active_layer_vote = function()
	{
		/* No active proposal needs requester or voter presence maintenance */
		if (!is_struct(server_active_layer_vote))
		{
			return false;
		}

		/* Read host sockets and current author assignments to detect departures and reused
		slots */
		var server = scr_get_server();

		/* Missing authoritative connection state cancels the proposal rather than letting
		stale presence produce an approval */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "slot_drawing_author_ids"))
		{
			return server_finish_active_layer_vote(LAYER_VOTE_RESULT_CANCELLED, "The layer vote was cancelled because the server state changed.");
		}

		/* Borrow the active proposal before checking its original requester connection */
		var vote = server_active_layer_vote;

		/* Read the requester's captured zero-based slot for socket and author validation */
		var requester_slot = vote.requester_slot;

		/* A missing, disconnected, or reused requester slot cancels the proposal because its
		originating connection no longer exists */
		if (requester_slot < 0
		|| requester_slot >= array_length(server.sockets)
		|| server.sockets[requester_slot] == noone
		|| server.slot_drawing_author_ids[requester_slot] != vote.requester_author_id)
		{
			return server_finish_active_layer_vote(LAYER_VOTE_RESULT_CANCELLED, "The layer vote was cancelled because its requester left.");
		}

		/* Eligibility and the required count are snapshots. A departing voter keeps
		their recorded choice, including a pending choice, so leaving cannot lower
		the threshold and turn a losing vote into an approval */
		/* Start with no presence changes so unchanged maintenance can avoid rebroadcasting the
		same pending banner */
		var presence_changed = false;

		/* Inspect all captured voter entries from index zero, preserving their original
		choices and required threshold */
		for (var voter_index = 0; voter_index < array_length(vote.voters); voter_index++)
		{
			/* Borrow the current captured voter to compare its presence and connection
			identity */
			var voter = vote.voters[voter_index];

			/* A currently present or legacy-present voter becomes absent when its slot is
			invalid, disconnected, or assigned to another author. Already absent or
			still-matching connections need no update */
			if ((!variable_struct_exists(voter, "present") || voter.present)
			&& (voter.slot < 0
				|| voter.slot >= array_length(server.sockets)
				|| server.sockets[voter.slot] == noone
				|| server.slot_drawing_author_ids[voter.slot] != voter.author_id))
			{
				voter.present = false;
				presence_changed = true;
			}
		}

		/* Reevaluate the fixed vote threshold after presence checks, broadcasting a pending
		state only when presence changed */
		return server_evaluate_active_layer_vote(presence_changed);
	}

	/// @description Cancel a departed requester or remove a captured nonrequester's presence bit
	/// @param {Any} raw_slot Recipient or sender value resolved through the host's slot helper
	/// @returns {Bool} True for a matched nonrequester update, false when absent or when requester cancellation returns false
	server_layer_vote_slot_disconnected = function(raw_slot)
	{
		/* No active proposal has voter presence to change, so return false */
		if (!is_struct(server_active_layer_vote))
		{
			return false;
		}

		/* Read the host slot resolver if still available during disconnect cleanup */
		var server = scr_get_server();

		/* Resolve the disconnect value through the host when possible. Otherwise retain the
		supplied slot because shutdown may already have removed that method */
		var slot = is_struct(server) && variable_struct_exists(server, "slot_from_value")
			? server.slot_from_value(raw_slot)
			: raw_slot;

		/* An unknown disconnect slot cannot identify a captured participant and leaves the
		proposal unchanged */
		if (slot == noone)
		{
			return false;
		}

		/* Losing the requester cancels the entire proposal. Other departures only update their
		captured presence below */
		if (server_active_layer_vote.requester_slot == slot)
		{
			return server_finish_active_layer_vote(LAYER_VOTE_RESULT_CANCELLED, "The layer vote was cancelled because its requester left.");
		}

		/* Borrow the remaining active proposal to find the departing nonrequester voter */
		var vote = server_active_layer_vote;

		/* Search captured voters from index zero until the departed player slot matches or the
		voter list ends */
		for (var voter_index = 0; voter_index < array_length(vote.voters); voter_index++)
		{
			/* A matching departing voter loses its presence bit, retaining its recorded choice
			and the original approval threshold. Broadcast that presence update and stop */
			if (vote.voters[voter_index].slot == slot)
			{
				vote.voters[voter_index].present = false;
				server_broadcast_active_layer_vote();
				return true;
			}
		}

		/* Non-requester departures do not alter the snapshotted threshold */
		return false;
	}

	/// @description Record a host layer rejection and send cancellation feedback to the requester
	/// @param {Real} slot Validated zero-based authoritative player slot
	/// @param {Any} message Feedback message converted to text
	/// @returns {Bool} False after rejection feedback
	server_reject_layer_request = function(slot, message)
	{
		debug_server_reject_count++;
		debug_note("server rejected layer request", server_slot_label(slot) + " " + string(message));
		server_send_layer_vote_result_to_slot(slot, 0, LAYER_VOTE_RESULT_CANCELLED, message);
		return false;
	}

	/// @description Extend per-slot storage and reserve a host layer-action wait only after expiry
	/// @param {Real} slot Validated zero-based authoritative player slot
	/// @returns {Bool} Whether this validated slot's current_time action wait has expired
	server_try_layer_action_cooldown = function(slot)
	{
		/* Extend layer-action deadlines through this validated player slot, adding zero
		deadlines so newly allocated slots have no initial wait */
		while (array_length(server_layer_action_cooldown_until) <= slot)
		{
			server_layer_action_cooldown_until[array_length(server_layer_action_cooldown_until)] = 0;
		}

		/* Before its current_time action deadline, reject the request. After expiry, reserve
		the next configured wait and allow it */
		if (current_time < server_layer_action_cooldown_until[slot])
		{
			return false;
		}
		server_layer_action_cooldown_until[slot] = current_time + server_layer_action_cooldown_ms;
		return true;
	}

	/// @description Validate joined-client layer requests, allocating authoritative IDs and voting on shared changes
	/// @param {Struct} item Tagged layer item or accepted drawable history item
	/// @param {Real} slot Validated zero-based authoritative player slot
	/// @returns {Bool} Commit or proposal result, false when rejected
	server_handle_layer_history_request = function(item, slot)
	{
		/* Only tagged layer-history items belong in this handler, so other history kinds make
		no layer changes */
		if (!history_item_is_layer(item))
		{
			return false;
		}

		/* Read host usernames and connection-specific drawing authors to confirm the requester
		has finished joining */
		var server = scr_get_server();

		/* Require an in-range slot with a nonblank assigned name and positive drawing-author
		ID. Missing host fields or incomplete join identity reject the request before layer
		changes */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "slot_usernames")
		|| !variable_struct_exists(server, "slot_drawing_author_ids")
		|| slot < 0
		|| slot >= array_length(server.slot_usernames)
		|| slot >= array_length(server.slot_drawing_author_ids)
		|| string_trim(string(server.slot_usernames[slot])) == ""
		|| server.slot_drawing_author_ids[slot] <= 0)
		{
			return server_reject_layer_request(slot, "Finish joining before changing shared layers.");
		}

		/* A slot still receiving ordered history cannot modify a canvas it has not fully
		received, so reject the layer request */
		if (history_sync_job_index_for_slot(slot) != noone)
		{
			return server_reject_layer_request(slot, "Wait for the shared canvas to finish syncing.");
		}
		server_ensure_default_layer_state();

		/* A running shared vote must finish before another layer operation can alter its
		target or captured stack, so reject this request */
		if (is_struct(server_active_layer_vote))
		{
			return server_reject_layer_request(slot, "Wait for the current layer vote to finish.");
		}

		/* An unexpired host layer-action cooldown rejects the request. Ready requests reserve
		that wait before their operation-specific validation */
		if (!server_try_layer_action_cooldown(slot))
		{
			return server_reject_layer_request(slot, "Please wait a moment before changing shared layers again.");
		}

		server_stamp_history_item_author(item, slot);

		/* Add requests allocate a fresh authoritative ID and insert a new empty layer near the
		requested source layer */
		if (item.op == DRAW_LAYER_ADD)
		{
			/* The active-layer ceiling blocks creating another unarchived layer, preserving
			the shared active-stack limit */
			if (server_active_layer_count() >= max_shared_active_layers)
			{
				return server_reject_layer_request(slot, "The shared canvas already has the maximum of " + string(max_shared_active_layers) + " active layers.");
			}

			/* The total-layer ceiling includes archived history, so reaching it also blocks
			new stored layers */
			if (array_length(server_layer_states) >= max_shared_total_layers)
			{
				return server_reject_layer_request(slot, "The server has reached its layer history safety limit.");
			}
			item.layer_id = server_next_layer_id;
			server_next_layer_id++;

			/* Resolve the requested source ID only as an insertion anchor for the new layer */
			var add_after_index = server_layer_state_index(item.source_layer_id);

			/* With no source anchor, append at the end of the stored stack. An existing anchor
			inserts immediately after that layer */
			item.index = add_after_index == noone
				? array_length(server_layer_states)
				: add_after_index + 1;
			item.name = layer_default_name(item.layer_id);
			return server_commit_layer_history_item(item, slot);
		}

		/* Duplicate requests allocate a new layer next to an available source while retaining
		its pixels through history replay */
		if (item.op == DRAW_LAYER_DUPLICATE)
		{
			/* Either active or total layer capacity prevents duplication because it adds
			another stored active layer */
			if (server_active_layer_count() >= max_shared_active_layers
			|| array_length(server_layer_states) >= max_shared_total_layers)
			{
				return server_reject_layer_request(slot, "The shared canvas has reached its layer limit.");
			}

			/* Resolve the requested stable source ID before copying its authoritative layer */
			var source_index = server_layer_state_index(item.source_layer_id);

			/* A missing or archived source cannot be duplicated by this request. Check
			existence before reading its archive flag */
			if (source_index == noone || server_layer_states[source_index].archived)
			{
				return server_reject_layer_request(slot, "That source layer is no longer available.");
			}
			item.layer_id = server_next_layer_id;
			server_next_layer_id++;
			item.index = source_index + 1;
			item.name = layer_name_clean(server_layer_states[source_index].name + " Copy", layer_default_name(item.layer_id));
			return server_commit_layer_history_item(item, slot);
		}

		/* Treat legacy delete requests as archive requests so layers with content go through
		the same voting and preservation rules */
		if (item.op == DRAW_LAYER_DELETE)
		{
			item.op = DRAW_LAYER_ARCHIVE;
		}

		/* Resolve the target of a move, archive, or restore request in current authoritative
		state */
		var state_index = server_layer_state_index(item.layer_id);

		/* A target removed since the client built its request cannot be changed and is
		rejected */
		if (state_index == noone)
		{
			return server_reject_layer_request(slot, "That layer no longer exists.");
		}

		/* Borrow the current target state to use authoritative name, archive/content status,
		and stack index */
		var state = server_layer_states[state_index];
		item.name = state.name;
		item.index = clamp(item.index, 0, max(0, array_length(server_layer_states) - 1));

		/* Move requests need an active target and a genuinely different requested position
		before opening a vote */
		if (item.op == DRAW_LAYER_MOVE)
		{
			/* Archived layers stay outside active reordering until restored, so reject their
			move requests */
			if (state.archived)
			{
				return server_reject_layer_request(slot, "Archived layers cannot be moved until they are restored.");
			}

			/* A requested position equal to the current stack index makes no change and needs
			no vote */
			if (item.index == state_index)
			{
				return server_reject_layer_request(slot, "That layer is already in the requested position.");
			}
			return server_create_layer_vote(item, slot, LAYER_VOTE_ACTION_MOVE);
		}

		/* Archive requests retain layers with content and protect the final active layer */
		if (item.op == DRAW_LAYER_ARCHIVE)
		{
			/* An already archived target cannot be archived again and is rejected */
			if (state.archived)
			{
				return server_reject_layer_request(slot, "That layer is already archived.");
			}

			/* Archiving the final active layer would leave no usable active canvas, so reject
			it */
			if (server_active_layer_count() <= 1)
			{
				return server_reject_layer_request(slot, "The last active layer cannot be archived.");
			}

			/* An empty target has no recorded content to preserve, so convert it to a direct
			delete instead of opening an archive vote. Content-bearing targets reach the
			archive proposal */
			if (!state.has_content)
			{
				item.op = DRAW_LAYER_DELETE;
				return server_commit_layer_history_item(item, slot);
			}
			return server_create_layer_vote(item, slot, LAYER_VOTE_ACTION_ARCHIVE);
		}

		/* Restore requests reactivate a retained archived layer through the vote path */
		if (item.op == DRAW_LAYER_RESTORE)
		{
			/* An already active target needs no restoration, so reject that redundant request */
			if (!state.archived)
			{
				return server_reject_layer_request(slot, "That layer is already active.");
			}

			/* Restoring would add an active layer, so reject it while the active stack is at
			its ceiling */
			if (server_active_layer_count() >= max_shared_active_layers)
			{
				return server_reject_layer_request(slot, "Archive another layer before restoring this one.");
			}
			item.index = state_index;
			return server_create_layer_vote(item, slot, LAYER_VOTE_ACTION_RESTORE);
		}

		/* An operation outside add, duplicate, move, archive, and restore has no supported
		request path and is rejected */
		return server_reject_layer_request(slot, "That layer operation is not supported.");
	}

	/// @description Cancel archive or restore voting when its target receives new drawable content
	/// @param {Real} target_layer_id Stable layer ID whose drawable content changed
	/// @returns {Bool} Whether a relevant proposal was cancelled
	server_cancel_layer_vote_for_layer_content = function(target_layer_id)
	{
		/* Without an active proposal or a known changed target layer, there is nothing to
		invalidate */
		if (!is_struct(server_active_layer_vote)
		|| target_layer_id == noone)
		{
			return false;
		}

		/* Drawing on another layer does not affect this proposal, and move votes depend on
		stack order rather than content, so both cases remain active */
		if (target_layer_id != server_active_layer_vote.item.layer_id
		|| server_active_layer_vote.action == LAYER_VOTE_ACTION_MOVE)
		{
			return false;
		}
		server_finish_active_layer_vote(
			LAYER_VOTE_RESULT_CANCELLED,
			"The layer changed while voting. Nothing changed; request the vote again when drawing pauses."
		);
		return true;
	}

	/// @description Resolve a drawable history target for archive/restore vote invalidation
	/// @param {Struct} item Tagged layer item or accepted drawable history item
	/// @returns {Bool} Whether drawable content cancelled a proposal, false for layer and undo records
	server_cancel_layer_vote_for_history_item = function(item)
	{
		/* Layer and undo records are handled through their structural paths rather than this
		drawable-content invalidator. Other records resolve their target layer and may
		cancel archive or restore voting */
		if (history_item_is_layer(item) || history_item_is_undo(item))
		{
			return false;
		}
		return server_cancel_layer_vote_for_layer_content(history_item_layer_id(item));
	}
	#endregion /* Server Layer Voting END */

	#region /* Undo Patches and History Reconstruction */
	/// @description Require drawable history with positive connection-author and stroke-group IDs
	/// @param {Struct} item History item to classify, inspect, mutate, capture, or restore
	/// @returns {Bool} Whether the item can belong to an undo group
	history_item_is_undoable_command = function(item)
	{
		/* An undoable drawable must be structured, outside layer and undo-record kinds, and
		carry positive connection-author and stroke-group IDs. Missing or zero IDs cannot
		identify an undo group */
		return is_struct(item)
			&& !history_item_is_layer(item)
			&& !history_item_is_undo(item)
			&& command_undo_author_id(item) > 0
			&& command_undo_id(item) > 0;
	}

	/// @description Match drawable history to one connection-specific author and group pair
	/// @param {Struct} item History item to classify, inspect, mutate, capture, or restore
	/// @param {Real} undo_author_id Connection-specific drawing author ID
	/// @param {Real} undo_id Stroke-group ID within that author
	/// @returns {Bool} Whether the item belongs to that exact undo group
	history_item_matches_undo_group = function(item, undo_author_id, undo_id)
	{
		/* Match only undoable drawing with both the requested author and group IDs so another
		connection's same-numbered stroke is not removed */
		return history_item_is_undoable_command(item)
			&& command_undo_author_id(item) == undo_author_id
			&& command_undo_id(item) == undo_id;
	}

	/// @description Resolve an image or ordinary drawable target with legacy layer-one compatibility
	/// @param {Struct} item History item to classify, inspect, mutate, capture, or restore
	/// @returns {Real} Stable target layer ID, or noone for nondrawable records
	history_item_layer_id = function(item)
	{
		/* Structural layer and undo records do not identify one drawable target, and nonstruct
		values have no layer fields, so return noone */
		if (!is_struct(item)
		|| history_item_is_layer(item)
		|| history_item_is_undo(item))
		{
			return noone;
		}

		/* Image records use their optional stable layer ID rather than ordinary command
		accessors */
		if (history_item_is_image(item))
		{
			/* An explicit image layer is normalized to a positive whole ID. Older images
			without the field stay on default layer one */
			if (variable_struct_exists(item, "layer_id"))
			{
				return max(1, floor(real(item.layer_id)));
			}

			return 1;
		}

		/* A remaining struct without a tool ID is not an ordinary drawable command and has no
		target layer here */
		if (!variable_struct_exists(item, "tool_id"))
		{
			return noone;
		}

		return command_layer_id(item);
	}

	/// @description Check whether a drawable item targets the supplied stable layer ID
	/// @param {Struct} item History item to classify, inspect, mutate, capture, or restore
	/// @param {Real} target_layer_id Stable drawable layer identifier
	/// @returns {Bool} Whether a known drawable target matches
	history_item_targets_layer = function(item, target_layer_id)
	{
		/* Resolve this item's drawable target before comparing it with the requested stable
		layer ID */
		var item_layer_id = history_item_layer_id(item);

		/* Only a known matching target belongs to the layer. noone must not compare as a valid
		drawable target */
		return item_layer_id != noone && item_layer_id == target_layer_id;
	}

	/// @description Require every removed drawable item to target the same layer
	/// @param {Array} undo_group Chronologically ordered drawable records removed together
	/// @returns {Real} Common layer ID, or noone for empty, unavailable, or multiple targets
	undo_group_single_layer_id = function(undo_group)
	{
		/* No common target is known until the first drawable group entry supplies its layer ID */
		var target_layer_id = noone;

		/* Visit every undo-group entry from index zero, rejecting unavailable or conflicting
		layer IDs before choosing a single-layer replay */
		for (var group_index = 0; group_index < array_length(undo_group); group_index++)
		{
			/* Read this group's current item's stable drawable target */
			var item_layer_id = history_item_layer_id(undo_group[group_index]);

			/* An item without a drawable layer prevents safely reducing this group to
			one-layer reconstruction */
			if (item_layer_id == noone)
			{
				return noone;
			}

			/* The first known target establishes the common layer for later entries */
			if (target_layer_id == noone)
			{
				target_layer_id = item_layer_id;
			}

			/* A later different target makes this a multilayer group, so return noone rather
			than rebuilding only part of it */
			else if (target_layer_id != item_layer_id)
			{
				return noone;
			}
		}

		return target_layer_id;
	}

	/// @description Find structural layer operations in the remaining client history range
	/// @param {Real} start_index Zero-based client-history index at which the dependency search begins
	/// @returns {Bool} Whether any layer-history item occurs at or after the clamped start
	history_range_has_layer_item = function(start_index)
	{
		/* Clamp the requested zero-based starting index to the current history range before
		searching later structural operations */
		var first_index = clamp(floor(real(start_index)), 0, array_length(client_history));

		/* Search history from that first index through the end, stopping as soon as a layer
		operation is found */
		for (var history_index = first_index; history_index < array_length(client_history); history_index++)
		{
			/* A later layer operation can affect stack structure and pixel dependencies, so
			report that the simple replay path needs a broader fallback */
			if (history_item_is_layer(client_history[history_index]))
			{
				return true;
			}
		}

		/* No structural layer operation remains in the requested range */
		return false;
	}

	/// @description Find cross-layer fill sampling dependencies on one target
	/// @param {Real} target_layer_id Stable drawable layer identifier
	/// @returns {Bool} Whether target-layer history includes a visible-layer fill
	history_layer_has_visible_fill_command = function(target_layer_id)
	{
		/* Search client history from index zero for fills on the target layer that sampled
		other visible layers */
		for (var history_index = 0; history_index < array_length(client_history); history_index++)
		{
			/* Borrow the current history record to inspect target and tool kind */
			var item = client_history[history_index];

			/* Skip other layer targets, images, and records without a tool field because they
			cannot be visible-layer fill commands */
			if (!history_item_targets_layer(item, target_layer_id)
			|| history_item_is_image(item)
			|| !variable_struct_exists(item, "tool_id"))
			{
				continue;
			}

			/* A fill that samples the visible composite depends on other layers, so rebuilding
			its target in isolation may change the result */
			if (item.tool_id == DRAW_TOOL_FILL
			&& command_fill_sample_visible(item))
			{
				return true;
			}
		}

		/* No visible-layer fill dependency was found on the requested layer */
		return false;
	}

	/// @description Free a live patch-owned surface and clear its handle
	/// @param {Any} patch Owned snapshot struct whose optional surface may be missing or lost
	/// @returns {Bool} Whether a live surface was released
	undo_patch_dispose = function(patch)
	{
		/* Free a patch only when its struct owns a live surface. Missing or already-lost
		resources require no release and return false */
		if (is_struct(patch)
		&& variable_struct_exists(patch, "surface")
		&& surface_exists(patch.surface))
		{
			surface_free(patch.surface);
			patch.surface = noone;
			return true;
		}

		return false;
	}

	/// @description Release an item's patch surface and clear its patch reference
	/// @param {Struct} item History item to classify, inspect, mutate, capture, or restore
	/// @returns {Bool} Whether disposal released a live patch surface
	dispose_item_undo_patch = function(item)
	{
		/* An item without an undo_patch field has no owned snapshot to dispose, so return
		false */
		if (!is_struct(item)
		|| !variable_struct_exists(item, "undo_patch"))
		{
			return false;
		}

		/* Remember whether the patch helper released a live surface before clearing the item's
		patch reference */
		var disposed = undo_patch_dispose(item.undo_patch);
		item.undo_patch = noone;
		return disposed;
	}

	/// @description Release and clear patch resources for every item in a supplied collection
	/// @param {Any} items History-item collection whose owned snapshot surfaces should be released
	/// @returns {Real} Number of live patch surfaces freed
	dispose_history_items_undo_patches = function(items)
	{
		/* A nonarray collection has no item patches to visit, so report zero releases */
		if (!is_array(items))
		{
			return 0;
		}

		/* Count successfully freed patch surfaces, starting before any resource has been
		disposed */
		var disposed_count = 0;

		/* Visit collection entries from index zero and clear each available item patch */
		for (var item_index = 0; item_index < array_length(items); item_index++)
		{
			/* Only a patch whose live surface was actually released increases the count.
			Missing or lost patches still leave their item references cleared by the helper */
			if (dispose_item_undo_patch(items[item_index]))
			{
				disposed_count++;
			}
		}

		return disposed_count;
	}

	/// @description Release patches retained by every redo group before discarding them
	/// @returns {Real} Total live patch surfaces freed
	dispose_redo_stack_undo_patches = function()
	{
		/* Count patch surfaces released across all redo groups, starting at zero */
		var disposed_count = 0;

		/* Visit each redo group from index zero and dispose its item-owned snapshots before
		the stack is cleared */
		for (var group_index = 0; group_index < array_length(redo_stack); group_index++)
		{
			disposed_count += dispose_history_items_undo_patches(redo_stack[group_index]);
		}

		return disposed_count;
	}

	/// @description Round and pad inclusive bounds outward while clamping them to the room
	/// @param {Real} raw_left First horizontal rectangle boundary in world pixels
	/// @param {Real} raw_top First vertical rectangle boundary in world pixels
	/// @param {Real} raw_right Opposite horizontal rectangle boundary in world pixels
	/// @param {Real} raw_bottom Opposite vertical rectangle boundary in world pixels
	/// @param {Real} raw_padding Nonnegative capture padding in pixels. Defaults to 0
	/// @returns {Any} Rectangle with world-pixel bounds and dimensions, or noone when inverted
	undo_patch_rect_make = function(raw_left, raw_top, raw_right, raw_bottom, raw_padding = 0)
	{
		/* room_w and room_h are positive room-pixel dimensions used to clamp the capture
		rectangle */
		var room_w = max(1, room_width);
		var room_h = max(1, room_height);

		/* Round requested padding outward to a nonnegative whole number of pixels */
		var rect_padding = max(0, ceil(real(raw_padding)));

		/* rect_left and rect_top round the lesser coordinates outward, apply padding, and
		clamp to the room's first pixel */
		var rect_left = clamp(floor(real(min(raw_left, raw_right))) - rect_padding, 0, room_w - 1);
		var rect_top = clamp(floor(real(min(raw_top, raw_bottom))) - rect_padding, 0, room_h - 1);

		/* rect_right and rect_bottom round the greater coordinates outward, apply padding, and
		clamp to the room's final inclusive pixel */
		var rect_right = clamp(ceil(real(max(raw_left, raw_right))) + rect_padding, 0, room_w - 1);
		var rect_bottom = clamp(ceil(real(max(raw_top, raw_bottom))) + rect_padding, 0, room_h - 1);

		/* An inverted clamped rectangle has no valid capture area, so return noone instead of
		creating a zero-size patch */
		if (rect_right < rect_left || rect_bottom < rect_top)
		{
			return noone;
		}

		/* Return inclusive world-pixel left/top/right/bottom bounds and their w/h pixel
		dimensions, counting both rectangle edges */
		return
		{
			left: rect_left,
			top: rect_top,
			right: rect_right,
			bottom: rect_bottom,
			w: rect_right - rect_left + 1,
			h: rect_bottom - rect_top + 1
		};
	}

	/// @description Estimate conservative world-pixel coverage for images and supported drawing geometry
	/// @param {Struct} item History item to classify, inspect, mutate, capture, or restore
	/// @returns {Any} Room-clamped inclusive affected rectangle, or noone without drawable geometry
	history_item_affected_rect = function(item)
	{
		/* A nonstruct item cannot supply image or command geometry, so return no affected
		rectangle */
		if (!is_struct(item))
		{
			return noone;
		}

		/* Image records use their placed rectangle, independent of their original PNG source
		dimensions */
		if (history_item_is_image(item))
		{
			/* image_left and image_top are floored world-pixel placement origins */
			var image_left = floor(real(item.x));
			var image_top = floor(real(item.y));

			/* image_w and image_h round placed dimensions outward with at least one pixel,
			preserving conservative capture coverage */
			var image_w = max(1, ceil(real(item.w)));
			var image_h = max(1, ceil(real(item.h)));
			return undo_patch_rect_make(image_left, image_top, image_left + image_w - 1, image_top + image_h - 1, 0);
		}

		/* A nonimage record without a tool ID has no drawable geometry to bound here */
		if (!variable_struct_exists(item, "tool_id"))
		{
			return noone;
		}

		/* Round the world-pixel brush diameter outward and keep it positive when estimating
		affected coverage */
		var brush_px_value = max(1, ceil(real(command_brush_px(item))));

		/* Capture half the brush width plus four extra pixels around ordinary strokes so edge
		coverage is included */
		var brush_padding = ceil(brush_px_value * 0.5) + 4;

		/* Choose conservative bounds by tool geometry. Fill and selection use their
		rectangles, text uses measured display size, circles distinguish ellipse and radius
		modes, and ordinary tools use padded endpoints */
		switch (item.tool_id)
		{
			/* Fill sampling uses its endpoint and extension corner, with one extra pixel
			around those bounds */
			case DRAW_TOOL_FILL:
				return undo_patch_rect_make(item.to_x, item.to_y, command_extra_a(item), command_extra_b(item), 1);

			/* Selection-clear commands use their two rectangle corners, padded by two pixels
			for capture coverage */
			case DRAW_TOOL_SELECT:
				return undo_patch_rect_make(item.from_x, item.from_y, item.to_x, item.to_y, 2);

			/* Text bounds use the rendered text size rather than just the pointer endpoints */
			case DRAW_TOOL_TEXT:
			{
				/* Use three times brush width for text height with a minimum of twelve world
				pixels, matching text rendering */
				var text_height = max(12, real(command_brush_px(item)) * 3);

				/* Get the font scale corresponding to that world-pixel text height */
				var text_scale = scr_render_text_scale(text_height);

				/* Measure display text width and apply its drawing scale for the capture
				rectangle */
				var text_width = scr_render_text_measure_width(command_text_value(item)) * text_scale;

				/* Text rendering limits width to 420 world pixels, so the capture estimate
				uses the same ceiling */
				if (text_width > 420)
				{
					text_width = 420;
				}
				return undo_patch_rect_make(item.from_x, item.from_y, item.from_x + max(1, ceil(text_width)), item.from_y + ceil(text_height) + 4, 6);
			}

			/* Circle commands may encode a dragged ellipse or a center-to-edge radius, which
			require different rectangles */
			case DRAW_TOOL_CIRCLE:
			{
				/* A nonzero extra_a selects endpoint-bounded ellipse mode. Zero selects a
				center and radius below */
				if (command_extra_a(item) != 0)
				{
					return undo_patch_rect_make(item.from_x, item.from_y, item.to_x, item.to_y, brush_padding);
				}

				/* Measure the world-pixel radius from the center start point to the endpoint
				before bounding the circle on both axes */
				var circle_radius = point_distance(item.from_x, item.from_y, item.to_x, item.to_y);
				return undo_patch_rect_make(item.from_x - circle_radius, item.from_y - circle_radius, item.from_x + circle_radius, item.from_y + circle_radius, brush_padding);
			}

			/* Other drawable tools use the endpoint rectangle plus brush coverage padding */
			default:
				return undo_patch_rect_make(item.from_x, item.from_y, item.to_x, item.to_y, brush_padding);
		}
	}

	/// @description Require complete patch geometry and a live positive-size snapshot surface
	/// @param {Any} patch Owned snapshot struct whose optional surface may be missing or lost
	/// @returns {Bool} Whether the captured patch is usable
	undo_patch_is_valid = function(patch)
	{
		/* A usable patch needs geometry fields, a stable layer target, positive dimensions,
		and a live surface. Check its shape first so missing members cannot be read */
		return is_struct(patch)
			&& variable_struct_exists(patch, "layer_id")
			&& variable_struct_exists(patch, "left")
			&& variable_struct_exists(patch, "top")
			&& variable_struct_exists(patch, "w")
			&& variable_struct_exists(patch, "h")
			&& variable_struct_exists(patch, "surface")
			&& patch.w > 0
			&& patch.h > 0
			&& surface_exists(patch.surface);
	}

	/// @description Validate an item's optional owned pre-command snapshot
	/// @param {Struct} item History item to classify, inspect, mutate, capture, or restore
	/// @returns {Bool} Whether a complete live patch exists
	history_item_has_valid_undo_patch = function(item)
	{
		/* Only an item with an undo_patch member can pass patch validation. Missing snapshots
		return false for replay fallback */
		return is_struct(item)
			&& variable_struct_exists(item, "undo_patch")
			&& undo_patch_is_valid(item.undo_patch);
	}

	/// @description Compare two inclusive rectangles on both axes for undo safety
	/// @param {Real} left_a First rectangle's inclusive left world-pixel boundary
	/// @param {Real} top_a First rectangle's inclusive top world-pixel boundary
	/// @param {Real} right_a First rectangle's inclusive right world-pixel boundary
	/// @param {Real} bottom_a First rectangle's inclusive bottom world-pixel boundary
	/// @param {Real} left_b Second rectangle's inclusive left world-pixel boundary
	/// @param {Real} top_b Second rectangle's inclusive top world-pixel boundary
	/// @param {Real} right_b Second rectangle's inclusive right world-pixel boundary
	/// @param {Real} bottom_b Second rectangle's inclusive bottom world-pixel boundary
	/// @returns {Bool} Whether any covered pixels overlap
	undo_patch_rects_overlap = function(left_a, top_a, right_a, bottom_a, left_b, top_b, right_b, bottom_b)
	{
		/* Inclusive rectangles overlap only when their x and y intervals both intersect.
		Touching inclusive edges count as overlap so restoring a patch does not overwrite
		later edge pixels */
		return left_a <= right_b
			&& right_a >= left_b
			&& top_a <= bottom_b
			&& bottom_a >= top_b;
	}

	/// @description Check valid same-layer removed patches against one later visible drawable item
	/// @param {Array} undo_group Chronologically ordered drawable records removed together
	/// @param {Struct} item History item to classify, inspect, mutate, capture, or restore
	/// @returns {Bool} Whether a known rectangle overlaps, false when bounds are unavailable
	undo_group_patch_overlaps_item = function(undo_group, item)
	{
		/* Only drawable, locally visible structured items can conflict with an undo-group
		patch. Invalid groups, structural records, and blocked drawing return no overlap */
		if (!is_array(undo_group)
		|| !is_struct(item)
		|| history_item_is_layer(item)
		|| history_item_is_undo(item)
		|| history_item_is_blocked(item))
		{
			return false;
		}

		/* Resolve the later item's stable target layer before comparing any captured pixels */
		var item_layer_id = history_item_layer_id(item);

		/* An item without a drawable target cannot overlap a layer patch in this test */
		if (item_layer_id == noone)
		{
			return false;
		}

		/* Estimate the later item's conservative affected rectangle for patch safety */
		var item_rect = history_item_affected_rect(item);

		/* Unavailable bounds cannot prove overlap here and return false. The higher-level
		safety scan treats missing bounds as a separate fallback reason */
		if (!is_struct(item_rect))
		{
			return false;
		}

		/* Check group entries from index zero until a valid same-layer overlapping patch is
		found */
		for (var group_index = 0; group_index < array_length(undo_group); group_index++)
		{
			/* Borrow this removed group item to inspect its owned undo snapshot */
			var group_item = undo_group[group_index];

			/* An unavailable or lost patch cannot supply overlap geometry and is skipped here */
			if (!history_item_has_valid_undo_patch(group_item))
			{
				continue;
			}

			/* Borrow the validated patch's layer and captured bounds */
			var patch = group_item.undo_patch;

			/* Patches on other layers cannot overwrite this later item and are skipped */
			if (patch.layer_id != item_layer_id)
			{
				continue;
			}

			/* If the same-layer captured rectangle intersects the later item's bounds, patch
			restoration could erase later drawing, so report overlap immediately */
			if (undo_patch_rects_overlap(
				patch.left,
				patch.top,
				patch.left + patch.w - 1,
				patch.top + patch.h - 1,
				item_rect.left,
				item_rect.top,
				item_rect.right,
				item_rect.bottom
			))
			{
				return true;
			}
		}

		/* No valid same-layer patch intersected the later item */
		return false;
	}

	/// @description Find later history dependencies that prevent safe patch-only undo
	/// @param {Array} undo_group Chronologically ordered drawable records removed together
	/// @param {Real} earliest_removed_index Earliest zero-based position removed from client history, used for later dependency checks
	/// @returns {String} Specific fallback reason, or empty text when no conflict is found
	undo_group_later_overlap_reason = function(undo_group, earliest_removed_index)
	{
		/* Clamp the earliest removed history position into the remaining client history before
		scanning later dependencies */
		var first_index = clamp(floor(real(earliest_removed_index)), 0, array_length(client_history));

		/* Inspect later history indexes in replay order, stopping when any unsafe restore
		dependency is found */
		for (var history_index = first_index; history_index < array_length(client_history); history_index++)
		{
			/* Borrow this later history item for structural, visibility, and bounds checks */
			var item = client_history[history_index];

			/* A later structural operation may change layer identity or ordering, so
			patch-only restoration requires broader replay */
			if (history_item_is_layer(item))
			{
				return "later layer operation";
			}

			/* Nonstruct values, undo markers, and locally blocked drawing contribute no
			visible later drawable dependency and are skipped */
			if (!is_struct(item)
			|| history_item_is_undo(item)
			|| history_item_is_blocked(item))
			{
				continue;
			}

			/* A record without a drawable target cannot conflict with the removed group's
			layer snapshots */
			if (history_item_layer_id(item) == noone)
			{
				continue;
			}

			/* Unknown affected bounds cannot prove safe restoration, so return the explicit
			unavailable-bounds fallback reason */
			if (!is_struct(history_item_affected_rect(item)))
			{
				return "later item bounds unavailable";
			}

			/* An overlapping later item requires replay rather than patch copying, preserving
			drawing added after the removed group */
			if (undo_group_patch_overlaps_item(undo_group, item))
			{
				return "later overlapping item";
			}
		}

		/* No later structural, unknown-bound, or overlapping item prevents patch restoration */
		return "";
	}

	/// @description Capture a drawable item's affected pixels before application into an item-owned surface
	/// @param {Struct} item History item to classify, inspect, mutate, capture, or restore
	/// @param {Real} layer_index Zero-based stored client layer index
	/// @returns {Bool} Whether a live patch was attached
	capture_undo_patch_for_item = function(item, layer_index)
	{
		/* Capture only when enabled, the item is undoable, the layer index is known and in
		range, and its surface can be ensured. Missing any requirement leaves the item
		without a new patch */
		if (undo_patch_capture_suspended
		|| !history_item_is_undoable_command(item)
		|| layer_index == noone
		|| layer_index < 0
		|| layer_index >= array_length(layers)
		|| !ensure_layer_surface(layer_index))
		{
			return false;
		}

		/* Borrow the current target-layer surface as the source of pre-command pixels */
		var source_surface = layers[layer_index].surface;

		/* A source surface lost after setup cannot supply an undo snapshot, so skip capture */
		if (!surface_exists(source_surface))
		{
			return false;
		}

		/* Calculate the command's conservative affected rectangle before allocating its
		pre-command snapshot */
		var patch_rect = history_item_affected_rect(item);

		/* Unavailable bounds cannot define a trustworthy capture area, so record the skipped
		capture and return false */
		if (!is_struct(patch_rect))
		{
			debug_note("undo patch skipped", "bounds unavailable");
			return false;
		}

		dispose_item_undo_patch(item);

		/* Own a new patch surface sized to the affected rectangle after disposing any older
		patch on the same item */
		var patch_surface = surface_create(patch_rect.w, patch_rect.h);

		/* A failed patch allocation leaves capture unavailable and reports false instead of
		targeting a nonexistent surface */
		if (!surface_exists(patch_surface))
		{
			debug_note("undo patch skipped", "surface " + string(patch_rect.w) + "x" + string(patch_rect.h));
			return false;
		}

		surface_set_target(patch_surface);
		draw_clear_alpha(c_black, 0);
		surface_reset_target();
		surface_copy_part(patch_surface, 0, 0, source_surface, patch_rect.left, patch_rect.top, patch_rect.w, patch_rect.h);

		/* Attach the owned pre-command surface with its stable layer_id, world-pixel left/top
		origin, and w/h dimensions. Item disposal or discarded history later releases this
		surface */
		item.undo_patch =
		{
			layer_id: layers[layer_index].id,
			left: patch_rect.left,
			top: patch_rect.top,
			w: patch_rect.w,
			h: patch_rect.h,
			surface: patch_surface
		};
		return true;
	}

	/// @description Validate every removed snapshot and ensure its target surface is available
	/// @param {Array} undo_group Chronologically ordered drawable records removed together
	/// @returns {String} Specific missing-resource reason, or empty text
	undo_group_patch_missing_reason = function(undo_group)
	{
		/* An absent or empty removed group has no snapshots to restore and gets an explicit
		missing-group reason */
		if (!is_array(undo_group) || array_length(undo_group) <= 0)
		{
			return "empty undo group";
		}

		/* Check every removed item from index zero before attempting restoration, so missing
		resources trigger replay fallback first */
		for (var group_index = 0; group_index < array_length(undo_group); group_index++)
		{
			/* Borrow this removed item to inspect its captured surface and target layer */
			var item = undo_group[group_index];

			/* A malformed or lost patch reports its one-based item number for diagnostics
			instead of attempting restoration */
			if (!history_item_has_valid_undo_patch(item))
			{
				return "missing patch at item " + string(group_index + 1);
			}

			/* Borrow the validated patch to resolve its original stable layer target */
			var patch = item.undo_patch;

			/* Translate the patch's stable layer ID into the current stack index */
			var layer_index = layer_index_from_id(patch.layer_id);

			/* A removed patch target cannot accept its old pixels and requires a replay
			fallback */
			if (layer_index == noone)
			{
				return "patch layer missing";
			}

			/* An unavailable target surface prevents restoration even though the patch itself
			still exists */
			if (!ensure_layer_surface(layer_index))
			{
				return "patch layer surface unavailable";
			}
		}

		/* Every patch and its target layer passed the availability check, so there is no
		missing-patch reason */
		return "";
	}

	/// @description Clear and redraw one captured region, restoring texture filtering and marking the composite dirty
	/// @param {Struct} item History item to classify, inspect, mutate, capture, or restore
	/// @returns {Bool} Whether the patch drawing path completed
	restore_undo_patch_item = function(item)
	{
		/* An item without a complete live patch cannot restore its pre-command pixels, so
		return false */
		if (!history_item_has_valid_undo_patch(item))
		{
			return false;
		}

		/* Borrow the validated patch while its owning item retains responsibility for
		releasing the surface */
		var patch = item.undo_patch;

		/* Resolve the patch's stable target into the current client stack */
		var layer_index = layer_index_from_id(patch.layer_id);

		/* A missing target or failed surface setup prevents restoration before any drawing
		state changes */
		if (layer_index == noone || !ensure_layer_surface(layer_index))
		{
			return false;
		}

		/* Borrow the target layer's owned surface to receive the pre-command snapshot */
		var target_surface = layers[layer_index].surface;

		/* A lost target surface cannot receive the snapshot and returns false */
		if (!surface_exists(target_surface))
		{
			return false;
		}

		/* Remember the caller's texture filtering so pixel restoration can disable
		interpolation temporarily and restore that setting afterward */
		var restore_filter = gpu_get_texfilter();
		gpu_set_texfilter(false);
		surface_set_target(target_surface);
		draw_set_alpha(1);

		/* Clear the patch-covered destination with zero blending before drawing the saved
		patch through normal blending. This removes current pixels in that region without
		clearing the whole layer */
		gpu_set_blendmode_ext(bm_zero, bm_zero);
		draw_surface(patch.surface, patch.left, patch.top);
		gpu_set_blendmode(bm_normal);
		draw_surface(patch.surface, patch.left, patch.top);
		surface_reset_target();
		gpu_set_texfilter(restore_filter);
		gpu_set_blendmode(bm_normal);
		draw_set_alpha(1);
		layer_composite_dirty = true;
		return true;
	}

	/// @description Restore valid nonconflicting snapshots in reverse command order with optional redo retention
	/// @param {Array} removed_group Removed drawable history items retaining their owned snapshots
	/// @param {Bool} keep_patches Whether the removed group retains restored snapshots for redo ownership. Defaults to false
	/// @param {Real} earliest_removed_index Earliest zero-based position removed from client history, used for later dependency checks. Defaults to 0
	/// @returns {Bool} Whether every patch restored, false to request replay fallback
	restore_undo_group_from_patches = function(removed_group, keep_patches = false, earliest_removed_index = 0)
	{
		/* Check all removed-group snapshots and target surfaces before attempting the
		patch-only shortcut */
		var missing_reason = undo_group_patch_missing_reason(removed_group);

		/* A specific missing-resource reason rejects this shortcut and lets the caller choose
		replay */
		if (missing_reason != "")
		{
			debug_note("undo patch missing", missing_reason);
			return false;
		}

		/* Check remaining later history for structural changes, unknown bounds, and
		overlapping drawing before copying pre-command pixels */
		var overlap_reason = undo_group_later_overlap_reason(removed_group, earliest_removed_index);

		/* Any later unsafe dependency rejects the shortcut so old snapshots cannot erase newer
		content */
		if (overlap_reason != "")
		{
			debug_note("undo patch unsafe", overlap_reason);
			return false;
		}

		/* restore_rebuild_active and restore_capture_suspended preserve the caller's
		reconstruction and snapshot-capture flags while patches are applied */
		var restore_rebuild_active = layer_surface_rebuild_active;
		var restore_capture_suspended = undo_patch_capture_suspended;
		layer_surface_rebuild_active = true;
		undo_patch_capture_suspended = true;

		/* Assume restoration succeeds, then retain the first failed patch result for replay
		fallback */
		var restored = true;

		/* Restore group entries from last to first so overlapping snapshots unwind the
		original command order */
		for (var group_index = array_length(removed_group) - 1; group_index >= 0; group_index--)
		{
			/* Stop on the first failed patch copy and report failure after restoring the
			caller's flags. Already copied patches are not rolled back here */
			if (!restore_undo_patch_item(removed_group[group_index]))
			{
				restored = false;
				break;
			}
		}
		layer_surface_rebuild_active = restore_rebuild_active;
		undo_patch_capture_suspended = restore_capture_suspended;

		/* A failed copy cannot claim a complete undo shortcut, so leave completion to the
		caller's replay fallback */
		if (!restored)
		{
			debug_note("undo patch missing", "restore failed");
			return false;
		}

		composite_layers();
		debug_note("undo patch restore", "commands=" + string(array_length(removed_group)));

		/* Release restored item patches unless keep_patches retains them for redo ownership.
		Retained patches stay owned by the removed group */
		if (!keep_patches)
		{
			dispose_history_items_undo_patches(removed_group);
		}
		return true;
	}

	/// @description Bound synchronous fill advances and abort work that remains after the guard
	/// @returns {Bool} Whether no fill remains after completion attempts
	finish_replay_fill_if_needed = function()
	{
		/* No active fill needs synchronous completion, so report ready without changing its
		budget */
		if (!fill_job_active())
		{
			return true;
		}

		/* Save the normal per-Step span budget before temporarily allowing a larger
		synchronous replay budget */
		var restore_span_budget = fill_spans_per_step;
		fill_spans_per_step = max(fill_spans_per_step, max_fill_pixels);

		/* Count synchronous advances from zero to prevent a fill that never finishes from
		looping indefinitely */
		var guard = 0;

		/* Continue while fill work remains and fewer than 1024 advances have run. Finishing
		the fill or exhausting the guard ends this bounded synchronous loop */
		while (fill_job_active() && guard < 1024)
		{
			advance_progressive_fill_job(max_fill_pixels, max_fill_queue);
			guard++;
		}
		fill_spans_per_step = restore_span_budget;

		/* A fill still active after the guard is aborted and counted as an application
		failure. A completed fill reports success below */
		if (fill_job_active())
		{
			fill_abort_runtime();
			debug_apply_failures++;
			debug_note("undo replay fill failed", "synchronous fill did not finish");
			return false;
		}

		return true;
	}

	/// @description Clear and replay one target while retaining selection, local visibility, and caller replay flags
	/// @param {Real} target_layer_id Stable drawable layer identifier
	/// @returns {Bool} Whether fill work finished and no asynchronous image draw remains
	rebuild_client_layer_from_history = function(target_layer_id)
	{
		/* A missing flattened canvas cannot support this layer reconstruction, so stop when
		surface setup fails */
		if (!ensure_surface())
		{
			return false;
		}

		/* Resolve the target's stable layer ID before clearing and replaying it */
		var layer_index = layer_index_from_id(target_layer_id);

		/* A removed target has no surface to rebuild, so return false */
		if (layer_index == noone)
		{
			return false;
		}

		fill_abort_runtime();
		delete_pending_image_draws();

		/* Preserve the selected stable layer ID while replay may select command targets */
		var active_layer_snapshot = active_layer_id;

		/* Capture local visibility choices independently of history so reconstruction can
		restore them afterward */
		var visibility_snapshot = layer_visibility_snapshot();

		/* restore_rebuild_active, restore_capture_suspended, and
		restore_force_synchronous_replay retain the caller's three replay flags before the
		temporary rebuild mode */
		var restore_rebuild_active = layer_surface_rebuild_active;
		var restore_capture_suspended = undo_patch_capture_suspended;
		var restore_force_synchronous_replay = fill_force_synchronous_replay;
		layer_surface_rebuild_active = true;
		undo_patch_capture_suspended = true;
		fill_force_synchronous_replay = true;
		clear_layer_surface(layer_index);

		/* Visit client history from index zero in chronological order, applying only the
		requested layer's drawable records */
		for (var history_index = 0; history_index < array_length(client_history); history_index++)
		{
			/* Borrow the current ordered history item for target filtering */
			var item = client_history[history_index];

			/* Only records targeting this stable layer replay into it. Other layers and
			structural records are omitted from this isolated rebuild */
			if (history_item_targets_layer(item, target_layer_id))
			{
				apply_history_item_to_surface(item);
			}
		}

		/* The layer rebuild is complete only when progressive fill can finish and no
		asynchronous image draws remain. Deferred work prevents claiming a synchronous
		reconstruction */
		var layer_replay_complete = finish_replay_fill_if_needed()
			&& array_length(pending_image_draws) <= 0;
		layer_surface_rebuild_active = restore_rebuild_active;
		undo_patch_capture_suspended = restore_capture_suspended;
		fill_force_synchronous_replay = restore_force_synchronous_replay;
		restore_layer_visibility_snapshot(visibility_snapshot);
		restore_active_layer_id(active_layer_snapshot);

		/* Remaining fill or image work makes this isolated replay incomplete, so return false
		after restoring the caller's state and preferences */
		if (!layer_replay_complete)
		{
			debug_note("undo atomic layer replay failed", "deferred work remained");
			return false;
		}
		composite_layers();
		debug_note("undo atomic layer replay", "layer " + string(target_layer_id) + " history=" + string(array_length(client_history)));
		return true;
	}

	/// @description Try safe patches, isolated-layer replay, then full history replay for removed drawing
	/// @param {Array} removed_group Removed drawable history items retaining their owned snapshots
	/// @param {Real} earliest_removed_index Earliest zero-based position removed from client history, used for later dependency checks
	/// @param {Bool} keep_removed_patches Whether the removed group retains snapshots instead of releasing them after replay. Defaults to false
	/// @returns {Bool} Restoration or replay result
	rebuild_client_history_after_undo = function(removed_group, earliest_removed_index, keep_removed_patches = false)
	{
		/* Valid nonoverlapping pre-command patches are the fastest undo path. Successful
		restoration ends here without reconstructing history */
		if (restore_undo_group_from_patches(removed_group, keep_removed_patches, earliest_removed_index))
		{
			return true;
		}

		/* Resolve whether the removed group belongs entirely to one drawable layer for the
		isolated replay fallback */
		var target_layer_id = undo_group_single_layer_id(removed_group);

		/* Start without a fallback reason, filling it with whichever constraint first prevents
		one-layer reconstruction */
		var fallback_reason = "";

		/* An unavailable single target, including a multilayer group, requires full history
		replay rather than selecting one layer */
		if (target_layer_id == noone)
		{
			fallback_reason = "undo group spans multiple layers";
		}

		/* With a single target established, any pending image load prevents the isolated
		synchronous rebuild */
		else if (array_length(pending_image_draws) > 0)
		{
			fallback_reason = "image load pending";
		}

		/* Later layer operations can change replay structure, so require the full stack
		reconstruction instead of one-layer replay */
		else if (history_range_has_layer_item(earliest_removed_index))
		{
			fallback_reason = "later layer operation";
		}

		/* A visible-layer fill depends on other layers' pixels, requiring the broader
		reconstruction to keep its sampled context */
		else if (history_layer_has_visible_fill_command(target_layer_id))
		{
			fallback_reason = "visible-layer fill dependency";
		}

		/* If none of those dependencies block isolated replay, rebuild the one target layer.
		Success avoids full-stack work */
		else if (rebuild_client_layer_from_history(target_layer_id))
		{
			/* After a successful isolated rebuild, release removed patches unless the caller
			keeps them for redo */
			if (!keep_removed_patches)
			{
				dispose_history_items_undo_patches(removed_group);
			}
			return true;
		}

		/* A failed isolated layer rebuild records that reason and falls through to complete
		client-history replay */
		else
		{
			fallback_reason = "layer replay failed";
		}

		debug_note("undo atomic full replay", fallback_reason);

		/* Retain the full replay result after reporting why the faster restoration paths could
		not be used */
		var replayed = replay_client_history();

		/* Release removed patches after the full replay attempt unless redo ownership requires
		retaining them */
		if (!keep_removed_patches)
		{
			dispose_history_items_undo_patches(removed_group);
		}
		return replayed;
	}

	/// @description Reuse or rebuild the last local-author undo lookup for the current history revision
	/// @returns {Real} Latest local undo group ID, or zero
	find_last_local_undo_id = function()
	{
		/* A lookup cache matching both history revision and local author can be returned
		directly. Changed history or attribution requires a fresh backward scan */
		if (undo_lookup_revision == client_history_revision && undo_lookup_author == local_undo_author_id)
		{
			return undo_lookup_id;
		}
		undo_lookup_revision = client_history_revision;
		undo_lookup_author = local_undo_author_id;
		undo_lookup_id = 0;

		/* Search history from its final index toward zero so the first matching local group is
		the most recent one */
		for (var i = array_length(client_history) - 1; i >= 0; i--)
		{
			/* Borrow the current record while checking its author and undoability */
			var item = client_history[i];

			/* Only drawable records with a positive group and the current local author can
			supply the last local undo ID */
			if (history_item_is_undoable_command(item)
			&& command_undo_author_id(item) == local_undo_author_id)
			{
				undo_lookup_id = command_undo_id(item);
				return undo_lookup_id;
			}
		}

		/* No undoable local group exists, so cache and return zero */
		return 0;
	}

	/// @description Remove one author/group from client history and optionally rebuild affected pixels
	/// @param {Real} undo_author_id Connection-specific drawing author ID
	/// @param {Real} undo_id Stroke-group ID within that author
	/// @param {Bool} replay_after Whether actual removal should rebuild client pixels, true by default
	/// @param {Bool} keep_removed_patches Whether the removed group retains snapshots instead of releasing them after replay. Defaults to false
	/// @returns {Array} Removed items in chronological order, with patch ownership controlled by the caller
	remove_client_undo_group = function(undo_author_id, undo_id, replay_after = true, keep_removed_patches = false)
	{
		/* Collect removed items in original chronological order, initially empty until a
		matching group is found */
		var removed_group = [];

		/* Begin the earliest-removal position at the history end, then replace it as earlier
		matches are removed */
		var earliest_removed_index = array_length(client_history);

		/* Visit client history backward from its last index so deletion cannot shift an
		unchecked item past the cursor */
		for (var i = array_length(client_history) - 1; i >= 0; i--)
		{
			/* Borrow this history record to compare its connection author and group IDs */
			var item = client_history[i];

			/* Remove only the requested author-and-group pair, preserving other players'
			same-numbered groups and all nonmatching history */
			if (history_item_matches_undo_group(item, undo_author_id, undo_id))
			{
				array_insert(removed_group, 0, item);
				array_delete(client_history, i, 1);
				client_history_revision++;
				client_history_replay_restart = true;
				earliest_removed_index = i;
			}
		}

		/* Rebuild surfaces only when at least one item was removed and replay_after requests
		it. Otherwise return the removed collection without replay */
		if (array_length(removed_group) > 0 && replay_after)
		{
			rebuild_client_history_after_undo(removed_group, earliest_removed_index, keep_removed_patches);
		}

		return removed_group;
	}

	/// @description Remove authoritative group records, rebuild metadata, dirty saves, and invalidate affected content votes
	/// @param {Real} undo_author_id Connection-specific drawing author ID
	/// @param {Real} undo_id Stroke-group ID within that author
	/// @returns {Real} Number of removed history items
	remove_server_undo_group = function(undo_author_id, undo_id)
	{
		/* Count removed authoritative items from zero so persistence is dirtied only for an
		actual history change */
		var removed_count = 0;

		/* Track whether removal changes the target of an archive or restore proposal,
		initially false */
		var changed_vote_target = false;

		/* Visit authoritative history backward so deletions preserve all remaining unchecked
		indexes */
		for (var i = array_length(server_history) - 1; i >= 0; i--)
		{
			/* Only records matching the requested connection author and stroke group are
			removed */
			if (history_item_matches_undo_group(server_history[i], undo_author_id, undo_id))
			{
				/* Removing drawable content from an active archive or restore target
				invalidates that proposal. Move proposals depend on stack order and are left
				alone */
				if (is_struct(server_active_layer_vote)
				&& history_item_layer_id(server_history[i]) == server_active_layer_vote.item.layer_id
				&& server_active_layer_vote.action != LAYER_VOTE_ACTION_MOVE)
				{
					changed_vote_target = true;
				}
				array_delete(server_history, i, 1);
				removed_count++;
			}
		}

		/* Only actual removals rebuild layer metadata and dirty the checkpoint/save state. A
		missing group leaves those systems unchanged */
		if (removed_count > 0)
		{
			server_rebuild_layer_state_from_history();
			server_history_checkpoint_dirty = true;
			mark_server_history_persistence_dirty();

			/* Cancel the current proposal only when one of its content-bearing target records
			was removed */
			if (changed_vote_target)
			{
				server_finish_active_layer_vote(LAYER_VOTE_RESULT_CANCELLED, "The layer changed while voting. Nothing changed; request the vote again when drawing pauses.");
			}
		}

		return removed_count;
	}

	/// @description Locate a recorded connection-author ownership mapping
	/// @param {Real} undo_author_id Connection-specific drawing author ID
	/// @returns {Real} Mapping-array index, or noone
	server_undo_author_slot_index = function(undo_author_id)
	{
		/* Search connection-author mappings from index zero until the requested author ID is
		found or all mappings are checked */
		for (var i = 0; i < array_length(server_undo_author_slots); i++)
		{
			/* A matching author ID returns its current mapping index for ownership checks */
			if (server_undo_author_slots[i].undo_author_id == undo_author_id)
			{
				return i;
			}
		}

		/* An unrecorded author ID has no owned slot/socket mapping and returns noone */
		return noone;
	}

	/// @description Read an available current author assignment for a player slot
	/// @param {Real} slot Zero-based authoritative player slot
	/// @returns {Real} Nonnegative assigned author ID, or zero
	server_expected_undo_author_id = function(slot)
	{
		/* Read the host's connection-specific drawing-author array for this player slot */
		var server = scr_get_server();

		/* Unavailable host author storage or an unknown/out-of-range slot has no expected
		author and returns zero. Validate the array before reading its length and entry */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "slot_drawing_author_ids")
		|| !is_array(server.slot_drawing_author_ids)
		|| slot == noone
		|| slot < 0
		|| slot >= array_length(server.slot_drawing_author_ids))
		{
			return 0;
		}

		return max(0, floor(real(server.slot_drawing_author_ids[slot])));
	}

	/// @description Remove malformed and matching slot/socket author mappings during disconnect cleanup
	/// @param {Real} slot Zero-based authoritative player slot
	/// @param {Real} socket_value Current connection socket handle, noone disabling socket matching in cleanup. Defaults to noone
	/// @returns {Real} Number of mapping entries removed
	server_clear_undo_authors_for_slot = function(slot, socket_value = noone)
	{
		/* Count removed author mappings, starting before any slot cleanup */
		var removed_count = 0;

		/* Visit mappings backward so deleting a matching or malformed entry does not skip
		another unchecked mapping */
		for (var author_index = array_length(server_undo_author_slots) - 1; author_index >= 0; author_index--)
		{
			/* Borrow this mapping to inspect optional slot and socket identity */
			var entry = server_undo_author_slots[author_index];

			/* Remove malformed nonstruct entries as part of cleanup because they cannot
			establish usable author ownership */
			if (!is_struct(entry))
			{
				array_delete(server_undo_author_slots, author_index, 1);
				removed_count++;
				continue;
			}

			/* same_slot is true only for a mapping with the requested player-slot field */
			var same_slot = variable_struct_exists(entry, "slot") && entry.slot == slot;

			/* same_socket requires a supplied non-noone socket and a matching socket field. An
			omitted socket leaves this second cleanup route disabled */
			var same_socket = socket_value != noone
				&& variable_struct_exists(entry, "socket")
				&& entry.socket == socket_value;

			/* Either the player slot or specified socket identifies a mapping to release, so
			remove it. Unrelated mappings remain intact */
			if (same_slot || same_socket)
			{
				array_delete(server_undo_author_slots, author_index, 1);
				removed_count++;
			}
		}

		/* Log author cleanup only after at least one mapping was removed, avoiding a
		misleading change note for an empty result */
		if (removed_count > 0)
		{
			debug_note("server cleared undo authors", server_slot_label(slot) + " removed=" + string(removed_count));
		}

		return removed_count;
	}

	/// @description Verify an assigned author and establish or check its slot/socket owner for drawable history
	/// @param {Struct} item History item to classify, inspect, mutate, capture, or restore
	/// @param {Real} slot Zero-based authoritative player slot
	/// @param {Real} socket_value Current connection socket handle, noone disabling socket matching in cleanup
	/// @returns {Bool} Whether the item needs no mapping or matches an accepted connection owner
	server_note_undo_author_slot = function(item, slot, socket_value)
	{
		/* Items without a positive undoable author/group need no ownership mapping, so this
		helper accepts them without recording one */
		if (!history_item_is_undoable_command(item))
		{
			return true;
		}

		/* Read the item's requested connection-specific undo author */
		var undo_author_id = command_undo_author_id(item);

		/* Read the author's current server assignment for this player slot, with zero meaning
		no expected assignment is available */
		var expected_author_id = server_expected_undo_author_id(slot);

		/* A known expected author must match the submitted one. A mismatch rejects the item
		rather than attributing it to another connection */
		if (expected_author_id > 0 && undo_author_id != expected_author_id)
		{
			debug_last_invalid_command = "expected author " + string(expected_author_id) + " but received " + string(undo_author_id);
			return false;
		}

		/* Locate any previously recorded owner of this submitted author ID */
		var author_index = server_undo_author_slot_index(undo_author_id);

		/* A new author ID records this slot/socket ownership and succeeds. An existing ID must
		match the same connection below */
		if (author_index == noone)
		{
			/* The ownership entry stores undo_author_id with its current player slot and
			socket handle. Disconnect cleanup removes entries by either identity */
			server_undo_author_slots[array_length(server_undo_author_slots)] =
			{
				undo_author_id: undo_author_id,
				slot: slot,
				socket: socket_value
			};
			return true;
		}

		/* author_matches requires both the original slot and socket to agree, so reconnecting
		into the same slot cannot reuse an old mapping */
		var author_matches = server_undo_author_slots[author_index].slot == slot
			&& server_undo_author_slots[author_index].socket == socket_value;

		/* A mismatching stored owner supplies a specific rejection detail, while a matching
		connection keeps its mapping */
		if (!author_matches)
		{
			debug_last_invalid_command = "author owned by " + server_slot_label(server_undo_author_slots[author_index].slot);
		}

		return author_matches;
	}

	/// @description Apply authoritative slot and display-name attribution to mutable drawable or layer items
	/// @param {Struct} item History item to classify, inspect, mutate, capture, or restore
	/// @param {Real} slot Zero-based authoritative player slot
	/// @returns {Any} The supplied item, unchanged for nonstruct values and undo markers
	server_stamp_history_item_author = function(item, slot)
	{
		/* Nonstruct items and undo markers do not carry drawable author attribution here, so
		return them unchanged */
		if (!is_struct(item)
		|| history_item_is_undo(item))
		{
			return item;
		}

		/* Stamp authoritative player-slot and displayed-name fields onto this mutable history
		item so clients cannot choose another author's attribution */
		item.author_player_id = slot;
		item.author_name = server_slot_display_name(slot);
		return item;
	}

	/// @description Require the current author assignment and recorded slot/socket ownership to agree
	/// @param {Real} undo_author_id Connection-specific drawing author ID
	/// @param {Real} slot Zero-based authoritative player slot
	/// @param {Real} socket_value Current connection socket handle, noone disabling socket matching in cleanup
	/// @returns {Bool} Whether this connection can act on the requested author
	server_slot_can_use_undo_author = function(undo_author_id, slot, socket_value)
	{
		/* Read the server's current expected drawing author for this slot before trusting a
		stored mapping */
		var expected_author_id = server_expected_undo_author_id(slot);

		/* A known assigned author different from the requested one rejects access even if a
		stale mapping remains */
		if (expected_author_id > 0 && undo_author_id != expected_author_id)
		{
			debug_last_invalid_command = "expected author " + string(expected_author_id) + " but received " + string(undo_author_id);
			return false;
		}

		/* Resolve the submitted author ID's recorded ownership mapping */
		var author_index = server_undo_author_slot_index(undo_author_id);

		/* Access requires a recorded author plus matching slot and socket. A missing mapping
		returns false before any array access */
		return author_index != noone
			&& server_undo_author_slots[author_index].slot == slot
			&& server_undo_author_slots[author_index].socket == socket_value;
	}

	/// @description Require an undoable local group with no active fill and no wall-tool selection
	/// @returns {Bool} Whether local drawing undo is currently available
	can_undo_local_command = function()
	{
		/* Local undo is available only outside the wall tool, with no progressive fill
		running, and with a positive last local group. Any failed requirement keeps the
		action unavailable */
		return tool != DRAW_TOOL_WALL && !fill_job_active() && find_last_local_undo_id() > 0;
	}

	/// @description Require a retained redo group with no active fill and no wall-tool selection
	/// @returns {Bool} Whether local drawing redo is currently available
	can_redo_local_command = function()
	{
		/* Local redo is available only outside the wall tool, without active fill work, and
		with at least one retained redo group. Otherwise the action remains unavailable */
		return tool != DRAW_TOOL_WALL && !fill_job_active() && array_length(redo_stack) > 0;
	}

	/// @description Release redo-owned snapshot surfaces and discard every retained redo group
	/// @returns {Bool} True after cleanup
	clear_redo_stack = function()
	{
		dispose_redo_stack_undo_patches();
		redo_stack = [];
		return true;
	}
	#endregion /* Undo Patches and History Reconstruction END */

	#region /* Progressive Fill Work */
	/// @description Clear an existing flattened canvas to transparent and record its dimensions
	/// @returns {Bool} Whether the live surface was cleared
	clear_surface = function()
	{
		/* A missing flattened canvas cannot be cleared, so record the skipped operation and
		return false */
		if (!surface_exists(canvas_surface))
		{
			debug_surface_status = "clear skipped: no surface";
			return false;
		}

		surface_set_target(canvas_surface);
		draw_clear_alpha(c_black, 0);
		surface_reset_target();
		debug_surface_status = "cleared " + string(surface_get_width(canvas_surface)) + "x" + string(surface_get_height(canvas_surface));
		return true;
	}

	/// @description Discard active/deferred fill state and release the shared fill surface and byte buffers
	delete_fill_work_area = function()
	{
		fill_active_job = noone;
		fill_deferred_history_items = [];

		/* Release the fill-owned work surface only if it still exists, then clear its handle */
		if (surface_exists(fill_work_surface))
		{
			surface_free(fill_work_surface);
		}

		fill_work_surface = noone;

		/* Release the sampling byte buffer only while allocated, then clear its handle and
		tracked capacity */
		if (buffer_exists(fill_work_buffer))
		{
			buffer_delete(fill_work_buffer);
		}

		fill_work_buffer = noone;
		fill_work_buffer_size = 0;

		/* Release the replacement-mask buffer only while allocated, then reset its handle and
		capacity */
		if (buffer_exists(fill_mask_buffer))
		{
			buffer_delete(fill_mask_buffer);
		}

		fill_mask_buffer = noone;
		fill_mask_buffer_size = 0;
	}

	/// @description Delete owned pending image sprites and discard image replay barriers and their queues
	delete_pending_image_draws = function()
	{
		/* Visit all pending image-load entries from index zero before clearing their queue and
		deferred history */
		for (var pending_index = 0; pending_index < array_length(pending_image_draws); pending_index++)
		{
			/* Borrow the pending load entry to find the temporary sprite it owns */
			var pending = pending_image_draws[pending_index];

			/* Delete only structured pending entries with an existing image sprite. Missing or
			failed sprite allocations require no release */
			if (is_struct(pending)
			&& variable_struct_exists(pending, "sprite")
			&& image_sprite_exists(pending.sprite))
			{
				sprite_delete(pending.sprite);
			}
		}

		pending_image_draws = [];
		image_deferred_history_items = [];
	}

	/// @description Ensure a sampled rectangle surface and sufficiently large reusable RGBA buffers
	/// @param {Real} work_w Sampled rectangle width in pixels, normalized to a positive whole number
	/// @param {Real} work_h Sampled rectangle height in pixels, normalized to a positive whole number
	/// @returns {Bool} Whether every work resource is available at the requested dimensions
	ensure_fill_work_area = function(work_w, work_h)
	{
		work_w = max(1, floor(real(work_w)));
		work_h = max(1, floor(real(work_h)));

		/* Inspect a live reusable sampling surface before deciding whether its dimensions
		still match this fill */
		if (surface_exists(fill_work_surface))
		{
			/* A changed work rectangle requires freeing the old surface. Matching dimensions
			retain its allocation for reuse */
			if (surface_get_width(fill_work_surface) != work_w
			|| surface_get_height(fill_work_surface) != work_h)
			{
				surface_free(fill_work_surface);
				fill_work_surface = noone;
			}
		}

		/* Allocate the sampling surface only when absent or discarded for a size change */
		if (!surface_exists(fill_work_surface))
		{
			fill_work_surface = surface_create(work_w, work_h);

			/* A failed allocation leaves noone and rejects fill setup before targeting that
			surface */
			if (!surface_exists(fill_work_surface))
			{
				fill_work_surface = noone;
				return false;
			}
		}

		/* Each sampled pixel needs four RGBA bytes, so required_buffer_size covers the entire
		work rectangle */
		var required_buffer_size = work_w * work_h * 4;

		/* A missing or undersized sampling buffer must be replaced. A sufficiently large
		existing buffer is retained */
		if (!buffer_exists(fill_work_buffer)
		|| fill_work_buffer_size < required_buffer_size)
		{
			/* Delete the previous live sampling buffer before allocating its larger
			replacement */
			if (buffer_exists(fill_work_buffer))
			{
				buffer_delete(fill_work_buffer);
			}

			fill_work_buffer = buffer_create(required_buffer_size, buffer_fixed, 1);
			fill_work_buffer_size = required_buffer_size;

			/* Sampling-buffer allocation failure clears both handle and capacity and reports
			unavailable work */
			if (!buffer_exists(fill_work_buffer))
			{
				fill_work_buffer = noone;
				fill_work_buffer_size = 0;
				return false;
			}
		}

		/* The replacement mask needs the same RGBA byte capacity. Missing or smaller mask
		storage is replaced */
		if (!buffer_exists(fill_mask_buffer)
		|| fill_mask_buffer_size < required_buffer_size)
		{
			/* Delete a still-live old mask buffer before creating its replacement */
			if (buffer_exists(fill_mask_buffer))
			{
				buffer_delete(fill_mask_buffer);
			}

			fill_mask_buffer = buffer_create(required_buffer_size, buffer_fixed, 1);
			fill_mask_buffer_size = required_buffer_size;

			/* Mask allocation failure resets its handle and capacity and prevents starting the
			fill */
			if (!buffer_exists(fill_mask_buffer))
			{
				fill_mask_buffer = noone;
				fill_mask_buffer_size = 0;
				return false;
			}
		}

		return true;
	}

	/// @description Clear the reusable fill sample surface to transparent with normal draw blending
	/// @returns {Bool} Whether the surface exists and was cleared
	clear_fill_work_surface = function()
	{
		/* A missing work surface cannot be cleared to transparent, so return false before
		changing render targets */
		if (!surface_exists(fill_work_surface))
		{
			return false;
		}

		surface_set_target(fill_work_surface);
		gpu_set_blendmode(bm_normal);
		draw_set_alpha(1);
		draw_clear_alpha(c_black, 0);
		surface_reset_target();
		return true;
	}

	/* Visible-layer fill samples a clipped composite only for boundary detection.
	The final color still goes through fill_mask_buffer onto the target layer */
	/// @description Sample visible unarchived layers into a clipped composite for fill boundaries
	/// @param {Real} left World-pixel left edge of the clipped fill sample
	/// @param {Real} top World-pixel top edge of the clipped fill sample
	/// @returns {Bool} Whether all source surfaces were available and the sample was drawn
	draw_visible_layers_to_fill_work_surface = function(left, top)
	{
		/* Visible-layer boundary sampling needs a work surface to receive the clipped
		composite */
		if (!surface_exists(fill_work_surface))
		{
			return false;
		}

		/* All layer surfaces must be available before sampling their pixels. Allocation
		failure returns false rather than supplying an incomplete boundary image */
		if (!ensure_all_layer_surfaces())
		{
			return false;
		}

		/* Remember the caller's texture filtering while sampling exact layer pixels without
		interpolation */
		var restore_filter = gpu_get_texfilter();
		gpu_set_texfilter(false);
		surface_set_target(fill_work_surface);
		gpu_set_blendmode(bm_normal);
		draw_set_alpha(1);
		draw_clear_alpha(c_black, 0);

		/* Composite stored layers from index zero in their real stack order for fill boundary
		detection */
		for (var layer_index = 0; layer_index < array_length(layers); layer_index++)
		{
			/* Borrow this paint layer to inspect archive status, visibility, and its surface */
			var paint_layer = layers[layer_index];

			/* Only unarchived visible layers with live surfaces contribute to the boundary
			sample. Hidden, archived, or lost layers are omitted */
			if (!layer_is_archived(paint_layer)
			&& paint_layer.visible
			&& surface_exists(paint_layer.surface))
			{
				draw_surface(paint_layer.surface, -left, -top);
			}
		}
		surface_reset_target();
		gpu_set_texfilter(restore_filter);
		return true;
	}

	/// @description Match empty opacity or all four nonempty RGBA components within fill tolerances
	/// @param {Real} pixel Packed little-endian RGBA sample
	/// @param {Real} target_r Original seed red byte
	/// @param {Real} target_g Original seed green byte
	/// @param {Real} target_b Original seed blue byte
	/// @param {Real} target_a Original seed alpha byte
	/// @returns {Bool} Whether the packed sample belongs to the connected target region
	fill_pixel_matches_target = function(pixel, target_r, target_g, target_b, target_a)
	{
		/* Extract the sampled opacity byte from the packed little-endian RGBA pixel */
		var pixel_a = (pixel >> 24) & 255;

		/* A seed at or below the empty-alpha threshold matches other sufficiently empty pixels
		without considering their hidden RGB channels */
		if (target_a <= fill_empty_alpha_threshold)
		{
			/* Only pixels at or below the same empty-opacity boundary belong to an empty
			target region */
			return pixel_a <= fill_empty_alpha_threshold;
		}

		/* Nonempty target pixels need red, green, and blue differences within color tolerance
		and alpha difference within its own tolerance. All four checks must pass to connect
		the region */
		return abs((pixel & 255) - target_r) <= fill_colour_tolerance
			&& abs(((pixel >> 8) & 255) - target_g) <= fill_colour_tolerance
			&& abs(((pixel >> 16) & 255) - target_b) <= fill_colour_tolerance
			&& abs(pixel_a - target_a) <= fill_alpha_tolerance;
	}

	/// @description Check whether shared progressive fill job state exists
	/// @returns {Bool} Whether fill_active_job is a struct
	fill_job_active = function()
	{
		/* A structured fill_active_job marks progressive work in progress. noone or other
		values mean no active job */
		return is_struct(fill_active_job);
	}

	/// @description Drop the active fill and fill-deferred history without releasing reusable work resources
	/// @returns {Bool} True after clearing runtime state
	fill_abort_runtime = function()
	{
		fill_active_job = noone;
		fill_deferred_history_items = [];
		return true;
	}

	/// @description Reuse a live job target or resolve and allocate its original stable layer
	/// @param {Struct} job Active fill state with local queues, sampling bounds, and replacement values
	/// @returns {Real} Borrowed live target handle, or noone
	fill_job_target_surface = function(job)
	{
		/* Without a structured job there is no target to resolve, so return noone */
		if (!is_struct(job))
		{
			return noone;
		}

		/* Retain an existing target surface while it is live, avoiding a layer lookup on every
		fill advance */
		if (surface_exists(job.target_surface))
		{
			return job.target_surface;
		}

		/* Resolve the job's command layer by stable ID if its original surface was lost */
		var layer_index = layer_index_from_id(command_layer_id(job.command));

		/* A missing layer or failed replacement allocation provides no draw target, so return
		noone instead of drawing into a stale handle */
		if (layer_index == noone || !ensure_layer_surface(layer_index))
		{
			return noone;
		}

		job.target_surface = layers[layer_index].surface;
		return job.target_surface;
	}

	/// @description Expand local touched bounds and append aligned completed-span coordinates
	/// @param {Struct} job Active fill state with local queues, sampling bounds, and replacement values
	/// @param {Real} span_left Inclusive horizontal run start in job-local pixels
	/// @param {Real} span_y Horizontal run row in job-local pixels
	/// @param {Real} span_right Inclusive horizontal run end in job-local pixels
	/// @returns {Bool} Whether a valid horizontal run was recorded
	fill_record_touched_span = function(job, span_left, span_y, span_right)
	{
		/* An absent job or inverted horizontal span has no touched pixels to record, so leave
		its bounds and span arrays unchanged */
		if (!is_struct(job) || span_right < span_left)
		{
			return false;
		}

		job.touched_left = min(job.touched_left, span_left);
		job.touched_top = min(job.touched_top, span_y);
		job.touched_right = max(job.touched_right, span_right);
		job.touched_bottom = max(job.touched_bottom, span_y);

		/* Append the span at one shared array index so span_lefts, span_ys, and span_rights
		remain aligned in work-local pixel coordinates */
		var span_index = array_length(job.span_lefts);
		job.span_lefts[span_index] = span_left;
		job.span_ys[span_index] = span_y;
		job.span_rights[span_index] = span_right;
		return true;
	}

	/// @description Append aligned local seed coordinates while the lifetime queue ceiling permits
	/// @param {Struct} job Active fill state with local queues, sampling bounds, and replacement values
	/// @param {Real} seed_x Queued seed x in sampled-rectangle pixels
	/// @param {Real} seed_y Queued seed y in sampled-rectangle pixels
	/// @returns {Bool} Whether a seed was queued, false marking queue_limited when full
	fill_queue_seed = function(job, seed_x, seed_y)
	{
		/* A missing fill job has no seed queue to extend and returns false */
		if (!is_struct(job))
		{
			return false;
		}

		/* Append a seed only while the lifetime queue-entry ceiling has room. Existing
		consumed entries are not reused because tail advances monotonically */
		if (job.tail < max_fill_queue)
		{
			job.queue_x[job.tail] = seed_x;
			job.queue_y[job.tail] = seed_y;
			job.tail++;
			return true;
		}

		/* Once the seed-entry ceiling is reached, retain queue_limited for final diagnostics
		and reject this additional seed */
		job.queue_limited = true;
		return false;
	}

	/// @description Queue one seed for each matching run within an adjacent local row interval
	/// @param {Struct} job Active fill state with local queues, sampling bounds, and replacement values
	/// @param {Real} span_left Inclusive horizontal run start in job-local pixels
	/// @param {Real} span_right Inclusive horizontal run end in job-local pixels
	/// @param {Real} scan_y Adjacent sampled-rectangle row to inspect
	/// @returns {Bool} Whether the supplied job and row interval were valid
	fill_scan_adjacent_span = function(job, span_left, span_right, scan_y)
	{
		/* Only a valid job, row inside the sampled rectangle, and noninverted x span can be
		scanned. Invalid rows or bounds are skipped before buffer access */
		if (!is_struct(job)
		|| scan_y < 0
		|| scan_y >= job.bounds_h
		|| span_left > span_right)
		{
			return false;
		}

		/* Compute this work-local row's byte offset using the job's RGBA row stride */
		var scan_row_offset = scan_y * job.row_stride;

		/* Start the adjacent-row scan at the span's inclusive left pixel */
		var scan_x = span_left;

		/* Move across the inclusive span until its right edge, queuing one seed per matching
		run */
		while (scan_x <= span_right)
		{
			/* Compute the current work-local pixel's byte offset within the sampling buffer */
			var scan_offset = scan_row_offset + scan_x * 4;

			/* Read its packed RGBA value to compare with the original fill target */
			var scan_pixel = buffer_peek(fill_work_buffer, scan_offset, buffer_u32);

			/* A matching pixel begins a connected adjacent run, so queue its first seed and
			skip across that run rather than queuing every matching pixel */
			if (fill_pixel_matches_target(scan_pixel, job.target_r, job.target_g, job.target_b, job.target_a))
			{
				fill_queue_seed(job, scan_x, scan_y);

				/* Advance through the current run while its x remains inside the span.
				Reaching a different pixel ends the run below */
				while (scan_x <= span_right)
				{
					scan_offset = scan_row_offset + scan_x * 4;
					scan_pixel = buffer_peek(fill_work_buffer, scan_offset, buffer_u32);

					/* A nonmatching pixel ends this adjacent run so the outer scan can
					continue searching beyond it */
					if (!fill_pixel_matches_target(scan_pixel, job.target_r, job.target_g, job.target_b, job.target_a))
					{
						break;
					}

					scan_x++;
				}
			}

			scan_x++;
		}

		return true;
	}

	/// @description Replace the reusable work surface with its RGBA replacement mask
	/// @returns {Bool} Whether both mask and work surface were available
	fill_mask_buffer_to_work_surface = function()
	{
		/* Both the work surface and mask buffer must exist before the replacement pixels can
		be uploaded. Missing either returns false */
		if (!surface_exists(fill_work_surface)
		|| !buffer_exists(fill_mask_buffer))
		{
			return false;
		}

		clear_fill_work_surface();
		buffer_set_surface(fill_mask_buffer, fill_work_surface, 0);
		return true;
	}

	/// @description Select destination removal for transparent fills or ordinary RGB/alpha painting
	/// @param {Struct} command Validated fill command with inclusive room-contained sample bounds
	/// @returns {Bool} True after setting blend, alpha, and color state
	begin_fill_span_blend = function(command)
	{
		/* Read the fill command's alpha byte to choose ordinary painting or pixel removal */
		var alpha_value = command_alpha(command);

		/* Zero-alpha fill spans remove destination pixels through inverse-source-alpha
		blending. Positive alpha uses the command color and opacity below */
		if (alpha_value <= 0)
		{
			gpu_set_blendmode_ext(bm_zero, bm_inv_src_alpha);
			draw_set_alpha(1);
			draw_set_colour(c_white);
			return true;
		}

		gpu_set_blendmode(bm_normal);
		draw_set_alpha(alpha_value / 255);
		draw_set_colour(command_color(command));
		return true;
	}

	/// @description Encode a local replacement-mask crop through the shared row-major RGBA hex encoder
	/// @param {Real} local_left Crop left edge in work-local mask pixels
	/// @param {Real} local_top Crop top edge in work-local mask pixels
	/// @param {Real} region_w Crop width in pixels
	/// @param {Real} region_h Crop height in pixels
	/// @param {Real} bounds_w Full sampling-mask row width in pixels
	/// @returns {Struct} Shared PNG result carrying accepted base64 or failure detail
	fill_mask_region_to_png_base64 = function(local_left, local_top, region_w, region_h, bounds_w)
	{
		/* Start with the shared PNG encoder's failed result, which carries no image until
		encoding succeeds */
		var result = RgbaPng.make_result("Could not encode fill PNG.");

		/* A missing replacement-mask buffer cannot supply pixels for encoding, so return the
		failed result with a specific message */
		if (!buffer_exists(fill_mask_buffer))
		{
			result.message = "Fill mask buffer is missing.";
			return result;
		}

		/* safe_left and safe_top are whole nonnegative offsets into the work-local mask */
		var safe_left = max(0, floor(real(local_left)));
		var safe_top = max(0, floor(real(local_top)));

		/* safe_w and safe_h are positive whole-pixel crop dimensions */
		var safe_w = max(1, floor(real(region_w)));
		var safe_h = max(1, floor(real(region_h)));

		/* Normalize the mask's row width to a positive whole-pixel stride source for offset
		calculation */
		var safe_bounds_w = max(1, floor(real(bounds_w)));

		/* Build row-major RGBA hex from empty text, appending exactly eight hex characters per
		pixel */
		var hex_text = "";

		/* Visit crop rows from zero through safe_h so encoded pixels retain top-to-bottom
		order */
		for (var pixel_row = 0; pixel_row < safe_h; pixel_row++)
		{
			/* Translate this cropped row into its source row within the full mask */
			var source_y = safe_top + pixel_row;

			/* Visit cropped columns from zero through safe_w for left-to-right pixel order */
			for (var pixel_col = 0; pixel_col < safe_w; pixel_col++)
			{
				/* Translate this crop column into its full-mask x coordinate */
				var source_x = safe_left + pixel_col;

				/* Convert the source row and column into its four-byte RGBA offset */
				var pixel_offset = (source_y * safe_bounds_w + source_x) * 4;

				/* Read the packed replacement pixel without modifying the reusable mask buffer */
				var pixel_value = buffer_peek(fill_mask_buffer, pixel_offset, buffer_u32);

				/* Extract its opacity byte before choosing transparent or colored output */
				var pixel_alpha = (pixel_value >> 24) & 255;

				/* A zero-alpha pixel encodes as eight zero hex digits, discarding invisible
				RGB bytes */
				if (pixel_alpha <= 0)
				{
					hex_text += "00000000";
				}

				/* Nontransparent pixels encode red, green, blue, then alpha as individual byte
				pairs for the shared RGBA PNG encoder */
				else
				{
					hex_text += RgbaPng.byte_to_hex(pixel_value & 255)
						+ RgbaPng.byte_to_hex((pixel_value >> 8) & 255)
						+ RgbaPng.byte_to_hex((pixel_value >> 16) & 255)
						+ RgbaPng.byte_to_hex(pixel_alpha);
				}
			}
		}

		return RgbaPng.rgba_hex_to_png_base64(safe_w, safe_h, hex_text);
	}

	/// @description Encode a local replacement-mask crop through a temporary native surface and file
	/// @param {Real} local_left Crop left edge in work-local mask pixels
	/// @param {Real} local_top Crop top edge in work-local mask pixels
	/// @param {Real} region_w Crop width in pixels
	/// @param {Real} region_h Crop height in pixels
	/// @returns {Struct} Shared PNG result, cleaning up its temporary surface, file, and buffer
	fill_mask_region_to_png_base64_surface = function(local_left, local_top, region_w, region_h)
	{
		/* Start with the shared PNG encoder's failure result before allocating the native
		surface export resources */
		var result = RgbaPng.make_result("Could not encode fill PNG.");

		/* safe_left/safe_top are nonnegative whole work-local crop offsets */
		var safe_left = max(0, floor(real(local_left)));
		var safe_top = max(0, floor(real(local_top)));

		/* safe_w/safe_h are positive whole crop dimensions in pixels */
		var safe_w = max(1, floor(real(region_w)));
		var safe_h = max(1, floor(real(region_h)));

		/* The mask must first upload to its work surface. Failure leaves no source pixels for
		the native crop export */
		if (!fill_mask_buffer_to_work_surface())
		{
			result.message = "Fill mask surface is missing.";
			return result;
		}

		/* Own a temporary crop surface sized to this output region, releasing it after the PNG
		result is obtained */
		var region_surface = surface_create(safe_w, safe_h);

		/* A failed crop allocation returns a specific failure without attempting to target an
		unavailable surface */
		if (!surface_exists(region_surface))
		{
			result.message = "Could not create fill region surface.";
			return result;
		}

		/* Use the runtime temporary directory with a clock and random suffix for this
		intermediate fill PNG, deleting the file afterward when present */
		var temp_path = screenshot_path_join(temp_directory, "JonnilOnline_Fill_" + string(current_time) + "_" + string(irandom(999999)) + ".png");

		/* Own the loaded PNG byte buffer only during export, starting unallocated and deleting
		it during final cleanup */
		var png_buffer = noone;
		try
		{
			/* Capture texture filtering before copying the crop without interpolation,
			restoring it after a successful target reset */
			var restore_filter = gpu_get_texfilter();
			gpu_set_texfilter(false);
			surface_set_target(region_surface);
			gpu_set_blendmode(bm_normal);
			draw_set_alpha(1);
			draw_clear_alpha(c_black, 0);
			draw_surface_part(fill_work_surface, safe_left, safe_top, safe_w, safe_h, 0, 0);
			surface_reset_target();
			gpu_set_texfilter(restore_filter);

			surface_save(region_surface, temp_path);
			png_buffer = buffer_load(temp_path);

			/* A failed PNG file load keeps the result rejected. A live buffer continues to
			byte-size validation */
			if (!buffer_exists(png_buffer))
			{
				result.message = "Could not read fill PNG.";
			}

			/* Inspect the successfully loaded PNG bytes before exposing an encoded fill result */
			else
			{
				/* Measure the exported PNG byte size for the import/send ceiling */
				var png_size = buffer_get_size(png_buffer);

				/* Empty or oversized PNG bytes cannot become the upload result, so retain
				failure with the existing size message */
				if (png_size <= 0 || png_size > image_import_max_bytes)
				{
					result.message = "Fill PNG is too large.";
				}

				/* A nonempty PNG within the import byte ceiling supplies ok true, base64
				bytes, byte_size, crop width/height, and an empty failure message */
				else
				{
					result.ok = true;
					result.base64 = buffer_base64_encode(png_buffer, 0, png_size);
					result.byte_size = png_size;
					result.width = safe_w;
					result.height = safe_h;
					result.message = "";
				}
			}
		}
		catch(e)
		{
			/* Prefer an encoding exception's structured message when available, otherwise use
			its printable form for the failed result */
			var encode_error = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			result.message = "Could not encode fill PNG: " + encode_error;
		}

		/* Delete the temporary loaded PNG buffer only when it exists */
		if (buffer_exists(png_buffer))
		{
			buffer_delete(png_buffer);
		}

		/* Remove a created temporary PNG file with best-effort cleanup after successful or
		failed encoding */
		if (file_exists(temp_path))
		{
			try { file_delete(temp_path); } catch(delete_error) {}
		}

		/* Free the temporary crop surface only when it still exists, leaving the reusable work
		surface owned by drawing state */
		if (surface_exists(region_surface))
		{
			surface_free(region_surface);
		}

		return result;
	}

	/// @description Encode clipped completed fill spans through the browser's opaque RGB span encoder
	/// @param {Struct} job Active fill state with local queues, sampling bounds, and replacement values
	/// @param {Real} image_left Encoded image world-pixel left edge
	/// @param {Real} image_top Encoded image world-pixel top edge
	/// @param {Real} image_w Encoded image width in pixels
	/// @param {Real} image_h Encoded image height in pixels
	/// @returns {Struct} Shared PNG result with output dimensions or failure detail
	fill_spans_region_to_png_base64 = function(job, image_left, image_top, image_w, image_h)
	{
		/* Start with a rejected shared PNG result until a usable span list is converted
		successfully */
		var result = RgbaPng.make_result("Could not encode fill spans.");

		/* A missing job, missing span_lefts field, or nonarray span list has no recorded fill
		runs to encode */
		if (!is_struct(job)
		|| !variable_struct_exists(job, "span_lefts")
		|| !is_array(job.span_lefts))
		{
			result.message = "Fill spans are missing.";
			return result;
		}

		/* crop_left/crop_top translate world image origin into job-local coordinates.
		crop_right/crop_bottom are the inclusive opposite crop edges */
		var crop_left = image_left - job.left;
		var crop_top = image_top - job.top;
		var crop_right = crop_left + image_w - 1;
		var crop_bottom = crop_top + image_h - 1;

		/* Build the browser span payload from empty text. Each record stores crop-local
		x,y,width separated by commas, with the literal semicolon separating records */
		var span_text = "";

		/* Visit recorded fill spans from index zero, retaining their row and horizontal extent
		inside this crop */
		for (var span_index = 0; span_index < array_length(job.span_lefts); span_index++)
		{
			/* Read this span's job-local row from its aligned span array */
			var span_y = job.span_ys[span_index];

			/* A span outside the crop's inclusive row range supplies no output pixels and is
			skipped */
			if (span_y < crop_top || span_y > crop_bottom)
			{
				continue;
			}

			/* span_left/span_right clip this recorded run to the crop's horizontal boundaries */
			var span_left = max(job.span_lefts[span_index], crop_left);
			var span_right = min(job.span_rights[span_index], crop_right);

			/* An inverted clipped run has no crop pixels, so omit it from the encoded span
			payload */
			if (span_right < span_left)
			{
				continue;
			}

			span_text += string(span_left - crop_left)
				+ "," + string(span_y - crop_top)
				+ "," + string(span_right - span_left + 1)
				+ ";";
		}

		/* No retained runs means there is no fill region to encode, so return the failed
		result before invoking the browser encoder */
		if (span_text == "")
		{
			result.message = "No fill spans to encode.";
			return result;
		}

		try
		{
			/* Ask the browser span encoder for PNG base64 using crop dimensions, the fill RGB
			channels, and compact opaque replacement runs */
			var base64_text = html5_rgba_spans_to_png_base64(
				image_w,
				image_h,
				job.command.color_r,
				job.command.color_g,
				job.command.color_b,
				span_text
			);

			/* An empty browser result means encoding failed. Try reading its shared error text
			instead of accepting empty PNG contents */
			if (string_trim(string(base64_text)) == "")
			{
				/* Begin without browser error detail so an unavailable error getter can leave
				the generic encoding failure intact */
				var error_text = "";
				try { error_text = html5_stamp_last_error(); } catch(error_read) {}

				/* A nonblank browser detail replaces the generic failure message. Blank detail
				keeps the original result message */
				result.message = string_trim(error_text) == "" ? result.message : error_text;
				return result;
			}

			/* Successful span encoding supplies base64 and output width/height, marking ok
			true. The shared result's other fields retain their encoder defaults */
			result.ok = true;
			result.base64 = base64_text;
			result.width = image_w;
			result.height = image_h;
			result.message = "";
		}
		catch(e)
		{
			/* Prefer a structured span-encoding exception message, falling back to its
			printable form for failure feedback */
			var span_error = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			result.message = "Could not encode fill spans: " + span_error;
		}

		return result;
	}

	/// @description Queue later history behind the active fill in its received order
	/// @param {Struct} item Accepted history item queued behind current fill work
	/// @returns {Bool} True after queuing
	fill_defer_history_item = function(item)
	{
		fill_deferred_history_items[array_length(fill_deferred_history_items)] = item;
		debug_note("drawing deferred during fill", history_item_payload_string(item));
		return true;
	}

	/// @description Resume queued history only while no fill or image replay barrier exists
	/// @returns {Bool} Whether items remain deferred
	apply_deferred_fill_history_items = function()
	{
		/* Apply the oldest deferred item only while no fill or image barrier exists and the
		fill queue is nonempty. A newly started fill/image stops the loop and preserves
		later order */
		while (!fill_job_active()
		&& array_length(pending_image_draws) <= 0
		&& array_length(fill_deferred_history_items) > 0)
		{
			/* Borrow the oldest waiting history item before removing it from the queue and
			applying it */
			var item = fill_deferred_history_items[0];
			array_delete(fill_deferred_history_items, 0, 1);
			apply_history_item_to_surface(item);
		}

		/* Return true when history still waits behind a replay barrier, or false when the
		fill-deferred queue is empty */
		return array_length(fill_deferred_history_items) > 0;
	}

	/// @description Finalize changed pixels, package local uploads, and resume ordered deferred history
	/// @param {Bool} cancelled Whether finalization represents a cancelled local fill, false by default
	/// @returns {Bool} Whether this job filled any pixels
	finish_progressive_fill_job = function(cancelled = false)
	{
		/* Without an active job there is no fill to finish or upload, so return false */
		if (!fill_job_active())
		{
			return false;
		}

		/* Retain the completed job locally before clearing active state so deferred history
		may resume */
		var job = fill_active_job;
		fill_active_job = noone;

		/* changed records whether any pixels were filled, distinguishing a real drawing action
		from an empty attempt */
		var changed = job.filled > 0;

		/* Only changed fills increase application diagnostics and dirty compositing. Empty
		attempts leave those drawing counters and surface state unchanged */
		if (changed)
		{
			debug_apply_count++;
			debug_last_command = job.command;
			layer_composite_dirty = true;

			/* Append a limited diagnostic suffix if the lifetime seed queue or total
			filled-pixel ceiling stopped expansion. Otherwise limit_text remains empty */
			var limit_text = job.queue_limited || job.filled >= max_fill_pixels ? " limited" : "";

			/* cancel_text marks a caller-cancelled fill, while normal completion uses no
			cancellation suffix */
			var cancel_text = cancelled ? " cancelled" : "";

			/* source_text identifies visible-layer boundary sampling or current-layer sampling
			in the completion diagnostic */
			var source_text = job.sample_visible_layers ? " source=visible" : " source=current";
			debug_surface_status = "fill" + cancel_text + " on layer " + string(command_layer_id(job.command));

			/* Choose cancelled or applied wording for the caller's completion mode, retaining
			pixel/span counts and sampling detail */
			debug_note("fill " + (cancelled ? "cancelled" : "applied"), "pixels=" + string(job.filled) + " spans=" + string(job.spans) + " bounds=" + string(job.bounds_w) + "x" + string(job.bounds_h) + source_text + limit_text);
		}

		/* Only locally submitted fills marked send_on_finish package and replicate results.
		Remote or replay jobs finish locally without resending shared history */
		if (job.send_on_finish)
		{
			/* Record the brush color only when the local fill actually changed pixels */
			if (changed)
			{
				record_recent_color_from_command(job.command);
			}

			/* No outgoing item is available until changed pixels are packaged or a permitted
			raw-command fallback is selected */
			var outgoing_item = noone;

			/* A changed local fill attempts to replace its provisional history command with a
			PNG result. Empty fills have no upload item */
			if (changed)
			{
				/* image_left/image_top initially use the sampled world origin. image_w/image_h
				initially cover the full sampled rectangle */
				var image_left = job.left;
				var image_top = job.top;
				var image_w = job.bounds_w;
				var image_h = job.bounds_h;

				/* Cancelled local fills crop packaging to the touched bounds so only completed
				pixels are shared, rather than replaying the unfinished original fill */
				if (cancelled)
				{
					image_left = job.left + job.touched_left;
					image_top = job.top + job.touched_top;
					image_w = job.touched_right - job.touched_left + 1;
					image_h = job.touched_bottom - job.touched_top + 1;
				}

				/* Build a history image from the fill's completed pixels, retaining its layer
				and undo identity */
				var fill_image_item = make_fill_image_history_item(job.command, image_left, image_top, image_w, image_h, job);

				/* A successful image package replaces the local provisional history item and
				becomes the upload result */
				if (fill_image_item != noone)
				{
					replace_client_history_item_at(job.history_index, fill_image_item);
					outgoing_item = fill_image_item;
					debug_last_replication_status = "fill packaged as image";
					debug_note("fill packaged", string(fill_image_item.w) + "x" + string(fill_image_item.h));
				}

				/* If packaging a cancelled fill fails, keep its partial drawing local.
				Resending the raw command would fill beyond the player's cancelled work */
				else if (cancelled)
				{
					debug_last_replication_status = "cancelled fill local only";
					debug_note("fill send skipped", "cancelled fill image unavailable");
				}
			}

			/* A changed normally completed fill without an image package may send its original
			replay command. Cancelled or unchanged fills must not use this fallback */
			if (changed && outgoing_item == noone && !cancelled)
			{
				outgoing_item = job.command;
				debug_note("fill fallback", "sending replay command");
			}

			/* Only an available packaged image or allowed replay-command fallback enters the
			ordered client upload queue */
			if (outgoing_item != noone)
			{
				queue_or_send_history_item_to_server(outgoing_item);
			}
		}

		apply_deferred_fill_history_items();
		apply_deferred_image_history_items();
		return changed;
	}

	/// @description Process bounded seeds and complete spans, yielding between spans or finalizing at lifetime limits
	/// @param {Real} pixel_budget Soft per-advance pixel budget checked between complete spans, defaulting to fill_pixels_per_step
	/// @param {Real} seed_budget Maximum seeds examined per advance, defaulting to fill_seed_budget_per_step
	/// @param {Real} span_budget Maximum completed spans per advance, defaulting to fill_spans_per_step
	/// @returns {Bool} True while work continues, finish result on completion, or false without a job
	advance_progressive_fill_job = function(pixel_budget = fill_pixels_per_step, seed_budget = fill_seed_budget_per_step, span_budget = fill_spans_per_step)
	{
		/* No active job has work to advance, so return false before reading job state */
		if (!fill_job_active())
		{
			return false;
		}

		/* Borrow the active job for this bounded batch of seed and span work */
		var job = fill_active_job;

		/* Resolve its live target surface, replacing a lost cached handle through the stable
		layer ID when possible */
		var target_surface = fill_job_target_surface(job);

		/* An unavailable target counts an application failure and finalizes current job state
		through the normal noncancelled finish path */
		if (!surface_exists(target_surface))
		{
			debug_apply_failures++;
			debug_note("fill cancelled", "target surface unavailable");
			return finish_progressive_fill_job(false);
		}

		/* pixels_this_step, spans_this_step, and seeds_this_step count this call's work from
		zero, separately from job lifetime totals */
		var pixels_this_step = 0;
		var spans_this_step = 0;
		var seeds_this_step = 0;

		/* safe_pixel_budget, safe_seed_budget, and safe_span_budget are positive whole limits
		for this advance, with at least one unit allowed per configured budget */
		var safe_pixel_budget = max(1, floor(real(pixel_budget)));
		var safe_seed_budget = max(1, floor(real(seed_budget)));
		var safe_span_budget = max(1, floor(real(span_budget)));

		surface_set_target(target_surface);
		begin_fill_span_blend(job.command);

		/* Process only queued seeds while below the total pixel ceiling and current seed/span
		budgets. Pixel budgeting is checked between complete spans, allowing a whole
		horizontal run to finish before yielding */
		while (job.head < job.tail
		&& job.filled < max_fill_pixels
		&& seeds_this_step < safe_seed_budget
		&& (pixels_this_step < safe_pixel_budget || spans_this_step <= 0)
		&& spans_this_step < safe_span_budget)
		{
			/* seed_x and seed_y are the next queued work-local pixel coordinates, sharing the
			same head index in their aligned arrays */
			var seed_x = job.queue_x[job.head];
			var seed_y = job.queue_y[job.head];
			job.head++;
			seeds_this_step++;

			/* A seed outside the sampled rectangle is skipped before calculating its buffer
			offset */
			if (seed_x < 0 || seed_x >= job.bounds_w || seed_y < 0 || seed_y >= job.bounds_h)
			{
				continue;
			}

			/* seed_row_offset is this work-local row's RGBA byte start */
			var seed_row_offset = seed_y * job.row_stride;

			/* seed_offset identifies this seed's four-byte pixel within that row */
			var seed_offset = seed_row_offset + seed_x * 4;

			/* Read its current packed sample, which may already have been replaced by an
			earlier overlapping run */
			var seed_pixel = buffer_peek(fill_work_buffer, seed_offset, buffer_u32);

			/* A pixel no longer matching the original target needs no repaint or neighbour
			scan, so discard this seed */
			if (!fill_pixel_matches_target(seed_pixel, job.target_r, job.target_g, job.target_b, job.target_a))
			{
				continue;
			}

			/* span_left begins at the seed for leftward expansion. draw_left begins there too,
			while draw_right starts one pixel earlier to mark no accepted pixels yet */
			var span_left = seed_x;
			var draw_left = seed_x;
			var draw_right = seed_x - 1;

			/* Extend left while inside the sampled row and below the job's total pixel
			ceiling. A nonmatching pixel also ends the run below */
			while (span_left >= 0 && job.filled < max_fill_pixels)
			{
				/* left_offset identifies the current leftward pixel's RGBA byte position */
				var left_offset = seed_row_offset + span_left * 4;

				/* Read the leftward sample before deciding whether it still belongs to the
				target region */
				var left_pixel = buffer_peek(fill_work_buffer, left_offset, buffer_u32);

				/* The first nonmatching left pixel ends expansion, keeping boundary pixels
				unchanged */
				if (!fill_pixel_matches_target(left_pixel, job.target_r, job.target_g, job.target_b, job.target_a))
				{
					break;
				}

				buffer_poke(fill_work_buffer, left_offset, buffer_u32, job.fill_pixel);
				buffer_poke(fill_mask_buffer, left_offset, buffer_u32, job.fill_pixel);
				draw_left = span_left;
				draw_right = max(draw_right, span_left);
				span_left--;
				job.filled++;
				pixels_this_step++;
			}

			/* Begin rightward expansion one pixel after the seed because the left pass already
			handled the seed itself */
			var span_right = seed_x + 1;

			/* Extend right while inside the sampled row and below the lifetime pixel ceiling.
			A nonmatching pixel ends this side of the run */
			while (span_right < job.bounds_w && job.filled < max_fill_pixels)
			{
				/* right_offset identifies the current rightward pixel's RGBA byte position */
				var right_offset = seed_row_offset + span_right * 4;

				/* Read the rightward sample before accepting it into the fill span */
				var right_pixel = buffer_peek(fill_work_buffer, right_offset, buffer_u32);

				/* A nonmatching right pixel ends this run without repainting its boundary */
				if (!fill_pixel_matches_target(right_pixel, job.target_r, job.target_g, job.target_b, job.target_a))
				{
					break;
				}

				buffer_poke(fill_work_buffer, right_offset, buffer_u32, job.fill_pixel);
				buffer_poke(fill_mask_buffer, right_offset, buffer_u32, job.fill_pixel);
				draw_right = span_right;
				span_right++;
				job.filled++;
				pixels_this_step++;
			}

			/* An inverted accepted draw range means this seed produced no span, so skip
			drawing and neighbour scans */
			if (draw_right < draw_left)
			{
				continue;
			}

			job.spans++;
			spans_this_step++;

			/* Only local send-on-finish jobs retain span coordinates for packaging. Shared
			replay fills need only their rendered pixels */
			if (job.send_on_finish)
			{
				fill_record_touched_span(job, draw_left, seed_y, draw_right);
			}
			draw_rectangle(job.left + draw_left, job.top + seed_y, job.left + draw_right + 1, job.top + seed_y + 1, false);

			/* Scan neighbouring rows only while total pixel capacity remains. Once the ceiling
			is reached, no additional seeds are needed */
			if (job.filled < max_fill_pixels)
			{
				fill_scan_adjacent_span(job, draw_left, draw_right, seed_y - 1);
				fill_scan_adjacent_span(job, draw_left, draw_right, seed_y + 1);
			}
		}

		surface_reset_target();
		gpu_set_blendmode(bm_normal);
		draw_set_alpha(1);

		/* Only a batch that drew spans dirties the composite and reports running pixel totals.
		Seed-only scans create no new surface pixels */
		if (spans_this_step > 0)
		{
			layer_composite_dirty = true;
			debug_surface_status = "fill running " + string(job.filled) + "px";
		}

		/* An exhausted queue or reached lifetime pixel ceiling finishes the job. Otherwise
		keep it active for another bounded advance */
		if (job.head >= job.tail || job.filled >= max_fill_pixels)
		{
			return finish_progressive_fill_job(false);
		}

		return true;
	}

	/// @description Finish a cancellable local fill with only its completed region eligible for upload
	/// @returns {Bool} Whether cancellation finalized a job that changed pixels, false for absent or noncancellable work
	cancel_progressive_fill_job = function()
	{
		/* No active fill can be cancelled, so return false */
		if (!fill_job_active())
		{
			return false;
		}

		/* Borrow the current job to check whether this action belongs to a cancellable local
		operation */
		var job = fill_active_job;

		/* Remote or replay fills are not cancellable because later shared history depends on
		their ordered completion. Keep them running and report false */
		if (!job.cancelable)
		{
			debug_note("fill cancel ignored", "remote/replay fill");
			return false;
		}

		set_screenshot_status("Fill cancelled.", make_color_rgb(255, 220, 95));
		return finish_progressive_fill_job(true);
	}

	/// @description Capture fill boundaries and one seed in shared work storage, then advance its first batch
	/// @param {Struct} command Validated fill command with inclusive room-contained sample bounds
	/// @param {Real} target_surface Borrowed live destination-layer surface
	/// @param {Bool} send_on_finish Whether completed local work should enter replication, false by default
	/// @param {Bool} cancelable Whether the player may stop this local job, false for shared/replay work by default
	/// @param {Real} history_index Provisional zero-based client-history item to replace after image packaging, minus one when unavailable. Defaults to -1
	/// @returns {Bool} Whether a job was started, false for invalid or unchanged fill setup
	begin_progressive_fill_command = function(command, target_surface, send_on_finish = false, cancelable = false, history_index = -1)
	{
		/* A missing target surface cannot receive fill spans, so reject startup */
		if (!surface_exists(target_surface))
		{
			return false;
		}

		/* Only one fill may own the reusable sample/mask buffers at a time. Reject a second
		job while the current one is active */
		if (fill_job_active())
		{
			debug_note("fill skipped", "another fill is active");
			return false;
		}

		/* left/top are the lesser fill-bound corners and right/bottom are the greater corners,
		all inclusive world-pixel coordinates */
		var left = min(command.to_x, command.extra_a);
		var top = min(command.to_y, command.extra_b);
		var right = max(command.to_x, command.extra_a);
		var bottom = max(command.to_y, command.extra_b);

		/* start_x/start_y clamp the fill seed into that inclusive sampling rectangle */
		var start_x = clamp(command.from_x, left, right);
		var start_y = clamp(command.from_y, top, bottom);

		/* bounds_w/bounds_h include both rectangle edges and describe its work-local pixel
		dimensions */
		var bounds_w = right - left + 1;
		var bounds_h = bottom - top + 1;

		/* Count total sampled pixels before allocating the shared fill work area */
		var bounds_area = bounds_w * bounds_h;

		/* A sampling rectangle above the area ceiling is rejected before allocating its
		surfaces and buffers */
		if (bounds_area > max_fill_bounds_area)
		{
			debug_note("fill skipped", "bounds too large " + string(bounds_area));
			return false;
		}

		/* Fill needs its sampling surface and both RGBA buffers. Setup failure rejects the job
		instead of operating on unavailable work storage */
		if (!ensure_fill_work_area(bounds_w, bounds_h))
		{
			debug_note("fill skipped", "work area unavailable");
			return false;
		}

		/* Resolve whether boundary detection uses the visible-layer composite or just the
		destination layer */
		var sample_visible_layers = command_fill_sample_visible(command);

		/* Visible-layer sampling composites the current visible unarchived layers into the
		clipped work surface for boundary detection */
		if (sample_visible_layers)
		{
			/* A failed visible-layer sample cannot define reliable boundaries, so reject the
			job */
			if (!draw_visible_layers_to_fill_work_surface(left, top))
			{
				debug_note("fill skipped", "visible layer sample unavailable");
				return false;
			}
		}

		/* Current-layer sampling copies only the target layer into the work area, preserving
		its independent fill boundary */
		else
		{
			clear_fill_work_surface();
			gpu_set_blendmode(bm_normal);
			draw_set_alpha(1);
			surface_copy_part(fill_work_surface, 0, 0, target_surface, left, top, bounds_w, bounds_h);
		}

		buffer_get_surface(fill_work_buffer, fill_work_surface, 0);
		clear_fill_work_surface();
		buffer_get_surface(fill_mask_buffer, fill_work_surface, 0);

		/* row_stride is the sampled rectangle's RGBA byte width, four bytes per pixel */
		var row_stride = bounds_w * 4;

		/* start_lx/start_ly translate the world seed into zero-based coordinates within the
		work rectangle */
		var start_lx = start_x - left;
		var start_ly = start_y - top;

		/* Locate the seed's packed RGBA value using that local row and column */
		var start_offset = start_ly * row_stride + start_lx * 4;

		/* Read the original seed color from the sampled layers before replacement begins */
		var target_pixel = buffer_peek(fill_work_buffer, start_offset, buffer_u32);

		/* target_r, target_g, target_b, and target_a are the seed's red, green, blue, and
		opacity bytes used to identify connected pixels */
		var target_r = target_pixel & 255;
		var target_g = (target_pixel >> 8) & 255;
		var target_b = (target_pixel >> 16) & 255;
		var target_a = (target_pixel >> 24) & 255;

		/* Read the replacement alpha byte, with zero selecting transparent removal */
		var fill_alpha = command_alpha(command);

		/* Pack replacement red, green, blue, and opacity into the same little-endian RGBA
		integer used by both fill buffers */
		var fill_pixel = command.color_r
			+ command.color_g * 256
			+ command.color_b * 65536
			+ fill_alpha * 16777216;

		/* A replacement already matching the seed under the fill tolerances changes no target
		classification. Skip it so painted pixels will not keep matching and expanding the
		same job */
		if (fill_pixel_matches_target(fill_pixel, target_r, target_g, target_b, target_a))
		{
			debug_note("fill skipped", "target already fill colour");
			return false;
		}

		/* The job borrows command and target_surface, stores world left/top/right/bottom
		bounds and local bounds_w/bounds_h/row_stride, and retains original target RGBA plus
		the packed replacement fill_pixel for each later Step */
		fill_active_job =
		{
			command: command,
			target_surface: target_surface,
			left: left,
			top: top,
			right: right,
			bottom: bottom,
			bounds_w: bounds_w,
			bounds_h: bounds_h,
			row_stride: row_stride,
			target_r: target_r,
			target_g: target_g,
			target_b: target_b,
			target_a: target_a,
			fill_pixel: fill_pixel,

			/* queue_x/queue_y start with the seed's local coordinates. head zero is the next
			unread entry and tail one is the next append position, keeping aligned seed
			arrays in FIFO order */
			queue_x: [start_lx],
			queue_y: [start_ly],
			head: 0,
			tail: 1,

			/* filled and spans start at zero before any pixels are replaced. queue_limited
			starts false until appending reaches the lifetime seed-entry ceiling */
			filled: 0,
			spans: 0,
			queue_limited: false,

			/* sample_visible_layers records boundary-source mode. send_on_finish and
			cancelable retain the caller's submission/cancellation choices, and
			history_index identifies the provisional local item to replace after packaging */
			sample_visible_layers: sample_visible_layers,
			send_on_finish: send_on_finish,
			cancelable: cancelable,
			history_index: history_index,

			/* Touched bounds start empty, with left/top beyond local dimensions and
			right/bottom at minus one. Empty aligned span_lefts/span_ys/span_rights later
			record local completed runs for upload. started_at is the job's current_time
			millisecond start */
			touched_left: bounds_w,
			touched_top: bounds_h,
			touched_right: -1,
			touched_bottom: -1,
			span_lefts: [],
			span_ys: [],
			span_rights: [],
			started_at: current_time
		};

		/* Add a cancelable diagnostic suffix only for local jobs that permit cancellation */
		debug_note("fill started", string(bounds_w) + "x" + string(bounds_h) + (cancelable ? " cancelable" : ""));

		/* Show shared-fill waiting feedback for noncancellable jobs outside a layer
		reconstruction. Cancellable edits and internal replay rebuilds omit that UI notice */
		if (!cancelable && !layer_surface_rebuild_active)
		{
			set_screenshot_status("Applying shared fill...", make_color_rgb(255, 220, 95));
		}
		advance_progressive_fill_job();
		return true;
	}
	#endregion /* Progressive Fill Work END */

	#region /* Primitive and Layer Rendering */
	/// @description Release canvas, layer, fill, pending image, and selection resources owned by drawing state
	delete_surface = function()
	{
		/* Free the flattened canvas only if its surface still exists, then release layer,
		fill, image, and selection resources through their owning helpers */
		if (surface_exists(canvas_surface))
		{
			surface_free(canvas_surface);
		}

		canvas_surface = noone;
		delete_all_layer_surfaces();
		delete_fill_work_area();
		delete_pending_image_draws();
		clear_selection();
		debug_surface_status = "deleted";
	}

	/// @description Select removal blending for erasing or transparency, otherwise apply command RGB and alpha
	/// @param {Struct} command Validated drawing command with tool, brush, color, and world geometry
	begin_command_blend = function(command)
	{
		draw_set_alpha(1);

		/* Eraser tools and zero-alpha commands remove destination pixels rather than painting
		RGB. Other drawing uses the command's color and opacity below */
		if (command.tool_id == DRAW_TOOL_ERASER
		|| command_is_transparent(command))
		{
			gpu_set_blendmode_ext(bm_zero, bm_inv_src_alpha);
			draw_set_colour(c_white);
			return;
		}

		gpu_set_blendmode(bm_normal);
		draw_set_alpha(command_alpha(command) / 255);
		draw_set_colour(command_color(command));
	}

	/// @description Restore ordinary blend mode and full draw alpha after a drawing command
	end_command_blend = function()
	{
		gpu_set_blendmode(bm_normal);
		draw_set_alpha(1);
	}

	/// @description Draw a world-pixel line with filled round caps on its two endpoints
	/// @param {Struct} command Validated drawing command with tool, brush, color, and world geometry
	draw_command_line = function(command)
	{
		/* Use half the world-pixel brush diameter for rounded stroke caps, with a minimum
		radius of one pixel */
		var radius = max(1, command.brush_px * 0.5);
		draw_line_width(command.from_x, command.from_y, command.to_x, command.to_y, command.brush_px);
		draw_circle(command.from_x, command.from_y, radius, false);
		draw_circle(command.to_x, command.to_y, radius, false);
	}

	/// @description Draw an endpoint-bounded rectangle outline using four brush-width strips
	/// @param {Struct} command Validated drawing command with tool, brush, color, and world geometry
	draw_command_rectangle = function(command)
	{
		/* left/top take the lesser endpoint coordinates and right/bottom take the greater ones
		so dragging either direction builds the same world rectangle */
		var left = min(command.from_x, command.to_x);
		var top = min(command.from_y, command.to_y);
		var right = max(command.from_x, command.to_x);
		var bottom = max(command.from_y, command.to_y);

		/* Use half the brush diameter, with at least half a pixel, to draw the rectangle
		outline as four filled strips */
		var half_width = max(0.5, command.brush_px * 0.5);

		draw_rectangle(left - half_width, top - half_width, right + half_width, top + half_width, false);
		draw_rectangle(left - half_width, bottom - half_width, right + half_width, bottom + half_width, false);
		draw_rectangle(left - half_width, top - half_width, left + half_width, bottom + half_width, false);
		draw_rectangle(right - half_width, top - half_width, right + half_width, bottom + half_width, false);
	}

	/// @description Draw a brush-width sampled ellipse, handling point and line degeneracies directly
	/// @param {Real} left Ellipse bounding-box left edge in world pixels
	/// @param {Real} top Ellipse bounding-box top edge in world pixels
	/// @param {Real} right Ellipse bounding-box right edge in world pixels
	/// @param {Real} bottom Ellipse bounding-box bottom edge in world pixels
	/// @param {Real} brush_px Outline diameter in world pixels
	draw_ellipse_outline = function(left, top, right, bottom, brush_px)
	{
		/* center_x/center_y are the midpoint of the ellipse's world-pixel bounding box */
		var center_x = (left + right) * 0.5;
		var center_y = (top + bottom) * 0.5;

		/* radius_x/radius_y are the nonnegative half-width and half-height, which also
		identify collapsed ellipse axes */
		var radius_x = max(0, (right - left) * 0.5);
		var radius_y = max(0, (bottom - top) * 0.5);

		/* line_width is the positive world-pixel segment thickness used for the ellipse
		outline */
		var line_width = max(1, brush_px);

		/* cap_radius is half the brush thickness with a half-pixel minimum, rounding the joins
		between outline segments */
		var cap_radius = max(0.5, brush_px * 0.5);

		/* A box collapsed on both axes becomes one brush-cap circle instead of attempting an
		ellipse path */
		if (radius_x <= 0 && radius_y <= 0)
		{
			draw_circle(center_x, center_y, cap_radius, false);
			return;
		}

		/* A zero horizontal radius leaves a vertical line, so draw it with rounded end caps
		and stop before angular sampling */
		if (radius_x <= 0)
		{
			draw_line_width(center_x, top, center_x, bottom, line_width);
			draw_circle(center_x, top, cap_radius, false);
			draw_circle(center_x, bottom, cap_radius, false);
			return;
		}

		/* A zero vertical radius leaves a horizontal line, so draw it with rounded end caps
		instead of sampling a flat ellipse */
		if (radius_y <= 0)
		{
			draw_line_width(left, center_y, right, center_y, line_width);
			draw_circle(left, center_y, cap_radius, false);
			draw_circle(right, center_y, cap_radius, false);
			return;
		}

		/* tau stores one full angular turn in radians for the cosine and sine path */
		var tau = 6.283185307179586;

		/* Estimate the ellipse perimeter from its two world-pixel radii to choose an
		appropriate sampling density */
		var circumference = tau * sqrt((radius_x * radius_x + radius_y * radius_y) * 0.5);

		/* Choose outline segments from perimeter relative to brush thickness, bounded between
		24 and 720 so tiny shapes retain detail and large shapes have finite draw work */
		var segment_count = clamp(ceil(circumference / max(1, brush_px * 0.75)), 24, 720);

		/* previous_x/previous_y begin at the ellipse's rightmost world point, providing the
		first segment's starting endpoint */
		var previous_x = center_x + radius_x;
		var previous_y = center_y;

		/* Sample segment numbers from one through the final segment count so the last point
		closes one full turn back to the start */
		for (var segment_index = 1; segment_index <= segment_count; segment_index++)
		{
			/* Compute this sample's angular position in radians around the ellipse */
			var angle = segment_index * tau / segment_count;

			/* next_x/next_y are the next world point on the ellipse, becoming the following
			segment's starting point after drawing */
			var next_x = center_x + cos(angle) * radius_x;
			var next_y = center_y + sin(angle) * radius_y;
			draw_line_width(previous_x, previous_y, next_x, next_y, line_width);
			draw_circle(previous_x, previous_y, cap_radius, false);
			previous_x = next_x;
			previous_y = next_y;
		}

		draw_circle(previous_x, previous_y, cap_radius, false);
	}

	/// @description Interpret the command as a bounding-box ellipse or center-to-edge circle
	/// @param {Struct} command Validated drawing command with tool, brush, color, and world geometry
	draw_command_circle = function(command)
	{
		/* A nonzero extra_a selects the dragged bounding-box ellipse representation. Zero
		keeps the center-and-radius command representation */
		var circle_uses_box = command_extra_a(command) != 0;

		/* Bounding-box mode normalizes both endpoints into ellipse edges and returns after
		drawing, leaving radius mode for the remaining path */
		if (circle_uses_box)
		{
			draw_ellipse_outline(
				min(command.from_x, command.to_x),
				min(command.from_y, command.to_y),
				max(command.from_x, command.to_x),
				max(command.from_y, command.to_y),
				command.brush_px
			);
			return;
		}

		/* Measure the radius in world pixels from the center start point to the command
		endpoint before constructing its square ellipse bounds */
		var radius = point_distance(command.from_x, command.from_y, command.to_x, command.to_y);
		draw_ellipse_outline(
			command.from_x - radius,
			command.from_y - radius,
			command.from_x + radius,
			command.from_y + radius,
			command.brush_px
		);
	}

	/// @description Render command text at its world origin with brush-derived height and a 420-pixel width ceiling
	/// @param {Struct} command Validated drawing command with tool, brush, color, and world geometry
	draw_command_text = function(command)
	{
		draw_set_halign(fa_left);
		scr_render_text(command.from_x, command.from_y, command.text, max(12, command.brush_px * 3), 420);
	}

	/// @description Remove every pixel in the inclusive selection rectangle and restore normal blending
	/// @param {Struct} command Validated drawing command with tool, brush, color, and world geometry
	draw_command_clear_rectangle = function(command)
	{
		/* left/top are the lesser selected pixel coordinates. right/bottom extend the greater
		inclusive coordinates by one so the filled clear rectangle includes the final pixel */
		var left = min(command.from_x, command.to_x);
		var top = min(command.from_y, command.to_y);
		var right = max(command.from_x, command.to_x) + 1;
		var bottom = max(command.from_y, command.to_y) + 1;

		/* Clear this selected rectangle through destination-removal blending, then restore
		ordinary blend and alpha state for later drawing */
		gpu_set_blendmode_ext(bm_zero, bm_inv_src_alpha);
		draw_set_alpha(1);
		draw_set_colour(c_white);
		draw_rectangle(left, top, right, bottom, false);
		gpu_set_blendmode(bm_normal);
		draw_set_alpha(1);
	}

	/// @description Start an ordered shared fill without local cancellation or upload
	/// @param {Struct} command Validated drawing command with tool, brush, color, and world geometry
	/// @param {Real} target_surface Borrowed live target-layer surface
	/// @returns {Bool} Whether progressive fill setup started a job
	apply_fill_command = function(command, target_surface)
	{
		/* Received or replayed fills start progressive work without local upload or
		cancellation, preserving ordered shared drawing */
		return begin_progressive_fill_command(command, target_surface, false, false, -1);
	}

	/// @description Refresh the cached canvas from visible layers unless an ordered rebuild is in progress
	/// @returns {Bool} Whether the composite surface was updated
	composite_layers = function()
	{
		/* Keep the last completed canvas visible while its layers rebuild offscreen */
		if (layer_surface_rebuild_active)
		{
			return false;
		}

		/* Capture get_timer's microsecond start for this composite's diagnostic duration */
		var composite_started_at = get_timer();

		/* Without a flattened target surface there is nowhere to draw the composite, so leave
		it unchanged and return false */
		if (!surface_exists(canvas_surface))
		{
			return false;
		}

		/* All layer surfaces must be available before compositing. A failed allocation returns
		false rather than clearing to an incomplete drawing */
		if (!ensure_all_layer_surfaces())
		{
			return false;
		}

		surface_set_target(canvas_surface);
		gpu_set_blendmode(bm_normal);
		draw_set_alpha(1);
		draw_clear_alpha(c_black, 0);

		/* Use provisional render order so the flattened canvas agrees with local reorder
		drafts and move-vote previews */
		var render_order = layer_render_order_indices();

		/* Draw render positions from zero in compositing order, ending after every layer entry */
		for (var order_index = 0; order_index < array_length(render_order); order_index++)
		{
			/* Resolve this render position into its stored client-layer index */
			var layer_index = render_order[order_index];

			/* Borrow the layer struct to read its visibility, archive status, and owned
			surface */
			var paint_layer = layers[layer_index];

			/* Remember whether restoration voting temporarily previews this archived layer */
			var restore_preview = layer_is_restore_preview(paint_layer);

			/* Draw only a live surface whose layer is unarchived and visible, unless a restore
			preview overrides those local display restrictions. Other layers contribute no
			pixels */
			if ((!layer_is_archived(paint_layer) || restore_preview)
			&& (paint_layer.visible || restore_preview)
			&& surface_exists(paint_layer.surface))
			{
				draw_surface(paint_layer.surface, 0, 0);
			}
		}
		surface_reset_target();
		layer_composite_dirty = false;
		debug_surface_status = "composited " + string(array_length(layers)) + " layer(s)";

		/* Convert the elapsed get_timer microseconds to milliseconds for the performance UI */
		var composite_elapsed_ms = (get_timer() - composite_started_at) / 1000;

		/* Store this sample as drawing_composite_last_ms, the latest flattened-canvas update
		duration */
		global.drawing_composite_last_ms = composite_elapsed_ms;

		/* A missing or negative average has no prior usable sample, so initialize it with this
		elapsed duration */
		if (!variable_global_exists("drawing_composite_average_ms")
		|| global.drawing_composite_average_ms < 0)
		{
			global.drawing_composite_average_ms = composite_elapsed_ms;
		}

		/* An existing nonnegative average retains 90 percent of its previous value and mixes
		10 percent of this sample to smooth frame-to-frame variation */
		else
		{
			global.drawing_composite_average_ms = global.drawing_composite_average_ms * 0.90 + composite_elapsed_ms * 0.10;
		}

		/* Initialize the peak with this first sample if absent. Otherwise retain the larger of
		the previous peak and current milliseconds */
		global.drawing_composite_peak_ms = variable_global_exists("drawing_composite_peak_ms")
			? max(global.drawing_composite_peak_ms, composite_elapsed_ms)
			: composite_elapsed_ms;
		scr_ui_perf_record("drawing.composite", composite_elapsed_ms);
		return true;
	}

	/// @description Create a missing legacy command target and prepare its owned surface
	/// @param {Struct} command Validated drawing command with tool, brush, color, and world geometry
	/// @returns {Real} Current stored layer index, or noone when surface setup fails
	ensure_command_layer = function(command)
	{
		ensure_default_layers();

		/* Resolve the command's stable target ID, using the active-layer compatibility
		fallback when omitted */
		var layer_id = command_layer_id(command);

		/* Look up that stable ID's current position in the stored stack */
		var layer_index = layer_index_from_id(layer_id);

		/* A command may reference a legacy layer without an add item, so create the missing
		layer and advance the allocation counter. Existing layers are retained */
		if (layer_index == noone)
		{
			/* Create a visible empty matching layer with its default label before appending it
			to the client stack */
			var new_layer = make_layer_struct(layer_id, layer_default_name(layer_id), true);
			layers[array_length(layers)] = new_layer;
			next_layer_id = max(next_layer_id, layer_id + 1);
			layer_index = array_length(layers) - 1;
		}

		/* A target without an available owned surface cannot receive this command, so return
		noone */
		if (!ensure_layer_surface(layer_index))
		{
			return noone;
		}

		return layer_index;
	}

	/// @description Insert client layer state at a clamped position and advance local ID allocation
	/// @param {Struct} paint_layer Client layer state and its owned optional surface
	/// @param {Real} layer_index Zero-based stored client layer index or requested insertion index
	/// @returns {Real} Actual inserted zero-based stack index
	insert_layer_at = function(paint_layer, layer_index)
	{
		/* Clamp the whole-number insertion position to the inclusive array-insertion range,
		allowing append at the current length */
		var insert_index = clamp(floor(real(layer_index)), 0, array_length(layers));
		array_insert(layers, insert_index, paint_layer);
		next_layer_id = max(next_layer_id, paint_layer.id + 1);
		layer_composite_dirty = true;
		return insert_index;
	}

	/// @description Replay structural layer changes while preserving local visibility and resource ownership
	/// @param {Struct} item Accepted history record or tagged layer operation
	/// @returns {Bool} Whether stack state changed, including structural additions with failed pixel allocation
	apply_layer_history_item = function(item)
	{
		/* Only tagged layer history can change the client stack through this handler, so
		reject other records */
		if (!history_item_is_layer(item))
		{
			return false;
		}

		ensure_default_layers();

		/* Track whether this operation actually changed stack state, starting false for
		ignored or unavailable targets */
		var changed = false;

		/* Dispatch layer creation, duplication, deletion, movement, archiving, restoration,
		and the intentionally ignored legacy visibility operation */
		switch (item.op)
		{
			/* Add creates a new layer and prepares its owned surface at the requested stack
			position */
			case DRAW_LAYER_ADD:
			{
				/* Only an absent stable ID is added so replaying an already applied add cannot
				duplicate the layer */
				if (layer_index_from_id(item.layer_id) == noone)
				{
					/* Create the new client layer with the operation's name, legacy initial
					visibility, and author stewardship */
					var add_layer = make_layer_struct(item.layer_id, item.name, item.visible, command_author_name(item));

					/* Retain its clamped inserted index for surface allocation */
					var added_index = insert_layer_at(add_layer, item.index);
					ensure_layer_surface(added_index);
					changed = true;
				}
				break;
			}

			/* Duplicate creates a separately owned target layer and copies available source
			pixels into it */
			case DRAW_LAYER_DUPLICATE:
			{
				/* An existing target ID is preserved. Only an absent target enters duplication */
				if (layer_index_from_id(item.layer_id) == noone)
				{
					/* Create a new target layer with its own stable ID, name, visibility, and
					stewardship */
					var duplicate_layer = make_layer_struct(item.layer_id, item.name, item.visible, command_author_name(item));

					/* Keep the duplicate's inserted index for target surface setup */
					var duplicate_index = insert_layer_at(duplicate_layer, item.index);

					/* Copying requires the duplicate's owned surface to be allocated. Failure
					still leaves the structural layer added without a pixel copy */
					if (ensure_layer_surface(duplicate_index))
					{
						/* Resolve the source layer's stable ID after the target insertion,
						because insertion may have shifted its old stack index */
						var source_index = layer_index_from_id(item.source_layer_id);

						/* A known source with an available surface supplies copied pixels. A
						missing or unavailable source leaves the new duplicate surface empty */
						if (source_index != noone && ensure_layer_surface(source_index))
						{
							surface_set_target(layers[duplicate_index].surface);
							draw_clear_alpha(c_black, 0);
							draw_surface(layers[source_index].surface, 0, 0);
							surface_reset_target();
						}
					}
					changed = true;
				}
				break;
			}

			/* Delete releases an existing layer's owned surface and removes its stack entry
			while retaining at least one stored layer */
			case DRAW_LAYER_DELETE:
			{
				/* Resolve the requested stable target into its current stored index */
				var delete_index = layer_index_from_id(item.layer_id);

				/* Only a known target in a stack with another layer can be deleted. Missing
				targets and the final stored layer are retained */
				if (delete_index != noone && array_length(layers) > 1)
				{
					/* Remember whether the deleted layer was selected so its local
					pixel-selection state can be cleared afterward */
					var deleting_active_layer = active_layer_id == item.layer_id;
					delete_layer_surface_value(layers[delete_index].surface);
					array_delete(layers, delete_index, 1);

					/* If deletion removed the selected ID, repair the active selection before
					future drawing targets it */
					if (layer_index_from_id(active_layer_id) == noone)
					{
						active_layer_id = noone;
						active_layer_index();
					}

					/* A selection tied to the deleted active layer is no longer meaningful, so
					clear its rectangle and preview resources */
					if (deleting_active_layer)
					{
						clear_selection();
					}
					changed = true;
				}
				break;
			}

			/* Move retains the layer struct and owned surface while changing only its stored
			stack position */
			case DRAW_LAYER_MOVE:
			{
				/* Resolve the moved stable ID before removing its current stack entry */
				var move_index = layer_index_from_id(item.layer_id);

				/* Only a known layer can be moved. Missing IDs leave stack order unchanged */
				if (move_index != noone)
				{
					/* Retain the moved layer struct while its old array entry is removed, then
					reinsert the same owned state */
					var move_layer = layers[move_index];
					array_delete(layers, move_index, 1);
					insert_layer_at(move_layer, clamp(item.index, 0, array_length(layers)));
					changed = true;
				}
				break;
			}

			/* Archive hides a retained layer from the active stack without deleting its
			surface pixels */
			case DRAW_LAYER_ARCHIVE:
			{
				/* Resolve the archive target by stable ID before reading its current state */
				var archive_index = layer_index_from_id(item.layer_id);

				/* Archive only a known currently active layer while another active layer
				remains, preserving at least one usable drawing target */
				if (archive_index != noone
				&& !layer_is_archived(layers[archive_index])
				&& active_layer_count() > 1)
				{
					layers[archive_index].archived = true;
					layers[archive_index].archive_sequence = next_layer_archive_sequence;
					next_layer_archive_sequence++;

					/* If the archived layer was selected, clear its selection and choose
					another active target */
					if (active_layer_id == item.layer_id)
					{
						clear_selection();
						active_layer_id = noone;
						active_layer_index();
					}
					changed = true;
				}
				break;
			}

			/* Restore reactivates the retained layer and clears its archive chronology marker */
			case DRAW_LAYER_RESTORE:
			{
				/* Resolve the restore target's current stored index */
				var restore_index = layer_index_from_id(item.layer_id);

				/* Only a known archived layer changes state here. Unknown or already active
				layers remain unchanged */
				if (restore_index != noone && layer_is_archived(layers[restore_index]))
				{
					layers[restore_index].archived = false;
					layers[restore_index].archive_sequence = 0;
					changed = true;
				}
				break;
			}

			/* Ignore visibility history because each client owns its visibility choices.
			Record that compatibility decision without changing the layer */
			case DRAW_LAYER_VISIBILITY:
			{
				debug_note("layer visibility ignored", "visibility is client-local");
				break;
			}
		}

		/* Only an actual stack-state change advances the local ID floor and marks the
		flattened canvas dirty */
		if (changed)
		{
			next_layer_id = max(next_layer_id, item.layer_id + 1);
			layer_composite_dirty = true;
		}

		return changed;
	}

	/// @description Capture optional undo pixels and apply a validated command to its owned layer surface
	/// @param {Struct} command Validated drawing command with tool, brush, color, and world geometry
	/// @returns {Bool} Whether immediate rendering or fill startup/completion succeeded
	apply_command_to_surface = function(command)
	{
		/* A failed canvas setup counts an application failure and skips the command before
		choosing its target layer */
		if (!ensure_surface())
		{
			debug_apply_failures++;
			debug_note("apply failed", "surface unavailable");
			return false;
		}

		/* Ensure the command's stable target layer exists and has a live owned surface */
		var layer_index = ensure_command_layer(command);

		/* An unavailable target counts an application failure and prevents pixel drawing or
		patch capture */
		if (layer_index == noone)
		{
			debug_apply_failures++;
			debug_note("apply failed", "layer unavailable");
			return false;
		}

		/* Borrow the target layer's owned surface for the command and its pre-command undo
		snapshot */
		var target_surface = layers[layer_index].surface;
		capture_undo_patch_for_item(command, layer_index);

		/* Fill commands use progressive sampling and span work rather than immediate primitive
		rendering */
		if (command.tool_id == DRAW_TOOL_FILL)
		{
			/* Retain whether shared fill startup accepted this command */
			var fill_started = apply_fill_command(command, target_surface);

			/* Only a started fill in forced synchronous replay must finish immediately. Normal
			progressive replay returns its startup result and advances in later updates */
			if (fill_started && fill_force_synchronous_replay)
			{
				return finish_replay_fill_if_needed();
			}
			return fill_started;
		}

		surface_set_target(target_surface);

		/* Selection-clear commands use their own rectangle-removal rendering, independent of
		brush color */
		if (command.tool_id == DRAW_TOOL_SELECT)
		{
			draw_command_clear_rectangle(command);
		}

		/* Other commands apply brush blend/color state, dispatch their primitive, and restore
		ordinary draw blending afterward */
		else
		{
			begin_command_blend(command);

			/* Rectangle draws four outline strips, circle draws its ellipse/radius path, and
			text renders its contents. Remaining accepted pen, eraser, and line commands
			share the rounded line renderer */
			switch (command.tool_id)
			{
				case DRAW_TOOL_RECTANGLE:
					draw_command_rectangle(command);
					break;
				case DRAW_TOOL_CIRCLE:
					draw_command_circle(command);
					break;
				case DRAW_TOOL_TEXT:
					draw_command_text(command);
					break;
				default:
					draw_command_line(command);
					break;
			}

			end_command_blend();
		}

		surface_reset_target();
		debug_apply_count++;
		debug_last_command = command;
		layer_composite_dirty = true;
		debug_surface_status = "applied on layer " + string(layers[layer_index].id);
		return true;
	}

	/// @description Require ordinary visible primitives with suspended patch capture and no asynchronous replay barriers
	/// @param {Struct} item Accepted history record or tagged layer operation
	/// @returns {Bool} Whether the item may reuse an active layer render target
	history_item_can_use_fast_batch = function(item)
	{
		/* Fast batching requires suspended patch capture, a structured locally visible
		ordinary command, no fill tool, and no active fill or pending image barrier. Layer,
		undo, and image records need their dedicated ordered paths */
		return undo_patch_capture_suspended
			&& is_struct(item)
			&& !history_item_is_layer(item)
			&& !history_item_is_undo(item)
			&& !history_item_is_image(item)
			&& variable_struct_exists(item, "tool_id")
			&& item.tool_id != DRAW_TOOL_FILL
			&& !history_item_is_blocked(item)
			&& !fill_job_active()
			&& array_length(pending_image_draws) <= 0;
	}

	/// @description Draw a validated nonfill primitive onto the caller's already active layer target
	/// @param {Struct} command Validated drawing command with tool, brush, color, and world geometry
	/// @param {Real} layer_index Zero-based stored client layer index or requested insertion index
	/// @returns {Bool} True after rendering and updating application diagnostics
	apply_fast_batched_command = function(command, layer_index)
	{
		/* A batched selection-clear command uses rectangle removal on the caller's already
		active target */
		if (command.tool_id == DRAW_TOOL_SELECT)
		{
			draw_command_clear_rectangle(command);
		}

		/* Other batched primitives use command brush/color blending without setting or
		resetting the caller's target surface */
		else
		{
			begin_command_blend(command);

			/* Dispatch batched rectangles, circles, and text to their geometry helpers.
			Remaining accepted ordinary tools use rounded lines */
			switch (command.tool_id)
			{
				case DRAW_TOOL_RECTANGLE:
					draw_command_rectangle(command);
					break;
				case DRAW_TOOL_CIRCLE:
					draw_command_circle(command);
					break;
				case DRAW_TOOL_TEXT:
					draw_command_text(command);
					break;
				default:
					draw_command_line(command);
					break;
			}
			end_command_blend();
		}

		debug_apply_count++;
		debug_last_command = command;
		layer_composite_dirty = true;
		debug_surface_status = "batch applied on layer " + string(layers[layer_index].id);
		return true;
	}

	/// @description Apply ordered history with reusable targets for eligible primitives and dedicated paths for other records
	/// @param {Any} history_items Ordered history-item array, with nonarray input treated as no work
	/// @returns {Bool} Whether canvas setup and all fast-path target setup succeeded, without aggregating general-path results
	apply_history_items_to_surfaces_batch = function(history_items)
	{
		/* A nonarray or empty batch has no replay work and succeeds without changing surfaces */
		if (!is_array(history_items) || array_length(history_items) <= 0)
		{
			return true;
		}

		/* An unavailable canvas cannot support history application, so count a failure and
		return false before the batch loop */
		if (!ensure_surface())
		{
			debug_apply_failures++;
			debug_note("history batch failed", "surface unavailable");
			return false;
		}

		/* target_active starts false because the batch has not yet selected a layer surface */
		var target_active = false;

		/* target_layer_index starts noone until a reusable active batch target is chosen */
		var target_layer_index = noone;

		/* Assume fast-path targets can all be prepared, retaining false if any target setup
		fails. General-path application results are not accumulated by this flag */
		var applied_all = true;

		/* Visit supplied history items from index zero in their ordered replay sequence */
		for (var item_index = 0; item_index < array_length(history_items); item_index++)
		{
			/* Borrow this current item to choose between safe primitive batching and the
			dedicated history path */
			var item = history_items[item_index];

			/* Eligible ordinary primitives keep a same-layer surface target active across
			adjacent items, avoiding repeated target setup */
			if (history_item_can_use_fast_batch(item))
			{
				/* Resolve the desired stable layer ID into its current stored index before
				considering target reuse */
				var desired_layer_index = layer_index_from_id(command_layer_id(item));

				/* A missing or incorrectly sized target needs command-layer setup. Release any
				active batch target first so setup can manage its own surface operations
				safely */
				if (desired_layer_index == noone
				|| !layer_surface_matches_room(layers[desired_layer_index].surface))
				{
					/* Reset a current render target only when one is active before ensuring a
					missing or resized layer */
					if (target_active)
					{
						surface_reset_target();
						target_active = false;
						target_layer_index = noone;
					}
					desired_layer_index = ensure_command_layer(item);
				}

				/* Failed target setup records a fast-path failure and continues with the
				remaining history items, leaving applied_all false */
				if (desired_layer_index == noone)
				{
					debug_apply_failures++;
					debug_note("history batch failed", "layer unavailable");
					applied_all = false;
					continue;
				}

				/* Select a new surface only when no batch target is active or this command
				targets a different layer. Same-layer adjacent commands reuse the target */
				if (!target_active || target_layer_index != desired_layer_index)
				{
					/* Reset an earlier active target before switching to the new layer surface */
					if (target_active)
					{
						surface_reset_target();
					}
					surface_set_target(layers[desired_layer_index].surface);
					target_active = true;
					target_layer_index = desired_layer_index;
				}

				apply_fast_batched_command(item, desired_layer_index);

				/* The primitive has been handled through the fast path, so skip the general
				history application for this same item */
				continue;
			}

			/* An item requiring a dedicated history path first releases the batch target so
			image, fill, and structural helpers can manage their own targets */
			if (target_active)
			{
				surface_reset_target();
				target_active = false;
				target_layer_index = noone;
			}
			apply_history_item_to_surface(item);
		}

		/* After the final item, reset a still-active batch target before restoring ordinary
		draw state */
		if (target_active)
		{
			surface_reset_target();
		}
		gpu_set_blendmode(bm_normal);
		draw_set_alpha(1);

		/* Refresh the flattened canvas only outside an ordered rebuild and when layer pixels
		changed. Clean or rebuilding canvases keep their previous composite until the owner
		permits rebuilding */
		if (!layer_surface_rebuild_active && layer_composite_dirty)
		{
			composite_layers();
		}
		return applied_all;
	}
	#endregion /* Primitive and Layer Rendering END */

	#region /* PNG Import and Async Image Replay */
	/// @description Check whether the current import feedback should still be displayed
	/// @returns {Bool} Whether nonempty status text remains within its display deadline
	image_import_status_is_visible = function()
	{
		/* Show import feedback only while it has text and its millisecond deadline has not
		passed */
		return server_import_status_text != "" && current_time <= server_import_status_until;
	}

	/// @description Set colored import feedback with a 5200 millisecond display lifetime
	/// @param {Any} message Import feedback converted to text
	/// @param {Color} colour Feedback text color. Defaults to c_white
	set_server_import_status = function(message, colour = c_white)
	{
		server_import_status_text = string(message);
		server_import_status_color = colour;
		server_import_status_until = current_time + 5200;
	}

	/// @description Discard all displayed import diagnostics and reset their line count
	server_import_debug_clear = function()
	{
		server_import_debug_lines = [];
		server_import_debug_line_count = 0;
	}

	/// @description Shorten diagnostic text around an omission marker while retaining at least eight characters at each end
	/// @param {Any} text Diagnostic value converted to text
	/// @param {Real} max_chars Desired character ceiling before minimum retained ends
	/// @returns {String} Original text or its retained beginning and ending, which can exceed a small requested limit
	server_import_debug_shorten = function(text, max_chars)
	{
		/* Convert the diagnostic value to text before measuring or taking its leading and
		trailing characters */
		var line = string(text);

		/* Keep text that already fits so short diagnostic lines remain intact */
		if (string_length(line) <= max_chars)
		{
			return line;
		}

		/* Reserve the leading portion around the five-character omission marker, retaining at
		least eight characters */
		var head_chars = max(8, floor((max_chars - 5) * 0.5));

		/* Reserve the trailing portion to preserve filenames and error endings, also retaining
		at least eight characters */
		var tail_chars = max(8, max_chars - 5 - head_chars);
		return string_copy(line, 1, head_chars) + " ... " + string_copy(line, string_length(line) - tail_chars + 1, tail_chars);
	}

	/// @description Append a bounded import diagnostic or replace the final panel line with an omission notice
	/// @param {Any} label Diagnostic label converted to text
	/// @param {Any} value Optional detail converted to text. Defaults to ""
	server_import_debug_add = function(label, value = "")
	{
		/* Begin the debug line with its label, adding a value only when one was provided */
		var line = string(label);

		/* A nonempty value gets a colon separator so labels without values do not end with
		unused punctuation */
		if (string(value) != "")
		{
			line += ": " + string(value);
		}
		line = server_import_debug_shorten(line, 72);

		/* Append while the fixed debug panel has room for another line */
		if (server_import_debug_line_count < server_import_debug_max_lines)
		{
			server_import_debug_lines[server_import_debug_line_count] = line;
			server_import_debug_line_count++;
		}

		/* Once the panel is full, use its last line to make the omitted diagnostics visible */
		else
		{
			server_import_debug_lines[server_import_debug_max_lines - 1] = "... more import debug lines omitted";
		}
	}

	/// @description Extract exception text and append extended runtime details when supplied
	/// @param {Any} error_value Thrown value or exception struct
	/// @returns {String} Human-readable diagnostic text
	server_import_debug_error_message = function(error_value)
	{
		/* Use a structured exception's message when available, otherwise stringify the
		exception itself */
		var message = is_struct(error_value) && variable_struct_exists(error_value, "message") ? string(error_value.message) : string(error_value);

		/* Include the runtime's extended message when present so filesystem failures retain
		their extra context */
		if (is_struct(error_value) && variable_struct_exists(error_value, "longMessage"))
		{
			message += " | " + string(error_value.longMessage);
		}

		return message;
	}

	/// @description Resolve the normalized import cache directory beneath the current save root
	/// @returns {String} Import folder path, or an empty string for a filename-only save context
	image_import_temp_folder = function()
	{
		/* An empty save root uses filenames directly instead of constructing an import
		subdirectory */
		if (string(game_save_id) == "")
		{
			return "";
		}

		return screenshot_normalize_path(screenshot_path_join(game_save_id, image_import_folder_name));
	}

	/// @description Prepare the import cache directory and report filesystem readiness
	/// @returns {Bool} Whether the directory exists or no directory is needed
	ensure_image_import_folder = function()
	{
		/* Resolve the import cache directory for this runner's save root */
		var folder_path = image_import_temp_folder();

		/* The filename-only save context needs no directory to create */
		if (folder_path == "")
		{
			return true;
		}

		try
		{
			/* Create the cache only when absent, leaving an existing import directory
			available for reuse */
			if (!directory_exists(folder_path))
			{
				directory_create(folder_path);
			}
		}

		/* A directory creation exception is reported and prevents callers from assuming the
		cache is ready */
		catch(e)
		{
			debug_error("Could not create drawing import cache folder: " + string(e.message));
			return false;
		}

		/* Confirm the directory exists after the creation attempt rather than treating the
		attempt itself as success */
		return directory_exists(folder_path);
	}

	/// @description Build an image-ID-and-clock-based temporary PNG cache path
	/// @param {Real} image_id History image identity used to distinguish temporary filenames
	/// @returns {String} PNG path without creating the file
	image_import_temp_path = function(image_id)
	{
		/* Give this temporary PNG a drawing prefix, image ID and millisecond timestamp to
		distinguish replay files */
		var filename = image_import_file_prefix + string(image_id) + "_" + string(current_time) + ".png";

		/* Resolve the cache root separately so runners without a save directory can use the
		filename alone */
		var folder_path = image_import_temp_folder();

		/* Return the temporary filename directly when there is no directory prefix */
		if (folder_path == "")
		{
			return filename;
		}

		return screenshot_path_join(folder_path, filename);
	}

	/// @description Extract the final filename component from either supported slash style
	/// @param {String} file_path Path whose filename component is needed
	/// @returns {String} Filename text after the final separator
	image_name_from_path = function(file_path)
	{
		/* Normalize the supplied path before locating its final filename component */
		var text = screenshot_normalize_path(file_path);

		/* Zero means no directory separator has been encountered yet */
		var slash = 0;

		/* Walk the string's one-based character positions and retain the last separator,
		including either slash style */
		for (var i = 1; i <= string_length(text); i++)
		{
			/* Inspect this character to distinguish separators from filename text */
			var ch = string_char_at(text, i);

			/* Each separator replaces the remembered position so nested folders do not become
			part of the filename */
			if (ch == "/" || ch == "\\")
			{
				slash = i;
			}
		}

		/* Keep a bare filename intact, otherwise return only the characters after the final
		separator */
		return slash <= 0 ? text : string_copy(text, slash + 1, string_length(text) - slash);
	}

	/// @description Trim pasted path text, remove matching outer quotes and normalize its separators
	/// @param {Any} raw_path Pasted path text that may contain whitespace and enclosing quotes
	/// @returns {String} Cleaned path without checking file existence
	image_import_clean_path = function(raw_path)
	{
		/* Trim pasted path text before stripping a matching pair of surrounding quotes */
		var text = string_trim(string(raw_path));

		/* Record the character count to locate both ends safely */
		var length = string_length(text);

		/* Only a path with at least two characters can contain a pair of enclosing quotes */
		if (length >= 2)
		{
			/* Read the first character to identify a possible quoted path */
			var first = string_char_at(text, 1);

			/* Read the last character to require the same closing quote style */
			var last = string_char_at(text, length);

			/* Remove matching single or double outer quotes while retaining all characters
			inside them */
			if ((first == "\"" && last == "\"")
			|| (first == "'" && last == "'"))
			{
				text = string_copy(text, 2, length - 2);
			}
		}

		return screenshot_normalize_path(text);
	}

	/// @description Replace a desktop PNG cache copy through the supported platform copy path
	/// @param {String} source_path Selected source PNG path
	/// @param {String} cache_path Destination cache PNG path
	/// @returns {Bool} Whether the destination exists after copying, or an already matching path exists
	image_import_copy_to_cache = function(source_path, cache_path)
	{
		/* Both paths must be supplied before copying or replacing a cache file */
		if (source_path == "" || cache_path == "")
		{
			return false;
		}

		try
		{
			/* Compare normalized source text without letter case to recognize a source already
			addressed as the cache */
			var source_compare = string_lower(screenshot_normalize_path(source_path));

			/* Normalize the cache path in the same way so its comparison uses the same
			spelling rules */
			var cache_compare = string_lower(screenshot_normalize_path(cache_path));

			/* A matching path is already cached, avoiding deletion of the file that would also
			be the source */
			if (source_compare == cache_compare)
			{
				/* For matching paths, readiness depends on the existing cache file */
				return file_exists(cache_path);
			}

			/* Remove a previous cache copy so the selected source replaces it */
			if (file_exists(cache_path))
			{
				file_delete(cache_path);
			}

			/* Choose the platform's copy mechanism because desktop runners expose external
			files differently */
			switch (os_type)
			{
				/* Windows copies binary contents through a blocking command so loading starts
				after the copy completes */
				case os_windows:

					/* Quote the source as a Windows command argument so spaces remain part of
					the path */
					var source_arg = scr_desktop_folder_windows_quote(source_path);

					/* Quote the cache destination independently for the same command */
					var cache_arg = scr_desktop_folder_windows_quote(cache_path);
					execute_program("cmd.exe", "copy /Y /B " + source_arg + " " + cache_arg, true);
					break;

				/* macOS uses a blocking native copy and passes paths as separately quoted
				arguments */
				case os_macosx:

					/* Quote the source for POSIX argument parsing before invoking the native
					copy */
					var mac_source_arg = scr_desktop_folder_posix_quote(source_path);

					/* Quote the destination for the same POSIX invocation */
					var mac_cache_arg = scr_desktop_folder_posix_quote(cache_path);
					execute_program("cp", "-f -- " + mac_source_arg + " " + mac_cache_arg, true);
					break;

				/* Linux can copy through the runner's file API here */
				case os_linux:
					file_copy(source_path, cache_path);
					break;

				/* Unsupported runners cannot prepare this desktop cache through these copy
				paths */
				default:
					return false;
			}

			/* Check that a destination file exists after copying, without claiming
			byte-for-byte verification */
			return file_exists(cache_path);
		}

		/* Report copy exceptions and return failure so the import can stop cleanly */
		catch(e)
		{
			/* Extract a structured error message when present, falling back to the thrown
			value's text */
			var error_message = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			debug_error("Could not copy imported PNG into cache: " + error_message);
			return false;
		}
	}

	/// @description Replace reserved filename characters and supply a PNG filename or extension when needed
	/// @param {Any} raw_name Filename text to sanitize
	/// @returns {String} Sanitized filename text
	image_import_sanitize_filename = function(raw_name)
	{
		/* Start with trimmed filename text, then replace path separators and reserved filename
		punctuation with underscores */
		var filename = string_trim(string(raw_name));
		filename = string_replace_all(filename, "\\", "_");
		filename = string_replace_all(filename, "/", "_");
		filename = string_replace_all(filename, ":", "_");
		filename = string_replace_all(filename, "*", "_");
		filename = string_replace_all(filename, "?", "_");
		filename = string_replace_all(filename, chr(34), "_");
		filename = string_replace_all(filename, "<", "_");
		filename = string_replace_all(filename, ">", "_");
		filename = string_replace_all(filename, "|", "_");

		/* An empty supplied name receives an image-ID-based PNG filename */
		if (filename == "")
		{
			filename = image_import_file_prefix + string(next_image_import_id) + ".png";
		}

		/* Use a lowercase comparison copy while preserving the displayed filename's original
		letter case */
		var lower_name = string_lower(filename);

		/* Assume the extension is absent until a complete four-character suffix can be checked */
		var has_png_extension = false;

		/* Short filenames cannot already contain the full PNG extension */
		if (string_length(lower_name) >= 4)
		{
			/* Recognize a trailing .png regardless of its original letter case */
			has_png_extension = string_copy(lower_name, string_length(lower_name) - 3, 4) == ".png";
		}

		/* Append .png only when the sanitized filename lacks that extension */
		if (!has_png_extension)
		{
			filename += ".png";
		}

		return filename;
	}

	/// @description Build a retained import-cache path using the selected source filename
	/// @param {String} source_path Selected source PNG path
	/// @returns {String} Cache path without creating the directory or copying a file
	image_import_cache_path = function(source_path)
	{
		/* Resolve the import directory used to retain the selected image */
		var folder_path = image_import_temp_folder();

		/* Keep only the source path's final component and sanitize it for the cache filename */
		var filename = image_import_sanitize_filename(image_name_from_path(source_path));
		return screenshot_path_join(folder_path, filename);
	}

	/// @description Read four caller-validated buffer bytes as an unsigned big-endian PNG integer
	/// @param {Buffer} source_buffer Borrowed buffer containing PNG bytes
	/// @param {Real} offset Zero-based byte offset with four readable bytes guaranteed by the caller
	/// @returns {Real} Unsigned 32-bit field value
	png_buffer_read_u32_be = function(source_buffer, offset)
	{
		return buffer_peek(source_buffer, offset, buffer_u8) * 16777216
			+ buffer_peek(source_buffer, offset + 1, buffer_u8) * 65536
			+ buffer_peek(source_buffer, offset + 2, buffer_u8) * 256
			+ buffer_peek(source_buffer, offset + 3, buffer_u8);
	}

	/// @description Inspect PNG signature and first IHDR fields without validating the full PNG contents
	/// @param {Buffer} source_buffer Borrowed buffer containing PNG bytes
	/// @returns {Struct} Header result with ok, pixel dimensions, image modes and a failure reason
	png_dimensions_from_buffer = function(source_buffer)
	{
		/* Reject absent buffers and headers shorter than the PNG signature plus complete first
		IHDR chunk */
		if (!buffer_exists(source_buffer)
		|| buffer_get_size(source_buffer) < 33)
		{
			/* The failed result carries ok=false, zero pixel dimensions and bit depth, unknown
			header mode values, and a diagnostic reason */
			return { ok: false, w: 0, h: 0, bit_depth: 0, color_type: -1, compression: -1, filter: -1, interlace: -1, reason: "file too small" };
		}

		/* Require all eight PNG signature bytes in order before interpreting this data as a
		PNG header */
		var valid_signature =
			buffer_peek(source_buffer, 0, buffer_u8) == 137
			&& buffer_peek(source_buffer, 1, buffer_u8) == 80
			&& buffer_peek(source_buffer, 2, buffer_u8) == 78
			&& buffer_peek(source_buffer, 3, buffer_u8) == 71
			&& buffer_peek(source_buffer, 4, buffer_u8) == 13
			&& buffer_peek(source_buffer, 5, buffer_u8) == 10
			&& buffer_peek(source_buffer, 6, buffer_u8) == 26
			&& buffer_peek(source_buffer, 7, buffer_u8) == 10;

		/* Require the first chunk's four-byte type to be IHDR, where PNG stores dimensions and
		image modes */
		var valid_ihdr =
			buffer_peek(source_buffer, 12, buffer_u8) == 73
			&& buffer_peek(source_buffer, 13, buffer_u8) == 72
			&& buffer_peek(source_buffer, 14, buffer_u8) == 68
			&& buffer_peek(source_buffer, 15, buffer_u8) == 82;

		/* The signature, IHDR type and 13-byte IHDR payload length must agree before reading
		its fields */
		if (!valid_signature || !valid_ihdr || png_buffer_read_u32_be(source_buffer, 8) != 13)
		{
			/* Return the same failure fields with an invalid-header reason so callers can
			display the rejection */
			return { ok: false, w: 0, h: 0, bit_depth: 0, color_type: -1, compression: -1, filter: -1, interlace: -1, reason: "invalid PNG header" };
		}

		/* Read the declared image width in pixels from the big-endian IHDR field */
		var png_w = png_buffer_read_u32_be(source_buffer, 16);

		/* Read the declared image height in pixels from the following big-endian IHDR field */
		var png_h = png_buffer_read_u32_be(source_buffer, 20);

		/* Read IHDR bit depth when its byte is present, otherwise use zero as the
		missing-value marker */
		var png_bit_depth = buffer_get_size(source_buffer) > 24 ? buffer_peek(source_buffer, 24, buffer_u8) : 0;

		/* Read the IHDR color mode when available, otherwise use -1 for an unknown mode */
		var png_color_type = buffer_get_size(source_buffer) > 25 ? buffer_peek(source_buffer, 25, buffer_u8) : -1;

		/* Read the IHDR compression method when available, otherwise retain the unknown marker */
		var png_compression = buffer_get_size(source_buffer) > 26 ? buffer_peek(source_buffer, 26, buffer_u8) : -1;

		/* Read the IHDR filter method when available, otherwise retain the unknown marker */
		var png_filter = buffer_get_size(source_buffer) > 27 ? buffer_peek(source_buffer, 27, buffer_u8) : -1;

		/* Read the IHDR interlace method when available, otherwise retain the unknown marker */
		var png_interlace = buffer_get_size(source_buffer) > 28 ? buffer_peek(source_buffer, 28, buffer_u8) : -1;

		/* Zero or negative declared pixel dimensions cannot describe a drawable image */
		if (png_w <= 0 || png_h <= 0)
		{
			/* Keep the parsed fields in the failed result so diagnostics can explain the
			invalid declared dimensions */
			return { ok: false, w: png_w, h: png_h, bit_depth: png_bit_depth, color_type: png_color_type, compression: png_compression, filter: png_filter, interlace: png_interlace, reason: "invalid PNG size" };
		}

		/* Return ok=true with pixel dimensions and IHDR modes plus an empty reason, indicating
		header checks passed rather than a full PNG integrity check */
		return { ok: true, w: png_w, h: png_h, bit_depth: png_bit_depth, color_type: png_color_type, compression: png_compression, filter: png_filter, interlace: png_interlace, reason: "" };
	}

	/// @description Wrap encoded PNG text in the data-URL prefix expected by supported sprite loaders
	/// @param {String} base64_text Base64-encoded PNG bytes without a data-URL prefix
	/// @returns {String} PNG Base64 data URL
	image_base64_data_url = function(base64_text)
	{
		return "data:image/png;base64," + string(base64_text);
	}

	/// @description Check sprite existence while treating runtime handle errors as a missing sprite
	/// @param {Any} sprite_value Potential sprite handle
	/// @returns {Bool} Whether the handle identifies a live sprite
	image_sprite_exists = function(sprite_value)
	{
		try
		{
			/* Report whether the runner recognizes this sprite handle as a live sprite
			resource */
			return sprite_exists(sprite_value);
		}

		/* Invalid handles that raise a runtime exception are treated as missing sprites */
		catch(e)
		{
			return false;
		}
	}

	/// @description Determine whether imported images must wait for browser Image Loaded events
	/// @returns {Bool} Whether this runner uses browser storage and asynchronous data-URL loading
	image_sprite_loads_async = function()
	{
		/* Only browser data-URL sprites use the asynchronous Image Loaded path.
		Unix runners treat a data URL as a sandboxed filename, so those builds
		decode to a short-lived local PNG in image_base64_to_sprite instead */
		return screenshot_uses_browser_storage();
	}

	/// @description Decode and size-check a PNG header, transferring an accepted buffer to the caller
	/// @param {String} base64_text Base64-encoded PNG bytes without a data-URL prefix
	/// @returns {Buffer} Caller-owned decoded buffer, or noone after rejection and local cleanup
	image_buffer_from_base64 = function(base64_text)
	{
		/* Own the decoded buffer locally until validation succeeds, starting with no allocated
		resource */
		var source_buffer = noone;
		try
		{
			/* Measure Base64 characters against the maximum chunk count and characters per
			chunk before allocating decoded bytes */
			var encoded_length = string_length(string(base64_text));

			/* Empty or oversized encoded input is rejected before decoding */
			if (encoded_length <= 0 || encoded_length > image_import_max_chunks * image_chunk_size)
			{
				return noone;
			}
			source_buffer = buffer_base64_decode(string(base64_text));

			/* A decoder that returns no live buffer has produced no usable PNG data */
			if (is_undefined(source_buffer) || !buffer_exists(source_buffer))
			{
				return noone;
			}

			/* Inspect the decoded PNG header to obtain declared dimensions and rejection
			details */
			var png_info = png_dimensions_from_buffer(source_buffer);

			/* Accept only a valid header within the pixel-dimension limits and decoded-byte
			ceiling */
			if (png_info.ok && png_info.w <= image_import_max_sprite_dimension
			&& png_info.h <= image_import_max_sprite_dimension
			&& buffer_get_size(source_buffer) <= image_import_max_chunks * image_chunk_size * 0.75)
			{
				/* Transfer this accepted buffer to the caller, which must delete it after use */
				return source_buffer;
			}
		}

		/* A decoding or header-read exception falls through to cleanup and the same rejection
		result */
		catch(image_validation_error) { }

		/* Delete any locally owned buffer left after failed validation so malformed image data
		does not retain memory */
		if (!is_undefined(source_buffer) && buffer_exists(source_buffer))
		{
			buffer_delete(source_buffer);
		}
		return noone;
	}

	/// @description Create a temporary image sprite through the platform load path and release local buffers and files
	/// @param {Real} image_id History image identity used to distinguish temporary filenames
	/// @param {String} base64_text Base64-encoded PNG bytes without a data-URL prefix
	/// @returns {Sprite} Caller-owned sprite that may still load asynchronously, or noone after failure
	image_base64_to_sprite = function(image_id, base64_text)
	{
		/* Track ownership of the validated decoded buffer until the sprite-load attempt has
		completed */
		var source_buffer = noone;

		/* An empty temporary path means this load has not created a desktop PNG that needs
		deletion */
		var temp_path = "";

		/* Start without a sprite, returning noone if preparation or loading fails */
		var decoded_sprite = noone;
		try
		{
			source_buffer = image_buffer_from_base64(base64_text);

			/* Stop the sprite load when decoding or size validation did not produce a live
			buffer */
			if (!buffer_exists(source_buffer))
			{
				throw "PNG exceeds the drawing image size limits or has an invalid header.";
			}

			/* Build the PNG data URL used by browser loading and runners that accept this
			representation */
			var data_url = image_base64_data_url(base64_text);

			/* Browser storage loads the data URL asynchronously and hands its sprite to the
			Image Loaded path */
			if (image_sprite_loads_async())
			{
				decoded_sprite = sprite_add_ext(data_url, 1, 0, 0, true);
			}

			/* Unix desktop runners need a temporary PNG filename for synchronous sprite
			loading */
			else if (os_type == os_linux || os_type == os_macosx)
			{
				/* Use the image ID, millisecond clock and random suffix for this short-lived
				file in the runtime's temporary directory */
				temp_path = screenshot_path_join(temp_directory,
					"JonnilOnline_HistoryImage_" + string(image_id) + "_" + string(current_time)
					+ "_" + string(irandom(999999999)) + ".png");
				buffer_save(source_buffer, temp_path);

				/* A missing saved file cannot be handed to the Unix sprite loader */
				if (!file_exists(temp_path))
				{
					throw "Could not prepare the imported drawing PNG.";
				}

				/* A local file is loaded synchronously by the Unix desktop runner. Never
				pass the potentially multi-megabyte data URL as a filename: the Linux
				runner copies filenames into a fixed-size native path buffer */
				decoded_sprite = sprite_add(temp_path, 1, false, false, 0, 0);
			}

			/* Other runners load this PNG data URL through the synchronous sprite API */
			else
			{
				decoded_sprite = sprite_add(data_url, 1, false, false, 0, 0);
			}
		}

		/* Expose loading errors in diagnostics and return no sprite after a failed attempt */
		catch(e)
		{
			/* Read a structured load error's message when available, otherwise use the thrown
			value's text */
			var decode_message = is_struct(e) && variable_struct_exists(e, "message")
				? string(e.message)
				: string(e);
			debug_error("Could not decode imported drawing image: " + decode_message);
			decoded_sprite = noone;
		}

		/* Release the decoded buffer after either load path because the sprite no longer needs
		this local buffer */
		if (!is_undefined(source_buffer) && buffer_exists(source_buffer))
		{
			buffer_delete(source_buffer);
		}

		/* Delete a temporary desktop PNG only when this attempt created a path and the file
		still exists */
		if (temp_path != "" && file_exists(temp_path))
		{
			/* Temporary-file deletion is best effort so cleanup errors do not replace the
			sprite-loading result */
			try { file_delete(temp_path); } catch(delete_error) { }
		}
		return decoded_sprite;
	}

	/// @description Draw a borrowed image sprite on its target layer, capture undo pixels and invalidate the composite
	/// @param {Struct} item Ordered image or drawing history item
	/// @param {Sprite} spr Temporary sprite, borrowed for drawing and transferred to the queue when enqueued
	/// @returns {Bool} Whether rendering reached the layer surface
	draw_image_sprite_to_surface = function(item, spr)
	{
		/* Require an image history item and a live sprite before drawing or altering layer
		state */
		if (!history_item_is_image(item)
		|| !image_sprite_exists(spr))
		{
			return false;
		}

		/* Stop when the canvas surfaces cannot be prepared */
		if (!ensure_surface())
		{
			return false;
		}

		/* Use the image's explicit layer ID, falling back to layer 1 for older image history */
		var image_layer_id = variable_struct_exists(item, "layer_id") ? item.layer_id : 1;

		/* Resolve the stable layer ID to its current array position */
		var layer_index = layer_index_from_id(image_layer_id);

		/* An image targeting an unknown layer creates that layer at the end of the layer stack */
		if (layer_index == noone)
		{
			/* Create the missing visible layer with its standard name before inserting it */
			var new_layer = make_layer_struct(image_layer_id, layer_default_name(image_layer_id), true);
			layer_index = insert_layer_at(new_layer, array_length(layers));
		}

		/* Drawing needs a live surface for the resolved layer */
		if (!ensure_layer_surface(layer_index))
		{
			return false;
		}

		/* Clamp the source width to at least one pixel to keep scaling division defined */
		var sprite_w = max(1, sprite_get_width(spr));

		/* Clamp the source height to at least one pixel for the vertical scale calculation */
		var sprite_h = max(1, sprite_get_height(spr));

		/* Use a declared image placement width when supplied, otherwise the sprite's pixel
		width */
		var draw_w = variable_struct_exists(item, "w") ? max(1, item.w) : sprite_w;

		/* Use a declared image placement height when supplied, otherwise the sprite's pixel
		height */
		var draw_h = variable_struct_exists(item, "h") ? max(1, item.h) : sprite_h;

		/* Convert the placement width to a horizontal sprite scale */
		var sx = draw_w / sprite_w;

		/* Convert the placement height to a vertical sprite scale */
		var sy = draw_h / sprite_h;

		/* Smooth filtering is enabled only when the history item explicitly requests it */
		var smooth_filter = variable_struct_exists(item, "smooth_filter") && item.smooth_filter;

		/* Remember the caller's texture-filter state so this image's filtering does not affect
		later drawing */
		var restore_filter = gpu_get_texfilter();
		capture_undo_patch_for_item(item, layer_index);
		gpu_set_texfilter(smooth_filter);

		surface_set_target(layers[layer_index].surface);

		/* Recognize checkpoint images by their reserved name prefix and absence of author or
		undo identity */
		var checkpoint_image = string_pos("Canvas checkpoint - ", string(item.name)) == 1
			&& command_author_name(item) == ""
			&& command_undo_author_id(item) == 0
			&& command_undo_id(item) == 0;

		/* Authoritative checkpoint pixels use direct RGBA replacement while the existing note
		explains their non-overlapping layout */
		if (checkpoint_image)
		{
			/* Checkpoint regions/tiles are non-overlapping authoritative RGBA pixels.
			Copy them exactly so alpha is not multiplied again during restoration */
			gpu_set_blendmode_ext(bm_one, bm_zero);
		}

		/* Ordinary imported images blend over the layer's existing pixels */
		else
		{
			gpu_set_blendmode(bm_normal);
		}
		draw_set_alpha(1);
		draw_sprite_ext(spr, 0, item.x, item.y, sx, sy, 0, c_white, 1);
		surface_reset_target();
		gpu_set_texfilter(restore_filter);
		gpu_set_blendmode(bm_normal);
		draw_set_alpha(1);

		debug_apply_count++;
		layer_composite_dirty = true;
		debug_surface_status = "image imported " + string(draw_w) + "x" + string(draw_h);
		debug_note("image imported", item.name);
		return true;
	}

	/// @description Transfer a temporary sprite to the pending image queue for later rendering and deletion
	/// @param {Struct} item Ordered image or drawing history item
	/// @param {Sprite} spr Temporary sprite, borrowed for drawing and transferred to the queue when enqueued
	/// @returns {Bool} True once the pending entry has been appended
	queue_pending_image_draw = function(item, spr)
	{
		/* Append this load at the next zero-based pending-image position */
		var pending_index = array_length(pending_image_draws);

		/* The entry keeps the image ID and history item with its owned temporary sprite,
		starts unready, and records the millisecond load start for timeout checks */
		pending_image_draws[pending_index] =
		{
			image_id: item.image_id,
			item: item,
			sprite: spr,
			ready: false,
			started_at: current_time
		};

		debug_surface_status = "image pending " + string(item.w) + "x" + string(item.h);
		debug_note("image pending", item.name + " sprite=" + string(spr));
		return true;
	}

	/// @description Draw a ready pending image or remove a failed or timed-out load, resuming history when possible
	/// @param {Real} pending_index Zero-based pending image queue index
	/// @returns {Bool} Whether this call drew the image
	apply_pending_image_draw_at = function(pending_index)
	{
		/* Ignore a stale or out-of-range pending index before accessing the queue */
		if (pending_index < 0 || pending_index >= array_length(pending_image_draws))
		{
			return false;
		}

		/* Borrow the pending entry while validating its required item and sprite fields */
		var pending = pending_image_draws[pending_index];

		/* Remove malformed entries so they cannot indefinitely hold ordered history behind an
		image load */
		if (!is_struct(pending)
		|| !variable_struct_exists(pending, "item")
		|| !variable_struct_exists(pending, "sprite"))
		{
			array_delete(pending_image_draws, pending_index, 1);
			resume_after_pending_image_draw();
			return false;
		}

		/* Borrow the queue-owned sprite handle until this entry is drawn or discarded */
		var spr = pending.sprite;

		/* A disappeared sprite removes this load, records a failure and allows deferred
		history to resume */
		if (!image_sprite_exists(spr))
		{
			array_delete(pending_image_draws, pending_index, 1);
			debug_apply_failures++;
			debug_note("image pending failed", "sprite disappeared");
			resume_after_pending_image_draw();
			return false;
		}

		/* Borrow the ordered image history item held by this pending entry */
		var item = pending.item;

		/* A browser sprite waits for its matching Image Loaded notification before drawing */
		if (image_sprite_loads_async()
		&& (!variable_struct_exists(pending, "ready") || !pending.ready))
		{
			/* Use the recorded load start for the timeout, falling back to this check's
			current millisecond time for an older entry without that field */
			var pending_started_at = variable_struct_exists(pending, "started_at")
				? pending.started_at
				: current_time;

			/* Discard a browser load when its recorded start plus the timeout reaches the
			current clock */
			if (current_time >= pending_started_at + image_pending_timeout_ms)
			{
				/* Delete a timed-out sprite only while the runner still recognizes the
				resource */
				if (image_sprite_exists(spr))
				{
					sprite_delete(spr);
				}
				array_delete(pending_image_draws, pending_index, 1);
				debug_apply_failures++;
				debug_note("image pending failed", "load timed out");
				resume_after_pending_image_draw();
			}

			/* Waiting and timed-out loads both report that no image was drawn by this call */
			return false;
		}

		/* Remove the ready entry before drawing so resuming deferred work does not see this
		load as still pending */
		array_delete(pending_image_draws, pending_index, 1);

		/* Record whether the image was actually drawn before releasing its temporary sprite */
		var applied = draw_image_sprite_to_surface(item, spr);
		sprite_delete(spr);
		resume_after_pending_image_draw();

		/* Return the drawing outcome rather than treating queue removal as a successful draw */
		return applied;
	}

	/// @description Poll pending sprites backwards so completed or failed entries can be removed safely
	/// @returns {Bool} Whether at least one image was drawn
	update_pending_image_draws = function()
	{
		/* Begin with no completed draws and set this flag only when a pending image reaches
		its layer */
		var applied_any = false;

		/* Visit pending entries backwards so removals do not shift an unvisited entry past its
		index */
		for (var pending_index = array_length(pending_image_draws) - 1; pending_index >= 0; pending_index--)
		{
			/* Only a successful draw contributes to the frame's applied-any result */
			if (apply_pending_image_draw_at(pending_index))
			{
				applied_any = true;
			}
		}

		/* Report whether at least one pending image was drawn during this update */
		return applied_any;
	}

	/// @description Append ordered history behind an outstanding image load
	/// @param {Struct} item Ordered image or drawing history item
	/// @returns {Bool} True once the item has been queued
	image_defer_history_item = function(item)
	{
		image_deferred_history_items[array_length(image_deferred_history_items)] = item;
		debug_note("drawing deferred during image load", history_item_payload_string(item));
		return true;
	}

	/// @description Drain deferred image history until the queue empties or a fill or image load blocks it
	/// @returns {Bool} Whether deferred items still remain
	apply_deferred_image_history_items = function()
	{
		/* Replay oldest deferred items only while neither a fill nor an image load blocks
		ordered surface changes */
		while (!fill_job_active()
		&& array_length(pending_image_draws) <= 0
		&& array_length(image_deferred_history_items) > 0)
		{
			/* Take the oldest deferred item before removing it from the queue and applying it */
			var item = image_deferred_history_items[0];
			array_delete(image_deferred_history_items, 0, 1);
			apply_history_item_to_surface(item);
		}

		/* Report whether deferred image history still waits for an earlier operation to finish */
		return array_length(image_deferred_history_items) > 0;
	}

	/// @description Resume deferred fill and image history after the final pending sprite is removed
	resume_after_pending_image_draw = function()
	{
		/* The last pending image releases the ordering barrier, allowing deferred fill and
		image history to run */
		if (array_length(pending_image_draws) <= 0)
		{
			apply_deferred_fill_history_items();
			apply_deferred_image_history_items();
		}
	}

	/// @description Match an Image Loaded event to this drawing queue and handle its success or failure
	/// @param {DS Map} load_map Borrowed Image Loaded event map, retained by the event owner
	/// @returns {Bool} Whether a matching pending entry was handled, including failed loads
	handle_image_loaded = function(load_map)
	{
		/* An Image Loaded event without a sprite ID cannot be matched to this drawing queue */
		if (!ds_map_exists(load_map, "id"))
		{
			return false;
		}

		/* Read the event's sprite handle to find the load this notification belongs to */
		var loaded_sprite = load_map[? "id"];

		/* Search the pending queue backwards because handling a match can remove its entry */
		for (var pending_index = array_length(pending_image_draws) - 1; pending_index >= 0; pending_index--)
		{
			/* Borrow the current pending entry for the sprite-ID match */
			var pending = pending_image_draws[pending_index];

			/* Skip malformed entries and sprite handles belonging to other image loads */
			if (!is_struct(pending)
			|| !variable_struct_exists(pending, "sprite")
			|| pending.sprite != loaded_sprite)
			{
				continue;
			}

			/* Use the event status when present, otherwise treat an omitted status as zero */
			var load_status = ds_map_exists(load_map, "status") ? load_map[? "status"] : 0;

			/* A negative loading status discards this sprite and releases history waiting
			behind it */
			if (load_status < 0)
			{
				/* Delete the failed load's sprite only when it still exists */
				if (image_sprite_exists(pending.sprite))
				{
					sprite_delete(pending.sprite);
				}
				array_delete(pending_image_draws, pending_index, 1);
				debug_apply_failures++;
				debug_note("image pending failed", "status=" + string(load_status));
				resume_after_pending_image_draw();

				/* Return handled=true for a matched failure, even though the image was not
				drawn */
				return true;
			}

			pending.ready = true;
			apply_pending_image_draw_at(pending_index);

			/* Return handled=true after marking the matched load ready and attempting its draw */
			return true;
		}

		/* No matching pending sprite leaves this event unhandled by the drawing subsystem */
		return false;
	}

	/// @description Decode and draw a PNG item or transfer its sprite to asynchronous replay
	/// @param {Struct} item Ordered image or drawing history item
	/// @returns {Bool} Whether the item was drawn synchronously or queued for an asynchronous draw
	apply_image_history_item_to_surface = function(item)
	{
		/* Only image history belongs in this PNG-specific application path */
		if (!history_item_is_image(item))
		{
			return false;
		}

		/* Decode the item's Base64 PNG into a temporary sprite owned by this application
		attempt */
		var spr = image_base64_to_sprite(item.image_id, item.base64);

		/* A missing decoded sprite records a failure without modifying the canvas */
		if (!image_sprite_exists(spr))
		{
			debug_apply_failures++;
			debug_note("image import failed", "sprite decode failed");
			return false;
		}

		/* Browser loads transfer sprite ownership to the pending queue until notification or
		timeout */
		if (image_sprite_loads_async())
		{
			return queue_pending_image_draw(item, spr);
		}

		/* Remember the synchronous drawing result before releasing the decoded sprite */
		var applied = draw_image_sprite_to_surface(item, spr);
		sprite_delete(spr);

		/* Return whether synchronous rendering reached the target layer */
		return applied;
	}

	/// @description Apply or defer an ordered history item. Pending images and fills must finish first
	/// @param {Struct} item Command, layer edit, undo, or PNG image history item
	/// @returns {Bool} Whether the item applied, started or queued work, or removed an undo group
	apply_history_item_to_surface = function(item)
	{
		/* A pending image keeps later history queued so subsequent drawing cannot overtake it */
		if (array_length(pending_image_draws) > 0)
		{
			return image_defer_history_item(item);
		}

		/* An active progressive fill holds later history behind that fill's surface changes */
		if (fill_job_active())
		{
			return fill_defer_history_item(item);
		}

		/* Undo items remove their identified client command group and replay the remaining
		history */
		if (history_item_is_undo(item))
		{
			/* Keep the removed commands to distinguish a real undo from an unknown or already
			removed group */
			var removed_group = remove_client_undo_group(item.undo_author_id, item.undo_id, true, false);
			debug_note("undo received", "removed " + string(array_length(removed_group)) + " command(s)");

			/* The undo succeeds only when its author and undo ID matched at least one command */
			return array_length(removed_group) > 0;
		}

		/* Structural layer history is applied through its own layer-state handler */
		if (history_item_is_layer(item))
		{
			return apply_layer_history_item(item);
		}

		/* Blocked authors' drawing is skipped before image decoding or primitive rendering */
		if (history_item_is_blocked(item))
		{
			debug_note("drawing skipped blocked author", command_author_name(item));
			return false;
		}

		/* PNG history uses the image-loading path because it may need asynchronous completion */
		if (history_item_is_image(item))
		{
			return apply_image_history_item_to_surface(item);
		}

		return apply_command_to_surface(item);
	}
	#endregion /* PNG Import and Async Image Replay END */

	#region /* Local Replay and Session Reset */
	/// @description Record and optimistically render a local primitive before server replication
	/// @param {Struct} command Validated local primitive or fill command
	/// @returns {Bool} Whether the primitive's local surface application succeeded
	apply_local_command = function(command)
	{
		debug_last_local_command = command;
		push_client_history(command);

		/* Keep the primitive application's result while the command is already recorded in
		local history */
		var applied = apply_command_to_surface(command);

		/* A successful local draw increments local-first diagnostics before any server echo */
		if (applied)
		{
			debug_local_apply_count++;
			debug_last_replication_status = "applied locally";
			debug_note("local-first applied", command_debug_string(command));
		}

		/* A failed surface application retains the recorded command and exposes the failure in
		replication diagnostics */
		else
		{
			debug_last_replication_status = "local apply failed";
			debug_note("local-first failed", "surface unavailable");
		}

		/* Report the actual local surface outcome to the submitting tool */
		return applied;
	}

	/// @description Record a local fill and start progressive rendering, rolling back its history insertion if startup fails
	/// @param {Struct} command Validated local primitive or fill command
	/// @returns {Bool} Whether the local fill job started
	begin_local_fill_command = function(command)
	{
		/* A local fill cannot begin without initialized canvas and layer surfaces */
		if (!ensure_surface())
		{
			debug_note("fill skipped", "surface unavailable");
			return false;
		}

		/* Resolve or create the command's target layer before capturing its undo pixels */
		var layer_index = ensure_command_layer(command);

		/* An unavailable layer stops the fill before adding it to local history */
		if (layer_index == noone)
		{
			debug_note("fill skipped", "layer unavailable");
			return false;
		}

		/* Remember the append position so a failed fill start can remove this newly recorded
		item */
		var history_index = array_length(client_history);
		push_client_history(command);
		capture_undo_patch_for_item(command, layer_index);

		/* Start a replicated local progressive fill and retain whether its runtime job was
		accepted */
		var started = begin_progressive_fill_command(command, layers[layer_index].surface, true, true, history_index);

		/* Undo the new history insertion when the fill could not start */
		if (!started)
		{
			/* Dispose and remove the appended entry only when that position still exists */
			if (array_length(client_history) > history_index)
			{
				dispose_item_undo_patch(client_history[history_index]);
				array_delete(client_history, history_index, 1);
				client_history_revision++;
				client_history_replay_restart = true;
			}

			debug_last_replication_status = "local fill failed";
			return false;
		}

		debug_local_apply_count++;
		debug_last_replication_status = "fill running locally";
		debug_note("local fill started", command_debug_string(command));
		return true;
	}

	/// @description Rebuild layers from client history while preserving local visibility and the active layer
	/// @returns {Bool} Whether the canvas existed and replay completed without an apply failure
	replay_client_history = function()
	{
		/* A full history rebuild needs an existing canvas surface to hold its final composite */
		if (!surface_exists(canvas_surface))
		{
			return false;
		}

		fill_abort_runtime();
		delete_pending_image_draws();

		/* Snapshot the failure counter so any new apply failure makes this rebuild
		unsuccessful */
		var replay_failure_count = debug_apply_failures;

		/* Keep the user's selected stable layer ID across recreation of the layer stack */
		var active_layer_snapshot = active_layer_id;

		/* Keep local layer visibility separately from replicated drawing history */
		var visibility_snapshot = layer_visibility_snapshot();

		/* Remember the enclosing rebuild flag so nested replay restores its caller's state */
		var restore_rebuild_active = layer_surface_rebuild_active;

		/* Remember whether undo-patch capture was already suspended before this rebuild */
		var restore_capture_suspended = undo_patch_capture_suspended;

		/* Remember the enclosing fill replay mode before temporarily requiring synchronous
		replay */
		var restore_force_synchronous_replay = fill_force_synchronous_replay;
		layer_surface_rebuild_active = true;
		undo_patch_capture_suspended = true;
		fill_force_synchronous_replay = true;
		reset_layer_stack_for_replay();

		/* Track whether the batch's surface setup and fast-path application succeeded */
		var batch_applied = apply_history_items_to_surfaces_batch(client_history);

		/* Require any fill started during replay to finish before returning the rebuild's
		outcome */
		var replay_complete = finish_replay_fill_if_needed();
		layer_surface_rebuild_active = restore_rebuild_active;
		undo_patch_capture_suspended = restore_capture_suspended;
		fill_force_synchronous_replay = restore_force_synchronous_replay;

		/* Visibility is local view state, so keep it across surface/history rebuilds
		without putting it into replicated drawing history */
		restore_layer_visibility_snapshot(visibility_snapshot);
		restore_active_layer_id(active_layer_snapshot);

		/* Composite only after leaving rebuild mode so nested operations do not display an
		incomplete stack */
		if (!layer_surface_rebuild_active)
		{
			composite_layers();
		}

		/* Replay succeeds when the batch and its final fill completed without increasing the
		application failure counter */
		return batch_applied
			&& replay_complete
			&& debug_apply_failures == replay_failure_count;
	}

	/// @description Ensure room-sized canvas and layer surfaces. Replay client history after creating the canvas
	/// @returns {Bool} Whether surface allocation and any required history replay succeeded
	ensure_surface = function()
	{
		/* Allocate a canvas at the room's pixel width, with a one-pixel minimum for valid
		surface dimensions */
		var target_width = max(1, room_width);

		/* Use the room's pixel height with the same allocation minimum */
		var target_height = max(1, room_height);

		/* Inspect an existing canvas before deciding whether its resource can be reused */
		if (surface_exists(canvas_surface))
		{
			/* A correctly sized canvas keeps its pixels and only verifies default layers and
			their surfaces */
			if (surface_get_width(canvas_surface) == target_width
			&& surface_get_height(canvas_surface) == target_height)
			{
				ensure_default_layers();

				/* Propagate layer allocation failure even when the main canvas already exists */
				return ensure_all_layer_surfaces();
			}

			/* Release a canvas whose dimensions no longer match the room before creating its
			replacement */
			delete_surface();
		}

		canvas_surface = surface_create(target_width, target_height);

		/* A failed allocation leaves no usable canvas and stops history replay */
		if (!surface_exists(canvas_surface))
		{
			canvas_surface = noone;
			debug_surface_status = "create failed " + string(target_width) + "x" + string(target_height);
			return false;
		}

		/* A join may defer the first composite until history replay finishes.
		Never display uninitialized texture contents during that wait */
		clear_surface();
		debug_surface_status = "created " + string(target_width) + "x" + string(target_height);

		/* Assume no replay is needed while an enclosing layer rebuild already owns
		reconstruction */
		var replayed = true;

		/* Outside an existing rebuild, restore the newly allocated canvas from client history */
		if (!layer_surface_rebuild_active)
		{
			replayed = replay_client_history();
		}

		/* Return whether the required replay succeeded after allocating and clearing the
		canvas */
		return replayed;
	}

	/// @description Free client drawing resources and clear session history, transfer queues, identity, and tool interaction state
	reset_client = function()
	{
		finish_client_history_sync_batch(false);
		delete_surface();
		free_toolbar_gradient_surfaces();

		/* Restore the default layer identities and archive sequence after releasing the
		previous session's surfaces */
		layers = [];
		active_layer_id = 1;
		next_layer_id = 2;
		next_layer_archive_sequence = 1;
		ensure_default_layers();

		/* Release history-owned undo patches before emptying history and all joining/replay
		state */
		dispose_history_items_undo_patches(client_history);
		client_history = [];
		client_history_revision++;
		client_history_replay = noone;
		client_history_replay_restart = false;
		pending_image_receives = [];
		client_history_sync_complete = false;
		client_history_sync_completion_received = false;
		client_history_sync_completion_required = false;
		client_history_sync_requires_replay = false;
		client_history_sync_notice_shown = false;
		client_history_sync_legacy_last_packet_at = 0;
		client_history_sync_started_at = 0;
		client_history_sync_batch_active = false;
		client_history_sync_restore_rebuild_active = false;
		client_history_sync_restore_patch_capture_suspended = false;

		/* Clear the session's vote dialog, move draft and panel scroll so previous layer
		actions do not carry into the next connection */
		client_layer_vote = noone;
		layer_vote_hover = "";
		layer_vote_mouse_capture = false;
		layer_move_draft_active = false;
		layer_move_draft_layer_id = 0;
		layer_move_draft_target_position = 0;
		layer_move_draft_original_position = 0;
		layer_move_draft_submitted = false;
		layers_panel_scroll = 0;

		/* Remove pending image resources and reset fill queues before reusing image IDs in a
		new session */
		delete_pending_image_draws();
		fill_active_job = noone;
		fill_deferred_history_items = [];
		next_client_image_id = 1;

		/* Clear player and undo identities, then release redo groups that belonged to the
		previous session */
		local_player_id = noone;
		local_player_name = "";
		local_undo_author_id = 0;
		next_local_undo_id = 1;
		active_undo_group_id = 0;
		clear_redo_stack();
		redo_stack = [];

		/* Reset millisecond action deadlines and outbound queues so the next session starts
		without inherited throttles */
		fill_cooldown_until = 0;
		stamp_cooldown_until = 0;
		undo_cooldown_until = 0;
		redo_cooldown_until = 0;
		pending_client_history_sends = [];
		client_image_send_chunk = 0;
		next_pending_history_send_time = 0;

		/* Restore opaque brush input and clear text, HSV editing, mode notices and selection
		state */
		brush_alpha = 255;
		text_entry_active = false;
		text_entry_text = "";
		hsv_input_active = "";
		hsv_input_text = "";
		draw_mode_enabled = false;
		draw_while_hidden = false;
		toolbar_mode_notice_enabled = false;
		toolbar_mode_notice_until = 0;
		fill_sample_visible_layers = false;
		clear_selection();

		/* Clear layer highlighting, drawing gestures, send timing and toolbar interactions at
		the session boundary */
		layer_blink_layer_id = 0;
		layer_blink_started_at = 0;
		is_drawing = false;
		sent_drag_command = false;
		next_send_time = 0;
		toolbar_dragging = false;
		toolbar_hidden = true;
		toolbar_hover = "";
		debug_note("client reset", "");
		debug_surface_status = "client reset";
	}

	/// @description Clear authoritative history, transfer jobs, votes, author slots, and server persistence timers
	/// @param {Bool} clear_persisted_history Whether to also delete the saved history and its recovery copies. Defaults to false
	reset_server = function(clear_persisted_history = false)
	{
		/* A server reset during checkpoint rendering must release the temporary client-side
		drawing state */
		if (server_history_checkpoint_in_progress)
		{
			clear_client_drawing_state();
		}

		/* Clear authoritative history and transfer jobs, then recreate per-client timing
		arrays and default server layer identities */
		server_history = [];
		server_history_sync_jobs = [];
		server_undo_author_slots = [];
		server_last_command_time = array_create(net.max_clients, 0);
		server_pending_image_receives = [];
		server_undo_cooldown_until = array_create(net.max_clients, 0);
		server_layer_action_cooldown_until = array_create(net.max_clients, 0);
		server_layer_vote_cooldown_until = array_create(net.max_clients, 0);
		server_layer_states = [];
		server_next_layer_id = 2;
		server_layer_stack_revision = 0;
		server_next_layer_vote_id = 1;
		server_active_layer_vote = noone;
		server_ensure_default_layer_state();

		/* Restart import identities and clear server menu hover and timed-feedback state */
		next_image_import_id = 1;
		server_import_hover = false;
		server_import_folder_hover = false;
		server_save_log_hover = false;
		server_logs_folder_hover = false;
		server_logs_auto_save_hover = false;
		server_import_status_text = "";
		server_import_status_until = 0;

		/* Reset server counters and last-operation diagnostics for the new authoritative
		session */
		debug_server_received_count = 0;
		debug_server_accept_count = 0;
		debug_server_reject_count = 0;
		debug_server_broadcast_count = 0;
		debug_server_broadcast_failures = 0;
		debug_server_last_slot = noone;
		debug_server_last_send_count = noone;
		debug_server_last_history_sync = noone;
		debug_server_last_history_slot = noone;
		debug_server_history_sync_jobs = 0;
		debug_server_history_sync_detail = "idle";

		/* Clear persistence deadlines and checkpoint snapshots so no save or checkpoint job
		from the old session resumes */
		server_history_persistence_dirty = false;
		server_history_persistence_dirty_since = 0;
		server_history_persistence_save_at = 0;
		server_history_persistence_retry_at = 0;
		server_history_persistence_loaded_count = 0;
		server_history_persistence_saved_count = 0;
		server_history_persistence_status = "not loaded";
		server_history_checkpoint_dirty = false;
		server_history_checkpoint_requested = false;
		server_history_checkpoint_in_progress = false;
		server_history_checkpoint_retry_at = 0;
		server_history_checkpoint_source_count = 0;
		server_history_checkpoint_layer_states = [];
		server_history_checkpoint_apply_failures = 0;
		server_history_checkpoint_next_image_id = next_image_import_id;
		server_history_checkpoint_status = "idle";

		/* Delete persisted history and recovery copies only when the caller explicitly
		requests that reset */
		if (clear_persisted_history)
		{
			delete_server_history_persistence();
		}
		debug_note("server reset", "");
	}
	#endregion /* Local Replay and Session Reset END */

	#region /* Ordered Client History Sync */
	/// @description Compare a provisional local drawing item with a received server echo using identity and drawing payload fields
	/// @param {Struct} first Provisional local history item to compare
	/// @param {Struct} second Received server history item
	/// @returns {Bool} Whether both items represent the same local drawing operation
	history_items_are_same_local_echo = function(first, second)
	{
		/* Local echo matching requires two structs, a provisional first item, the same
		positive undo-author/group identity, and both items attributed to this player */
		if (!is_struct(first) || !is_struct(second)
		|| (variable_struct_exists(first, "history_sync_authoritative") && first.history_sync_authoritative)
		|| command_undo_author_id(first) <= 0
		|| command_undo_author_id(first) != command_undo_author_id(second)
		|| command_undo_id(first) != command_undo_id(second)
		|| command_author_player_id(first) != local_player_id
		|| command_author_player_id(second) != local_player_id)
		{
			return false;
		}

		/* Image echoes need their own comparison because they do not share primitive tool
		fields */
		if (history_item_is_image(first) || history_item_is_image(second))
		{
			/* Match both image identities, target layer and placement rectangle before
			replacing an optimistic image with its server echo */
			return history_item_is_image(first)
				&& history_item_is_image(second)
				&& first.image_id == second.image_id
				&& first.layer_id == second.layer_id
				&& first.x == second.x
				&& first.y == second.y
				&& first.w == second.w
				&& first.h == second.h;
		}

		/* A non-image item without a tool ID cannot be compared as a primitive drawing echo */
		if (!variable_struct_exists(first, "tool_id")
		|| !variable_struct_exists(second, "tool_id"))
		{
			return false;
		}

		/* Primitive echoes must agree on tool, layer, color, opacity, brush size, endpoints,
		extra data, text and fill-sampling mode */
		return first.tool_id == second.tool_id
			&& command_layer_id(first) == command_layer_id(second)
			&& first.color_r == second.color_r
			&& first.color_g == second.color_g
			&& first.color_b == second.color_b
			&& command_alpha(first) == command_alpha(second)
			&& command_brush_px(first) == command_brush_px(second)
			&& first.from_x == second.from_x
			&& first.from_y == second.from_y
			&& first.to_x == second.to_x
			&& first.to_y == second.to_y
			&& command_extra_a(first) == command_extra_a(second)
			&& command_extra_b(first) == command_extra_b(second)
			&& command_text_value(first) == command_text_value(second)
			&& command_fill_sample_visible(first) == command_fill_sample_visible(second);
	}

	/// @description Replace a matching provisional local item with its authoritative echo at the current history tail
	/// @param {Struct} item Received drawing history item
	/// @returns {Bool} Whether a local copy was replaced and replay was requested
	reorder_client_local_echo_to_history_tail = function(item)
	{
		refresh_local_identity_from_client();

		/* Only this player's drawing items can replace optimistic local history, excluding
		layer edits and undo records */
		if (!is_struct(item)
		|| history_item_is_layer(item)
		|| history_item_is_undo(item)
		|| command_author_player_id(item) != local_player_id)
		{
			return false;
		}

		/* Search history backwards to find the most recent provisional copy of the echoed
		command */
		for (var history_index = array_length(client_history) - 1; history_index >= 0; history_index--)
		{
			/* Leave unrelated commands and already authoritative records in their existing
			positions */
			if (!history_items_are_same_local_echo(client_history[history_index], item))
			{
				continue;
			}
			dispose_item_undo_patch(client_history[history_index]);
			array_delete(client_history, history_index, 1);
			client_history_revision++;
			client_history_replay_restart = true;

			/* Mark the replacement authoritative so a later matching packet cannot remove it
			as a provisional local copy */
			item.history_sync_authoritative = true;
			push_client_history_item(item);
			client_history_sync_requires_replay = true;
			debug_note("client history reordered local echo", history_item_payload_string(item));

			/* A matched local copy has been replaced at the tail and will be rebuilt in server
			order */
			return true;
		}

		/* No provisional match leaves history untouched and lets the caller append the
		received item normally */
		return false;
	}

	/// @description Suppress intermediate composites and undo-patch capture while preserving their enclosing states
	/// @returns {Bool} True for an existing or newly opened batch
	begin_client_history_sync_batch = function()
	{
		/* An already active batch retains its original restoration snapshots instead of
		nesting another batch */
		if (client_history_sync_batch_active)
		{
			return true;
		}

		/* Open the batch, remember its enclosing rebuild and patch-capture states, then
		suppress composites and new undo patches during collection */
		client_history_sync_batch_active = true;
		client_history_sync_restore_rebuild_active = layer_surface_rebuild_active;
		client_history_sync_restore_patch_capture_suspended = undo_patch_capture_suspended;
		layer_surface_rebuild_active = true;
		undo_patch_capture_suspended = true;
		debug_note("client history sync batch", "started");
		return true;
	}

	/// @description Refresh legacy packet timing and open a joining batch while the canvas is not ready
	/// @returns {Bool} Whether joining history collection is active
	begin_legacy_client_history_sync_batch = function()
	{
		/* A ready canvas has no joining history batch to start */
		if (client_history_sync_is_ready())
		{
			return false;
		}

		/* Record this packet's millisecond arrival time for the legacy quiet-window completion
		rule */
		client_history_sync_legacy_last_packet_at = current_time;

		/* An active batch only needs its latest packet time refreshed */
		if (client_history_sync_batch_active)
		{
			return true;
		}

		/* Clear previous completion notices and record the millisecond start before opening a
		legacy batch */
		client_history_sync_completion_received = false;
		client_history_sync_notice_shown = false;
		client_history_sync_started_at = current_time;
		begin_client_history_sync_batch();
		debug_note("client history sync started", "legacy ordered queue");
		return true;
	}

	/// @description Restore the batch's saved rendering states and optionally composite the completed layer stack
	/// @param {Bool} composite_after Whether to composite once the enclosing rebuild state is restored. Defaults to true
	/// @returns {Bool} Whether an active batch was closed
	finish_client_history_sync_batch = function(composite_after = true)
	{
		/* Without an active batch there are no saved rebuild states to restore */
		if (!client_history_sync_batch_active)
		{
			return false;
		}

		layer_surface_rebuild_active = client_history_sync_restore_rebuild_active;
		undo_patch_capture_suspended = client_history_sync_restore_patch_capture_suspended;
		client_history_sync_batch_active = false;
		client_history_sync_restore_rebuild_active = false;
		client_history_sync_restore_patch_capture_suspended = false;

		/* Composite on request only when the restored state permits it and a live canvas
		exists */
		if (composite_after && !layer_surface_rebuild_active && surface_exists(canvas_surface))
		{
			composite_layers();
		}
		debug_note("client history sync batch", "finished");
		return true;
	}

	/// @description Check that all fill, image and outbound history work has drained
	/// @returns {Bool} Whether no runtime queue blocks sync completion
	client_history_sync_runtime_idle = function()
	{
		/* History work is idle only when fill processing, outbound items, pending image loads
		and receives, and both deferred queues are empty */
		return !fill_job_active()
			&& array_length(pending_client_history_sends) <= 0
			&& array_length(pending_image_draws) <= 0
			&& array_length(pending_image_receives) <= 0
			&& array_length(fill_deferred_history_items) <= 0
			&& array_length(image_deferred_history_items) <= 0;
	}

	/// @description Advance or restart a budgeted ordered replay and restore local layer view state when it finishes
	/// @returns {Bool} Whether replay, terminator reception and outstanding drawing work have completed
	advance_client_history_replay = function()
	{
		/* Start or restart replay when no cursor exists or a history change invalidated its
		current prefix */
		if (!is_struct(client_history_replay) || client_history_replay_restart)
		{
			/* Preserve the previous replay's selected layer on restart, otherwise snapshot the
			current selection */
			var saved_active_layer = is_struct(client_history_replay) ? client_history_replay.active_layer : active_layer_id;

			/* Preserve the previous replay's local visibility on restart, otherwise capture
			the current layer view */
			var saved_visibility = is_struct(client_history_replay) ? client_history_replay.visibility : layer_visibility_snapshot();
			fill_abort_runtime();
			delete_pending_image_draws();

			/* The replay cursor starts at item zero with a baseline failure count, saved layer
			and visibility, no failure, and an immediate next notice time */
			client_history_replay =
			{
				index: 0,
				failures: debug_apply_failures,
				active_layer: saved_active_layer,
				visibility: saved_visibility,
				failed: false,
				next_notice_at: 0
			};
			client_history_replay_restart = false;
			reset_layer_stack_for_replay();
		}

		/* Borrow the current replay cursor so index advancement and failure state persist
		across frames */
		var replay = client_history_replay;

		/* A failed cursor stops replay and keeps reconnect guidance visible rather than
		retrying the same damaged reconstruction */
		if (replay.failed)
		{
			client_history_sync_notice_shown = true;
			set_screenshot_status("Canvas could not finish loading. Reconnect to retry.", make_color_rgb(244, 84, 84));
			return false;
		}

		/* Check the get_timer microsecond budget after each item.
		One command or decode can exceed it */
		/* Measure this frame's replay work from a microsecond timer snapshot */
		var started_us = get_timer();

		/* Begin this frame with zero applied items for the per-step item cap */
		var applied_count = 0;

		/* Apply the received prefix while items and frame allowance remain and no fill or
		image load holds the ordering barrier */
		while (replay.index < array_length(client_history)
		&& applied_count < client_history_replay_items_per_step
		&& !fill_job_active() && array_length(pending_image_draws) <= 0)
		{
			/* Borrow the next history item before advancing the persistent replay cursor */
			var item = client_history[replay.index];
			apply_history_item_to_surface(item);
			replay.index++;
			applied_count++;

			/* A PNG decode is indivisible. Never decode several large textures in
			the same frame. Fills keep their existing progressive job ordering */
			/* Yield after an image decode or an exhausted microsecond budget so subsequent
			packets and input can run */
			if (history_item_is_image(item)
			|| get_timer() - started_us >= client_history_replay_budget_us)
			{
				break;
			}
		}

		/* Any new recorded apply failure permanently marks this replay attempt failed */
		if (debug_apply_failures != replay.failures)
		{
			replay.failed = true;
			client_history_sync_notice_shown = true;
			set_screenshot_status("Canvas could not finish loading. Reconnect to retry.", make_color_rgb(244, 84, 84));
			debug_error("Shared canvas replay failed at item " + string(replay.index));
			return false;
		}

		/* Keep the cursor while more received items, the server terminator or outstanding
		runtime work remain */
		if (replay.index < array_length(client_history)
		|| !client_history_sync_completion_received
		|| !client_history_sync_runtime_idle())
		{
			/* Keep the cursor when the received prefix is ready. More ordered items
			can arrive next frame, and replaying that prefix again wastes join time */
			/* Refresh loading feedback no more often than its half-second millisecond notice
			deadline */
			if (current_time >= replay.next_notice_at)
			{
				replay.next_notice_at = current_time + 500;

				/* Show item progress after the terminator arrives, otherwise explain that
				shared history is still being received */
				var loading_status = client_history_sync_completion_received
					? "Loading canvas: " + string(replay.index) + "/" + string(array_length(client_history)) + " items..."
					: "Receiving shared canvas...";
				set_screenshot_status(loading_status, make_color_rgb(255, 220, 95));
			}

			/* An incomplete prefix or pending runtime operation leaves joining sync unfinished
			for this frame */
			return false;
		}
		restore_layer_visibility_snapshot(replay.visibility);
		restore_active_layer_id(replay.active_layer);
		client_history_replay = noone;
		client_history_sync_requires_replay = false;

		/* All received history and runtime work are complete, with local visibility and active
		layer restored */
		return true;
	}

	/// @description Finish joining after optional Step replay, server completion and idle drawing work
	/// @param {Bool} advance_replay Whether this caller may spend the Step budget advancing replay. Defaults to false
	/// @returns {Bool} Whether the shared canvas was marked ready
	try_finish_client_history_sync = function(advance_replay = false)
	{
		/* History collected without rendering must finish its replay before the canvas can
		become ready */
		if (client_history_sync_requires_replay)
		{
			/* Replay received items while the remaining history is downloading.
			Packet callbacks only collect history. The Step budget leaves room
			for input, heartbeat and the next network packets */
			/* Packet callbacks do not advance replay, while Step callers must wait until the
			budgeted replay finishes */
			if (!advance_replay || !advance_client_history_replay())
			{
				return false;
			}
		}

		/* An exhausted received prefix is not the end of the server's history.
		Keep the completed canvas hidden until its terminator and image/fill work */
		/* A server completion marker and idle drawing runtime are both required before
		revealing the joined canvas */
		if (!client_history_sync_completion_received
		|| !client_history_sync_runtime_idle())
		{
			return false;
		}

		finish_client_history_sync_batch(true);

		/* Measure synchronization milliseconds from a recorded start, using zero when no start
		time exists */
		var sync_elapsed_ms = client_history_sync_started_at > 0
			? max(0, current_time - client_history_sync_started_at)
			: 0;
		client_history_sync_complete = true;
		client_history_sync_completion_received = false;
		client_history_sync_legacy_last_packet_at = 0;
		client_history_sync_started_at = 0;

		/* Show ready feedback only when joining already displayed a loading notice */
		if (client_history_sync_notice_shown)
		{
			set_screenshot_status("Shared canvas ready.", make_color_rgb(94, 215, 122));
		}
		client_history_sync_notice_shown = false;
		debug_note("client history sync complete", string(array_length(client_history)) + " item(s)");
		debug_success("Shared canvas ready: " + string(array_length(client_history))
			+ " item(s) in " + string(sync_elapsed_ms) + " ms.");
		return true;
	}

	/// @description Advance sends and joining history replay from Step, including while another menu captures input
	/// @returns {Bool} Whether an active client is still waiting for its shared canvas
	update_client_history_sync_maintenance = function()
	{
		/* History maintenance has no client session to advance outside an active connection */
		if (!is_active_client_session())
		{
			return false;
		}

		/* This maintenance also runs while chat/editor menus capture input.
		Pump once here so an open menu cannot strand an image halfway through */
		update_pending_client_history_sends();

		/* After pumping outbound history, stop if the session ended or its canvas is already
		ready */
		if (!is_active_client_session() || client_history_sync_is_ready())
		{
			return false;
		}

		/* Start legacy collection when joining has not already opened a batch */
		if (!client_history_sync_batch_active)
		{
			begin_legacy_client_history_sync_batch();
		}

		is_drawing = false;
		sent_drag_command = false;
		end_local_undo_group();
		update_pending_image_draws();

		/* Advance an outstanding shared fill with the configured per-step pixel, seed and span
		budgets */
		if (fill_job_active())
		{
			advance_progressive_fill_job(shared_fill_pixels_per_step, shared_fill_seed_budget_per_step, shared_fill_spans_per_step);
		}

		/* Legacy sync can infer completion after its quiet interval only when no explicit
		terminator is required and all runtime work is idle */
		if (client_history_sync_batch_active
		&& !client_history_sync_completion_required
		&& !client_history_sync_completion_received
		&& client_history_sync_legacy_last_packet_at > 0
		&& current_time >= client_history_sync_legacy_last_packet_at + client_history_sync_legacy_idle_ms
		&& client_history_sync_runtime_idle())
		{
			client_history_sync_completion_received = true;
			debug_note("client history sync quiet window", string(client_history_sync_legacy_idle_ms) + "ms");
		}
		try_finish_client_history_sync(true);

		/* Show the initial syncing notice once if replay still has not made the canvas ready */
		if (!client_history_sync_is_ready() && !client_history_sync_notice_shown)
		{
			client_history_sync_notice_shown = true;
			set_screenshot_status("Syncing the shared canvas...", make_color_rgb(255, 220, 95));
		}

		/* Tell the input loop whether this active client must continue waiting for its canvas */
		return !client_history_sync_is_ready();
	}

	/// @description Maintain joining work when needed and let an active vote receive input while drawing waits
	/// @param {Bool} maintenance_done Whether joining maintenance already ran for this frame. Defaults to false
	/// @returns {Bool} Whether canvas synchronization still captures this input pass
	update_client_history_sync_wait = function(maintenance_done = false)
	{
		/* Run maintenance here only when the caller has not already performed this frame's
		maintenance */
		if (!maintenance_done)
		{
			update_client_history_sync_maintenance();
		}

		/* A ready shared canvas no longer captures input through this waiting path */
		if (client_history_sync_is_ready())
		{
			return false;
		}

		/* An active layer vote remains usable while canvas synchronization captures drawing
		input */
		if (is_struct(client_layer_vote))
		{
			handle_layer_vote_input();
		}

		/* The still-loading canvas keeps this input pass in waiting mode */
		return true;
	}

	/// @description Read a drawing packet item and collect or apply it in order, updating this player's accepted layer actions
	/// @returns {Bool} Whether one item was decoded and handled
	receive_command = function()
	{
		/* Decode one received history item from the active network buffer */
		var item = read_history_item();

		/* Reject an item that failed deserialization before updating history or surfaces */
		if (item == noone)
		{
			debug_note("client receive failed", debug_last_invalid_command);
			return false;
		}

		debug_receive_count++;
		refresh_local_identity_from_client();

		/* Recognize structural edits authored by this player so the matching local draft and
		layer selection can be updated */
		var authored_local_layer = history_item_is_layer(item)
			&& command_author_player_id(item) == local_player_id;

		/* The authoritative echo of this player's move closes the local move preview */
		if (authored_local_layer && item.op == DRAW_LAYER_MOVE)
		{
			layer_move_draft_active = false;
			layer_move_draft_submitted = false;
		}

		/* Keep the last primitive or image diagnostic without replacing it with a structural
		layer operation */
		if (!history_item_is_layer(item))
		{
			debug_last_command = item;
		}
		debug_note("client received drawing item", history_item_payload_string(item));

		/* During joining collection, update ordered history and postpone rendering to the Step
		replay budget */
		if (client_history_sync_batch_active && !client_history_sync_complete)
		{
			/* Undo records remove their referenced group during collection without rebuilding
			surfaces immediately */
			if (history_item_is_undo(item))
			{
				remove_client_undo_group(item.undo_author_id, item.undo_id, false, false);
			}

			/* Other collected items append to the history that the budgeted replay will
			reconstruct */
			else
			{
				push_client_history_item(item);
			}
			client_history_sync_requires_replay = true;
			return true;
		}

		/* Live undo application removes existing history instead of storing the undo as a
		drawable item */
		if (!history_item_is_undo(item))
		{
			push_client_history_item(item);
		}
		apply_history_item_to_surface(item);

		/* Only this player's accepted layer edits produce local selection changes and
		confirmation feedback */
		if (authored_local_layer)
		{
			/* Added, duplicated and restored layers become the active selection and receive a
			brief visual highlight */
			if (item.op == DRAW_LAYER_ADD || item.op == DRAW_LAYER_DUPLICATE || item.op == DRAW_LAYER_RESTORE)
			{
				clear_selection();
				active_layer_id = item.layer_id;
				layers_panel_scroll_to_layer(item.layer_id);
				trigger_layer_blink(item.layer_id);
			}

			/* Confirm an accepted new layer with its authoritative name */
			if (item.op == DRAW_LAYER_ADD)
			{
				set_screenshot_status("Created “" + item.name + "”.", make_color_rgb(94, 215, 122));
			}

			/* Confirm an accepted duplication with the duplicated layer's name */
			else if (item.op == DRAW_LAYER_DUPLICATE)
			{
				set_screenshot_status("Duplicated “" + item.name + "”.", make_color_rgb(94, 215, 122));
			}

			/* Confirm removal of this player's empty layer after the authoritative edit is
			applied */
			else if (item.op == DRAW_LAYER_DELETE)
			{
				set_screenshot_status("Removed the empty layer.", make_color_rgb(94, 215, 122));
			}
		}
		return true;
	}

	/// @description Read an N_DRAW_HISTORY packet body from the active network buffer. Zero items terminate joining sync
	/// @returns {Bool} Whether the packet count was accepted
	receive_history = function()
	{
		/* Read the unsigned 16-bit history item count from this packet's active network body */
		var command_count = net.read(buffer_u16);

		/* A zero item count is the server's explicit joining terminator */
		if (command_count == 0)
		{
			client_history_sync_completion_received = true;
			try_finish_client_history_sync();
			return true;
		}

		/* Reject an item count above the negotiated history chunk ceiling before iterating the
		packet */
		if (command_count > history_chunk_size)
		{
			debug_note("client history rejected", "invalid command count " + string(command_count));
			return false;
		}
		begin_legacy_client_history_sync_batch();
		debug_history_receive_count += command_count;
		debug_note("client received history", string(command_count) + " command(s)");

		/* Collect live items for one batched surface application after deserialization */
		var received_items = [];

		/* Read exactly the announced item count, using a zero-based loop counter */
		for (var i = 0; i < command_count; i++)
		{
			/* Decode the next ordered item before classifying echo replacement or joining
			collection */
			var item = read_history_item();

			/* Skip invalid decoded items while continuing to read the remaining announced
			entries */
			if (item == noone)
			{
				debug_note("client history skipped", debug_last_invalid_command);
				continue;
			}

			/* A reordered local echo is already inserted into authoritative history and must
			not be appended again */
			if (reorder_client_local_echo_to_history_tail(item))
			{
				continue;
			}

			/* Joining batches collect history for Step replay instead of spending packet
			callback time drawing */
			if (client_history_sync_batch_active && !client_history_sync_complete)
			{
				/* Collected undo entries remove their group without immediate surface replay */
				if (history_item_is_undo(item))
				{
					remove_client_undo_group(item.undo_author_id, item.undo_id, false, false);
				}

				/* Other joining entries append to the received prefix awaiting budgeted
				reconstruction */
				else
				{
					push_client_history_item(item);
				}
				client_history_sync_requires_replay = true;
				continue;
			}

			/* Live drawing history records non-undo items before the batch is rendered */
			if (!history_item_is_undo(item))
			{
				push_client_history_item(item);
			}
			received_items[array_length(received_items)] = item;
		}
		apply_history_items_to_surfaces_batch(received_items);

		return true;
	}
	#endregion /* Ordered Client History Sync END */

	#region /* Client Drawing Submission */
	/// @description Submit non-image history immediately or hand images to the chunked upload queue
	/// @param {Struct} item History item submitted, queued or used as a replacement
	/// @returns {Bool} Whether sent, queued, or intentionally kept local, with false for a failed attempted send
	send_history_item_to_server_now = function(item)
	{
		/* PNG items use the chunked image uploader rather than the primitive payload packet */
		if (history_item_is_image(item))
		{
			debug_last_outgoing_payload = "I2|"
				+ string(item.image_id)
				+ "|" + string(item.layer_id)
				+ "|" + string(command_author_player_id(item))
				+ "|" + command_author_name(item)
				+ "|" + string(command_undo_author_id(item))
				+ "|" + string(command_undo_id(item))
				+ "|" + string(item.x)
				+ "," + string(item.y)
				+ " "
				+ string(item.w)
				+ "x"
				+ string(item.h);
			debug_last_send_time = current_time;
			return send_image_history_item_to_server_now(item);
		}

		/* Serialize this non-image history item for both outgoing diagnostics and the network
		packet */
		var payload = history_item_payload_string(item);
		debug_last_outgoing_payload = payload;
		debug_last_send_time = current_time;

		/* Borrow the current client state to select local-only or online submission */
		var client = scr_get_client();

		/* Singleplayer retains the local draw and records success without a network send */
		if (is_struct(client)
		&& variable_struct_exists(client, "singleplayer_mode")
		&& client.singleplayer_mode)
		{
			debug_last_send_mode = "singleplayer";
			debug_last_send_result = 1;
			debug_send_successes++;
			debug_last_replication_status = "singleplayer local";
			debug_note("singleplayer local", payload);
			return true;
		}

		/* Missing online identity or a usable socket keeps this primitive local and reports
		handled=true to its caller */
		if (!is_struct(client)
		|| !variable_struct_exists(client, "ID")
		|| client.ID == noone
		|| !variable_struct_exists(client, "socket")
		|| !is_real(client.socket)
		|| client.socket < 0)
		{
			debug_last_send_mode = "online";
			debug_last_send_result = -1;
			debug_note("client local only", "missing ID/socket");
			return true;
		}

		debug_last_send_mode = "online";
		net.start(N_DRAW_COMMAND, client.ID);
		write_command_payload(payload);

		/* Keep the server-send byte result to distinguish an accepted write from a transport
		failure */
		var send_result = net.send_server();
		debug_last_send_result = send_result;

		/* A negative transport result records failure while leaving the optimistic local work
		visible */
		if (send_result < 0)
		{
			debug_send_failures++;
			debug_last_replication_status = "local only: send failed " + string(send_result);
			debug_note("client local only", "net.send_server=" + string(send_result));
			return false;
		}

		debug_send_successes++;
		debug_last_replication_status = "sent " + string(send_result) + " bytes";
		debug_note("client sent history item", "bytes=" + string(send_result) + " " + payload);
		return true;
	}

	/// @description Preserve outbound history ordering while joining or sending older queued items
	/// @param {Struct} item History item submitted, queued or used as a replacement
	/// @returns {Bool} Whether accepted by the queue or immediate submission path
	queue_or_send_history_item_to_server = function(item)
	{
		/* An image with no older queued item goes straight to the image uploader, which can
		enqueue its chunks */
		if (history_item_is_image(item) && array_length(pending_client_history_sends) <= 0)
		{
			return send_image_history_item_to_server_now(item);
		}

		/* Keep later items in order behind an existing queue or unfinished joining
		synchronization */
		if (array_length(pending_client_history_sends) > 0
		|| !client_history_sync_is_ready())
		{
			pending_client_history_sends[array_length(pending_client_history_sends)] = item;
			return true;
		}

		return send_history_item_to_server_now(item);
	}

	/// @description Advance the oldest outbound item within image packet and millisecond timing limits
	/// @returns {Bool} Whether queued work remains or an upload failure path was handled
	update_pending_client_history_sends = function()
	{
		/* An empty outbound queue has no work remaining */
		if (array_length(pending_client_history_sends) <= 0)
		{
			return false;
		}

		/* Keep queued work pending until its millisecond send deadline permits the next item */
		if (current_time < next_pending_history_send_time)
		{
			return true;
		}

		/* Borrow the oldest queued history item so uploads preserve drawing order */
		var item = pending_client_history_sends[0];

		/* Images retain their chunk cursor across frames instead of sending their full
		contents at once */
		if (history_item_is_image(item))
		{
			/* Compute how many fixed-size Base64 chunks this image needs */
			var chunk_count = image_history_chunk_count(item);

			/* An invalid or oversized upload preserves a disconnect screenshot and ends the
			connection rather than sending it */
			if (chunk_count <= 0 || chunk_count > image_import_max_chunks)
			{
				/* Screenshot preservation is best effort so a save exception cannot prevent
				connection-loss handling */
				try { save_drawing_screenshot("automatic_disconnect", "client", "image_upload_too_large"); } catch(upload_save_error) { }
				scr_get_client().mark_connection_lost("Image upload is too large. Reconnect to reload the shared canvas.");
				return true;
			}

			/* Borrow the client that owns this queued upload's transport and connection-loss
			state */
			var client = scr_get_client();

			/* Singleplayer considers all image chunks complete because no server transfer is
			needed */
			if (is_struct(client) && variable_struct_exists(client, "singleplayer_mode") && client.singleplayer_mode)
			{
				client_image_send_chunk = chunk_count;
			}

			/* Send only the frame's packet allowance and stop when the persistent image chunk
			cursor reaches the total */
			for (var packet_index = 0; packet_index < client_image_packets_per_step && client_image_send_chunk < chunk_count; packet_index++)
			{
				/* Keep this chunk's transport result before advancing its persistent cursor */
				var send_result = send_image_history_chunk_to_server(item, client_image_send_chunk, chunk_count);
				debug_last_send_result = send_result;

				/* A failed chunk write stops this connection because retrying could extend a
				partially sent frame */
				if (send_result < 0)
				{
					debug_send_failures++;

					/* A failed stream write may have sent a partial frame. Do not retry
					on that connection. Preserve visible work before its normal reset */
					/* Preserve visible work if possible before the connection's normal reset,
					ignoring screenshot-save exceptions */
					try { save_drawing_screenshot("automatic_disconnect", "client", "image_upload_failed"); } catch(upload_save_error) { }
					client.mark_connection_lost("Image upload failed. Reconnect to reload the shared canvas.");
					return true;
				}
				client_image_send_chunk++;
			}
			debug_last_replication_status = "uploading image " + string(client_image_send_chunk) + "/" + string(chunk_count);

			/* An incomplete image retains its queue entry and chunk cursor for the next frame */
			if (client_image_send_chunk < chunk_count)
			{
				return true;
			}
			client_image_send_chunk = 0;
			debug_send_successes++;
			array_delete(pending_client_history_sends, 0, 1);
			next_pending_history_send_time = current_time + server_min_command_interval_ms + 1;

			/* After a completed image, report whether later queued history still needs sending */
			return array_length(pending_client_history_sends) > 0;
		}

		/* Keep the oldest non-image item's immediate submission outcome before deciding
		whether to dequeue it */
		var sent = send_history_item_to_server_now(item);

		/* An accepted or intentionally local item leaves the queue and starts the next
		millisecond send interval */
		if (sent)
		{
			array_delete(pending_client_history_sends, 0, 1);
			next_pending_history_send_time = current_time + server_min_command_interval_ms + 1;
		}

		/* A failed non-image transfer preserves a screenshot if possible and closes the
		connection */
		else
		{
			/* Save failure must not interrupt the connection-loss path */
			try { save_drawing_screenshot("automatic_disconnect", "client", "drawing_upload_failed"); } catch(upload_save_error) { }
			scr_get_client().mark_connection_lost("Drawing upload failed. Reconnect to reload the shared canvas.");
		}

		/* Tell maintenance whether the outbound queue still holds work after this attempt */
		return array_length(pending_client_history_sends) > 0;
	}

	/// @description Serialize and send one Base64 image chunk using the current client identity
	/// @param {Struct} item History item submitted, queued or used as a replacement
	/// @param {Real} chunk_index Zero-based Base64 chunk index
	/// @param {Real} chunk_count Total chunks announced for this image
	/// @returns {Real} Transport byte result, or -1 when image or client transport is unavailable
	send_image_history_chunk_to_server = function(item, chunk_index, chunk_count)
	{
		/* Borrow online identity and socket state for a single image chunk */
		var client = scr_get_client();

		/* An image chunk requires an image item and usable online client transport, otherwise
		return the negative send sentinel */
		if (!history_item_is_image(item)
		|| !is_struct(client)
		|| !variable_struct_exists(client, "ID")
		|| client.ID == noone
		|| !variable_struct_exists(client, "socket")
		|| !is_real(client.socket)
		|| client.socket < 0)
		{
			return -1;
		}

		/* Treat the image payload as Base64 text for fixed-size character slicing */
		var base64_text = string(item.base64);

		/* Convert the zero-based chunk index to the one-based string position of its first
		character */
		var chunk_start = chunk_index * image_chunk_size + 1;

		/* Take up to one configured chunk's characters, leaving the final chunk shorter when
		needed */
		var chunk_text = string_copy(base64_text, chunk_start, image_chunk_size);
		write_image_chunk_packet(item, chunk_index, chunk_count, chunk_text, client.ID);
		return net.send_server();
	}

	/// @description Validate an image's chunk count and accept it locally or into the ordered online queue
	/// @param {Struct} item History item submitted, queued or used as a replacement
	/// @returns {Bool} Whether the image was accepted for local use or queued transfer
	send_image_history_item_to_server_now = function(item)
	{
		/* Borrow the client to distinguish singleplayer image handling from an online queued
		transfer */
		var client = scr_get_client();

		/* Singleplayer keeps the image locally and needs no chunk queue */
		if (is_struct(client)
		&& variable_struct_exists(client, "singleplayer_mode")
		&& client.singleplayer_mode)
		{
			debug_last_send_mode = "singleplayer";
			debug_last_send_result = 1;
			debug_send_successes++;
			debug_last_replication_status = "image local";
			return true;
		}

		/* Count encoded-image chunks before accepting the upload into the outbound queue */
		var chunk_count = image_history_chunk_count(item);

		/* Reject empty and over-limit images without queueing an upload the server cannot
		accept */
		if (chunk_count <= 0 || chunk_count > image_import_max_chunks)
		{
			debug_send_failures++;
			debug_last_send_result = -1;
			debug_last_replication_status = "image too large";
			debug_note("client image send skipped", "chunks=" + string(chunk_count));
			return false;
		}

		pending_client_history_sends[array_length(pending_client_history_sends)] = item;
		debug_last_send_mode = "online image";
		debug_last_replication_status = "image queued: " + string(chunk_count) + " chunk(s)";
		debug_note("client queued image", string(item.w) + "x" + string(item.h) + " chunks=" + string(chunk_count));
		return true;
	}

	/// @description Combine the bounded client slot and rolling local image sequence into an upload identity
	/// @returns {Real} Per-client upload ID, with the sequence wrapping after 999999
	make_client_image_id = function()
	{
		/* Borrow the client's slot identity to give uploads a per-client numeric namespace */
		var client = scr_get_client();

		/* Use slot zero when no valid client identity is available */
		var client_slot = 0;

		/* Only a numeric assigned ID is converted into the bounded client slot */
		if (is_struct(client)
		&& variable_struct_exists(client, "ID")
		&& is_real(client.ID)
		&& client.ID != noone)
		{
			client_slot = clamp(floor(real(client.ID)), 0, 4095);
		}

		/* Combine the slot's million-sized namespace with the next per-client image sequence */
		var upload_id = client_slot * 1000000 + next_client_image_id;
		next_client_image_id++;

		/* Wrap the local sequence after 999999 to keep it inside its slot's numeric namespace */
		if (next_client_image_id > 999999)
		{
			next_client_image_id = 1;
		}

		return upload_id;
	}

	/// @description Resolve the dedicated fill PNG directory beneath the save root
	/// @returns {String} Normalized directory path, or an empty string without a save root
	fill_upload_folder_path = function()
	{
		/* A missing save root provides no dedicated fill-upload directory */
		if (string(game_save_id) == "")
		{
			return "";
		}

		return screenshot_normalize_path(screenshot_path_join(game_save_id, fill_upload_folder_name));
	}

	/// @description Create the dedicated fill PNG directory if needed
	/// @returns {Bool} Whether a nonempty fill directory exists after preparation
	ensure_fill_upload_folder = function()
	{
		/* Resolve the fill PNG upload directory before attempting to prepare it */
		var folder_path = fill_upload_folder_path();

		/* A filename-only save context cannot create this dedicated upload directory */
		if (folder_path == "")
		{
			return false;
		}

		try
		{
			/* Create a missing fill directory while reusing an existing one */
			if (!directory_exists(folder_path))
			{
				directory_create(folder_path);
			}

			/* Confirm directory existence after creation rather than treating a create attempt
			as success */
			return directory_exists(folder_path);
		}

		/* A filesystem exception rejects directory preparation and preserves its diagnostic */
		catch(e)
		{
			/* Extract a structured filesystem message when present, otherwise stringify the
			thrown value */
			var fill_folder_error = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			debug_error("Could not create drawing fill upload folder: " + fill_folder_error);
			return false;
		}
	}

	/// @description Build the named PNG path for a fill upload without creating a file
	/// @param {Real} upload_id Image upload identity used in the retained PNG filename
	/// @returns {String} Fill PNG path, or an empty string without a save root
	fill_upload_file_path = function(upload_id)
	{
		/* Resolve the fill upload directory for this image's retained PNG filename */
		var folder_path = fill_upload_folder_path();

		/* Return no path when a dedicated fill directory is unavailable */
		if (folder_path == "")
		{
			return "";
		}

		return screenshot_path_join(folder_path, fill_upload_file_prefix + string(upload_id) + ".png");
	}

	/// @description Encode an opaque fill-mask subregion as PNG history retaining the original author and undo identity
	/// @param {Struct} command Validated drawing command
	/// @param {Real} raw_left Optional world-pixel left edge, defaulting to the fill bound
	/// @param {Real} raw_top Optional world-pixel top edge, defaulting to the fill bound
	/// @param {Real} raw_w Optional pixel width, defaulting to the full fill width
	/// @param {Real} raw_h Optional pixel height, defaulting to the full fill height
	/// @param {Struct} fill_job Optional completed fill job whose recorded spans can encode browser PNGs. Defaults to noone
	/// @returns {Struct} Image history item, or noone when encoding or size checks reject replacement
	make_fill_image_history_item = function(command, raw_left = undefined, raw_top = undefined, raw_w = undefined, raw_h = undefined, fill_job = noone)
	{
		/* PNG replacement requires a fill command and the live fill mask buffer that contains
		its result */
		if (!is_struct(command)
		|| command.tool_id != DRAW_TOOL_FILL
		|| !buffer_exists(fill_mask_buffer))
		{
			return noone;
		}

		/* Normalize the fill's horizontal command bounds to their inclusive left pixel */
		var fill_left = min(command.to_x, command.extra_a);

		/* Normalize the vertical bounds to their inclusive top pixel */
		var fill_top = min(command.to_y, command.extra_b);

		/* Keep the inclusive right pixel for clipping optional image subregions */
		var fill_right = max(command.to_x, command.extra_a);

		/* Keep the inclusive bottom pixel for clipping optional image subregions */
		var fill_bottom = max(command.to_y, command.extra_b);

		/* Count fill columns including both boundary pixels */
		var fill_w = fill_right - fill_left + 1;

		/* Count fill rows including both boundary pixels */
		var fill_h = fill_bottom - fill_top + 1;

		/* Use the fill's left edge when omitted, otherwise clamp the supplied integer pixel
		origin inside it */
		var image_left = is_undefined(raw_left) ? fill_left : clamp(floor(real(raw_left)), fill_left, fill_right);

		/* Use the fill's top edge when omitted, otherwise clamp the supplied integer pixel
		origin inside it */
		var image_top = is_undefined(raw_top) ? fill_top : clamp(floor(real(raw_top)), fill_top, fill_bottom);

		/* Use the full fill width when omitted, otherwise require at least one integer output
		pixel */
		var image_w = is_undefined(raw_w) ? fill_w : max(1, floor(real(raw_w)));

		/* Use the full fill height when omitted, otherwise require at least one integer output
		pixel */
		var image_h = is_undefined(raw_h) ? fill_h : max(1, floor(real(raw_h)));
		image_w = min(image_w, fill_right - image_left + 1);
		image_h = min(image_h, fill_bottom - image_top + 1);

		/* Partly transparent fills keep their replay command because converting them to a
		composited PNG would change replay blending */
		if (command_alpha(command) < 255)
		{
			debug_note("fill image skipped", "transparent fill sends replay command");
			return noone;
		}

		/* Allocate a client image identity for a possible PNG replacement */
		var upload_id = make_client_image_id();

		/* Begin without encoded data until one of the platform-specific encoders succeeds */
		var upload_base64 = "";

		/* Desktop runners encode the selected fill-mask rectangle through a temporary surface */
		if (!screenshot_uses_browser_storage())
		{
			/* Keep the surface encoder's result and error message for this selected mask
			region */
			var surface_result = fill_mask_region_to_png_base64_surface(image_left - fill_left, image_top - fill_top, image_w, image_h);

			/* A failed surface encoding leaves the fill represented by its original command */
			if (!surface_result.ok)
			{
				debug_note("fill image skipped", surface_result.message);
				return noone;
			}

			upload_base64 = surface_result.base64;
		}

		/* Browser fills with a job can encode its recorded spans directly */
		else if (is_struct(fill_job))
		{
			/* Keep the span encoder's PNG data or failure details for the requested
			world-pixel rectangle */
			var encode_result = fill_spans_region_to_png_base64(fill_job, image_left, image_top, image_w, image_h);

			/* A failed span encoding cannot replace the command with an image */
			if (!encode_result.ok)
			{
				debug_note("fill image skipped", encode_result.message);
				return noone;
			}

			upload_base64 = encode_result.base64;
		}

		/* Without recorded spans, the browser falls back to the raw fill mask bytes */
		else
		{
			/* Convert the selected image's world left coordinate to a fill-mask column */
			var local_left = image_left - fill_left;

			/* Convert its world top coordinate to a fill-mask row */
			var local_top = image_top - fill_top;

			/* Encode the selected mask rectangle using the full fill width as its source row
			stride */
			var fallback_result = fill_mask_region_to_png_base64(local_left, local_top, image_w, image_h, fill_w);

			/* A failed fallback encoding also preserves the original fill command */
			if (!fallback_result.ok)
			{
				debug_note("fill image skipped", fallback_result.message);
				return noone;
			}

			upload_base64 = fallback_result.base64;
		}

		/* Build the PNG history item with its placement, encoded bytes, target layer and
		original author/undo identity */
		var item = make_image_history_item(
			upload_id,
			"Fill " + screenshot_timestamp(),
			image_left,
			image_top,
			image_w,
			image_h,
			upload_base64,
			command_layer_id(command),
			command_undo_id(command),
			command_undo_author_id(command),
			command_author_player_id(command),
			command_author_name(command)
		);

		/* Reject a PNG replacement that would need more chunks than the upload protocol allows */
		if (image_history_chunk_count(item) > image_import_max_chunks)
		{
			debug_note("fill image skipped", "chunks=" + string(image_history_chunk_count(item)));
			return noone;
		}

		return item;
	}

	/// @description Replace one history entry while transferring or disposing its old undo patch and invalidating replay
	/// @param {Real} item_index Zero-based client history index
	/// @param {Struct} item History item submitted, queued or used as a replacement
	/// @returns {Bool} Whether the requested history index existed
	replace_client_history_item_at = function(item_index, item)
	{
		/* A stale replacement index cannot safely identify a client history item */
		if (item_index < 0 || item_index >= array_length(client_history))
		{
			return false;
		}

		/* Borrow the previous item to transfer or release any undo patch it owns */
		var previous_item = client_history[item_index];

		/* Only a different structured item can have patch ownership changed during replacement */
		if (is_struct(previous_item) && previous_item != item)
		{
			/* Transfer a valid old patch when the replacement has no valid patch of its own */
			if (history_item_has_valid_undo_patch(previous_item)
			&& is_struct(item)
			&& !history_item_has_valid_undo_patch(item))
			{
				/* The replacement becomes owner of this patch while the previous item
				relinquishes its reference */
				item.undo_patch = previous_item.undo_patch;
				previous_item.undo_patch = noone;
			}

			/* Otherwise dispose the previous item's patch so replacement does not leak its
			surface */
			else
			{
				dispose_item_undo_patch(previous_item);
			}
		}

		client_history[item_index] = item;
		client_history_revision++;
		client_history_replay_restart = true;
		return true;
	}

	/// @description Replace the final client history entry through the patch-aware replacement path
	/// @param {Struct} item History item submitted, queued or used as a replacement
	/// @returns {Bool} Whether a final history item was replaced
	replace_last_client_history_item = function(item)
	{
		/* Count history entries to locate the final item's zero-based position */
		var history_count = array_length(client_history);

		/* An empty history has no final item to replace */
		if (history_count <= 0)
		{
			return false;
		}

		return replace_client_history_item_at(history_count - 1, item);
	}

	/// @description Remove the latest eligible local undo group, save it for redo and submit its server undo record
	/// @returns {Bool} Whether a group was removed locally
	undo_local_command = function()
	{
		/* Wall edits use shared erasing rather than the drawing undo stack */
		if (tool == DRAW_TOOL_WALL)
		{
			set_screenshot_status("Use the Eraser to remove walls. Everyone can erase them.", make_color_rgb(255, 220, 95));
			return false;
		}

		/* An active fill must finish before undo changes and replays its history */
		if (fill_job_active())
		{
			set_screenshot_status("Wait for the fill to finish.", make_color_rgb(255, 220, 95));
			return false;
		}

		/* Find the latest undo group owned by this client's undo-author identity */
		var undo_id = find_last_local_undo_id();

		/* No positive local group ID means there is nothing eligible to undo */
		if (undo_id <= 0)
		{
			set_screenshot_status("Nothing to undo.", make_color_rgb(255, 220, 95));
			debug_note("undo skipped", "no local command");
			return false;
		}

		/* Respect the undo action's millisecond cooldown before removing any group */
		if (!try_start_action_cooldown("undo"))
		{
			return false;
		}

		/* Remove and rebuild the chosen local group, retaining its commands for redo */
		var removed_group = remove_client_undo_group(local_undo_author_id, undo_id, true, true);

		/* A group that disappeared before removal cannot produce a redo entry or network undo */
		if (array_length(removed_group) <= 0)
		{
			set_screenshot_status("Nothing to undo.", make_color_rgb(255, 220, 95));
			debug_note("undo skipped", "group disappeared");
			return false;
		}

		redo_stack[array_length(redo_stack)] = removed_group;

		/* Create the author's group-removal record for ordered server replication */
		var undo_item = make_undo_history_item(local_undo_author_id, undo_id);
		queue_or_send_history_item_to_server(undo_item);
		set_screenshot_status("Undid drawing.", make_color_rgb(94, 215, 122));
		debug_note("undo local", "group " + string(undo_id) + " commands=" + string(array_length(removed_group)));
		return true;
	}

	/// @description Restore the latest saved redo group locally and queue its items for ordered replication
	/// @returns {Bool} Whether a saved group was restored after cooldown checks
	redo_local_command = function()
	{
		/* Wall geometry is restored by drawing new walls rather than through the drawing redo
		stack */
		if (tool == DRAW_TOOL_WALL)
		{
			set_screenshot_status("Use the Wall Brush to draw walls, and the Eraser to remove them.", make_color_rgb(255, 220, 95));
			return false;
		}

		/* Redo waits for an active fill so replay does not compete with its surface changes */
		if (fill_job_active())
		{
			set_screenshot_status("Wait for the fill to finish.", make_color_rgb(255, 220, 95));
			return false;
		}

		/* Count stored redo groups to locate the most recently undone one */
		var redo_count = array_length(redo_stack);

		/* An empty redo stack has no drawing group to restore */
		if (redo_count <= 0)
		{
			set_screenshot_status("Nothing to redo.", make_color_rgb(255, 220, 95));
			debug_note("redo skipped", "empty redo stack");
			return false;
		}

		/* The redo action must pass its millisecond cooldown before consuming the saved group */
		if (!try_start_action_cooldown("redo"))
		{
			return false;
		}

		/* Take the newest undone group's history items before removing its redo-stack entry */
		var group = redo_stack[redo_count - 1];
		array_delete(redo_stack, redo_count - 1, 1);

		/* Restore the group's commands in their recorded order and queue each for matching
		server replay */
		for (var i = 0; i < array_length(group); i++)
		{
			/* Borrow this group's next item, releasing its old patch before capturing replay's
			current pixels */
			var item = group[i];
			dispose_item_undo_patch(item);
			push_client_history_item(item);
			apply_history_item_to_surface(item);
			pending_client_history_sends[array_length(pending_client_history_sends)] = item;
		}

		set_screenshot_status("Redid drawing.", make_color_rgb(94, 215, 122));
		debug_note("redo local", "commands=" + string(array_length(group)));
		return true;
	}

	/// @description Apply a command locally, invalidate redo and queue replication or begin a progressive fill
	/// @param {Struct} command Validated drawing command
	/// @returns {Bool} Whether local application or fill startup succeeded
	send_client_command = function(command)
	{
		/* An absent command records a failed attempt without local drawing or network
		submission */
		if (command == noone)
		{
			debug_send_failures++;
			debug_last_send_result = noone;
			debug_note("client send skipped", "command was noone");
			return false;
		}

		debug_send_attempts++;
		debug_last_command = command;
		debug_last_outgoing_command = command;
		debug_last_outgoing_payload = command_payload_string(command);
		debug_last_send_time = current_time;

		/* Fills begin locally and defer their eventual network representation until
		progressive processing finishes */
		if (command.tool_id == DRAW_TOOL_FILL)
		{
			/* A fill that cannot start must not invalidate redo history or be reported as
			submitted */
			if (!begin_local_fill_command(command))
			{
				debug_send_failures++;
				debug_last_send_result = noone;
				debug_last_replication_status = "local fill failed";
				return false;
			}

			clear_redo_stack();
			return true;
		}

		/* Other tools must apply locally before their command is queued for server replication */
		if (!apply_local_command(command))
		{
			debug_send_failures++;
			debug_last_send_result = noone;
			debug_last_replication_status = "local apply failed";
			return false;
		}

		record_recent_color_from_command(command);
		clear_redo_stack();
		queue_or_send_history_item_to_server(command);
		return true;
	}

	/// @description Attribute and locally commit a singleplayer layer edit or send its online request for authority
	/// @param {Struct} item History item submitted, queued or used as a replacement
	/// @returns {Bool} Whether locally handled or accepted by the transport
	send_layer_history_item = function(item)
	{
		/* Only structural layer history belongs in the layer-request submission path */
		if (!history_item_is_layer(item))
		{
			return false;
		}

		debug_send_attempts++;
		refresh_local_identity_from_client();

		/* Stamp this request with the refreshed player identity and displayed author name */
		item.author_player_id = local_player_id;
		item.author_name = local_player_name;
		debug_last_outgoing_payload = layer_payload_string(item);
		debug_last_send_time = current_time;

		/* Borrow the client to choose immediate singleplayer application or an authoritative
		online request */
		var client = scr_get_client();

		/* Singleplayer applies structural history immediately because no server approval is
		needed */
		if (is_struct(client)
		&& variable_struct_exists(client, "singleplayer_mode")
		&& client.singleplayer_mode)
		{
			push_client_history_item(item);
			apply_history_item_to_surface(item);
			debug_last_send_mode = "singleplayer";
			debug_last_send_result = 1;
			debug_send_successes++;
			debug_last_replication_status = "layer committed locally";
			return true;
		}

		/* Online layer requests require an assigned identity and usable socket instead of
		silently remaining local */
		if (!is_struct(client)
		|| !variable_struct_exists(client, "ID")
		|| client.ID == noone
		|| !variable_struct_exists(client, "socket")
		|| !is_real(client.socket)
		|| client.socket < 0)
		{
			debug_last_send_mode = "online";
			debug_last_send_result = -1;
			debug_send_failures++;
			debug_last_replication_status = "layer request failed: missing ID/socket";
			set_screenshot_status("Layer request could not reach the server.", make_color_rgb(244, 84, 84));
			return false;
		}

		debug_last_send_mode = "online";
		net.start(N_DRAW_COMMAND, client.ID);
		write_command_payload(layer_payload_string(item));

		/* Keep the transport byte result to update layer-request success or failure feedback */
		var send_result = net.send_server();
		debug_last_send_result = send_result;

		/* A negative write leaves the request uncommitted and reports that the server could
		not be reached */
		if (send_result < 0)
		{
			debug_send_failures++;
			debug_last_replication_status = "layer request failed " + string(send_result);
			set_screenshot_status("Layer request could not reach the server.", make_color_rgb(244, 84, 84));
		}

		/* An accepted transport write records the request as sent while waiting for
		authoritative application */
		else
		{
			debug_send_successes++;
			debug_last_replication_status = "layer request sent " + string(send_result) + " bytes";
		}

		/* Report transport acceptance rather than claiming the server has already accepted the
		layer edit */
		return send_result >= 0;
	}

	/// @description Request a visible paint layer immediately above the active layer
	/// @returns {Bool} Whether its layer request was submitted
	add_paint_layer = function()
	{
		ensure_default_layers();

		/* Use the next local layer identity for the proposed new layer */
		var new_id = next_layer_id;

		/* Request insertion immediately above the currently active layer's array position */
		var insert_index = active_layer_index() + 1;

		/* Build a visible layer-add item with its default name and source selection context */
		var item = make_layer_history_item(DRAW_LAYER_ADD, new_id, insert_index, layer_default_name(new_id), active_layer_id, true);

		/* Keep whether the layer-add request was locally committed or sent successfully */
		var result = send_layer_history_item(item);

		/* Select the new layer immediately only when successful local application has already
		created it */
		if (result && layer_index_from_id(new_id) != noone)
		{
			active_layer_id = new_id;
		}
		return result;
	}

	/// @description Request a named copy immediately above the selected source layer
	/// @returns {Bool} Whether its duplication request was submitted
	duplicate_active_layer = function()
	{
		ensure_default_layers();

		/* Resolve the active source layer's array position before creating its duplication
		request */
		var source_index = active_layer_index();

		/* Borrow the source layer's stable ID and displayed name */
		var source_layer = layers[source_index];

		/* Use the next layer identity for the proposed duplicate */
		var new_id = next_layer_id;

		/* Create a cleaned Copy name with a default layer-name fallback */
		var duplicate_name = layer_name_clean(source_layer.name + " Copy", layer_default_name(new_id));

		/* Request the duplicate immediately above its source with the source's stable layer ID */
		var item = make_layer_history_item(DRAW_LAYER_DUPLICATE, new_id, source_index + 1, duplicate_name, source_layer.id, true);

		/* Keep the duplication request's submission outcome */
		var result = send_layer_history_item(item);

		/* Select the duplicate immediately only when it already exists after successful local
		application */
		if (result && layer_index_from_id(new_id) != noone)
		{
			active_layer_id = new_id;
		}
		return result;
	}

	/// @description Adjust a local move preview within active layer positions without submitting it
	/// @param {Real} direction Integer-converted movement offset within active layer positions
	/// @returns {Bool} Whether the preview changed
	move_active_layer = function(direction)
	{
		ensure_default_layers();

		/* An active vote or submitted move must finish before another layer move preview can
		begin */
		if (is_struct(client_layer_vote) || layer_move_draft_submitted)
		{
			set_screenshot_status("Wait for the current layer request to finish.", make_color_rgb(255, 220, 95));
			return false;
		}

		/* List unarchived layer positions because the move preview operates within the active
		stack */
		var active_indices = active_layer_indices();

		/* Continue from an existing preview position, otherwise use the selected layer's
		actual active position */
		var source_position = layer_move_draft_active
			? layer_move_draft_target_position
			: active_layer_position(active_layer_id);

		/* A selected layer outside the active stack cannot be moved through this preview */
		if (source_position == noone)
		{
			return false;
		}

		/* Clamp the integer movement offset inside the active stack's zero-based positions */
		var target_position = clamp(source_position + floor(real(direction)), 0, array_length(active_indices) - 1);

		/* Movement clipped back to the same position creates no useful preview change */
		if (target_position == source_position)
		{
			return false;
		}

		/* The first preview remembers its selected layer and original active position for
		later cancellation or submission */
		if (!layer_move_draft_active)
		{
			layer_move_draft_active = true;
			layer_move_draft_layer_id = active_layer_id;
			layer_move_draft_original_position = source_position;
		}
		layer_move_draft_target_position = target_position;
		layer_composite_dirty = true;

		/* Refresh the preview composite only when no enclosing layer rebuild is active */
		if (!layer_surface_rebuild_active)
		{
			composite_layers();
		}
		set_screenshot_status("Previewing a new layer position. Use Apply Move to request it.", make_color_rgb(255, 220, 95));
		return true;
	}

	/// @description Discard an unsubmitted move preview and refresh the local layer order
	/// @returns {Bool} Whether an active preview was cancelled
	cancel_layer_move_draft = function()
	{
		/* Only an unsubmitted active preview can be cancelled locally */
		if (!layer_move_draft_active || layer_move_draft_submitted)
		{
			return false;
		}
		layer_move_draft_active = false;
		layer_move_draft_layer_id = 0;
		layer_move_draft_target_position = 0;
		layer_move_draft_original_position = 0;
		layer_composite_dirty = true;

		/* Refresh the restored order immediately outside a layer rebuild */
		if (!layer_surface_rebuild_active)
		{
			composite_layers();
		}
		set_screenshot_status("Layer move preview cancelled.", make_color_rgb(255, 220, 95));
		return true;
	}

	/// @description Submit the previewed layer order and lock it until online authority resolves it
	/// @returns {Bool} Whether the preview was submitted or an invalid preview was cancelled
	apply_layer_move_draft = function()
	{
		/* Submission requires an active preview that has not already been sent */
		if (!layer_move_draft_active || layer_move_draft_submitted)
		{
			return false;
		}

		/* Resolve the preview's stable layer ID against the current layer stack */
		var source_index = layer_index_from_id(layer_move_draft_layer_id);

		/* Snapshot active layer positions to translate the preview position into the full
		stack index */
		var active_indices = active_layer_indices();

		/* Cancel a preview whose source disappeared or whose target no longer lies in the
		active stack */
		if (source_index == noone
		|| layer_move_draft_target_position < 0
		|| layer_move_draft_target_position >= array_length(active_indices))
		{
			return cancel_layer_move_draft();
		}

		/* Convert the active-stack target position into its current full layer-array index */
		var target_index = active_indices[layer_move_draft_target_position];

		/* Build the authoritative move request using the preview's stable layer identity and
		current name */
		var item = make_layer_history_item(DRAW_LAYER_MOVE, layer_move_draft_layer_id, target_index, layers[source_index].name, 0, true);

		/* A failed send keeps the preview available instead of marking it submitted */
		if (!send_layer_history_item(item))
		{
			return false;
		}

		/* Borrow client mode after submission to determine whether the move was already
		applied locally */
		var client = scr_get_client();

		/* Singleplayer closes the preview immediately and displays the newly committed order */
		if (is_struct(client)
		&& variable_struct_exists(client, "singleplayer_mode")
		&& client.singleplayer_mode)
		{
			layer_move_draft_active = false;
			layer_move_draft_submitted = false;
			layer_composite_dirty = true;
			composite_layers();
			set_screenshot_status("Layer order updated.", make_color_rgb(94, 215, 122));
			return true;
		}

		/* Online submission locks the preview until the server's move or vote outcome arrives */
		layer_move_draft_submitted = true;
		set_screenshot_status("Layer order request sent.", make_color_rgb(94, 215, 122));
		return true;
	}

	/// @description Request archiving of the active layer while retaining at least one active paint layer
	/// @returns {Bool} Whether the archive request was submitted
	archive_active_layer = function()
	{
		ensure_default_layers();

		/* Keep at least one unarchived paint layer available instead of archiving the final
		active layer */
		if (active_layer_count() <= 1)
		{
			return false;
		}

		/* Resolve the active layer selected for archiving */
		var source_index = active_layer_index();

		/* Borrow its stable identity and name for the structural history request */
		var source_layer = layers[source_index];

		/* Build an archive request without changing local pixels before authoritative
		application */
		var item = make_layer_history_item(DRAW_LAYER_ARCHIVE, source_layer.id, source_index, source_layer.name, 0, true);
		return send_layer_history_item(item);
	}

	/// @description Request restoration of the newest archived layer and select it after immediate local application
	/// @returns {Bool} Whether the restore request was submitted
	restore_latest_archived_layer = function()
	{
		/* Locate the most recently archived layer by its archive sequence */
		var restore_index = latest_archived_layer_index();

		/* No archived layer means there is nothing to restore */
		if (restore_index == noone)
		{
			return false;
		}

		/* Borrow the archived layer's identity and displayed name */
		var restore_layer = layers[restore_index];

		/* Request restoration at its existing layer-array position */
		var item = make_layer_history_item(DRAW_LAYER_RESTORE, restore_layer.id, restore_index, restore_layer.name, 0, true);

		/* Keep whether the restore request was locally committed or successfully sent */
		var result = send_layer_history_item(item);

		/* Select and blink the restored layer immediately only when local application has
		already unarchived it */
		if (result && !layer_is_archived(restore_layer))
		{
			active_layer_id = restore_layer.id;
			trigger_layer_blink(active_layer_id);
		}
		return result;
	}

	/// @description Toggle a layer's local view preference and refresh the composite when rebuilding permits it
	/// @param {Real} layer_id Stable layer identity whose local visibility should change
	/// @returns {Bool} Whether the requested layer existed
	toggle_layer_visibility = function(layer_id)
	{
		/* Resolve the requested stable ID before toggling its local visibility */
		var layer_index = layer_index_from_id(layer_id);

		/* An unknown layer has no local view preference to toggle */
		if (layer_index == noone)
		{
			return false;
		}

		/* Visibility is a local view preference, not a shared drawing edit */
		layers[layer_index].visible = !layers[layer_index].visible;
		layer_composite_dirty = true;

		/* Rebuild the visible composite immediately when no enclosing layer reconstruction is
		active */
		if (!layer_surface_rebuild_active)
		{
			composite_layers();
		}

		debug_last_replication_status = "layer visibility local";

		/* Describe the layer as shown or hidden according to its updated local visibility flag */
		debug_note("layer visibility local", layers[layer_index].name + " " + (layers[layer_index].visible ? "shown" : "hidden"));
		return true;
	}
	#endregion /* Client Drawing Submission END */

	#region /* World Tool Actions and Text Entry */
	/// @description Submit a Wall segment or local paint segment, letting the Eraser also remove shared walls
	/// @param {Real} from_x World-pixel segment start x
	/// @param {Real} from_y World-pixel segment start y
	/// @param {Real} to_x World-pixel segment end x
	/// @param {Real} to_y World-pixel segment end y
	/// @returns {Bool} Whether paint submission or shared wall handling accepted the segment
	send_current_segment = function(from_x, from_y, to_x, to_y)
	{
		/* Borrow the shared wall subsystem because wall geometry is separate from paint-layer
		pixels */
		var walls = scr_get_walls();

		/* Combine the selected brush RGB channels into the color passed to wall segment
		submission */
		var wall_colour = make_color_rgb(brush_red, brush_green, brush_blue);

		/* The Wall tool sends world geometry instead of a paint history command */
		if (tool == DRAW_TOOL_WALL)
		{
			/* A server that disables wall drawing blocks this segment and reports the
			restriction */
			if (!walls.can_draw())
			{
				set_screenshot_status("Wall drawing is turned off or unavailable on this server.", make_color_rgb(255, 220, 95));
				return false;
			}

			/* Submit the wall segment with at least four world pixels of thickness and keep
			its acceptance result */
			var wall_sent = walls.send_segment(from_x, from_y, to_x, to_y, max(4, brush_width), wall_colour);

			/* Only an accepted wall segment records the selected opaque color in recent colors */
			if (wall_sent)
			{
				record_recent_color(brush_red, brush_green, brush_blue, 255);
			}

			/* Return the wall subsystem's segment outcome without submitting a paint primitive */
			return wall_sent;
		}

		/* Walls belong to the shared world, so every player can erase them
		regardless of which painting layer is selected or hidden */
		/* Begin with no wall removal, then let the Eraser try shared wall erasing as well as
		paint erasing */
		var wall_erased = false;

		/* An Eraser stroke targets shared walls regardless of the local paint layer */
		if (tool == DRAW_TOOL_ERASER)
		{
			wall_erased = walls.send_segment(from_x, from_y, to_x, to_y, brush_width, wall_colour, true);
		}
		ensure_local_undo_group();

		/* Circle commands use the box-based interpretation flag while other segment tools
		leave it zero */
		var circle_uses_box = tool == DRAW_TOOL_CIRCLE ? 1 : 0;

		/* Build the paint command from current tool, brush channels, width and world-space
		endpoints */
		var command = make_command(tool, brush_red, brush_green, brush_blue, brush_width, from_x, from_y, to_x, to_y, circle_uses_box);

		/* Keep the local paint submission outcome separately from any wall removal */
		var paint_sent = send_client_command(command);

		/* An accepted paint stroke or shared wall erase makes this segment successful */
		return paint_sent || wall_erased;
	}

	/// @description Clip the camera rectangle to room pixels and shrink oversized fill work around the chosen seed
	/// @param {Real} world_x Chosen world-pixel horizontal position
	/// @param {Real} world_y Chosen world-pixel vertical position
	/// @param {Camera} camera_id View camera whose rectangle bounds the fill
	/// @returns {Struct} Inclusive world-pixel bounds and limited metadata, or noone for an invalid camera handle
	fill_bounds_for_view = function(world_x, world_y, camera_id)
	{
		/* Fill bounds require a numeric nonnegative camera handle */
		if (!is_real(camera_id) || camera_id < 0)
		{
			return noone;
		}

		/* Round and clip the camera's left world-pixel edge inside the room */
		var view_left = clamp(round(camera_get_view_x(camera_id)), 0, room_width - 1);

		/* Round and clip its top world-pixel edge inside the room */
		var view_top = clamp(round(camera_get_view_y(camera_id)), 0, room_height - 1);

		/* Compute the inclusive right view pixel and clip it inside the room */
		var view_right = clamp(round(camera_get_view_x(camera_id) + camera_get_view_width(camera_id) - 1), 0, room_width - 1);

		/* Compute the inclusive bottom view pixel and clip it inside the room */
		var view_bottom = clamp(round(camera_get_view_y(camera_id) + camera_get_view_height(camera_id) - 1), 0, room_height - 1);

		/* Count view columns including both horizontal edges */
		var view_w = view_right - view_left + 1;

		/* Count view rows including both vertical edges */
		var view_h = view_bottom - view_top + 1;

		/* Mark whether the visible pixel area exceeds the permitted fill work area */
		var limited = view_w * view_h > max_fill_bounds_area;

		/* Oversized views receive a smaller fill rectangle around the clicked pixel */
		if (limited)
		{
			/* Preserve the visible aspect ratio while fitting the work area under the
			safety limit. Centre it on the clicked pixel, then clamp it to the view */
			/* Scale both dimensions by the square root of the allowed area ratio to preserve
			the view's proportions */
			var bounds_scale = sqrt(max_fill_bounds_area / max(1, view_w * view_h));

			/* Choose an integer work width with at least one column */
			var bounds_w = max(1, floor(view_w * bounds_scale));

			/* Choose an integer work height with at least one row */
			var bounds_h = max(1, floor(view_h * bounds_scale));

			/* Reduce integer dimensions until their product fits the exact fill area ceiling */
			while (bounds_w * bounds_h > max_fill_bounds_area)
			{
				/* Trim the longer or equal width first to keep the reduced rectangle balanced */
				if (bounds_w >= bounds_h)
				{
					bounds_w--;
				}

				/* Otherwise trim its longer height */
				else
				{
					bounds_h--;
				}
			}

			view_left = clamp(round(world_x - (bounds_w - 1) * 0.5), view_left, view_right - bounds_w + 1);
			view_top = clamp(round(world_y - (bounds_h - 1) * 0.5), view_top, view_bottom - bounds_h + 1);
			view_right = view_left + bounds_w - 1;
			view_bottom = view_top + bounds_h - 1;
			view_w = bounds_w;
			view_h = bounds_h;
		}

		/* Return inclusive world-pixel edges, pixel width and height, and the limited flag
		describing whether the original view exceeded the cap */
		return
		{
			left: view_left,
			top: view_top,
			right: view_right,
			bottom: view_bottom,
			width: view_w,
			height: view_h,
			limited: limited
		};
	}

	/// @description Start one camera-bounded local fill with an undo group and accepted-action cooldown
	/// @param {Real} world_x Chosen world-pixel horizontal position
	/// @param {Real} world_y Chosen world-pixel vertical position
	/// @param {Camera} camera_id View camera whose rectangle bounds the fill
	/// @returns {Bool} Whether local fill startup succeeded
	send_fill_at = function(world_x, world_y, camera_id)
	{
		/* A second local fill waits until the current progressive fill has finished */
		if (fill_job_active())
		{
			set_screenshot_status("Wait for the current fill to finish.", make_color_rgb(255, 220, 95));
			return false;
		}

		/* Compute a camera-clipped and area-limited work rectangle around the chosen world
		pixel */
		var fill_bounds = fill_bounds_for_view(world_x, world_y, camera_id);

		/* A missing bounds struct identifies a camera that cannot start this fill */
		if (!is_struct(fill_bounds))
		{
			debug_note("fill skipped", "invalid camera");
			set_screenshot_status("Fill could not start: invalid camera.", make_color_rgb(244, 84, 84));
			return false;
		}

		/* The fill action's millisecond cooldown blocks repeated starts before creating an
		undo group */
		if (action_cooldown_blocks("fill"))
		{
			return false;
		}

		begin_local_undo_group();

		/* Build one fill command carrying its seed, inclusive work bounds, selected layer and
		visible-layer sampling preference */
		var command = make_command(DRAW_TOOL_FILL, brush_red, brush_green, brush_blue, brush_width, world_x, world_y, fill_bounds.left, fill_bounds.top, fill_bounds.right, fill_bounds.bottom, "", active_layer_id, fill_sample_visible_layers);

		/* Keep whether local command submission actually started the fill */
		var result = send_client_command(command);
		end_local_undo_group();

		/* Only a started fill consumes the action cooldown */
		if (result)
		{
			start_action_cooldown("fill");

			/* Explain the reduced fill dimensions when the camera area exceeded the safety cap */
			if (fill_bounds.limited)
			{
				set_screenshot_status("Fill area limited to " + string(fill_bounds.width) + "x" + string(fill_bounds.height) + " at this zoom.", make_color_rgb(255, 220, 95));
			}
		}

		/* A rejected or empty fill reports that the clicked pixel produced no fill work */
		else
		{
			set_screenshot_status("Nothing to fill here.", make_color_rgb(255, 220, 95));
		}

		/* Report local fill startup rather than waiting for its eventual upload */
		return result;
	}

	/// @description Resolve the selected layer's human-readable label with a numeric identity fallback
	/// @returns {String} Active layer display label
	active_layer_display_text = function()
	{
		/* Resolve the active stable layer identity to its displayed layer record */
		var layer_index = active_layer_index();

		/* An unresolved layer retains a numeric fallback label instead of reading a
		nonexistent record */
		if (layer_index == noone)
		{
			return "Layer " + string(active_layer_id);
		}

		return "Layer: " + layers[layer_index].name;
	}

	/// @description Scale stamp dimensions from brush width while preserving proportions within world limits
	/// @param {Real} base_stamp_w Unscaled stamp width in source pixels
	/// @param {Real} base_stamp_h Unscaled stamp height in source pixels
	/// @returns {Struct} Source and placement dimensions, requested and accepted scales, and a capped flag
	stamp_world_size_for_brush = function(base_stamp_w, base_stamp_h)
	{
		/* Normalize the original stamp width to a positive integer source-pixel count */
		var base_w = max(1, floor(real(base_stamp_w)));

		/* Normalize its source height to the same positive integer convention */
		var base_h = max(1, floor(real(base_stamp_h)));

		/* Translate brush width into a requested scale relative to the default stamp brush,
		with a minimum one-eighth scale */
		var requested_scale = max(0.125, real(brush_width) / max(1, stamp_default_brush_width));

		/* Limit placement width to both the room and the configured maximum stamp size */
		var max_world_w = max(1, min(room_width, stamp_max_world_size));

		/* Limit placement height to both the room and the configured maximum stamp size */
		var max_world_h = max(1, min(room_height, stamp_max_world_size));

		/* Choose the scale that would bring the longer source dimension to the preferred
		minimum world size */
		var minimum_scale = stamp_min_world_size / max(base_w, base_h);

		/* Balance the requested or minimum size against both world-dimension ceilings while
		preserving source proportions */
		var final_scale = min(max(requested_scale, minimum_scale), min(max_world_w / base_w, max_world_h / base_h));

		/* Round the final horizontal placement size into its permitted world-pixel range */
		var final_w = clamp(round(base_w * final_scale), 1, max_world_w);

		/* Round the vertical placement size into its permitted world-pixel range */
		var final_h = clamp(round(base_h * final_scale), 1, max_world_h);

		/* The result carries placed stamp_w and stamp_h, original source_w and source_h,
		accepted and requested scales, and capped=true when acceptance falls more than 0.001
		below the request */
		return
		{
			stamp_w: final_w,
			stamp_h: final_h,
			source_w: base_w,
			source_h: base_h,
			scale_amount: final_scale,
			requested_scale: requested_scale,
			capped: final_scale < requested_scale - 0.001
		};
	}

	/// @description Format placed stamp dimensions for user feedback
	/// @param {Struct} stamp_size Computed stamp placement dimensions and scale
	/// @returns {String} Width x height text, or empty when required size fields are absent
	stamp_world_size_text = function(stamp_size)
	{
		/* A tooltip needs both placed dimensions, otherwise it has no size text to display */
		if (!is_struct(stamp_size)
		|| !variable_struct_exists(stamp_size, "stamp_w")
		|| !variable_struct_exists(stamp_size, "stamp_h"))
		{
			return "";
		}

		return string(stamp_size.stamp_w) + "x" + string(stamp_size.stamp_h);
	}

	/// @description Format accepted stamp scale as an integer percentage of at least one percent
	/// @param {Struct} stamp_size Computed stamp placement dimensions and scale
	/// @returns {String} Scale percentage, or empty when the scale field is absent
	stamp_world_scale_text = function(stamp_size)
	{
		/* A scale tooltip needs the accepted scale field, otherwise it returns no percentage */
		if (!is_struct(stamp_size)
		|| !variable_struct_exists(stamp_size, "scale_amount"))
		{
			return "";
		}

		return string(max(1, round(stamp_size.scale_amount * 100))) + "%";
	}

	/// @description Resolve current stamp metadata and add its brush-scaled placement size
	/// @returns {Struct} Placement and selection metadata, or noone when unavailable
	selected_stamp_world_size = function()
	{
		/* Borrow the stamp manager that owns the current selection and its size metadata */
		var stamp_manager = scr_get_stamps();

		/* An unavailable manager or size method means no selected stamp size can be resolved */
		if (!is_struct(stamp_manager)
		|| !variable_struct_exists(stamp_manager, "selected_size"))
		{
			return noone;
		}

		/* Request the currently selected stamp's source dimensions and placement metadata */
		var selected_stamp_size = stamp_manager.selected_size();

		/* A missing selection cannot produce a world-size description */
		if (selected_stamp_size == noone)
		{
			return noone;
		}

		/* Calculate this selection's placed dimensions using the current brush width */
		var result = stamp_world_size_for_brush(selected_stamp_size.stamp_w, selected_stamp_size.stamp_h);

		/* Carry image_only=true only when the selected metadata explicitly marks the stamp as
		an image */
		result.image_only = variable_struct_exists(selected_stamp_size, "image_only") && selected_stamp_size.image_only;

		/* Carry editable_pixels=true only when the selected stamp explicitly supports pixel
		editing */
		result.editable_pixels = variable_struct_exists(selected_stamp_size, "editable_pixels") && selected_stamp_size.editable_pixels;

		/* Preserve a selected stamp label when supplied, otherwise use an empty label */
		result.label = variable_struct_exists(selected_stamp_size, "label") ? selected_stamp_size.label : "";
		return result;
	}

	/// @description Describe the current stamp size and include scale for image-only stamps
	/// @returns {String} Stamp size tooltip label
	stamp_size_tooltip_text = function()
	{
		/* Resolve the selected stamp's current brush-scaled placement for its size tooltip */
		var stamp_size = selected_stamp_world_size();

		/* Without a selection, use the generic Stamp Size label */
		if (stamp_size == noone)
		{
			return "Stamp Size";
		}

		/* Image-only selections display both world dimensions and accepted percentage scale */
		if (variable_struct_exists(stamp_size, "image_only")
		&& stamp_size.image_only)
		{
			return "Image Stamp: " + stamp_world_size_text(stamp_size) + " " + stamp_world_scale_text(stamp_size);
		}

		return "Stamp Size: " + stamp_world_size_text(stamp_size);
	}

	/// @description Center a stamp horizontally and clip its left origin into the room
	/// @param {Real} world_x Chosen world-pixel horizontal position
	/// @param {Real} stamp_w Placed stamp width in world pixels
	/// @returns {Real} Integer world-pixel left coordinate
	stamp_left_from_world = function(world_x, stamp_w)
	{
		/* Keep the centered stamp's left edge between room zero and the final legal origin for
		its width */
		var max_left = max(0, room_width - stamp_w);
		return clamp(round(real(world_x) - stamp_w * 0.5), 0, max_left);
	}

	/// @description Center a stamp vertically and clip its top origin into the room
	/// @param {Real} world_y Chosen world-pixel vertical position
	/// @param {Real} stamp_h Placed stamp height in world pixels
	/// @returns {Real} Integer world-pixel top coordinate
	stamp_top_from_world = function(world_y, stamp_h)
	{
		/* Keep the centered stamp's top edge between room zero and the final legal origin for
		its height */
		var max_top = max(0, room_height - stamp_h);
		return clamp(round(real(world_y) - stamp_h * 0.5), 0, max_top);
	}

	/// @description Prepare a resized PNG stamp, apply it with one undo group and queue its ordered upload
	/// @param {Real} world_x Chosen world-pixel horizontal position
	/// @param {Real} world_y Chosen world-pixel vertical position
	/// @returns {Bool} Whether local placement was accepted, even if network submission later failed
	send_stamp_at = function(world_x, world_y)
	{
		/* Inspect each queued outbound item before accepting another stamp image */
		for (var pending_index = 0; pending_index < array_length(pending_client_history_sends); pending_index++)
		{
			/* An existing image upload blocks a new stamp so large image transfers cannot
			overlap in this queue */
			if (history_item_is_image(pending_client_history_sends[pending_index]))
			{
				set_screenshot_status("Wait for the current drawing upload to finish.", make_color_rgb(255, 220, 95));
				return false;
			}
		}

		/* Respect the stamp action's millisecond cooldown before preparing PNG data */
		if (action_cooldown_blocks("stamp"))
		{
			return false;
		}

		/* Borrow the manager that owns selected stamp payloads, lazy metadata and placement
		feedback */
		var stamp_manager = scr_get_stamps();

		/* Resolve lazy PNG metadata before sizing.
		Previews may still have fallback dimensions */
		/* Resolve the source PNG payload and its actual pixel dimensions before scaling the
		stamp */
		var original_payload = stamp_manager.selected_payload();

		/* A missing or failed source payload exposes its manager message and stops placement */
		if (!original_payload.ok)
		{
			stamp_manager.set_status(original_payload.message, make_color_rgb(244, 84, 84));
			set_screenshot_status(original_payload.message, make_color_rgb(244, 84, 84));
			return false;
		}

		/* Calculate world placement dimensions from the resolved source PNG rather than
		preview fallback dimensions */
		var stamp_size = stamp_world_size_for_brush(original_payload.stamp_w, original_payload.stamp_h);

		/* Resize the shared PNG itself, not only the rectangle used to draw it */
		/* Request the resized PNG payload that will be shared at the calculated placement
		dimensions */
		var stamp_payload = stamp_manager.placement_payload(stamp_size.stamp_w, stamp_size.stamp_h);

		/* An unavailable resized payload pauses placement or reports a preparation failure */
		if (!stamp_payload.ok)
		{
			/* Distinguish a still-preparing payload from a completed failure for feedback
			coloring */
			var preparing_stamp = variable_struct_exists(stamp_payload, "pending") && stamp_payload.pending;

			/* Use yellow while preparation is pending and red when the payload failed */
			var status_colour = preparing_stamp ? make_color_rgb(255, 220, 95) : make_color_rgb(244, 84, 84);
			stamp_manager.set_status(stamp_payload.message, status_colour);
			set_screenshot_status(stamp_payload.message, status_colour);
			return false;
		}

		/* Carry the resized payload's explicit image-only flag into the history item's
		filtering choice */
		stamp_size.image_only = variable_struct_exists(stamp_payload, "image_only") && stamp_payload.image_only;

		/* Keep the final placed width in world pixels for centering and history construction */
		var stamp_w_value = stamp_size.stamp_w;

		/* Keep the final placed height in world pixels for centering and history construction */
		var stamp_h_value = stamp_size.stamp_h;

		/* Center the stamp horizontally at the click while clipping its origin to the room */
		var stamp_left = stamp_left_from_world(world_x, stamp_w_value);

		/* Center it vertically with the same room clipping */
		var stamp_top = stamp_top_from_world(world_y, stamp_h_value);
		begin_local_undo_group();

		/* Keep the new undo group's ID so this entire stamp placement can be undone together */
		var stamp_undo_id = active_undo_group_id;

		/* Build the image history with a fresh upload identity, PNG contents, centered
		placement, active layer, author and undo group */
		var stamp_item = make_image_history_item(
			make_client_image_id(),
			"Stamp " + stamp_payload.name,
			stamp_left,
			stamp_top,
			stamp_w_value,
			stamp_h_value,
			stamp_payload.base64,
			active_layer_id,
			stamp_undo_id,
			local_undo_author_id,
			local_player_id,
			local_player_name,
			stamp_size.image_only
		);

		push_client_history_item(stamp_item);

		/* Keep whether local image application was drawn or accepted into ordered asynchronous
		replay */
		var applied = apply_history_item_to_surface(stamp_item);

		/* A failed local application rolls back the appended history entry before ending its
		undo group */
		if (!applied)
		{
			/* Count history entries to locate the appended stamp that must be removed */
			var history_count = array_length(client_history);

			/* Only an existing final history entry can have its patch disposed and be removed */
			if (history_count > 0)
			{
				dispose_item_undo_patch(client_history[history_count - 1]);
				array_delete(client_history, history_count - 1, 1);
				client_history_revision++;
				client_history_replay_restart = true;
			}
			end_local_undo_group();
			stamp_manager.set_status("Could not place stamp.", make_color_rgb(244, 84, 84));
			debug_note("stamp skipped", "local apply failed");
			return false;
		}

		clear_redo_stack();

		/* Keep the outbound queue or send outcome separately from the already accepted local
		stamp */
		var sent = queue_or_send_history_item_to_server(stamp_item);
		end_local_undo_group();
		start_action_cooldown("stamp");

		/* Accepted outbound handling can confirm both the stamp name and its placed dimensions */
		if (sent)
		{
			/* Distinguish image-only stamp confirmation from the ordinary placement wording */
			var placed_label = stamp_size.image_only ? "Placed image stamp " : "Placed ";
			stamp_manager.set_status(placed_label + stamp_payload.name + " " + stamp_world_size_text(stamp_size) + ".", make_color_rgb(126, 245, 150));
		}

		/* A failed network submission leaves the locally placed stamp and reports its
		local-only state */
		else
		{
			stamp_manager.set_status("Stamp placed locally, network send failed.", make_color_rgb(255, 220, 95));
		}

		debug_note("stamp placed", stamp_payload.name + " " + stamp_world_size_text(stamp_size) + " layer=" + string(active_layer_id));

		/* Return the local placement outcome even when network submission failed */
		return applied;
	}

	/// @description Filter drawing editor input to its permitted display text and character count
	/// @param {Any} raw_text Editor contents converted to text before display filtering
	/// @returns {String} Cleaned editor text
	text_entry_clean = function(raw_text)
	{
		/* Convert incoming text to a string before enforcing the drawing entry's display and
		character rules */
		var text = string(raw_text);
		return scr_text_filter_for_display(text, max_text_chars, false, " ", " ");
	}

	/// @description Combine drawing-editor, stamp-manager and fill keyboard capture state
	/// @returns {Bool} Whether drawing interaction reserves keyboard input
	text_entry_captures_keyboard = function()
	{
		/* Borrow the stamp manager to include its own keyboard capture alongside drawing
		editors */
		var stamp_manager = scr_get_stamps();

		/* A stamp manager captures typing only when it exposes and currently enables its
		keyboard-capture method */
		var stamp_captures_keyboard = is_struct(stamp_manager)
			&& variable_struct_exists(stamp_manager, "captures_keyboard")
			&& stamp_manager.captures_keyboard();

		/* Drawing text, HSV or brush editing, stamp input, and active fills each reserve
		keyboard handling */
		return text_entry_active || hsv_input_active != "" || brush_input_active || stamp_captures_keyboard || fill_job_active();
	}

	/// @description Determine whether drawing mode or an active fill blocks player-card interaction
	/// @returns {Bool} Whether player cards should defer interaction
	blocks_player_cards = function()
	{
		/* Draw mode and active fills prevent player cards from taking the same interaction */
		return draw_mode_enabled || fill_job_active();
	}

	/// @description Discard drawing editor text, clear shared keyboard input and close the undo group
	/// @param {String} reason Diagnostic reason for closing the drawing text editor. Defaults to "cancelled"
	/// @returns {Bool} True after entry state is cleared
	cancel_text_entry = function(reason = "cancelled")
	{
		/* Clear the drawing editor and shared keyboard text before closing this entry's undo
		group */
		text_entry_active = false;
		text_entry_text = "";
		keyboard_string = "";
		end_local_undo_group();
		debug_note("text entry " + string(reason), "");
		return true;
	}

	/// @description Sanitize and submit active drawing text or cancel an empty entry
	/// @returns {Bool} Whether text was locally submitted or an empty entry was cancelled
	commit_text_entry = function()
	{
		/* Without an active text editor there is no pending drawing text to commit */
		if (!text_entry_active)
		{
			return false;
		}

		/* Sanitize the current editor contents for the replicated drawing-text format */
		var text = text_sanitize(text_entry_text);

		/* Empty sanitized text closes the entry instead of submitting an empty drawing command */
		if (text == "")
		{
			return cancel_text_entry("empty");
		}

		/* Build a text command using the editor's captured position, color, opacity and size
		while targeting the active layer and undo group */
		var command = make_command(
			DRAW_TOOL_TEXT,
			text_entry_color_r,
			text_entry_color_g,
			text_entry_color_b,
			text_entry_brush_width,
			text_entry_world_x,
			text_entry_world_y,
			text_entry_world_x,
			text_entry_world_y,
			0,
			0,
			text,
			active_layer_id,
			false,
			active_undo_group_id,
			local_undo_author_id,
			text_entry_color_a
		);

		text_entry_active = false;
		text_entry_text = "";
		keyboard_string = "";

		/* An invalid command ends its undo group without drawing or replication */
		if (command == noone)
		{
			end_local_undo_group();
			debug_note("text skipped", "invalid command");
			return false;
		}

		/* Keep the text command's local submission result before closing the group */
		var result = send_client_command(command);
		end_local_undo_group();
		return result;
	}

	/// @description Release player movement and open drawing text entry with captured position and brush style
	/// @param {Real} world_x Chosen world-pixel horizontal position
	/// @param {Real} world_y Chosen world-pixel vertical position
	/// @returns {Bool} True after opening the editor
	begin_text_entry = function(world_x, world_y)
	{
		/* Borrow movement control so beginning a text editor can release held player movement */
		var movement_client = scr_get_client();

		/* Release local movement only when the client exposes that integration method */
		if (is_struct(movement_client)
		&& variable_struct_exists(movement_client, "release_local_movement"))
		{
			movement_client.release_local_movement();
		}

		begin_local_undo_group();

		/* Open text editing and capture integer world position, RGB and alpha bytes, and brush
		width for this entry, then begin with empty text */
		text_entry_active = true;
		text_entry_world_x = round(world_x);
		text_entry_world_y = round(world_y);
		text_entry_color_r = brush_red;
		text_entry_color_g = brush_green;
		text_entry_color_b = brush_blue;
		text_entry_color_a = brush_alpha;
		text_entry_brush_width = brush_width;
		text_entry_text = "";
		keyboard_string = "";
		debug_note("text entry started", string(text_entry_world_x) + "," + string(text_entry_world_y));
		return true;
	}

	/// @description Open drawing text entry at the requested world position
	/// @param {Real} world_x Chosen world-pixel horizontal position
	/// @param {Real} world_y Chosen world-pixel vertical position
	/// @returns {Bool} Whether the text-entry start was handled
	send_text_at = function(world_x, world_y)
	{
		return begin_text_entry(world_x, world_y);
	}

	/// @description Update active drawing text and handle Escape cancellation or Enter submission
	/// @returns {Bool} Whether an active editor handled this input pass
	update_text_entry_input = function()
	{
		/* This input path handles keyboard text only while the drawing editor is open */
		if (!text_entry_active)
		{
			return false;
		}

		scr_text_input_update("drawing_text", text_entry_text, max_text_chars);
		text_entry_text = text_entry_clean(keyboard_string);
		keyboard_string = text_entry_text;

		/* Escape discards the pending text and consumes this editor input pass */
		if (keyboard_check_pressed(vk_escape))
		{
			cancel_text_entry();
			return true;
		}

		/* Enter commits the pending text and consumes the same input pass */
		if (keyboard_check_pressed(vk_enter))
		{
			commit_text_entry();
			return true;
		}

		debug_note("text entry typing", string(string_length(text_entry_text)) + " char(s)");
		return true;
	}

	/// @description Retain the unused asynchronous text-dialog compatibility hook
	/// @param {DS Map} dialog_map Borrowed legacy dialog event map, currently unused
	/// @returns {Bool} False because this hook currently handles no dialog
	handle_text_dialog_async = function(dialog_map)
	{
		/* This legacy dialog hook currently handles no asynchronous dialogs */
		return false;
	}
	#endregion /* World Tool Actions and Text Entry END */

	#region /* Brush Color and Size Controls */
	/// @description Convert clipped RGB bytes into stored hue, saturation and value bytes
	/// @param {Real} red Red channel in the zero-to-255 byte range
	/// @param {Real} green Green channel in the zero-to-255 byte range
	/// @param {Real} blue Blue channel in the zero-to-255 byte range
	set_hsv_from_rgb = function(red, green, blue)
	{
		/* Normalize the selected red byte into the zero-to-one range used by HSV conversion */
		var r = clamp(real(red), 0, 255) / 255;

		/* Normalize the green byte into the same component range */
		var g = clamp(real(green), 0, 255) / 255;

		/* Normalize the blue byte into the same component range */
		var b = clamp(real(blue), 0, 255) / 255;

		/* The largest RGB component becomes HSV value and identifies the dominant hue sector */
		var max_c = max(r, max(g, b));

		/* The smallest component establishes the neutral contribution shared by all channels */
		var min_c = min(r, min(g, b));

		/* Chromatic range is the largest component minus the smallest */
		var delta = max_c - min_c;

		/* Achromatic colors begin with hue zero because equal components provide no hue
		direction */
		var hue_degrees = 0;

		/* Only a nonzero chromatic range can safely define hue through component differences */
		if (delta > 0)
		{
			/* A red-dominant color uses the sector centered on red */
			if (max_c == r)
			{
				hue_degrees = 60 * ((g - b) / delta);
			}

			/* A green-dominant color offsets the component difference into the green sector */
			else if (max_c == g)
			{
				hue_degrees = 60 * (((b - r) / delta) + 2);
			}

			/* Otherwise blue is dominant and uses the blue-sector offset */
			else
			{
				hue_degrees = 60 * (((r - g) / delta) + 4);
			}
		}

		/* Wrap a negative hue angle into the nonnegative color wheel */
		if (hue_degrees < 0)
		{
			hue_degrees += 360;
		}

		/* Wrap the full-turn endpoint back inside the zero-to-360-degree interval */
		if (hue_degrees >= 360)
		{
			hue_degrees -= 360;
		}

		hue_value = clamp(round(hue_degrees / 360 * 255), 0, 255);

		/* Black has zero saturation, while other colors express chromatic range relative to
		their brightest component */
		saturation_value = max_c <= 0 ? 0 : clamp(round(delta / max_c * 255), 0, 255);
		value_value = clamp(round(max_c * 255), 0, 255);
	}

	/// @description Convert byte-scaled HSV into rounded RGB channel bytes
	/// @param {Real} hue Hue scaled to the zero-to-255 storage range
	/// @param {Real} saturation Saturation scaled to the zero-to-255 storage range
	/// @param {Real} value HSV brightness byte or numeric value to convert
	/// @returns {Struct} r, g and b fields in the zero-to-255 range
	hsv_to_rgb_struct = function(hue, saturation, value)
	{
		/* Convert the stored hue byte to a color-wheel angle in degrees */
		var h = clamp(real(hue), 0, 255) / 255 * 360;

		/* The maximum hue byte reaches a full turn, which is equivalent to degree zero */
		if (h >= 360)
		{
			h = 0;
		}

		/* Convert stored saturation into its zero-to-one fraction */
		var s = clamp(real(saturation), 0, 255) / 255;

		/* Convert stored value into its zero-to-one brightness */
		var v = clamp(real(value), 0, 255) / 255;

		/* Chroma is the colored portion of the brightest channel before adding the shared
		neutral component */
		var c = v * s;

		/* Measure hue in sixty-degree sectors */
		var section = h / 60;

		/* Choose the integer sector that determines which RGB channels receive chroma and its
		mixture */
		var sector = floor(section);

		/* Keep the fractional position in alternating two-sector pairs for the hue mixture */
		var section_mod2 = section - floor(section / 2) * 2;

		/* Calculate the secondary channel contribution as hue travels between adjacent primary
		colors */
		var hsv_mix = c * (1 - abs(section_mod2 - 1));

		/* Begin the red chromatic contribution at zero until the selected sector assigns it */
		var r1 = 0;

		/* Begin the green chromatic contribution at zero until that sector assigns it */
		var g1 = 0;

		/* Begin the blue chromatic contribution at zero until that sector assigns it */
		var b1 = 0;

		/* Assign chroma and the secondary mixture according to the hue's six color-wheel
		sectors */
		switch (sector)
		{
			/* The red-to-yellow sector raises green while red remains brightest */
			case 0:
				r1 = c; g1 = hsv_mix; b1 = 0;
				break;

			/* The yellow-to-green sector lowers red while green remains brightest */
			case 1:
				r1 = hsv_mix; g1 = c; b1 = 0;
				break;

			/* The green-to-cyan sector raises blue while green remains brightest */
			case 2:
				r1 = 0; g1 = c; b1 = hsv_mix;
				break;

			/* The cyan-to-blue sector lowers green while blue remains brightest */
			case 3:
				r1 = 0; g1 = hsv_mix; b1 = c;
				break;

			/* The blue-to-magenta sector raises red while blue remains brightest */
			case 4:
				r1 = hsv_mix; g1 = 0; b1 = c;
				break;

			/* The final magenta-to-red sector lowers blue while red remains brightest */
			default:
				r1 = c; g1 = 0; b1 = hsv_mix;
				break;
		}

		/* Add the shared neutral brightness left after the chromatic contribution */
		var m = v - c;

		/* Return rounded and clamped r, g and b byte fields after adding neutral brightness to
		each channel */
		return
		{
			r: clamp(round((r1 + m) * 255), 0, 255),
			g: clamp(round((g1 + m) * 255), 0, 255),
			b: clamp(round((b1 + m) * 255), 0, 255)
		};
	}

	/// @description Convert byte-scaled HSV into a packed RGB color without a temporary result struct
	/// @param {Real} hue Hue scaled to the zero-to-255 storage range
	/// @param {Real} saturation Saturation scaled to the zero-to-255 storage range
	/// @param {Real} value HSV brightness byte or numeric value to convert
	/// @returns {Color} Packed RGB color
	hsv_to_colour = function(hue, saturation, value)
	{
		/* Keep the packed-colour path allocation-free. This is used while building
		gradient caches and used to allocate one temporary RGB struct per segment */
		/* Convert the hue byte to degrees for the allocation-free packed-color calculation */
		var h = clamp(real(hue), 0, 255) / 255 * 360;

		/* A full-turn hue wraps to the red endpoint */
		if (h >= 360)
		{
			h = 0;
		}

		/* Normalize saturation into the zero-to-one conversion range */
		var s = clamp(real(saturation), 0, 255) / 255;

		/* Normalize brightness into the zero-to-one conversion range */
		var v = clamp(real(value), 0, 255) / 255;

		/* Separate chroma from the neutral brightness added after sector selection */
		var c = v * s;

		/* Express hue as a position among sixty-degree sectors */
		var section = h / 60;

		/* Choose the RGB assignment sector */
		var sector = floor(section);

		/* Keep the alternating sector position for the secondary channel mixture */
		var section_mod2 = section - floor(section / 2) * 2;

		/* Calculate the mixture shared between the neighboring primary-color directions */
		var hsv_mix = c * (1 - abs(section_mod2 - 1));

		/* Start the red chromatic contribution at zero until sector assignment */
		var r1 = 0;

		/* Start the green chromatic contribution at zero until sector assignment */
		var g1 = 0;

		/* Start the blue chromatic contribution at zero until sector assignment */
		var b1 = 0;

		/* Choose the same six hue sectors without allocating the RGB result struct */
		switch (sector)
		{
			/* Red stays brightest while green rises toward yellow */
			case 0:
				r1 = c; g1 = hsv_mix; b1 = 0;
				break;

			/* Green stays brightest while red falls toward green */
			case 1:
				r1 = hsv_mix; g1 = c; b1 = 0;
				break;

			/* Green stays brightest while blue rises toward cyan */
			case 2:
				r1 = 0; g1 = c; b1 = hsv_mix;
				break;

			/* Blue stays brightest while green falls toward blue */
			case 3:
				r1 = 0; g1 = hsv_mix; b1 = c;
				break;

			/* Blue stays brightest while red rises toward magenta */
			case 4:
				r1 = hsv_mix; g1 = 0; b1 = c;
				break;

			/* Red stays brightest while blue falls back toward red */
			default:
				r1 = c; g1 = 0; b1 = hsv_mix;
				break;
		}

		/* Restore the neutral brightness common to all three RGB channels */
		var m = v - c;
		return make_color_rgb(
			clamp(round((r1 + m) * 255), 0, 255),
			clamp(round((g1 + m) * 255), 0, 255),
			clamp(round((b1 + m) * 255), 0, 255)
		);
	}

	/// @description Update brush RGB from current HSV state and make the selected brush fully opaque
	set_brush_from_hsv = function()
	{
		/* Convert the current stored HSV bytes into one packed brush color */
		var brush_colour = hsv_to_colour(hue_value, saturation_value, value_value);
		brush_red = colour_get_red(brush_colour);
		brush_green = colour_get_green(brush_colour);
		brush_blue = colour_get_blue(brush_colour);
		brush_alpha = 255;
	}

	/// @description Set clipped integer brush RGBA bytes and update HSV only for nontransparent selections
	/// @param {Real} red Red channel in the zero-to-255 byte range
	/// @param {Real} green Green channel in the zero-to-255 byte range
	/// @param {Real} blue Blue channel in the zero-to-255 byte range
	/// @param {Real} alpha Opacity byte, zero transparent and 255 opaque. Defaults to 255
	set_brush_rgba = function(red, green, blue, alpha = 255)
	{
		brush_red = clamp(floor(real(red)), 0, 255);
		brush_green = clamp(floor(real(green)), 0, 255);
		brush_blue = clamp(floor(real(blue)), 0, 255);
		brush_alpha = clamp(floor(real(alpha)), 0, 255);

		/* Only a nontransparent selection updates HSV controls, retaining their previous
		values for the transparent brush */
		if (brush_alpha > 0)
		{
			set_hsv_from_rgb(brush_red, brush_green, brush_blue);
		}
	}

	/// @description Set clipped brush RGB channels with fully opaque alpha
	/// @param {Real} red Red channel in the zero-to-255 byte range
	/// @param {Real} green Green channel in the zero-to-255 byte range
	/// @param {Real} blue Blue channel in the zero-to-255 byte range
	set_brush_rgb = function(red, green, blue)
	{
		set_brush_rgba(red, green, blue, 255);
	}

	/// @description Select a transparent black brush without changing the retained HSV controls
	set_brush_transparent = function()
	{
		brush_red = 0;
		brush_green = 0;
		brush_blue = 0;
		brush_alpha = 0;
	}

	/// @description Resolve a swatch's explicit alpha or the opaque default for RGB-only swatches
	/// @param {Struct} swatch Borrowed swatch with RGB fields and optional alpha
	/// @returns {Real} Clipped integer alpha byte
	swatch_alpha = function(swatch)
	{
		/* Use a swatch's explicit alpha byte when available */
		if (is_struct(swatch)
		&& variable_struct_exists(swatch, "a"))
		{
			return clamp(floor(real(swatch.a)), 0, 255);
		}

		/* Older RGB-only swatches remain fully opaque */
		return 255;
	}

	/// @description Compare all current brush channels with a swatch's resolved RGBA values
	/// @param {Struct} swatch Borrowed swatch with RGB fields and optional alpha
	/// @returns {Bool} Whether the swatch matches the brush
	brush_matches_swatch = function(swatch)
	{
		/* A missing swatch record cannot match the current brush */
		if (!is_struct(swatch))
		{
			return false;
		}

		/* A brush matches only when its red, green, blue and resolved alpha bytes all agree */
		return brush_red == swatch.r
			&& brush_green == swatch.g
			&& brush_blue == swatch.b
			&& brush_alpha == swatch_alpha(swatch);
	}

	/// @description Return the numeric editor ceiling for the selected HSV channel
	/// @param {String} slider_key HSV channel key or routed toolbar slider name
	/// @returns {Real} 360 for hue or 100 for other keys
	hsv_input_max = function(slider_key)
	{
		/* Hue entry spans 360 degrees, while saturation and value entries span 100 percent */
		return slider_key == "hue" ? 360 : 100;
	}

	/// @description Return the displayed unit for the selected HSV channel
	/// @param {String} slider_key HSV channel key or routed toolbar slider name
	/// @returns {String} deg for hue or % for other keys
	hsv_input_unit = function(slider_key)
	{
		/* Label hue as degrees and both other HSV controls as percentages */
		return slider_key == "hue" ? "deg" : "%";
	}

	/// @description Convert a stored HSV channel to displayed degrees or percent
	/// @param {String} slider_key HSV channel key or routed toolbar slider name
	/// @returns {Real} Rounded editor value, or zero for an unknown key
	hsv_input_display_value = function(slider_key)
	{
		/* Convert the requested stored HSV channel to its human-readable editor range */
		switch (slider_key)
		{
			/* Hue displays the rounded color-wheel angle in degrees */
			case "hue":
				return clamp(round(hue_value / 255 * 360), 0, 360);

			/* Saturation displays the rounded chromatic percentage */
			case "saturation":
				return clamp(round(saturation_value / 255 * 100), 0, 100);

			/* Value displays the rounded brightness percentage */
			case "value":
				return clamp(round(value_value / 255 * 100), 0, 100);
		}

		/* Unknown slider names display zero rather than accessing an unrelated channel */
		return 0;
	}

	/// @description Apply a clipped editor value to its HSV channel and refresh the opaque brush color
	/// @param {String} slider_key HSV channel key or routed toolbar slider name
	/// @param {Real} raw_value User-entered displayed value or brush width before clamping
	/// @returns {Bool} Whether the channel key was recognized
	set_hsv_input_display_value = function(slider_key, raw_value)
	{
		/* Clamp entered integer text to the selected channel's displayed degrees or percentage
		range */
		var display_value = clamp(floor(real(raw_value)), 0, hsv_input_max(slider_key));

		/* Apply the displayed value to the matching internal zero-to-255 HSV channel */
		switch (slider_key)
		{
			/* Convert entered hue degrees into the stored hue byte */
			case "hue":
				hue_value = clamp(round(display_value / 360 * 255), 0, 255);
				break;

			/* Convert entered saturation percent into the stored saturation byte */
			case "saturation":
				saturation_value = clamp(round(display_value / 100 * 255), 0, 255);
				break;

			/* Convert entered brightness percent into the stored value byte */
			case "value":
				value_value = clamp(round(display_value / 100 * 255), 0, 255);
				break;

			/* An unrecognized channel cannot update the brush */
			default:
				return false;
		}

		set_brush_from_hsv();
		return true;
	}

	/// @description Retain at most three decimal digits from HSV numeric editor text
	/// @param {Any} raw_text Numeric editor input converted to text
	/// @returns {String} Cleaned numeric text
	hsv_input_clean = function(raw_text)
	{
		/* Read numeric editor input as text before retaining permitted characters */
		var text = string(raw_text);

		/* Start with no accepted digits and append them in their original order */
		var clean = "";

		/* Walk one-based string positions until the source ends or three accepted digits are
		retained */
		for (var i = 1; i <= string_length(text); i++)
		{
			/* Inspect this character for membership in the decimal-digit set */
			var ch = string_char_at(text, i);

			/* Ignore every character outside decimal digits */
			if (string_pos(ch, "0123456789") > 0)
			{
				clean += ch;

				/* Three retained digits cover the maximum hue value and bound the input
				field's length */
				if (string_length(clean) >= 3)
				{
					break;
				}
			}
		}

		return clean;
	}

	/// @description Translate an HSV numeric-field hover key into its channel name
	/// @param {String} hover_key Toolbar hover target to resolve
	/// @returns {String} HSV channel key or an empty string for other targets
	hsv_input_key_from_hover = function(hover_key)
	{
		/* Translate numeric-field hover keys into their corresponding HSV channel names */
		switch (hover_key)
		{
			/* The hue numeric field edits the hue channel */
			case "hue_input":
				return "hue";

			/* The saturation numeric field edits saturation */
			case "saturation_input":
				return "saturation";

			/* The value numeric field edits brightness */
			case "value_input":
				return "value";
		}

		/* Other hover targets do not identify an HSV numeric editor */
		return "";
	}

	/// @description Build the numeric-field hover key for an HSV channel
	/// @param {String} slider_key HSV channel key or routed toolbar slider name
	/// @returns {String} Channel name with the input suffix
	hsv_input_hover_key = function(slider_key)
	{
		return slider_key + "_input";
	}

	/// @description Hit-test the three current HSV numeric input rectangles in GUI coordinates
	/// @param {Real} mx Horizontal GUI pointer position
	/// @param {Real} my Vertical GUI pointer position
	/// @returns {String} Channel key under the pointer or an empty string
	hsv_input_key_at = function(mx, my)
	{
		/* Visit the hue, saturation and value field rows in their fixed display order */
		for (var i = 0; i < 3; i++)
		{
			/* Map row zero to hue, row one to saturation, and the final row to value */
			var slider_key = i == 0 ? "hue" : (i == 1 ? "saturation" : "value");

			/* Locate this field's GUI top edge beside its corresponding slider */
			var field_y = hsv_slider_y + i * (hsv_slider_height + hsv_slider_gap) - 2;

			/* Return the channel only when the GUI pointer lies within its numeric input
			rectangle */
			if (point_in_rect(mx, my, hsv_input_x, field_y, hsv_input_x + hsv_input_width, field_y + hsv_input_height))
			{
				return slider_key;
			}
		}

		/* A pointer outside all three fields identifies no HSV editor */
		return "";
	}

	/// @description Open an HSV numeric editor using its current displayed channel value
	/// @param {String} slider_key HSV channel key or routed toolbar slider name
	/// @returns {Bool} True after setting editor and keyboard state
	begin_hsv_input = function(slider_key)
	{
		/* Open the chosen HSV editor with its current displayed value and share that text with
		keyboard input */
		hsv_input_active = slider_key;
		hsv_input_text = string(hsv_input_display_value(slider_key));
		keyboard_string = hsv_input_text;
		debug_note("hsv input started", slider_key);
		return true;
	}

	/// @description Close an active HSV numeric editor without applying its pending text
	/// @param {Bool} clear_keyboard Whether closing this numeric editor clears the shared keyboard string. Defaults to true
	/// @returns {Bool} Whether an editor was active and closed
	cancel_hsv_input = function(clear_keyboard = true)
	{
		/* No active channel means there is no HSV input to cancel */
		if (hsv_input_active == "")
		{
			return false;
		}

		debug_note("hsv input cancelled", hsv_input_active);
		hsv_input_active = "";
		hsv_input_text = "";

		/* Clear shared keyboard text only when requested, allowing a switch between numeric
		editors */
		if (clear_keyboard)
		{
			keyboard_string = "";
		}

		return true;
	}

	/// @description Apply nonempty active HSV input and close its editor
	/// @param {Bool} clear_keyboard Whether closing this numeric editor clears the shared keyboard string. Defaults to true
	/// @returns {Bool} Whether an editor was active and closed
	commit_hsv_input = function(clear_keyboard = true)
	{
		/* No active HSV channel means there is no pending edit to commit */
		if (hsv_input_active == "")
		{
			return false;
		}

		/* Nonempty numeric text updates the channel, while an empty entry closes without
		changing the brush */
		if (hsv_input_text != "")
		{
			set_hsv_input_display_value(hsv_input_active, real(hsv_input_text));
		}

		debug_note("hsv input committed", hsv_input_active + "=" + hsv_input_text);
		hsv_input_active = "";
		hsv_input_text = "";

		/* Clear shared keyboard text on request after committing or closing the field */
		if (clear_keyboard)
		{
			keyboard_string = "";
		}

		return true;
	}

	/// @description Update active HSV typing and handle keyboard closure or clicks between numeric fields
	/// @returns {Bool} Whether an active editor captured this input pass
	update_hsv_input = function()
	{
		/* This update consumes input only while an HSV numeric editor is active */
		if (hsv_input_active == "")
		{
			return false;
		}

		update_toolbar_layout();
		is_drawing = false;
		sent_drag_command = false;
		debug_last_toolbar_captured = true;
		toolbar_hover = hsv_input_hover_key(hsv_input_active);

		scr_text_input_update("drawing_hsv_" + hsv_input_active, hsv_input_text);
		hsv_input_text = hsv_input_clean(keyboard_string);
		keyboard_string = hsv_input_text;

		/* Escape closes the field without applying its pending numeric text */
		if (keyboard_check_pressed(vk_escape))
		{
			cancel_hsv_input();
			return true;
		}

		/* Enter commits the selected channel and closes its field */
		if (keyboard_check_pressed(vk_enter))
		{
			commit_hsv_input();
			return true;
		}

		/* A new left click decides whether to keep, switch or close the numeric editor */
		if (mouse_check_button_pressed(mb_left))
		{
			/* Read the pointer's horizontal GUI coordinate for numeric-field hit testing */
			var mx = device_mouse_x_to_gui(0);

			/* Read its vertical GUI coordinate in the same coordinate system */
			var my = device_mouse_y_to_gui(0);

			/* Find the HSV channel under this click, if any */
			var clicked_key = hsv_input_key_at(mx, my);

			/* Clicking an HSV numeric field keeps numeric-edit mode active */
			if (clicked_key != "")
			{
				/* Switching channels commits the previous value without clearing shared
				keyboard state before opening the new field */
				if (clicked_key != hsv_input_active)
				{
					commit_hsv_input(false);
					begin_hsv_input(clicked_key);
				}
			}

			/* A click outside the HSV numeric fields commits and closes the current entry */
			else
			{
				commit_hsv_input();
			}

			return true;
		}

		return true;
	}

	/// @description Resolve the selected tool's minimum world-pixel width including the wall minimum
	/// @returns {Real} Minimum permitted brush width
	tool_min_brush_width = function()
	{
		/* The Wall tool enforces at least four world pixels of width, while other tools use
		the ordinary minimum */
		return tool == DRAW_TOOL_WALL ? max(4, min_brush_width) : min_brush_width;
	}

	/// @description Resolve the selected tool's brush or eraser world-pixel width ceiling
	/// @returns {Real} Maximum permitted brush width
	tool_max_brush_width = function()
	{
		/* The Eraser has its own wider permitted ceiling, while other tools use the ordinary
		brush maximum */
		return tool == DRAW_TOOL_ERASER ? max_eraser_width : max_brush_width;
	}

	/// @description Round and clamp brush width to the current tool's permitted range
	/// @param {Real} raw_value User-entered displayed value or brush width before clamping
	/// @returns {Real} Accepted brush width in world pixels
	set_brush_width_value = function(raw_value)
	{
		brush_width = clamp(round(real(raw_value)), tool_min_brush_width(), tool_max_brush_width());
		return brush_width;
	}

	/// @description Retain decimal width digits up to the length needed for this tool's maximum
	/// @param {Any} raw_text Numeric editor input converted to text
	/// @returns {String} Cleaned numeric brush-width text
	brush_input_clean = function(raw_text)
	{
		/* Treat size entry as text before accepting decimal digits */
		var text = string(raw_text);

		/* Begin with no accepted brush-width digits */
		var clean = "";

		/* Limit entry length to the digit count needed for this tool's maximum width */
		var max_digits = max(1, string_length(string(tool_max_brush_width())));

		/* Scan one-based character positions until the source ends or the numeric field
		reaches its digit cap */
		for (var i = 1; i <= string_length(text); i++)
		{
			/* Inspect this character for a decimal brush-width digit */
			var ch = string_char_at(text, i);

			/* Skip characters that cannot belong to the positive integer width field */
			if (string_pos(ch, "0123456789") > 0)
			{
				clean += ch;

				/* Stop once enough digits have been retained to express the current tool's
				maximum width */
				if (string_length(clean) >= max_digits)
				{
					break;
				}
			}
		}

		return clean;
	}

	/// @description Translate a GUI slider position into a clipped integer tool width
	/// @param {Real} mx Horizontal GUI pointer position
	/// @returns {Real} Brush width in world pixels
	brush_slider_value_from_mouse = function(mx)
	{
		/* Read the current tool's minimum allowed world-pixel width */
		var tool_min_width = tool_min_brush_width();

		/* Read the current tool's maximum allowed world-pixel width */
		var tool_max_width = tool_max_brush_width();

		/* Keep a positive interpolation range even when both width bounds coincide */
		var value_range = max(1, tool_max_width - tool_min_width);

		/* Convert the GUI pointer's position along the slider into a clipped zero-to-one
		amount */
		var amount = clamp((mx - brush_slider_x) / max(1, brush_slider_width), 0, 1);
		return clamp(round(tool_min_width + amount * value_range), tool_min_width, tool_max_width);
	}

	/// @description Apply the brush width represented by the GUI pointer's slider position
	/// @param {Real} mx Horizontal GUI pointer position
	/// @returns {Bool} True after updating width
	update_brush_slider_from_mouse = function(mx)
	{
		set_brush_width_value(brush_slider_value_from_mouse(mx));
		return true;
	}

	/// @description Route dragging to brush width, canvas brightness or the selected HSV slider
	/// @param {String} slider_key HSV channel key or routed toolbar slider name
	/// @param {Real} mx Horizontal GUI pointer position
	/// @returns {Bool} Result of the selected slider update
	update_toolbar_slider_from_mouse = function(slider_key, mx)
	{
		/* Brush-width dragging uses its tool-specific width range */
		if (slider_key == "brush_width")
		{
			return update_brush_slider_from_mouse(mx);
		}

		/* Canvas brightness dragging changes local background brightness through its own
		control */
		if (slider_key == "canvas_bg_brightness")
		{
			return update_canvas_background_slider_from_mouse(mx);
		}

		return update_hsv_slider_from_mouse(slider_key, mx);
	}

	/// @description Hit-test the brush-width numeric field in GUI coordinates
	/// @param {Real} mx Horizontal GUI pointer position
	/// @param {Real} my Vertical GUI pointer position
	/// @returns {Bool} Whether the pointer lies within the field
	brush_input_at = function(mx, my)
	{
		/* Capture the pointer only inside the current brush-width numeric rectangle */
		return point_in_rect(mx, my, brush_input_x, brush_input_y, brush_input_x + brush_input_width, brush_input_y + brush_input_height);
	}

	/// @description Commit any HSV editor and open brush-width entry with the current width
	/// @returns {Bool} True after opening brush entry
	begin_brush_input = function()
	{
		/* Commit an open HSV numeric edit before sharing keyboard input with brush-width entry */
		if (hsv_input_active != "")
		{
			commit_hsv_input(false);
		}

		/* Open brush-width editing with the current width's text as the initial shared
		keyboard contents */
		brush_input_active = true;
		brush_input_text = string(brush_width);
		keyboard_string = brush_input_text;
		debug_note("brush input started", brush_input_text);
		return true;
	}

	/// @description Close active brush-width entry without applying its pending text
	/// @param {Bool} clear_keyboard Whether closing this numeric editor clears the shared keyboard string. Defaults to true
	/// @returns {Bool} Whether an editor was active and closed
	cancel_brush_input = function(clear_keyboard = true)
	{
		/* No brush-width editor means there is nothing to cancel */
		if (!brush_input_active)
		{
			return false;
		}

		debug_note("brush input cancelled", brush_input_text);
		brush_input_active = false;
		brush_input_text = "";

		/* Clear shared keyboard text only when requested, supporting transitions to another
		input control */
		if (clear_keyboard)
		{
			keyboard_string = "";
		}

		return true;
	}

	/// @description Apply nonempty width text through tool limits and close the editor
	/// @param {Bool} clear_keyboard Whether closing this numeric editor clears the shared keyboard string. Defaults to true
	/// @returns {Bool} Whether an editor was active and closed
	commit_brush_input = function(clear_keyboard = true)
	{
		/* No active brush-width editor means there is nothing to commit */
		if (!brush_input_active)
		{
			return false;
		}

		/* Apply nonempty width text through the tool's clamp rules, otherwise retain the
		previous width */
		if (brush_input_text != "")
		{
			set_brush_width_value(real(brush_input_text));
		}

		debug_note("brush input committed", string(brush_width));
		brush_input_active = false;
		brush_input_text = "";

		/* Clear shared keyboard contents when requested after closing the editor */
		if (clear_keyboard)
		{
			keyboard_string = "";
		}

		return true;
	}

	/// @description Update width typing and handle keyboard closure or transfer to slider dragging
	/// @returns {Bool} Whether an active editor captured this input pass
	update_brush_input = function()
	{
		/* Only an active brush-width editor consumes this update's input */
		if (!brush_input_active)
		{
			return false;
		}

		update_toolbar_layout();
		is_drawing = false;
		sent_drag_command = false;
		debug_last_toolbar_captured = true;
		toolbar_hover = "brush_input";

		scr_text_input_update("drawing_brush_width", brush_input_text);
		brush_input_text = brush_input_clean(keyboard_string);
		keyboard_string = brush_input_text;

		/* Escape discards the pending width entry */
		if (keyboard_check_pressed(vk_escape))
		{
			cancel_brush_input();
			return true;
		}

		/* Enter applies the pending width and closes the editor */
		if (keyboard_check_pressed(vk_enter))
		{
			commit_brush_input();
			return true;
		}

		/* A left click determines whether width editing continues or hands control to its
		slider */
		if (mouse_check_button_pressed(mb_left))
		{
			/* Read the click's horizontal GUI coordinate for field and slider hit testing */
			var mx = device_mouse_x_to_gui(0);

			/* Read its vertical GUI coordinate for the same tests */
			var my = device_mouse_y_to_gui(0);

			/* A click inside the active width field keeps editing without committing */
			if (brush_input_at(mx, my))
			{
				return true;
			}

			commit_brush_input(false);

			/* A click on the width slider commits the entry and begins direct slider dragging */
			if (point_in_rect(mx, my, brush_slider_x, brush_slider_y, brush_slider_x + brush_slider_width, brush_slider_y + brush_slider_height))
			{
				toolbar_active_slider = "brush_width";
				update_brush_slider_from_mouse(mx);
			}

			/* Other clicks close width editing and clear shared keyboard text */
			else
			{
				keyboard_string = "";
			}

			return true;
		}

		return true;
	}

	/// @description Convert a clipped integer nibble to its uppercase hexadecimal character
	/// @param {Real} value HSV brightness byte or numeric value to convert
	/// @returns {String} One hexadecimal digit
	hex_digit = function(value)
	{
		/* Keep the hexadecimal alphabet used to convert a clipped four-bit value to one
		uppercase character */
		var digits = "0123456789ABCDEF";
		return string_char_at(digits, clamp(floor(real(value)), 0, 15) + 1);
	}

	/// @description Convert a clipped integer byte to two uppercase hexadecimal characters
	/// @param {Real} value HSV brightness byte or numeric value to convert
	/// @returns {String} Two-digit hexadecimal byte
	byte_to_hex = function(value)
	{
		/* Clamp the numeric color channel into an integer byte before splitting its high and
		low hexadecimal digits */
		var channel_value = clamp(floor(real(value)), 0, 255);
		return hex_digit(floor(channel_value / 16)) + hex_digit(channel_value mod 16);
	}

	/// @description Describe the selected brush as transparent or with its RGB hexadecimal color
	/// @returns {String} Transparent or a #RRGGBB color label
	current_hex_text = function()
	{
		/* A zero-alpha brush is described as Transparent rather than showing meaningless RGB
		text */
		if (brush_alpha <= 0)
		{
			return "Transparent";
		}

		return "#" + byte_to_hex(brush_red) + byte_to_hex(brush_green) + byte_to_hex(brush_blue);
	}

	/// @description Sample the current visible canvas RGBA pixel into brush channels and HSV state
	/// @param {Real} world_x Horizontal world-pixel sampling position
	/// @param {Real} world_y Vertical world-pixel sampling position
	/// @returns {Bool} Whether the canvas was available for picking
	pick_color_at_world = function(world_x, world_y)
	{
		/* Color picking needs a live initialized canvas composite */
		if (!ensure_surface())
		{
			debug_note("picker failed", "surface unavailable");
			return false;
		}

		/* Refresh dirty layer pixels before sampling the visible composite */
		if (layer_composite_dirty)
		{
			composite_layers();
		}

		/* Read the packed RGBA pixel at the rounded world-space pointer position */
		var picked = surface_getpixel_ext(canvas_surface, round(world_x), round(world_y));

		/* Extract the alpha byte from the packed pixel's high eight bits before setting brush
		RGBA */
		var picked_alpha = (picked >> 24) & 255;
		set_brush_rgba(colour_get_red(picked), colour_get_green(picked), colour_get_blue(picked), picked_alpha);
		debug_note("color picked", string(brush_red) + "," + string(brush_green) + "," + string(brush_blue) + "," + string(brush_alpha));
		return true;
	}
	#endregion /* Brush Color and Size Controls END */

	#region /* Pixel Selection and Shared Clipboard */
	/// @description Floor and clamp a numeric channel to the unsigned byte range
	/// @param {Real} raw_value Numeric channel value before byte clamping
	/// @returns {Real} Integer channel from zero to 255
	selection_clamp_byte = function(raw_value)
	{
		return clamp(floor(real(raw_value)), 0, 255);
	}

	/// @description Pack clipped RGBA bytes with red in the low byte and alpha in the high byte
	/// @param {Real} raw_red Red channel value
	/// @param {Real} raw_green Green channel value
	/// @param {Real} raw_blue Blue channel value
	/// @param {Real} raw_alpha Opacity channel value
	/// @returns {Real} Packed 32-bit RGBA pixel
	selection_pack_rgba = function(raw_red, raw_green, raw_blue, raw_alpha)
	{
		return selection_clamp_byte(raw_red)
			+ selection_clamp_byte(raw_green) * 256
			+ selection_clamp_byte(raw_blue) * 65536
			+ selection_clamp_byte(raw_alpha) * 16777216;
	}

	/// @description Extract the low red byte from a packed RGBA pixel
	/// @param {Real} pixel_value Packed RGBA pixel with alpha in the high byte
	/// @returns {Real} Red byte
	selection_pixel_red = function(pixel_value)
	{
		return pixel_value & 255;
	}

	/// @description Extract the green byte from a packed RGBA pixel
	/// @param {Real} pixel_value Packed RGBA pixel with alpha in the high byte
	/// @returns {Real} Green byte
	selection_pixel_green = function(pixel_value)
	{
		return (pixel_value >> 8) & 255;
	}

	/// @description Extract the blue byte from a packed RGBA pixel
	/// @param {Real} pixel_value Packed RGBA pixel with alpha in the high byte
	/// @returns {Real} Blue byte
	selection_pixel_blue = function(pixel_value)
	{
		return (pixel_value >> 16) & 255;
	}

	/// @description Extract the high alpha byte from a packed RGBA pixel
	/// @param {Real} pixel_value Packed RGBA pixel with alpha in the high byte
	/// @returns {Real} Alpha byte
	selection_pixel_alpha = function(pixel_value)
	{
		return (pixel_value >> 24) & 255;
	}

	/// @description Convert a clipped integer nibble into one uppercase hexadecimal digit
	/// @param {Real} value Numeric nibble before clamping
	/// @returns {String} Hexadecimal character
	selection_hex_digit = function(value)
	{
		return string_char_at("0123456789ABCDEF", clamp(floor(real(value)), 0, 15) + 1);
	}

	/// @description Convert a clipped integer channel byte to two uppercase hexadecimal digits
	/// @param {Real} raw_value Numeric channel value before byte clamping
	/// @returns {String} Two-character hexadecimal byte
	selection_byte_to_hex = function(raw_value)
	{
		/* Clamp this channel into an integer byte before extracting its two hexadecimal digits */
		var byte_value = selection_clamp_byte(raw_value);
		return selection_hex_digit(floor(byte_value / 16)) + selection_hex_digit(byte_value mod 16);
	}

	/// @description Floor and clip a world x coordinate to a room-pixel column
	/// @param {Real} raw_x World x coordinate before cell clipping
	/// @returns {Real} Integer room column
	selection_cell_x = function(raw_x)
	{
		return clamp(floor(real(raw_x)), 0, max(0, room_width - 1));
	}

	/// @description Floor and clip a world y coordinate to a room-pixel row
	/// @param {Real} raw_y World y coordinate before cell clipping
	/// @returns {Real} Integer room row
	selection_cell_y = function(raw_y)
	{
		return clamp(floor(real(raw_y)), 0, max(0, room_height - 1));
	}

	/// @description Measure the active rectangle's inclusive pixel width
	/// @returns {Real} Positive width, or zero without an active selection
	selection_width = function()
	{
		/* An inactive selection has zero width rather than a drawable rectangle */
		if (!selection_active)
		{
			return 0;
		}

		return max(1, selection_right - selection_left + 1);
	}

	/// @description Measure the active rectangle's inclusive pixel height
	/// @returns {Real} Positive height, or zero without an active selection
	selection_height = function()
	{
		/* An inactive selection has zero height */
		if (!selection_active)
		{
			return 0;
		}

		return max(1, selection_bottom - selection_top + 1);
	}

	/// @description Clip a region's horizontal origin against its integer width and room bounds
	/// @param {Real} raw_left Requested world-pixel left origin
	/// @param {Real} region_w Region width in pixels
	/// @returns {Real} Integer left origin, zero when the region reaches or exceeds room width
	selection_clamp_region_left = function(raw_left, region_w)
	{
		/* Normalize the region's width to a positive integer before clipping its origin */
		var safe_w = max(1, floor(real(region_w)));

		/* A region as wide as the room or wider can only start at its left edge */
		if (safe_w >= room_width)
		{
			return 0;
		}

		return clamp(floor(real(raw_left)), 0, room_width - safe_w);
	}

	/// @description Clip a region's vertical origin against its integer height and room bounds
	/// @param {Real} raw_top Requested world-pixel top origin
	/// @param {Real} region_h Region height in pixels
	/// @returns {Real} Integer top origin, zero when the region reaches or exceeds room height
	selection_clamp_region_top = function(raw_top, region_h)
	{
		/* Normalize the region height before clipping its top origin */
		var safe_h = max(1, floor(real(region_h)));

		/* A region as tall as the room or taller can only start at its top edge */
		if (safe_h >= room_height)
		{
			return 0;
		}

		return clamp(floor(real(raw_top)), 0, room_height - safe_h);
	}

	/// @description Release the selection-owned preview surface and reset its handle
	/// @returns {Bool} True after clearing the preview resource
	selection_clear_preview_surface = function()
	{
		/* Free a preview surface only while its owned GPU resource still exists */
		if (surface_exists(selection_preview_surface))
		{
			surface_free(selection_preview_surface);
		}

		selection_preview_surface = noone;
		return true;
	}

	/// @description Discard selection and drag state and release the owned preview surface
	/// @returns {Bool} True after clearing selection state
	clear_selection = function()
	{
		/* Drop the active rectangle, drag mode, preview and copied move pixels, releasing the
		preview surface separately */
		selection_active = false;
		selection_drag_mode = "";
		selection_preview_active = false;
		selection_move_region = noone;
		selection_clear_preview_surface();
		return true;
	}

	/// @description Check whether a selection or move gesture is currently open
	/// @returns {Bool} Whether the drag mode is nonempty
	selection_drag_active = function()
	{
		/* A nonempty drag mode means selection input currently owns a select or move gesture */
		return selection_drag_mode != "";
	}

	/* Selection edges are inclusive room-pixel cells.
	Width and height add one */
	/// @description Set an active inclusive room-cell rectangle from either ordering of its two endpoints
	/// @param {Real} x_a First world x rectangle endpoint
	/// @param {Real} y_a First world y rectangle endpoint
	/// @param {Real} x_b Second world x rectangle endpoint
	/// @param {Real} y_b Second world y rectangle endpoint
	/// @returns {Bool} True after assigning clipped and sorted edges
	selection_set_rect = function(x_a, y_a, x_b, y_b)
	{
		/* Floor and clip the first horizontal endpoint to a valid room-pixel cell */
		var safe_x_a = selection_cell_x(x_a);

		/* Floor and clip the second horizontal endpoint before sorting rectangle edges */
		var safe_x_b = selection_cell_x(x_b);

		/* Floor and clip the first vertical endpoint to a valid room-pixel cell */
		var safe_y_a = selection_cell_y(y_a);

		/* Floor and clip the second vertical endpoint before sorting rectangle edges */
		var safe_y_b = selection_cell_y(y_b);
		selection_left = min(safe_x_a, safe_x_b);
		selection_right = max(safe_x_a, safe_x_b);
		selection_top = min(safe_y_a, safe_y_b);
		selection_bottom = max(safe_y_a, safe_y_b);
		selection_active = true;
		return true;
	}

	/// @description Clip active selection edges and discard a rectangle with crossed edges
	/// @returns {Bool} Whether an active valid selection remains
	selection_clamp_to_room = function()
	{
		/* Only an active selection has edges that need room clipping */
		if (!selection_active)
		{
			return false;
		}

		selection_left = clamp(selection_left, 0, max(0, room_width - 1));
		selection_right = clamp(selection_right, 0, max(0, room_width - 1));
		selection_top = clamp(selection_top, 0, max(0, room_height - 1));
		selection_bottom = clamp(selection_bottom, 0, max(0, room_height - 1));

		/* Crossed horizontal or vertical edges invalidate the rectangle and clear its
		resources */
		if (selection_right < selection_left || selection_bottom < selection_top)
		{
			clear_selection();
			return false;
		}

		return true;
	}

	/// @description Test a world position's clipped room cell against the active inclusive rectangle
	/// @param {Real} world_x World-pixel pointer x
	/// @param {Real} world_y World-pixel pointer y
	/// @returns {Bool} Whether the clipped cell belongs to the selection
	selection_contains = function(world_x, world_y)
	{
		/* Convert the tested world x coordinate to a bounded integer room cell */
		var cell_x = selection_cell_x(world_x);

		/* Convert the tested world y coordinate to the same cell convention */
		var cell_y = selection_cell_y(world_y);

		/* A point belongs to the selection only when it is active and the clipped cell lies
		inside both inclusive edge ranges */
		return selection_active
			&& cell_x >= selection_left
			&& cell_x <= selection_right
			&& cell_y >= selection_top
			&& cell_y <= selection_bottom;
	}

	/// @description Duplicate normalized region dimensions and row-major packed pixels, filling missing entries with transparent zero
	/// @param {Struct} source_region Borrowed width, height and row-major packed pixels to copy
	/// @returns {Struct} Independent width, height and pixels region, or noone for missing required fields
	copy_region_struct = function(source_region)
	{
		/* A copied region needs width, height and pixel fields before its storage can be
		duplicated */
		if (!is_struct(source_region)
		|| !variable_struct_exists(source_region, "width")
		|| !variable_struct_exists(source_region, "height")
		|| !variable_struct_exists(source_region, "pixels"))
		{
			return noone;
		}

		/* Normalize the copied column count to a positive integer */
		var safe_w = max(1, floor(real(source_region.width)));

		/* Normalize the copied row count to a positive integer */
		var safe_h = max(1, floor(real(source_region.height)));

		/* Borrow the source's flat pixel array while copying its packed RGBA values */
		var source_pixels = source_region.pixels;

		/* Allocate a separate row-major pixel array, initializing absent source pixels to
		transparent zero */
		var copied_pixels = array_create(safe_w * safe_h, 0);

		/* Copy only the entries that fit both the source array and the normalized destination
		dimensions */
		var copy_count = min(array_length(source_pixels), array_length(copied_pixels));

		/* Walk the available zero-based pixels without reading beyond either array */
		for (var pixel_index = 0; pixel_index < copy_count; pixel_index++)
		{
			copied_pixels[pixel_index] = source_pixels[pixel_index];
		}

		/* Return independent pixels with their positive width and height, leaving the original
		region storage untouched */
		return
		{
			width: safe_w,
			height: safe_h,
			pixels: copied_pixels
		};
	}

	/* Share copied RGBA pixels with the character and stamp editors through the common clipboard */
	/// @description Place an independent region copy into the common pixel-editor clipboard
	/// @param {Struct} region Borrowed region with width, height and row-major packed RGBA pixels
	/// @returns {Bool} Whether a copy was stored
	set_region_clipboard = function(region)
	{
		/* Make an independent region copy before sharing it with the other pixel editors */
		var region_copy = copy_region_struct(region);

		/* A failed region copy leaves the common clipboard unchanged */
		if (!is_struct(region_copy))
		{
			return false;
		}

		/* The global clipboard owns this independent width, height and packed-pixel array for
		cross-editor use */
		global.pixel_editor_region_clipboard = region_copy;
		return true;
	}

	/// @description Borrow the current shared pixel-editor clipboard region
	/// @returns {Struct} Existing global region, or noone when unavailable
	region_clipboard = function()
	{
		/* Return the existing clipboard only when its global field contains a region struct */
		if (variable_global_exists("pixel_editor_region_clipboard")
		&& is_struct(global.pixel_editor_region_clipboard))
		{
			return global.pixel_editor_region_clipboard;
		}

		/* No stored region is represented by noone instead of creating an empty clipboard */
		return noone;
	}

	/// @description Check that shared clipboard metadata describes a positive-sized region
	/// @returns {Bool} Whether the clipboard has required fields and positive dimensions
	region_clipboard_available = function()
	{
		/* Borrow the shared clipboard region to inspect its shape metadata */
		var clipboard_region = region_clipboard();

		/* Availability requires the region fields and positive dimensions, without claiming
		full pixel-array validation */
		return is_struct(clipboard_region)
			&& variable_struct_exists(clipboard_region, "width")
			&& variable_struct_exists(clipboard_region, "height")
			&& variable_struct_exists(clipboard_region, "pixels")
			&& clipboard_region.width > 0
			&& clipboard_region.height > 0;
	}

	/// @description Search region pixels for any nonzero alpha byte
	/// @param {Struct} region Borrowed region with width, height and row-major packed RGBA pixels
	/// @returns {Bool} Whether any visible pixel was found
	region_has_visible_pixels = function(region)
	{
		/* A missing region or pixel field cannot contain visible pixels */
		if (!is_struct(region)
		|| !variable_struct_exists(region, "pixels"))
		{
			return false;
		}

		/* Search each packed pixel until a nonzero alpha byte proves the region contains
		visible content */
		for (var pixel_index = 0; pixel_index < array_length(region.pixels); pixel_index++)
		{
			/* Any alpha above zero makes the region visible, including partially transparent
			pixels */
			if (selection_pixel_alpha(region.pixels[pixel_index]) > 0)
			{
				return true;
			}
		}

		/* A complete scan with no nonzero alpha means the region is entirely transparent */
		return false;
	}

	/// @description Read a clipped active-layer rectangle into an independent row-major packed RGBA array
	/// @param {Real} raw_left Requested world-pixel left origin
	/// @param {Real} raw_top Requested world-pixel top origin
	/// @param {Real} raw_w Requested region width in pixels
	/// @param {Real} raw_h Requested region height in pixels
	/// @returns {Struct} Copied width, height and pixels, or noone when required resources cannot be prepared
	copy_active_layer_region = function(raw_left, raw_top, raw_w, raw_h)
	{
		/* Copying pixels needs initialized canvas and layer surfaces */
		if (!ensure_surface())
		{
			return noone;
		}

		/* Borrow the selected layer's surface rather than sampling the visible multi-layer
		composite */
		var source_surface = active_layer_surface();

		/* An unavailable active layer surface cannot produce a copied region */
		if (!surface_exists(source_surface))
		{
			return noone;
		}

		/* Clip the requested left origin to a valid integer room column */
		var safe_left = clamp(floor(real(raw_left)), 0, max(0, room_width - 1));

		/* Clip the requested top origin to a valid integer room row */
		var safe_top = clamp(floor(real(raw_top)), 0, max(0, room_height - 1));

		/* Keep a positive width that cannot extend past the room from that clipped origin */
		var safe_w = max(1, min(floor(real(raw_w)), room_width - safe_left));

		/* Keep a positive height that cannot extend past the room from that clipped origin */
		var safe_h = max(1, min(floor(real(raw_h)), room_height - safe_top));

		/* Own a temporary surface sized to the clipped region so only selected pixels need
		readback */
		var sample_surface = surface_create(safe_w, safe_h);

		/* Stop when the temporary sample surface cannot be allocated */
		if (!surface_exists(sample_surface))
		{
			return noone;
		}

		surface_set_target(sample_surface);
		draw_clear_alpha(c_black, 0);
		surface_reset_target();
		surface_copy_part(sample_surface, 0, 0, source_surface, safe_left, safe_top, safe_w, safe_h);

		/* Own a tightly packed four-byte-per-pixel buffer for the sample surface's RGBA
		readback */
		var sample_buffer = buffer_create(safe_w * safe_h * 4, buffer_fixed, 1);

		/* A failed readback-buffer allocation releases the temporary surface before returning
		no region */
		if (!buffer_exists(sample_buffer))
		{
			surface_free(sample_surface);
			return noone;
		}

		buffer_get_surface(sample_buffer, sample_surface, 0);

		/* Allocate the returned row-major packed-pixel array, initially transparent */
		var region_pixels = array_create(safe_w * safe_h, 0);

		/* Visit each sample row in top-to-bottom order */
		for (var pixel_row = 0; pixel_row < safe_h; pixel_row++)
		{
			/* Visit every column in the current row to reconstruct the flat region pixel array */
			for (var pixel_col = 0; pixel_col < safe_w; pixel_col++)
			{
				/* Convert this row and column into the zero-based four-byte buffer offset */
				var pixel_offset = (pixel_row * safe_w + pixel_col) * 4;

				/* Read the source's packed pixel from the temporary surface buffer */
				var sampled_pixel = buffer_peek(sample_buffer, pixel_offset, buffer_u32);

				/* Extract its high alpha byte before repacking it with explicitly resolved RGB
				channels */
				var sampled_alpha = (sampled_pixel >> 24) & 255;
				region_pixels[pixel_row * safe_w + pixel_col] = selection_pack_rgba(
					colour_get_red(sampled_pixel),
					colour_get_green(sampled_pixel),
					colour_get_blue(sampled_pixel),
					sampled_alpha
				);
			}
		}

		buffer_delete(sample_buffer);
		surface_free(sample_surface);

		/* Transfer the sampled pixel array to the returned width/height region after releasing
		temporary buffer and surface resources */
		return
		{
			width: safe_w,
			height: safe_h,
			pixels: region_pixels
		};
	}

	/// @description Copy the active selection's pixels from the selected paint layer
	/// @returns {Struct} Independent selected region, or noone without selection or resources
	copy_selected_region = function()
	{
		/* An inactive selection has no layer rectangle to copy */
		if (!selection_active)
		{
			return noone;
		}

		return copy_active_layer_region(selection_left, selection_top, selection_width(), selection_height());
	}

	/// @description Copy the selected active-layer pixels into the common pixel-editor clipboard
	/// @returns {Bool} Whether selected pixels were copied to the clipboard
	copy_selection_to_clipboard = function()
	{
		return set_region_clipboard(copy_selected_region());
	}

	/// @description Serialize normalized row-major region pixels into eight uppercase RRGGBBAA digits per pixel
	/// @param {Struct} region Borrowed region with width, height and row-major packed RGBA pixels
	/// @returns {String} RGBA hexadecimal text, or empty for invalid region metadata
	selection_region_to_hex = function(region)
	{
		/* Duplicate and normalize the region before serializing its pixels into a portable
		RGBA text format */
		var region_copy = copy_region_struct(region);

		/* A missing region returns no hexadecimal payload */
		if (!is_struct(region_copy))
		{
			return "";
		}

		/* Begin with an empty serialized payload before appending one eight-character RGBA
		group per pixel */
		var hex_text = "";

		/* Serialize pixels in their row-major array order so the PNG encoder reconstructs the
		same rectangle */
		for (var pixel_index = 0; pixel_index < array_length(region_copy.pixels); pixel_index++)
		{
			/* Borrow the current packed RGBA value before extracting its channel bytes */
			var pixel_value = region_copy.pixels[pixel_index];
			hex_text += selection_byte_to_hex(selection_pixel_red(pixel_value))
				+ selection_byte_to_hex(selection_pixel_green(pixel_value))
				+ selection_byte_to_hex(selection_pixel_blue(pixel_value))
				+ selection_byte_to_hex(selection_pixel_alpha(pixel_value));
		}

		return hex_text;
	}

	/// @description Upload normalized packed pixels to a new surface and transfer that surface to the caller
	/// @param {Struct} region Borrowed region with width, height and row-major packed RGBA pixels
	/// @returns {Surface} Caller-owned surface, or noone after resource preparation failure
	selection_region_to_surface = function(region)
	{
		/* Copy the region before allocating a surface representation of its packed pixels */
		var region_copy = copy_region_struct(region);

		/* Invalid region metadata cannot produce a preview or export surface */
		if (!is_struct(region_copy))
		{
			return noone;
		}

		/* Own a GPU surface at the normalized region dimensions until returning it to the
		caller */
		var region_surface = surface_create(region_copy.width, region_copy.height);

		/* A failed surface allocation leaves no drawable region resource */
		if (!surface_exists(region_surface))
		{
			return noone;
		}

		/* Own a four-byte-per-pixel buffer to upload the region's packed RGBA array */
		var region_buffer = buffer_create(region_copy.width * region_copy.height * 4, buffer_fixed, 1);

		/* Release the allocated surface if its upload buffer cannot be created */
		if (!buffer_exists(region_buffer))
		{
			surface_free(region_surface);
			return noone;
		}

		/* Write every row-major packed pixel at its matching four-byte offset */
		for (var pixel_index = 0; pixel_index < array_length(region_copy.pixels); pixel_index++)
		{
			buffer_poke(region_buffer, pixel_index * 4, buffer_u32, region_copy.pixels[pixel_index]);
		}

		surface_set_target(region_surface);
		draw_clear_alpha(c_black, 0);
		surface_reset_target();
		buffer_set_surface(region_buffer, region_surface, 0);
		buffer_delete(region_buffer);

		/* Transfer the created surface to the caller after releasing its upload buffer */
		return region_surface;
	}

	/// @description Encode selection pixels through a temporary desktop surface and PNG file, releasing local resources
	/// @param {Struct} region Borrowed region with width, height and row-major packed RGBA pixels
	/// @returns {Struct} Standard PNG result with ok, Base64, byte size, dimensions and diagnostic text
	selection_region_to_png_base64_surface = function(region)
	{
		/* Start with a failed PNG result carrying empty encoded data and a default diagnostic */
		var result = RgbaPng.make_result("Could not encode selection PNG.");

		/* Make an independent normalized region before PNG preparation */
		var region_copy = copy_region_struct(region);

		/* A missing region produces the failed result with an explicit no-pixels message */
		if (!is_struct(region_copy))
		{
			result.message = "No selection pixels to encode.";
			return result;
		}

		/* Own a temporary surface populated with the selection pixels for desktop PNG saving */
		var region_surface = selection_region_to_surface(region_copy);

		/* A failed selection-surface allocation returns its diagnostic without attempting a
		file save */
		if (!surface_exists(region_surface))
		{
			result.message = "Could not create selection surface.";
			return result;
		}

		/* Give this temporary PNG a clock and random suffix in the runtime's temporary
		directory */
		var temp_path = screenshot_path_join(temp_directory, "JonnilOnline_Selection_" + string(current_time) + "_" + string(irandom(999999)) + ".png");

		/* Track the PNG file's loaded buffer, beginning without an allocated resource */
		var png_buffer = noone;
		try
		{
			surface_save(region_surface, temp_path);
			png_buffer = buffer_load(temp_path);

			/* A save that cannot be loaded into a buffer keeps the result failed */
			if (!buffer_exists(png_buffer))
			{
				result.message = "Could not read selection PNG.";
			}

			/* A live PNG buffer can be measured and encoded */
			else
			{
				/* Measure encoded PNG file bytes before accepting them for image transfer */
				var png_size = buffer_get_size(png_buffer);

				/* Empty or over-limit PNG bytes keep the result failed with a size diagnostic */
				if (png_size <= 0 || png_size > image_import_max_bytes)
				{
					result.message = "Selection PNG is too large.";
				}

				/* A permitted PNG becomes a successful result with encoded bytes and source
				pixel dimensions */
				else
				{
					/* Set ok=true, Base64 text, encoded byte_size, pixel width and height, and
					an empty error message */
					result.ok = true;
					result.base64 = buffer_base64_encode(png_buffer, 0, png_size);
					result.byte_size = png_size;
					result.width = region_copy.width;
					result.height = region_copy.height;
					result.message = "";
				}
			}
		}

		/* A save or read exception is retained in the result instead of escaping before
		resource cleanup */
		catch(e)
		{
			/* Extract the exception's message field when supplied, otherwise use its string
			representation */
			var encode_error = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			result.message = "Could not encode selection PNG: " + encode_error;
		}

		/* Release the locally owned PNG read buffer once encoding or failure handling is
		complete */
		if (buffer_exists(png_buffer))
		{
			buffer_delete(png_buffer);
		}

		/* Remove a temporary PNG only when the save actually left a file at its path */
		if (file_exists(temp_path))
		{
			/* File deletion is best effort so its exception cannot replace the PNG encoding
			outcome */
			try { file_delete(temp_path); } catch(delete_error) {}
		}

		/* Free the selection export surface if it remains live after encoding */
		if (surface_exists(region_surface))
		{
			surface_free(region_surface);
		}

		return result;
	}

	/// @description Prefer desktop surface encoding and fall back to portable row-major RGBA PNG encoding
	/// @param {Struct} region Borrowed region with width, height and row-major packed RGBA pixels
	/// @returns {Struct} Standard PNG encoding result
	selection_region_to_png_base64 = function(region)
	{
		/* Copy the input region so platform encoding uses normalized dimensions and an
		independent pixel array */
		var region_copy = copy_region_struct(region);

		/* A missing region immediately returns the standard failed PNG result */
		if (!is_struct(region_copy))
		{
			return RgbaPng.make_result("No selection pixels to encode.");
		}

		/* Desktop runners first try their native surface-to-file PNG encoder */
		if (!screenshot_uses_browser_storage())
		{
			/* Keep the desktop encoder's success or diagnostic before considering the portable
			fallback */
			var surface_result = selection_region_to_png_base64_surface(region_copy);

			/* Return a successful desktop result without building the larger hexadecimal
			intermediate */
			if (surface_result.ok)
			{
				return surface_result;
			}
		}

		/* Convert packed pixels to row-major RRGGBBAA text for browser or desktop-fallback PNG
		encoding */
		var hex_text = selection_region_to_hex(region_copy);
		return RgbaPng.rgba_hex_to_png_base64(region_copy.width, region_copy.height, hex_text);
	}

	/// @description Encode visible selection pixels into clipped PNG history with a supplied undo identity
	/// @param {Struct} region Borrowed region with width, height and row-major packed RGBA pixels
	/// @param {Real} raw_left Requested world-pixel left origin
	/// @param {Real} raw_top Requested world-pixel top origin
	/// @param {Real} undo_id Local undo group shared by this selection operation
	/// @returns {Struct} Paste image item, or noone after empty pixels, encoding failure or chunk overflow
	make_selection_paste_item = function(region, raw_left, raw_top, undo_id)
	{
		/* Normalize and duplicate paste pixels before choosing placement or encoding */
		var paste_region = copy_region_struct(region);

		/* A missing region or wholly transparent region produces no paste history item */
		if (!is_struct(paste_region)
		|| !region_has_visible_pixels(paste_region))
		{
			return noone;
		}

		/* Clip the paste's left origin so a fitting region stays within the room */
		var paste_left = selection_clamp_region_left(raw_left, paste_region.width);

		/* Clip its top origin by the region's height */
		var paste_top = selection_clamp_region_top(raw_top, paste_region.height);

		/* Keep the selection PNG encoder's Base64 data and failure details */
		var encode_result = selection_region_to_png_base64(paste_region);

		/* A failed PNG encoding reports its reason and stops history construction */
		if (!encode_result.ok)
		{
			set_screenshot_status(encode_result.message, make_color_rgb(244, 84, 84));
			debug_note("selection paste skipped", encode_result.message);
			return noone;
		}

		/* Build a fresh image history item with clipped placement, active layer, encoded
		pixels and the supplied undo group */
		var paste_item = make_image_history_item(
			make_client_image_id(),
			"Selection " + screenshot_timestamp(),
			paste_left,
			paste_top,
			paste_region.width,
			paste_region.height,
			encode_result.base64,
			active_layer_id,
			undo_id,
			local_undo_author_id,
			local_player_id,
			local_player_name
		);

		/* A PNG requiring too many image chunks cannot be submitted as a selection paste */
		if (image_history_chunk_count(paste_item) > image_import_max_chunks)
		{
			set_screenshot_status("Selection is too large to send.", make_color_rgb(244, 84, 84));
			debug_note("selection paste skipped", "chunks=" + string(image_history_chunk_count(paste_item)));
			return noone;
		}

		return paste_item;
	}

	/// @description Build a rectangular active-layer clear for a visible copied region
	/// @param {Struct} region Borrowed region with width, height and row-major packed RGBA pixels
	/// @param {Real} source_left Source clear rectangle left world pixel
	/// @param {Real} source_top Source clear rectangle top world pixel
	/// @param {Real} undo_id Local undo group shared by this selection operation
	/// @returns {Array} Zero or one clear command
	make_selection_clear_items_for_region = function(region, source_left, source_top, undo_id)
	{
		/* Copy the source region to validate its dimensions and visible contents before
		building a rectangular clear */
		var clear_region = copy_region_struct(region);

		/* Start with no clear commands, returning this empty array when no visible region
		needs clearing */
		var items = [];

		/* Missing or entirely transparent pixels need no destructive clear history */
		if (!is_struct(clear_region)
		|| !region_has_visible_pixels(clear_region))
		{
			return items;
		}

		/* Clip the clear rectangle's left origin against its source width */
		var clear_left = selection_clamp_region_left(source_left, clear_region.width);

		/* Clip its top origin against its source height */
		var clear_top = selection_clamp_region_top(source_top, clear_region.height);

		/* Compute its inclusive right room pixel */
		var clear_right = min(room_width - 1, clear_left + clear_region.width - 1);

		/* Compute its inclusive bottom room pixel */
		var clear_bottom = min(room_height - 1, clear_top + clear_region.height - 1);

		/* Build a Select-tool rectangular clear command for the active layer and shared
		operation undo group */
		var command = make_command(
			DRAW_TOOL_SELECT,
			0,
			0,
			0,
			1,
			clear_left,
			clear_top,
			clear_right,
			clear_bottom,
			0,
			0,
			"",
			active_layer_id,
			false,
			undo_id,
			local_undo_author_id
		);

		/* Append a clear item only when command construction accepted the rectangle */
		if (command != noone)
		{
			items[0] = command;
		}

		return items;
	}

	/// @description Apply structured selection items locally with rollback on rejection, then queue them in order
	/// @param {Array} items Ordered candidate selection clear and image history items
	/// @returns {Bool} Whether every retained local item was accepted
	commit_selection_history_items = function(items)
	{
		/* An absent or empty item array cannot commit a selection edit */
		if (!is_array(items) || array_length(items) <= 0)
		{
			return false;
		}

		/* Collect only structured history items into a separate operation list */
		var valid_items = [];

		/* Begin the accepted-item count at zero while filtering the requested edit */
		var valid_count = 0;

		/* Visit each requested item in order to preserve clear-before-paste sequencing */
		for (var item_index = 0; item_index < array_length(items); item_index++)
		{
			/* Borrow the next requested history item for the struct check */
			var item = items[item_index];

			/* Only structs are retained as candidate selection history */
			if (is_struct(item))
			{
				valid_items[valid_count] = item;
				valid_count++;
			}
		}

		/* No retained items means there is nothing to draw or upload */
		if (valid_count <= 0)
		{
			return false;
		}

		/* Remember the original history length so a rejected local edit can remove only its
		new entries */
		var history_start = array_length(client_history);

		/* Preserve the enclosing layer-rebuild flag before suppressing intermediate selection
		composites */
		var restore_rebuild_active = layer_surface_rebuild_active;
		layer_surface_rebuild_active = true;

		/* Assume all local applications succeed until an item rejects application */
		var applied_all = true;

		/* Apply retained items in order while recording each in local history */
		for (var apply_index = 0; apply_index < valid_count; apply_index++)
		{
			push_client_history_item(valid_items[apply_index]);

			/* Stop on the first failed application so its newly added operation can be rolled
			back */
			if (!apply_history_item_to_surface(valid_items[apply_index]))
			{
				applied_all = false;
				break;
			}
		}

		layer_surface_rebuild_active = restore_rebuild_active;

		/* A failed operation removes the newly recorded items and reconstructs the previous
		visible history */
		if (!applied_all)
		{
			/* Rollback continues until the history length reaches the pre-operation snapshot */
			while (array_length(client_history) > history_start)
			{
				/* Dispose and remove the newest appended item's owned patch before rolling
				back the next */
				var rollback_index = array_length(client_history) - 1;
				dispose_item_undo_patch(client_history[rollback_index]);
				array_delete(client_history, rollback_index, 1);
				client_history_revision++;
				client_history_replay_restart = true;
			}

			/* Rebuild the restored history immediately only when no outer layer rebuild owns
			that work */
			if (!restore_rebuild_active)
			{
				replay_client_history();
			}

			set_screenshot_status("Could not apply selection edit.", make_color_rgb(244, 84, 84));
			debug_note("selection edit failed", "rolled back");
			return false;
		}

		/* Composite the accepted edit immediately outside an enclosing rebuild */
		if (!restore_rebuild_active)
		{
			composite_layers();
		}

		clear_redo_stack();

		/* Queue accepted operation items in order after local success, keeping a move's clear
		and paste together */
		for (var send_index = 0; send_index < valid_count; send_index++)
		{
			pending_client_history_sends[array_length(pending_client_history_sends)] = valid_items[send_index];
		}

		debug_send_attempts += valid_count;
		debug_note("selection edit committed", "items=" + string(valid_count));
		return true;
	}

	/// @description Commit an undoable rectangular clear when the selected region has visible pixels
	/// @returns {Bool} Whether a clear operation committed
	clear_selected_pixels = function()
	{
		/* Clearing pixels requires an active selected rectangle */
		if (!selection_active)
		{
			return false;
		}

		/* Sample the selected active-layer pixels to decide whether a clear has visible work
		to remove */
		var clear_region = copy_selected_region();

		/* An empty or transparent sample creates no clear command */
		if (!region_has_visible_pixels(clear_region))
		{
			return false;
		}

		begin_local_undo_group();

		/* Use one fresh local undo group for this selected rectangle's clear */
		var undo_id = active_undo_group_id;

		/* Build the clear command list from the sampled source region and selection origin */
		var clear_items = make_selection_clear_items_for_region(clear_region, selection_left, selection_top, undo_id);

		/* Keep the local commit result before closing its undo group */
		var result = commit_selection_history_items(clear_items);
		end_local_undo_group();
		return result;
	}

	/// @description Copy selected pixels first and then commit their clear
	/// @returns {Bool} Whether both clipboard capture and local clear succeeded
	cut_selection_to_clipboard = function()
	{
		/* Cut must copy successfully before clearing so failed clipboard capture cannot lose
		selected pixels */
		if (!copy_selection_to_clipboard())
		{
			return false;
		}

		return clear_selected_pixels();
	}

	/// @description Select a clipped destination and commit visible region pixels as one undoable PNG paste
	/// @param {Struct} region Borrowed region with width, height and row-major packed RGBA pixels
	/// @param {Real} raw_left Requested world-pixel left origin
	/// @param {Real} raw_top Requested world-pixel top origin
	/// @returns {Bool} Whether local paste history committed
	paste_region_at = function(region, raw_left, raw_top)
	{
		/* Copy the supplied region before changing selection bounds or making paste history */
		var paste_region = copy_region_struct(region);

		/* A missing region cannot be pasted */
		if (!is_struct(paste_region))
		{
			return false;
		}

		/* Choose a room-clipped left origin for this copied region */
		var paste_left = selection_clamp_region_left(raw_left, paste_region.width);

		/* Choose the room-clipped top origin using the copied height */
		var paste_top = selection_clamp_region_top(raw_top, paste_region.height);
		selection_set_rect(paste_left, paste_top, min(room_width - 1, paste_left + paste_region.width - 1), min(room_height - 1, paste_top + paste_region.height - 1));

		/* An entirely transparent paste updates the selection rectangle but creates no drawing
		edit */
		if (!region_has_visible_pixels(paste_region))
		{
			return false;
		}

		begin_local_undo_group();

		/* Keep one undo group ID for this PNG paste */
		var undo_id = active_undo_group_id;

		/* Encode the copied region into a paste item at the chosen clipped origin */
		var paste_item = make_selection_paste_item(paste_region, paste_left, paste_top, undo_id);

		/* Begin with an unsuccessful paste until a real history item can be committed */
		var result = false;

		/* Commit only when encoding and image-size validation produced a paste item */
		if (paste_item != noone)
		{
			result = commit_selection_history_items([paste_item]);
		}
		end_local_undo_group();
		return result;
	}

	/// @description Paste the borrowed shared clipboard region at a requested room origin
	/// @param {Real} raw_left Requested world-pixel left origin
	/// @param {Real} raw_top Requested world-pixel top origin
	/// @returns {Bool} Whether local paste history committed
	paste_clipboard_at = function(raw_left, raw_top)
	{
		return paste_region_at(region_clipboard(), raw_left, raw_top);
	}

	/// @description Commit source clear and destination PNG paste in one undo group, then update the selection bounds
	/// @param {Real} raw_left Requested world-pixel left origin
	/// @param {Real} raw_top Requested world-pixel top origin
	/// @returns {Bool} Whether a pixel move committed
	move_selection_to = function(raw_left, raw_top)
	{
		/* A move needs an active selection to supply source edges */
		if (!selection_active)
		{
			return false;
		}

		/* Prefer the pixels captured when the move drag began so moving does not resample a
		changing layer */
		var move_region = copy_region_struct(selection_move_region);

		/* Without a valid drag snapshot, sample the current selected region as the move source */
		if (!is_struct(move_region))
		{
			move_region = copy_selected_region();
		}

		/* A move without valid source pixels cannot construct its clear and paste items */
		if (!is_struct(move_region))
		{
			return false;
		}

		/* Clip the move destination's left coordinate by the copied region width */
		var target_left = selection_clamp_region_left(raw_left, move_region.width);

		/* Clip the destination's top coordinate by its height */
		var target_top = selection_clamp_region_top(raw_top, move_region.height);

		/* A destination equal to the current selection origin ends the preview without a
		drawing edit */
		if (target_left == selection_left && target_top == selection_top)
		{
			selection_preview_active = false;
			return false;
		}

		/* An entirely transparent source moves only the selection rectangle and produces no
		clear or paste history */
		if (!region_has_visible_pixels(move_region))
		{
			selection_set_rect(target_left, target_top, min(room_width - 1, target_left + move_region.width - 1), min(room_height - 1, target_top + move_region.height - 1));
			selection_preview_active = false;
			return false;
		}

		begin_local_undo_group();

		/* Use the same new undo group for both source clearing and destination image placement */
		var undo_id = active_undo_group_id;

		/* Prepare source-clear items before constructing the destination image */
		var clear_items = make_selection_clear_items_for_region(move_region, selection_left, selection_top, undo_id);

		/* Encode the destination paste while retaining the move's common undo identity */
		var paste_item = make_selection_paste_item(move_region, target_left, target_top, undo_id);

		/* Collect the ordered clear-then-paste history operation */
		var items = [];

		/* Begin its append cursor at zero before copying the clear items */
		var item_count = 0;

		/* Append source clears in their existing order */
		for (var clear_index = 0; clear_index < array_length(clear_items); clear_index++)
		{
			items[item_count] = clear_items[clear_index];
			item_count++;
		}

		/* Append the PNG placement only when encoding produced a valid item */
		if (paste_item != noone)
		{
			items[item_count] = paste_item;
			item_count++;
		}

		/* Start with an unsuccessful move until the complete clear-and-paste operation is
		accepted */
		var result = false;

		/* A missing destination paste prevents clearing the source by itself */
		if (paste_item != noone)
		{
			result = commit_selection_history_items(items);
		}
		end_local_undo_group();

		/* Move the selected rectangle to its new bounds only after the complete local edit
		commits */
		if (result)
		{
			selection_set_rect(target_left, target_top, min(room_width - 1, target_left + move_region.width - 1), min(room_height - 1, target_top + move_region.height - 1));
		}

		selection_preview_active = false;
		return result;
	}

	/// @description Start a rectangle gesture or capture selection pixels and a surface for a move preview
	/// @param {Real} world_x World-pixel pointer x
	/// @param {Real} world_y World-pixel pointer y
	/// @returns {String} move when starting inside selection, otherwise select
	begin_selection_drag = function(world_x, world_y)
	{
		/* Convert the initial pointer x coordinate to a bounded room-pixel cell */
		var safe_x = selection_cell_x(world_x);

		/* Convert its y coordinate to the same cell grid */
		var safe_y = selection_cell_y(world_y);
		selection_drag_start_x = safe_x;
		selection_drag_start_y = safe_y;

		/* Starting inside the existing selection previews a move of its captured pixels */
		if (selection_contains(safe_x, safe_y))
		{
			selection_drag_mode = "move";

			/* Remember the source origin and initial preview origin, then copy its pixels and
			own a new preview surface */
			selection_move_origin_left = selection_left;
			selection_move_origin_top = selection_top;
			selection_preview_left = selection_left;
			selection_preview_top = selection_top;
			selection_preview_active = true;
			selection_move_region = copy_selected_region();
			selection_clear_preview_surface();
			selection_preview_surface = selection_region_to_surface(selection_move_region);
			return "move";
		}

		/* Starting outside the selection begins a new rectangle with this cell as its fixed
		anchor */
		selection_drag_mode = "select";
		selection_anchor_x = safe_x;
		selection_anchor_y = safe_y;
		selection_preview_active = false;
		selection_move_region = noone;
		selection_clear_preview_surface();
		selection_set_rect(safe_x, safe_y, safe_x, safe_y);
		return "select";
	}

	/// @description Adjust active rectangle edges or its move preview without committing pixel history
	/// @param {Real} world_x World-pixel pointer x
	/// @param {Real} world_y World-pixel pointer y
	/// @returns {Bool} False because this method never commits a pixel edit
	update_selection_drag = function(world_x, world_y)
	{
		/* Without a select or move gesture there is no selection drag to update */
		if (selection_drag_mode == "")
		{
			return false;
		}

		/* Clip the current pointer x to a room cell before measuring its drag displacement */
		var safe_x = selection_cell_x(world_x);

		/* Clip its y coordinate before updating the rectangle or preview */
		var safe_y = selection_cell_y(world_y);

		/* A move drag changes only the clipped preview origin until mouse release commits its
		pixels */
		if (selection_drag_mode == "move")
		{
			selection_preview_left = selection_clamp_region_left(selection_move_origin_left + safe_x - selection_drag_start_x, selection_width());
			selection_preview_top = selection_clamp_region_top(selection_move_origin_top + safe_y - selection_drag_start_y, selection_height());
			selection_preview_active = true;

			/* A preview update reports no committed drawing change */
			return false;
		}

		selection_set_rect(selection_anchor_x, selection_anchor_y, safe_x, safe_y);

		/* A newly extended rectangle also reports no committed pixel edit */
		return false;
	}

	/// @description Commit a move when applicable and release the gesture's copied pixels and preview surface
	/// @returns {Bool} Whether finishing committed a pixel move
	finish_selection_drag = function()
	{
		/* A missing drag mode leaves nothing to finish */
		if (selection_drag_mode == "")
		{
			return false;
		}

		/* Begin with no committed pixel change, distinguishing a new selection from a
		completed move edit */
		var changed = false;

		/* Only a move gesture commits clear-and-paste history when the drag finishes */
		if (selection_drag_mode == "move")
		{
			changed = move_selection_to(selection_preview_left, selection_preview_top);
		}

		selection_drag_mode = "";
		selection_preview_active = false;
		selection_move_region = noone;
		selection_clear_preview_surface();

		/* Report whether finishing the gesture committed a pixel move */
		return changed;
	}

	/// @description Discard gesture state and preview resources without moving pixels
	/// @returns {Bool} True after clearing the gesture
	cancel_selection_drag = function()
	{
		/* Cancel the gesture and discard its copied pixels and owned preview surface without
		committing a move */
		selection_drag_mode = "";
		selection_preview_active = false;
		selection_move_region = noone;
		selection_clear_preview_surface();
		return true;
	}

	/// @description Choose a paste origin from selection, pointer, camera or room zero and clip it for a supplied region
	/// @param {Camera} camera_id Optional valid camera used when selection and pointer are absent
	/// @param {Struct} mouse_world World pointer x and y, or noone when outside the drawing view
	/// @param {Struct} region Borrowed region with width, height and row-major packed RGBA pixels
	/// @returns {Struct} x and y world-pixel origin fields
	selection_paste_target = function(camera_id, mouse_world, region)
	{
		/* Default the paste's horizontal origin to the room's left edge */
		var target_x = 0;

		/* Default its vertical origin to the room's top edge */
		var target_y = 0;

		/* An existing selected rectangle supplies the preferred paste origin */
		if (selection_active)
		{
			target_x = selection_left;
			target_y = selection_top;
		}

		/* Otherwise use a provided world pointer's clipped cell */
		else if (mouse_world != noone)
		{
			target_x = selection_cell_x(mouse_world.x);
			target_y = selection_cell_y(mouse_world.y);
		}

		/* Without a selection or pointer, a valid camera provides its visible top-left room
		cell */
		else if (is_real(camera_id) && camera_id >= 0)
		{
			target_x = selection_cell_x(camera_get_view_x(camera_id));
			target_y = selection_cell_y(camera_get_view_y(camera_id));
		}

		/* A supplied region further clips this chosen origin according to its width and height */
		if (is_struct(region))
		{
			target_x = selection_clamp_region_left(target_x, region.width);
			target_y = selection_clamp_region_top(target_y, region.height);
		}

		/* Return x and y as the final world-pixel paste origin */
		return
		{
			x: target_x,
			y: target_y
		};
	}
	#endregion /* Pixel Selection and Shared Clipboard END */

	#region /* Tool Cursor and World Coordinates */
	/// @description Select an integer tool ID, enforce Wall availability, clear obsolete selection and clamp tool width
	/// @param {Real} new_tool Requested drawing tool ID converted to an integer
	/// @returns {Bool} Whether the tool change was accepted
	set_draw_tool = function(new_tool)
	{
		/* Convert the requested tool ID to an integer before selecting its behavior */
		var clean_tool = floor(real(new_tool));

		/* Selecting Wall requires the server's shared-wall subsystem to permit drawing */
		if (clean_tool == DRAW_TOOL_WALL && !scr_get_walls().can_draw())
		{
			set_screenshot_status("Wall drawing is turned off or unavailable on this server.", make_color_rgb(255, 220, 95));
			return false;
		}

		/* Entering Stamp from another tool remembers that tool for later restoration */
		if (tool != clean_tool && clean_tool == DRAW_TOOL_STAMP)
		{
			tool_before_stamp = tool;
		}

		/* Switching away from a different tool to a non-selection tool discards the old
		selection and its preview resources */
		if (tool != clean_tool && clean_tool != DRAW_TOOL_SELECT)
		{
			clear_selection();
		}

		tool = clean_tool;
		set_brush_width_value(brush_width);
		return true;
	}

	/// @description Restore the remembered pre-stamp tool, falling back to Pen for a remembered Stamp
	/// @returns {Bool} Whether tool selection succeeded
	restore_tool_before_stamp = function()
	{
		/* Use the tool remembered before Stamp was selected */
		var restore_tool = tool_before_stamp;

		/* A remembered Stamp would not leave stamp mode, so fall back to Pen */
		if (restore_tool == DRAW_TOOL_STAMP)
		{
			restore_tool = DRAW_TOOL_PEN;
		}

		return set_draw_tool(restore_tool);
	}

	/// @description Classify tools that submit repeated segments during a held drag
	/// @param {Real} tool_id Drawing tool enum value
	/// @returns {Bool} Whether the tool is Pen, Eraser or Wall
	tool_is_stream_tool = function(tool_id)
	{
		/* Pen, Eraser and Wall send repeated segments throughout a drag */
		return tool_id == DRAW_TOOL_PEN || tool_id == DRAW_TOOL_ERASER || tool_id == DRAW_TOOL_WALL;
	}

	/// @description Classify tools that submit one completed drag shape
	/// @param {Real} tool_id Drawing tool enum value
	/// @returns {Bool} Whether the tool is Line, Rectangle or Circle
	tool_is_shape_tool = function(tool_id)
	{
		/* Line, Rectangle and Circle preview a drag and submit the completed shape */
		return tool_id == DRAW_TOOL_LINE
			|| tool_id == DRAW_TOOL_RECTANGLE
			|| tool_id == DRAW_TOOL_CIRCLE;
	}

	/// @description Resolve the world cursor icon with a stamp-preview exception and pen fallback
	/// @param {Real} tool_id Drawing tool enum value
	/// @returns {Sprite} Existing cursor asset, or noone for Stamp
	tool_cursor_sprite = function(tool_id)
	{
		/* Choose the cursor asset representing the selected tool's interaction */
		switch (tool_id)
		{
			/* Eraser displays its erase icon near the pointer */
			case DRAW_TOOL_ERASER:
				return spr_icon_erase;

			/* Line displays its line icon */
			case DRAW_TOOL_LINE:
				return spr_icon_line;

			/* Rectangle displays its rectangle icon */
			case DRAW_TOOL_RECTANGLE:
				return spr_icon_rect;

			/* Circle displays its circle icon */
			case DRAW_TOOL_CIRCLE:
				return spr_icon_circle;

			/* Fill displays its fill icon */
			case DRAW_TOOL_FILL:
				return spr_icon_fill;

			/* Text displays its text icon */
			case DRAW_TOOL_TEXT:
				return spr_icon_text;

			/* Color Picker displays its sampling icon */
			case DRAW_TOOL_COLOR_PICKER:
				return spr_icon_pick;

			/* Stamp draws its own image preview and needs no generic tool cursor sprite */
			case DRAW_TOOL_STAMP:
				return noone;

			/* Select uses a dedicated world cursor instead of its toolbar button icon */
			case DRAW_TOOL_SELECT:
				return spr_cursor_select;

			/* Other tools, including Pen and Wall, use the pen cursor asset */
			default:
				return spr_icon_pen;
		}
	}

	/// @description Resolve the toolbar icon using a separate button asset for Select
	/// @param {Real} tool_id Drawing tool enum value
	/// @returns {Sprite} Existing tool icon, or noone when the cursor lookup has none
	tool_button_icon_sprite = function(tool_id)
	{
		/* The Select toolbar button uses its button icon while world drawing uses its
		dedicated cursor */
		if (tool_id == DRAW_TOOL_SELECT)
		{
			return spr_icon_select;
		}

		return tool_cursor_sprite(tool_id);
	}

	/// @description Switch the operating-system cursor only when custom cursor ownership changes
	/// @param {Bool} active Whether the custom drawing cursor should own pointer display
	set_tool_cursor_active = function(active)
	{
		/* An unchanged cursor-active state needs no repeated operating-system cursor update */
		if (tool_cursor_active == active)
		{
			return;
		}

		/* Hide the system cursor while the custom tool cursor owns drawing, otherwise restore
		the default cursor */
		window_set_cursor(active ? cr_none : cr_default);
		tool_cursor_active = active;
	}

	/// @description Check whether open chat should retain ordinary interface cursor behavior
	/// @returns {Bool} Whether a valid chat panel is open
	tool_cursor_blocked_by_chat = function()
	{
		/* Borrow chat state before checking whether the open chat panel reserves pointer
		interaction */
		var chat = scr_get_chat();

		/* Chat blocks the drawing cursor only when a valid chat struct exposes an enabled
		is_open flag */
		return is_struct(chat)
			&& variable_struct_exists(chat, "is_open")
			&& chat.is_open;
	}

	/// @description Combine client, editor, GUI bounds, zoom panel, selection and toolbar cursor restrictions
	/// @returns {Bool} Whether the custom drawing cursor can be displayed
	tool_cursor_should_draw = function()
	{
		/* A missing client session, disabled drawing, text or HSV entry, character editor, or
		open chat prevents drawing the world tool cursor */
		if (!is_active_client_session()
		|| !draw_mode_enabled
		|| text_entry_active
		|| hsv_input_active != ""
		|| scr_get_character_maker().blocks_game_input()
		|| tool_cursor_blocked_by_chat())
		{
			return false;
		}

		/* Use a positive GUI width to bound pointer hit testing */
		var gui_width = max(1, display_get_gui_width());

		/* Use a positive GUI height for the vertical GUI bounds */
		var gui_height = max(1, display_get_gui_height());

		/* Read the pointer's GUI x coordinate before deciding whether it is over the drawing
		view */
		var mx = device_mouse_x_to_gui(0);

		/* Read its GUI y coordinate in the same space */
		var my = device_mouse_y_to_gui(0);

		/* A pointer outside the GUI cannot display a drawing cursor inside this interface */
		if (mx < 0 || mx > gui_width || my < 0 || my > gui_height)
		{
			return false;
		}

		/* Find the network controller that owns the camera zoom panel */
		var network_control = instance_find(obj_network_control, 0);

		/* An available zoom editor or a pointer inside its fully described panel keeps the
		default interface cursor */
		if (network_control != noone
		&& variable_instance_exists(network_control, "network_camera_zoom_input_active")
		&& variable_instance_exists(network_control, "network_camera_zoom_panel_x")
		&& variable_instance_exists(network_control, "network_camera_zoom_panel_y")
		&& variable_instance_exists(network_control, "network_camera_zoom_panel_width")
		&& variable_instance_exists(network_control, "network_camera_zoom_panel_height")
		&& (network_control.network_camera_zoom_input_active
			|| point_in_rect(
				mx,
				my,
				network_control.network_camera_zoom_panel_x,
				network_control.network_camera_zoom_panel_y,
				network_control.network_camera_zoom_panel_x + network_control.network_camera_zoom_panel_width,
				network_control.network_camera_zoom_panel_y + network_control.network_camera_zoom_panel_height
			)))
		{
			return false;
		}

		/* Selection needs a valid room-pixel pointer before displaying its specialized world
		cursor */
		if (tool == DRAW_TOOL_SELECT && !debug_mouse_world_valid)
		{
			return false;
		}

		/* Draw the tool cursor only when the toolbar did not capture this pointer interaction */
		return !debug_last_toolbar_captured;
	}

	/// @description Validate the runner's world mouse position against GUI, camera and room bounds and update pointer diagnostics
	/// @param {Camera} camera_id Camera whose world view validates the current mouse position
	/// @returns {Struct} Unrounded world x and y coordinates, or noone with a recorded rejection reason
	mouse_to_world = function(camera_id)
	{
		debug_last_camera_id = camera_id;
		debug_mouse_world_valid = false;

		/* A numeric nonnegative camera handle is required to validate the world pointer */
		if (!is_real(camera_id)
		|| camera_id < 0)
		{
			debug_mouse_reason = "invalid camera " + string(camera_id);
			return noone;
		}

		/* Use a positive GUI width when checking whether the pointer lies inside the
		application view */
		var gui_width = max(1, display_get_gui_width());

		/* Use the GUI height with the same positive bound */
		var gui_height = max(1, display_get_gui_height());

		/* Read the pointer's horizontal GUI coordinate for application-view checks */
		var mouse_gui_x = device_mouse_x_to_gui(0);

		/* Read its vertical GUI coordinate for the same checks */
		var mouse_gui_y = device_mouse_y_to_gui(0);
		debug_last_mouse_gui_x = mouse_gui_x;
		debug_last_mouse_gui_y = mouse_gui_y;

		/* Reject a GUI pointer outside the application before trusting its reported world
		coordinates */
		if (mouse_gui_x < 0
		|| mouse_gui_x > gui_width
		|| mouse_gui_y < 0
		|| mouse_gui_y > gui_height)
		{
			debug_mouse_reason = "mouse outside GUI";
			return noone;
		}

		/* Read the camera's world-space left view edge */
		var view_x = camera_get_view_x(camera_id);

		/* Read the camera's world-space top view edge */
		var view_y = camera_get_view_y(camera_id);

		/* Read its world-pixel view width to bound the raw pointer */
		var view_w = camera_get_view_width(camera_id);

		/* Read its world-pixel view height for vertical bounds */
		var view_h = camera_get_view_height(camera_id);

		/* A camera with no positive view area cannot contain a valid drawing pointer */
		if (view_w <= 0 || view_h <= 0)
		{
			debug_mouse_reason = "bad camera view " + string(view_w) + "x" + string(view_h);
			return noone;
		}

		/* Use the runner's world x mouse position rather than manually projecting its GUI
		coordinate */
		var raw_world_x = device_mouse_x(0);

		/* Use the runner's world y mouse position in the same room space */
		var raw_world_y = device_mouse_y(0);
		debug_raw_world_x = raw_world_x;
		debug_raw_world_y = raw_world_y;

		/* Reject raw world coordinates outside this camera view, allowing a one-pixel margin
		at its edges */
		if (raw_world_x < view_x - 1
		|| raw_world_x > view_x + view_w + 1
		|| raw_world_y < view_y - 1
		|| raw_world_y > view_y + view_h + 1)
		{
			debug_mouse_reason = "mouse outside camera raw " + string(round(raw_world_x)) + "," + string(round(raw_world_y));
			return noone;
		}

		/* A point outside the room's drawable pixel bounds cannot begin world drawing */
		if (raw_world_x < 0
		|| raw_world_x > room_width - 1
		|| raw_world_y < 0
		|| raw_world_y > room_height - 1)
		{
			debug_mouse_reason = "mouse outside room raw " + string(round(raw_world_x)) + "," + string(round(raw_world_y));
			return noone;
		}

		/* Return x and y as the accepted unrounded world coordinates while diagnostics
		separately mark the pointer valid */
		var world =
		{
			x: raw_world_x,
			y: raw_world_y
		};

		debug_mouse_world_valid = true;
		debug_mouse_world_x = world.x;
		debug_mouse_world_y = world.y;
		debug_mouse_reason = "ok";
		return world;
	}
	#endregion /* Tool Cursor and World Coordinates END */

	#region /* Screenshot Export and Automatic Archives */
	/// @description Select browser-style export for browser and GXGames runners
	/// @returns {Bool} Whether screenshot output uses browser storage
	screenshot_uses_browser_storage = function()
	{
		/* Browser and GXGames runners use the browser export path instead of a desktop
		screenshot directory */
		return os_browser != browser_not_a_browser || os_type == os_gxgames;
	}

	/// @description Check support for categorized desktop output beneath a nonempty save root
	/// @returns {Bool} Whether desktop screenshot folders are usable
	screenshot_can_use_folder = function()
	{
		/* Categorized filesystem output requires a desktop runner, a save root and no
		browser-storage path */
		return !screenshot_uses_browser_storage()
			&& string(game_save_id) != ""
			&& (os_type == os_windows || os_type == os_macosx || os_type == os_linux);
	}

	/// @description Check desktop folder-opening capability and save-root availability
	/// @returns {Bool} Whether folder integration can be requested
	screenshot_folder_can_open = function()
	{
		/* Folder opening requires enabled desktop integration and a nonempty save root */
		return scr_desktop_folder_opening_is_enabled()
			&& string(game_save_id) != "";
	}

	/// @description Choose the current runner's path separator
	/// @returns {String} Backslash on Windows, otherwise forward slash
	screenshot_platform_separator = function()
	{
		/* Windows paths use backslashes, while other targets use forward slashes */
		return os_type == os_windows ? "\\" : "/";
	}

	/// @description Join textual path components while avoiding a duplicate separator at the base's end
	/// @param {Any} base_path Base path converted to text
	/// @param {Any} child_path Child path component converted to text
	/// @returns {String} Joined path without filesystem checks
	screenshot_path_join = function(base_path, child_path)
	{
		/* Convert the base path to text before inspecting its trailing separator */
		var base_text = string(base_path);

		/* Convert the child component to text before joining it */
		var child_text = string(child_path);

		/* An empty base needs no separator and returns the child alone */
		if (base_text == "")
		{
			return child_text;
		}

		/* An empty child leaves the base unchanged */
		if (child_text == "")
		{
			return base_text;
		}

		/* Read the final base character to avoid adding a duplicate separator */
		var last_char = string_char_at(base_text, string_length(base_text));

		/* Either recognized trailing slash already separates the base from its child */
		if (last_char == "/" || last_char == "\\")
		{
			return base_text + child_text;
		}

		return base_text + screenshot_platform_separator() + child_text;
	}

	/// @description Replace path separators with the current runner's preferred slash style
	/// @param {Any} raw_path Path converted to text before separator normalization
	/// @returns {String} Normalized path text
	screenshot_normalize_path = function(raw_path)
	{
		/* Convert the path to text before replacing separators for the current runner */
		var path_text = string(raw_path);

		/* Windows normalizes slash characters to its native backslash spelling */
		if (os_type == os_windows)
		{
			return string_replace_all(path_text, "/", "\\");
		}

		return string_replace_all(path_text, "\\", "/");
	}

	/// @description Format a nonnegative integer with a requested minimum count of decimal digits
	/// @param {Any} value Number to pad or metadata value to stringify
	/// @param {Real} digits Minimum decimal digit count
	/// @returns {String} Zero-padded number, retaining wider values
	screenshot_pad_number = function(value, digits)
	{
		/* Start with a nonnegative integer's text before zero padding */
		var text = string(floor(max(0, real(value))));

		/* Prepend zeros only until the requested minimum digit width is reached */
		while (string_length(text) < digits)
		{
			text = "0" + text;
		}

		return text;
	}

	/// @description Format one local date-time snapshot for archive filenames
	/// @returns {String} YYYY-MM-DD_HH-MM-SS timestamp
	screenshot_timestamp = function()
	{
		/* Snapshot the current local date and time once so all filename components refer to
		the same second */
		var now = date_current_datetime();
		return screenshot_pad_number(date_get_year(now), 4)
			+ "-" + screenshot_pad_number(date_get_month(now), 2)
			+ "-" + screenshot_pad_number(date_get_day(now), 2)
			+ "_" + screenshot_pad_number(date_get_hour(now), 2)
			+ "-" + screenshot_pad_number(date_get_minute(now), 2)
			+ "-" + screenshot_pad_number(date_get_second(now), 2);
	}

	/// @description Describe the runner OS with known names or a numeric fallback
	/// @returns {String} OS filename and metadata label
	screenshot_os_type_name = function()
	{
		/* Map known runner OS constants to readable filename and metadata labels */
		switch (os_type)
		{
			/* Use Windows for the Windows desktop runner */
			case os_windows:
				return "Windows";

			/* Use MacOS for the macOS desktop runner */
			case os_macosx:
				return "MacOS";

			/* Use Linux for the Linux desktop runner */
			case os_linux:
				return "Linux";

			/* Use GXGames for its distinct export runtime */
			case os_gxgames:
				return "GXGames";
		}

		/* Other OS values retain their numeric identity in the label */
		return "OS" + string(os_type);
	}

	/// @description Describe the browser with known names or a numeric fallback
	/// @returns {String} Browser metadata label
	screenshot_browser_name = function()
	{
		/* Map known browser constants to readable metadata labels */
		switch (os_browser)
		{
			/* A native runner has no browser and is labeled None */
			case browser_not_a_browser:
				return "None";

			/* Identify Firefox explicitly */
			case browser_firefox:
				return "Firefox";

			/* Identify the Internet Explorer browser constant explicitly */
			case browser_ie:
				return "InternetExplorer";
		}

		/* Other browser values retain their numeric identity in the label */
		return "Browser" + string(os_browser);
	}

	/// @description Classify GXGames, HTML5, PC desktop and other native export runtimes
	/// @returns {String} Runtime family label
	screenshot_runtime_family_name = function()
	{
		/* GXGames gets its own runtime family before the general browser classification */
		if (os_type == os_gxgames)
		{
			return "GXGames";
		}

		/* Other browser runners are labeled HTML5 */
		if (os_browser != browser_not_a_browser)
		{
			return "HTML5";
		}

		/* Windows, macOS and Linux native runners share the PC family */
		if (os_type == os_windows
		|| os_type == os_macosx
		|| os_type == os_linux)
		{
			return "PC";
		}

		/* Other nonbrowser runners use the Native family label */
		return "Native";
	}

	/// @description Build a sanitized runtime and OS tag with browser identity when applicable
	/// @returns {String} Runtime filename fragment
	screenshot_runtime_filename_fragment = function()
	{
		/* Build a filename tag containing the runtime family and readable OS name */
		var runtime_text = "Runtime-" + screenshot_runtime_family_name()
			+ "_OS-" + screenshot_os_type_name();

		/* Append browser identity only on a runner that actually reports a browser */
		if (os_browser != browser_not_a_browser)
		{
			runtime_text += "_Browser-" + screenshot_browser_name();
		}

		return screenshot_safe_name_fragment(runtime_text);
	}

	/// @description Clean a label and replace reserved filename punctuation and spaces with underscores
	/// @param {Any} raw_text Label cleaned for a filename component
	/// @returns {String} Filename component with Layer as the cleaned-name fallback
	screenshot_safe_name_fragment = function(raw_text)
	{
		/* Clean the source label with a Layer fallback before replacing filename punctuation
		and spaces */
		var text = layer_name_clean(raw_text, "Layer");
		text = string_replace_all(text, "\\", "_");
		text = string_replace_all(text, "/", "_");
		text = string_replace_all(text, ":", "_");
		text = string_replace_all(text, "*", "_");
		text = string_replace_all(text, "?", "_");
		text = string_replace_all(text, chr(34), "_");
		text = string_replace_all(text, "<", "_");
		text = string_replace_all(text, ">", "_");
		text = string_replace_all(text, "|", "_");
		text = string_replace_all(text, " ", "_");
		return text;
	}

	/// @description Resolve a screenshot owner from assigned client name, requested name or chat identity
	/// @returns {String} Owner name or Unknown_Player
	screenshot_owner_name = function()
	{
		/* Borrow the client to prefer its authoritative or requested username for file
		ownership */
		var client = scr_get_client();

		/* Only an available client struct can supply these username fields */
		if (is_struct(client))
		{
			/* Prefer a nonblank server-assigned username for screenshot ownership */
			if (variable_struct_exists(client, "assigned_username")
			&& string_trim(string(client.assigned_username)) != "")
			{
				return string(client.assigned_username);
			}

			/* Use a nonblank requested username while an authoritative name is unavailable */
			if (variable_struct_exists(client, "requested_username")
			&& string_trim(string(client.requested_username)) != "")
			{
				return string(client.requested_username);
			}
		}

		/* Borrow chat identity as a fallback when client username fields are not available */
		var chat = scr_get_chat();

		/* A nonblank assigned chat name supplies the fallback owner label */
		if (is_struct(chat)
		&& variable_struct_exists(chat, "assigned_username")
		&& string_trim(string(chat.assigned_username)) != "")
		{
			return string(chat.assigned_username);
		}

		/* Use an explicit Unknown_Player label when neither subsystem provides an owner name */
		return "Unknown_Player";
	}

	/// @description Combine the project prefix, sanitized player name and available network ID
	/// @returns {String} Client archive filename prefix
	screenshot_file_owner_prefix = function()
	{
		/* Borrow the client to prefer its assigned network identity in the filename prefix */
		var client = scr_get_client();

		/* Begin with an IDpending marker for screenshots taken before player assignment */
		var id_text = "IDpending";

		/* Use the client's assigned ID when available */
		if (is_struct(client)
		&& variable_struct_exists(client, "ID")
		&& client.ID != noone)
		{
			id_text = scr_network_debug_id_text(client.ID);
		}

		/* Otherwise a stored local player ID can still identify the screenshot owner */
		else if (local_player_id != noone)
		{
			id_text = scr_network_debug_id_text(local_player_id);
		}

		return screenshot_file_prefix + screenshot_safe_name_fragment(screenshot_owner_name()) + "_" + id_text + "_";
	}

	/// @description Choose the fixed server prefix or resolved client-owner prefix
	/// @param {String} role Archive role, server or client. Defaults to "client"
	/// @returns {String} Archive role filename prefix
	screenshot_file_role_prefix = function(role = "client")
	{
		/* Server archives use the fixed Server_IDserver prefix instead of a client username */
		if (string_lower(string(role)) == "server")
		{
			return screenshot_file_prefix + "Server_IDserver_";
		}

		return screenshot_file_owner_prefix();
	}

	/// @description Build a client screenshot filename from owner, runtime, timestamp and artifact suffix
	/// @param {String} suffix Filename artifact label. Defaults to "flattened"
	/// @returns {String} PNG filename
	screenshot_filename = function(suffix = "flattened")
	{
		return screenshot_file_owner_prefix() + screenshot_runtime_filename_fragment() + "_" + screenshot_timestamp() + "_" + screenshot_safe_name_fragment(suffix) + ".png";
	}

	/// @description Resolve the normalized screenshot root or a sanitized category beneath it
	/// @param {String} category Output subdirectory label, empty to address the root. Defaults to ""
	/// @returns {String} Directory path without creating it
	screenshot_folder_path = function(category = "")
	{
		/* Build the normalized screenshot root under the runner's save directory */
		var root_path = screenshot_normalize_path(screenshot_path_join(game_save_id, screenshot_folder_name));

		/* Trim the optional category text before deciding whether to add a subdirectory */
		var category_name = string_trim(string(category));

		/* An empty category returns the screenshot root directly */
		if (category_name == "")
		{
			return root_path;
		}

		return screenshot_normalize_path(screenshot_path_join(root_path, screenshot_safe_name_fragment(category_name)));
	}

	/// @description Choose a categorized desktop destination or filename-only output
	/// @param {String} filename Output PNG filename
	/// @param {String} category Output subdirectory label, empty to address the root. Defaults to "manual"
	/// @returns {String} PNG save path
	screenshot_save_path = function(filename, category = "manual")
	{
		/* Runners without categorized desktop storage save using a filename alone */
		if (!screenshot_can_use_folder())
		{
			return string(filename);
		}

		return screenshot_path_join(screenshot_folder_path(category), filename);
	}

	/// @description Set colored drawing feedback with a 4200 millisecond display lifetime
	/// @param {Any} message Drawing feedback converted to text
	/// @param {Color} colour Feedback text color. Defaults to c_white
	set_screenshot_status = function(message, colour = c_white)
	{
		screenshot_status_text = string(message);
		screenshot_status_color = colour;
		screenshot_status_until = current_time + 4200;
	}

	/// @description Keep joining feedback visible or show nonempty status within its deadline
	/// @returns {Bool} Whether the feedback area should remain visible
	screenshot_status_is_visible = function()
	{
		/* Joining clients keep feedback visible while their canvas is loading, otherwise timed
		nonempty feedback expires at its millisecond deadline */
		return (is_active_client_session() && !client_history_sync_is_ready())
			|| (screenshot_status_text != "" && current_time <= screenshot_status_until);
	}

	/// @description Prepare the screenshot root and category on supported desktop runners
	/// @param {String} category Output subdirectory label, empty to address the root. Defaults to "manual"
	/// @returns {Bool} Whether directories are ready or this target does not need them
	ensure_screenshot_folder = function(category = "manual")
	{
		/* Targets using filenames or browser downloads need no categorized directory
		preparation */
		if (!screenshot_can_use_folder())
		{
			return true;
		}

		/* Resolve the root screenshot directory before creating a category beneath it */
		var root_path = screenshot_folder_path();

		/* Resolve this category's final directory for the save operation */
		var folder_path = screenshot_folder_path(category);
		try
		{
			/* Create the root first so the category has an existing parent */
			if (!directory_exists(root_path))
			{
				directory_create(root_path);
			}

			/* Create the requested category only when it does not already exist */
			if (!directory_exists(folder_path))
			{
				directory_create(folder_path);
			}

			/* A category still absent after creation reports failure rather than claiming it
			is ready */
			if (!directory_exists(folder_path))
			{
				set_screenshot_status("Could not create screenshots folder.", make_color_rgb(244, 84, 84));
				debug_note("screenshot folder failed", folder_path);
				return false;
			}
		}

		/* Directory exceptions produce save feedback and a debug error, leaving folder
		preparation unsuccessful */
		catch(e)
		{
			set_screenshot_status("Could not create screenshots folder.", make_color_rgb(244, 84, 84));
			debug_error("Could not create screenshots folder: " + string(e.message));
			debug_note("screenshot folder failed", folder_path);
			return false;
		}

		return true;
	}

	/// @description Serialize drawable client history for the browser exporter, excluding blocked and structural records
	/// @returns {String} Newline-delimited primitive or IMG2 drawing records
	browser_screenshot_commands_text = function()
	{
		/* Start with an empty newline-delimited browser drawing payload */
		var commands_text = "";

		/* Visit client history in recorded order to preserve browser replay ordering */
		for (var i = 0; i < array_length(client_history); i++)
		{
			/* Borrow this history entry for browser export classification */
			var command = client_history[i];

			/* Skip malformed entries, blocked authors and structural or undo records that are
			not browser draw commands */
			if (!is_struct(command)
			|| history_item_is_blocked(command)
			|| history_item_is_layer(command)
			|| history_item_is_undo(command))
			{
				continue;
			}

			/* Begin without a serializable line until this entry is recognized as an image or
			primitive */
			var export_line = "";

			/* Image history exports its placement rectangle, smoothing flag and Base64 PNG
			contents in IMG2 format */
			if (history_item_is_image(command))
			{
				export_line = "IMG2"
					+ "|" + string(command.x)
					+ "|" + string(command.y)
					+ "|" + string(command.w)
					+ "|" + string(command.h)

					/* Export smoothing as one only when the image explicitly enables smooth
					filtering, otherwise zero */
					+ "|" + string((variable_struct_exists(command, "smooth_filter") && command.smooth_filter) ? 1 : 0)
					+ "|" + string(command.base64);
			}

			/* Primitive history with a tool ID uses the regular command payload format */
			else if (variable_struct_exists(command, "tool_id"))
			{
				export_line = command_payload_string(command);
			}

			/* Skip entries that produced no supported browser draw line */
			if (export_line == "")
			{
				continue;
			}

			/* Insert newline separators only between populated records */
			if (commands_text != "")
			{
				commands_text += "\n";
			}

			commands_text += export_line;
		}

		return commands_text;
	}

	/// @description Request a flattened browser PNG from current drawing records and selected-role walls
	/// @param {String} filename Output PNG filename
	/// @param {Bool} use_server_walls Whether flattened browser output uses authoritative server wall data. Defaults to false
	/// @returns {Bool} Whether the extension accepted the download request, rather than confirming browser file completion
	download_browser_screenshot = function(filename, use_server_walls = false)
	{
		try
		{
			/* Use at least one room pixel for the downloaded PNG width */
			var screenshot_width = max(1, room_width);

			/* Use at least one room pixel for its height */
			var screenshot_height = max(1, room_height);

			/* Build ordered browser paint records from current client history */
			var commands_text = browser_screenshot_commands_text();

			/* Request matching client or server wall records to include world walls in the
			flattened export */
			var wall_commands = scr_get_walls().browser_export_commands(use_server_walls);

			/* Append nonempty wall records with a newline only when paint records already
			exist */
			if (wall_commands != "") commands_text += (commands_text == "" ? "" : "\n") + wall_commands;

			/* A positive extension result means the browser export request was accepted, so
			display download feedback */
			if (html5_download_drawing_history_png(filename, screenshot_width, screenshot_height, commands_text) > 0)
			{
				set_screenshot_status("Downloading: " + filename, make_color_rgb(94, 215, 122));
				debug_note("browser screenshot downloaded", "commands=" + string(array_length(client_history)));
				return true;
			}

			set_screenshot_status("Could not download browser PNG.", make_color_rgb(244, 84, 84));
			debug_note("browser screenshot failed", "html5_download_drawing_history_png returned false");
			return false;
		}

		/* An extension exception reports download failure without allowing it to escape this
		export path */
		catch(e)
		{
			/* Extract a structured browser-export message when present, otherwise stringify
			the error */
			var error_message = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			set_screenshot_status("Could not download browser PNG.", make_color_rgb(244, 84, 84));
			debug_error("Could not download browser drawing screenshot: " + error_message);
			debug_note("browser screenshot failed", filename);
			return false;
		}
	}

	/// @description Write textual metadata plus a line ending through a borrowed open file handle
	/// @param {Real} file_handle Borrowed open text-file handle retained by its caller
	/// @param {Any} text Metadata line converted to text
	screenshot_write_line = function(file_handle, text)
	{
		file_text_write_string(file_handle, string(text));
		file_text_writeln(file_handle);
	}

	/// @description Append a label and value metadata line and return the updated array
	/// @param {Array} lines Metadata lines receiving a new textual entry
	/// @param {Any} label Metadata label converted to text
	/// @param {Any} value Number to pad or metadata value to stringify
	/// @returns {Array} Metadata lines including the new entry
	screenshot_try_add_metadata_value = function(lines, label, value)
	{
		lines[array_length(lines)] = string(label) + ": " + string(value);
		return lines;
	}

	/// @description Describe archive files, context, runtime, owner and drawing state with optional OS diagnostics
	/// @param {String} flattened_filename Flattened PNG filename described by the metadata
	/// @param {Real} saved_layers Count of layer PNG save calls completed
	/// @param {Bool} layer_pngs_requested Whether separate layer PNGs were requested
	/// @param {String} category Output subdirectory label, empty to address the root. Defaults to "manual"
	/// @param {String} role Archive role, server or client. Defaults to "client"
	/// @param {String} reason Manual or lifecycle archive reason. Defaults to "manual"
	/// @returns {Array} Human-readable metadata lines
	screenshot_metadata_lines = function(flattened_filename, saved_layers, layer_pngs_requested, category = "manual", role = "client", reason = "manual")
	{
		/* Collect human-readable metadata lines for this export without writing a file yet */
		var lines = [];
		lines[array_length(lines)] = "Jonnil Online Drawing Screenshot Metadata";
		lines[array_length(lines)] = "";
		lines[array_length(lines)] = "Filename schema: JonnilOnline_Drawing_{owner}_{ID}_[Automatic-{reason}_]{runtime_tag}_{YYYY-MM-DD_HH-MM-SS}_{artifact}.png";
		lines[array_length(lines)] = "Runtime tag schema: Runtime-{PC|HTML5|GXGames|Native}_OS-{os_type_name}[_Browser-{os_browser_name}]";
		lines[array_length(lines)] = "";
		lines = screenshot_try_add_metadata_value(lines, "flattened_filename", flattened_filename);
		lines = screenshot_try_add_metadata_value(lines, "screenshot_category", category);
		lines = screenshot_try_add_metadata_value(lines, "archive_role", role);
		lines = screenshot_try_add_metadata_value(lines, "archive_reason", reason);
		lines = screenshot_try_add_metadata_value(lines, "runtime_tag", screenshot_runtime_filename_fragment());
		lines = screenshot_try_add_metadata_value(lines, "runtime_family", screenshot_runtime_family_name());
		lines = screenshot_try_add_metadata_value(lines, "os_type_name", screenshot_os_type_name());
		lines = screenshot_try_add_metadata_value(lines, "os_type_raw", os_type);
		lines = screenshot_try_add_metadata_value(lines, "os_browser_name", screenshot_browser_name());
		lines = screenshot_try_add_metadata_value(lines, "os_browser_raw", os_browser);
		lines = screenshot_try_add_metadata_value(lines, "os_version", os_version);
		lines = screenshot_try_add_metadata_value(lines, "gm_build_date", scr_get_build_date());
		lines = screenshot_try_add_metadata_value(lines, "gm_runtime_version", GM_runtime_version);
		lines = screenshot_try_add_metadata_value(lines, "room", string(room_get_name(room)) + " " + string(room_width) + "x" + string(room_height));

		/* Server archives label their owner Server, while client archives use the resolved
		player name */
		lines = screenshot_try_add_metadata_value(lines, "owner_name", string_lower(string(role)) == "server" ? "Server" : screenshot_owner_name());
		lines = screenshot_try_add_metadata_value(lines, "local_player_id", scr_network_debug_id_text(local_player_id));
		lines = screenshot_try_add_metadata_value(lines, "layers_total", array_length(layers));
		lines = screenshot_try_add_metadata_value(lines, "active_layer_id", active_layer_id);
		lines = screenshot_try_add_metadata_value(lines, "client_history_count", array_length(client_history));
		lines = screenshot_try_add_metadata_value(lines, "saved_layer_pngs", saved_layers);
		lines = screenshot_try_add_metadata_value(lines, "layer_pngs_requested", layer_pngs_requested);
		lines = screenshot_try_add_metadata_value(lines, "walls_in_flattened_png", true);

		try
		{
			lines = screenshot_try_add_metadata_value(lines, "os_language", os_get_language());
			lines = screenshot_try_add_metadata_value(lines, "os_region", os_get_region());
			lines = screenshot_try_add_metadata_value(lines, "network_connected", os_is_network_connected());
			lines = screenshot_try_add_metadata_value(lines, "os_paused", os_is_paused());
		}

		/* Optional OS metadata failures add an error line while retaining the rest of the
		archive description */
		catch(e)
		{
			/* Read the OS metadata exception's message when available, otherwise use its text
			representation */
			var os_meta_error = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			lines = screenshot_try_add_metadata_value(lines, "os_metadata_error", os_meta_error);
		}

		return lines;
	}

	/// @description Write a desktop metadata sidecar and close the locally opened file handle
	/// @param {String} metadata_path Desktop destination for the text sidecar
	/// @param {String} flattened_filename Flattened PNG filename described by the metadata
	/// @param {Real} saved_layers Count of layer PNG save calls completed
	/// @param {Bool} layer_pngs_requested Whether separate layer PNGs were requested
	/// @param {String} category Output subdirectory label, empty to address the root. Defaults to "manual"
	/// @param {String} role Archive role, server or client. Defaults to "client"
	/// @param {String} reason Manual or lifecycle archive reason. Defaults to "manual"
	/// @returns {Bool} Whether metadata writing completed
	screenshot_write_metadata_file = function(metadata_path, flattened_filename, saved_layers, layer_pngs_requested, category = "manual", role = "client", reason = "manual")
	{
		/* Metadata text files are supported only for categorized desktop screenshot output */
		if (!screenshot_can_use_folder())
		{
			return false;
		}

		/* Begin without an open file handle so exception cleanup knows whether this function
		owns one */
		var file_handle = -1;
		try
		{
			file_handle = file_text_open_write(metadata_path);

			/* A negative open result stops writing before metadata lines are generated */
			if (file_handle < 0)
			{
				debug_note("screenshot metadata skipped", "file_text_open_write returned -1");
				return false;
			}

			/* Generate metadata for the flattened PNG, requested layer files and archive
			context */
			var lines = screenshot_metadata_lines(flattened_filename, saved_layers, layer_pngs_requested, category, role, reason);

			/* Write each metadata line in array order using the owned text handle */
			for (var line_index = 0; line_index < array_length(lines); line_index++)
			{
				screenshot_write_line(file_handle, lines[line_index]);
			}

			file_text_close(file_handle);
			debug_note("screenshot metadata saved", metadata_path);
			return true;
		}

		/* A metadata write exception closes an acquired handle and reports failure */
		catch(e)
		{
			/* Close only a handle successfully acquired by this attempt */
			if (file_handle >= 0)
			{
				file_text_close(file_handle);
			}

			/* Extract structured metadata-write error text when available, otherwise stringify
			the thrown value */
			var metadata_error = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			debug_error("Could not save screenshot metadata: " + metadata_error);
			debug_note("screenshot metadata failed", metadata_path);
			return false;
		}
	}

	/// @description Search primitive and image history for a stable layer identity without inspecting current pixels
	/// @param {Real} target_layer_id Stable layer identity to search in recorded drawing
	/// @returns {Bool} Whether recorded drawing targets the layer
	layer_has_drawn_history = function(target_layer_id)
	{
		/* Search recorded client history for drawing attributed to the requested stable layer
		ID */
		for (var history_index = 0; history_index < array_length(client_history); history_index++)
		{
			/* Borrow the current history item while excluding non-drawing records */
			var item = client_history[history_index];

			/* Malformed entries, layer structure and undo records do not prove a layer has
			drawn history */
			if (!is_struct(item)
			|| history_item_is_layer(item)
			|| history_item_is_undo(item))
			{
				continue;
			}

			/* Images declare their layer through an explicit image layer_id field */
			if (history_item_is_image(item))
			{
				/* A matching explicit image layer ID proves this layer has recorded drawing */
				if (variable_struct_exists(item, "layer_id")
				&& item.layer_id == target_layer_id)
				{
					return true;
				}

				/* Other images do not enter the primitive tool comparison */
				continue;
			}

			/* A primitive with a matching resolved layer ID proves recorded drawing for this
			layer */
			if (variable_struct_exists(item, "tool_id")
			&& command_layer_id(item) == target_layer_id)
			{
				return true;
			}
		}

		/* No matching image or primitive leaves this layer classified without drawn history */
		return false;
	}

	/// @description Count layer identities with recorded primitive or image drawing
	/// @returns {Real} Number of current layer records with drawn history
	drawn_layer_count = function()
	{
		/* Start the drawn-layer count at zero before inspecting current layer identities */
		var count = 0;

		/* Visit all current layer records, including hidden or archived records present in the
		stack */
		for (var layer_index = 0; layer_index < array_length(layers); layer_index++)
		{
			/* Count a layer only when recorded drawing targets its identity, without checking
			current visible pixels */
			if (layer_has_drawn_history(layers[layer_index].id))
			{
				count++;
			}
		}

		return count;
	}

	/// @description Require a nonempty destination and remove an existing file before a PNG save
	/// @param {Any} path PNG destination path converted to text
	/// @returns {Bool} Whether the path is nonempty and no older file remains
	screenshot_prepare_output_path = function(path)
	{
		/* Convert the intended output path to text before deciding whether an older file needs
		removal */
		var output_path = string(path);

		/* A nonexistent output is already available, while an empty path is invalid */
		if (output_path == "" || !file_exists(output_path))
		{
			/* Report ready only for a nonempty output path */
			return output_path != "";
		}

		try
		{
			file_delete(output_path);
		}

		/* A deletion exception means the output cannot safely be replaced */
		catch(e)
		{
			return false;
		}

		/* Confirm the older file is gone before a subsequent PNG save uses this path */
		return !file_exists(output_path);
	}

	/// @description Export a flattened drawing with walls, optional recorded layer PNGs and optional desktop metadata
	/// @param {String} category Output subdirectory label, empty to address the root. Defaults to "manual"
	/// @param {String} role Archive role, server or client. Defaults to "client"
	/// @param {String} reason Manual or lifecycle archive reason. Defaults to "manual"
	/// @param {Bool} force_layer_pngs Whether to request per-layer artifacts even with one drawn layer. Defaults to false
	/// @returns {Bool} Whether browser export was accepted or desktop PNG save calls completed, even if optional metadata failed
	save_drawing_screenshot = function(category = "manual", role = "client", reason = "manual", force_layer_pngs = false)
	{
		/* Track a possible temporary wall-composited export surface, starting without an owned
		resource */
		var walls_export_surface = noone;

		/* A screenshot needs prepared paint-layer and canvas surfaces */
		if (!ensure_surface())
		{
			set_screenshot_status("Could not prepare drawing layers.", make_color_rgb(244, 84, 84));
			debug_note("screenshot failed", "surface unavailable");
			return false;
		}

		/* Stop before saving when its required categorized directory could not be prepared */
		if (!ensure_screenshot_folder(category))
		{
			return false;
		}

		try
		{
			/* Refresh the canvas composite if layer pixels or local visibility made it stale */
			if (layer_composite_dirty)
			{
				composite_layers();
			}

			/* Use one local timestamp across flattened, layer and metadata filenames in this
			archive */
			var export_stamp = screenshot_timestamp();

			/* Use one runtime tag across those related artifacts */
			var export_runtime = screenshot_runtime_filename_fragment();

			/* Filename parts are: project + drawing owner + network ID + runtime tag
			+ timestamp + artifact. The runtime tag is deliberately obvious so
			PC/native and HTML5/browser screenshots can be compared at a glance */
			/* Manual exports begin without an automatic-reason filename fragment */
			var context_fragment = "";

			/* Other reasons add their sanitized Automatic fragment so lifecycle archives
			remain recognizable */
			if (string_lower(string(reason)) != "manual")
			{
				context_fragment = "Automatic-" + screenshot_safe_name_fragment(reason) + "_";
			}

			/* Combine owner role, context, runtime and timestamp into this archive's shared
			artifact prefix */
			var export_prefix = screenshot_file_role_prefix(role) + context_fragment + export_runtime + "_" + export_stamp;

			/* Name the flattened image from that shared prefix */
			var flattened_filename = export_prefix + "_flattened.png";

			/* Resolve its output category and platform save path before export */
			var flattened_path = screenshot_save_path(flattened_filename, category);
			last_screenshot_filename = flattened_filename;
			last_screenshot_path = flattened_path;

			/* Browser exports request only a flattened PNG from ordered history and wall
			records */
			if (screenshot_uses_browser_storage())
			{
				last_screenshot_path = flattened_filename;
				set_screenshot_status("Browser export saves flattened PNG only.", make_color_rgb(255, 220, 95));

				/* Choose authoritative server wall data only for a server-role browser archive */
				return download_browser_screenshot(flattened_filename, string_lower(string(role)) == "server");
			}

			/* A desktop flattened output must have a replaceable nonempty destination path */
			if (!screenshot_prepare_output_path(flattened_path))
			{
				throw "Could not prepare the flattened PNG output path.";
			}

			/* Ask the wall subsystem for a flattened export surface containing the selected
			role's walls */
			walls_export_surface = scr_get_walls().create_export_surface(canvas_surface, string_lower(string(role)) == "server");

			/* A missing wall-export surface stops the save rather than producing an incomplete
			flattened PNG */
			if (!surface_exists(walls_export_surface)) throw "Could not prepare walls for the flattened PNG.";
			surface_save(walls_export_surface, flattened_path);

			/* Release an independently allocated wall composite while retaining a borrowed
			canvas surface */
			if (walls_export_surface != canvas_surface) surface_free(walls_export_surface);
			walls_export_surface = noone;

			/* Count only layer PNGs whose save calls complete within this export loop */
			var saved_layers = 0;

			/* Save layer artifacts when forced or when more than one layer has recorded
			drawing */
			var should_save_layer_pngs = force_layer_pngs || drawn_layer_count() > 1;

			/* A layer-output request visits the layer stack after saving its flattened image */
			if (should_save_layer_pngs)
			{
				/* Visit layer records in stack order to use matching one-based file numbering */
				for (var layer_index = 0; layer_index < array_length(layers); layer_index++)
				{
					/* Skip layers whose GPU surfaces cannot be prepared */
					if (!ensure_layer_surface(layer_index))
					{
						continue;
					}

					/* Borrow this layer's name, visibility and pixel surface for its separate
					PNG */
					var paint_layer = layers[layer_index];

					/* Skip layers without recorded primitive or image drawing */
					if (!layer_has_drawn_history(paint_layer.id))
					{
						continue;
					}

					/* Format this layer's one-based stack position with at least two digits */
					var layer_number = screenshot_pad_number(layer_index + 1, 2);

					/* Add a hidden suffix only when the layer's local visibility is disabled */
					var layer_visibility_suffix = paint_layer.visible ? "" : "_hidden";

					/* Build the layer artifact name from archive prefix, stack number, cleaned
					name and optional hidden marker */
					var layer_filename = export_prefix
						+ "_layer_"
						+ layer_number
						+ "_"
						+ screenshot_safe_name_fragment(paint_layer.name)
						+ layer_visibility_suffix
						+ ".png";

					/* Resolve the category path for this layer PNG */
					var layer_path = screenshot_save_path(layer_filename, category);

					/* A layer destination that cannot be prepared aborts the remaining archive
					save */
					if (!screenshot_prepare_output_path(layer_path))
					{
						throw "Could not prepare a drawing-layer PNG output path.";
					}
					surface_save(paint_layer.surface, layer_path);
					saved_layers++;
				}
			}

			/* Give the metadata text file the same artifact prefix as the PNGs */
			var metadata_filename = export_prefix + "_metadata.txt";

			/* Record whether the optional metadata file was written, without failing already
			saved PNGs when metadata fails */
			var metadata_saved = screenshot_write_metadata_file(screenshot_save_path(metadata_filename, category), flattened_filename, saved_layers, should_save_layer_pngs, category, role, reason);

			/* When layer artifacts were saved, include their count in the success message */
			if (saved_layers > 0)
			{
				/* Mention metadata only when its text file was written successfully */
				set_screenshot_status("Saved flattened PNG + " + string(saved_layers) + " layer PNG(s)" + (metadata_saved ? " + metadata." : "."), make_color_rgb(94, 215, 122));
			}

			/* Without saved layer artifacts, report the flattened image alone and optional
			metadata */
			else
			{
				/* The flattened-only feedback adds metadata wording only after a successful
				metadata write */
				set_screenshot_status("Saved flattened PNG" + (metadata_saved ? " + metadata." : "."), make_color_rgb(94, 215, 122));
			}

			debug_note("screenshot saved", flattened_path);
			return true;
		}

		/* An export exception releases any separately owned wall surface and reports that the
		archive save failed */
		catch(e)
		{
			/* Cleanup frees only a live wall composite owned by this attempt, preserving the
			main canvas */
			if (surface_exists(walls_export_surface) && walls_export_surface != canvas_surface) surface_free(walls_export_surface);
			set_screenshot_status("Could not save layer PNGs.", make_color_rgb(244, 84, 84));

			/* Extract structured screenshot error text when present, otherwise stringify the
			thrown value */
			var screenshot_error_message = is_struct(e) && variable_struct_exists(e, "message") ? string(e.message) : string(e);
			debug_error("Could not save drawing layer PNGs: " + screenshot_error_message);
			debug_note("screenshot failed", last_screenshot_path);
			return false;
		}
	}

	/// @description Dispose old drawing resources and interaction queues, adopt replacement history and reconstruct its surfaces
	/// @param {Array} history_items Replacement history adopted for replay, or an empty replacement for non-array input
	/// @returns {Bool} Whether replacement canvas preparation and required replay succeeded
	replace_client_drawing_history = function(history_items)
	{
		/* Use a supplied history array or an empty replacement when the input is not an array */
		var replacement = is_array(history_items) ? history_items : [];
		dispose_history_items_undo_patches(client_history);
		fill_abort_runtime();
		delete_pending_image_draws();
		delete_surface();

		/* Recreate default layer identities after disposing the old history patches, fill
		runtime, image loads and surfaces */
		layers = [];
		active_layer_id = 1;
		next_layer_id = 2;
		ensure_default_layers();

		/* Adopt the replacement history and clear replay, receive, fill and image deferral
		state before reconstruction */
		client_history = replacement;
		client_history_revision++;
		client_history_replay = noone;
		client_history_replay_restart = false;
		pending_image_receives = [];
		fill_active_job = noone;
		fill_deferred_history_items = [];
		image_deferred_history_items = [];

		/* Discard redo groups, outbound history, current selection and layer highlighting from
		the replaced canvas */
		clear_redo_stack();
		redo_stack = [];
		pending_client_history_sends = [];
		client_image_send_chunk = 0;
		next_pending_history_send_time = 0;
		clear_selection();
		layer_blink_layer_id = 0;
		layer_blink_started_at = 0;
		layer_composite_dirty = true;

		/* Reallocate surfaces and replay the replacement history through the normal canvas
		preparation path */
		return ensure_surface();
	}

	/// @description Replace the current drawing with empty history and prepared default layers
	/// @returns {Bool} Whether blank canvas preparation succeeded
	clear_client_drawing_state = function()
	{
		/* Keep whether replacing the drawing with empty history produced a prepared blank
		canvas */
		var cleared = replace_client_drawing_history([]);
		debug_note("drawing lifecycle reset", "blank canvas");
		return cleared;
	}

	/// @description Replace client drawing state with an authoritative history-array snapshot for export
	/// @returns {Bool} Whether server snapshot surfaces were prepared
	prepare_server_archive_surface = function()
	{
		/* Copy authoritative server history so the archive uses accepted drawing rather than
		optimistic client state */
		var server_snapshot = copy_server_history_snapshot();

		/* Replace client drawing state with that snapshot and keep whether its surfaces were
		prepared */
		var prepared = replace_client_drawing_history(server_snapshot);
		debug_note("server archive prepared", string(array_length(server_snapshot)) + " authoritative item(s)");
		return prepared;
	}

	/// @description Prepare server state when requested and export into the lifecycle reason's automatic category
	/// @param {String} reason Manual or lifecycle archive reason. Defaults to "client_reset"
	/// @param {String} role Archive role, server or client. Defaults to "client"
	/// @param {Bool} force_layer_pngs Whether to request per-layer artifacts even with one drawn layer. Defaults to false
	/// @returns {Bool} Whether archive preparation and export succeeded
	save_automatic_archive = function(reason = "client_reset", role = "client", force_layer_pngs = false)
	{
		/* Normalize the archive role for client/server context decisions */
		var normalized_role = string_lower(string(role));

		/* Normalize and sanitize its lifecycle reason for category and filename use */
		var normalized_reason = screenshot_safe_name_fragment(string_lower(string(reason)));

		/* Server archives must reconstruct the authoritative snapshot before attempting export */
		if (normalized_role == "server"
		&& !prepare_server_archive_surface())
		{
			set_screenshot_status("Could not prepare the server drawing archive.", make_color_rgb(244, 84, 84));
			return false;
		}

		/* Keep each lifecycle reason in a distinct automatic screenshot category */
		var category = "automatic_" + normalized_reason;
		return save_drawing_screenshot(category, normalized_role, normalized_reason, force_layer_pngs);
	}

	/// @description Request the desktop screenshot root through the shared folder opener and show result feedback
	/// @returns {Bool} Whether the folder was launched automatically
	open_screenshot_folder = function()
	{
		/* Opening the screenshot directory needs enabled desktop folder integration and a save
		root */
		if (!screenshot_folder_can_open())
		{
			set_screenshot_status("Screenshot folder is only available on desktop builds.", make_color_rgb(255, 220, 95));
			debug_note("screenshot folder skipped", "not a desktop folder target");
			return false;
		}

		/* Resolve the root screenshot directory to pass to the shared desktop folder opener */
		var folder_path = screenshot_folder_path();

		/* Keep the folder opener's detailed result for automatic versus manual-open feedback */
		var open_result = scr_open_folder(folder_path, "Drawing Screenshots Folder");

		/* Treat only Opened as a successful automatic folder launch */
		var opened = open_result == FolderOpenResult.Opened;

		/* An automatic launch records the folder path and confirms success */
		if (opened)
		{
			last_screenshot_path = folder_path;
			set_screenshot_status("Opened screenshots folder.", make_color_rgb(94, 215, 122));
			debug_note("screenshot folder opened", folder_path);
			return true;
		}

		/* A prepared folder requiring manual opening preserves its path and points to the
		popup instructions */
		if (open_result == FolderOpenResult.ManualOpenNeeded)
		{
			last_screenshot_path = folder_path;
			set_screenshot_status("Screenshots folder is ready. Use the popup path to open it manually.", make_color_rgb(255, 220, 95));
			debug_note("screenshot folder needs manual open", folder_path);
			return false;
		}

		set_screenshot_status("Could not open screenshots folder.", make_color_rgb(244, 84, 84));
		debug_note("screenshot folder failed", folder_path);
		return false;
	}

	/// @description Request the desktop image cache through the shared folder opener and show server import feedback
	/// @returns {Bool} Whether the folder was launched automatically
	open_image_import_folder = function()
	{
		/* Opening the import directory uses the same desktop integration capability check */
		if (!screenshot_folder_can_open())
		{
			set_server_import_status("Import folder is only available on desktop builds.", make_color_rgb(255, 220, 95));
			debug_note("import folder skipped", "not a desktop folder target");
			return false;
		}

		/* Resolve the import cache directory for the shared folder opener */
		var folder_path = image_import_temp_folder();

		/* Keep the detailed open result so feedback can distinguish automatic launch from
		manual action */
		var open_result = scr_open_folder(folder_path, "Drawing Import Folder");

		/* Only the Opened enum counts as an automatic launch success */
		var opened = open_result == FolderOpenResult.Opened;

		/* A launched import directory reports success in the server import feedback */
		if (opened)
		{
			set_server_import_status("Opened import folder.", make_color_rgb(94, 215, 122));
			debug_note("import folder opened", folder_path);
			return true;
		}

		/* A prepared import directory requiring manual action reports its popup path guidance */
		if (open_result == FolderOpenResult.ManualOpenNeeded)
		{
			set_server_import_status("Import folder is ready. Use the popup path to open it manually.", make_color_rgb(255, 220, 95));
			debug_note("import folder needs manual open", folder_path);
			return false;
		}

		set_server_import_status("Could not open import folder.", make_color_rgb(244, 84, 84));
		debug_note("import folder failed", folder_path);
		return false;
	}
	#endregion /* Screenshot Export and Automatic Archives END */

	#region /* Toolbar Layout and Layer Panel Input */
	/// @description Recompute cached toolbar rectangles and clamp them around GUI bounds and reserved zoom controls
	update_toolbar_layout = function()
	{
		/* Read a positive GUI width for toolbar clamping and cache identity */
		var gui_w = max(1, display_get_gui_width());

		/* Read a positive GUI height for vertical clamping and cache identity */
		var gui_h = max(1, display_get_gui_height());

		/* Include every size, visibility, capability and reserved-control input that can
		change the computed toolbar geometry */
		var cache_suffix = "|" + string(gui_w) + "|" + string(gui_h)
			+ "|" + string(toolbar_hidden) + "|" + string(tool == DRAW_TOOL_FILL)
			+ "|" + string(inactive_layer_dim_available()) + "|" + string(screenshot_folder_can_open())
			+ "|" + string(array_length(swatches)) + "|" + string(toolbar_reserved_right_width)
			+ "|" + string(toolbar_reserved_top) + "|" + string(toolbar_reserved_bottom);

		/* Include toolbar origin with those inputs to identify a reusable layout */
		var cache_key = string(toolbar_x) + "|" + string(toolbar_y) + cache_suffix;

		/* Reuse a cached layout only while all geometry-affecting values agree */
		if (toolbar_layout_cache_key == cache_key)
		{
			return;
		}

		/* Use a six-GUI-pixel gap between the toolbar's ordinary neighboring controls */
		var gap = 6;
		draw_button_height = 30;

		/* Allow two layout passes so a newly clamped toolbar origin can recompute every child
		control position */
		for (var pass = 0; pass < 2; pass++)
		{
			/* The collapsed toolbar needs only its Show button and surrounding padding */
			if (toolbar_hidden)
			{
				draw_button_width = show_toolbar_button_width;
				toolbar_width = show_toolbar_button_width + 12;
				toolbar_height = show_toolbar_button_height + 12;
				draw_button_x = toolbar_x + 6;
				draw_button_y = toolbar_y + 6;
			}

			/* The expanded toolbar lays out tool, color and action rows */
			else
			{
				draw_button_width = hide_toolbar_button_width;
				draw_button_x = toolbar_x + 6;
				draw_button_y = toolbar_y + 6;
				action_button_y = toolbar_y + 140;
				toolbar_height = 178;

				/* Begin the tool-icon row immediately after the Hide button and its gap */
				var button_x = draw_button_x + draw_button_width + gap;
				tool_button_width = 34;
				tool_button_height = draw_button_height;

				/* Each button carries a hover key, visible label, tool enum and GUI x/y/w/h
				rectangle, arranged in fixed Pen-through-Wall order */
				tool_buttons =
				[
					{ key: "pen", label: "Pen", tool_id: DRAW_TOOL_PEN, x: button_x, y: draw_button_y, w: tool_button_width, h: tool_button_height },
					{ key: "eraser", label: "Eraser", tool_id: DRAW_TOOL_ERASER, x: button_x + (tool_button_width + gap) * 1, y: draw_button_y, w: tool_button_width, h: tool_button_height },
					{ key: "select", label: "Select", tool_id: DRAW_TOOL_SELECT, x: button_x + (tool_button_width + gap) * 2, y: draw_button_y, w: tool_button_width, h: tool_button_height },
					{ key: "picker", label: "Color Picker", tool_id: DRAW_TOOL_COLOR_PICKER, x: button_x + (tool_button_width + gap) * 3, y: draw_button_y, w: tool_button_width, h: tool_button_height },
					{ key: "line", label: "Line", tool_id: DRAW_TOOL_LINE, x: button_x + (tool_button_width + gap) * 4, y: draw_button_y, w: tool_button_width, h: tool_button_height },
					{ key: "rect", label: "Rectangle", tool_id: DRAW_TOOL_RECTANGLE, x: button_x + (tool_button_width + gap) * 5, y: draw_button_y, w: tool_button_width, h: tool_button_height },
					{ key: "circle", label: "Ellipse", tool_id: DRAW_TOOL_CIRCLE, x: button_x + (tool_button_width + gap) * 6, y: draw_button_y, w: tool_button_width, h: tool_button_height },
					{ key: "fill", label: "Fill", tool_id: DRAW_TOOL_FILL, x: button_x + (tool_button_width + gap) * 7, y: draw_button_y, w: tool_button_width, h: tool_button_height },
					{ key: "stamp", label: "Stamp", tool_id: DRAW_TOOL_STAMP, x: button_x + (tool_button_width + gap) * 8, y: draw_button_y, w: tool_button_width, h: tool_button_height },
					{ key: "text", label: "Text", tool_id: DRAW_TOOL_TEXT, x: button_x + (tool_button_width + gap) * 9, y: draw_button_y, w: tool_button_width, h: tool_button_height },
					{ key: "wall", label: "Wall Brush", tool_id: DRAW_TOOL_WALL, x: button_x + (tool_button_width + gap) * 10, y: draw_button_y, w: tool_button_width, h: tool_button_height }
				];
				pen_button_x = tool_buttons[0].x;
				eraser_button_x = tool_buttons[1].x;

				/* Borrow the final tool button to position brush and background controls after
				the icon row */
				var last_tool = tool_buttons[array_length(tool_buttons) - 1];
				width_minus_x = last_tool.x + last_tool.w + gap + 10;
				brush_slider_x = width_minus_x + width_button_width + gap + 8;
				brush_slider_y = draw_button_y + 8;
				brush_input_x = brush_slider_x + brush_slider_width + gap + 2;
				brush_input_y = draw_button_y + 4;
				width_plus_x = brush_input_x + brush_input_width + gap;

				canvas_background_label_x = width_plus_x + width_button_width + gap;
				canvas_background_label_y = draw_button_y + 7;
				canvas_background_slider_x = canvas_background_label_x + canvas_background_label_width + gap;
				canvas_background_slider_y = draw_button_y + 8;
				canvas_background_value_x = canvas_background_slider_x + canvas_background_slider_width + gap;
				canvas_background_value_y = draw_button_y + 4;

				/* Keep the first row's right edge when choosing the full expanded toolbar
				width */
				var row_one_right = canvas_background_value_x + canvas_background_value_width;

				/* Start the action row at the toolbar's left inset before optional fill source
				controls */
				var action_left = toolbar_x + 10;
				fill_source_label_x = action_left;
				fill_source_label_y = action_button_y + 7;
				fill_source_button_y = action_button_y;

				/* Fill alone displays Current and Visible source choices before Undo */
				if (tool == DRAW_TOOL_FILL)
				{
					fill_current_button_x = fill_source_label_x + fill_source_label_width + gap;
					fill_visible_button_x = fill_current_button_x + fill_current_button_width + gap;
					action_left = fill_visible_button_x + fill_visible_button_width + gap + 8;
				}

				/* Other tools move fill source buttons outside hit-testable GUI positions */
				else
				{
					fill_current_button_x = -10000;
					fill_visible_button_x = -10000;
				}

				undo_button_x = action_left;
				redo_button_x = undo_button_x + undo_button_width + gap;
				screenshot_button_x = redo_button_x + redo_button_width + gap;
				open_screenshot_folder_button_x = screenshot_button_x + screenshot_button_width + gap;

				/* Begin the screenshot action edge at the screenshot button before optional
				folder opening */
				var button_right = screenshot_button_x + screenshot_button_width;

				/* Reserve folder-opening button width only on runners that offer desktop
				folder integration */
				if (screenshot_folder_can_open())
				{
					button_right = open_screenshot_folder_button_x + open_screenshot_folder_button_width;
				}
				draw_hidden_button_x = button_right + gap;
				dim_inactive_button_x = draw_hidden_button_x + draw_hidden_button_width + gap;

				/* Begin the third row's right edge at Draw Hidden before optional
				inactive-layer dimming */
				var row_three_right = draw_hidden_button_x + draw_hidden_button_width;

				/* Include the dimming button when the current drawing mode and layer state
				support it */
				if (inactive_layer_dim_available())
				{
					row_three_right = dim_inactive_button_x + dim_inactive_button_width;
				}

				/* Otherwise hide its hit rectangle outside the GUI */
				else
				{
					dim_inactive_button_x = -10000;
				}

				swatch_x = toolbar_x + 10;

				/* Position the color controls' second row fifty GUI pixels below the toolbar
				origin */
				var row_two_y = toolbar_y + 50;
				swatch_y = toolbar_y + 68;
				recent_swatch_y = swatch_y + swatch_size + 4;
				color_preview_x = swatch_x + array_length(swatches) * (swatch_size + 4) + 12;
				color_preview_y = row_two_y + 10;
				hsv_slider_x = color_preview_x + color_preview_size + 48;
				hsv_slider_y = row_two_y;
				hsv_input_x = hsv_slider_x + hsv_slider_width + 10;

				/* Include the numeric HSV field edge and trailing space when choosing toolbar
				width */
				var row_two_right = hsv_input_x + hsv_input_width + 30;
				toolbar_width = max(max(row_one_right, row_two_right), row_three_right) - toolbar_x + 10;
			}

			/* Start horizontal clamping at the full GUI width before reserving camera zoom
			controls */
			var toolbar_right_limit = gui_w;

			/* An expanded toolbar overlaps zoom controls only when its vertical extent crosses
			their reserved band */
			var blocks_zoom_controls = !toolbar_hidden
				&& toolbar_y < toolbar_reserved_bottom
				&& toolbar_y + toolbar_height > toolbar_reserved_top;

			/* An overlapping toolbar reserves the zoom panel's right-side width */
			if (blocks_zoom_controls)
			{
				toolbar_right_limit = max(0, gui_w - toolbar_reserved_right_width);
			}

			/* Clamp the toolbar's horizontal origin within the currently available GUI span */
			var clamped_x = clamp(toolbar_x, 0, max(0, toolbar_right_limit - toolbar_width));

			/* Clamp its vertical origin within the GUI height */
			var clamped_y = clamp(toolbar_y, 0, max(0, gui_h - toolbar_height));

			/* If neither coordinate changed, this pass's child geometry is already final */
			if (clamped_x == toolbar_x && clamped_y == toolbar_y)
			{
				break;
			}

			toolbar_x = clamped_x;
			toolbar_y = clamped_y;
		}
		toolbar_layout_cache_key = string(toolbar_x) + "|" + string(toolbar_y) + cache_suffix;
	}

	/// @description Test a point against inclusive ordered rectangle edges
	/// @param {Real} mx Horizontal GUI pointer position
	/// @param {Real} my Vertical GUI pointer position
	/// @param {Real} x1 Rectangle left coordinate
	/// @param {Real} y1 Rectangle top coordinate
	/// @param {Real} x2 Rectangle right coordinate
	/// @param {Real} y2 Rectangle bottom coordinate
	/// @returns {Bool} Whether the point lies on or inside all edges
	point_in_rect = function(mx, my, x1, y1, x2, y2)
	{
		/* The rectangle includes its boundary coordinates on both axes */
		return mx >= x1 && mx <= x2 && my >= y1 && my <= y2;
	}

	/// @description Resolve a panel pointer to its layer-array index in reverse scrolled display order
	/// @param {Real} mx Horizontal GUI pointer position
	/// @param {Real} my Vertical GUI pointer position
	/// @returns {Real} Layer-array index or noone outside valid displayed rows
	layer_row_index_at = function(mx, my)
	{
		/* Locate the first list row beneath the layer panel header */
		var list_top = layers_panel_y + layers_panel_header_height + 4;

		/* Compute how many whole rows fit while reserving the panel footer, retaining at least
		one row */
		var visible_rows = max(1, floor((layers_panel_height - layers_panel_header_height - 38) / layers_panel_row_height));

		/* A pointer outside the list rectangle has no selectable layer row */
		if (!point_in_rect(mx, my, layers_panel_x + 6, list_top, layers_panel_x + layers_panel_width - 6, list_top + visible_rows * layers_panel_row_height))
		{
			return noone;
		}

		/* Convert pointer y to a zero-based row offset within the visible list */
		var display_row = floor((my - list_top) / layers_panel_row_height);

		/* Resolve active display ordering, including current layer-preview context */
		var display_indices = active_layer_display_indices();
		layers_panel_scroll = clamp(layers_panel_scroll, 0, max(0, array_length(display_indices) - visible_rows));

		/* Reverse display order so higher stack positions appear above lower ones, applying
		the panel's scroll offset */
		var display_position = array_length(display_indices) - 1 - layers_panel_scroll - display_row;

		/* An empty row or position outside the current ordering has no layer index */
		if (display_position < 0 || display_position >= array_length(display_indices))
		{
			return noone;
		}

		return display_indices[display_position];
	}

	/// @description Convert a displayed layer-array index to its scrolled reverse-order row
	/// @param {Real} layer_index Zero-based layer-array index
	/// @returns {Real} Display row that may be offscreen, or noone when not displayed
	layer_display_row_from_index = function(layer_index)
	{
		/* Resolve the current active display ordering for converting a layer index back to a
		panel row */
		var display_indices = active_layer_display_indices();

		/* Compute the visible row capacity used to clip scroll state */
		var visible_rows = max(1, floor((layers_panel_height - layers_panel_header_height - 38) / layers_panel_row_height));
		layers_panel_scroll = clamp(layers_panel_scroll, 0, max(0, array_length(display_indices) - visible_rows));

		/* Find the matching layer-array index inside the displayed ordering */
		for (var display_position = 0; display_position < array_length(display_indices); display_position++)
		{
			/* Convert the matching position into its reverse-order scrolled row, which may lie
			outside the visible range */
			if (display_indices[display_position] == layer_index)
			{
				return array_length(display_indices) - 1 - layers_panel_scroll - display_position;
			}
		}

		/* An index absent from display ordering has no display row */
		return noone;
	}

	/// @description Adjust panel scroll to reveal a displayed stable layer identity
	/// @param {Real} layer_id Stable layer identity to reveal
	/// @returns {Bool} Whether the identity was found
	layers_panel_scroll_to_layer = function(layer_id)
	{
		/* Use the current active display ordering to reveal a requested stable layer */
		var display_indices = active_layer_display_indices();

		/* Compute the number of visible rows for deciding which scroll offset reveals it */
		var visible_rows = max(1, floor((layers_panel_height - layers_panel_header_height - 38) / layers_panel_row_height));

		/* Search the displayed indices for the requested stable identity */
		for (var display_position = 0; display_position < array_length(display_indices); display_position++)
		{
			/* Skip layers with other identities before changing scroll */
			if (layers[display_indices[display_position]].id != layer_id)
			{
				continue;
			}

			/* Compute the highest display position currently visible at the top */
			var top_row = array_length(display_indices) - 1 - layers_panel_scroll;

			/* Compute the lowest position currently visible at the bottom */
			var bottom_row = top_row - visible_rows + 1;

			/* A target above the visible range becomes the new top row */
			if (display_position > top_row)
			{
				layers_panel_scroll = array_length(display_indices) - 1 - display_position;
			}

			/* A target below the range becomes the new bottom row */
			else if (display_position < bottom_row)
			{
				layers_panel_scroll = array_length(display_indices) - visible_rows - display_position;
			}
			layers_panel_scroll = clamp(layers_panel_scroll, 0, max(0, array_length(display_indices) - visible_rows));
			return true;
		}

		/* No displayed layer with this identity leaves scrolling unchanged */
		return false;
	}

	/// @description Resolve a footer action to its fixed GUI slot shared by ordinary and preview modes
	/// @param {String} button_key Layer footer action hover key
	/// @returns {Struct} x/y/w/h button rectangle, all zero for an unknown key
	layer_panel_button_rect = function(button_key)
	{
		/* Locate action buttons above the layer panel's bottom inset */
		var bottom_y = layers_panel_y + layers_panel_height - layers_panel_button_size - 6;

		/* Start the action strip at the panel's left inset */
		var left_x = layers_panel_x + 8;

		/* Separate these square action buttons by five GUI pixels */
		var gap = 5;

		/* Begin with the first slot before mapping its requested action key */
		var button_index = 0;

		/* Map ordinary and move-preview actions to the six fixed footer slots */
		switch (button_key)
		{
			/* Add uses footer slot zero */
			case "layer_add":
				button_index = 0;
				break;

			/* Duplicate uses footer slot one */
			case "layer_duplicate":
				button_index = 1;
				break;

			/* Move Down uses footer slot two */
			case "layer_down":
				button_index = 2;
				break;

			/* Move Up uses footer slot three */
			case "layer_up":
				button_index = 3;
				break;

			/* Archive and Cancel Move share footer slot four in their respective modes */
			case "layer_archive":
			case "layer_move_cancel":
				button_index = 4;
				break;

			/* Restore and Apply Move share footer slot five */
			case "layer_restore":
			case "layer_move_apply":
				button_index = 5;
				break;

			/* Unknown actions return an empty x/y/w/h rectangle rather than an actionable
			button slot */
			default:
				return { x: 0, y: 0, w: 0, h: 0 };
		}

		/* Return the slot's GUI x/y origin and square w/h dimensions */
		return
		{
			x: left_x + button_index * (layers_panel_button_size + gap),
			y: bottom_y,
			w: layers_panel_button_size,
			h: layers_panel_button_size
		};
	}

	/// @description Hit-test footer actions available in the current move-preview mode
	/// @param {Real} mx Horizontal GUI pointer position
	/// @param {Real} my Vertical GUI pointer position
	/// @returns {String} Action hover key or empty outside their rectangles
	layer_panel_button_at = function(mx, my)
	{
		/* Move preview displays movement and confirmation actions, while normal mode displays
		the full layer-management set */
		var button_keys = layer_move_draft_active
			? ["layer_down", "layer_up", "layer_move_cancel", "layer_move_apply"]
			: ["layer_add", "layer_duplicate", "layer_down", "layer_up", "layer_archive", "layer_restore"];

		/* Inspect only the buttons available in the current footer mode */
		for (var button_index = 0; button_index < array_length(button_keys); button_index++)
		{
			/* Resolve this button's GUI rectangle before hit testing */
			var rect = layer_panel_button_rect(button_keys[button_index]);

			/* Return the action whose inclusive rectangle contains the pointer */
			if (point_in_rect(mx, my, rect.x, rect.y, rect.x + rect.w, rect.y + rect.h))
			{
				return button_keys[button_index];
			}
		}

		/* No footer hit produces an empty action key */
		return "";
	}

	/// @description Resolve layer action availability against votes, preview state and shared stack limits
	/// @param {String} button_key Layer footer action hover key
	/// @returns {Bool} Whether this action can be used now
	layer_panel_button_enabled = function(button_key)
	{
		/* An active authoritative vote disables all layer action buttons */
		if (is_struct(client_layer_vote))
		{
			return false;
		}

		/* Count unarchived layers to enforce stack boundaries and shared layer ceilings */
		var active_count = active_layer_count();

		/* A local move preview uses draft-specific availability rather than ordinary layer
		actions */
		if (layer_move_draft_active)
		{
			/* A submitted preview is locked until its server outcome arrives */
			if (layer_move_draft_submitted)
			{
				return false;
			}

			/* Resolve each unsubmitted preview action against its target and original
			positions */
			switch (button_key)
			{
				/* Move Down is available only above the bottom active-stack position */
				case "layer_down":
					return layer_move_draft_target_position > 0;

				/* Move Up is available only below the top active-stack position */
				case "layer_up":
					return layer_move_draft_target_position < active_count - 1;

				/* An unsubmitted preview can always be cancelled */
				case "layer_move_cancel":
					return true;

				/* Apply Move requires a target position different from the remembered original */
				case "layer_move_apply":
					return layer_move_draft_target_position != layer_move_draft_original_position;
			}

			/* Other action names are unavailable during a move preview */
			return false;
		}

		/* Locate the current selected layer within the active stack for ordinary movement
		limits */
		var active_position = active_layer_position(active_layer_id);

		/* Resolve each ordinary layer action against active position, active count and archive
		state */
		switch (button_key)
		{
			/* Add and Duplicate require space beneath both active-layer and total-layer shared
			ceilings */
			case "layer_add":
			case "layer_duplicate":
				return active_count < max_shared_active_layers
					&& array_length(layers) < max_shared_total_layers;

			/* Move Down requires a valid selected position above the bottom */
			case "layer_down":
				return active_position != noone && active_position > 0;

			/* Move Up requires a valid selected position below the top */
			case "layer_up":
				return active_position != noone && active_position < active_count - 1;

			/* Archive must leave at least one active layer */
			case "layer_archive":
				return active_count > 1;

			/* Restore requires an archived layer and available active-layer capacity */
			case "layer_restore":
				return archived_layer_count() > 0
					&& active_count < max_shared_active_layers;
		}

		/* Unrecognized action keys remain disabled */
		return false;
	}

	/// @description Handle layer-panel dragging, scrolling, local view changes, selection and structural requests
	/// @returns {Bool} Whether the panel captured this input pass
	handle_layers_panel_input = function()
	{
		layers_panel_hover = "";
		toolbar_hover = "";

		/* Check whether an active vote requires the layer panel to remain visible as
		contextual preview */
		var vote_preview_visible = layer_vote_preview_active();

		/* With drawing disabled or the toolbar hidden, capture nothing unless a vote needs
		that panel preview */
		if ((!draw_mode_enabled || toolbar_hidden) && !vote_preview_visible)
		{
			layers_panel_dragging = false;
			return false;
		}

		/* A vote-only panel remains visible but restricts input to inspection and panel
		movement */
		var vote_preview_read_only = vote_preview_visible
			&& (!draw_mode_enabled || toolbar_hidden);

		ensure_default_layers();

		/* Read horizontal GUI mouse position for panel hit testing and dragging */
		var mx = device_mouse_x_to_gui(0);

		/* Read vertical GUI mouse position for the same interactions */
		var my = device_mouse_y_to_gui(0);

		/* Continue a panel drag before ordinary row and button hit testing */
		if (layers_panel_dragging)
		{
			/* Holding the left button moves the panel by its stored pointer offsets */
			if (mouse_check_button(mb_left))
			{
				layers_panel_x = mx - layers_panel_drag_offset_x;
				layers_panel_y = my - layers_panel_drag_offset_y;

				/* Use a positive GUI width when clipping the dragged panel */
				var gui_w = max(1, display_get_gui_width());

				/* Use a positive GUI height when clipping its vertical position */
				var gui_h = max(1, display_get_gui_height());
				layers_panel_x = clamp(layers_panel_x, 0, max(0, gui_w - layers_panel_width));
				layers_panel_y = clamp(layers_panel_y, 0, max(0, gui_h - layers_panel_height));
				layers_panel_hover = "layer_panel_drag";
				return true;
			}

			layers_panel_dragging = false;
		}

		/* A pointer outside the panel leaves this input pass available to other controls */
		if (!point_in_rect(mx, my, layers_panel_x, layers_panel_y, layers_panel_x + layers_panel_width, layers_panel_y + layers_panel_height))
		{
			return false;
		}

		debug_last_toolbar_captured = true;

		/* Compute visible row capacity to limit wheel scrolling */
		var visible_rows = max(1, floor((layers_panel_height - layers_panel_header_height - 38) / layers_panel_row_height));

		/* Resolve the displayed layer indices for the current stack or preview */
		var panel_display_indices = active_layer_display_indices();

		/* The last legal scroll offset leaves a full visible row window where possible */
		var max_scroll = max(0, array_length(panel_display_indices) - visible_rows);

		/* Wheel Up shifts the view toward higher displayed stack positions */
		if (mouse_wheel_up())
		{
			layers_panel_scroll = max(0, layers_panel_scroll - 1);
			return true;
		}

		/* Wheel Down shifts it toward the final permitted scroll offset */
		if (mouse_wheel_down())
		{
			layers_panel_scroll = min(max_scroll, layers_panel_scroll + 1);
			return true;
		}

		/* Disable footer action hit testing in vote-only read-only mode */
		var button_key = vote_preview_read_only ? "" : layer_panel_button_at(mx, my);

		/* Begin without a row hit until the pointer is checked against the list */
		var row_index = noone;

		/* A footer hit supplies its action hover key directly */
		if (button_key != "")
		{
			layers_panel_hover = button_key;
		}

		/* Otherwise inspect the row list and then the header */
		else
		{
			row_index = layer_row_index_at(mx, my);

			/* A valid row can provide visibility, selection or vote-context hover */
			if (row_index != noone)
			{
				/* Read-only vote preview distinguishes its target layer from surrounding
				context */
				if (vote_preview_read_only)
				{
					/* Use a target hover label only for the voted stable layer, otherwise the
					context label */
					layers_panel_hover = layers[row_index].id == client_layer_vote.layer_id
						? "layer_vote_target"
						: "layer_vote_context";
				}

				/* Normal rows separate the visibility control from the layer-selection area */
				else
				{
					/* Position the row's visibility hit area beside its left inset */
					var visibility_x = layers_panel_x + 14;

					/* Convert its array index to the current scrolled display row */
					var display_row = layer_display_row_from_index(row_index);

					/* Locate the row's GUI top using that display position */
					var row_top = layers_panel_y + layers_panel_header_height + 4 + display_row * layers_panel_row_height;

					/* The small visibility rectangle receives its own stable-layer hover key */
					if (point_in_rect(mx, my, visibility_x - 6, row_top + 5, visibility_x + 16, row_top + 24))
					{
						layers_panel_hover = "layer_visible_" + string(layers[row_index].id);
					}

					/* The remaining row area receives the stable layer-selection hover key */
					else
					{
						layers_panel_hover = "layer_row_" + string(layers[row_index].id);
					}
				}
			}

			/* A header hit outside list rows offers panel dragging */
			else if (point_in_rect(mx, my, layers_panel_x, layers_panel_y, layers_panel_x + layers_panel_width, layers_panel_y + layers_panel_header_height))
			{
				layers_panel_hover = "layer_panel_header";
			}
		}

		/* A fresh panel left click cancels any world drawing gesture before dispatching the
		chosen control */
		if (mouse_check_button_pressed(mb_left))
		{
			is_drawing = false;
			sent_drag_command = false;
			end_local_undo_group();

			/* Read-only vote context allows highlighting its target or dragging its header */
			if (vote_preview_read_only)
			{
				/* Clicking the voted layer highlights it without changing layer selection or
				visibility */
				if (row_index != noone
				&& layers[row_index].id == client_layer_vote.layer_id)
				{
					trigger_layer_blink(client_layer_vote.layer_id);
				}

				/* Its header begins panel dragging and records pointer-to-panel offsets */
				else if (layers_panel_hover == "layer_panel_header")
				{
					layers_panel_dragging = true;
					layers_panel_drag_offset_x = mx - layers_panel_x;
					layers_panel_drag_offset_y = my - layers_panel_y;
				}
			}

			/* Disabled footer actions show unavailable feedback before any operation is
			submitted */
			else if (button_key != "" && !layer_panel_button_enabled(button_key))
			{
				set_screenshot_status("That layer action is not available right now.", make_color_rgb(255, 220, 95));
			}

			/* Add requests a new paint layer */
			else if (button_key == "layer_add")
			{
				/* Clear selection only when the Add request was accepted */
				if (add_paint_layer())
				{
					clear_selection();
				}
			}

			/* Duplicate requests a copy of the selected layer */
			else if (button_key == "layer_duplicate")
			{
				/* Clear selection only when the Duplicate request was accepted */
				if (duplicate_active_layer())
				{
					clear_selection();
				}
			}

			/* Move Down adjusts the local preview by one active-stack position */
			else if (button_key == "layer_down")
			{
				move_active_layer(-1);
			}

			/* Move Up adjusts the local preview in the opposite direction */
			else if (button_key == "layer_up")
			{
				move_active_layer(1);
			}

			/* Cancel Move discards an unsubmitted order preview */
			else if (button_key == "layer_move_cancel")
			{
				cancel_layer_move_draft();
			}

			/* Apply Move sends the previewed order for authority */
			else if (button_key == "layer_move_apply")
			{
				apply_layer_move_draft();
			}

			/* Archive requests removal from the active stack */
			else if (button_key == "layer_archive")
			{
				archive_active_layer();
			}

			/* Restore requests the latest archived layer's return */
			else if (button_key == "layer_restore")
			{
				restore_latest_archived_layer();
			}

			/* A visibility hover key identifies the stable layer whose local view state may
			change */
			else if (string_copy(layers_panel_hover, 1, 14) == "layer_visible_")
			{
				/* Extract the numeric stable ID from the visibility hover suffix */
				var visible_id = real(string_copy(layers_panel_hover, 15, string_length(layers_panel_hover) - 14));

				/* Resolve that identity to the current layer-array position */
				var visible_index = layer_index_from_id(visible_id);

				/* An archived row only highlights its layer instead of toggling local
				visibility */
				if (visible_index != noone && layer_is_archived(layers[visible_index]))
				{
					trigger_layer_blink(visible_id);
				}

				/* Other visibility hits toggle the resolved layer's local view preference */
				else
				{
					toggle_layer_visibility(visible_id);
				}
			}

			/* Remaining clicks target layer selection or the draggable panel header */
			else
			{
				/* Resolve the clicked list row again for this selection action */
				var clicked_index = layer_row_index_at(mx, my);

				/* A valid layer row can be highlighted or selected */
				if (clicked_index != noone)
				{
					/* Archived rows receive a highlight while remaining unavailable as active
					drawing targets */
					if (layer_is_archived(layers[clicked_index]))
					{
						trigger_layer_blink(layers[clicked_index].id);
					}

					/* Unarchived rows can become the active drawing layer */
					else
					{
						/* Cancel an existing move preview before selecting a different stack
						context */
						if (layer_move_draft_active)
						{
							cancel_layer_move_draft();
						}

						/* Changing active layer discards selected pixels and their preview
						resources */
						if (active_layer_id != layers[clicked_index].id)
						{
							clear_selection();
						}
						active_layer_id = layers[clicked_index].id;
						trigger_layer_blink(active_layer_id);
					}
				}

				/* A header hit without a row begins dragging and captures both GUI offsets */
				else if (layers_panel_hover == "layer_panel_header")
				{
					layers_panel_dragging = true;
					layers_panel_drag_offset_x = mx - layers_panel_x;
					layers_panel_drag_offset_y = my - layers_panel_y;
				}
			}
		}

		return true;
	}

	/// @description Convert horizontal GUI pointer position to a stored HSV slider byte
	/// @param {Real} mx Horizontal GUI pointer position
	/// @returns {Real} Clipped integer value from zero to 255
	hsv_slider_value_from_mouse = function(mx)
	{
		return clamp(round((mx - hsv_slider_x) / max(1, hsv_slider_width) * 255), 0, 255);
	}

	/// @description Apply a pointer-driven HSV byte to its recognized channel and refresh brush RGB
	/// @param {String} slider_key hue, saturation or value channel name
	/// @param {Real} mx Horizontal GUI pointer position
	/// @returns {Bool} Whether the slider channel was recognized
	update_hsv_slider_from_mouse = function(slider_key, mx)
	{
		/* Convert pointer x along the HSV slider to its clipped zero-to-255 storage value */
		var value = hsv_slider_value_from_mouse(mx);

		/* Route this drag to the selected HSV channel */
		switch (slider_key)
		{
			/* Hue dragging updates the stored hue byte */
			case "hue":
				hue_value = value;
				break;

			/* Saturation dragging updates the stored chromatic byte */
			case "saturation":
				saturation_value = value;
				break;

			/* Value dragging updates the stored brightness byte */
			case "value":
				value_value = value;
				break;

			/* An unknown channel rejects the drag instead of changing brush color */
			default:
				return false;
		}

		set_brush_from_hsv();
		return true;
	}
	#endregion /* Toolbar Layout and Layer Panel Input END */

	#region /* Client Layer Vote Input and UI */
	/// @description Close contextual layer preview, optionally restore saved scroll and refresh local canvas view
	/// @param {Bool} restore_scroll Whether to restore the original panel scroll retained by this preview. Defaults to true
	/// @returns {Bool} Whether the vote had an active preview
	close_layer_vote_preview = function(restore_scroll = true)
	{
		/* Without a vote struct there is no contextual layer preview to close */
		if (!is_struct(client_layer_vote))
		{
			return false;
		}

		/* Remember whether the vote had a visible preview before clearing its preview flags */
		var was_previewing = variable_struct_exists(client_layer_vote, "preview")
			&& client_layer_vote.preview;

		/* Restore prior panel scroll only on request and when this vote retained a valid saved
		scroll field */
		if (restore_scroll
		&& variable_struct_exists(client_layer_vote, "preview_scroll_saved")
		&& client_layer_vote.preview_scroll_saved
		&& variable_struct_exists(client_layer_vote, "saved_panel_scroll"))
		{
			layers_panel_scroll = max(0, floor(real(client_layer_vote.saved_panel_scroll)));
		}
		client_layer_vote.preview = false;
		client_layer_vote.preview_scroll_saved = false;

		/* Clear a target-layer blink only when it belongs to the vote being closed */
		if (layer_blink_layer_id == client_layer_vote.layer_id)
		{
			layer_blink_layer_id = 0;
		}

		/* A formerly visible preview invalidates the composite so ordinary local layer view
		can return */
		if (was_previewing)
		{
			layer_composite_dirty = true;

			/* Refresh that restored view immediately outside an enclosing rebuild */
			if (!layer_surface_rebuild_active)
			{
				composite_layers();
			}
		}

		/* Report whether a visible vote preview was actually closed */
		return was_previewing;
	}

	/// @description Save original scroll once, reveal and highlight the target layer and render contextual proposal view
	/// @returns {Bool} Whether an active vote was focused
	focus_layer_vote_preview = function()
	{
		/* Focusing vote context requires an active vote struct */
		if (!is_struct(client_layer_vote))
		{
			return false;
		}

		/* Save panel scroll only on the first preview focus so repeated focus does not
		overwrite the original view */
		if (!variable_struct_exists(client_layer_vote, "preview_scroll_saved")
		|| !client_layer_vote.preview_scroll_saved)
		{
			/* The vote owns saved_panel_scroll and preview_scroll_saved until its preview
			closes or the proposal is replaced */
			client_layer_vote.saved_panel_scroll = layers_panel_scroll;
			client_layer_vote.preview_scroll_saved = true;
		}

		client_layer_vote.preview = true;

		/* Use a positive GUI width to keep the contextual layer panel on screen */
		var gui_w = max(1, display_get_gui_width());

		/* Use a positive GUI height for its vertical clipping */
		var gui_h = max(1, display_get_gui_height());
		layers_panel_x = clamp(layers_panel_x, 0, max(0, gui_w - layers_panel_width));
		layers_panel_y = clamp(layers_panel_y, 0, max(0, gui_h - layers_panel_height));
		layers_panel_scroll_to_layer(client_layer_vote.layer_id);
		trigger_layer_blink(client_layer_vote.layer_id);
		layer_composite_dirty = true;

		/* Composite the focused proposal immediately only when an enclosing rebuild is not
		active */
		if (!layer_surface_rebuild_active)
		{
			composite_layers();
		}
		return true;
	}

	/// @description Read proposal state or result packets and update preview, voter masks and feedback
	/// @returns {Bool} Whether the packet subtype was handled
	receive_layer_vote_packet = function()
	{
		/* Read the vote packet subtype from the active network body before interpreting its
		fields */
		var packet_kind = net.read(buffer_u8);

		/* A state packet replaces or refreshes the current proposal, voter masks and remaining
		deadline */
		if (packet_kind == LAYER_VOTE_PACKET_STATE)
		{
			/* Read the unsigned proposal identity used to distinguish refreshes from new votes */
			var proposal_id = net.read(buffer_u32);

			/* Read the archive, restore or move action enum */
			var action = net.read(buffer_u8);

			/* Read the target's stable layer ID */
			var layer_id = net.read(buffer_u32);

			/* Read the signed target stack index for the proposed structural change */
			var target_index = net.read(buffer_s16);

			/* Read the requesting player's network slot with the project's ID format */
			var requester_slot = net.read(TYPE_ID);

			/* Read the requester name displayed in the vote explanation */
			var requester_name = net.read(buffer_string);

			/* Read the target layer name shown to voters */
			var layer_name = net.read(buffer_string);

			/* Read milliseconds remaining so the client can establish a local display deadline */
			var remaining_ms = net.read(buffer_u32);

			/* Read the sixteen-slot eligible-voter bit mask */
			var eligible_mask = net.read(buffer_u16);

			/* Read the mask of recorded approvals */
			var yes_mask = net.read(buffer_u16);

			/* Read the mask of recorded Keep choices */
			var no_mask = net.read(buffer_u16);

			/* Read the fixed approval threshold for this proposal */
			var required = net.read(buffer_u8);

			/* A matching proposal identity allows its local preview preferences to survive
			this state refresh */
			var same_vote = is_struct(client_layer_vote)
				&& client_layer_vote.id == proposal_id;

			/* Preserve preview visibility only when refreshing the same proposal with its
			preview enabled */
			var preserve_preview = same_vote
				&& variable_struct_exists(client_layer_vote, "preview")
				&& client_layer_vote.preview;

			/* Preserve saved-scroll ownership only when the same proposal already saved it */
			var preserve_scroll_saved = same_vote
				&& variable_struct_exists(client_layer_vote, "preview_scroll_saved")
				&& client_layer_vote.preview_scroll_saved;

			/* Use that proposal's saved scroll when available, otherwise the current panel
			scroll */
			var preserve_saved_scroll = preserve_scroll_saved
				&& variable_struct_exists(client_layer_vote, "saved_panel_scroll")
				? client_layer_vote.saved_panel_scroll
				: layers_panel_scroll;

			/* A different active proposal must close its prior preview before replacing the
			vote state */
			if (is_struct(client_layer_vote) && !same_vote)
			{
				close_layer_vote_preview(true);
			}

			/* A newly received move requested by this player opens its proposed order preview
			by default */
			var default_preview = !same_vote
				&& action == LAYER_VOTE_ACTION_MOVE
				&& requester_slot == local_player_id;

			/* The proposal retains packet identity, action, layer and target index,
			requester/name text, a millisecond deadline, voter masks and threshold, plus
			local preview and input state */
			client_layer_vote =
			{
				id: proposal_id,
				action: action,
				layer_id: layer_id,
				target_index: target_index,
				requester_slot: requester_slot,
				requester_name: requester_name,
				layer_name: layer_name,
				deadline: current_time + remaining_ms,
				eligible_mask: eligible_mask,
				yes_mask: yes_mask,
				no_mask: no_mask,
				required: required,

				/* Keep an existing preview or open this player's new move preview */
				preview: preserve_preview || default_preview,

				/* Retain existing saved scroll or mark the new default preview's current
				scroll as saved */
				preview_scroll_saved: preserve_scroll_saved || default_preview,

				/* Use the retained scroll for a refresh, otherwise snapshot the current panel
				scroll for this proposal */
				saved_panel_scroll: preserve_scroll_saved ? preserve_saved_scroll : layers_panel_scroll,

				/* Start this refreshed proposal without an internal mouse-capture flag */
				mouse_capture: false
			};

			/* A proposal state supersedes the optimistic local move draft and unlocks its
			submitted flag */
			if (layer_move_draft_active)
			{
				layer_move_draft_active = false;
				layer_move_draft_submitted = false;
			}

			/* A default move preview focuses and blinks the requested layer */
			if (default_preview)
			{
				focus_layer_vote_preview();
			}

			/* Other state refreshes invalidate the composite while retaining the established
			local preview choice */
			else
			{
				layer_composite_dirty = true;

				/* Render the refreshed preview immediately outside an enclosing rebuild */
				if (!layer_surface_rebuild_active)
				{
					composite_layers();
				}
			}
			return true;
		}

		/* A result packet supplies the proposal outcome and a server-authored feedback message */
		if (packet_kind == LAYER_VOTE_PACKET_RESULT)
		{
			/* Read the completed proposal ID, with zero reserved for a request result without
			an open vote */
			var proposal_id = net.read(buffer_u32);

			/* Read the approved, rejected or error result enum for feedback color */
			var result_code = net.read(buffer_u8);

			/* Read the server's result explanation text */
			var message = net.read(buffer_string);

			/* Close and remove only the currently displayed proposal whose positive ID matches
			the result */
			if (proposal_id > 0
			&& is_struct(client_layer_vote)
			&& client_layer_vote.id == proposal_id)
			{
				close_layer_vote_preview(true);
				client_layer_vote = noone;
				layer_vote_hover = "";
				layer_composite_dirty = true;

				/* Refresh the ordinary canvas after removing vote preview when no outer
				rebuild owns rendering */
				if (!layer_surface_rebuild_active)
				{
					composite_layers();
				}
			}

			/* A zero-ID result resolves a submitted local move draft that never opened a
			matching proposal */
			else if (proposal_id == 0 && layer_move_draft_submitted)
			{
				layer_move_draft_active = false;
				layer_move_draft_submitted = false;
				layer_composite_dirty = true;

				/* Refresh that cancelled or resolved draft's ordinary layer order outside
				rebuild mode */
				if (!layer_surface_rebuild_active)
				{
					composite_layers();
				}
			}

			/* Approved results use green, rejected choices use yellow, and other result codes
			use red */
			var result_colour = result_code == LAYER_VOTE_RESULT_APPROVED
				? make_color_rgb(94, 215, 122)
				: (result_code == LAYER_VOTE_RESULT_REJECTED
					? make_color_rgb(255, 220, 95)
					: make_color_rgb(244, 84, 84));
			set_screenshot_status(message, result_colour);
			return true;
		}

		/* Other packet subtypes are not handled by this client vote reader */
		return false;
	}

	/// @description Send this proposal's Approve or Keep choice through the online client transport
	/// @param {Bool} approve True to Approve, false to Keep the existing shared state
	/// @returns {Bool} Whether the transport accepted the vote packet
	send_layer_vote_cast = function(approve)
	{
		/* Casting requires a displayed active proposal */
		if (!is_struct(client_layer_vote))
		{
			return false;
		}

		/* Borrow client identity and socket state for this vote response */
		var client = scr_get_client();

		/* A missing client, assigned ID or usable socket prevents sending a vote */
		if (!is_struct(client)
		|| !variable_struct_exists(client, "ID")
		|| client.ID == noone
		|| !variable_struct_exists(client, "socket")
		|| !is_real(client.socket)
		|| client.socket < 0)
		{
			return false;
		}
		net.start(N_LAYER_VOTE, client.ID);
		net.write(buffer_u8, LAYER_VOTE_PACKET_CAST);
		net.write(buffer_u32, client_layer_vote.id);

		/* Encode approval as byte one and Keep as byte zero */
		net.write(buffer_u8, approve ? 1 : 0);

		/* Retain the transport result before reporting whether the vote could reach the server */
		var send_result = net.send_server();

		/* A negative write reports failed delivery without changing the server-owned recorded
		vote masks */
		if (send_result < 0)
		{
			set_screenshot_status("Your layer vote could not reach the server.", make_color_rgb(244, 84, 84));
			return false;
		}
		return true;
	}

	/// @description Resolve the local player to one of the protocol's sixteen voter bits
	/// @returns {Real} Single-bit mask or zero for an unrepresentable identity
	layer_vote_local_bit = function()
	{
		refresh_local_identity_from_client();

		/* A nonnumeric player identity has no slot in the sixteen-bit voter masks */
		if (!is_real(local_player_id))
		{
			return 0;
		}

		/* Convert the refreshed local player identity to an integer slot */
		var slot = floor(real(local_player_id));

		/* Only slots zero through fifteen have a representable vote bit */
		if (slot < 0 || slot >= 16)
		{
			return 0;
		}
		return 1 << slot;
	}

	/// @description Check the local player's bit against the proposal's fixed eligible mask
	/// @returns {Bool} Whether this player can vote on the proposal
	layer_vote_local_is_eligible = function()
	{
		/* Without a proposal there is no eligibility decision to read */
		if (!is_struct(client_layer_vote))
		{
			return false;
		}

		/* Resolve this player to its single sixteen-slot mask bit */
		var bit = layer_vote_local_bit();

		/* Eligibility requires a representable local bit present in the proposal's eligible
		mask */
		return bit != 0 && (client_layer_vote.eligible_mask & bit) != 0;
	}

	/// @description Read this player's server-recorded choice from the proposal masks
	/// @returns {Real} 1 for approval, 0 for Keep, or -1 for no recorded choice
	layer_vote_local_choice = function()
	{
		/* Without a displayed proposal there is no recorded local choice */
		if (!is_struct(client_layer_vote))
		{
			return -1;
		}

		/* Resolve the current player's bit before inspecting yes and no masks */
		var bit = layer_vote_local_bit();

		/* A player outside the mask range has no recorded choice */
		if (bit == 0)
		{
			return -1;
		}

		/* An approval bit takes precedence and returns choice one */
		if ((client_layer_vote.yes_mask & bit) != 0)
		{
			return 1;
		}

		/* A Keep bit returns choice zero */
		if ((client_layer_vote.no_mask & bit) != 0)
		{
			return 0;
		}

		/* Neither mask contains this player, so the choice remains pending at -1 */
		return -1;
	}

	/// @description Count set bits in the protocol's first sixteen voter slots
	/// @param {Real} mask Sixteen-bit voter mask
	/// @returns {Real} Count from zero to sixteen
	layer_vote_mask_count = function(mask)
	{
		/* Start with zero present mask bits before counting eligible slots */
		var count = 0;

		/* Inspect all sixteen protocol voter positions with a zero-based slot index */
		for (var slot = 0; slot < 16; slot++)
		{
			/* Count a slot only when its corresponding mask bit is set */
			if ((mask & (1 << slot)) != 0)
			{
				count++;
			}
		}
		return count;
	}

	/// @description Build action-specific human-readable proposal title and explanation
	/// @returns {Struct} title and body fields, empty without an active vote
	layer_vote_copy = function()
	{
		/* Without a proposal, title and body text are both empty */
		if (!is_struct(client_layer_vote))
		{
			return { title: "", body: "" };
		}

		/* Trim the requester name before using it in the human-readable proposal explanation */
		var requester = string_trim(string(client_layer_vote.requester_name));

		/* A blank requester name uses the neutral A player fallback */
		if (requester == "")
		{
			requester = "A player";
		}

		/* Clean the target layer name with this layer as the missing-name fallback */
		var layer_name = layer_name_clean(client_layer_vote.layer_name, "this layer");

		/* Choose copy that explains the requested structural action and its preview effect */
		switch (client_layer_vote.action)
		{
			/* Archive returns a title naming the requester and layer, plus a body explaining
			nondestructive shared hiding */
			case LAYER_VOTE_ACTION_ARCHIVE:
				return
				{
					title: requester + " wants to archive \"" + layer_name + "\"",
					body: "Archive hides this layer for everyone without destroying it. Show Layers highlights and flashes the exact target."
				};

			/* Restore returns a title naming the layer's return, plus a body describing the
			contextual preview */
			case LAYER_VOTE_ACTION_RESTORE:
				return
				{
					title: requester + " wants to restore \"" + layer_name + "\"",
					body: "Restore returns this archived layer. Show Layers previews it and marks the read-only vote target."
				};

			/* Other actions use the move-order title and explanation body */
			default:
				return
				{
					title: requester + " wants to change the shared layer order",
					body: "Show Layers previews the proposed shared order and highlights the moved layer; only Approve publishes it."
				};
		}
	}

	/// @description Build a centered top-of-GUI banner and its three action rectangles
	/// @returns {Struct} Banner edges and keep/view/approve buttons, or noone without a vote
	layer_vote_rect = function()
	{
		/* The vote dialog has no rectangle without an active proposal */
		if (!is_struct(client_layer_vote))
		{
			return noone;
		}

		/* Read a positive GUI width to size and horizontally center the banner */
		var gui_w = max(1, display_get_gui_width());

		/* Limit the banner to 640 GUI pixels while keeping its minimum width at eighty */
		var vote_w = max(80, min(640, gui_w - 16));

		/* Use a fixed 132-GUI-pixel height for copy, progress and buttons */
		var vote_h = 132;

		/* Center horizontally when it fits, otherwise start at GUI x zero */
		var vote_x = max(0, (gui_w - vote_w) * 0.5);

		/* Inset the banner eight GUI pixels from the top */
		var vote_y = 8;

		/* Reserve twelve GUI pixels of horizontal padding on both sides */
		var inner_w = max(24, vote_w - 24);

		/* Separate its three action buttons by eight GUI pixels */
		var gap = 8;

		/* Divide the usable action row into three buttons with a minimum eight-GUI-pixel width */
		var button_w = max(8, (inner_w - gap * 2) / 3);

		/* Place the button row above the banner's lower inset */
		var button_y = vote_y + vote_h - 38;

		/* Return inclusive banner edges and separate keep, view and approve x/y/w/h GUI button
		rectangles */
		return
		{
			left: vote_x,
			top: vote_y,
			right: vote_x + vote_w,
			bottom: vote_y + vote_h,
			keep: { x: vote_x + 12, y: button_y, w: button_w, h: 28 },
			view: { x: vote_x + 12 + button_w + gap, y: button_y, w: button_w, h: 28 },
			approve: { x: vote_x + 12 + (button_w + gap) * 2, y: button_y, w: button_w, h: 28 }
		};
	}

	/// @description Hit-test the three vote action rectangles in GUI coordinates
	/// @param {Real} mx Horizontal GUI pointer position
	/// @param {Real} my Vertical GUI pointer position
	/// @param {Struct} rect GUI banner or button geometry with its required edge or x/y/w/h fields
	/// @returns {String} keep, view, approve or empty outside their rectangles
	layer_vote_button_at = function(mx, my, rect)
	{
		/* Hit testing requires a vote rectangle struct */
		if (!is_struct(rect))
		{
			return "";
		}

		/* The first action rectangle maps to the Keep choice */
		if (point_in_rect(mx, my, rect.keep.x, rect.keep.y, rect.keep.x + rect.keep.w, rect.keep.y + rect.keep.h))
		{
			return "keep";
		}

		/* The middle rectangle maps to the contextual layer preview toggle */
		if (point_in_rect(mx, my, rect.view.x, rect.view.y, rect.view.x + rect.view.w, rect.view.y + rect.view.h))
		{
			return "view";
		}

		/* The final rectangle maps to Approve */
		if (point_in_rect(mx, my, rect.approve.x, rect.approve.y, rect.approve.x + rect.approve.w, rect.approve.y + rect.approve.h))
		{
			return "approve";
		}

		/* A pointer outside these action rectangles has no button key */
		return "";
	}

	/// @description Capture banner clicks through release and submit eligible votes or toggle contextual layer preview
	/// @returns {Bool} Whether vote UI captured this input pass
	handle_layer_vote_input = function()
	{
		/* Without an active proposal, clear vote hover and click capture and release this
		input pass */
		if (!is_struct(client_layer_vote))
		{
			layer_vote_hover = "";
			layer_vote_mouse_capture = false;
			return false;
		}

		/* A held vote click continues capturing input so dragging out cannot begin a world
		drawing gesture */
		if (layer_vote_mouse_capture)
		{
			is_drawing = false;
			sent_drag_command = false;
			end_local_undo_group();

			/* Release capture after the left mouse button is no longer held */
			if (!mouse_check_button(mb_left))
			{
				layer_vote_mouse_capture = false;
			}
			return true;
		}

		/* Resolve the current GUI banner and its button hit rectangles */
		var rect = layer_vote_rect();

		/* Without a valid banner rectangle this handler captures no input */
		if (!is_struct(rect))
		{
			return false;
		}

		/* Read the pointer's GUI x for banner hit testing */
		var mx = device_mouse_x_to_gui(0);

		/* Read its GUI y in the same coordinate system */
		var my = device_mouse_y_to_gui(0);

		/* A pointer outside the banner clears hover and leaves input to other controls */
		if (!point_in_rect(mx, my, rect.left, rect.top, rect.right, rect.bottom))
		{
			layer_vote_hover = "";
			return false;
		}

		debug_last_toolbar_captured = true;
		is_drawing = false;
		sent_drag_command = false;
		end_local_undo_group();
		layer_vote_hover = layer_vote_button_at(mx, my, rect);

		/* Hovering the banner captures input, while casting or preview toggling waits for a
		fresh left click */
		if (!mouse_check_button_pressed(mb_left))
		{
			return true;
		}

		layer_vote_mouse_capture = true;

		/* An eligible Keep click sends the negative vote choice */
		if (layer_vote_hover == "keep" && layer_vote_local_is_eligible())
		{
			send_layer_vote_cast(false);
		}

		/* An eligible Approve click sends the positive vote choice */
		else if (layer_vote_hover == "approve" && layer_vote_local_is_eligible())
		{
			send_layer_vote_cast(true);
		}

		/* The View button toggles contextual inspection even for players who are watching
		rather than voting */
		else if (layer_vote_hover == "view")
		{
			/* An open preview closes and restores its saved panel scroll */
			if (client_layer_vote.preview)
			{
				close_layer_vote_preview(true);
			}

			/* A closed preview opens, scrolls to and highlights the target layer */
			else
			{
				focus_layer_vote_preview();
			}
		}
		return true;
	}

	/// @description Render a vote button's enabled, selected and hovered appearance with centered label
	/// @param {Struct} rect GUI banner or button geometry with its required edge or x/y/w/h fields
	/// @param {String} label Displayed button label
	/// @param {Bool} enabled Whether the button is available for this player
	/// @param {Bool} selected Whether this button represents the current recorded choice or preview state
	/// @param {Bool} hovered Whether the pointer is over this button
	draw_layer_vote_button = function(rect, label, enabled, selected, hovered)
	{
		/* Enabled buttons use selected green, hovered gray or ordinary gray fills, while
		disabled buttons use a darker fill */
		var fill = enabled
			? (selected ? make_color_rgb(70, 116, 82) : (hovered ? make_color_rgb(78, 82, 88) : make_color_rgb(54, 57, 62)))
			: make_color_rgb(34, 36, 40);

		/* Selected buttons use a green border, enabled hovered buttons use yellow, and others
		use the neutral border */
		var border = selected
			? make_color_rgb(94, 215, 122)
			: (hovered && enabled ? make_color_rgb(255, 220, 95) : make_color_rgb(112, 116, 124));
		draw_set_colour(fill);
		draw_rectangle(rect.x, rect.y, rect.x + rect.w, rect.y + rect.h, false);
		draw_set_colour(border);
		draw_rectangle(rect.x, rect.y, rect.x + rect.w, rect.y + rect.h, true);
		draw_set_halign(fa_center);

		/* Enabled button labels are white while disabled labels are muted */
		draw_set_colour(enabled ? c_white : make_color_rgb(132, 134, 138));
		scr_render_text(rect.x + rect.w * 0.5, rect.y + 6, label, 15, rect.w - 6);
		draw_set_halign(fa_left);
	}

	/// @description Render active proposal copy, approval progress, remaining seconds and local action states
	/// @returns {Bool} Whether a vote banner was rendered
	draw_layer_vote_banner = function()
	{
		/* No active vote means there is no banner to render */
		if (!is_struct(client_layer_vote))
		{
			return false;
		}

		/* Resolve the banner's GUI geometry for this frame */
		var rect = layer_vote_rect();

		/* Skip rendering if its rectangle cannot be resolved */
		if (!is_struct(rect))
		{
			return false;
		}

		/* Resolve action-specific title and body text for the displayed proposal */
		var copy = layer_vote_copy();

		/* Count recorded approval bits for the progress display */
		var yes_count = layer_vote_mask_count(client_layer_vote.yes_mask);

		/* Convert the remaining millisecond deadline to nonnegative rounded-up display seconds */
		var seconds_left = max(0, ceil((client_layer_vote.deadline - current_time) / 1000));

		/* Keep whether this player belongs to the fixed eligible voter mask */
		var eligible = layer_vote_local_is_eligible();

		/* Read the recorded local choice as approval one, Keep zero or pending -1 */
		var local_choice = layer_vote_local_choice();

		/* Keep the local layer-preview state for the View button's text and selection */
		var previewing = client_layer_vote.preview;

		draw_set_alpha(0.95);
		draw_set_colour(make_color_rgb(24, 26, 30));
		draw_rectangle(rect.left, rect.top, rect.right, rect.bottom, false);
		draw_set_alpha(1);
		draw_set_colour(make_color_rgb(255, 220, 95));
		draw_rectangle(rect.left, rect.top, rect.right, rect.bottom, true);
		draw_set_colour(c_white);
		draw_set_halign(fa_left);
		scr_render_text(rect.left + 12, rect.top + 9, copy.title, 18, rect.right - rect.left - 24);
		draw_set_colour(make_color_rgb(220, 220, 224));
		scr_render_text_wrapped(rect.left + 12, rect.top + 33, copy.body, 14, rect.right - rect.left - 24, 2);
		draw_set_colour(make_color_rgb(255, 220, 95));

		/* Build approval count, required threshold and remaining seconds for the progress line */
		var progress_text = "Approvals " + string(yes_count) + "/" + string(client_layer_vote.required)
			+ "  -  " + string(seconds_left) + "s remaining";

		/* Players outside the eligible mask see Watching only while retaining preview access */
		if (!eligible)
		{
			progress_text += "  -  Watching only";
		}
		scr_render_text(rect.left + 12, rect.bottom - 58, progress_text, 14, rect.right - rect.left - 24);

		/* Enable Keep only for eligible players and mark it selected only for a recorded zero
		choice */
		draw_layer_vote_button(rect.keep, "Keep", eligible, local_choice == 0, layer_vote_hover == "keep");

		/* The always-enabled View button says Close View while previewing and Show Layers
		otherwise */
		draw_layer_vote_button(rect.view, previewing ? "Close View" : "Show Layers", true, previewing, layer_vote_hover == "view");

		/* Enable Approve only for eligible players and mark it selected only for a recorded
		one choice */
		draw_layer_vote_button(rect.approve, "Approve", eligible, local_choice == 1, layer_vote_hover == "approve");
		draw_set_alpha(1);
		draw_set_halign(fa_left);
		return true;
	}
	#endregion /* Client Layer Vote Input and UI END */

	#region /* Toolbar Input and Client Step */
	/// @description Show the changed hidden-toolbar drawing preference for eight seconds
	/// @param {Bool} enabled Whether drawing remains enabled with the toolbar hidden
	show_toolbar_mode_notice = function(enabled)
	{
		/* Remember the newly selected hidden-toolbar drawing preference and display its notice
		for eight seconds */
		toolbar_mode_notice_enabled = enabled;
		toolbar_mode_notice_until = current_time + 8000;
	}

	/// @description Capture pointer interaction over a visible mode notice and dismiss it on a fresh click
	/// @returns {Bool} Whether the notice captured this input pass
	handle_toolbar_mode_notice_input = function()
	{
		/* An expired or inapplicable mode notice has no input rectangle to capture */
		if (!toolbar_mode_notice_is_visible())
		{
			return false;
		}

		update_toolbar_layout();

		/* Resolve the notice's current GUI edges after updating toolbar geometry */
		var notice_rect = toolbar_mode_notice_rect();

		/* An unavailable notice rectangle leaves input to other controls */
		if (!is_struct(notice_rect))
		{
			return false;
		}

		/* Read GUI pointer x for notice hit testing */
		var mx = device_mouse_x_to_gui(0);

		/* Read GUI pointer y for the same hit test */
		var my = device_mouse_y_to_gui(0);

		/* A pointer outside the notice leaves this pass uncaptured */
		if (!point_in_rect(mx, my, notice_rect.left, notice_rect.top, notice_rect.right, notice_rect.bottom))
		{
			return false;
		}

		debug_last_toolbar_captured = true;
		toolbar_hover = "";
		layers_panel_hover = "";

		/* A fresh left click dismisses the notice by clearing its millisecond deadline */
		if (mouse_check_button_pressed(mb_left))
		{
			toolbar_mode_notice_until = 0;
			debug_note("toolbar mode notice dismissed", "");
		}

		/* A held or released notice click closes the current drawing gesture so dismissal
		cannot paint the world */
		if (mouse_check_button(mb_left) || mouse_check_button_released(mb_left))
		{
			is_drawing = false;
			sent_drag_command = false;
			end_local_undo_group();
		}
		return true;
	}

	/// @description Collapse drawing controls, commit numeric editors and apply the requested drawing mode
	/// @param {Bool} keep_drawing Whether collapsing retains world drawing input
	/// @returns {Bool} True after toolbar state is updated
	hide_toolbar_panel = function(keep_drawing)
	{
		/* Collapse the toolbar, apply the requested drawing mode and stop panel or slider
		dragging */
		toolbar_hidden = true;
		draw_mode_enabled = keep_drawing;
		toolbar_active_slider = "";
		toolbar_dragging = false;
		layers_panel_dragging = false;

		/* Disabling drawing while hiding also clears selection and preview resources */
		if (!draw_mode_enabled)
		{
			clear_selection();
		}

		/* Commit a pending HSV numeric edit before hiding its controls */
		if (hsv_input_active != "")
		{
			commit_hsv_input();
		}

		/* Commit a pending brush-width edit before hiding its field */
		if (brush_input_active)
		{
			commit_brush_input();
		}
		update_toolbar_layout();
		toolbar_hover = "";

		/* Describe whether collapsing kept drawing active according to the requested mode */
		debug_note("toolbar hidden", keep_drawing ? "drawing kept active" : "drawing disabled");
		return true;
	}

	/// @description Handle toolbar panel dragging, sliders, hover targets and click or wheel action dispatch
	/// @returns {Bool} Whether the toolbar captured this input pass
	handle_toolbar_input = function()
	{
		update_toolbar_layout();
		toolbar_hover = "";
		debug_last_toolbar_captured = false;

		/* An inactive client session cannot use drawing toolbar controls */
		if (!is_active_client_session())
		{
			is_drawing = false;
			debug_note("toolbar skipped", "inactive client session");
			return false;
		}

		/* Read GUI mouse x for toolbar control and drag hit testing */
		var mx = device_mouse_x_to_gui(0);

		/* Read GUI mouse y in the same coordinate system */
		var my = device_mouse_y_to_gui(0);
		debug_last_mouse_gui_x = mx;
		debug_last_mouse_gui_y = my;

		/* Continue an existing toolbar panel drag before checking new controls */
		if (toolbar_dragging)
		{
			debug_last_toolbar_captured = true;

			/* While held, update panel position from the saved pointer offsets and recompute
			its clamped child geometry */
			if (mouse_check_button(mb_left))
			{
				toolbar_x = mx - toolbar_drag_offset_x;
				toolbar_y = my - toolbar_drag_offset_y;
				update_toolbar_layout();
				toolbar_hover = "panel_drag";
				return true;
			}

			toolbar_dragging = false;
		}

		/* An active slider retains input ownership until its mouse gesture ends */
		if (toolbar_active_slider != "")
		{
			/* Keep the slider key before updating or clearing its active state */
			var active_slider_key = toolbar_active_slider;
			debug_last_toolbar_captured = true;

			/* A held slider updates its value from the pointer and retains hover capture */
			if (mouse_check_button(mb_left))
			{
				update_toolbar_slider_from_mouse(active_slider_key, mx);
				toolbar_hover = active_slider_key;
				return true;
			}

			/* Ending canvas brightness dragging persists the local background preference */
			if (active_slider_key == "canvas_bg_brightness")
			{
				save_canvas_background_setting();
			}
			toolbar_active_slider = "";
		}

		/* A hidden toolbar exposes only its Show button */
		if (toolbar_hidden)
		{
			/* Keep whether the pointer lies inside that collapsed button */
			var in_show_button = point_in_rect(mx, my, draw_button_x, draw_button_y, draw_button_x + show_toolbar_button_width, draw_button_y + show_toolbar_button_height);

			/* A pointer elsewhere cannot interact with the collapsed toolbar */
			if (!in_show_button)
			{
				return false;
			}

			debug_last_toolbar_captured = true;
			toolbar_hover = "show_toolbar";

			/* A fresh Show click expands controls and enables drawing mode */
			if (mouse_check_button_pressed(mb_left))
			{
				toolbar_hidden = false;
				draw_mode_enabled = true;
				update_toolbar_layout();
				toolbar_hover = "";
				debug_note("toolbar shown", "");
			}

			return true;
		}

		/* Test the full expanded panel rectangle to decide whether it owns the pointer */
		var in_toolbar = point_in_rect(mx, my, toolbar_x, toolbar_y, toolbar_x + toolbar_width, toolbar_y + toolbar_height);

		/* A pointer outside the panel releases toolbar capture */
		if (!in_toolbar)
		{
			return false;
		}

		debug_last_toolbar_captured = true;

		/* The expanded Hide button receives its dedicated hover key */
		if (point_in_rect(mx, my, draw_button_x, draw_button_y, draw_button_x + draw_button_width, draw_button_y + draw_button_height))
		{
			toolbar_hover = "hide_toolbar";
		}

		/* Resolve ordinary controls only while the toolbar remains expanded */
		if (!toolbar_hidden)
		{
			/* Visit tool button rectangles in their configured order */
			for (var tool_index = 0; tool_index < array_length(tool_buttons); tool_index++)
			{
				/* Borrow this button's GUI geometry and hover identity */
				var tool_button = tool_buttons[tool_index];

				/* The first matching tool rectangle supplies its hover key and ends the
				tool-button search */
				if (point_in_rect(mx, my, tool_button.x, tool_button.y, tool_button.x + tool_button.w, tool_button.y + tool_button.h))
				{
					toolbar_hover = tool_button.key;
					break;
				}
			}

			/* The decrement button lowers brush width by one */
			if (point_in_rect(mx, my, width_minus_x, draw_button_y, width_minus_x + width_button_width, draw_button_y + draw_button_height))
			{
				toolbar_hover = "minus";
			}

			/* The width slider offers pointer-driven size changes */
			else if (point_in_rect(mx, my, brush_slider_x, brush_slider_y, brush_slider_x + brush_slider_width, brush_slider_y + brush_slider_height))
			{
				toolbar_hover = "brush_width";
			}

			/* The width numeric field offers keyboard entry */
			else if (brush_input_at(mx, my))
			{
				toolbar_hover = "brush_input";
			}

			/* The increment button raises brush width by one */
			else if (point_in_rect(mx, my, width_plus_x, draw_button_y, width_plus_x + width_button_width, draw_button_y + draw_button_height))
			{
				toolbar_hover = "plus";
			}

			/* The Fill tool's Current button selects boundaries from its active paint layer */
			else if (tool == DRAW_TOOL_FILL
			&& point_in_rect(mx, my, fill_current_button_x, fill_source_button_y, fill_current_button_x + fill_current_button_width, fill_source_button_y + draw_button_height))
			{
				toolbar_hover = "fill_current_layer";
			}

			/* Its Visible button selects boundaries from the visible layer composite */
			else if (tool == DRAW_TOOL_FILL
			&& point_in_rect(mx, my, fill_visible_button_x, fill_source_button_y, fill_visible_button_x + fill_visible_button_width, fill_source_button_y + draw_button_height))
			{
				toolbar_hover = "fill_visible_layers";
			}

			/* The background slider reserves a slightly taller hit area around its visual
			track */
			else if (point_in_rect(mx, my, canvas_background_slider_x, canvas_background_slider_y - 4, canvas_background_slider_x + canvas_background_slider_width, canvas_background_slider_y + canvas_background_slider_height + 4))
			{
				toolbar_hover = "canvas_bg_brightness";
			}

			/* The action row's Undo button receives the undo hover key */
			else if (point_in_rect(mx, my, undo_button_x, action_button_y, undo_button_x + undo_button_width, action_button_y + draw_button_height))
			{
				toolbar_hover = "undo";
			}

			/* The Redo button receives the redo hover key */
			else if (point_in_rect(mx, my, redo_button_x, action_button_y, redo_button_x + redo_button_width, action_button_y + draw_button_height))
			{
				toolbar_hover = "redo";
			}

			/* The Save button offers drawing screenshot export */
			else if (point_in_rect(mx, my, screenshot_button_x, action_button_y, screenshot_button_x + screenshot_button_width, action_button_y + draw_button_height))
			{
				toolbar_hover = "save";
			}

			/* The folder button is hit-testable only when desktop opening is available */
			else if (screenshot_folder_can_open()
			&& point_in_rect(mx, my, open_screenshot_folder_button_x, action_button_y, open_screenshot_folder_button_x + open_screenshot_folder_button_width, action_button_y + draw_button_height))
			{
				toolbar_hover = "folder";
			}

			/* Draw Hidden toggles whether collapsing the toolbar preserves drawing input */
			else if (point_in_rect(mx, my, draw_hidden_button_x, action_button_y, draw_hidden_button_x + draw_hidden_button_width, action_button_y + draw_button_height))
			{
				toolbar_hover = "draw_hidden";
			}

			/* The dimming control receives hover only when inactive-layer dimming is currently
			available */
			else if (inactive_layer_dim_available()
			&& point_in_rect(mx, my, dim_inactive_button_x, action_button_y, dim_inactive_button_x + dim_inactive_button_width, action_button_y + draw_button_height))
			{
				toolbar_hover = "dim_inactive_layers";
			}

			/* Visit each permanent swatch rectangle in palette order */
			for (var i = 0; i < array_length(swatches); i++)
			{
				/* Compute this swatch's GUI x from its index and four-pixel spacing */
				var sx = swatch_x + i * (swatch_size + 4);

				/* Use the permanent swatch row's shared GUI y */
				var sy = swatch_y;

				/* A palette rectangle hit stores its zero-based swatch index in the hover key */
				if (point_in_rect(mx, my, sx, sy, sx + swatch_size, sy + swatch_size))
				{
					toolbar_hover = "swatch_" + string(i);
					break;
				}
			}

			/* Visit every recent-color display slot, including slots with no stored color yet */
			for (var recent_index = 0; recent_index < recent_swatch_capacity; recent_index++)
			{
				/* Compute this recent slot's GUI x at the same spacing as the permanent
				palette */
				var recent_x = swatch_x + recent_index * (swatch_size + 4);

				/* A recent-slot hit stores its zero-based index for later availability
				validation */
				if (point_in_rect(mx, my, recent_x, recent_swatch_y, recent_x + swatch_size, recent_swatch_y + swatch_size))
				{
					toolbar_hover = "recent_swatch_" + string(recent_index);
					break;
				}
			}

			/* Hit-test the three HSV slider rows */
			for (var slider_index = 0; slider_index < 3; slider_index++)
			{
				/* Row zero edits hue, row one saturation, and row two value */
				var slider_key = slider_index == 0 ? "hue" : (slider_index == 1 ? "saturation" : "value");

				/* Locate the row's GUI top from slider height and row gap */
				var slider_y = hsv_slider_y + slider_index * (hsv_slider_height + hsv_slider_gap);

				/* A slider-track hit supplies its channel hover key */
				if (point_in_rect(mx, my, hsv_slider_x, slider_y, hsv_slider_x + hsv_slider_width, slider_y + hsv_slider_height))
				{
					toolbar_hover = slider_key;
					break;
				}
			}

			/* Check whether the pointer instead lies in an HSV numeric field */
			var hovered_input_key = hsv_input_key_at(mx, my);

			/* A numeric-field hit replaces slider hover with its input hover key */
			if (hovered_input_key != "")
			{
				toolbar_hover = hsv_input_hover_key(hovered_input_key);
			}
		}

		/* Only a fresh left click dispatches an action from the resolved toolbar hover key */
		if (mouse_check_button_pressed(mb_left))
		{
			is_drawing = false;
			sent_drag_command = false;
			debug_note("toolbar click", toolbar_hover);

			/* Hide follows the current Draw Hidden preference */
			if (toolbar_hover == "hide_toolbar")
			{
				hide_toolbar_panel(draw_while_hidden);
			}

			/* Draw Hidden toggles the collapse preference and opens explanatory timed feedback */
			else if (toolbar_hover == "draw_hidden")
			{
				draw_while_hidden = !draw_while_hidden;
				show_toolbar_mode_notice(draw_while_hidden);

				/* Report the newly enabled or disabled preference in diagnostics */
				debug_note("draw without toolbar", draw_while_hidden ? "on" : "off");

				/* Enabling the preference immediately collapses the toolbar while keeping
				drawing active */
				if (draw_while_hidden)
				{
					hide_toolbar_panel(true);
				}
			}

			/* A currently available dimming control toggles the local inactive-layer view */
			else if (toolbar_hover == "dim_inactive_layers" && inactive_layer_dim_available())
			{
				toggle_inactive_layer_dim();
			}

			/* Pen selects streamed paint strokes */
			else if (toolbar_hover == "pen")
			{
				set_draw_tool(DRAW_TOOL_PEN);
			}

			/* Wall selects shared world geometry after its availability check */
			else if (toolbar_hover == "wall")
			{
				set_draw_tool(DRAW_TOOL_WALL);
			}

			/* Eraser selects paint and shared wall removal */
			else if (toolbar_hover == "eraser")
			{
				set_draw_tool(DRAW_TOOL_ERASER);
			}

			/* Select chooses rectangle and pixel-move interaction */
			else if (toolbar_hover == "select")
			{
				set_draw_tool(DRAW_TOOL_SELECT);
			}

			/* Color Picker selects visible-canvas RGBA sampling */
			else if (toolbar_hover == "picker")
			{
				set_draw_tool(DRAW_TOOL_COLOR_PICKER);
			}

			/* Line selects drag-previewed line drawing */
			else if (toolbar_hover == "line")
			{
				set_draw_tool(DRAW_TOOL_LINE);
			}

			/* Rectangle selects drag-previewed rectangle drawing */
			else if (toolbar_hover == "rect")
			{
				set_draw_tool(DRAW_TOOL_RECTANGLE);
			}

			/* Circle selects drag-previewed ellipse drawing */
			else if (toolbar_hover == "circle")
			{
				set_draw_tool(DRAW_TOOL_CIRCLE);
			}

			/* Fill selects progressive region filling */
			else if (toolbar_hover == "fill")
			{
				set_draw_tool(DRAW_TOOL_FILL);
			}

			/* Stamp selects PNG placement and refreshes its library */
			else if (toolbar_hover == "stamp")
			{
				set_draw_tool(DRAW_TOOL_STAMP);
				scr_get_stamps().refresh();
			}

			/* Text selects the drawing text editor */
			else if (toolbar_hover == "text")
			{
				set_draw_tool(DRAW_TOOL_TEXT);
			}

			/* Minus requests one world pixel less width through the current tool clamp */
			else if (toolbar_hover == "minus")
			{
				set_brush_width_value(brush_width - 1);
			}

			/* A width-track click starts slider capture and applies its pointer value
			immediately */
			else if (toolbar_hover == "brush_width")
			{
				toolbar_active_slider = "brush_width";
				update_brush_slider_from_mouse(mx);
			}

			/* A width-field click opens numeric brush entry */
			else if (toolbar_hover == "brush_input")
			{
				begin_brush_input();
			}

			/* Plus requests one world pixel more width through the current tool clamp */
			else if (toolbar_hover == "plus")
			{
				set_brush_width_value(brush_width + 1);
			}

			/* Current fill boundaries disable visible-layer sampling */
			else if (toolbar_hover == "fill_current_layer")
			{
				fill_sample_visible_layers = false;
				debug_note("fill boundaries", "current layer");
			}

			/* Visible fill boundaries enable sampling of visible layers */
			else if (toolbar_hover == "fill_visible_layers")
			{
				fill_sample_visible_layers = true;
				debug_note("fill boundaries", "visible layers");
			}

			/* A background-track click starts local brightness dragging */
			else if (toolbar_hover == "canvas_bg_brightness")
			{
				toolbar_active_slider = "canvas_bg_brightness";
				update_canvas_background_slider_from_mouse(mx);
			}

			/* Undo invokes the latest eligible local group removal */
			else if (toolbar_hover == "undo")
			{
				undo_local_command();
			}

			/* Redo invokes the latest saved local group restoration */
			else if (toolbar_hover == "redo")
			{
				redo_local_command();
			}

			/* Save exports the current drawing screenshot */
			else if (toolbar_hover == "save")
			{
				save_current_layer_screenshot();
			}

			/* Folder requests desktop opening of the screenshot root */
			else if (toolbar_hover == "folder")
			{
				open_screenshot_folder();
			}

			/* A permanent swatch hover key selects its indexed RGBA brush value */
			else if (string_copy(toolbar_hover, 1, 7) == "swatch_")
			{
				/* Parse the permanent palette index from its hover-key suffix */
				var swatch_index = real(string_copy(toolbar_hover, 8, string_length(toolbar_hover) - 7));

				/* Only an index within the actual swatch array can select a color */
				if (swatch_index >= 0 && swatch_index < array_length(swatches))
				{
					/* Borrow this palette record's RGB channels and optional alpha */
					var swatch = swatches[swatch_index];

					/* Resolve its alpha byte with the opaque legacy fallback */
					var alpha = swatch_alpha(swatch);

					/* A zero-alpha palette swatch selects the dedicated transparent brush */
					if (alpha <= 0)
					{
						set_brush_transparent();
					}

					/* Visible swatches apply their RGBA values and update HSV as permitted */
					else
					{
						set_brush_rgba(swatch.r, swatch.g, swatch.b, alpha);
					}
				}
			}

			/* A recent-swatch hover key restores a previously used RGBA color */
			else if (string_copy(toolbar_hover, 1, 14) == "recent_swatch_")
			{
				/* Parse the recent slot index from its hover-key suffix */
				var recent_index = real(string_copy(toolbar_hover, 15, string_length(toolbar_hover) - 14));

				/* Only a populated recent-color slot can restore a brush */
				if (recent_index >= 0 && recent_index < array_length(recent_swatches))
				{
					/* Borrow the selected recent RGBA record before applying its channels */
					var recent_color = recent_swatches[recent_index];
					set_brush_rgba(recent_color.r, recent_color.g, recent_color.b, recent_color.a);
				}
			}

			/* Any HSV track starts dragging its resolved channel and updates the brush
			immediately */
			else if (toolbar_hover == "hue"
			|| toolbar_hover == "saturation"
			|| toolbar_hover == "value")
			{
				toolbar_active_slider = toolbar_hover;
				update_hsv_slider_from_mouse(toolbar_active_slider, mx);
			}

			/* Unoccupied toolbar space begins moving the panel and records both pointer
			offsets */
			else if (toolbar_hover == "")
			{
				toolbar_dragging = true;
				toolbar_drag_offset_x = mx - toolbar_x;
				toolbar_drag_offset_y = my - toolbar_y;
			}

			/* Other hover targets may identify a numeric HSV field */
			else
			{
				/* Translate the hover key into a channel that supports numeric entry */
				var hsv_key = hsv_input_key_from_hover(toolbar_hover);

				/* Open a numeric editor only for a recognized HSV input field */
				if (hsv_key != "")
				{
					begin_hsv_input(hsv_key);
				}
			}
		}

		/* While drawing mode is enabled, the hovered toolbar can also adjust width with the
		wheel */
		if (draw_mode_enabled)
		{
			/* Wheel Up adds one world pixel of tool-clipped brush width */
			if (mouse_wheel_up())
			{
				set_brush_width_value(brush_width + 1);
			}

			/* Wheel Down removes one world pixel of tool-clipped width */
			if (mouse_wheel_down())
			{
				set_brush_width_value(brush_width - 1);
			}
		}

		return true;
	}

	/// @description Handle Control-Z and Control-Y after closing the current drawing gesture
	/// @returns {Bool} Whether an undo or redo shortcut was attempted
	handle_history_shortcuts = function()
	{
		/* History shortcuts require Control to avoid consuming ordinary key presses */
		if (!keyboard_check(vk_control))
		{
			return false;
		}

		/* Control-Z stops a drawing gesture before attempting local undo */
		if (keyboard_check_pressed(ord("Z")))
		{
			is_drawing = false;
			sent_drag_command = false;
			end_local_undo_group();
			undo_local_command();
			return true;
		}

		/* Control-Y stops a drawing gesture before attempting local redo */
		if (keyboard_check_pressed(ord("Y")))
		{
			is_drawing = false;
			sent_drag_command = false;
			end_local_undo_group();
			redo_local_command();
			return true;
		}

		/* Other Control combinations are left for selection or other handlers */
		return false;
	}

	/// @description Check drawing mode and keyboard owners before selection shortcut handling
	/// @returns {Bool} Whether selection shortcuts must defer
	selection_keyboard_blocked = function()
	{
		/* Selection keyboard actions are unavailable while drawing mode is off */
		if (!draw_mode_enabled)
		{
			return true;
		}

		/* Active text, numeric editors, stamp keyboard capture or a fill reserve typing from
		selection shortcuts */
		if (text_entry_captures_keyboard())
		{
			return true;
		}

		/* Open chat also reserves keyboard interaction */
		if (tool_cursor_blocked_by_chat())
		{
			return true;
		}

		/* Otherwise selection shortcuts can inspect the current key state */
		return false;
	}

	/// @description Handle selection Escape, copy, cut, paste and clear shortcuts with user feedback
	/// @param {Camera} camera_id View camera used to resolve paste placement from pointer or view
	/// @returns {Bool} Whether a recognized selection shortcut was attempted
	handle_selection_shortcuts = function(camera_id)
	{
		/* A keyboard owner or disabled drawing prevents selection shortcut dispatch */
		if (selection_keyboard_blocked())
		{
			return false;
		}

		/* Outside Select, an existing rectangle is required before these shortcuts apply */
		if (tool != DRAW_TOOL_SELECT && !selection_active)
		{
			return false;
		}

		/* Escape clears an active selection without deleting its layer pixels */
		if (keyboard_check_pressed(vk_escape) && selection_active)
		{
			clear_selection();
			set_screenshot_status("Cleared selection.", make_color_rgb(255, 220, 95));
			return true;
		}

		/* Copy, Cut and Paste require the Control modifier */
		if (keyboard_check(vk_control))
		{
			/* Control-C attempts copying the selected active-layer pixels */
			if (keyboard_check_pressed(ord("C")))
			{
				/* A valid selection and successful clipboard copy receive success feedback */
				if (selection_active && copy_selection_to_clipboard())
				{
					set_screenshot_status("Copied selection.", make_color_rgb(94, 215, 122));
				}

				/* An absent selection or failed copy reports that no selection was copied */
				else
				{
					set_screenshot_status("No selection to copy.", make_color_rgb(255, 220, 95));
				}
				return true;
			}

			/* Control-X attempts copying and clearing the selected pixels */
			if (keyboard_check_pressed(ord("X")))
			{
				/* An active rectangle permits the cut attempt and its confirmation feedback */
				if (selection_active)
				{
					cut_selection_to_clipboard();
					set_screenshot_status("Cut selection.", make_color_rgb(94, 215, 122));
				}

				/* Without a rectangle, Cut reports no selection */
				else
				{
					set_screenshot_status("No selection to cut.", make_color_rgb(255, 220, 95));
				}
				return true;
			}

			/* Control-V attempts PNG paste from the shared pixel-editor clipboard */
			if (keyboard_check_pressed(ord("V")))
			{
				/* A clipboard with required region metadata can resolve a destination and
				attempt paste */
				if (region_clipboard_available())
				{
					/* Borrow the clipboard's region dimensions and pixels for choosing paste
					placement */
					var clipboard_region = region_clipboard();

					/* Resolve the current validated world pointer, which may be unavailable */
					var mouse_world = mouse_to_world(camera_id);

					/* Choose a paste origin from selection, pointer or camera and clip it for
					the copied region */
					var target = selection_paste_target(camera_id, mouse_world, clipboard_region);
					paste_clipboard_at(target.x, target.y);
					set_screenshot_status("Pasted selection.", make_color_rgb(94, 215, 122));
				}

				/* An unavailable clipboard reports that no copied selection exists */
				else
				{
					set_screenshot_status("No copied selection.", make_color_rgb(255, 220, 95));
				}
				return true;
			}
		}

		/* Delete or Backspace clears selected pixels only when a rectangle is active */
		if ((keyboard_check_pressed(vk_delete) || keyboard_check_pressed(vk_backspace))
		&& selection_active)
		{
			/* A committed clear receives deleted-pixels feedback */
			if (clear_selected_pixels())
			{
				set_screenshot_status("Deleted selection pixels.", make_color_rgb(94, 215, 122));
			}

			/* A failed or empty clear receives already-empty feedback */
			else
			{
				set_screenshot_status("Selection is already empty.", make_color_rgb(255, 220, 95));
			}
			return true;
		}

		/* No recognized selection shortcut leaves this keyboard pass unhandled */
		return false;
	}

	/// @description Update stamp GUI, consume brush color and close requests, and report input capture
	/// @returns {Bool} Whether the stamp GUI or a close request captured input
	handle_stamp_gui_input = function()
	{
		/* Borrow the stamp manager that owns library GUI input and brush-color synchronization */
		var stamp_manager = scr_get_stamps();

		/* A missing manager or GUI-update method cannot capture drawing input */
		if (!is_struct(stamp_manager)
		|| !variable_struct_exists(stamp_manager, "update_gui"))
		{
			return false;
		}

		update_toolbar_layout();
		stamp_manager.set_anchor(toolbar_x, toolbar_y, toolbar_width, toolbar_height);

		/* Enable the library panel only for expanded drawing mode with Stamp selected */
		var panel_active = draw_mode_enabled && !toolbar_hidden && tool == DRAW_TOOL_STAMP;

		/* Keep whether the stamp GUI consumed input, including ongoing editing work */
		var captured = stamp_manager.update_gui(panel_active, brush_red, brush_green, brush_blue);

		/* Consume library-to-brush color updates only when the manager exposes that
		integration */
		if (variable_struct_exists(stamp_manager, "consume_colour_sync"))
		{
			/* Read the manager's pending RGB synchronization once */
			var colour_sync = stamp_manager.consume_colour_sync();

			/* An available synchronization record updates brush color with opaque alpha */
			if (colour_sync != noone)
			{
				set_brush_rgb(colour_sync.r, colour_sync.g, colour_sync.b);
			}
		}

		/* A consumed library-close request restores the tool selected before Stamp */
		if (variable_struct_exists(stamp_manager, "consume_library_close_request")
		&& stamp_manager.consume_library_close_request())
		{
			restore_tool_before_stamp();
			captured = true;
		}

		/* Captured stamp GUI input clears unrelated hover and invalidates the world pointer
		for previews */
		if (captured)
		{
			toolbar_hover = "";
			layers_panel_hover = "";
			debug_mouse_world_valid = false;
		}

		/* Return the manager's capture decision after close requests and color sync are
		handled */
		return captured;
	}

	/// @description Process drawing UI and world-tool input from the client Step event
	/// @param {Real} camera_id Camera used to convert pointer coordinates into room pixels
	/// @param {Bool} history_sync_maintenance_done Whether Step already advanced sync maintenance this frame. Defaults to false
	/// @returns {Bool} Whether an editor, UI, fill or immediate-tool path captured input, with false for ordinary world gestures
	update_client = function(camera_id, history_sync_maintenance_done = false)
	{
		debug_update_count++;
		debug_last_camera_id = camera_id;
		debug_last_mouse_pressed = mouse_check_button_pressed(mb_left);
		debug_last_mouse_down = mouse_check_button(mb_left);
		debug_last_mouse_released = mouse_check_button_released(mb_left);
		debug_last_moved_enough = false;

		/* An inactive session aborts drawing and fill interaction before processing any
		editors or UI */
		if (!is_active_client_session())
		{
			fill_abort_runtime();
			is_drawing = false;
			end_local_undo_group();

			/* Close active HSV entry when its client session disappears */
			if (hsv_input_active != "")
			{
				cancel_hsv_input();
			}

			/* Close active brush-width entry for the same session boundary */
			if (brush_input_active)
			{
				cancel_brush_input();
			}

			/* Discard pending drawing text when there is no active session */
			if (text_entry_active)
			{
				cancel_text_entry("inactive");
			}
			debug_note("client update skipped", "inactive client session");
			return false;
		}

		/* Joining synchronization owns this Step until its shared canvas is ready */
		if (update_client_history_sync_wait(history_sync_maintenance_done))
		{
			return false;
		}

		update_pending_image_draws();

		/* An active fill reserves this pass from new world gestures */
		if (fill_job_active())
		{
			is_drawing = false;
			sent_drag_command = false;
			end_local_undo_group();

			/* A fresh left click requests cancellation of a cancelable local fill */
			if (mouse_check_button_pressed(mb_left))
			{
				cancel_progressive_fill_job();
			}

			/* Advance the fill only if cancellation did not end its job */
			if (fill_job_active())
			{
				/* Borrow the active fill job to decide which per-frame budget applies */
				var active_fill_job = fill_active_job;

				/* A job explicitly marked noncancelable represents shared replay work */
				var shared_fill_job = is_struct(active_fill_job)
					&& variable_struct_exists(active_fill_job, "cancelable")
					&& !active_fill_job.cancelable;

				/* Shared replay fills use the configured shared per-step pixel, seed and span
				budgets */
				if (shared_fill_job)
				{
					advance_progressive_fill_job(shared_fill_pixels_per_step, shared_fill_seed_budget_per_step, shared_fill_spans_per_step);
				}

				/* Other fills use the local progressive defaults */
				else
				{
					advance_progressive_fill_job();
				}
			}
			return true;
		}

		/* An active HSV editor takes precedence over world and toolbar input */
		if (hsv_input_active != "")
		{
			return update_hsv_input();
		}

		/* An active brush-width editor likewise owns its input pass */
		if (brush_input_active)
		{
			return update_brush_input();
		}

		/* Drawing text entry owns typing and prevents streamed drawing gestures */
		if (text_entry_active)
		{
			is_drawing = false;
			sent_drag_command = false;
			return update_text_entry_input();
		}

		/* A vote banner that captures the pointer prevents later controls or world drawing
		from receiving it */
		if (handle_layer_vote_input())
		{
			return true;
		}

		/* A mode notice that captures the pointer takes precedence over stamp and ordinary
		toolbar controls */
		if (handle_toolbar_mode_notice_input())
		{
			return true;
		}

		/* A captured stamp-library interaction stops the remaining drawing input dispatch */
		if (handle_stamp_gui_input())
		{
			return true;
		}

		/* A handled undo or redo shortcut stops this pass before layer and world gestures */
		if (handle_history_shortcuts())
		{
			return true;
		}

		/* Layer-panel capture takes precedence over toolbar and world input */
		if (handle_layers_panel_input())
		{
			return true;
		}

		/* Toolbar capture prevents its clicks from reaching the world */
		if (handle_toolbar_input())
		{
			return true;
		}

		/* A handled selection shortcut stops later world-tool processing */
		if (handle_selection_shortcuts(camera_id))
		{
			return true;
		}

		/* Disabled drawing mode ends the current gesture and clears selection before returning
		idle */
		if (!draw_mode_enabled)
		{
			is_drawing = false;
			sent_drag_command = false;
			end_local_undo_group();
			clear_selection();
			debug_note("client update idle", "draw mode off");
			return false;
		}

		/* Wall input remains unavailable when server capability changes after tool selection */
		if (tool == DRAW_TOOL_WALL && !scr_get_walls().can_draw())
		{
			is_drawing = false;
			sent_drag_command = false;
			end_local_undo_group();

			/* Show the Wall restriction only on a fresh press rather than repeating it every
			held frame */
			if (mouse_check_button_pressed(mb_left))
			{
				set_screenshot_status("Wall drawing is turned off or unavailable on this server.", make_color_rgb(255, 220, 95));
			}
			return false;
		}

		/* Resolve a pointer accepted by GUI, camera and room bounds before using world
		coordinates */
		var mouse_world = mouse_to_world(camera_id);

		/* An unavailable world pointer cannot start or extend ordinary drawing */
		if (mouse_world == noone)
		{
			/* An existing Select drag still owns its gesture outside the world view */
			if (tool == DRAW_TOOL_SELECT && selection_drag_active())
			{
				/* Finish that drag once its left button is up or released, even when no valid
				world pointer remains */
				if (!mouse_check_button(mb_left) || mouse_check_button_released(mb_left))
				{
					finish_selection_drag();
				}
				return true;
			}

			/* Without a held mouse button, an invalid-pointer frame closes the ordinary
			drawing undo group */
			if (!mouse_check_button(mb_left))
			{
				is_drawing = false;
				sent_drag_command = false;
				end_local_undo_group();
			}
			debug_note("client update no world", debug_mouse_reason);
			return false;
		}

		current_world_x = mouse_world.x;
		current_world_y = mouse_world.y;

		/* Select routes pointer gestures to rectangle or pixel-move handling instead of
		primitive drawing */
		if (tool == DRAW_TOOL_SELECT)
		{
			is_drawing = false;
			sent_drag_command = false;
			end_local_undo_group();

			/* A fresh Select press begins a selection or move drag */
			if (mouse_check_button_pressed(mb_left))
			{
				begin_selection_drag(mouse_world.x, mouse_world.y);
				return true;
			}

			/* A held active Select gesture updates its rectangle or move preview */
			if (mouse_check_button(mb_left) && selection_drag_active())
			{
				update_selection_drag(mouse_world.x, mouse_world.y);
				return true;
			}

			/* A released Select gesture commits its move if applicable and frees preview
			resources */
			if (mouse_check_button_released(mb_left) && selection_drag_active())
			{
				finish_selection_drag();
				return true;
			}

			/* An idle Select frame reports no handled gesture */
			return false;
		}

		/* A drawing gesture with no held button and no release edge is stale and must close
		its undo group */
		if (is_drawing
		&& !mouse_check_button(mb_left)
		&& !mouse_check_button_released(mb_left))
		{
			is_drawing = false;
			sent_drag_command = false;
			end_local_undo_group();
		}

		/* A fresh valid world press dispatches immediate tools or starts a held gesture */
		if (mouse_check_button_pressed(mb_left))
		{
			/* Color Picker samples once and does not begin streamed drawing */
			if (tool == DRAW_TOOL_COLOR_PICKER)
			{
				pick_color_at_world(mouse_world.x, mouse_world.y);
				is_drawing = false;
				sent_drag_command = false;
				return true;
			}

			/* Fill starts once at the chosen seed and camera bounds */
			if (tool == DRAW_TOOL_FILL)
			{
				send_fill_at(mouse_world.x, mouse_world.y, camera_id);
				is_drawing = false;
				sent_drag_command = false;
				return true;
			}

			/* Stamp attempts one PNG placement at the chosen world position */
			if (tool == DRAW_TOOL_STAMP)
			{
				send_stamp_at(mouse_world.x, mouse_world.y);
				is_drawing = false;
				sent_drag_command = false;
				return true;
			}

			/* Text opens its editor once at that position */
			if (tool == DRAW_TOOL_TEXT)
			{
				send_text_at(mouse_world.x, mouse_world.y);
				is_drawing = false;
				sent_drag_command = false;
				return true;
			}

			/* Other tools open one undo group, start both endpoints at the click and allow the
			first segment without a prior send deadline */
			is_drawing = true;
			sent_drag_command = false;
			begin_local_undo_group();
			last_world_x = mouse_world.x;
			last_world_y = mouse_world.y;
			current_world_x = mouse_world.x;
			current_world_y = mouse_world.y;
			next_send_time = 0;
			debug_note("draw press", "world " + string(mouse_world.x) + "," + string(mouse_world.y));
			return false;
		}

		/* A held shape gesture updates its preview endpoint without submitting geometry yet */
		if (is_drawing && tool_is_shape_tool(tool) && mouse_check_button(mb_left))
		{
			current_world_x = mouse_world.x;
			current_world_y = mouse_world.y;
			debug_note("shape preview", string(round(last_world_x)) + "," + string(round(last_world_y)) + " -> " + string(round(current_world_x)) + "," + string(round(current_world_y)));
		}

		/* A held stream gesture measures movement before deciding whether another segment is
		due */
		else if (is_drawing && tool_is_stream_tool(tool) && mouse_check_button(mb_left))
		{
			/* Measure horizontal displacement from the most recently accepted segment endpoint */
			var dx = mouse_world.x - last_world_x;

			/* Measure vertical displacement from the same endpoint */
			var dy = mouse_world.y - last_world_y;

			/* Compare squared displacement to squared minimum world distance, avoiding a
			square-root calculation */
			var moved_enough = dx * dx + dy * dy >= min_send_distance * min_send_distance;
			debug_last_moved_enough = moved_enough;

			/* Submit a segment only after both the movement threshold and millisecond send
			deadline are satisfied */
			if (moved_enough && current_time >= next_send_time)
			{
				/* Only an accepted segment advances its anchor and next deadline, preserving
				unsent movement for a later attempt */
				if (send_current_segment(last_world_x, last_world_y, mouse_world.x, mouse_world.y))
				{
					sent_drag_command = true;
					last_world_x = mouse_world.x;
					last_world_y = mouse_world.y;
					next_send_time = current_time + send_interval_ms;
				}
			}

			/* Insufficient movement waits without consuming the send interval */
			else if (!moved_enough)
			{
				debug_note("draw drag waiting", "move below min distance");
			}

			/* Enough movement before the deadline waits for the next allowed send time */
			else
			{
				debug_note("draw drag waiting", "send interval");
			}
		}

		/* Releasing a shape submits one complete anchor-to-pointer shape and closes its undo
		group */
		if (is_drawing && tool_is_shape_tool(tool) && mouse_check_button_released(mb_left))
		{
			send_current_segment(last_world_x, last_world_y, mouse_world.x, mouse_world.y);
			is_drawing = false;
			sent_drag_command = false;
			end_local_undo_group();
		}

		/* Releasing a streamed tool may need one final segment before closing the gesture */
		else if (is_drawing && tool_is_stream_tool(tool) && mouse_check_button_released(mb_left))
		{
			/* Send a final segment for a click with no prior segment or for movement beyond
			the last accepted endpoint */
			if (!sent_drag_command
			|| mouse_world.x != last_world_x
			|| mouse_world.y != last_world_y)
			{
				/* Record an accepted final segment before gesture cleanup */
				if (send_current_segment(last_world_x, last_world_y, mouse_world.x, mouse_world.y))
				{
					sent_drag_command = true;
				}
			}

			/* A release exactly at an already submitted endpoint needs no duplicate segment */
			else
			{
				debug_note("draw release", "no final segment needed");
			}

			is_drawing = false;
			sent_drag_command = false;
			end_local_undo_group();
		}

		/* World drawing returns false unless an earlier editor, UI, fill or immediate-tool
		path explicitly captured this input pass */
		return false;
	}
	#endregion /* Toolbar Input and Client Step END */

	#region /* World Drawing Previews */
	/// @description Draw a room-space Wall or Eraser footprint while its tool cursor is available
	/// @returns {Bool} Whether the footprint was drawn
	draw_brush_world_preview = function()
	{
		/* Only available Wall or Eraser tools with a valid visible world cursor can display a
		brush footprint */
		if ((tool != DRAW_TOOL_WALL && tool != DRAW_TOOL_ERASER)
		|| !debug_mouse_world_valid
		|| !tool_cursor_should_draw()
		|| (tool == DRAW_TOOL_WALL && !scr_get_walls().can_draw()))
		{
			return false;
		}

		/* Use half the effective world-pixel width as radius, enforcing a four-pixel Wall or
		two-pixel Eraser minimum */
		var radius = max(tool == DRAW_TOOL_WALL ? 4 : 2, brush_width) * 0.5;

		/* Eraser previews use a faint white disk with contrasting outlines so removed-area
		size is visible over any paint */
		if (tool == DRAW_TOOL_ERASER)
		{
			draw_set_alpha(0.12);
			draw_set_colour(c_white);
			draw_circle(current_world_x, current_world_y, radius, false);
			draw_set_alpha(1);
			draw_set_colour(c_black);
			draw_circle(current_world_x, current_world_y, radius + 1, true);
			draw_set_colour(c_white);
			draw_circle(current_world_x, current_world_y, radius, true);
			return true;
		}
		draw_set_alpha(0.8);
		draw_set_colour(c_black);
		draw_circle(current_world_x, current_world_y, radius + 1, false);
		draw_set_colour(make_color_rgb(brush_red, brush_green, brush_blue));
		draw_circle(current_world_x, current_world_y, radius, false);
		draw_set_colour(c_white);
		draw_circle(current_world_x, current_world_y, radius, true);
		draw_set_alpha(1);
		return true;
	}

	/// @description Render the current shape gesture without adding history or altering paint surfaces
	/// @returns {Bool} Whether a valid active shape preview was drawn
	draw_shape_preview = function()
	{
		/* A shape preview needs enabled drawing, an active drag and a shape tool */
		if (!draw_mode_enabled
		|| !is_drawing
		|| !tool_is_shape_tool(tool))
		{
			return false;
		}

		/* Circle previews use the same box-interpretation flag as committed ellipse commands */
		var circle_uses_box = tool == DRAW_TOOL_CIRCLE ? 1 : 0;

		/* Build a temporary shape command from the drag anchor, current endpoint and selected
		brush style */
		var preview_command = make_command(tool, brush_red, brush_green, brush_blue, brush_width, last_world_x, last_world_y, current_world_x, current_world_y, circle_uses_box);

		/* A command rejected by normal validation cannot produce a preview */
		if (preview_command == noone)
		{
			return false;
		}

		/* Transparent shapes use a visible white hint instead of erasing pixels in the world
		Draw target */
		if (command_is_transparent(preview_command))
		{
			gpu_set_blendmode(bm_normal);
			draw_set_colour(c_white);
			draw_set_alpha(0.46);
		}

		/* Visible shapes use their command color and blending with reduced preview opacity */
		else
		{
			begin_command_blend(preview_command);
			draw_set_alpha(0.72);
		}

		/* Choose the same geometry renderer used for the selected committed shape */
		switch (tool)
		{
			/* Rectangle preview follows the command's normalized rectangle geometry */
			case DRAW_TOOL_RECTANGLE:
				draw_command_rectangle(preview_command);
				break;

			/* Circle preview follows its ellipse geometry */
			case DRAW_TOOL_CIRCLE:
				draw_command_circle(preview_command);
				break;

			/* Other accepted shape tools render the line geometry */
			default:
				draw_command_line(preview_command);
				break;
		}

		end_command_blend();
		draw_set_alpha(1);
		return true;
	}

	/// @description Render pending drawing text and a blinking width-aligned caret in world space
	/// @returns {Bool} Whether an active text editor was previewed
	draw_text_entry_preview = function()
	{
		/* Text preview is available only while its drawing editor is open */
		if (!text_entry_active)
		{
			return false;
		}

		/* Derive the preview text height from captured brush width with a twelve-world-pixel
		minimum */
		var text_height = max(12, text_entry_brush_width * 3);

		/* Transparent text receives a white visibility hint, otherwise its captured RGB color */
		var preview_colour = text_entry_color_a <= 0 ? c_white : make_color_rgb(text_entry_color_r, text_entry_color_g, text_entry_color_b);

		/* Borrow the current editor text so glyphs and caret measure the same contents */
		var preview_text = text_entry_text;

		draw_set_colour(preview_colour);

		/* Use a fixed visibility hint for transparent text, otherwise scale preview opacity by
		its captured alpha byte */
		draw_set_alpha(text_entry_color_a <= 0 ? 0.46 : 0.78 * text_entry_color_a / 255);

		/* Only nonempty text has glyphs to render before the caret */
		if (preview_text != "")
		{
			scr_render_text(text_entry_world_x, text_entry_world_y, preview_text, text_height, text_entry_max_width);
		}

		/* Select the fallback-aware font matching the current preview text */
		var preview_font = scr_render_text_font_for_text(preview_text);

		/* Translate the desired world text height into that font's scale for caret positioning */
		var caret_scale = scr_render_text_scale(text_height, preview_font);
		draw_set_font(preview_font);

		/* Measure nonempty glyph text to keep its caret aligned with the width-limited preview */
		if (preview_text != "")
		{
			/* Measure the preview's unscaled glyph width */
			var base_width = scr_render_text_measure_width(preview_text);

			/* Shrink caret measurement scale when positive-width text would exceed the
			editor's world-width cap */
			if (base_width > 0 && base_width * caret_scale > text_entry_max_width)
			{
				caret_scale *= text_entry_max_width / (base_width * caret_scale);
			}
		}

		/* Place the caret two world pixels after the measured preview text */
		var caret_x = text_entry_world_x + scr_render_text_measure_width(preview_text) * caret_scale + 2;

		/* Give the caret an integer width proportional to text height, with a one-pixel
		minimum */
		var caret_w = max(1, floor(text_height * 0.08));

		/* Toggle caret visibility on alternating 420-millisecond clock intervals */
		var caret_on = (floor(current_time / 420) mod 2) == 0;

		/* The visible caret interval draws the insertion bar */
		if (caret_on)
		{
			draw_set_alpha(0.92);
			draw_rectangle(caret_x, text_entry_world_y, caret_x + caret_w, text_entry_world_y + text_height, false);
		}

		/* During a hidden caret interval, an empty entry still shows a faint baseline to
		locate its text origin */
		else if (preview_text == "")
		{
			draw_set_alpha(0.35);
			draw_rectangle(text_entry_world_x, text_entry_world_y + text_height, text_entry_world_x + max(12, text_height), text_entry_world_y + text_height + 1, false);
		}

		draw_set_alpha(1);
		draw_set_colour(c_white);
		return true;
	}

	/// @description Render the stamp manager's selected image at its brush-scaled clipped world placement
	/// @returns {Bool} Whether the manager drew a preview
	draw_stamp_world_preview = function()
	{
		/* A stamp preview needs enabled Stamp mode and a validated world pointer */
		if (!draw_mode_enabled
		|| tool != DRAW_TOOL_STAMP
		|| !debug_mouse_world_valid)
		{
			return false;
		}

		/* Borrow the stamp manager that owns the selected preview resource */
		var stamp_manager = scr_get_stamps();

		/* No selected stamp or unavailable manager integration leaves no PNG preview to draw */
		if (!is_struct(stamp_manager)
		|| !variable_struct_exists(stamp_manager, "has_selected_stamp")
		|| !stamp_manager.has_selected_stamp())
		{
			return false;
		}

		/* Compute the selected stamp's current brush-scaled world placement */
		var preview_size = selected_stamp_world_size();

		/* Unavailable stamp dimensions prevent preview placement */
		if (preview_size == noone)
		{
			return false;
		}

		/* Center and room-clip the preview's left world origin */
		var preview_left = stamp_left_from_world(current_world_x, preview_size.stamp_w);

		/* Center and room-clip its top world origin */
		var preview_top = stamp_top_from_world(current_world_y, preview_size.stamp_h);
		return stamp_manager.draw_selected_world_preview(preview_left, preview_top, preview_size.stamp_w, preview_size.stamp_h);
	}

	/// @description Draw fill and contrasting outlines around inclusive room-cell selection edges
	/// @param {Real} raw_left First inclusive horizontal room-cell edge
	/// @param {Real} raw_top First inclusive vertical room-cell edge
	/// @param {Real} raw_right Opposite inclusive horizontal room-cell edge
	/// @param {Real} raw_bottom Opposite inclusive vertical room-cell edge
	/// @param {Color} outline_colour Selection fill and primary outline color
	/// @param {Real} fill_alpha Zero-to-one rectangle fill opacity. Defaults to 0.12
	/// @param {Real} outline_alpha Zero-to-one primary outline opacity. Defaults to 1
	/// @returns {Bool} True after drawing the rectangle
	draw_selection_rect = function(raw_left, raw_top, raw_right, raw_bottom, outline_colour, fill_alpha = 0.12, outline_alpha = 1)
	{
		/* Sort the horizontal selection edges to obtain its left world boundary */
		var left = min(raw_left, raw_right);

		/* Sort its vertical edges to obtain its top boundary */
		var top = min(raw_top, raw_bottom);

		/* Convert the inclusive final column into the rectangle's outer right edge */
		var right = max(raw_left, raw_right) + 1;

		/* Convert the inclusive final row into the rectangle's outer bottom edge */
		var bottom = max(raw_top, raw_bottom) + 1;

		draw_set_alpha(fill_alpha);
		draw_set_colour(outline_colour);
		draw_rectangle(left, top, right, bottom, false);
		draw_set_alpha(outline_alpha * 0.45);
		draw_set_colour(c_black);
		draw_rectangle(left + 1, top + 1, right + 1, bottom + 1, true);
		draw_set_alpha(outline_alpha);
		draw_set_colour(outline_colour);
		draw_rectangle(left, top, right, bottom, true);
		draw_set_alpha(1);
		return true;
	}

	/// @description Draw captured move pixels through a crisp cached surface or a clipped per-pixel fallback
	/// @param {Real} target_left Preview destination left world coordinate
	/// @param {Real} target_top Preview destination top world coordinate
	/// @param {Real} draw_alpha Zero-to-one multiplier for preview pixel opacity. Defaults to 0.82
	/// @returns {Bool} Whether a preview path was rendered
	draw_selection_pixel_preview = function(target_left, target_top, draw_alpha = 0.82)
	{
		/* Pixel preview is drawn only while a move preview is active */
		if (!selection_preview_active)
		{
			return false;
		}

		/* Prefer the cached selection surface to drawing every copied pixel separately */
		if (surface_exists(selection_preview_surface))
		{
			/* Remember texture filtering so the preview can temporarily retain crisp pixel
			edges */
			var restore_filter = gpu_get_texfilter();
			gpu_set_texfilter(false);
			draw_set_alpha(draw_alpha);
			draw_surface(selection_preview_surface, target_left, target_top);
			draw_set_alpha(1);
			gpu_set_texfilter(restore_filter);
			return true;
		}

		/* Borrow the captured move region as the fallback when its GPU preview surface is
		unavailable */
		var preview_region = selection_move_region;

		/* Fallback drawing needs the region's dimensions and packed-pixel array */
		if (!is_struct(preview_region)
		|| !variable_struct_exists(preview_region, "width")
		|| !variable_struct_exists(preview_region, "height")
		|| !variable_struct_exists(preview_region, "pixels"))
		{
			return false;
		}

		/* Visit captured rows from top to bottom */
		for (var region_row = 0; region_row < preview_region.height; region_row++)
		{
			/* Translate this source row into its proposed world destination */
			var draw_row = target_top + region_row;

			/* Skip destination rows outside the room */
			if (draw_row < 0 || draw_row >= room_height)
			{
				continue;
			}

			/* Visit columns within each source row */
			for (var region_col = 0; region_col < preview_region.width; region_col++)
			{
				/* Translate this source column into its proposed world destination */
				var draw_col = target_left + region_col;

				/* Skip columns outside room pixel bounds */
				if (draw_col < 0 || draw_col >= room_width)
				{
					continue;
				}

				/* Read the captured row-major packed RGBA pixel */
				var pixel_value = preview_region.pixels[region_row * preview_region.width + region_col];

				/* Resolve its alpha byte to skip invisible pixels and scale preview opacity */
				var pixel_alpha = selection_pixel_alpha(pixel_value);

				/* A fully transparent source pixel needs no fallback rectangle */
				if (pixel_alpha <= 0)
				{
					continue;
				}

				draw_set_alpha(draw_alpha * pixel_alpha / 255);
				draw_set_colour(make_color_rgb(selection_pixel_red(pixel_value), selection_pixel_green(pixel_value), selection_pixel_blue(pixel_value)));
				draw_rectangle(draw_col, draw_row, draw_col + 1, draw_row + 1, false);
			}
		}

		draw_set_alpha(1);
		return true;
	}

	/// @description Render active selection bounds and any proposed pixel move over the canvas
	/// @returns {Bool} Whether a selection overlay was drawn
	draw_selection_overlay = function()
	{
		/* An overlay needs both enabled drawing mode and an active selection rectangle */
		if (!draw_mode_enabled || !selection_active)
		{
			return false;
		}

		/* During a move, show the original source faintly and the proposed pixels and
		destination more prominently */
		if (selection_preview_active)
		{
			draw_selection_rect(selection_left, selection_top, selection_right, selection_bottom, make_color_rgb(178, 178, 184), 0.04, 0.48);
			draw_selection_pixel_preview(selection_preview_left, selection_preview_top, 0.86);

			/* Compute the inclusive right destination pixel using the selected region width */
			var preview_right = selection_preview_left + selection_width() - 1;

			/* Compute the inclusive bottom destination pixel using its height */
			var preview_bottom = selection_preview_top + selection_height() - 1;
			draw_selection_rect(selection_preview_left, selection_preview_top, preview_right, preview_bottom, make_color_rgb(255, 220, 95), 0.16, 1);
			return true;
		}

		return draw_selection_rect(selection_left, selection_top, selection_right, selection_bottom, make_color_rgb(255, 220, 95), 0.1, 1);
	}

	/// @description Interpolate and render the local brightness tint behind the drawing canvas
	/// @returns {Bool} Whether a nonnegligible tint was drawn
	draw_canvas_background = function()
	{
		/* Disabled drawing resets the local background tint interpolation and draws no tint */
		if (!draw_mode_enabled)
		{
			canvas_background_brightness_lerp = 0;
			return false;
		}

		canvas_background_brightness_lerp = lerp(canvas_background_brightness_lerp, canvas_background_brightness, 0.18);

		/* Negligible interpolated brightness snaps to zero and avoids an effectively invisible
		full-room rectangle */
		if (abs(canvas_background_brightness_lerp) < 0.005)
		{
			canvas_background_brightness_lerp = 0;
			return false;
		}

		draw_set_alpha(abs(canvas_background_brightness_lerp));

		/* Negative brightness dims with black while positive brightness lightens with white */
		draw_set_colour(canvas_background_brightness_lerp < 0 ? c_black : c_white);
		draw_rectangle(0, 0, room_width, room_height, false);
		draw_set_alpha(1);
		return true;
	}

	/// @description Draw the borrowed layer in surrounding strips while omitting the selected source rectangle
	/// @param {Surface} layer_surface Borrowed active-layer surface retained by its owner
	/// @returns {Bool} Whether a valid source-omitting layer view was attempted
	draw_active_layer_without_selection_source = function(layer_surface)
	{
		/* A borrowed active-layer surface and active source rectangle are required to omit
		moved pixels visually */
		if (!surface_exists(layer_surface)
		|| !selection_active)
		{
			return false;
		}

		/* Clip the source's inclusive left cell inside room bounds */
		var source_left = clamp(selection_left, 0, max(0, room_width - 1));

		/* Clip its top cell inside room bounds */
		var source_top = clamp(selection_top, 0, max(0, room_height - 1));

		/* Clip its right cell inside room bounds */
		var source_right = clamp(selection_right, 0, max(0, room_width - 1));

		/* Clip its bottom cell inside room bounds */
		var source_bottom = clamp(selection_bottom, 0, max(0, room_height - 1));

		/* Use a positive canvas width for drawing the unaffected surrounding strips */
		var canvas_w = max(1, room_width);

		/* Use a positive canvas height for the same strip geometry */
		var canvas_h = max(1, room_height);

		/* Draw the full-width strip above the source only when at least one row exists there */
		if (source_top > 0)
		{
			draw_surface_part(layer_surface, 0, 0, canvas_w, source_top, 0, 0);
		}

		/* Draw the full-width strip below the source only when its bottom leaves rows in the
		canvas */
		if (source_bottom + 1 < canvas_h)
		{
			/* Start the lower strip one row after the inclusive source bottom */
			var bottom_y = source_bottom + 1;
			draw_surface_part(layer_surface, 0, bottom_y, canvas_w, canvas_h - bottom_y, 0, bottom_y);
		}

		/* Measure the middle strip's row count including both selected vertical edges */
		var middle_h = source_bottom - source_top + 1;

		/* Within those rows, draw the columns left of the source only when such columns exist */
		if (source_left > 0)
		{
			draw_surface_part(layer_surface, 0, source_top, source_left, middle_h, 0, source_top);
		}

		/* Draw remaining columns to the right only when the source ends before the canvas edge */
		if (source_right + 1 < canvas_w)
		{
			/* Start the right strip one column after the inclusive source right */
			var right_x = source_right + 1;
			draw_surface_part(layer_surface, right_x, source_top, canvas_w - right_x, middle_h, right_x, source_top);
		}

		return true;
	}

	/// @description Render visible layers with the selected source omitted during a pixel-move preview
	/// @returns {Bool} Whether the alternate layer view was drawn
	draw_selection_move_canvas = function()
	{
		/* A temporary source-omitting canvas view applies only during an active selection move
		preview */
		if (!selection_active
		|| !selection_preview_active
		|| selection_drag_mode != "move")
		{
			return false;
		}

		/* Every layer surface must be ready before drawing this alternate layered canvas */
		if (!ensure_all_layer_surfaces())
		{
			return false;
		}

		/* Remember texture filtering before drawing this temporary pixel-crisp layer view */
		var restore_filter = gpu_get_texfilter();
		gpu_set_texfilter(false);
		gpu_set_blendmode(bm_normal);
		draw_set_alpha(1);

		/* Resolve the current local or voted layer render order */
		var render_order = layer_render_order_indices();

		/* Visit that order from lower to higher compositing position */
		for (var order_index = 0; order_index < array_length(render_order); order_index++)
		{
			/* Resolve the render-order entry to a current layer-array index */
			var layer_index = render_order[order_index];

			/* Borrow this layer's surface, visibility and stable identity */
			var paint_layer = layers[layer_index];

			/* Determine whether vote context temporarily reveals an archived or hidden
			restoration target */
			var restore_preview = layer_is_restore_preview(paint_layer);

			/* Skip unavailable surfaces and ordinary archived or hidden layers that are not
			the restoration preview */
			if ((layer_is_archived(paint_layer) && !restore_preview)
			|| (!paint_layer.visible && !restore_preview)
			|| !surface_exists(paint_layer.surface))
			{
				continue;
			}

			/* For the active layer, draw only strips outside the captured source so its moving
			pixels do not appear twice */
			if (paint_layer.id == active_layer_id)
			{
				draw_set_alpha(layer_display_alpha(paint_layer));
				draw_active_layer_without_selection_source(paint_layer.surface);
				draw_set_alpha(1);
			}

			/* Other visible layers retain their full surfaces and normal local display opacity */
			else
			{
				draw_layer_surface_with_alpha(paint_layer.surface, layer_display_alpha(paint_layer));
			}
		}

		gpu_set_texfilter(restore_filter);
		draw_set_alpha(1);
		return true;
	}

	/// @description Draw the local canvas and world previews from the normal Draw event. Loading keeps the last composite visible
	draw_world = function()
	{
		/* World rendering requires an active client drawing session */
		if (!is_active_client_session())
		{
			return;
		}

		/* Without a canvas, drawing mode or history, there is no drawing content to allocate
		or render */
		if (!surface_exists(canvas_surface)
		&& !draw_mode_enabled
		&& array_length(client_history) <= 0)
		{
			return;
		}

		/* A failed canvas preparation stops world drawing before using a missing surface */
		if (!ensure_surface())
		{
			return;
		}

		/* The chosen background is only a local tint over the room while drawing is active.
		It stays behind the composited canvas, so history, layers, and PNG export are unchanged */
		draw_canvas_background();
		draw_set_alpha(1);

		/* During rebuilding or joining, display the existing composite and defer direct layer
		previews */
		if (layer_surface_rebuild_active || !client_history_sync_is_ready())
		{
			/* Layer previews also draw surfaces directly, so skip them during loading */
			draw_surface(canvas_surface, 0, 0);
			return;
		}

		/* Use ordinary canvas drawing only when move preview, layer blink and inactive-layer
		dimming did not render their alternate layer view */
		if (!draw_selection_move_canvas()
		&& !draw_layer_blink_world()
		&& !draw_inactive_layer_dim_world())
		{
			/* Refresh a dirty ordinary composite before drawing its surface */
			if (layer_composite_dirty)
			{
				composite_layers();
			}
			draw_surface(canvas_surface, 0, 0);
		}
		draw_shape_preview();
		draw_text_entry_preview();
		draw_stamp_world_preview();
		draw_selection_overlay();
	}
	#endregion /* World Drawing Previews END */

	#region /* Drawing Toolbar and GUI Rendering */
	/// @description Render remaining action cooldown as a readiness bar inset within GUI button bounds
	/// @param {Real} button_left Button left GUI coordinate
	/// @param {Real} button_top Button top GUI coordinate
	/// @param {Real} button_w Button width in GUI pixels
	/// @param {Real} button_h Button height in GUI pixels
	/// @param {String} action_key fill, stamp, undo or redo cooldown identity
	/// @returns {Bool} Whether a cooldown indicator was drawn
	draw_action_cooldown_indicator = function(button_left, button_top, button_w, button_h, action_key)
	{
		/* Only an action with remaining cooldown milliseconds needs a readiness bar */
		if (action_cooldown_remaining_ms(action_key) <= 0)
		{
			return false;
		}

		/* Inset the cooldown track three GUI pixels from its button edges */
		var bar_pad = 3;

		/* Use a four-GUI-pixel-high track */
		var bar_h = 4;

		/* Place its left edge inside the button's padding */
		var bar_left = button_left + bar_pad;

		/* Place the track above the button's bottom padding */
		var bar_top = button_top + button_h - bar_h - bar_pad;

		/* Retain at least one GUI pixel of usable track width */
		var bar_w = max(1, button_w - bar_pad * 2);

		/* Use the elapsed cooldown fraction to grow the ready portion of the bar */
		var ready_fraction = action_cooldown_ready_fraction(action_key);

		draw_set_alpha(0.72);
		draw_set_colour(c_black);
		draw_rectangle(bar_left, bar_top, bar_left + bar_w, bar_top + bar_h, false);
		draw_set_alpha(1);
		draw_set_colour(make_color_rgb(255, 220, 95));
		draw_rectangle(bar_left, bar_top, bar_left + bar_w * ready_fraction, bar_top + bar_h, false);
		draw_set_colour(make_color_rgb(112, 116, 124));
		draw_rectangle(bar_left, bar_top, bar_left + bar_w, bar_top + bar_h, true);
		draw_set_alpha(1);
		return true;
	}

	/// @description Draw a shared menu button using its explicit toolbar hover key
	/// @param {Real} button_left Button left GUI coordinate
	/// @param {Real} button_top Button top GUI coordinate
	/// @param {Real} button_w Button width in GUI pixels
	/// @param {Real} button_h Button height in GUI pixels
	/// @param {String} label Visible button or slider label
	/// @param {String} hover_key Explicit toolbar input identity
	/// @param {Bool} active Whether this button represents the active selection
	/// @param {Bool} enabled Whether this control is currently usable
	draw_toolbar_button_key = function(button_left, button_top, button_w, button_h, label, hover_key, active, enabled)
	{
		/* Resolve this explicit hover key against the toolbar's current captured target */
		var hovered = toolbar_hover == hover_key;
		scr_draw_menu_button(button_left, button_top, button_w, button_h, label, hovered, active, enabled, false, false, 17);
	}

	/// @description Map historical text labels to toolbar action keys and render their button
	/// @param {Real} button_left Button left GUI coordinate
	/// @param {Real} button_top Button top GUI coordinate
	/// @param {Real} button_w Button width in GUI pixels
	/// @param {Real} button_h Button height in GUI pixels
	/// @param {String} label Visible button or slider label
	/// @param {Bool} active Whether this button represents the active selection
	/// @param {Bool} enabled Whether this control is currently usable
	draw_toolbar_button = function(button_left, button_top, button_w, button_h, label, active, enabled)
	{
		/* Start from the lowercase visible label before mapping special labels to their actual
		input keys */
		var hover_key = string_lower(label);

		/* The Erase label maps to the Eraser tool's input key */
		if (hover_key == "erase")
		{
			hover_key = "eraser";
		}

		/* The minus glyph maps to its named decrement action */
		else if (hover_key == "-")
		{
			hover_key = "minus";
		}

		/* The plus glyph maps to its increment action */
		else if (hover_key == "+")
		{
			hover_key = "plus";
		}

		/* Save PNG maps to the screenshot action key */
		else if (hover_key == "save png")
		{
			hover_key = "save";
		}

		/* Both historical Hide labels use the current hide-toolbar action */
		else if (hover_key == "hide toolbar" || hover_key == "hide panel")
		{
			hover_key = "hide_toolbar";
		}

		/* Both hidden-drawing labels map to its preference toggle */
		else if (hover_key == "draw without toolbar" || hover_key == "draw while hidden")
		{
			hover_key = "draw_hidden";
		}

		/* Show Toolbar and the older Draw label use the collapsed-toolbar action */
		else if (hover_key == "show toolbar" || hover_key == "draw")
		{
			hover_key = "show_toolbar";
		}

		draw_toolbar_button_key(button_left, button_top, button_w, button_h, label, hover_key, active, enabled);
	}

	/// @description Draw a brick-pattern Wall glyph within supplied GUI bounds
	/// @param {Real} icon_left Icon left GUI coordinate
	/// @param {Real} icon_top Icon top GUI coordinate
	/// @param {Real} icon_width Icon width in GUI pixels
	/// @param {Real} icon_height Icon height in GUI pixels
	/// @param {Color} icon_colour Wall glyph color
	draw_wall_brush_icon = function(icon_left, icon_top, icon_width, icon_height, icon_colour)
	{
		draw_set_colour(icon_colour);
		draw_rectangle(icon_left, icon_top, icon_left + icon_width, icon_top + icon_height, true);
		draw_line(icon_left, icon_top + icon_height / 3, icon_left + icon_width, icon_top + icon_height / 3);
		draw_line(icon_left, icon_top + icon_height * 2 / 3, icon_left + icon_width, icon_top + icon_height * 2 / 3);
		draw_line(icon_left + icon_width * 0.5, icon_top, icon_left + icon_width * 0.5, icon_top + icon_height / 3);
		draw_line(icon_left + icon_width * 0.25, icon_top + icon_height / 3, icon_left + icon_width * 0.25, icon_top + icon_height * 2 / 3);
		draw_line(icon_left + icon_width * 0.75, icon_top + icon_height / 3, icon_left + icon_width * 0.75, icon_top + icon_height * 2 / 3);
		draw_line(icon_left + icon_width * 0.5, icon_top + icon_height * 2 / 3, icon_left + icon_width * 0.5, icon_top + icon_height);
	}

	/// @description Render tool icons with Wall and selected-stamp fallbacks, image badges and action cooldowns
	/// @param {Struct} tool_button Borrowed tool identity, label, hover key and GUI x/y/w/h rectangle
	/// @param {Bool} active Whether this button represents the active selection
	/// @param {Bool} enabled Whether this control is currently usable
	draw_toolbar_icon_button = function(tool_button, active, enabled)
	{
		/* Determine whether this tool button owns the current toolbar hover */
		var hovered = toolbar_hover == tool_button.key;

		/* Choose normal gray for available buttons and darker gray for disabled buttons */
		var fill = enabled ? make_color_rgb(54, 57, 62) : make_color_rgb(34, 36, 40);

		/* An active tool gets a yellow border while other tools use the neutral border */
		var border = active ? make_color_rgb(255, 220, 95) : make_color_rgb(112, 116, 124);

		/* Use white icon tint for enabled tools and muted gray for disabled tools */
		var icon_tint = enabled ? c_white : make_color_rgb(132, 134, 138);

		/* An enabled hovered button receives the brighter hover fill */
		if (hovered && enabled)
		{
			fill = make_color_rgb(78, 82, 88);
		}

		scr_draw_menu_button(tool_button.x, tool_button.y, tool_button.w, tool_button.h, "", hovered, active, enabled, false, false, 1);

		/* Wall uses a drawn brick glyph because its tool is represented independently from
		sprite icons */
		if (tool_button.tool_id == DRAW_TOOL_WALL)
		{
			draw_wall_brush_icon(tool_button.x + 7, tool_button.y + 6, tool_button.w - 14, tool_button.h - 12, icon_tint);
			draw_set_alpha(1);
			return;
		}

		/* Stamp can show its selected image instead of an ordinary tool sprite */
		if (tool_button.tool_id == DRAW_TOOL_STAMP)
		{
			/* Begin with no selected-image icon drawn so unavailable previews can use the
			fallback stamp glyph */
			var stamp_icon_drawn = false;

			/* Borrow the manager that owns the selected stamp's toolbar preview */
			var stamp_manager = scr_get_stamps();

			/* Use its preview integration only when the manager and method are available */
			if (is_struct(stamp_manager)
			&& variable_struct_exists(stamp_manager, "draw_selected_toolbar_icon"))
			{
				/* Fit a square selected-image icon within the button's horizontal and vertical
				padding */
				var stamp_icon_size = min(tool_button.w - 10, tool_button.h - 8);

				/* Center the selected image's left GUI edge within the button */
				var stamp_icon_left = tool_button.x + tool_button.w * 0.5 - stamp_icon_size * 0.5;

				/* Center its top GUI edge in the button's height */
				var stamp_icon_top = tool_button.y + tool_button.h * 0.5 - stamp_icon_size * 0.5;

				/* Draw available stamp previews fully opaque and disabled previews at reduced
				opacity */
				stamp_icon_drawn = stamp_manager.draw_selected_toolbar_icon(stamp_icon_left, stamp_icon_top, stamp_icon_size, stamp_icon_size, enabled ? 1 : 0.45);
			}

			/* A missing selected-image preview falls back to a simple stamp silhouette */
			if (!stamp_icon_drawn)
			{
				/* Inset the fallback glyph horizontally within the button */
				var glyph_left = tool_button.x + 9;

				/* Inset it vertically within the button */
				var glyph_top = tool_button.y + 7;
				draw_set_colour(icon_tint);
				draw_rectangle(glyph_left + 4, glyph_top, glyph_left + 15, glyph_top + 4, false);
				draw_rectangle(glyph_left + 7, glyph_top + 4, glyph_left + 12, glyph_top + 8, false);
				draw_rectangle(glyph_left + 2, glyph_top + 8, glyph_left + 17, glyph_top + 16, false);
				draw_set_colour(fill);
				draw_rectangle(glyph_left + 5, glyph_top + 11, glyph_left + 14, glyph_top + 15, false);
				draw_set_colour(icon_tint);
				draw_rectangle(glyph_left + 7, glyph_top + 12, glyph_left + 7, glyph_top + 12, false);
				draw_rectangle(glyph_left + 10, glyph_top + 12, glyph_left + 10, glyph_top + 12, false);
				draw_rectangle(glyph_left + 13, glyph_top + 12, glyph_left + 13, glyph_top + 12, false);
				draw_rectangle(glyph_left + 8, glyph_top + 14, glyph_left + 8, glyph_top + 14, false);
				draw_rectangle(glyph_left + 12, glyph_top + 14, glyph_left + 12, glyph_top + 14, false);
			}

			/* Resolve selected stamp metadata to decide whether it needs an image-only badge */
			var active_stamp_size = selected_stamp_world_size();

			/* Only explicit image-only selections receive the IMG badge */
			if (active_stamp_size != noone
			&& variable_struct_exists(active_stamp_size, "image_only")
			&& active_stamp_size.image_only)
			{
				/* Available image badges have a stronger background than disabled badges */
				draw_set_alpha(enabled ? 0.95 : 0.5);
				draw_set_colour(make_color_rgb(18, 19, 22));
				draw_rectangle(tool_button.x + 3, tool_button.y + 3, tool_button.x + 25, tool_button.y + 14, false);

				/* Dim the disabled badge's border and text while keeping it recognizable */
				draw_set_alpha(enabled ? 1 : 0.55);
				draw_set_colour(make_color_rgb(255, 220, 95));
				draw_rectangle(tool_button.x + 3, tool_button.y + 3, tool_button.x + 25, tool_button.y + 14, true);
				draw_set_halign(fa_center);
				scr_render_text(tool_button.x + 14, tool_button.y + 4, "IMG", 8, 22);
				draw_set_halign(fa_left);
				draw_set_alpha(1);
			}

			draw_action_cooldown_indicator(tool_button.x, tool_button.y, tool_button.w, tool_button.h, "stamp");
			draw_set_alpha(1);
			draw_set_halign(fa_left);
			return;
		}

		/* Borrow the tool's existing toolbar sprite asset for ordinary icon rendering */
		var icon_spr = tool_button_icon_sprite(tool_button.tool_id);

		/* A missing icon sprite falls back to the label's initial letter */
		if (!sprite_exists(icon_spr))
		{
			draw_set_halign(fa_center);
			draw_set_colour(icon_tint);
			scr_render_text(tool_button.x + tool_button.w * 0.5, tool_button.y + 7, string_copy(tool_button.label, 1, 1), 17, tool_button.w - 8);
			draw_set_halign(fa_left);

			/* Even a Fill letter fallback retains its action cooldown indicator */
			if (tool_button.tool_id == DRAW_TOOL_FILL)
			{
				draw_action_cooldown_indicator(tool_button.x, tool_button.y, tool_button.w, tool_button.h, "fill");
			}
			return;
		}

		/* Use a positive source sprite width for scale calculation */
		var icon_w = max(1, sprite_get_width(icon_spr));

		/* Use a positive source sprite height for the matching scale calculation */
		var icon_h = max(1, sprite_get_height(icon_spr));

		/* Choose an aspect-preserving scale that fits the padded button before its later scale
		clamp */
		var icon_scale = min((tool_button.w - 10) / icon_w, (tool_button.h - 8) / icon_h);
		icon_scale = clamp(icon_scale, 1, 2.25);

		/* Center the scaled icon's visible left edge in the button */
		var icon_left = tool_button.x + tool_button.w * 0.5 - icon_w * icon_scale * 0.5;

		/* Center its visible top edge in the button */
		var icon_top = tool_button.y + tool_button.h * 0.5 - icon_h * icon_scale * 0.5;

		/* Include the source sprite's horizontal origin offset in its draw position */
		var icon_x = icon_left + sprite_get_xoffset(icon_spr) * icon_scale;

		/* Include its vertical origin offset in the draw position */
		var icon_y = icon_top + sprite_get_yoffset(icon_spr) * icon_scale;
		draw_sprite_ext(icon_spr, 0, icon_x, icon_y, icon_scale, icon_scale, 0, icon_tint, 1);

		/* Fill icons also show their readiness bar */
		if (tool_button.tool_id == DRAW_TOOL_FILL)
		{
			draw_action_cooldown_indicator(tool_button.x, tool_button.y, tool_button.w, tool_button.h, "fill");
		}
		draw_set_alpha(1);
		draw_set_halign(fa_left);
	}

	/// @description Resolve tool and control explanations including availability, cooldowns and selected stamp metadata
	/// @returns {String} Tooltip text or empty for an unrecognized target
	toolbar_tooltip_text = function()
	{
		/* Look for a hovered tool button before considering non-tool controls */
		for (var tool_index = 0; tool_index < array_length(tool_buttons); tool_index++)
		{
			/* Borrow the button's label, tool identity and hover key */
			var tool_button = tool_buttons[tool_index];

			/* The hovered tool supplies its tool-specific tooltip */
			if (toolbar_hover == tool_button.key)
			{
				/* Wall tooltip explains shared opaque geometry or its unavailable state */
				if (tool_button.tool_id == DRAW_TOOL_WALL)
				{
					/* Choose usable Wall instructions only while the wall subsystem permits
					drawing */
					return scr_get_walls().can_draw()
						? "Wall Brush: Solid, Opaque Strokes. Everyone Can Erase Them."
						: "Wall Drawing Is Turned Off or Unavailable on This Server";
				}

				/* Eraser tooltip explains its shared walls and active-layer scope */
				if (tool_button.tool_id == DRAW_TOOL_ERASER)
				{
					return "Eraser: Current Drawing Layer and Everyone's Walls";
				}

				/* A cooling Fill reports its remaining milliseconds converted to one-decimal
				seconds */
				if (tool_button.tool_id == DRAW_TOOL_FILL
				&& !action_cooldown_is_ready("fill"))
				{
					return "Fill Cooldown: " + string_format(max(0.1, action_cooldown_remaining_ms("fill") / 1000), 1, 1) + "s";
				}

				/* A cooling Stamp reports its remaining time using the same seconds format */
				if (tool_button.tool_id == DRAW_TOOL_STAMP
				&& !action_cooldown_is_ready("stamp"))
				{
					return "Stamp Cooldown: " + string_format(max(0.1, action_cooldown_remaining_ms("stamp") / 1000), 1, 1) + "s";
				}

				return tool_button.label;
			}
		}

		/* Resolve action and numeric-control tooltips from the captured hover key */
		switch (toolbar_hover)
		{
			/* Show tooltip explains whether drawing is already active behind the collapsed
			toolbar */
			case "show_toolbar":
				return draw_mode_enabled ? "Drawing Is Active - Show Toolbar" : "Open Drawing Toolbar";

			/* Hide tooltip states whether this preference keeps drawing active or pauses it */
			case "hide_toolbar":
				return draw_while_hidden ? "Hide Toolbar - Drawing Stays Active" : "Hide Toolbar - Drawing Pauses";

			/* The decrement tooltip changes from brush sizing to stamp sizing in Stamp mode */
			case "minus":

				/* Stamp sizing distinguishes an image-only selected stamp from a
				pixel-editable stamp */
				if (tool == DRAW_TOOL_STAMP)
				{
					/* Resolve selected stamp metadata for the Smaller wording */
					var smaller_stamp_size = selected_stamp_world_size();

					/* Use image-specific wording only when the resolved selection explicitly
					marks image_only */
					return smaller_stamp_size != noone && variable_struct_exists(smaller_stamp_size, "image_only") && smaller_stamp_size.image_only ? "Smaller Image Stamp" : "Smaller Stamp";
				}
				return "Smaller Brush";

			/* Width slider and numeric field share a size tooltip */
			case "brush_width":
			case "brush_input":

				/* In Stamp mode the size tooltip describes its calculated placement */
				if (tool == DRAW_TOOL_STAMP)
				{
					return stamp_size_tooltip_text();
				}
				return "Brush Size";

			/* The increment tooltip likewise distinguishes stamp size from ordinary brush
			width */
			case "plus":

				/* Stamp increment wording depends on the selection's image-only metadata */
				if (tool == DRAW_TOOL_STAMP)
				{
					/* Resolve the selected stamp for the Larger wording */
					var larger_stamp_size = selected_stamp_world_size();

					/* Use Larger Image Stamp only for a resolved image-only selection */
					return larger_stamp_size != noone && variable_struct_exists(larger_stamp_size, "image_only") && larger_stamp_size.image_only ? "Larger Image Stamp" : "Larger Stamp";
				}
				return "Larger Brush";

			/* Current identifies active-layer fill boundaries */
			case "fill_current_layer":
				return "Fill Boundaries: Current Layer";

			/* Visible identifies multi-layer visible fill boundaries */
			case "fill_visible_layers":
				return "Fill Boundaries: Visible Layers";

			/* Background tooltip includes the local brightness description */
			case "canvas_bg_brightness":
				return "Background Brightness: " + canvas_background_text();

			/* Undo explains Wall erasing or the local drawing undo action */
			case "undo":

				/* Wall has no drawing undo and instead points to Eraser */
				if (tool == DRAW_TOOL_WALL)
				{
					return "Remove Walls with the Eraser";
				}

				/* A cooling undo action displays its remaining time in seconds */
				if (!action_cooldown_is_ready("undo"))
				{
					return "Undo Cooldown: " + string_format(max(0.1, action_cooldown_remaining_ms("undo") / 1000), 1, 1) + "s";
				}

				return "Undo Your Last Drawing";

			/* Redo explains Wall drawing or restoration of an undone drawing group */
			case "redo":

				/* Wall restoration points to the Wall Brush instead of drawing redo */
				if (tool == DRAW_TOOL_WALL)
				{
					return "Draw Walls with the Wall Brush";
				}

				/* A cooling redo action displays its remaining seconds */
				if (!action_cooldown_is_ready("redo"))
				{
					return "Redo Cooldown: " + string_format(max(0.1, action_cooldown_remaining_ms("redo") / 1000), 1, 1) + "s";
				}

				return "Redo Your Last Undone Drawing";

			/* Save identifies PNG export */
			case "save":
				return "Save PNG";

			/* Folder identifies desktop screenshot-folder opening */
			case "folder":
				return "Open Folder";

			/* Hidden-drawing tooltip describes its current enabled or disabled preference */
			case "draw_hidden":
				return draw_while_hidden ? "On: Drawing Stays Active Without The Toolbar" : "Hide The Toolbar And Keep Drawing";

			/* Inactive dimming offers a tooltip only while that local view feature is
			available */
			case "dim_inactive_layers":
				return inactive_layer_dim_available() ? "Dim Inactive Layers" : "";

			/* Hue track and numeric field share the Hue label */
			case "hue":
			case "hue_input":
				return "Hue";

			/* Saturation track and numeric field share the Saturation label */
			case "saturation":
			case "saturation_input":
				return "Saturation";

			/* Value track and numeric field share the Value label */
			case "value":
			case "value_input":
				return "Value";
		}

		/* Recent-slot tooltips depend on whether that slot contains a recorded color */
		if (string_copy(toolbar_hover, 1, 14) == "recent_swatch_")
		{
			/* Parse the recent index from its hover key */
			var recent_index = real(string_copy(toolbar_hover, 15, string_length(toolbar_hover) - 14));

			/* Only an index inside the stored recent-color array represents a discovered color */
			if (recent_index >= 0 && recent_index < array_length(recent_swatches))
			{
				/* The newest slot gets its distinct discovery label while older populated
				slots use Recent Color */
				return recent_index == 0 ? "Newest Discovered Color" : "Recent Color";
			}

			return "New Custom Colors Appear After You Draw";
		}

		/* Permanent palette tooltips distinguish the transparent entry from ordinary fixed
		colors */
		if (string_copy(toolbar_hover, 1, 7) == "swatch_")
		{
			/* Parse the palette index before examining its alpha */
			var swatch_index = real(string_copy(toolbar_hover, 8, string_length(toolbar_hover) - 7));

			/* A valid zero-alpha palette entry gets the transparent-color explanation */
			if (swatch_index >= 0
			&& swatch_index < array_length(swatches)
			&& swatch_alpha(swatches[swatch_index]) <= 0)
			{
				return "Fixed Transparent Color";
			}

			return "Fixed Palette Color";
		}

		/* Unknown hover targets have no tooltip text */
		return "";
	}

	/// @description Render current toolbar tooltip near the GUI pointer with edge clipping
	/// @returns {Bool} Whether tooltip text was rendered
	draw_toolbar_tooltip = function()
	{
		/* Resolve the current action or color tooltip text before sizing its popup */
		var tooltip_text = toolbar_tooltip_text();

		/* Empty copy or active panel dragging suppresses the tooltip */
		if (tooltip_text == "" || toolbar_hover == "panel_drag")
		{
			return false;
		}

		/* Read positive GUI width for horizontal popup clipping */
		var gui_w = max(1, display_get_gui_width());

		/* Read positive GUI height for deciding whether it fits below the pointer */
		var gui_h = max(1, display_get_gui_height());

		/* Read GUI pointer x for popup placement */
		var mx = device_mouse_x_to_gui(0);

		/* Read GUI pointer y for popup placement */
		var my = device_mouse_y_to_gui(0);

		/* Use a twenty-four-GUI-pixel tooltip height */
		var tooltip_h = 24;

		/* Render its text at fourteen GUI pixels */
		var text_height = 14;
		draw_set_font(fnt_ui);

		/* Measure scaled text and padding, clipping popup width between 52 and 300 GUI pixels */
		var tooltip_w = clamp(string_width(tooltip_text) * scr_render_text_scale(text_height) + 16, 52, 300);

		/* Prefer the pointer's right side while retaining a four-pixel GUI edge inset */
		var tooltip_x = clamp(mx + 14, 4, max(4, gui_w - tooltip_w - 4));

		/* Prefer the pointer's lower side for vertical placement */
		var tooltip_y = my + 18;

		/* If the popup would exceed the GUI bottom, place it above the pointer instead */
		if (tooltip_y + tooltip_h > gui_h - 4)
		{
			tooltip_y = max(4, my - tooltip_h - 12);
		}

		draw_set_alpha(0.92);
		draw_set_colour(c_black);
		draw_rectangle(tooltip_x, tooltip_y, tooltip_x + tooltip_w, tooltip_y + tooltip_h, false);
		draw_set_alpha(1);
		draw_set_colour(make_color_rgb(255, 220, 95));
		draw_rectangle(tooltip_x, tooltip_y, tooltip_x + tooltip_w, tooltip_y + tooltip_h, true);
		draw_set_halign(fa_center);
		draw_set_colour(c_white);
		scr_render_text(tooltip_x + tooltip_w * 0.5, tooltip_y + 5, tooltip_text, text_height, tooltip_w - 10);
		draw_set_halign(fa_left);
		draw_set_alpha(1);
		return true;
	}

	/// @description Render timed drawing feedback or persistent joining progress and failure feedback
	/// @returns {Bool} Whether a status toast was rendered
	draw_screenshot_status = function()
	{
		/* Expired feedback and a ready canvas need no screenshot-status toast */
		if (!screenshot_status_is_visible())
		{
			return false;
		}

		/* Begin with the latest stored feedback text before overriding it for joining status */
		var status_text = screenshot_status_text;

		/* Begin with that feedback's stored color */
		var status_colour = screenshot_status_color;

		/* An active joining client always displays current loading state even if its ordinary
		toast expired */
		if (is_active_client_session() && !client_history_sync_is_ready())
		{
			/* Loading must remain visible even when the normal toast expires */
			/* After the completion marker, report loading, otherwise report continued
			receiving */
			status_text = client_history_sync_completion_received
				? "Loading shared canvas..."
				: "Receiving shared canvas...";
			status_colour = make_color_rgb(255, 220, 95);

			/* An active replay cursor can provide more specific failure or progress feedback */
			if (is_struct(client_history_replay))
			{
				/* A failed replay overrides loading copy with reconnect guidance and red
				feedback */
				if (client_history_replay.failed)
				{
					status_text = "Canvas could not finish loading. Reconnect to retry.";
					status_colour = make_color_rgb(244, 84, 84);
				}

				/* After the terminator and with nonempty history, show received-item replay
				progress */
				else if (client_history_sync_completion_received && array_length(client_history) > 0)
				{
					/* Clamp displayed completion to 99 percent until the joining state is
					actually marked ready */
					var loading_percent = min(99, floor(100 * client_history_replay.index / array_length(client_history)));
					status_text = "Loading shared canvas: " + string(loading_percent) + "%...";
				}
			}
		}

		/* Read a positive GUI width for the status toast's horizontal room */
		var gui_width = max(1, display_get_gui_width());

		/* Align the toast's left edge to the toolbar origin */
		var status_x = toolbar_x;

		/* Place it six GUI pixels below the toolbar */
		var status_y = toolbar_y + toolbar_height + 6;

		/* Prefer a width covering the toolbar or 340 pixels while limiting it by available GUI
		width */
		var status_w = min(max(toolbar_width, 340), max(120, gui_width - toolbar_x * 2));

		/* Use a fixed twenty-eight-GUI-pixel toast height */
		var status_h = 28;

		draw_set_alpha(0.82);
		draw_set_colour(c_black);
		draw_rectangle(status_x, status_y, status_x + status_w, status_y + status_h, false);
		draw_set_alpha(1);
		draw_set_colour(status_colour);
		draw_rectangle(status_x, status_y, status_x + status_w, status_y + status_h, true);
		draw_set_halign(fa_left);
		scr_render_text(status_x + 8, status_y + 6, status_text, 16, status_w - 16);
		draw_set_alpha(1);
		return true;
	}

	/// @description Check the hidden-toolbar preference notice's millisecond display deadline
	/// @returns {Bool} Whether its positive deadline has not expired
	toolbar_mode_notice_is_visible = function()
	{
		/* A mode notice is visible only while it has a positive millisecond deadline that has
		not expired */
		return toolbar_mode_notice_until > 0 && current_time <= toolbar_mode_notice_until;
	}

	/// @description Resolve hidden-drawing preference copy and feedback color
	/// @returns {Struct} title, body and colour describing the enabled or disabled preference
	toolbar_mode_notice_text = function()
	{
		/* Enabled hidden drawing returns an ON title, explanatory body and green feedback
		color */
		if (toolbar_mode_notice_enabled)
		{
			return
			{
				title: "Draw Without Toolbar: ON",
				body: "The toolbar was hidden to give you more room. Drawing stays active whenever it is hidden. Use Show Toolbar anytime to change tools or settings.",
				colour: make_color_rgb(94, 215, 122)
			};
		}

		/* Disabled hidden drawing returns an OFF title, pause explanation and yellow feedback
		color */
		return
		{
			title: "Draw Without Toolbar: OFF",
			body: "Hiding the drawing toolbar will now pause drawing until you show it again.",
			colour: make_color_rgb(255, 220, 95)
		};
	}

	/// @description Measure and place a visible preference notice above or below the toolbar when GUI space permits
	/// @returns {Struct} GUI edges, text width and notice content, or noone when expired or unplaceable
	toolbar_mode_notice_rect = function()
	{
		/* An expired mode notice has no hit-test or drawing rectangle */
		if (!toolbar_mode_notice_is_visible())
		{
			return noone;
		}

		/* Resolve this preference notice's title, body and color */
		var notice = toolbar_mode_notice_text();

		/* Read positive GUI width for notice sizing */
		var gui_w = max(1, display_get_gui_width());

		/* Read positive GUI height for vertical placement */
		var gui_h = max(1, display_get_gui_height());

		/* Cap notice width at 520 GUI pixels while retaining an eight-pixel edge inset */
		var notice_w = min(520, gui_w - 16);

		/* A view too narrow for a 200-pixel notice skips it */
		if (notice_w < 200)
		{
			return noone;
		}

		/* Reserve twelve GUI pixels on either side of the notice body */
		var text_w = notice_w - 24;

		/* Measure wrapped body height at fifteen-pixel text with at most three lines */
		var body_h = scr_text_wrapped_height(notice.body, 15, text_w, 3);

		/* Add title and padding height to that measured body */
		var notice_h = 48 + body_h;

		/* A notice taller than the available GUI area is skipped */
		if (notice_h > gui_h - 16)
		{
			return noone;
		}

		/* Clip its horizontal origin while aligning it with the toolbar when possible */
		var notice_x = clamp(toolbar_x, 8, gui_w - notice_w - 8);

		/* Prefer placing the notice eight pixels below the toolbar */
		var below_y = toolbar_y + toolbar_height + 8;

		/* Leave extra vertical room when a screenshot-status toast already occupies that lower
		area */
		if (screenshot_status_is_visible())
		{
			below_y += 36;
		}

		/* Compute an alternate origin eight pixels above the toolbar */
		var above_y = toolbar_y - notice_h - 8;

		/* Declare the final GUI y position, assigning it only after a below-or-above placement
		fits */
		var notice_y;

		/* Use the preferred lower position when the notice fits above the GUI bottom inset */
		if (below_y + notice_h <= gui_h - 8)
		{
			notice_y = below_y;
		}

		/* Otherwise use the upper position when it retains the top inset */
		else if (above_y >= 8)
		{
			notice_y = above_y;
		}

		/* Without space on either side, return no notice rectangle */
		else
		{
			return noone;
		}

		/* Return inclusive GUI edges, usable text width and the title/body/color notice used
		for rendering */
		return
		{
			left: notice_x,
			top: notice_y,
			right: notice_x + notice_w,
			bottom: notice_y + notice_h,
			text_w: text_w,
			notice: notice
		};
	}

	/// @description Render a currently visible and placeable hidden-drawing preference notice
	/// @returns {Bool} Whether the notice was rendered
	draw_toolbar_mode_notice = function()
	{
		/* Resolve notice content and rectangle through the shared visibility and placement
		rules */
		var rect = toolbar_mode_notice_rect();

		/* An expired or unplaceable notice has nothing to render */
		if (!is_struct(rect))
		{
			return false;
		}

		draw_set_alpha(0.92);
		draw_set_colour(c_black);
		draw_rectangle(rect.left, rect.top, rect.right, rect.bottom, false);
		draw_set_alpha(1);
		draw_set_colour(rect.notice.colour);
		draw_rectangle(rect.left, rect.top, rect.right, rect.bottom, true);
		draw_set_halign(fa_left);
		draw_set_colour(c_white);
		scr_render_text(rect.left + 12, rect.top + 10, rect.notice.title, 18, rect.text_w);
		draw_set_colour(make_color_rgb(220, 220, 224));
		scr_render_text_wrapped(rect.left + 12, rect.top + 34, rect.notice.body, 15, rect.text_w, 3);
		draw_set_alpha(1);
		return true;
	}

	/// @description Render forty-eight gradient segments varying one HSV byte channel at current companion values
	/// @param {String} slider_key hue, saturation or value channel identity
	/// @param {Real} gradient_left Gradient left draw coordinate
	/// @param {Real} gradient_top Gradient top draw coordinate
	/// @param {Real} gradient_w Gradient width in draw-target pixels
	/// @param {Real} gradient_h Gradient height in draw-target pixels
	draw_hsv_gradient_segments = function(slider_key, gradient_left, gradient_top, gradient_w, gradient_h)
	{
		/* Divide each HSV track into forty-eight colored segments */
		var segments = 48;

		/* Visit each segment from left to right */
		for (var i = 0; i < segments; i++)
		{
			/* Compute this segment's normalized starting position */
			var t0 = i / segments;

			/* Compute its normalized final position */
			var t1 = (i + 1) / segments;

			/* Assign this segment's packed color after choosing which HSV channel varies */
			var segment_colour;

			/* Vary the requested slider channel while keeping the other two selected values
			fixed */
			switch (slider_key)
			{
				/* Hue segments travel around the color wheel at current saturation and
				brightness */
				case "hue":
					segment_colour = hsv_to_colour(round(t0 * 255), saturation_value, value_value);
					break;

				/* Saturation segments vary chromatic intensity at current hue and brightness */
				case "saturation":
					segment_colour = hsv_to_colour(hue_value, round(t0 * 255), value_value);
					break;

				/* Other slider keys use brightness segments at current hue and saturation */
				default:
					segment_colour = hsv_to_colour(hue_value, saturation_value, round(t0 * 255));
					break;
			}

			draw_set_alpha(1);
			draw_set_colour(segment_colour);
			draw_rectangle(
				gradient_left + t0 * gradient_w,
				gradient_top,
				gradient_left + t1 * gradient_w + 1,
				gradient_top + gradient_h,
				false
			);
		}
	}

	/// @description Prepare a channel's toolbar-owned gradient cache and return a borrowed handle
	/// @param {String} slider_key hue, saturation or value channel identity
	/// @param {Real} slider_w Requested gradient surface width in pixels
	/// @param {Real} slider_h Requested gradient surface height in pixels
	/// @returns {Surface} Borrowed cached surface, or noone when channel selection or allocation fails
	toolbar_hsv_surface_for = function(slider_key, slider_w, slider_h)
	{
		/* Normalize cache width to a positive integer surface-pixel count */
		var safe_w = max(1, floor(real(slider_w)));

		/* Normalize cache height to a positive integer surface-pixel count */
		var safe_h = max(1, floor(real(slider_h)));

		/* Assign the color-state cache identity after selecting its channel's two fixed HSV
		components */
		var cache_key;

		/* Begin without a local surface handle before borrowing the selected channel's owned
		cache */
		var slider_surface = noone;

		/* Begin without a matching cached color key before reading that channel's stored key */
		var slider_cache_key = "";

		/* Choose the gradient resource and key belonging to the requested HSV channel */
		switch (slider_key)
		{
			/* Hue depends on selected saturation and brightness, packed into a two-byte cache
			key */
			case "hue":
				cache_key = saturation_value * 256 + value_value;
				slider_surface = hsv_surface_hue;
				slider_cache_key = hsv_key_hue;
				break;

			/* Saturation depends on selected hue and brightness */
			case "saturation":
				cache_key = hue_value * 256 + value_value;
				slider_surface = hsv_surface_saturation;
				slider_cache_key = hsv_key_saturation;
				break;

			/* Value depends on selected hue and saturation */
			case "value":
				cache_key = hue_value * 256 + saturation_value;
				slider_surface = hsv_surface_value;
				slider_cache_key = hsv_key_value;
				break;

			/* Unknown channels have no allocated or borrowed gradient surface */
			default:
				return noone;
		}

		/* Release a live cached surface when its pixel dimensions no longer match this control */
		if (surface_exists(slider_surface)
		&& (surface_get_width(slider_surface) != safe_w || surface_get_height(slider_surface) != safe_h))
		{
			surface_free(slider_surface);
			slider_surface = noone;
			slider_cache_key = "";
		}

		/* Allocate a missing gradient surface and invalidate its cached color-state key */
		if (!surface_exists(slider_surface))
		{
			slider_surface = surface_create(safe_w, safe_h);
			slider_cache_key = "";
		}

		/* Redraw a live cache only when its two fixed HSV channels changed */
		if (surface_exists(slider_surface) && slider_cache_key != cache_key)
		{
			surface_set_target(slider_surface);
			draw_clear_alpha(c_black, 0);
			draw_hsv_gradient_segments(slider_key, 0, 0, safe_w, safe_h);
			surface_reset_target();
			slider_cache_key = cache_key;
		}

		/* Write the resulting handle and valid key back to the owning channel's persistent
		cache fields */
		switch (slider_key)
		{
			/* The Hue fields retain this hue-track surface and color-state key */
			case "hue":
				hsv_surface_hue = slider_surface;
				hsv_key_hue = slider_cache_key;
				break;

			/* The Saturation fields retain their track surface and key */
			case "saturation":
				hsv_surface_saturation = slider_surface;
				hsv_key_saturation = slider_cache_key;
				break;

			/* The Value fields retain their track surface and key */
			case "value":
				hsv_surface_value = slider_surface;
				hsv_key_value = slider_cache_key;
				break;
		}

		/* Return a borrowed cache handle, leaving its resource owned by the drawing toolbar */
		return slider_surface;
	}

	/// @description Render thirty-two equal-channel grayscale gradient segments
	/// @param {Real} gradient_left Gradient left draw coordinate
	/// @param {Real} gradient_top Gradient top draw coordinate
	/// @param {Real} gradient_w Gradient width in draw-target pixels
	/// @param {Real} gradient_h Gradient height in draw-target pixels
	draw_canvas_background_gradient_segments = function(gradient_left, gradient_top, gradient_w, gradient_h)
	{
		/* Draw thirty-two grayscale segments from the brightness track's left side to its
		right */
		for (var segment = 0; segment < 32; segment++)
		{
			/* Compute the segment's normalized start position */
			var t0 = segment / 32;

			/* Compute its normalized end position */
			var t1 = (segment + 1) / 32;

			/* Convert the starting position to an equal RGB byte for this gray shade */
			var shade = round(t0 * 255);
			draw_set_alpha(1);
			draw_set_colour(make_color_rgb(shade, shade, shade));
			draw_rectangle(
				gradient_left + t0 * gradient_w,
				gradient_top,
				gradient_left + t1 * gradient_w + 1,
				gradient_top + gradient_h,
				false
			);
		}
	}

	/// @description Prepare the toolbar-owned dimension-keyed grayscale cache for brightness controls
	/// @param {Real} slider_w Requested gradient surface width in pixels
	/// @param {Real} slider_h Requested gradient surface height in pixels
	/// @returns {Surface} Borrowed cached surface, or noone after allocation failure
	canvas_background_gradient_surface_for = function(slider_w, slider_h)
	{
		/* Normalize the grayscale cache width to a positive surface-pixel count */
		var safe_w = max(1, floor(real(slider_w)));

		/* Normalize its height to a positive surface-pixel count */
		var safe_h = max(1, floor(real(slider_h)));

		/* Pack the dimensions into the cache identity because this grayscale pattern has no
		HSV dependencies */
		var cache_key = safe_w * 65536 + safe_h;

		/* Release a live grayscale cache whose dimensions no longer fit the requested control */
		if (surface_exists(canvas_background_gradient_surface)
		&& (surface_get_width(canvas_background_gradient_surface) != safe_w
		|| surface_get_height(canvas_background_gradient_surface) != safe_h))
		{
			surface_free(canvas_background_gradient_surface);
			canvas_background_gradient_surface = noone;
			canvas_background_gradient_key = "";
		}

		/* Allocate a missing grayscale cache and invalidate its content key */
		if (!surface_exists(canvas_background_gradient_surface))
		{
			canvas_background_gradient_surface = surface_create(safe_w, safe_h);
			canvas_background_gradient_key = "";
		}

		/* Draw the gradient only on a live cache whose dimension key is not yet current */
		if (surface_exists(canvas_background_gradient_surface)
		&& canvas_background_gradient_key != cache_key)
		{
			surface_set_target(canvas_background_gradient_surface);
			draw_clear_alpha(c_black, 0);
			draw_canvas_background_gradient_segments(0, 0, safe_w, safe_h);
			surface_reset_target();
			canvas_background_gradient_key = cache_key;
		}

		return canvas_background_gradient_surface;
	}

	/// @description Draw a labeled HSV gradient with cache fallback, hover border and stored-value knob
	/// @param {String} label Visible button or slider label
	/// @param {String} slider_key hue, saturation or value channel identity
	/// @param {Real} slider_left Slider left GUI coordinate
	/// @param {Real} slider_top Slider top GUI coordinate
	/// @param {Real} value Stored zero-to-255 slider channel value
	draw_hsv_slider = function(label, slider_key, slider_left, slider_top, value)
	{
		draw_set_halign(fa_right);
		draw_set_colour(make_color_rgb(210, 210, 214));
		scr_render_text(slider_left - 8, slider_top - 2, label, 14, 28);
		draw_set_halign(fa_left);

		/* Borrow the toolbar-owned gradient surface prepared for this HSV channel */
		var slider_surface = toolbar_hsv_surface_for(slider_key, hsv_slider_width, hsv_slider_height);

		/* A live cache draws as one surface at this slider's GUI origin */
		if (surface_exists(slider_surface))
		{
			draw_set_alpha(1);
			draw_surface(slider_surface, slider_left, slider_top);
		}

		/* Without the small GPU cache, draw the colored segments directly to keep the control
		usable */
		else
		{
			/* Preserve a usable control if the runner cannot allocate the small cache */
			draw_hsv_gradient_segments(slider_key, slider_left, slider_top, hsv_slider_width, hsv_slider_height);
		}

		/* A slider is highlighted for either pointer hover or continued drag capture */
		var hovered = toolbar_hover == slider_key || toolbar_active_slider == slider_key;

		/* Use a yellow border for highlighted sliders and the neutral border otherwise */
		draw_set_colour(hovered ? make_color_rgb(255, 220, 95) : make_color_rgb(112, 116, 124));
		draw_rectangle(slider_left, slider_top, slider_left + hsv_slider_width, slider_top + hsv_slider_height, true);

		/* Position the knob according to the stored zero-to-255 HSV value */
		var knob_x = slider_left + value / 255 * hsv_slider_width;
		draw_set_colour(c_black);
		draw_rectangle(knob_x - 3, slider_top - 3, knob_x + 3, slider_top + hsv_slider_height + 3, false);
		draw_set_colour(c_white);
		draw_rectangle(knob_x - 2, slider_top - 2, knob_x + 2, slider_top + hsv_slider_height + 2, false);
	}

	/// @description Render HSV numeric entry in displayed units with active text and blinking caret
	/// @param {String} slider_key hue, saturation or value channel identity
	/// @param {Real} field_left Numeric field left GUI coordinate
	/// @param {Real} field_top Numeric field top GUI coordinate
	draw_hsv_input_field = function(slider_key, field_left, field_top)
	{
		/* Mark this numeric field active only when it owns HSV keyboard editing */
		var active = hsv_input_active == slider_key;

		/* Determine whether this field owns the current hover target */
		var hovered = toolbar_hover == hsv_input_hover_key(slider_key);

		/* Active fields use a darker editing fill than idle fields */
		var field_fill = active ? make_color_rgb(26, 30, 36) : make_color_rgb(34, 36, 40);

		/* Use yellow for active input, bright gray for hover and the neutral border otherwise */
		var field_border = active ? make_color_rgb(255, 220, 95) : (hovered ? make_color_rgb(190, 190, 194) : make_color_rgb(112, 116, 124));

		/* Show pending editor text while active, otherwise the current channel in displayed
		units */
		var field_text = active ? hsv_input_text : string(hsv_input_display_value(slider_key));

		/* Append a caret on alternating 420-millisecond intervals only while this field is
		active */
		if (active && (floor(current_time / 420) mod 2) == 0)
		{
			field_text += "|";
		}

		draw_set_colour(field_fill);
		draw_rectangle(field_left, field_top, field_left + hsv_input_width, field_top + hsv_input_height, false);
		draw_set_colour(field_border);
		draw_rectangle(field_left, field_top, field_left + hsv_input_width, field_top + hsv_input_height, true);

		draw_set_halign(fa_center);
		draw_set_colour(c_white);
		scr_render_text(field_left + hsv_input_width * 0.5, field_top + 3, field_text, 14, hsv_input_width - 6);
		draw_set_halign(fa_left);
		draw_set_colour(make_color_rgb(190, 190, 194));
		scr_render_text(field_left + hsv_input_width + 4, field_top + 3, hsv_input_unit(slider_key), 14, 28);
	}

	/// @description Draw tool-scaled brush width slider and numeric entry with active and hover state
	draw_brush_size_controls = function()
	{
		/* Width slider highlighting covers either hover or a captured drag */
		var slider_hovered = toolbar_hover == "brush_width" || toolbar_active_slider == "brush_width";

		/* Use this tool's minimum world-pixel width as the slider's lower endpoint */
		var tool_min_width = tool_min_brush_width();

		/* Normalize accepted brush width within the tool's range, keeping a positive
		denominator */
		var amount = (brush_width - tool_min_width) / max(1, tool_max_brush_width() - tool_min_width);

		/* Translate that width fraction into the GUI knob position */
		var knob_x = brush_slider_x + amount * brush_slider_width;

		draw_set_colour(make_color_rgb(34, 36, 40));
		draw_rectangle(brush_slider_x, brush_slider_y, brush_slider_x + brush_slider_width, brush_slider_y + brush_slider_height, false);
		draw_set_colour(make_color_rgb(82, 162, 255));
		draw_rectangle(brush_slider_x, brush_slider_y, knob_x, brush_slider_y + brush_slider_height, false);

		/* Highlight the width track border only while hovered or dragged */
		draw_set_colour(slider_hovered ? make_color_rgb(255, 220, 95) : make_color_rgb(112, 116, 124));
		draw_rectangle(brush_slider_x, brush_slider_y, brush_slider_x + brush_slider_width, brush_slider_y + brush_slider_height, true);
		draw_set_colour(c_black);
		draw_rectangle(knob_x - 3, brush_slider_y - 3, knob_x + 3, brush_slider_y + brush_slider_height + 3, false);
		draw_set_colour(c_white);
		draw_rectangle(knob_x - 2, brush_slider_y - 2, knob_x + 2, brush_slider_y + brush_slider_height + 2, false);

		/* Numeric width entry uses the darker active fill while editing */
		var field_fill = brush_input_active ? make_color_rgb(26, 30, 36) : make_color_rgb(34, 36, 40);

		/* Its border prioritizes active yellow, then hover gray, then neutral gray */
		var field_border = brush_input_active ? make_color_rgb(255, 220, 95) : (toolbar_hover == "brush_input" ? make_color_rgb(190, 190, 194) : make_color_rgb(112, 116, 124));

		/* Display pending width text while editing, otherwise the accepted brush width */
		var field_text = brush_input_active ? brush_input_text : string(brush_width);

		/* Blink the active width field's text caret at the same 420-millisecond cadence */
		if (brush_input_active && (floor(current_time / 420) mod 2) == 0)
		{
			field_text += "|";
		}

		draw_set_colour(field_fill);
		draw_rectangle(brush_input_x, brush_input_y, brush_input_x + brush_input_width, brush_input_y + brush_input_height, false);
		draw_set_colour(field_border);
		draw_rectangle(brush_input_x, brush_input_y, brush_input_x + brush_input_width, brush_input_y + brush_input_height, true);
		draw_set_halign(fa_center);
		draw_set_colour(c_white);
		scr_render_text(brush_input_x + brush_input_width * 0.5, brush_input_y + 4, field_text, 15, brush_input_width - 6);
		draw_set_halign(fa_left);
	}

	/// @description Render Current and Visible boundary choices when Fill is selected
	/// @returns {Bool} Whether Fill controls were rendered
	draw_fill_source_controls = function()
	{
		/* Only Fill shows its boundary-source controls */
		if (tool != DRAW_TOOL_FILL)
		{
			return false;
		}

		draw_set_halign(fa_left);
		draw_set_colour(make_color_rgb(210, 210, 214));
		scr_render_text(fill_source_label_x, fill_source_label_y, "Boundaries", 15, fill_source_label_width);

		/* Mark Current selected when sampling stays on the active layer */
		draw_toolbar_button_key(fill_current_button_x, fill_source_button_y, fill_current_button_width, draw_button_height, "Current Layer", "fill_current_layer", !fill_sample_visible_layers, true);

		/* Mark Visible selected when multi-layer sampling is enabled */
		draw_toolbar_button_key(fill_visible_button_x, fill_source_button_y, fill_visible_button_width, draw_button_height, "Visible Layers", "fill_visible_layers", fill_sample_visible_layers, true);
		draw_set_halign(fa_left);
		return true;
	}

	/// @description Draw grayscale local-brightness slider, neutral marker and displayed setting
	/// @returns {Bool} True after rendering brightness controls
	draw_canvas_background_controls = function()
	{
		/* Brightness highlighting covers pointer hover or continued drag ownership */
		var slider_hovered = toolbar_hover == "canvas_bg_brightness" || toolbar_active_slider == "canvas_bg_brightness";

		/* Map signed brightness from minus-one-to-one into a zero-to-one knob fraction */
		var knob_amount = (canvas_background_brightness + 1) * 0.5;

		/* Place the brightness knob at that fraction along the GUI track */
		var knob_x = canvas_background_slider_x + knob_amount * canvas_background_slider_width;

		/* Locate the neutral brightness marker at the track midpoint */
		var center_x = canvas_background_slider_x + canvas_background_slider_width * 0.5;

		draw_set_halign(fa_left);
		draw_set_colour(make_color_rgb(210, 210, 214));
		scr_render_text(canvas_background_label_x, canvas_background_label_y, "BG", 15, canvas_background_label_width);

		/* Borrow the toolbar-owned grayscale cache for this brightness control */
		var background_gradient_surface = canvas_background_gradient_surface_for(canvas_background_slider_width, canvas_background_slider_height);

		/* Draw its cached surface when GPU allocation succeeded */
		if (surface_exists(background_gradient_surface))
		{
			draw_set_alpha(1);
			draw_surface(background_gradient_surface, canvas_background_slider_x, canvas_background_slider_y);
		}

		/* Otherwise retain a usable brightness track through direct segment drawing */
		else
		{
			draw_canvas_background_gradient_segments(
				canvas_background_slider_x,
				canvas_background_slider_y,
				canvas_background_slider_width,
				canvas_background_slider_height
			);
		}

		draw_set_colour(make_color_rgb(255, 220, 95));
		draw_rectangle(center_x - 1, canvas_background_slider_y - 3, center_x + 1, canvas_background_slider_y + canvas_background_slider_height + 3, false);

		/* The track border highlights a hovered or dragged brightness control */
		draw_set_colour(slider_hovered ? make_color_rgb(255, 220, 95) : make_color_rgb(112, 116, 124));
		draw_rectangle(canvas_background_slider_x, canvas_background_slider_y, canvas_background_slider_x + canvas_background_slider_width, canvas_background_slider_y + canvas_background_slider_height, true);

		/* On the dark half use a white outer knob, otherwise a black outer knob for contrast */
		draw_set_colour(canvas_background_brightness <= 0 ? c_white : c_black);
		draw_rectangle(knob_x - 3, canvas_background_slider_y - 3, knob_x + 3, canvas_background_slider_y + canvas_background_slider_height + 3, false);

		/* Reverse that choice for the knob's inner mark */
		draw_set_colour(canvas_background_brightness <= 0 ? c_black : c_white);
		draw_rectangle(knob_x - 2, canvas_background_slider_y - 2, knob_x + 2, canvas_background_slider_y + canvas_background_slider_height + 2, false);

		draw_set_colour(make_color_rgb(34, 36, 40));
		draw_rectangle(canvas_background_value_x, canvas_background_value_y, canvas_background_value_x + canvas_background_value_width, canvas_background_value_y + canvas_background_value_height, false);

		/* The numeric brightness display uses the same highlighted border as its track */
		draw_set_colour(slider_hovered ? make_color_rgb(255, 220, 95) : make_color_rgb(112, 116, 124));
		draw_rectangle(canvas_background_value_x, canvas_background_value_y, canvas_background_value_x + canvas_background_value_width, canvas_background_value_y + canvas_background_value_height, true);
		draw_set_halign(fa_center);
		draw_set_colour(c_white);
		scr_render_text(canvas_background_value_x + canvas_background_value_width * 0.5, canvas_background_value_y + 4, canvas_background_text(), 14, canvas_background_value_width - 6);
		draw_set_halign(fa_left);
		return true;
	}

	/// @description Render selected brush RGB and hexadecimal labels or its transparent state
	draw_color_value_readout = function()
	{
		/* Position the RGB and hex readout just below the recent-color row */
		var readout_y = recent_swatch_y + swatch_size + 2;

		/* A transparent brush displays Transparent, otherwise its RGB bytes and hexadecimal
		label */
		var readout_text = brush_alpha <= 0
			? "Transparent"
			: "RGB " + string(brush_red) + ", " + string(brush_green) + ", " + string(brush_blue)
				+ "   HEX " + current_hex_text();

		draw_set_halign(fa_left);
		draw_set_colour(make_color_rgb(210, 210, 214));
		scr_render_text(swatch_x, readout_y, readout_text, 14, toolbar_width - 20);
	}

	/// @description Draw a clipped alternating gray checkerboard within a GUI square
	/// @param {Real} left Swatch or checkerboard left GUI coordinate
	/// @param {Real} top Swatch or checkerboard top GUI coordinate
	/// @param {Real} size Checkerboard square side in GUI pixels
	/// @param {Real} cell_size Checker cell side in GUI pixels before its two-pixel minimum. Defaults to 6
	draw_transparency_checkerboard = function(left, top, size, cell_size = 6)
	{
		/* Normalize checkerboard side length to a positive integer GUI-pixel count */
		var safe_size = max(1, floor(real(size)));

		/* Use a checker cell size of at least two integer GUI pixels */
		var safe_cell = max(2, floor(real(cell_size)));

		/* Visit checker rows at the chosen cell-size interval */
		for (var yy = 0; yy < safe_size; yy += safe_cell)
		{
			/* Visit checker columns and clip final cells at the requested square boundary */
			for (var xx = 0; xx < safe_size; xx += safe_cell)
			{
				/* Alternate dark and light cells according to their summed row and column
				parity */
				var dark_cell = ((xx div safe_cell) + (yy div safe_cell)) mod 2 == 0;

				/* Choose contrasting gray shades for that parity */
				draw_set_colour(dark_cell ? make_color_rgb(92, 96, 104) : make_color_rgb(218, 220, 224));
				draw_rectangle(left + xx, top + yy, min(left + safe_size, left + xx + safe_cell), min(top + safe_size, top + yy + safe_cell), false);
			}
		}
	}

	/// @description Render a swatch's alpha-aware color above a checkerboard when needed
	/// @param {Struct} swatch Borrowed RGB swatch with optional alpha byte
	/// @param {Real} left Swatch or checkerboard left GUI coordinate
	/// @param {Real} top Swatch or checkerboard top GUI coordinate
	draw_palette_swatch_fill = function(swatch, left, top)
	{
		/* Resolve this palette entry's opacity byte with the legacy opaque default */
		var alpha = swatch_alpha(swatch);

		/* A nonopaque swatch needs a checkerboard beneath it to show transparency */
		if (alpha < 255)
		{
			draw_transparency_checkerboard(left, top, swatch_size, 6);
		}

		/* Only visible swatches draw an RGB overlay above the checkerboard */
		if (alpha > 0)
		{
			draw_set_alpha(alpha / 255);
			draw_set_colour(make_color_rgb(swatch.r, swatch.g, swatch.b));
			draw_rectangle(left, top, left + swatch_size, top + swatch_size, false);
		}
		draw_set_alpha(1);
	}

	/// @description Export the drawing to its configured manual category with flattened and optional layer artifacts
	/// @returns {Bool} Result of drawing screenshot export
	save_current_layer_screenshot = function()
	{
		return save_drawing_screenshot(screenshot_manual_folder_name, "client", "manual");
	}

	/// @description Render fixed and recent palettes, selected-color preview, HSV controls and color readout
	draw_color_controls = function()
	{
		/* Draw permanent palette entries in their configured order */
		for (var i = 0; i < array_length(swatches); i++)
		{
			/* Borrow this swatch's RGB and optional alpha channels */
			var swatch = swatches[i];

			/* Place its GUI left edge by palette index and four-pixel spacing */
			var sx = swatch_x + i * (swatch_size + 4);

			/* Use the permanent palette row's shared top edge */
			var sy = swatch_y;

			/* Compare its resolved RGBA to current brush channels for selected highlighting */
			var selected = brush_matches_swatch(swatch);
			draw_palette_swatch_fill(swatch, sx, sy);

			/* Selected or hovered swatches use a yellow outline, otherwise neutral gray */
			draw_set_colour(selected || toolbar_hover == "swatch_" + string(i) ? make_color_rgb(255, 220, 95) : make_color_rgb(112, 116, 124));
			draw_rectangle(sx, sy, sx + swatch_size, sy + swatch_size, true);
		}

		/* Draw every recent-color slot so empty discoveries remain visible placeholders */
		for (var recent_index = 0; recent_index < recent_swatch_capacity; recent_index++)
		{
			/* Place this recent slot at its indexed GUI position */
			var recent_x = swatch_x + recent_index * (swatch_size + 4);

			/* A slot is populated only when its index exists in the stored recent-color array */
			var populated = recent_index < array_length(recent_swatches);

			/* Begin with the slot unselected until a stored color can be compared */
			var recent_selected = false;

			/* Populated slots draw their recorded RGBA swatch */
			if (populated)
			{
				/* Borrow the recent RGBA record to compare and render it */
				var recent_color = recent_swatches[recent_index];
				recent_selected = brush_matches_swatch(recent_color);
				draw_palette_swatch_fill(recent_color, recent_x, recent_swatch_y);
			}

			/* Empty slots draw a dark placeholder and short dash */
			else
			{
				draw_set_alpha(1);
				draw_set_colour(make_color_rgb(24, 26, 30));
				draw_rectangle(recent_x, recent_swatch_y, recent_x + swatch_size, recent_swatch_y + swatch_size, false);
				draw_set_colour(make_color_rgb(54, 57, 62));
				draw_rectangle(recent_x + 7, recent_swatch_y + 11, recent_x + swatch_size - 7, recent_swatch_y + 12, false);
			}

			/* Resolve this recent slot's hover state from its indexed key */
			var recent_hovered = toolbar_hover == "recent_swatch_" + string(recent_index);

			/* Selected or hovered slots get yellow, other populated slots neutral gray and
			empty slots a darker border */
			var recent_border = recent_selected || recent_hovered
				? make_color_rgb(255, 220, 95)
				: (populated ? make_color_rgb(112, 116, 124) : make_color_rgb(70, 73, 78));
			draw_set_colour(recent_border);
			draw_rectangle(recent_x, recent_swatch_y, recent_x + swatch_size, recent_swatch_y + swatch_size, true);
		}

		/* A transparent selected brush uses a checkerboard in the large color preview */
		if (brush_alpha <= 0)
		{
			draw_transparency_checkerboard(color_preview_x, color_preview_y, color_preview_size, 7);
		}

		/* Visible brushes show their selected RGB in the large preview */
		else
		{
			draw_set_colour(make_color_rgb(brush_red, brush_green, brush_blue));
			draw_rectangle(color_preview_x, color_preview_y, color_preview_x + color_preview_size, color_preview_y + color_preview_size, false);
		}

		draw_set_colour(make_color_rgb(190, 190, 194));
		draw_rectangle(color_preview_x, color_preview_y, color_preview_x + color_preview_size, color_preview_y + color_preview_size, true);

		draw_hsv_slider("H", "hue", hsv_slider_x, hsv_slider_y, hue_value);
		draw_hsv_slider("S", "saturation", hsv_slider_x, hsv_slider_y + hsv_slider_height + hsv_slider_gap, saturation_value);
		draw_hsv_slider("V", "value", hsv_slider_x, hsv_slider_y + (hsv_slider_height + hsv_slider_gap) * 2, value_value);
		draw_hsv_input_field("hue", hsv_input_x, hsv_slider_y - 2);
		draw_hsv_input_field("saturation", hsv_input_x, hsv_slider_y + hsv_slider_height + hsv_slider_gap - 2);
		draw_hsv_input_field("value", hsv_input_x, hsv_slider_y + (hsv_slider_height + hsv_slider_gap) * 2 - 2);
		draw_color_value_readout();
	}

	/// @description Render a layer-footer action with enabled and hover appearance
	/// @param {String} button_key Layer footer action identity
	/// @param {String} label Visible button or slider label
	/// @param {Bool} enabled Whether this control is currently usable. Defaults to true
	draw_layers_panel_button = function(button_key, label, enabled = true)
	{
		/* Resolve the requested layer-footer action's GUI rectangle */
		var rect = layer_panel_button_rect(button_key);

		/* Resolve whether that action owns layer-panel hover */
		var hovered = layers_panel_hover == button_key;

		/* Choose bright hover or ordinary fill when enabled, otherwise the disabled fill */
		var fill = enabled ? (hovered ? make_color_rgb(78, 82, 88) : make_color_rgb(54, 57, 62)) : make_color_rgb(34, 36, 40);

		/* Only enabled hovered actions receive a yellow border */
		var border = hovered && enabled ? make_color_rgb(255, 220, 95) : make_color_rgb(112, 116, 124);

		/* Use white for available action text and muted gray for disabled text */
		var text_colour = enabled ? c_white : make_color_rgb(132, 134, 138);

		draw_set_colour(fill);
		draw_rectangle(rect.x, rect.y, rect.x + rect.w, rect.y + rect.h, false);
		draw_set_colour(border);
		draw_rectangle(rect.x, rect.y, rect.x + rect.w, rect.y + rect.h, true);
		draw_set_halign(fa_center);
		draw_set_colour(text_colour);
		scr_render_text(rect.x + rect.w * 0.5, rect.y + 4, label, 16, rect.w - 4);
		draw_set_halign(fa_left);
	}

	/// @description Resolve shared layer and preview action explanations for panel hover
	/// @returns {String} Tooltip text or empty for an unknown target
	layers_panel_tooltip_text = function()
	{
		/* Resolve layer-panel explanations from the currently captured hover action */
		switch (layers_panel_hover)
		{
			/* A voted target explains that clicking flashes it again */
			case "layer_vote_target":
				return "Vote Target - Click To Flash Again";

			/* Vote context explains that surrounding layers are read-only */
			case "layer_vote_context":
				return "Read-Only Vote Context";

			/* Add explains its shared-layer request */
			case "layer_add":
				return "Add Shared Paint Layer";

			/* Duplicate explains its shared copy request */
			case "layer_duplicate":
				return "Duplicate Shared Layer";

			/* Move Down explains starting a preview or continuing an existing preview */
			case "layer_down":
				return layer_move_draft_active ? "Preview One Step Down" : "Start Move Preview Down";

			/* Move Up explains the corresponding upward preview state */
			case "layer_up":
				return layer_move_draft_active ? "Preview One Step Up" : "Start Move Preview Up";

			/* Archive explains that hiding this shared layer is reversible */
			case "layer_archive":
				return "Request Archive (Reversible)";

			/* Restore names the newest archived layer when one exists */
			case "layer_restore":

				/* Locate that newest archived record for the Restore tooltip */
				var restore_index = latest_archived_layer_index();

				/* No archived layer gets the unavailable explanation, otherwise name the
				requested restoration */
				return restore_index == noone
					? "No Archived Layers"
					: "Request Restore: " + layers[restore_index].name;

			/* Cancel explains discarding the current order preview */
			case "layer_move_cancel":
				return "Cancel Move Preview";

			/* Apply explains requesting authority for the previewed order */
			case "layer_move_apply":
				return "Apply Preview And Request Vote";

			/* Panel header and dragging explain shared layer state with an optional archived
			count */
			case "layer_panel_header":
			case "layer_panel_drag":

				/* Append an archived count only when at least one archived layer exists */
				return archived_layer_count() > 0
					? "Shared Layers - " + string(archived_layer_count()) + " Archived"
					: "Shared Layers";
		}

		/* Visibility hover explains its local-only view effect */
		if (string_copy(layers_panel_hover, 1, 14) == "layer_visible_")
		{
			return "Toggle Layer Visibility Locally";
		}

		/* Row hover explains layer selection and blinking */
		if (string_copy(layers_panel_hover, 1, 10) == "layer_row_")
		{
			return "Select Layer And Blink";
		}

		/* Other layer-panel targets have no tooltip text */
		return "";
	}

	/// @description Render layer action tooltip beside the GUI pointer within edge bounds
	/// @returns {Bool} Whether tooltip text was rendered
	draw_layers_panel_tooltip = function()
	{
		/* Resolve the layer panel's current tooltip before measuring its popup */
		var tooltip_text = layers_panel_tooltip_text();

		/* Empty tooltip text produces no popup */
		if (tooltip_text == "")
		{
			return false;
		}

		/* Read positive GUI width for popup clipping */
		var gui_w = max(1, display_get_gui_width());

		/* Read positive GUI height to choose lower or upper placement */
		var gui_h = max(1, display_get_gui_height());

		/* Read pointer GUI x for horizontal popup positioning */
		var mx = device_mouse_x_to_gui(0);

		/* Read pointer GUI y for vertical popup positioning */
		var my = device_mouse_y_to_gui(0);

		/* Use a fixed twenty-four-GUI-pixel tooltip height */
		var tooltip_h = 24;

		/* Render text at fourteen GUI pixels */
		var text_height = 14;
		draw_set_font(fnt_ui);

		/* Measure scaled text and padding, clipping this popup between 68 and 230 GUI pixels */
		var tooltip_w = clamp(string_width(tooltip_text) * scr_render_text_scale(text_height) + 16, 68, 230);

		/* Place it to the pointer's right within a four-pixel GUI inset */
		var tooltip_x = clamp(mx + 14, 4, max(4, gui_w - tooltip_w - 4));

		/* Prefer a position eighteen GUI pixels below the pointer */
		var tooltip_y = my + 18;

		/* When it would extend below the GUI, place the popup above the pointer */
		if (tooltip_y + tooltip_h > gui_h - 4)
		{
			tooltip_y = max(4, my - tooltip_h - 12);
		}

		draw_set_alpha(0.92);
		draw_set_colour(c_black);
		draw_rectangle(tooltip_x, tooltip_y, tooltip_x + tooltip_w, tooltip_y + tooltip_h, false);
		draw_set_alpha(1);
		draw_set_colour(make_color_rgb(255, 220, 95));
		draw_rectangle(tooltip_x, tooltip_y, tooltip_x + tooltip_w, tooltip_y + tooltip_h, true);
		draw_set_halign(fa_center);
		draw_set_colour(c_white);
		scr_render_text(tooltip_x + tooltip_w * 0.5, tooltip_y + 5, tooltip_text, text_height, tooltip_w - 10);
		draw_set_halign(fa_left);
		draw_set_alpha(1);
		return true;
	}

	/// @description Render scrolled shared layers, proposal context, local visibility and the current action footer
	/// @returns {Bool} Whether the panel was rendered
	draw_layers_panel = function()
	{
		/* Determine whether a proposal preview requires the panel even with drawing controls
		hidden */
		var vote_preview_visible = layer_vote_preview_active();

		/* Hidden or disabled drawing skips the panel unless vote context needs it */
		if ((!draw_mode_enabled || toolbar_hidden) && !vote_preview_visible)
		{
			return false;
		}

		ensure_default_layers();
		draw_set_alpha(0.86);
		draw_set_colour(make_color_rgb(32, 34, 36));
		draw_rectangle(layers_panel_x, layers_panel_y, layers_panel_x + layers_panel_width, layers_panel_y + layers_panel_height, false);
		draw_set_alpha(1);
		draw_set_colour(make_color_rgb(112, 116, 124));
		draw_rectangle(layers_panel_x, layers_panel_y, layers_panel_x + layers_panel_width, layers_panel_y + layers_panel_height, true);

		draw_set_colour(make_color_rgb(54, 57, 62));
		draw_rectangle(layers_panel_x, layers_panel_y, layers_panel_x + layers_panel_width, layers_panel_y + layers_panel_header_height, false);
		draw_set_colour(c_white);

		/* Header text prioritizes the voted target, then submitted or unsubmitted move
		preview, otherwise ordinary Layers */
		var header_text = vote_preview_visible
			? "Vote Target - " + layer_name_clean(client_layer_vote.layer_name, "Layer")
			: (layer_move_draft_active
				? (layer_move_draft_submitted ? "Layers - Move Requested" : "Layers - Move Preview")
				: "Layers");

		/* Count archived layers for the ordinary header's supplemental context */
		var archive_count = archived_layer_count();

		/* Append that count only outside proposal preview and move-draft modes */
		if (!vote_preview_visible && !layer_move_draft_active && archive_count > 0)
		{
			header_text += " (" + string(archive_count) + " archived)";
		}
		scr_render_text(layers_panel_x + 10, layers_panel_y + 7, header_text, 16, layers_panel_width - 20);

		/* Locate the first row beneath the header and its small gap */
		var list_top = layers_panel_y + layers_panel_header_height + 4;

		/* Compute visible whole-row capacity while retaining panel footer space */
		var visible_rows = max(1, floor((layers_panel_height - layers_panel_header_height - 38) / layers_panel_row_height));

		/* Resolve active display ordering for ordinary stack, draft or vote context */
		var display_indices = active_layer_display_indices();
		layers_panel_scroll = clamp(layers_panel_scroll, 0, max(0, array_length(display_indices) - visible_rows));

		/* Draw at most the visible row capacity after clipping panel scroll */
		for (var display_row = 0; display_row < visible_rows; display_row++)
		{
			/* Map the visible row back to its reverse-order scrolled display position */
			var display_position = array_length(display_indices) - 1 - layers_panel_scroll - display_row;

			/* Stop once no lower displayed position remains */
			if (display_position < 0)
			{
				break;
			}

			/* Resolve this display position to the layer-array index */
			var layer_index = display_indices[display_position];

			/* Borrow its layer name, identity, visibility and state for the row */
			var paint_layer = layers[layer_index];

			/* Place the row vertically below the list origin */
			var row_y = list_top + display_row * layers_panel_row_height;

			/* Mark this row active when its stable ID matches the selected paint layer */
			var active = paint_layer.id == active_layer_id;

			/* Highlight row hover for either its selection region or visibility control */
			var hovered = layers_panel_hover == "layer_row_" + string(paint_layer.id)
				|| layers_panel_hover == "layer_visible_" + string(paint_layer.id);

			/* Inset the row's left edge inside the panel */
			var row_left = layers_panel_x + 6;

			/* Use the computed row y as its top */
			var row_top = row_y;

			/* Inset its right edge inside the panel */
			var row_right = layers_panel_x + layers_panel_width - 6;

			/* Leave two GUI pixels between this row and the next */
			var row_bottom = row_y + layers_panel_row_height - 2;

			/* Mark the row proposed for a local move target or current server-vote target */
			var proposed = (layer_move_draft_active && paint_layer.id == layer_move_draft_layer_id)
				|| (is_struct(client_layer_vote) && paint_layer.id == client_layer_vote.layer_id);

			/* Mark an explicit vote target only while that contextual preview is visible */
			var vote_target = vote_preview_visible && paint_layer.id == client_layer_vote.layer_id;

			/* Prioritize selected blue, then proposed amber, hovered gray and ordinary row
			gray */
			var row_colour = active
				? make_color_rgb(82, 122, 154)
				: (proposed
					? make_color_rgb(112, 91, 42)
					: (hovered ? make_color_rgb(58, 62, 68) : make_color_rgb(42, 44, 46)));
			draw_set_colour(row_colour);
			draw_rectangle(row_left, row_top, row_right, row_bottom, false);

			/* The contextual vote target receives an extra yellow outline */
			if (vote_target)
			{
				draw_set_colour(make_color_rgb(255, 220, 95));
				draw_rectangle(row_left, row_top, row_right, row_bottom, true);
			}

			/* A layer with an active blink ID may receive its animated row highlight */
			if (paint_layer.id == layer_blink_layer_id)
			{
				/* Read the current blink opacity to apply the row animation */
				var panel_blink_alpha = layer_blink_alpha();

				/* Skip negligible blink opacity rather than drawing its highlight */
				if (panel_blink_alpha > 0.02)
				{
					draw_set_alpha(0.18 + panel_blink_alpha * 0.42);
					draw_set_colour(make_color_rgb(255, 220, 95));
					draw_rectangle(row_left, row_top, row_right, row_bottom, false);
					draw_set_alpha(0.72 + panel_blink_alpha * 0.28);
					draw_rectangle(row_left, row_top, row_right, row_bottom, true);
					draw_set_alpha(1);
				}
			}

			/* Place the visibility eye symbol near the panel's left inset */
			var eye_x = layers_panel_x + 18;

			/* Visible layers use a white eye, hidden layers a muted eye */
			draw_set_colour(paint_layer.visible ? c_white : make_color_rgb(96, 98, 102));
			draw_circle(eye_x, row_y + 13, 5, false);
			draw_set_colour(make_color_rgb(20, 22, 24));
			draw_circle(eye_x, row_y + 13, 2, false);

			/* Place the simple layer-thumbnail frame after the eye */
			var thumb_x = layers_panel_x + 38;

			/* Inset its top five GUI pixels below the row */
			var thumb_y = row_y + 5;
			draw_set_colour(make_color_rgb(220, 220, 224));
			draw_rectangle(thumb_x, thumb_y, thumb_x + 18, thumb_y + 18, false);
			draw_set_colour(make_color_rgb(150, 150, 154));
			draw_rectangle(thumb_x, thumb_y, thumb_x + 18, thumb_y + 18, true);

			/* Use pale yellow text for vote target, otherwise white visible-layer or muted
			hidden-layer text */
			draw_set_colour(vote_target ? make_color_rgb(255, 235, 145) : (paint_layer.visible ? c_white : make_color_rgb(150, 150, 154)));

			/* Prefix the voted layer name with its explicit target marker */
			var row_label = vote_target ? "[VOTE TARGET] " + paint_layer.name : paint_layer.name;
			scr_render_text(thumb_x + 26, row_y + 6, row_label, 15, layers_panel_width - 82);
		}

		/* Vote context is read-only when ordinary drawing mode or the expanded toolbar is
		unavailable */
		var vote_preview_read_only = vote_preview_visible
			&& (!draw_mode_enabled || toolbar_hidden);

		/* Read-only context shows explanatory text instead of structural action buttons */
		if (vote_preview_read_only)
		{
			draw_set_colour(make_color_rgb(255, 220, 95));
			scr_render_text(layers_panel_x + 8, layers_panel_y + layers_panel_height - 24, "Read-only vote view", 14, 180);
		}

		/* An active local move draft shows movement, cancel and apply controls */
		else if (layer_move_draft_active)
		{
			draw_layers_panel_button("layer_down", "v", layer_panel_button_enabled("layer_down"));
			draw_layers_panel_button("layer_up", "^", layer_panel_button_enabled("layer_up"));
			draw_layers_panel_button("layer_move_cancel", "C", layer_panel_button_enabled("layer_move_cancel"));
			draw_layers_panel_button("layer_move_apply", "OK", layer_panel_button_enabled("layer_move_apply"));
		}

		/* Ordinary mode shows Add, Duplicate, movement, Archive and Restore controls */
		else
		{
			draw_layers_panel_button("layer_add", "+", layer_panel_button_enabled("layer_add"));
			draw_layers_panel_button("layer_duplicate", "D", layer_panel_button_enabled("layer_duplicate"));
			draw_layers_panel_button("layer_down", "v", layer_panel_button_enabled("layer_down"));
			draw_layers_panel_button("layer_up", "^", layer_panel_button_enabled("layer_up"));
			draw_layers_panel_button("layer_archive", "A", layer_panel_button_enabled("layer_archive"));
			draw_layers_panel_button("layer_restore", "R", layer_panel_button_enabled("layer_restore"));
		}

		/* Show scroll-range text only when more displayed layers exist than visible rows */
		if (array_length(display_indices) > visible_rows)
		{
			/* Compute the current one-based start position from panel scroll for the range
			label */
			var first_visible = min(array_length(display_indices), layers_panel_scroll + 1);

			/* Clip the range's final position to the displayed layer count */
			var last_visible = min(array_length(display_indices), layers_panel_scroll + visible_rows);
			draw_set_colour(make_color_rgb(180, 182, 188));
			scr_render_text(
				layers_panel_x + 196,
				layers_panel_y + layers_panel_height - 25,
				"Scroll " + string(first_visible) + "-" + string(last_visible) + "/" + string(array_length(display_indices)),
				14,
				layers_panel_width - 204
			);
		}
		draw_set_alpha(1);
		draw_set_halign(fa_left);
		return true;
	}

	/// @description Render drawing toolbar, local layer panel and stamp library from the client Draw GUI event
	draw_gui = function()
	{
		/* Drawing GUI needs an active client session */
		if (!is_active_client_session())
		{
			return;
		}

		update_toolbar_layout();

		draw_set_alpha(0.78);
		draw_set_colour(c_black);
		draw_rectangle(toolbar_x, toolbar_y, toolbar_x + toolbar_width, toolbar_y + toolbar_height, false);
		draw_set_alpha(1);
		draw_set_colour(make_color_rgb(86, 90, 98));
		draw_rectangle(toolbar_x, toolbar_y, toolbar_x + toolbar_width, toolbar_y + toolbar_height, true);

		/* Collapsed mode draws only Show Toolbar and any required contextual vote panel */
		if (toolbar_hidden)
		{
			draw_toolbar_button_key(draw_button_x, draw_button_y, show_toolbar_button_width, show_toolbar_button_height, "Show Toolbar", "show_toolbar", draw_mode_enabled, true);

			/* An active vote preview keeps its layer context panel visible in collapsed mode */
			if (layer_vote_preview_active())
			{
				draw_layers_panel();
			}
			draw_set_alpha(1);
			draw_set_halign(fa_left);
			return;
		}

		draw_toolbar_button_key(draw_button_x, draw_button_y, draw_button_width, draw_button_height, "Hide Toolbar", "hide_toolbar", false, true);

		/* Render every configured tool button in its fixed layout order */
		for (var tool_index = 0; tool_index < array_length(tool_buttons); tool_index++)
		{
			/* Borrow this tool button's identity, label and GUI rectangle */
			var tool_button = tool_buttons[tool_index];

			/* Ordinary tools are enabled, while Wall depends on the current server capability */
			var tool_enabled = tool_button.tool_id != DRAW_TOOL_WALL || scr_get_walls().can_draw();
			draw_toolbar_icon_button(tool_button, tool == tool_button.tool_id, tool_enabled);
		}

		/* Enable width decrement only above the current tool's minimum */
		draw_toolbar_button_key(width_minus_x, draw_button_y, width_button_width, draw_button_height, "-", "minus", false, brush_width > tool_min_brush_width());
		draw_brush_size_controls();

		/* Enable increment only below its permitted maximum */
		draw_toolbar_button_key(width_plus_x, draw_button_y, width_button_width, draw_button_height, "+", "plus", false, brush_width < tool_max_brush_width());
		draw_canvas_background_controls();
		draw_fill_source_controls();

		/* Undo availability requires both an eligible local group and an elapsed action
		cooldown */
		var undo_enabled = can_undo_local_command() && action_cooldown_is_ready("undo");

		/* Redo availability requires both saved redo work and an elapsed cooldown */
		var redo_enabled = can_redo_local_command() && action_cooldown_is_ready("redo");
		draw_toolbar_button_key(undo_button_x, action_button_y, undo_button_width, draw_button_height, "Undo", "undo", false, undo_enabled);
		draw_action_cooldown_indicator(undo_button_x, action_button_y, undo_button_width, draw_button_height, "undo");
		draw_toolbar_button_key(redo_button_x, action_button_y, redo_button_width, draw_button_height, "Redo", "redo", false, redo_enabled);
		draw_action_cooldown_indicator(redo_button_x, action_button_y, redo_button_width, draw_button_height, "redo");
		draw_toolbar_button_key(screenshot_button_x, action_button_y, screenshot_button_width, draw_button_height, "Save PNG", "save", false, true);

		/* Render folder opening only on supported desktop integration targets */
		if (screenshot_folder_can_open())
		{
			draw_toolbar_button_key(open_screenshot_folder_button_x, action_button_y, open_screenshot_folder_button_width, draw_button_height, "Folder", "folder", false, true);
		}
		draw_toolbar_button_key(draw_hidden_button_x, action_button_y, draw_hidden_button_width, draw_button_height, "Draw Without Toolbar", "draw_hidden", draw_while_hidden, true);

		/* Render inactive-layer dimming only while the feature is available */
		if (inactive_layer_dim_available())
		{
			draw_toolbar_button_key(dim_inactive_button_x, action_button_y, dim_inactive_button_width, draw_button_height, "Dim Inactive", "dim_inactive_layers", dim_inactive_layers, true);
		}

		draw_color_controls();
		draw_layers_panel();

		/* Borrow the stamp manager to anchor its library beside current toolbar geometry */
		var stamp_manager = scr_get_stamps();
		stamp_manager.set_anchor(toolbar_x, toolbar_y, toolbar_width, toolbar_height);

		/* Show the stamp library only for expanded active drawing with Stamp selected */
		stamp_manager.draw_gui(draw_mode_enabled && !toolbar_hidden && tool == DRAW_TOOL_STAMP, active_layer_display_text());

		draw_set_alpha(1);
		draw_set_halign(fa_left);
	}

	/* Toasts and tooltips are intentionally drawn in a final pass so they sit
	above the toolbar, Layers panel, chat overlays, and drawing debug overlay */
	/// @description Render final drawing notices, allowed tooltips, stamp overlays and the vote banner above other GUI
	/// @returns {Bool} Whether an active client overlay pass ran
	draw_top_overlays = function()
	{
		/* Final drawing overlays require an active client session */
		if (!is_active_client_session())
		{
			return false;
		}

		/* Borrow the stamp manager to order its top overlays with drawing feedback */
		var stamp_manager = scr_get_stamps();
		draw_screenshot_status();

		draw_toolbar_mode_notice();

		/* Ordinary toolbar and layer tooltips defer while the stamp interface blocks
		player-card interaction */
		if (!stamp_manager.blocks_player_cards())
		{
			draw_layers_panel_tooltip();
			draw_toolbar_tooltip();
		}
		stamp_manager.draw_top_overlays();
		draw_layer_vote_banner();
		draw_set_alpha(1);
		draw_set_halign(fa_left);
		return true;
	}

	/// @description Give editor grid cursors priority, then render an allowed world tool cursor and manage system cursor visibility
	/// @param {Bool} allow_tool_cursor Whether custom editor and world tool cursors are permitted for this overlay pass. Defaults to true
	/// @returns {Bool} Whether a custom cursor path was rendered
	draw_tool_cursor = function(allow_tool_cursor = true)
	{
		/* Borrow the character editor to give its pixel-grid cursor first chance at pointer
		ownership */
		var character_manager = scr_get_character_maker();

		/* A permitted character-grid cursor hides the system cursor and ends this cursor pass */
		if (allow_tool_cursor

		&& is_struct(character_manager)

		&& variable_struct_exists(character_manager, "draw_editor_grid_cursor")
		&& character_manager.draw_editor_grid_cursor())
		{
			set_tool_cursor_active(true);
			return true;
		}

		/* Borrow the stamp editor for the next pixel-grid cursor opportunity */
		var stamp_manager = scr_get_stamps();

		/* A permitted stamp-grid cursor likewise takes pointer ownership before the world-tool
		cursor */
		if (allow_tool_cursor

		&& is_struct(stamp_manager)

		&& variable_struct_exists(stamp_manager, "draw_editor_grid_cursor")
		&& stamp_manager.draw_editor_grid_cursor())
		{
			set_tool_cursor_active(true);
			return true;
		}

		/* A disallowed or blocked world cursor restores the default system cursor */
		if (!allow_tool_cursor || !tool_cursor_should_draw())
		{
			set_tool_cursor_active(false);
			return false;
		}

		/* Wall uses a GUI brick symbol and an availability/width label rather than an ordinary
		sprite cursor */
		if (tool == DRAW_TOOL_WALL)
		{
			set_tool_cursor_active(true);

			/* Read Wall cursor GUI x for its symbol and label */
			var wall_cursor_x = device_mouse_x_to_gui(0);

			/* Read its GUI y for the same draw positions */
			var wall_cursor_y = device_mouse_y_to_gui(0);

			/* Check server Wall capability to choose current cursor feedback */
			var wall_available = scr_get_walls().can_draw();

			/* An available Wall cursor shows its world-pixel width, otherwise WALL OFF */
			var wall_label = wall_available ? "WALL " + string(brush_width) + "px" : "WALL OFF";

			draw_set_alpha(0.88);

			draw_set_colour(c_black);
			draw_rectangle(wall_cursor_x - 3, wall_cursor_y - 3, wall_cursor_x + 115, wall_cursor_y + 23, false);
			draw_set_alpha(1);

			/* Available Wall gets yellow emphasis and unavailable Wall a muted gray glyph */
			var wall_cursor_colour = wall_available ? make_color_rgb(255, 220, 95) : make_color_rgb(160, 160, 164);
			draw_wall_brush_icon(wall_cursor_x, wall_cursor_y, 24, 18, wall_cursor_colour);

			draw_set_halign(fa_left);
			scr_render_text(wall_cursor_x + 30, wall_cursor_y + 1, wall_label, 15, 82);
			return true;
		}

		/* Borrow the selected ordinary tool cursor sprite asset */
		var tool_cursor_icon = tool_cursor_sprite(tool);

		/* A missing sprite restores the default system cursor instead of hiding it without a
		replacement */
		if (!sprite_exists(tool_cursor_icon))

		{
			set_tool_cursor_active(false);
			return false;
		}

		set_tool_cursor_active(true);

		/* Read pointer GUI x for the cursor sprite and shadow */
		var mx = device_mouse_x_to_gui(0);

		/* Read pointer GUI y for the same draw positions */
		var my = device_mouse_y_to_gui(0);

		draw_sprite_ext(tool_cursor_icon, 0, mx + 2, my + 2, tool_cursor_scale, tool_cursor_scale, 0, c_black, 0.35);

		draw_sprite_ext(tool_cursor_icon, 0, mx, my, tool_cursor_scale, tool_cursor_scale, 0, c_white, 1);

		/* Eraser adds a world-pixel width label below its icon */
		if (tool == DRAW_TOOL_ERASER)
		{
			/* Position that label below the scaled icon with a minimum eighteen-pixel
			clearance */
			var eraser_label_y = my + max(18, sprite_get_height(tool_cursor_icon) * tool_cursor_scale) + 4;
			draw_set_alpha(0.88);

			draw_set_colour(c_black);
			draw_rectangle(mx - 3, eraser_label_y - 2, mx + 96, eraser_label_y + 19, false);
			draw_set_alpha(1);
			draw_set_colour(c_white);
			draw_set_halign(fa_left);
			scr_render_text(mx + 2, eraser_label_y, "ERASE " + string(brush_width) + "px", 14, 90);
		}

		/* Fill adds its cooldown readiness track below the cursor */
		if (tool == DRAW_TOOL_FILL)
		{
			/* Use at least thirty GUI pixels of track width while accommodating the scaled
			icon */
			var cursor_w = max(30, sprite_get_width(tool_cursor_icon) * tool_cursor_scale);

			/* Use at least ten GUI pixels of icon height to position the track beneath it */
			var cursor_h = max(10, sprite_get_height(tool_cursor_icon) * tool_cursor_scale);

			draw_action_cooldown_indicator(mx, my + cursor_h + 4, cursor_w, 10, "fill");

		}
		draw_set_alpha(1);
		draw_set_halign(fa_left);
		return true;
	}
	#endregion /* Drawing Toolbar and GUI Rendering END */

	#region /* Chunked Image Replication */
	/// @description Normalize placement and identities into an image history record without decoding its PNG
	/// @param {Real} image_id Upload identity converted to an integer
	/// @param {String} name Diagnostic image name limited to 160 characters
	/// @param {Real} image_x Horizontal world-pixel placement rounded to an integer
	/// @param {Real} image_y Vertical world-pixel placement rounded to an integer
	/// @param {Real} image_w Placed world-pixel width with a one-pixel minimum
	/// @param {Real} image_h Placed world-pixel height with a one-pixel minimum
	/// @param {String} base64_text PNG bytes encoded as Base64 without a data-URL prefix
	/// @param {Real} layer_id Stable target layer identity. Defaults to active_layer_id
	/// @param {Real} undo_id Undo group identity, zero for ungrouped history. Defaults to 0
	/// @param {Real} undo_author_id Undo-author namespace, used only for a positive group ID. Defaults to 0
	/// @param {Real} author_player_id Displayed history player identity, later authoritative on server acceptance. Defaults to local_player_id
	/// @param {String} author_name Displayed author name, sanitized when nonblank. Defaults to local_player_name
	/// @param {Bool} smooth_filter Whether texture filtering interpolates the image. Defaults to false
	/// @returns {Struct} Image-kind record with author, undo, filter and Base64 fields
	make_image_history_item = function(image_id, name, image_x, image_y, image_w, image_h, base64_text, layer_id = active_layer_id, undo_id = 0, undo_author_id = 0, author_player_id = local_player_id, author_name = local_player_name, smooth_filter = false)
	{
		/* Build an image-kind history record with integer image and positive layer identities,
		coerced player identity, display names, rounded placement, encoded PNG contents,
		filtering and undo-group ownership */
		return
		{
			history_kind: DRAW_HISTORY_IMAGE,
			image_id: floor(real(image_id)),
			layer_id: max(1, floor(real(layer_id))),
			author_player_id: coerce_player_id(author_player_id),

			/* Keep a blank author name blank for authoritative checkpoint images, otherwise
			sanitize it as a displayed username */
			author_name: string_trim(string(author_name)) == "" ? "" : chat_sanitize_username(author_name),

			/* Retain at most 160 characters of the image's diagnostic name */
			name: string_copy(string(name), 1, 160),

			/* Round horizontal placement to a world-pixel coordinate */
			x: round(real(image_x)),

			/* Round vertical placement to a world-pixel coordinate */
			y: round(real(image_y)),

			/* Store a positive integer placement width, independent of the PNG's source
			dimensions */
			w: max(1, round(real(image_w))),

			/* Store a positive integer placement height */
			h: max(1, round(real(image_h))),

			/* Store Base64 text without a data-URL prefix */
			base64: string(base64_text),

			/* Carry the requested texture-filter choice with this history item */
			smooth_filter: smooth_filter,

			/* A positive undo group requires a positive integer undo-author identity,
			otherwise store no undo owner as zero */
			undo_author_id: undo_id > 0 ? max(1, floor(real(undo_author_id))) : 0,

			/* Store a nonnegative integer undo group, with zero meaning outside local undo
			history */
			undo_id: max(0, floor(real(undo_id)))
		};
	}

	/// @description Locate a client image assembly by upload identity
	/// @param {Real} image_id Upload identity converted to an integer
	/// @returns {Real} Zero-based assembly index or noone
	image_pending_index = function(image_id)
	{
		/* Search client image assemblies in queue order for this upload identity */
		for (var i = 0; i < array_length(pending_image_receives); i++)
		{
			/* A matching image ID identifies the assembly's zero-based array position */
			if (pending_image_receives[i].image_id == image_id)
			{
				return i;
			}
		}

		/* An unseen image ID has no current client assembly */
		return noone;
	}

	/// @description Replace a provisional echo, collect a joining image or apply its live ordered history
	/// @param {Struct} item Complete image history record
	/// @returns {Bool} Whether the image was handled or accepted for drawing
	apply_received_image_item = function(item)
	{
		/* A matching optimistic local image is replaced at authoritative history tail and
		requires no duplicate append */
		if (reorder_client_local_echo_to_history_tail(item))
		{
			debug_receive_count++;
			return true;
		}

		/* Joining collection records this assembled image for budgeted Step replay */
		if (client_history_sync_batch_active && !client_history_sync_complete)
		{
			push_client_history_item(item);
			client_history_sync_requires_replay = true;
			debug_receive_count++;
			return true;
		}
		push_client_history_item(item);

		/* Keep whether a live image was drawn or accepted by ordered asynchronous application */
		var applied = apply_history_item_to_surface(item);

		/* Only accepted live image application increments the received-image count */
		if (applied)
		{
			debug_receive_count++;
		}

		/* Return the actual image application outcome */
		return applied;
	}

	/// @description Read and validate client-side image chunks, assemble matching metadata and apply completed history
	/// @returns {Bool} Whether a valid partial or complete image packet was handled
	receive_image_chunk = function()
	{
		begin_legacy_client_history_sync_batch();

		/* Read the unsigned image transfer identity from the current image packet */
		var image_id = net.read(buffer_u32);

		/* Read the stable target layer identity shared by all chunks */
		var image_layer_id = net.read(buffer_u32);

		/* Read the zero-based chunk index in this transfer */
		var chunk_index = net.read(buffer_u16);

		/* Read the announced total encoded-text chunk count */
		var chunk_count = net.read(buffer_u16);

		/* Read horizontal world-pixel placement */
		var image_x = net.read(buffer_s32);

		/* Read vertical world-pixel placement */
		var image_y = net.read(buffer_s32);

		/* Read placement width in world pixels */
		var image_w = net.read(buffer_s32);

		/* Read placement height in world pixels */
		var image_h = net.read(buffer_s32);

		/* Read the image author's numeric player identity */
		var image_author_id = net.read(buffer_s32);

		/* Read displayed author text, retaining packet spelling for assembly consistency
		checks */
		var image_author_name = string(net.read(buffer_string));

		/* Read the undo-author identity shared by this image's group */
		var image_undo_author_id = net.read(buffer_u32);

		/* Read the undo group identity */
		var image_undo_id = net.read(buffer_u32);

		/* A nonzero filter byte enables smooth image filtering */
		var image_smooth_filter = net.read(buffer_u8) != 0;

		/* Read the diagnostic image name carried in every chunk */
		var image_name = string(net.read(buffer_string));

		/* Read this chunk's encoded PNG characters */
		var chunk_text = string(net.read(buffer_string));

		/* Reject invalid chunk counts or lengths, incomplete nonfinal chunks, oversized names,
		out-of-room origins, invalid placement dimensions or nonpositive layer IDs */
		if (chunk_count <= 0
		|| chunk_count > image_import_max_chunks
		|| chunk_index >= chunk_count
		|| string_length(chunk_text) <= 0 || string_length(chunk_text) > image_chunk_size
		|| (chunk_index < chunk_count - 1 && string_length(chunk_text) != image_chunk_size)
		|| string_length(image_author_name) > 96 || string_length(image_name) > 160
		|| image_x < 0 || image_x > room_width - 1
		|| image_y < 0 || image_y > room_height - 1
		|| image_w <= 0 || image_w > room_width
		|| image_h <= 0 || image_h > room_height
		|| image_layer_id <= 0)
		{
			debug_note("image chunk rejected", "id=" + string(image_id));
			return false;
		}

		/* A single-chunk image needs no assembly queue */
		if (chunk_count == 1)
		{
			/* Build its complete image history directly from this packet's metadata and
			encoded text */
			var single_item = make_image_history_item(image_id, image_name, image_x, image_y, image_w, image_h, chunk_text, image_layer_id, image_undo_id, image_undo_author_id, image_author_id, image_author_name, image_smooth_filter);
			debug_note("image received", image_name);
			return apply_received_image_item(single_item);
		}

		/* Find any assembly already receiving this image ID */
		var pending_index = image_pending_index(image_id);

		/* Assign the assembly reference after choosing whether to create or reuse it */
		var pending;

		/* An unseen multi-chunk image can begin a new assembly */
		if (pending_index == noone)
		{
			/* Require chunk zero and fewer than eight pending client images before allocating
			its assembly */
			if (chunk_index != 0 || array_length(pending_image_receives) >= 8)
			{
				debug_note("image chunk rejected", "too many pending images or missing first chunk");
				return false;
			}

			/* The assembly retains image and layer IDs, total and zero received counts, world
			placement, author/undo identity, filtering, name, empty indexed chunks and the
			millisecond start time */
			pending =
			{
				/* Keep the image ID used for matching later chunks */
				image_id: image_id,

				/* Keep the announced total for completion and metadata consistency checks */
				chunk_count: chunk_count,

				/* Start with zero distinct chunks received */
				received: 0,

				/* Retain the horizontal placement origin */
				x: image_x,

				/* Retain the vertical placement origin */
				y: image_y,

				/* Retain placement width */
				w: image_w,

				/* Retain placement height */
				h: image_h,

				/* Retain the target stable layer ID */
				layer_id: image_layer_id,

				/* Retain packet author identity until authoritative history application */
				author_player_id: image_author_id,

				/* Retain author name to require consistent later chunk metadata */
				author_name: image_author_name,

				/* Retain the image's undo-author namespace */
				undo_author_id: image_undo_author_id,

				/* Retain its undo group */
				undo_id: image_undo_id,

				/* Retain its texture-filter preference */
				smooth_filter: image_smooth_filter,

				/* Retain its diagnostic image name */
				name: image_name,

				/* Allocate one empty Base64 string slot per announced chunk */
				chunks: array_create(chunk_count, ""),

				/* Record the transfer's starting millisecond clock for pending-receive
				diagnostics and lifecycle cleanup */
				started_at: current_time
			};
			pending_index = array_length(pending_image_receives);
			pending_image_receives[pending_index] = pending;
		}

		/* Known image IDs reuse the already allocated assembly */
		else
		{
			pending = pending_image_receives[pending_index];
		}

		/* Every subsequent chunk must match the first packet's count, placement, layer,
		author, name, undo and filter metadata */
		if (pending.chunk_count != chunk_count
		|| pending.x != image_x
		|| pending.y != image_y
		|| pending.w != image_w
		|| pending.h != image_h
		|| pending.layer_id != image_layer_id
		|| pending.author_player_id != image_author_id
		|| pending.author_name != image_author_name
		|| pending.name != image_name
		|| pending.undo_author_id != image_undo_author_id
		|| pending.undo_id != image_undo_id
		|| pending.smooth_filter != image_smooth_filter)
		{
			array_delete(pending_image_receives, pending_index, 1);
			debug_note("image chunk rejected", "metadata mismatch");
			return false;
		}

		/* Store and count only an unfilled chunk slot so duplicate delivery cannot prematurely
		complete the image */
		if (pending.chunks[chunk_index] == "")
		{
			pending.chunks[chunk_index] = chunk_text;
			pending.received++;
		}

		/* An incomplete assembly reports accepted packet handling while retaining its chunk
		queue */
		if (pending.received < pending.chunk_count)
		{
			debug_note("image chunk received", string(pending.received) + "/" + string(pending.chunk_count));
			return true;
		}

		/* Begin the complete encoded image with empty text before joining all chunk slots */
		var base64_text = "";

		/* Concatenate chunks by their zero-based index, restoring the original Base64
		character order */
		for (var i = 0; i < pending.chunk_count; i++)
		{
			base64_text += pending.chunks[i];
		}

		/* Build the final image history from the retained first-chunk metadata and assembled
		PNG text */
		var item = make_image_history_item(pending.image_id, pending.name, pending.x, pending.y, pending.w, pending.h, base64_text, pending.layer_id, pending.undo_id, pending.undo_author_id, pending.author_player_id, pending.author_name, pending.smooth_filter);
		array_delete(pending_image_receives, pending_index, 1);
		debug_note("image received", pending.name);
		return apply_received_image_item(item);
	}

	/// @description Locate a server image assembly by actual sender slot and upload identity
	/// @param {Real} sender_slot Actual connected client slot, independent of packet header claims
	/// @param {Real} image_id Upload identity converted to an integer
	/// @returns {Real} Zero-based assembly index or noone
	server_pending_image_index = function(sender_slot, image_id)
	{
		/* Search server assemblies by both actual sender slot and image ID to avoid
		cross-client transfer identity collisions */
		for (var i = 0; i < array_length(server_pending_image_receives); i++)
		{
			/* Both connection slot and upload identity must match an existing server assembly */
			if (server_pending_image_receives[i].sender_slot == sender_slot
			&& server_pending_image_receives[i].image_id == image_id)
			{
				return i;
			}
		}

		/* No paired sender/image match returns the absent-index sentinel */
		return noone;
	}

	/// @description Discard departing-slot and malformed uploads and reset its per-client drawing deadlines
	/// @param {Real} raw_slot Recipient or sender value resolved through the server slot helper
	/// @returns {Real} Number of removed assemblies, zero for a nonnumeric slot
	server_clear_pending_images_for_slot = function(raw_slot)
	{
		/* A nonnumeric slot request cannot identify pending uploads to clear */
		if (!is_real(raw_slot))
		{
			return 0;
		}

		/* Normalize the requested sender slot to an integer */
		var slot = floor(real(raw_slot));

		/* Count removed assemblies from zero for disconnect diagnostics */
		var removed_count = 0;

		/* Remove backwards so deleting one assembly does not skip another */
		for (var pending_index = array_length(server_pending_image_receives) - 1; pending_index >= 0; pending_index--)
		{
			/* Borrow this pending record to inspect its sender identity */
			var pending = server_pending_image_receives[pending_index];

			/* Remove malformed pending records and every assembly belonging to the departing
			slot */
			if (!is_struct(pending)
			|| !variable_struct_exists(pending, "sender_slot")
			|| pending.sender_slot == slot)
			{
				array_delete(server_pending_image_receives, pending_index, 1);
				removed_count++;
			}
		}

		/* Reset the slot's command timing only when its timing-array position exists */
		if (slot >= 0 && slot < array_length(server_last_command_time))
		{
			server_last_command_time[slot] = 0;
		}

		/* Reset undo throttling only within its allocated per-client array */
		if (slot >= 0 && slot < array_length(server_undo_cooldown_until))
		{
			server_undo_cooldown_until[slot] = 0;
		}

		/* Reset structural layer-action throttling only within its allocated array */
		if (slot >= 0 && slot < array_length(server_layer_action_cooldown_until))
		{
			server_layer_action_cooldown_until[slot] = 0;
		}

		/* Reset vote throttling only within its allocated array */
		if (slot >= 0 && slot < array_length(server_layer_vote_cooldown_until))
		{
			server_layer_vote_cooldown_until[slot] = 0;
		}

		/* Emit cleanup diagnostics only when at least one assembly was removed */
		if (removed_count > 0)
		{
			debug_note("server cleared pending images", server_slot_label(slot) + " removed=" + string(removed_count));
		}

		return removed_count;
	}

	/// @description Validate completed PNG and undo ownership, stamp authority and queue accepted history for broadcast
	/// @param {Struct} item Complete image history record
	/// @param {Real} sender_slot Actual connected client slot, independent of packet header claims
	/// @returns {Bool} Whether validation and broadcast queueing succeeded, with accepted history retained after broadcast failure
	server_accept_image_item = function(item, sender_slot)
	{
		/* Borrow server socket state before accepting a complete client image */
		var server = scr_get_server();

		/* Accept only image history from an actual connected slot in the server socket array */
		if (!history_item_is_image(item)
		|| !is_struct(server)
		|| !variable_struct_exists(server, "sockets")
		|| !is_array(server.sockets)
		|| sender_slot == noone
		|| sender_slot < 0
		|| sender_slot >= array_length(server.sockets)
		|| server.sockets[sender_slot] == noone)
		{
			debug_server_reject_count++;
			debug_note("server image rejected", "bad sender/image");
			return false;
		}

		/* The authoritative layer must still permit drawing before the image can enter history */
		if (!server_layer_accepts_content(item.layer_id))
		{
			debug_server_reject_count++;
			debug_note("server image rejected", server_slot_label(sender_slot) + " unavailable layer=" + string(item.layer_id));
			return false;
		}

		/* Own a decoded PNG validation buffer for this completed image */
		var source_buffer = image_buffer_from_base64(item.base64);

		/* Begin source acceptance from whether decoding and general header/dimension checks
		produced a live buffer */
		var valid_source = buffer_exists(source_buffer);

		/* A live source can undergo the stricter authoritative byte and stamp checks before
		its buffer is deleted */
		if (valid_source)
		{
			/* Require encoded PNG bytes within the import-byte ceiling */
			valid_source = buffer_get_size(source_buffer) <= image_import_max_bytes;

			/* Names beginning Stamp identify images subject to the smaller shared stamp source
			ceiling */
			if (string_pos("Stamp ", string(item.name)) == 1)
			{
				/* Read the declared source PNG dimensions for that stamp-specific check */
				var source_info = png_dimensions_from_buffer(source_buffer);

				/* Enforce the shared image dimensions too. A small placement must not
				smuggle a multi-megapixel texture to every connected player */
				/* Retain source validity only when both declared stamp PNG dimensions fit the
				shared stamp ceiling */
				valid_source = valid_source && source_info.w <= stamp_max_world_size
					&& source_info.h <= stamp_max_world_size;
			}
			buffer_delete(source_buffer);
		}

		/* A named Stamp also fails when either placed world dimension exceeds the stamp
		ceiling */
		var oversized_stamp = string_pos("Stamp ", string(item.name)) == 1
			&& (item.w > stamp_max_world_size || item.h > stamp_max_world_size);

		/* Invalid PNG data or oversized stamp placement rejects the image and closes its
		sender connection */
		if (!valid_source || oversized_stamp)
		{
			debug_server_reject_count++;
			debug_note("server image rejected", "PNG or stamp exceeds size limits");
			server.send_server_kick_to_slot(sender_slot, "Image rejected: PNG limit 2 MiB/4096 px per side; stamp PNGs and placements must fit 1024 px per side. Update your client and reconnect.");
			server.close_client_slot(sender_slot, "invalid drawing image size/header", true, true);
			return false;
		}

		/* The image's undo-author ownership must match the connected sender's assigned author
		namespace */
		if (!server_note_undo_author_slot(item, sender_slot, server.sockets[sender_slot]))
		{
			debug_server_reject_count++;
			debug_note("server image rejected", server_slot_label(sender_slot) + " author=" + string(command_undo_author_id(item)) + " " + debug_last_invalid_command);
			return false;
		}

		server_stamp_history_item_author(item, sender_slot);
		server_cancel_layer_vote_for_history_item(item);
		push_server_history(item);
		debug_server_accept_count++;
		debug_last_validated_payload = "I2|"
			+ string(item.image_id)
			+ "|" + string(item.layer_id)
			+ "|" + string(command_author_player_id(item))
			+ "|" + command_author_name(item)
			+ "|" + string(item.x)
			+ "," + string(item.y)
			+ " "
			+ string(item.w)
			+ "x"
			+ string(item.h);

		/* Accepted image content records gameplay activity when the server exposes that
		integration */
		if (variable_struct_exists(server, "note_client_gameplay_activity"))
		{
			server.note_client_gameplay_activity(sender_slot);
		}

		/* Queue the accepted image for recipients and keep the broadcaster's result */
		var broadcast_result = broadcast_image_history_item(item, sender_slot);
		debug_server_last_send_count = broadcast_result;

		/* A negative broadcast result records replication failure even though this image
		already entered authoritative history */
		if (broadcast_result < 0)
		{
			debug_server_broadcast_failures++;
			debug_note("server image broadcast failed", server_slot_label(sender_slot));
			return false;
		}

		debug_server_broadcast_count++;
		debug_note("server image broadcast", server_slot_label(sender_slot) + " " + item.name + " to " + string(broadcast_result));
		return true;
	}

	/// @description Validate trusted sender and chunk metadata, reserve layer content and assemble one upload per sender
	/// @param {Real} raw_slot Recipient or sender value resolved through the server slot helper
	/// @returns {Bool} Whether a valid partial upload or complete image acceptance was handled
	server_handle_image_chunk = function(raw_slot)
	{
		debug_server_received_count++;
		debug_server_last_slot = raw_slot;

		/* Borrow the server needed to resolve the packet's actual transport slot */
		var server = scr_get_server();

		/* Without its slot resolver the received image packet cannot establish trusted sender
		identity */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "slot_from_value"))
		{
			debug_server_reject_count++;
			debug_note("server image rejected", "server slot helper missing");
			return false;
		}

		/* Resolve actual sender identity from the transport-provided slot rather than trusting
		the packet header's claimed socket ID */
		var sender_slot = server.slot_from_value(raw_slot);
		debug_note("server read image", "actual=" + server_slot_label(sender_slot) + " header=" + server_slot_label(net.header.socketID));

		/* Read the sender's unsigned image upload identity */
		var image_id = net.read(buffer_u32);

		/* Read the requested stable target layer */
		var image_layer_id = net.read(buffer_u32);

		/* Read this chunk's zero-based index */
		var chunk_index = net.read(buffer_u16);

		/* Read the announced total chunk count */
		var chunk_count = net.read(buffer_u16);

		/* Read the proposed horizontal world origin */
		var image_x = net.read(buffer_s32);

		/* Read the proposed vertical world origin */
		var image_y = net.read(buffer_s32);

		/* Read proposed placement width */
		var image_w = net.read(buffer_s32);

		/* Read proposed placement height */
		var image_h = net.read(buffer_s32);

		/* Read the client-supplied author player ID, which acceptance later stamps from server
		authority */
		var image_author_id = net.read(buffer_s32);

		/* Read the client-supplied displayed author text for assembly consistency */
		var image_author_name = string(net.read(buffer_string));

		/* Read the claimed undo-author identity for its ownership check */
		var image_undo_author_id = net.read(buffer_u32);

		/* Read the claimed undo group */
		var image_undo_id = net.read(buffer_u32);

		/* Interpret any nonzero filtering byte as smooth filtering */
		var image_smooth_filter = net.read(buffer_u8) != 0;

		/* Read the diagnostic name used for assembly and stamp-specific limits */
		var image_name = string(net.read(buffer_string));

		/* Read this chunk's Base64 characters */
		var chunk_text = string(net.read(buffer_string));

		/* Reject an untrusted slot or invalid count, length, names, placement or layer
		identity before retaining this packet */
		if (sender_slot == noone
		|| chunk_count <= 0
		|| chunk_count > image_import_max_chunks
		|| chunk_index >= chunk_count
		|| string_length(chunk_text) <= 0 || string_length(chunk_text) > image_chunk_size
		|| (chunk_index < chunk_count - 1 && string_length(chunk_text) != image_chunk_size)
		|| string_length(image_author_name) > 96 || string_length(image_name) > 160
		|| image_x < 0 || image_x > room_width - 1
		|| image_y < 0 || image_y > room_height - 1
		|| image_w <= 0 || image_w > room_width
		|| image_h <= 0 || image_h > room_height
		|| image_layer_id <= 0)
		{
			debug_server_reject_count++;
			debug_note("server image rejected", "metadata id=" + string(image_id));
			return false;
		}

		/* A layer that stopped accepting drawing cannot retain an unfinished upload */
		if (!server_layer_accepts_content(image_layer_id))
		{
			/* Locate any existing assembly from this sender for the now-unavailable layer */
			var orphaned_pending_index = server_pending_image_index(sender_slot, image_id);

			/* Discard that assembly only when it exists */
			if (orphaned_pending_index != noone)
			{
				array_delete(server_pending_image_receives, orphaned_pending_index, 1);
			}
			debug_server_reject_count++;
			debug_note("server image rejected", "unavailable layer=" + string(image_layer_id));
			return false;
		}

		/* An assigned server undo-author namespace must agree with the packet's claimed
		undo-author ID */
		if (server_expected_undo_author_id(sender_slot) > 0
		&& image_undo_author_id != server_expected_undo_author_id(sender_slot))
		{
			debug_server_reject_count++;
			debug_note("server image rejected", server_slot_label(sender_slot) + " invalid author=" + string(image_undo_author_id));
			return false;
		}

		/* An image is locally applied before its chunks finish uploading. Reserve
		the target immediately and cancel archive/restore voting so the vote
		cannot commit between chunks and strand the sender's accepted edit */
		server_cancel_layer_vote_for_layer_content(image_layer_id);

		/* Single-chunk images can be validated and accepted without a server assembly */
		if (chunk_count == 1)
		{
			/* Build the complete image item for authoritative sender and PNG validation */
			var single_item = make_image_history_item(image_id, image_name, image_x, image_y, image_w, image_h, chunk_text, image_layer_id, image_undo_id, image_undo_author_id, image_author_id, image_author_name, image_smooth_filter);
			return server_accept_image_item(single_item, sender_slot);
		}

		/* Find this sender's assembly for the upload identity */
		var pending_index = server_pending_image_index(sender_slot, image_id);

		/* Assign a pending reference after selecting a new or existing assembly */
		var pending;

		/* An unseen image can begin server assembly only under first-chunk and per-sender
		rules */
		if (pending_index == noone)
		{
			/* A transfer must start at chunk zero */
			if (chunk_index != 0)
			{
				return false;
			}

			/* Inspect all pending assemblies to enforce one upload per sender */
			for (var pending_slot_index = 0; pending_slot_index < array_length(server_pending_image_receives); pending_slot_index++)
			{
				/* A sender with another pending image cannot allocate a second assembly */
				if (server_pending_image_receives[pending_slot_index].sender_slot == sender_slot)
				{
					debug_note("server image rejected", "another image upload is pending");
					return false;
				}
			}

			/* Resolve the authoritative target layer's record for immediate content
			reservation */
			var pending_state_index = server_layer_state_index(image_layer_id);

			/* An existing target marks content and advances revision before the remaining
			chunks arrive */
			if (pending_state_index != noone)
			{
				server_layer_states[pending_state_index].has_content = true;
				server_layer_states[pending_state_index].revision++;
			}

			/* The server assembly adds trusted sender_slot to retained image/count, placement,
			layer, supplied author/undo, filtering and name fields, empty chunk slots and
			millisecond start time */
			pending =
			{
				/* Keep actual transport sender identity separate from claimed packet author
				data */
				sender_slot: sender_slot,
				image_id: image_id,

				/* Keep the announced total encoded chunks */
				chunk_count: chunk_count,

				/* Start with zero distinct chunk slots received */
				received: 0,

				/* Retain the first packet's world placement rectangle across all later chunks */
				x: image_x,
				y: image_y,
				w: image_w,
				h: image_h,

				/* Retain the first packet's target layer and author/undo identity for
				consistency checks */
				layer_id: image_layer_id,
				author_player_id: image_author_id,
				author_name: image_author_name,
				undo_author_id: image_undo_author_id,
				undo_id: image_undo_id,

				/* Retain filtering and diagnostic name alongside those packet metadata fields */
				smooth_filter: image_smooth_filter,
				name: image_name,

				/* Allocate empty indexed Base64 chunk storage */
				chunks: array_create(chunk_count, ""),

				/* Record server assembly start in milliseconds for transfer diagnostics and
				lifecycle cleanup */
				started_at: current_time
			};
			pending_index = array_length(server_pending_image_receives);
			server_pending_image_receives[pending_index] = pending;
		}

		/* Reuse a matching sender/image assembly rather than allocating new chunk storage */
		else
		{
			pending = server_pending_image_receives[pending_index];
		}

		/* Reject and discard an assembly whose later metadata differs from its first chunk */
		if (pending.chunk_count != chunk_count
		|| pending.x != image_x
		|| pending.y != image_y
		|| pending.w != image_w
		|| pending.h != image_h
		|| pending.layer_id != image_layer_id
		|| pending.author_player_id != image_author_id
		|| pending.author_name != image_author_name
		|| pending.name != image_name
		|| pending.undo_author_id != image_undo_author_id
		|| pending.undo_id != image_undo_id
		|| pending.smooth_filter != image_smooth_filter)
		{
			array_delete(server_pending_image_receives, pending_index, 1);
			debug_server_reject_count++;
			debug_note("server image rejected", "metadata mismatch");
			return false;
		}

		/* Count a chunk only on its first stored delivery */
		if (pending.chunks[chunk_index] == "")
		{
			pending.chunks[chunk_index] = chunk_text;
			pending.received++;
		}

		/* Keep incomplete accepted uploads queued until all distinct chunks arrive */
		if (pending.received < pending.chunk_count)
		{
			debug_note("server image chunk", string(pending.received) + "/" + string(pending.chunk_count));
			return true;
		}

		/* Begin the final server PNG text empty before ordered chunk concatenation */
		var base64_text = "";

		/* Join chunks in numeric order to reconstruct the encoded image */
		for (var i = 0; i < pending.chunk_count; i++)
		{
			base64_text += pending.chunks[i];
		}

		/* Build the assembled image for final PNG validation, authority stamping and broadcast
		queueing */
		var item = make_image_history_item(pending.image_id, pending.name, pending.x, pending.y, pending.w, pending.h, base64_text, pending.layer_id, pending.undo_id, pending.undo_author_id, pending.author_player_id, pending.author_name, pending.smooth_filter);
		array_delete(server_pending_image_receives, pending_index, 1);
		return server_accept_image_item(item, sender_slot);
	}

	/// @description Write image metadata and one encoded-text chunk into the active outgoing image packet
	/// @param {Struct} item Complete image history record
	/// @param {Real} chunk_index Zero-based index in encoded-image chunks
	/// @param {Real} chunk_count Total announced chunks, computed from item when undefined
	/// @param {String} chunk_text Up to image_chunk_size Base64 characters for this packet
	/// @param {Real} sender_id Packet header sender identity, noone for server-origin packets. Defaults to noone
	write_image_chunk_packet = function(item, chunk_index, chunk_count, chunk_text, sender_id = noone)
	{
		net.start(N_DRAW_IMAGE, sender_id);
		net.write(buffer_u32, item.image_id);

		/* Serialize an explicit image layer ID, falling back to layer 1 for older image
		records */
		net.write(buffer_u32, variable_struct_exists(item, "layer_id") ? item.layer_id : 1);
		net.write(buffer_u16, chunk_index);
		net.write(buffer_u16, chunk_count);
		net.write(buffer_s32, item.x);
		net.write(buffer_s32, item.y);
		net.write(buffer_s32, item.w);
		net.write(buffer_s32, item.h);
		net.write(buffer_s32, command_author_player_id(item));
		net.write(buffer_string, command_author_name(item));
		net.write(buffer_u32, command_undo_author_id(item));
		net.write(buffer_u32, command_undo_id(item));

		/* Serialize smooth filtering as one only when explicitly enabled, otherwise zero */
		net.write(buffer_u8, (variable_struct_exists(item, "smooth_filter") && item.smooth_filter) ? 1 : 0);
		net.write(buffer_string, item.name);
		net.write(buffer_string, chunk_text);
	}

	/// @description Count fixed-size Base64 character chunks with a minimum one for image history
	/// @param {Struct} item Complete image history record
	/// @returns {Real} Positive chunk count, or -1 for non-image history
	image_history_chunk_count = function(item)
	{
		/* Only image history has an encoded-image chunk count */
		if (!history_item_is_image(item))
		{
			return -1;
		}

		return max(1, ceil(string_length(string(item.base64)) / image_chunk_size));
	}

	/// @description Send one reliable image chunk using the recipient's current socket and transport
	/// @param {Struct} item Complete image history record
	/// @param {Real} raw_slot Recipient or sender value resolved through the server slot helper
	/// @param {Real} chunk_index Zero-based index in encoded-image chunks
	/// @param {Real} chunk_count Total announced chunks, computed from item when undefined. Defaults to undefined
	/// @returns {Real} 1 for an accepted packet write, or -1 after validation or transport failure
	send_image_history_chunk_to_slot = function(item, raw_slot, chunk_index, chunk_count = undefined)
	{
		/* Borrow the server's recipient sockets and transport choices */
		var server = scr_get_server();

		/* One server chunk needs image history and both recipient socket and transport arrays
		plus the slot resolver */
		if (!history_item_is_image(item)
		|| !is_struct(server)
		|| !variable_struct_exists(server, "slot_from_value")
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "slot_transports")
		|| !is_array(server.sockets)
		|| !is_array(server.slot_transports))
		{
			return -1;
		}

		/* Resolve the target transport slot from the caller's recipient value */
		var slot = server.slot_from_value(raw_slot);

		/* Require a connected slot within both arrays before serializing its packet */
		if (slot == noone
		|| slot < 0
		|| slot >= array_length(server.sockets)
		|| slot >= array_length(server.slot_transports)
		|| server.sockets[slot] == noone)
		{
			return -1;
		}

		/* Read the image's Base64 text for its fixed-character chunk slice */
		var base64_text = string(item.base64);

		/* Use an explicit announced count when supplied, otherwise calculate it from encoded
		text */
		var total_chunks = is_undefined(chunk_count) ? image_history_chunk_count(item) : chunk_count;

		/* Require a permitted total chunk count and a zero-based index inside that total */
		if (total_chunks <= 0 || total_chunks > image_import_max_chunks
		|| chunk_index < 0 || chunk_index >= total_chunks)
		{
			return -1;
		}

		/* Convert this chunk's zero-based position into its one-based Base64 string start */
		var chunk_start = chunk_index * image_chunk_size + 1;

		/* Take one configured chunk's characters, with a shorter final slice when needed */
		var chunk_text = string_copy(base64_text, chunk_start, image_chunk_size);
		write_image_chunk_packet(item, chunk_index, total_chunks, chunk_text);

		/* Keep the reliable transport result using this recipient's selected transport */
		var send_result = net.send(server.sockets[slot], true, server.slot_transports[slot]);

		/* A negative write records its chunk position and returns the failure sentinel */
		if (send_result < 0)
		{
			debug_server_history_sync_detail = "image send failed " + server_slot_label(slot) + " chunk=" + string(chunk_index + 1) + "/" + string(total_chunks);
			return -1;
		}

		debug_server_history_sync_detail = "image " + server_slot_label(slot) + " chunk=" + string(chunk_index + 1) + "/" + string(total_chunks);

		/* A nonnegative transport write counts as one accepted chunk packet, rather than
		returning its byte count */
		return 1;
	}
	#endregion /* Chunked Image Replication END */

	#region /* Server History Transfer Jobs */
	/// @description Copy authoritative history order into a new array while retaining its item struct references
	/// @returns {Array} Independent array container with the existing ordered history items
	copy_server_history_snapshot = function()
	{
		/* Snapshot the authoritative item count before copying its array positions */
		var history_count = array_length(server_history);

		/* Allocate an independent array container while retaining references to the existing
		history item structs */
		var snapshot = array_create(history_count);

		/* Copy each authoritative entry in order without cloning its struct or nested
		resources */
		for (var i = 0; i < history_count; i++)
		{
			snapshot[i] = server_history[i];
		}

		return snapshot;
	}

	/// @description Locate the first transfer job for a logical recipient slot
	/// @param {Real} slot Logical recipient client slot
	/// @returns {Real} Zero-based job index or noone
	history_sync_job_index_for_slot = function(slot)
	{
		/* Search transfer jobs for the first valid record targeting this logical slot */
		for (var job_index = 0; job_index < array_length(server_history_sync_jobs); job_index++)
		{
			/* Borrow the current job while checking its required slot field */
			var job = server_history_sync_jobs[job_index];

			/* A struct with the matching slot identifies its zero-based queue position */
			if (is_struct(job)
			&& variable_struct_exists(job, "slot")
			&& job.slot == slot)
			{
				return job_index;
			}
		}

		/* An unmatched slot has no current transfer job */
		return noone;
	}

	/// @description Check for an ordered job whose retained transfer reason is join
	/// @param {Real} slot Logical recipient client slot
	/// @returns {Bool} Whether joining transfer work remains for the slot
	history_join_sync_active_for_slot = function(slot)
	{
		/* Inspect transfer jobs to identify a joining batch for this slot */
		for (var job_index = 0; job_index < array_length(server_history_sync_jobs); job_index++)
		{
			/* Borrow the current job's slot and reason fields */
			var job = server_history_sync_jobs[job_index];

			/* Only a matching slot with reason join counts as active joining synchronization */
			if (is_struct(job)
			&& variable_struct_exists(job, "slot")
			&& variable_struct_exists(job, "reason")
			&& job.slot == slot
			&& string(job.reason) == "join")
			{
				return true;
			}
		}

		/* No matching join reason leaves the slot outside a joining batch */
		return false;
	}

	/// @description Send the reliable zero-count history terminator to a connected recipient
	/// @param {Real} slot Logical recipient client slot
	/// @returns {Real} Transport byte result, or -1 for an invalid recipient
	server_send_history_sync_complete_to_slot = function(slot)
	{
		/* Borrow recipient socket and transport state for the explicit history terminator */
		var server = scr_get_server();

		/* A connected recipient within both arrays is required before writing its terminator */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "slot_transports")
		|| slot < 0
		|| slot >= array_length(server.sockets)
		|| slot >= array_length(server.slot_transports)
		|| server.sockets[slot] == noone)
		{
			return -1;
		}

		/* A zero-count legacy history packet is a no-op for existing clients and an
		explicit batch terminator for clients that understand checkpoint sync */
		net.start(N_DRAW_HISTORY, noone);
		net.write(buffer_u16, 0);
		return net.send(server.sockets[slot], true, server.slot_transports[slot]);
	}

	/// @description Append ordered history to a slot transfer job. Joining empty history sends its completion packet immediately
	/// @param {Real} raw_slot Logical client slot validated by the server slot lookup
	/// @param {Array} history_items History items to enqueue in their existing order
	/// @param {String} reason Transfer reason. Join requests receive an explicit completion packet. Defaults to "history"
	/// @returns {Real} Number of queued items, zero for empty history, or -1 on validation or send failure
	queue_history_sync_items_to_slot = function(raw_slot, history_items, reason = "history")
	{
		/* Borrow server transport state and slot resolution before accepting queued history */
		var server = scr_get_server();

		/* Queueing requires valid socket and transport arrays plus an actual history item
		array */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "slot_from_value")
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "slot_transports")
		|| !is_array(server.sockets)
		|| !is_array(server.slot_transports)
		|| !is_array(history_items))
		{
			return -1;
		}

		/* Resolve the logical destination from the caller's slot value */
		var slot = server.slot_from_value(raw_slot);

		/* An unresolved or disconnected recipient cannot own a history transfer job */
		if (slot == noone
		|| slot < 0
		|| slot >= array_length(server.sockets)
		|| slot >= array_length(server.slot_transports)
		|| server.sockets[slot] == noone)
		{
			debug_server_last_history_slot = raw_slot;
			debug_server_last_history_sync = -1;
			debug_server_history_sync_detail = "queue failed bad slot/socket " + string(raw_slot);
			debug_note("server history failed", debug_server_history_sync_detail);
			return -1;
		}

		/* Count requested items to distinguish empty joining completion from an actual
		transfer job */
		var history_count = array_length(history_items);
		debug_server_last_history_slot = slot;

		/* Empty history needs no queue allocation */
		if (history_count <= 0)
		{
			/* A join reason sends the terminator immediately, while other empty transfers need
			no packet */
			var complete_result = string(reason) == "join"
				? server_send_history_sync_complete_to_slot(slot)
				: 0;

			/* Record empty transfer success as zero or a failed completion write as -1 */
			debug_server_last_history_sync = complete_result < 0 ? -1 : 0;

			/* Choose failure or ordinary empty-history diagnostics from that completion result */
			debug_server_history_sync_detail = (complete_result < 0 ? "empty history completion failed " : "empty history ")
				+ server_slot_label(slot);

			/* Return -1 only for failed explicit completion, otherwise zero queued items */
			return complete_result < 0 ? -1 : 0;
		}

		/* Locate any existing ordered transfer for this recipient */
		var existing_job_index = history_sync_job_index_for_slot(slot);

		/* Append to an existing job so live edits cannot overtake its earlier joining or image
		history */
		if (existing_job_index != noone)
		{
			/* Borrow the recipient's current transfer job and append to its retained history
			array */
			var existing_job = server_history_sync_jobs[existing_job_index];

			/* Append all requested items in their existing order */
			for (var append_index = 0; append_index < history_count; append_index++)
			{
				existing_job.history[array_length(existing_job.history)] = history_items[append_index];
			}
			debug_server_last_history_sync = existing_job.sent_items;
			debug_server_history_sync_detail = string(reason) + " appended " + string(history_count)
				+ " item(s) for " + server_slot_label(slot);
			return history_count;
		}

		/* The job owns recipient slot and history-array references, starts item and
		image-chunk cursors and sent count at zero, retains reason and millisecond start,
		and starts without failures or a retry deadline */
		var job =
		{
			slot: slot,
			history: history_items,
			history_index: 0,
			image_chunk_index: 0,
			sent_items: 0,
			reason: string(reason),
			started_at: current_time,
			failures: 0,
			retry_at: 0
		};

		server_history_sync_jobs[array_length(server_history_sync_jobs)] = job;
		debug_server_history_sync_jobs = array_length(server_history_sync_jobs);
		debug_server_last_history_sync = 0;
		debug_server_history_sync_detail = string(reason) + " queued " + string(history_count) + " item(s) for " + server_slot_label(slot);
		debug_note("server history queued", debug_server_history_sync_detail);
		return history_count;
	}

	/// @description Remove the caller-validated transfer queue index and update queue-count diagnostics
	/// @param {Real} job_index Caller-validated zero-based server transfer job index
	remove_history_sync_job = function(job_index)
	{
		array_delete(server_history_sync_jobs, job_index, 1);
		debug_server_history_sync_jobs = array_length(server_history_sync_jobs);
	}

	/// @description Remove jobs for a resolved logical slot and record an optional cancellation reason
	/// @param {Real} raw_slot Client slot value normalized by available server integration
	/// @param {String} reason Transfer cancellation reason recorded in diagnostics. Defaults to ""
	/// @returns {Real} Count of removed jobs
	cancel_history_sync_jobs_for_slot = function(raw_slot, reason = "")
	{
		/* Borrow the server slot resolver when available for this cancellation request */
		var server = scr_get_server();

		/* Begin with the caller's slot value so cancellation can still match a direct slot
		without server integration */
		var slot = raw_slot;

		/* Use the server's normalization helper when that integration is available */
		if (is_struct(server)
		&& variable_struct_exists(server, "slot_from_value"))
		{
			slot = server.slot_from_value(raw_slot);
		}

		/* An absent slot identifies no transfer jobs to cancel */
		if (slot == noone)
		{
			return 0;
		}

		/* Count cancelled jobs from zero for diagnostics and the return value */
		var removed_count = 0;

		/* Delete matching jobs backwards so array shifts cannot skip an unvisited entry */
		for (var job_index = array_length(server_history_sync_jobs) - 1; job_index >= 0; job_index--)
		{
			/* Borrow this job to inspect its logical recipient slot */
			var job = server_history_sync_jobs[job_index];

			/* Remove only valid records belonging to the resolved slot */
			if (is_struct(job)
			&& variable_struct_exists(job, "slot")
			&& job.slot == slot)
			{
				array_delete(server_history_sync_jobs, job_index, 1);
				removed_count++;
			}
		}

		/* Update queue and cancellation diagnostics only when this call removed jobs */
		if (removed_count > 0)
		{
			debug_server_history_sync_jobs = array_length(server_history_sync_jobs);
			debug_server_history_sync_detail = "cancelled " + string(removed_count) + " job(s) for slot=" + string(slot) + " reason=" + string(reason);
			debug_note("server history cancelled", debug_server_history_sync_detail);
		}

		return removed_count;
	}

	/// @description Advance one image chunk or primitive packet, or complete a joined history transfer
	/// @param {Struct} job Mutable transfer state with ordered history and persistent cursors
	/// @returns {Real} -1 for failure, 0 for completion, or 1 for progress, including skipped empty collections
	send_history_sync_job_step = function(job)
	{
		/* Borrow the server transport arrays before advancing one queued packet */
		var server = scr_get_server();

		/* A valid server and job history array are required to serialize this job's next
		operation */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "sockets")
		|| !variable_struct_exists(server, "slot_transports")
		|| !is_array(server.sockets)
		|| !is_array(server.slot_transports)
		|| !is_struct(job)
		|| !variable_struct_exists(job, "history")
		|| !is_array(job.history))
		{
			return -1;
		}

		/* Read the job's retained logical recipient slot */
		var slot = job.slot;

		/* An invalid or disconnected slot cannot receive further history */
		if (slot == noone
		|| slot < 0
		|| slot >= array_length(server.sockets)
		|| slot >= array_length(server.slot_transports)
		|| server.sockets[slot] == noone)
		{
			debug_server_history_sync_detail = "job failed bad slot/socket " + string(slot);
			return -1;
		}

		/* Borrow this job's ordered history array while its cursor advances */
		var history_items = job.history;

		/* Count currently retained entries, including live edits appended behind the original
		snapshot */
		var history_count = array_length(history_items);

		/* A cursor at the end can complete the job rather than sending another history item */
		if (job.history_index >= history_count)
		{
			/* A join job must successfully send its explicit zero-count terminator before
			reporting completion */
			if (variable_struct_exists(job, "reason") && string(job.reason) == "join"
			&& server_send_history_sync_complete_to_slot(slot) < 0)
			{
				debug_server_history_sync_detail = "completion send failed " + server_slot_label(slot);
				return -1;
			}

			/* After a successful join terminator, send any current shared vote state to this
			newly synchronized recipient */
			if (variable_struct_exists(job, "reason") && string(job.reason) == "join"
			&& is_struct(server_active_layer_vote))
			{
				server_send_active_layer_vote_to_slot(slot);
			}
			debug_server_last_history_sync = job.sent_items;
			debug_server_history_sync_detail = "complete slot=" + string(slot) + " item(s)=" + string(job.sent_items);

			/* Zero signals completed work so the outer queue can remove this job */
			return 0;
		}

		/* Borrow the item at the persistent history cursor */
		var history_item = history_items[job.history_index];

		/* Images advance one encoded chunk per job step while keeping the item cursor until
		the last chunk */
		if (history_item_is_image(history_item))
		{
			/* Count the current image's encoded chunks before sending it */
			var total_chunks = image_history_chunk_count(history_item);

			/* Invalid or over-limit image chunk counts fail the job */
			if (total_chunks <= 0 || total_chunks > image_import_max_chunks)
			{
				debug_server_history_sync_detail = "image too many chunks " + server_slot_label(slot) + " chunks=" + string(total_chunks);
				return -1;
			}

			/* Keep whether this recipient's current image chunk was accepted by its transport */
			var image_result = send_image_history_chunk_to_slot(history_item, slot, job.image_chunk_index, total_chunks);

			/* A failed chunk ends this step without advancing image or item cursors */
			if (image_result < 0)
			{
				return -1;
			}

			job.image_chunk_index++;

			/* The final image chunk advances the history cursor and completed-item count,
			resetting the chunk cursor for the next image */
			if (job.image_chunk_index >= total_chunks)
			{
				job.history_index++;
				job.image_chunk_index = 0;
				job.sent_items++;
			}

			job.failures = 0;
			job.retry_at = 0;
			debug_server_last_history_sync = job.sent_items;
			return 1;
		}

		/* Begin a primitive packet with zero announced items before collecting consecutive
		non-image history */
		var command_count = 0;

		/* Collect only consecutive non-image entries up to the protocol packet cap and before
		history ends */
		while (job.history_index + command_count < history_count
		&& command_count < history_chunk_size
		&& !history_item_is_image(history_items[job.history_index + command_count]))
		{
			command_count++;
		}

		/* A zero-sized collection skips this history position and reports progress without
		writing an empty packet */
		if (command_count <= 0)
		{
			job.history_index++;
			return 1;
		}

		net.start(N_DRAW_HISTORY, noone);
		net.write(buffer_u16, command_count);

		/* Serialize each collected history entry in its existing order */
		for (var i = 0; i < command_count; i++)
		{
			/* Borrow the entry at this packet's relative offset from the persistent history
			cursor */
			var command_history_item = history_items[job.history_index + i];

			/* Convert that entry to its primitive, structural or undo payload representation */
			var command_payload = history_item_payload_string(command_history_item);
			write_command_payload(command_payload);
		}

		/* Keep the reliable write result using this recipient's selected transport */
		var send_result = net.send(server.sockets[slot], true, server.slot_transports[slot]);

		/* A failed packet leaves the persistent cursor unchanged and reports job failure */
		if (send_result < 0)
		{
			debug_server_history_sync_detail = "command send failed " + server_slot_label(slot) + " count=" + string(command_count);
			return -1;
		}

		job.history_index += command_count;
		job.sent_items += command_count;
		job.failures = 0;
		job.retry_at = 0;
		debug_server_last_history_sync = job.sent_items;
		debug_server_history_sync_detail = "commands " + server_slot_label(slot) + " count=" + string(command_count);
		return 1;
	}

	/// @description Advance checkpoint, persistence, vote, and budgeted history transfer work during each server update
	update_server_network = function()
	{
		update_server_history_checkpoint();
		update_server_history_persistence();
		server_update_active_layer_vote();

		/* Use the configured per-step packet allowance for all queued recipients */
		var budget = server_history_sync_packets_per_step;

		/* Count consecutive retry-delayed jobs to detect one complete pass with no runnable
		recipient */
		var skipped_retry_jobs = 0;

		/* Continue while packet allowance remains and the transfer queue is nonempty */
		while (budget > 0 && array_length(server_history_sync_jobs) > 0)
		{
			/* Take the front job for this round-robin work step */
			var job = server_history_sync_jobs[0];

			/* A job with a future millisecond retry deadline is not runnable yet */
			if (is_struct(job)
			&& variable_struct_exists(job, "retry_at")
			&& job.retry_at > current_time)
			{
				skipped_retry_jobs++;

				/* Move a delayed job to the tail when another job may be runnable */
				if (array_length(server_history_sync_jobs) > 1)
				{
					array_delete(server_history_sync_jobs, 0, 1);
					server_history_sync_jobs[array_length(server_history_sync_jobs)] = job;

					/* Continue scanning only until every queued job has been skipped once */
					if (skipped_retry_jobs < array_length(server_history_sync_jobs))
					{
						continue;
					}
				}

				/* A single delayed job or a full delayed pass ends this update without
				spending packet budget */
				break;
			}

			skipped_retry_jobs = 0;

			/* Keep the job step's negative failure, zero completion or positive progress
			result */
			var step_result = send_history_sync_job_step(job);

			/* A failed transfer removes its job and closes the affected recipient rather than
			retrying a possibly partial stream frame */
			if (step_result < 0)
			{
				/* Extract a usable failed recipient when the job is structured, otherwise use
				noone */
				var failed_slot = is_struct(job) && variable_struct_exists(job, "slot") ? job.slot : noone;

				/* Preserve the detailed send diagnostic before queue removal or connection
				cleanup changes other state */
				var failure_detail = debug_server_history_sync_detail;

				debug_server_last_history_sync = -1;
				debug_server_history_sync_detail = failure_detail;
				debug_note("server history failed", debug_server_history_sync_detail);
				remove_history_sync_job(0);

				/* Borrow the server for recipient cleanup after this job is removed */
				var server = scr_get_server();

				/* Close the client only when the server exposes that method and a recipient
				slot was retained */
				if (is_struct(server)
				&& variable_struct_exists(server, "close_client_slot")
				&& failed_slot != noone)
				{
					server.close_client_slot(failed_slot, "drawing history sync failed: " + debug_server_history_sync_detail, true, true);
				}
			}

			/* A completed transfer is removed without consuming another progress packet from
			this frame's allowance */
			else if (step_result == 0)
			{
				debug_note("server history sync", debug_server_history_sync_detail);
				remove_history_sync_job(0);
			}

			/* A progressing job retains its cursors and consumes one packet allowance */
			else
			{
				/* Rotate progressing jobs when more recipients are queued so a large image
				cannot monopolize transfers */
				if (array_length(server_history_sync_jobs) > 1)
				{
					array_delete(server_history_sync_jobs, 0, 1);
					server_history_sync_jobs[array_length(server_history_sync_jobs)] = job;
				}
				debug_server_history_sync_jobs = array_length(server_history_sync_jobs);
				budget--;
			}
		}
	}

	/// @description Queue an image in recipient order, retaining origin echoes behind existing transfers and closing failed queues
	/// @param {Struct} item Accepted complete image history
	/// @param {Real} exception Origin slot skipped only when it has no ordered job, or noone for no exception. Defaults to noone
	/// @returns {Real} Queued recipient count, or -1 if any recipient queue failed
	broadcast_image_history_item = function(item, exception = noone)
	{
		/* Borrow recipient socket state for queueing this accepted image broadcast */
		var server = scr_get_server();

		/* Broadcasting needs an image item and server socket list */
		if (!history_item_is_image(item)
		|| !is_struct(server)
		|| !variable_struct_exists(server, "sockets"))
		{
			return -1;
		}

		/* Count recipients whose ordered transfer queue accepted this image */
		var send_count = 0;

		/* Retain failed recipient slots for connection cleanup after the socket iteration */
		var failed_slots = [];

		/* Visit each logical server slot in order */
		for (var slot = 0; slot < array_length(server.sockets); slot++)
		{
			/* Skip disconnected slots with no recipient socket */
			if (server.sockets[slot] == noone)
			{
				continue;
			}

			/* Skip the originating exception only when it has no ongoing ordered transfer,
			otherwise append its echo behind that transfer */
			if (slot == exception && history_sync_job_index_for_slot(slot) == noone)
			{
				continue;
			}

			/* Queue this image behind any earlier history for the recipient */
			var result = queue_history_sync_items_to_slot(slot, [item], "image broadcast");

			/* A rejected queue request records its recipient for cleanup instead of
			incrementing accepted count */
			if (result < 0)
			{
				failed_slots[array_length(failed_slots)] = slot;
				continue;
			}

			send_count++;
		}

		/* Close failed recipients after queue iteration so connection cleanup cannot disrupt
		the original socket walk */
		for (var i = 0; i < array_length(failed_slots); i++)
		{
			/* Cleanup closes recipients only when the server exposes its close method */
			if (variable_struct_exists(server, "close_client_slot"))
			{
				server.close_client_slot(failed_slots[i], "queueing imported drawing image", true, true);
			}
		}

		/* Any failed recipient makes the result -1, otherwise return the count of successfully
		queued recipients */
		return array_length(failed_slots) > 0 ? -1 : send_count;
	}
	#endregion /* Server History Transfer Jobs END */

	#region /* Server Drawing Controls */
	/// @description Pick and cache a desktop PNG, validate and decode-check it, then record server-authored history and queue broadcast
	/// @returns {Bool} Whether authoritative import completed, including imports whose broadcast result is only logged as failed
	server_import_png_from_dialog = function()
	{
		server_import_debug_clear();
		server_import_debug_add("PNG IMPORT DEBUG", "started " + string(current_time));
		server_import_debug_add("os", "os_type=" + string(os_type) + " os_browser=" + string(os_browser));
		server_import_debug_add("limits", "bytes<=" + string(image_import_max_bytes) + " sprite<=" + string(image_import_max_sprite_dimension) + " room=" + string(room_width) + "x" + string(room_height));

		/* Prepare an import cache before showing the desktop picker so its Linux fallback has
		a readable destination */
		if (!ensure_image_import_folder())
		{
			set_server_import_status("Could not prepare import cache.", make_color_rgb(244, 84, 84));
			server_import_debug_add("result", "ensure_image_import_folder failed before picker");
			return false;
		}

		/* Build a temporary cache destination using the next server import identity */
		var linux_cache_path = image_import_temp_path(next_image_import_id);

		/* Ask the platform picker for a selected PNG and a runner-readable path, allowing its
		Linux cache preparation */
		var picked_file = scr_desktop_pick_png(linux_cache_path);

		/* Keep the user's original selected path for diagnostics even if the readable path
		differs */
		var raw_file_path = picked_file.selected_path;

		/* Clean the picker-provided readable path before cache copying */
		var file_path = image_import_clean_path(picked_file.readable_path);
		server_import_debug_add("picker raw", raw_file_path);
		server_import_debug_add("picker clean", file_path);

		/* A cancelled picker or empty readable path ends the import without allocating PNG
		resources */
		if (file_path == "")
		{
			server_import_debug_add("result", "cancelled or empty path");
			return false;
		}

		/* Track the loaded file buffer owned by this attempt, starting without a resource */
		var file_buffer = noone;

		/* Track a temporary decode-check sprite so success and exception paths can release it */
		var imported_sprite = noone;

		/* Start without a retained cache path until the selected filename is sanitized and
		resolved */
		var import_path = "";
		try
		{
			server_import_debug_add("game_save_id", game_save_id);
			server_import_debug_add("import folder", image_import_temp_folder());

			/* Recheck cache readiness after the dialog before copying the chosen PNG */
			if (!ensure_image_import_folder())
			{
				set_server_import_status("Could not prepare import cache.", make_color_rgb(244, 84, 84));
				server_import_debug_add("result", "ensure_image_import_folder failed");
				return false;
			}
			server_import_debug_add("folder exists", string(directory_exists(image_import_temp_folder())));

			import_path = image_import_cache_path(file_path);
			server_import_debug_add("cache path", import_path);
			server_import_debug_add("path lengths", "source=" + string(string_length(file_path)) + " cache=" + string(string_length(import_path)));

			/* Show whether normalized source and cache paths compare equal without letter
			case, explaining a possible copy bypass */
			server_import_debug_add("source equals cache", string(string_lower(screenshot_normalize_path(file_path)) == string_lower(screenshot_normalize_path(import_path))));
			server_import_debug_add("source file_exists", string(file_exists(file_path)));
			server_import_debug_add("cache existed before", string(file_exists(import_path)));

			/* A failed source-to-cache copy stops import while leaving its diagnostic and any
			retained cache file available */
			if (!image_import_copy_to_cache(file_path, import_path))
			{
				set_server_import_status("Could not copy PNG into imports folder.", make_color_rgb(244, 84, 84));
				debug_note("PNG import failed", "copy failed " + file_path);
				server_import_debug_add("result", "copy to cache failed");
				return false;
			}
			server_import_debug_add("copy result", "cache exists=" + string(file_exists(import_path)));

			file_buffer = buffer_load(import_path);
			server_import_debug_add("buffer_load cache", string(buffer_exists(file_buffer)));

			/* The cached PNG must load into a live buffer before header inspection */
			if (!buffer_exists(file_buffer))
			{
				set_server_import_status("Copied, but could not read cached PNG.", make_color_rgb(244, 84, 84));
				debug_note("PNG import failed", "cache unreadable " + import_path);
				server_import_debug_add("result", "buffer_load(import_path) failed");
				return false;
			}

			/* Measure cached file bytes against the server's import-byte ceiling */
			var file_size = buffer_get_size(file_buffer);
			server_import_debug_add("buffer size", string(file_size));

			/* Empty or over-limit files release their buffer before reporting rejection */
			if (file_size <= 0 || file_size > image_import_max_bytes)
			{
				buffer_delete(file_buffer);
				file_buffer = noone;
				set_server_import_status("Copied, but PNG must be 2 MB or smaller.", make_color_rgb(244, 84, 84));
				server_import_debug_add("result", "file size rejected");
				return false;
			}

			/* Inspect signature, IHDR fields and declared dimensions for import validation and
			debug details */
			var png_info = png_dimensions_from_buffer(file_buffer);
			server_import_debug_add("png header", "ok=" + string(png_info.ok) + " size=" + string(png_info.w) + "x" + string(png_info.h) + " reason=" + png_info.reason);
			server_import_debug_add("png ihdr", "bit=" + string(png_info.bit_depth) + " color=" + string(png_info.color_type) + " comp=" + string(png_info.compression) + " filter=" + string(png_info.filter) + " interlace=" + string(png_info.interlace));

			/* An invalid PNG header releases its buffer and stops sprite loading */
			if (!png_info.ok)
			{
				buffer_delete(file_buffer);
				file_buffer = noone;
				set_server_import_status("Copied, but PNG header is invalid.", make_color_rgb(244, 84, 84));
				debug_note("PNG import failed", png_info.reason);
				server_import_debug_add("result", "png header rejected");
				return false;
			}

			/* Declared source dimensions above the maximum sprite side length are rejected
			before decoding */
			if (png_info.w > image_import_max_sprite_dimension
			|| png_info.h > image_import_max_sprite_dimension)
			{
				buffer_delete(file_buffer);
				file_buffer = noone;
				set_server_import_status(
					"Copied, but too large: "
					+ string(png_info.w) + "x" + string(png_info.h)
					+ " max " + string(image_import_max_sprite_dimension) + "x" + string(image_import_max_sprite_dimension) + ".",
					make_color_rgb(255, 220, 95)
				);
				debug_note("PNG import too large", string(png_info.w) + "x" + string(png_info.h));
				server_import_debug_add("result", "sprite dimension rejected");
				return false;
			}

			/* Server imports retain their source dimensions, so both sides must also fit the
			room */
			if (png_info.w > room_width || png_info.h > room_height)
			{
				buffer_delete(file_buffer);
				file_buffer = noone;
				set_server_import_status("Copied, but PNG must fit inside the room.", make_color_rgb(244, 84, 84));
				server_import_debug_add("result", "room dimension rejected");
				return false;
			}

			/* Encode accepted cached PNG bytes into the history's portable Base64 contents */
			var base64_text = buffer_base64_encode(file_buffer, 0, file_size);

			/* Build a PNG data URL for this import's first sprite decode attempt */
			var data_url = image_base64_data_url(base64_text);
			server_import_debug_add("base64 length", string(string_length(base64_text)));
			server_import_debug_add("data url length", string(string_length(data_url)));
			try
			{
				imported_sprite = sprite_add(data_url, 1, false, false, 0, 0);
				server_import_debug_add("sprite_add data", "index=" + string(imported_sprite) + " exists=" + string(image_sprite_exists(imported_sprite)));
			}

			/* Record a data-URL sprite exception and retain no accepted sprite from that
			attempt */
			catch(sprite_error)
			{
				server_import_debug_add("sprite_add data exception", server_import_debug_error_message(sprite_error));
				imported_sprite = noone;
			}

			/* A missing data-URL sprite triggers a diagnostic filename load before rejecting
			the import */
			if (!image_sprite_exists(imported_sprite))
			{
				/* Own a separate diagnostic path-loaded sprite, beginning without a resource */
				var path_sprite = noone;
				try
				{
					path_sprite = sprite_add(import_path, 1, false, false, 0, 0);
					server_import_debug_add("sprite_add path", "index=" + string(path_sprite) + " exists=" + string(image_sprite_exists(path_sprite)));

					/* Release a successfully created diagnostic sprite because this path does
					not accept it as the import result */
					if (image_sprite_exists(path_sprite))
					{
						sprite_delete(path_sprite);
					}
				}

				/* Retain diagnostic filename-loader exception text without replacing the
				import's decode-failure outcome */
				catch(path_sprite_error)
				{
					server_import_debug_add("sprite_add path exception", server_import_debug_error_message(path_sprite_error));
				}

				buffer_delete(file_buffer);
				file_buffer = noone;
				set_server_import_status("Copied, but GameMaker could not decode PNG data.", make_color_rgb(244, 84, 84));
				debug_note("PNG sprite decode failed", image_name_from_path(import_path));
				server_import_debug_add("result", "sprite decode failed");
				return false;
			}

			/* Keep the validated PNG width as its final unscaled world-pixel placement width */
			var image_w = png_info.w;

			/* Keep its validated height as placement height before releasing the decode-check
			sprite */
			var image_h = png_info.h;
			server_import_debug_add("sprite accepted", string(image_w) + "x" + string(image_h));
			sprite_delete(imported_sprite);
			imported_sprite = noone;

			buffer_delete(file_buffer);
			file_buffer = noone;

			server_ensure_default_layer_state();

			/* Begin without an import layer until the topmost unarchived server layer is found */
			var import_layer_id = noone;

			/* Search authoritative layers backwards so import targets the highest active layer */
			for (var import_layer_index = array_length(server_layer_states) - 1; import_layer_index >= 0; import_layer_index--)
			{
				/* Choose the first unarchived layer and retain its stable ID */
				if (!server_layer_states[import_layer_index].archived)
				{
					import_layer_id = server_layer_states[import_layer_index].id;
					break;
				}
			}

			/* A server without an active paint layer cannot place this image history */
			if (import_layer_id == noone)
			{
				set_server_import_status("Could not find an active paint layer.", make_color_rgb(244, 84, 84));
				server_import_debug_add("result", "no active server layer");
				return false;
			}

			/* Build server-authored image history at room origin with the cached filename,
			native dimensions and no client undo group */
			var item = make_image_history_item(
				next_image_import_id,
				image_name_from_path(import_path),
				0,
				0,
				image_w,
				image_h,
				base64_text,
				import_layer_id,
				0,
				0,
				noone,
				"Server"
			);
			next_image_import_id++;
			server_cancel_layer_vote_for_history_item(item);
			push_server_history(item);

			/* Queue the already recorded import for all connected recipients and retain its
			broadcast result for diagnostics */
			var broadcast_result = broadcast_image_history_item(item);
			set_server_import_status("Imported: " + item.name, make_color_rgb(94, 215, 122));
			debug_note("server imported image", item.name + " broadcast=" + string(broadcast_result));
			server_import_debug_add("broadcast", string(broadcast_result));
			server_import_debug_add("result", "success");

			/* Report authoritative import success after recording history, even when its
			separately logged broadcast result is negative */
			return true;
		}

		/* An unexpected import exception releases still-owned PNG buffer and decode-check
		sprite resources */
		catch(e)
		{
			/* Delete the file buffer only if this attempt still holds a live allocation */
			if (buffer_exists(file_buffer))
			{
				buffer_delete(file_buffer);
			}

			/* Delete the decode-check sprite only if it still exists */
			if (image_sprite_exists(imported_sprite))
			{
				sprite_delete(imported_sprite);
			}

			set_server_import_status("Could not import PNG.", make_color_rgb(244, 84, 84));

			/* Collect short and extended import exception text for both debug error and
			on-screen import diagnostics */
			var import_error_message = server_import_debug_error_message(e);
			debug_error("Could not import drawing PNG: " + import_error_message);
			server_import_debug_add("exception", import_error_message);
			server_import_debug_add("result", "exception");
			return false;
		}
	}

	/// @description Handle server PNG import, folder opening and debug/chat snapshot controls
	/// @returns {Bool} Whether the pointer or click was captured by an available server control
	update_server_input = function()
	{
		/* Check desktop folder integration to determine which server controls can be shown and
		hit tested */
		var can_open_server_folders = scr_desktop_folder_opening_is_enabled();
		server_import_folder_button_x = server_import_button_x + server_import_button_width + 8;

		/* Place Save Log after Import Folder when desktop folders exist, otherwise directly
		after Import PNG */
		server_save_log_button_x = can_open_server_folders
			? server_import_folder_button_x + server_import_folder_button_width + 8
			: server_import_button_x + server_import_button_width + 8;
		server_logs_folder_button_x = server_save_log_button_x + server_save_log_button_width + 8;
		server_logs_auto_save_button_x = server_logs_folder_button_x + server_logs_folder_button_width + 8;

		/* Read horizontal GUI pointer position for the server control row */
		var mx = device_mouse_x_to_gui(0);

		/* Read vertical GUI pointer position for its hit rectangles */
		var my = device_mouse_y_to_gui(0);

		/* Import hover requires the pointer inside the import button rectangle */
		server_import_hover = point_in_rect(mx, my, server_import_button_x, server_import_button_y, server_import_button_x + server_import_button_width, server_import_button_y + server_import_button_height);

		/* Import Folder hover additionally requires desktop folder integration */
		server_import_folder_hover = can_open_server_folders
			&& point_in_rect(mx, my, server_import_folder_button_x, server_import_button_y, server_import_folder_button_x + server_import_folder_button_width, server_import_button_y + server_import_button_height);

		/* Save Log hover tests its current GUI rectangle */
		server_save_log_hover = point_in_rect(mx, my, server_save_log_button_x, server_import_button_y, server_save_log_button_x + server_save_log_button_width, server_import_button_y + server_import_button_height);

		/* Logs Folder hover requires desktop integration and its current rectangle */
		server_logs_folder_hover = can_open_server_folders
			&& point_in_rect(mx, my, server_logs_folder_button_x, server_import_button_y, server_logs_folder_button_x + server_logs_folder_button_width, server_import_button_y + server_import_button_height);

		/* Save on Open hover requires desktop integration and its toggle rectangle */
		server_logs_auto_save_hover = can_open_server_folders
			&& point_in_rect(mx, my, server_logs_auto_save_button_x, server_import_button_y, server_logs_auto_save_button_x + server_logs_auto_save_button_width, server_import_button_y + server_import_button_height);

		/* A fresh left click on Import starts the synchronous file-picker import attempt */
		if (server_import_hover && mouse_check_button_pressed(mb_left))
		{
			server_import_png_from_dialog();
			return true;
		}

		/* A fresh import-folder click requests opening its cache directory */
		if (server_import_folder_hover && mouse_check_button_pressed(mb_left))
		{
			open_image_import_folder();
			return true;
		}

		/* A fresh Save Log click captures both current debug and chat log exports */
		if (server_save_log_hover && mouse_check_button_pressed(mb_left))
		{
			/* Keep the debug export path, using its empty result to detect save failure */
			var debug_log_path = scr_debug_export_save();

			/* Snapshot debug-save error feedback immediately when that export produced no path */
			var debug_log_error = debug_log_path == "" ? scr_debug_export_status_text("Could not save debug log") : "";

			/* Keep the chat export path separately from the debug result */
			var chat_log_path = scr_chat_export_save();

			/* Snapshot chat-save error feedback when its export produced no path */
			var chat_log_error = chat_log_path == "" ? scr_debug_export_status_text("Could not save chat log") : "";

			/* Confirm combined success only when both exports returned paths */
			if (debug_log_path != "" && chat_log_path != "")
			{
				set_server_import_status("Saved debug and chat logs.", make_color_rgb(94, 215, 122));
			}

			/* A failed debug export with error text takes precedence in combined failure
			feedback */
			else if (debug_log_path == "" && debug_log_error != "")
			{
				set_server_import_status(debug_log_error, make_color_rgb(244, 84, 84));
			}

			/* Otherwise report the captured chat-export failure text */
			else
			{
				set_server_import_status(chat_log_error, make_color_rgb(244, 84, 84));
			}
			return true;
		}

		/* A fresh Logs Folder click optionally saves current snapshots before requesting
		desktop opening */
		if (server_logs_folder_hover && mouse_check_button_pressed(mb_left))
		{
			/* Begin without a newly saved debug path so feedback can distinguish plain opening
			from save-and-open */
			var auto_saved_debug_log_path = "";

			/* Begin without a newly saved chat path for the same combined outcome */
			var auto_saved_chat_log_path = "";

			/* The configured Save on Open preference controls both automatic log exports */
			if (server_logs_auto_save_on_open)
			{
				auto_saved_debug_log_path = scr_debug_export_save();

				/* Capture the debug-save error before a subsequent chat export changes shared
				export status */
				var auto_debug_log_error = auto_saved_debug_log_path == "" ? scr_debug_export_status_text("Could not auto-save debug log before opening folder") : "";
				auto_saved_chat_log_path = scr_chat_export_save();

				/* Capture the chat-save error if its automatic export returned no path */
				var auto_chat_log_error = auto_saved_chat_log_path == "" ? scr_debug_export_status_text("Could not auto-save chat log before opening folder") : "";

				/* An unsuccessful automatic debug save stops before opening the folder */
				if (auto_saved_debug_log_path == "")
				{
					set_server_import_status(auto_debug_log_error, make_color_rgb(244, 84, 84));
					return true;
				}

				/* An unsuccessful automatic chat save likewise stops before folder opening */
				if (auto_saved_chat_log_path == "")
				{
					set_server_import_status(auto_chat_log_error, make_color_rgb(244, 84, 84));
					return true;
				}
			}

			/* Keep the shared folder opener's automatic, manual or failed result */
			var logs_folder_result = scr_debug_export_open_folder();

			/* An automatic folder launch receives success feedback */
			if (logs_folder_result == FolderOpenResult.Opened)
			{
				/* Mention new logs only when both automatic snapshot paths were produced */
				if (auto_saved_debug_log_path != "" && auto_saved_chat_log_path != "")
				{
					set_server_import_status("Saved new debug and chat logs and opened logs folder.", make_color_rgb(94, 215, 122));
				}

				/* Otherwise confirm the folder launch alone */
				else
				{
					set_server_import_status("Opened logs folder.", make_color_rgb(94, 215, 122));
				}
			}

			/* A prepared folder requiring manual action gets popup-path guidance */
			else if (logs_folder_result == FolderOpenResult.ManualOpenNeeded)
			{
				/* Include completed snapshots in manual-open guidance only when both were
				saved */
				if (auto_saved_debug_log_path != "" && auto_saved_chat_log_path != "")
				{
					set_server_import_status("Saved new debug and chat logs. Use the popup path to open the folder manually.", make_color_rgb(255, 220, 95));
				}

				/* Otherwise explain manual opening of the prepared directory alone */
				else
				{
					set_server_import_status("Logs folder is ready. Use the popup path to open it manually.", make_color_rgb(255, 220, 95));
				}
			}

			/* Other opener results receive export-aware failure feedback */
			else
			{
				/* Mention retained saved logs in fallback text when a debug snapshot path
				exists, otherwise describe only opening failure */
				var open_folder_fallback = auto_saved_debug_log_path != "" ? "Saved logs, but could not open logs folder" : "Could not open logs folder";
				set_server_import_status(scr_debug_export_status_text(open_folder_fallback), make_color_rgb(244, 84, 84));
			}
			return true;
		}

		/* A fresh Save on Open click toggles the local server preference */
		if (server_logs_auto_save_hover && mouse_check_button_pressed(mb_left))
		{
			server_logs_auto_save_on_open = !server_logs_auto_save_on_open;

			/* Choose ON or OFF from the new preference state for its confirmation */
			var auto_save_status = server_logs_auto_save_on_open ? "ON" : "OFF";
			set_server_import_status("Save snapshots when opening Logs Folder: " + auto_save_status + ".", c_white);
			return true;
		}

		/* Return pointer capture while it hovers any available server control, even without a
		fresh click */
		return server_import_hover || server_import_folder_hover || server_save_log_hover || server_logs_folder_hover || server_logs_auto_save_hover;
	}

	/// @description Render platform-aware server controls, timed import feedback and bounded PNG diagnostics
	draw_server_gui = function()
	{
		/* Check desktop integration so visual buttons match input availability */
		var can_open_server_folders = scr_desktop_folder_opening_is_enabled();
		server_import_folder_button_x = server_import_button_x + server_import_button_width + 8;

		/* Use the same optional-folder-dependent Save Log position as input hit testing */
		server_save_log_button_x = can_open_server_folders
			? server_import_folder_button_x + server_import_folder_button_width + 8
			: server_import_button_x + server_import_button_width + 8;
		server_logs_folder_button_x = server_save_log_button_x + server_save_log_button_width + 8;
		server_logs_auto_save_button_x = server_logs_folder_button_x + server_logs_folder_button_width + 8;

		/* Display the current Save on Open preference directly in its toggle label */
		var auto_save_label = server_logs_auto_save_on_open ? "Save on Open: On" : "Save on Open: Off";
		scr_draw_menu_button(server_import_button_x, server_import_button_y, server_import_button_width, server_import_button_height, "Import PNG", server_import_hover, false, true, false, false, 18);

		/* Only desktop integration targets draw the Import Folder control */
		if (can_open_server_folders)
		{
			scr_draw_menu_button(server_import_folder_button_x, server_import_button_y, server_import_folder_button_width, server_import_button_height, "Import Folder", server_import_folder_hover, false, true, false, false, 18);
		}
		scr_draw_menu_button(server_save_log_button_x, server_import_button_y, server_save_log_button_width, server_import_button_height, "Save Log", server_save_log_hover, false, true, false, false, 18);

		/* They also draw Logs Folder and its automatic-save toggle */
		if (can_open_server_folders)
		{
			scr_draw_menu_button(server_logs_folder_button_x, server_import_button_y, server_logs_folder_button_width, server_import_button_height, "Logs Folder", server_logs_folder_hover, false, true, false, false, 18);
			scr_draw_menu_button(server_logs_auto_save_button_x, server_import_button_y, server_logs_auto_save_button_width, server_import_button_height, auto_save_label, server_logs_auto_save_hover, server_logs_auto_save_on_open, true, false, false, 17);
		}

		/* Render import feedback only within its nonempty millisecond display deadline */
		if (image_import_status_is_visible())
		{
			draw_set_alpha(0.82);
			draw_set_colour(c_black);
			draw_rectangle(server_import_button_x, server_import_button_y + server_import_button_height + 8, server_import_button_x + 620, server_import_button_y + server_import_button_height + 36, false);
			draw_set_alpha(1);
			draw_set_colour(server_import_status_color);
			draw_rectangle(server_import_button_x, server_import_button_y + server_import_button_height + 8, server_import_button_x + 620, server_import_button_y + server_import_button_height + 36, true);
			scr_render_text(server_import_button_x + 8, server_import_button_y + server_import_button_height + 15, server_import_status_text, 16, 604);
		}

		/* A nonempty diagnostic list opens the PNG import debug panel */
		if (server_import_debug_line_count > 0)
		{
			/* Read positive GUI width for diagnostic panel clipping */
			var gui_w = max(1, display_get_gui_width());

			/* Read positive GUI height for vertical placement */
			var gui_h = max(1, display_get_gui_height());

			/* Inset the panel eight GUI pixels from the left */
			var debug_x = 8;

			/* Fit width inside the GUI with a maximum 1040-pixel diagnostic panel */
			var debug_w = max(1, min(1040, gui_w - debug_x * 2));

			/* Use two columns only with at least 560 pixels and more than ten diagnostic
			lines, otherwise one column */
			var debug_columns = (debug_w >= 560 && server_import_debug_line_count > 10) ? 2 : 1;

			/* Round up the row count so every stored line has a position */
			var debug_rows = ceil(server_import_debug_line_count / debug_columns);

			/* Two-column panels use tighter twelve-pixel line spacing, otherwise fifteen */
			var debug_line_h = debug_columns > 1 ? 12 : 15;

			/* Use eleven-pixel text for two columns and thirteen-pixel text for one */
			var debug_font_size = debug_columns > 1 ? 11 : 13;

			/* Inset diagnostic text eight GUI pixels inside the panel */
			var debug_pad = 8;

			/* Measure full panel height from row count, line spacing and padding */
			var debug_h = debug_pad * 2 + debug_rows * debug_line_h;

			/* Prefer placing diagnostics below the server control row and feedback area */
			var debug_y_preferred = server_import_button_y + server_import_button_height + 44;

			/* Clip that preferred vertical origin against available GUI height */
			var debug_y = min(debug_y_preferred, max(4, gui_h - debug_h - 6));

			/* Divide usable diagnostic width equally among the selected columns */
			var debug_col_w = (debug_w - debug_pad * 2) / debug_columns;

			draw_set_alpha(0.9);
			draw_set_colour(c_black);
			draw_rectangle(debug_x, debug_y, debug_x + debug_w, debug_y + debug_h, false);
			draw_set_alpha(1);
			draw_set_colour(make_color_rgb(255, 220, 95));
			draw_rectangle(debug_x, debug_y, debug_x + debug_w, debug_y + debug_h, true);
			draw_set_colour(c_white);
			draw_set_halign(fa_left);

			/* Render every retained debug line in its stored order */
			for (var debug_line_index = 0; debug_line_index < server_import_debug_line_count; debug_line_index++)
			{
				/* Map the zero-based line index to its column, filling the first column before
				the next */
				var debug_col = debug_line_index div debug_rows;

				/* Map that line to its row within the chosen column */
				var debug_row = debug_line_index mod debug_rows;

				/* Compute the text's horizontal GUI origin from panel padding and column width */
				var debug_text_x = debug_x + debug_pad + debug_col * debug_col_w;

				/* Compute its vertical GUI origin from panel padding and line spacing */
				var debug_text_y = debug_y + debug_pad + debug_row * debug_line_h;
				scr_render_text(debug_text_x, debug_text_y, server_import_debug_lines[debug_line_index], debug_font_size, debug_col_w - 6);
			}
		}

		draw_set_alpha(1);
	}
	#endregion /* Server Drawing Controls END */

	#region /* Drawing Diagnostics */
	/// @description Return current drawing and replication diagnostics as plain-text export lines
	/// @returns {Array<String>} New diagnostic line array containing a snapshot of the current manager state
	debug_export_summary = function()
	{
		/* Build a readable canvas size from the live surface. A missing surface is reported by
		name so exporting diagnostics never queries an invalid handle */
		var surface_text = surface_exists(canvas_surface)
			? string(surface_get_width(canvas_surface)) + "x" + string(surface_get_height(canvas_surface))
			: "missing";

		/* Collect one plain-text line per subsystem for the debug export. The returned array
		records current identities, drawing history, transport counters and the last command
		payloads without changing drawing state */
		var lines =
		[
			"client identity: " + scr_network_debug_client_label() + " author=" + string(local_undo_author_id),
			"server players: " + scr_network_debug_player_map(),
			"surface/history: surface=" + surface_text + " layers=" + string(array_length(layers)) + " active=" + string(active_layer_id) + " clientHistory=" + string(array_length(client_history)) + " serverHistory=" + string(array_length(server_history)),
			"send: attempts=" + string(debug_send_attempts) + " ok=" + string(debug_send_successes) + " fail=" + string(debug_send_failures) + " last=" + string(debug_last_send_result) + " mode=" + debug_last_send_mode,
			"receive/apply: live=" + string(debug_receive_count) + " history=" + string(debug_history_receive_count) + " applied=" + string(debug_apply_count) + " applyFail=" + string(debug_apply_failures),
			"server: rx=" + string(debug_server_received_count) + " accept=" + string(debug_server_accept_count) + " reject=" + string(debug_server_reject_count) + " broadcasts=" + string(debug_server_broadcast_count) + " fail=" + string(debug_server_broadcast_failures),
			"server history sync: slot=" + string(debug_server_last_history_slot) + " sent=" + string(debug_server_last_history_sync) + " jobs=" + string(debug_server_history_sync_jobs) + " detail=" + debug_server_history_sync_detail,
			"server history persistence: " + server_history_persistence_status + " dirty=" + string(server_history_persistence_dirty) + " loaded=" + string(server_history_persistence_loaded_count) + " saved=" + string(server_history_persistence_saved_count),
			"server history checkpoint: " + server_history_checkpoint_status + " dirty=" + string(server_history_checkpoint_dirty) + " queued=" + string(server_history_checkpoint_requested) + " active=" + string(server_history_checkpoint_in_progress),
			"last invalid: " + debug_last_invalid_command,
			"last local: " + command_debug_string(debug_last_local_command),
			"last outgoing: " + command_debug_string(debug_last_outgoing_command),
			"last validated: " + command_debug_string(debug_last_validated_command),
			"last command: " + command_debug_string(debug_last_command)
		];

		return lines;
	}

	/// @description Draw the optional diagnostic panel in GUI coordinates, truncating rows to the available screen space
	/// @param {Bool} server_screen Use server-screen placement and permit diagnostics without an active client session. Defaults to false
	/// @returns {Undefined} No return value
	draw_debug_overlay = function(server_screen = false)
	{
		/* Hide this optional diagnostic panel until the user enables it with the debug
		shortcut */
		if (!debug_overlay_enabled)
		{
			return;
		}

		/* The client overlay belongs to an active drawing session. The server screen may
		display diagnostics before a client session exists */
		if (!server_screen && !is_active_client_session())
		{
			return;
		}

		/* Read the shared client manager for connection details shown on this frame */
		var client = scr_get_client();

		/* Read the shared server manager for socket counts and authoritative history details */
		var server = scr_get_server();

		/* Clamp the GUI width to at least one pixel before calculating the panel bounds */
		var gui_w = max(1, display_get_gui_width());

		/* Keep the GUI height positive for the same panel layout calculations */
		var gui_h = max(1, display_get_gui_height());

		/* Inset the panel 16 GUI pixels from the left edge */
		var panel_x = 16;

		/* Place server diagnostics 96 GUI pixels from the top. Client diagnostics sit below
		the toolbar, with 40 pixels of clearance when drawing mode shows screenshot status
		and eight pixels otherwise */
		var panel_y = server_screen ? 96 : toolbar_y + toolbar_height + ((draw_mode_enabled && screenshot_status_is_visible()) ? 40 : 8);

		/* Limit the panel to 900 GUI pixels while retaining the left and right margins on
		smaller windows */
		var panel_w = min(900, gui_w - panel_x * 2);

		/* Reserve eight GUI pixels inside each panel edge */
		var pad = 8;

		/* Space diagnostic rows 15 GUI pixels apart */
		var line_h = 15;

		/* Build the display text in a fresh frame-local array so counters and connection
		details reflect the current state */
		var lines = [];

		/* Track the next free row and final row count while assembling the panel text */
		var line_count = 0;

		/* Read the assigned client identifier only when that field exists. The noone fallback
		represents an unassigned identity, and this local is currently retained without a
		later display use */
		var client_id = is_struct(client) && variable_struct_exists(client, "ID") ? client.ID : noone;

		/* Read the client socket when available, otherwise use noone to describe the absence
		of a connection handle */
		var client_socket = is_struct(client) && variable_struct_exists(client, "socket") ? client.socket : noone;

		/* Convert a known transport to its debug name. Use a question mark when the client has
		no transport field */
		var client_transport = is_struct(client) && variable_struct_exists(client, "transport") ? net.transport_to_string(client.transport) : "?";

		/* Report singleplayer only when the client manager and its singleplayer flag are both
		present and enabled */
		var client_singleplayer = is_struct(client)
			&& variable_struct_exists(client, "singleplayer_mode")
			&& client.singleplayer_mode;

		/* Report a pending connection only when the client manager exposes an enabled pending
		flag */
		var client_pending = is_struct(client)
			&& variable_struct_exists(client, "connect_pending")
			&& client.connect_pending;

		/* Show the client's current connection message when it exists, otherwise leave that
		diagnostic value empty */
		var client_status = is_struct(client) && variable_struct_exists(client, "connect_status") ? client.connect_status : "";

		/* Capture whether drawing considers the current client session active for the
		connection-status row */
		var active_session = is_active_client_session();

		/* Describe live canvas dimensions, or use the missing label when the surface has been
		lost */
		var surface_text = surface_exists(canvas_surface)
			? string(surface_get_width(canvas_surface)) + "x" + string(surface_get_height(canvas_surface))
			: "missing";

		/* Format the last unfiltered world coordinates as rounded pixel positions for
		comparison with the accepted drawing position */
		var raw_world_text = string(round(debug_raw_world_x)) + "," + string(round(debug_raw_world_y));

		/* Show accepted world coordinates when mouse conversion succeeded. Otherwise display
		the rejection reason, while retaining raw coordinates in either case */
		var world_text = debug_mouse_world_valid
			? string(round(debug_mouse_world_x)) + "," + string(round(debug_mouse_world_y)) + " raw=" + raw_world_text
			: debug_mouse_reason + " raw=" + raw_world_text;

		/* Start the occupied server-socket count at zero before examining available slots */
		var server_socket_count = 0;

		/* Count sockets only when the server exposes a socket array. Missing server state
		leaves the displayed count at zero */
		if (is_struct(server)
		&& variable_struct_exists(server, "sockets")
		&& is_array(server.sockets))
		{
			/* Walk each socket-array position using a frame-local index so vacant slots do not
			inflate the connected-client count */
			for (var socket_index = 0; socket_index < array_length(server.sockets); socket_index++)
			{
				/* A socket value other than noone occupies this slot and contributes one
				client to the displayed total */
				if (server.sockets[socket_index] != noone)
				{
					server_socket_count++;
				}
			}
		}

		lines[line_count] = "DRAW DEBUG OVERLAY - F6 toggles this panel"; line_count++;
		lines[line_count] = "stage: " + debug_last_stage + " | " + debug_last_reason + " | age " + string(current_time - debug_last_time) + "ms"; line_count++;
		lines[line_count] = "local-first: " + debug_last_replication_status + " | localApplied=" + string(debug_local_apply_count); line_count++;
		lines[line_count] = "client: active=" + string(active_session) + " " + scr_network_debug_client_label() + " author=" + string(local_undo_author_id) + " socket=" + string(client_socket) + " " + client_transport + " single=" + string(client_singleplayer) + " pending=" + string(client_pending); line_count++;
		lines[line_count] = "client status: " + client_status; line_count++;
		lines[line_count] = "tool: mode=" + string(draw_mode_enabled) + " drawing=" + string(is_drawing) + " sent_drag=" + string(sent_drag_command) + " tool=" + string(tool) + " brush=" + string(brush_width); line_count++;
		lines[line_count] = "mouse: gui=" + string(round(debug_last_mouse_gui_x)) + "," + string(round(debug_last_mouse_gui_y)) + " world=" + world_text + " pressed/down/released=" + string(debug_last_mouse_pressed) + "/" + string(debug_last_mouse_down) + "/" + string(debug_last_mouse_released); line_count++;
		lines[line_count] = "toolbar: hover=" + toolbar_hover + " captured=" + string(debug_last_toolbar_captured) + " movedEnough=" + string(debug_last_moved_enough) + " camera=" + string(debug_last_camera_id); line_count++;
		lines[line_count] = "send: attempts=" + string(debug_send_attempts) + " ok=" + string(debug_send_successes) + " fail=" + string(debug_send_failures) + " last=" + string(debug_last_send_result) + " mode=" + debug_last_send_mode; line_count++;
		lines[line_count] = "receive/apply: live=" + string(debug_receive_count) + " history=" + string(debug_history_receive_count) + " applied=" + string(debug_apply_count) + " applyFail=" + string(debug_apply_failures); line_count++;
		lines[line_count] = "surface/history: surface=" + surface_text + " layers=" + string(array_length(layers)) + " active=" + string(active_layer_id) + " status=" + debug_surface_status + " clientHistory=" + string(array_length(client_history)); line_count++;
		lines[line_count] = "validate: failures=" + string(debug_validate_failures) + " lastInvalid=" + debug_last_invalid_command; line_count++;
		lines[line_count] = "local command: " + command_debug_string(debug_last_local_command); line_count++;
		lines[line_count] = "outgoing: " + command_debug_string(debug_last_outgoing_command); line_count++;
		lines[line_count] = "outgoing string: " + debug_last_outgoing_payload; line_count++;
		lines[line_count] = "raw string: " + debug_last_raw_payload; line_count++;
		lines[line_count] = "raw parsed: " + command_debug_string(debug_last_raw_command); line_count++;
		lines[line_count] = "validated string: " + debug_last_validated_payload; line_count++;
		lines[line_count] = "validated: " + command_debug_string(debug_last_validated_command); line_count++;
		lines[line_count] = "last command: " + command_debug_string(debug_last_command); line_count++;
		lines[line_count] = "server: sockets=" + string(server_socket_count) + " history=" + string(array_length(server_history)) + " rx=" + string(debug_server_received_count) + " accept=" + string(debug_server_accept_count) + " reject=" + string(debug_server_reject_count); line_count++;
		lines[line_count] = server_slot_summary(); line_count++;
		lines[line_count] = "server send: broadcasts=" + string(debug_server_broadcast_count) + " fail=" + string(debug_server_broadcast_failures) + " lastSlot=" + string(debug_server_last_slot) + " lastSend=" + string(debug_server_last_send_count); line_count++;
		lines[line_count] = "server history sync: slot=" + string(debug_server_last_history_slot) + " sent=" + string(debug_server_last_history_sync) + " jobs=" + string(debug_server_history_sync_jobs) + " detail=" + debug_server_history_sync_detail; line_count++;
		lines[line_count] = "server history persistence: " + server_history_persistence_status + " dirty=" + string(server_history_persistence_dirty) + " loaded=" + string(server_history_persistence_loaded_count) + " saved=" + string(server_history_persistence_saved_count); line_count++;
		lines[line_count] = "server history checkpoint: " + server_history_checkpoint_status + " dirty=" + string(server_history_checkpoint_dirty) + " queued=" + string(server_history_checkpoint_requested) + " active=" + string(server_history_checkpoint_in_progress); line_count++;

		/* Fit the panel height to both its text rows and the remaining GUI space, retaining a
		12-pixel bottom margin */
		var panel_h = min(gui_h - panel_y - 12, pad * 2 + line_count * line_h);

		/* Skip drawing when the window leaves no panel width or no room beyond the vertical
		padding */
		if (panel_w <= 0 || panel_h <= pad * 2)
		{
			return;
		}

		draw_set_alpha(0.82);
		draw_set_colour(c_black);
		draw_rectangle(panel_x, panel_y, panel_x + panel_w, panel_y + panel_h, false);
		draw_set_alpha(1);
		draw_set_colour(make_color_rgb(255, 220, 95));
		draw_rectangle(panel_x, panel_y, panel_x + panel_w, panel_y + panel_h, true);
		draw_set_halign(fa_left);

		/* Limit rendered rows to the number of complete 15-pixel lines that fit inside the
		panel */
		var visible_lines = min(line_count, floor((panel_h - pad * 2) / line_h));

		/* Draw the visible prefix of diagnostic rows using a zero-based row index, avoiding
		text below the panel */
		for (var i = 0; i < visible_lines; i++)
		{
			/* Highlight the first row as the panel title and render subsequent diagnostic rows
			in white */
			draw_set_colour(i == 0 ? make_color_rgb(255, 220, 95) : c_white);
			scr_render_text(panel_x + pad, panel_y + pad + i * line_h, lines[i], 14, panel_w - pad * 2);
		}

		draw_set_alpha(1);
		draw_set_halign(fa_left);
	}
	#endregion /* Drawing Diagnostics END */

	#region /* Server Command Dispatch and Join Snapshots */
	/// @description Read and validate the active drawing packet body, commit authoritative history, and broadcast behind joining snapshots
	/// @param {Real} raw_slot Logical sender slot supplied by server packet dispatch
	/// @returns {Bool} Acceptance and replication result, including true for an already absent undo group. A replication failure leaves an accepted history change committed
	server_handle_command = function(raw_slot)
	{
		debug_server_received_count++;
		debug_server_last_slot = raw_slot;
		debug_note("server read command", "actual=" + server_slot_label(raw_slot) + " header=" + server_slot_label(net.header.socketID));

		/* Decode and validate the active packet body into one history item before accepting
		any author or layer changes */
		var item = read_history_item();

		/* Reject malformed or unsupported packet content immediately. No authoritative edit
		has been recorded at this point */
		if (item == noone)
		{
			debug_server_reject_count++;
			debug_note("server rejected command", debug_last_invalid_command);
			return false;
		}

		/* Use the shared server manager to resolve the sender's logical slot and current
		socket */
		var server = scr_get_server();

		/* Reject the request when the server cannot resolve slot values or does not expose the
		expected socket array */
		if (!is_struct(server)
		|| !variable_struct_exists(server, "slot_from_value")
		|| !variable_struct_exists(server, "sockets")
		|| !is_array(server.sockets))
		{
			debug_server_reject_count++;
			debug_note("server rejected command", "server struct/socket data missing");
			return false;
		}

		/* Normalize the dispatcher's slot value through the server's slot resolver before
		using it as an array index */
		var slot = server.slot_from_value(raw_slot);

		/* A missing logical slot or vacant socket cannot identify a connected drawing author,
		so reject the command */
		if (slot == noone
		|| server.sockets[slot] == noone)
		{
			debug_server_reject_count++;
			debug_note("server rejected command", "bad slot/socket " + string(raw_slot));
			return false;
		}

		/* Layer actions use their own validation, voting and cooldown handling. Delegate their
		result instead of treating them as pixel edits */
		if (history_item_is_layer(item))
		{
			return server_handle_layer_history_request(item, slot);
		}

		/* Extend command timestamps through this sender's slot. Newly added entries begin at
		zero milliseconds because they have no prior recorded command time */
		while (array_length(server_last_command_time) <= slot)
		{
			server_last_command_time[array_length(server_last_command_time)] = 0;
		}

		/* Record close packet spacing for diagnostics. This branch does not reject an edit
		that the sender already applied locally */
		if (current_time < server_last_command_time[slot] + server_min_command_interval_ms)
		{
			debug_note("server command close spacing", server_slot_label(slot));
		}

		server_last_command_time[slot] = current_time;

		/* Serialize the validated item for debug reporting before undo handling or later
		server-side author stamping */
		var command_payload = history_item_payload_string(item);

		/* Undo packets remove an existing author-and-group history entry instead of adding new
		content to a layer */
		if (history_item_is_undo(item))
		{
			/* Reject an undo whose claimed author cannot be used by this slot and its current
			socket */
			if (!server_slot_can_use_undo_author(item.undo_author_id, slot, server.sockets[slot]))
			{
				debug_server_reject_count++;
				debug_note("server rejected undo", server_slot_label(slot) + " author=" + string(item.undo_author_id) + " " + debug_last_invalid_command);
				return false;
			}

			/* Stop an undo when its action cooldown is still active, preventing rapid repeat
			undo requests */
			if (!server_try_start_action_cooldown(slot, "undo"))
			{
				return false;
			}

			/* Count authoritative history entries removed for this undo author and group so
			the server can distinguish a real removal from a repeat request */
			var removed_count = remove_server_undo_group(item.undo_author_id, item.undo_id);

			/* An already absent undo group is an accepted no-op. Return success without
			broadcasting another removal */
			if (removed_count <= 0)
			{
				debug_note("server undo skipped", "no matching group " + string(item.undo_author_id) + ":" + string(item.undo_id));
				return true;
			}

			debug_server_accept_count++;
			debug_last_validated_payload = command_payload;

			/* Refresh gameplay activity only when the server manager provides that optional
			idle-tracking hook */
			if (variable_struct_exists(server, "note_client_gameplay_activity"))
			{
				server.note_client_gameplay_activity(slot);
			}

			/* Broadcast the accepted undo behind each client's pending history snapshot. The
			result counts immediate recipients and is negative on delivery failure */
			var undo_send_count = server_broadcast_history_item_with_sync_barrier(item, slot, false);
			debug_server_last_send_count = undo_send_count;

			/* Record an undo broadcast failure while retaining the history removal that has
			already happened */
			if (undo_send_count < 0)
			{
				debug_server_broadcast_failures++;
				debug_note("server undo broadcast failed", server_slot_label(slot));
			}

			/* A nonnegative send count records successful scheduling or delivery, including
			zero immediate recipients */
			else
			{
				debug_server_broadcast_count++;
				debug_note("server broadcast undo", server_slot_label(slot) + " removed " + string(removed_count) + " command(s)");
			}

			/* Report whether undo replication succeeded. A false result does not restore the
			removed history group */
			return undo_send_count >= 0;
		}

		/* Read the content edit's target layer identifier for authoritative availability
		checks */
		var target_layer_id = history_item_layer_id(item);

		/* Reject content with no usable target layer or a layer that cannot currently accept
		drawing */
		if (target_layer_id == noone || !server_layer_accepts_content(target_layer_id))
		{
			debug_server_reject_count++;
			debug_note("server rejected command", server_slot_label(slot) + " unavailable layer=" + string(target_layer_id));
			return false;
		}

		/* Bind and validate the claimed undo author against the actual sender. Reject
		mismatched ownership before recording the edit */
		if (!server_note_undo_author_slot(item, slot, server.sockets[slot]))
		{
			debug_server_reject_count++;
			debug_note("server rejected command", server_slot_label(slot) + " author=" + string(command_undo_author_id(item)) + " " + debug_last_invalid_command);
			return false;
		}

		/* Do not drop accepted drawing edits for close packet spacing. The sender has
		already applied its edit locally, so rejection here would leave other clients
		with different pixels. Undo and layer actions enforce their own cooldowns */
		server_stamp_history_item_author(item, slot);
		server_cancel_layer_vote_for_history_item(item);
		command_payload = history_item_payload_string(item);
		push_server_history(item);
		debug_server_accept_count++;

		/* Only content commands update this latest-pixel-command diagnostic. Layer actions
		have already returned through their dedicated handler above */
		if (!history_item_is_layer(item))
		{
			debug_last_command = item;
		}
		debug_last_validated_payload = command_payload;

		/* Mark gameplay activity through the optional server hook after the content edit has
		been accepted */
		if (variable_struct_exists(server, "note_client_gameplay_activity"))
		{
			server.note_client_gameplay_activity(slot);
		}

		/* Broadcast the newly committed item with each client's snapshot-ordering barrier. A
		negative result signals replication failure after the authoritative history was
		updated */
		var send_count = server_broadcast_history_item_with_sync_barrier(item, slot, false);
		debug_server_last_send_count = send_count;

		/* Report a broadcast failure without removing the accepted edit from authoritative
		history */
		if (send_count < 0)
		{
			debug_server_broadcast_failures++;
			debug_note("server broadcast failed", server_slot_label(slot));
			debug_error("Failed to broadcast drawing command from slot " + string(slot));
		}

		/* Count a successful broadcast attempt even when no other client requires immediate
		delivery */
		else
		{
			debug_server_broadcast_count++;
			debug_note("server broadcast command", server_slot_label(slot) + " to " + string(send_count) + " other client(s)");
		}

		/* Return the delivery result for this accepted content edit. Authoritative history
		remains committed if replication reports failure */
		return send_count >= 0;
	}

	/// @description Queue an ordered server history array snapshot for a joining client. History items retain their existing struct references and server updates perform the transfer
	/// @param {Real} raw_slot Logical joining client slot
	/// @returns {Real} Queued history item count, zero for an empty snapshot, or -1 on failure
	server_send_history_to_slot = function(raw_slot)
	{
		return queue_history_sync_items_to_slot(raw_slot, copy_server_history_snapshot(), "join");
	}
	#endregion /* Server Command Dispatch and Join Snapshots END */

	/* Restore client preferences once when the shared drawing manager is created */
	load_canvas_background_setting();
	load_inactive_layer_dim_setting();
	load_recent_colors();
}

/// @description Return the drawing manager shared by the client, server, and network object events
/// @returns {Struct} Drawing manager created on first access
function scr_get_drawing()
{
	/* Create the shared drawing manager once on the first call. Its persistent state
	is then reused by client, server and network events for the lifetime of the game */
	static drawing = new scr_drawing();
	return drawing;
}
